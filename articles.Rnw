# These are daily ratio returns
V <- cov(d, use="complete")
alpha <- apply(d, 2, mean, na.rm=TRUE)
# We cannot really convert these to annual returns,
# because if we do it properly, the straight lines
# would not be preserved.

# Minimize w' V w such that w' 1 = 1 and w' alpha = mu.
# Lagrange multipliers: 
#   2 V w = lambda1 1 + lambda2 alpha
#   w' 1 = 1
#   w' alpha = mu
f <- function( V, alpha, mu=1 ) {
  stopifnot( dim(V)[1] == dim(V)[2] )
  stopifnot( nrow(V) == length(alpha) )
  n <- length(alpha)
  ones <- rep(1,n)
  m <- matrix(
    c( 
      t(ones) %*% solve(V, ones),  t(alpha) %*% solve(V,ones ),
      t(ones) %*% solve(V, alpha), t(alpha) %*% solve(V,alpha)
    ),
    nr=2, byrow=TRUE
  )
  lambda <- solve(m, c(1, mu))
  w <- solve( V, lambda[1] * ones + lambda[2] * alpha )
  stopifnot( abs( t(w) %*% ones  - 1 ) < 1e-6 )
  stopifnot( abs( t(w) %*% alpha - mu ) < 1e-6 )
  w
}

k <- 500
max_risk <- 3e-2
max_return <- .01
risk_free <- 1.01^(1/250) - 1

frontier <- matrix( 
  c(
    rep(NA,k),
    seq(-.1*max_return, 1.1*max_return,length=k)
  ), nc=2)
colnames(frontier) <- c("Risk", "Return")
for(i in seq_len(nrow(frontier))) {
  w <- f(V, alpha, frontier[i,2])
  frontier[i,1] <- sqrt(t(w) %*% V %*% w)
}
par(mar=c(4,4,1,1))
plot(frontier, 
  xlab="Risk", ylab="Return",
  type="l", lwd=3, las=1,
  xlim=c(0,max_risk), ylim=c(0,max_return)
)
points( sqrt(diag(V)), alpha, pch=16 )
# Risk-free asset
abline(h=0,v=0,lty=3)
points( 0, risk_free, pch=16)
# Tangent (market) portfolio
i <- which.max( ( frontier[,2] - risk_free ) / frontier[,1] )
sharpe <- ( frontier[i,2] - risk_free ) / frontier[i,1]
abline(risk_free, sharpe)
points( frontier[i,,drop=FALSE], cex=2, lwd=3)
# Minimum variance portfolio
i <- which.min(frontier[,1])
points( frontier[i,,drop=FALSE], cex=2, lwd=3)

# Indifference curves
aversion <- 20
for(i in seq(-max_return,max_return,length=20)) {
  curve(i + aversion * x^2, add=TRUE, col="grey")
}
