\textbf{3.} There is a zoo of activation functions:
\begin{align*}
  \sigma(z) &= ( 1 + e^{-z} )^{-1} \\
  \tanh z \\
  \text{PReLU}_a(z) &= \begin{cases}
    z & \text{if } z \geq 0 \\
    az & \text{if } z \leq 0
  \end{cases} \\
  \text{LReLU} &= \text{PReLU}_a \\
  \text{Softplpus}(z) &= \log( 1 + e^z ) \\
  \text{GeLU}(z) &= z \cdot \Phi(z) \\
  \text{SiLU}(z) &= z \cdot \sigma(z) \\
  \text{ELU}_\alpha (z) &= \begin{cases}
    z & \text{if } z \geq 0 \\
    \alpha( e^z - 1 ) & \text{if } z \leq 0
  \end{cases} \\
  \text{SELU}(z) &= \lambda \text{ELU}_\alpha(z) \\
  \text{Swish}_\beta(z) &= z \cdot \sigma ( \beta z )
\end{align*}

