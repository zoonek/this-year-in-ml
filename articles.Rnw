\draw[->] (B) -- (C);
\draw[dashed,very thick,blue!90!black] (A) to[out=30,in=150,looseness=1] (C);
\end{tikzpicture}
\qquad
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.6,inner sep=1pt,outer sep=0pt,baseline=3mm, text width=.5em,
  every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
