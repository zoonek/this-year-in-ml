\longrightarrow
\underset{\text{\footnotesize latent representation}}{%
\begin{tikzpicture}[>=stealth,xscale=.3, yscale=.4,inner sep=1pt, outer sep=1pt,baseline=10pt]
\draw[thick]
(-2.1,0)--(-2.07,0)--(-2.04,0)--(-2.01,0)--(-1.98,0)--(-1.95,0.003)--(-1.92,0.018)--(-1.89,0.058)--(-1.86,0.132)--(-1.83,0.25)--(-1.8,0.413)--(-1.77,0.62)--(-1.74,0.863)--(-1.71,1.132)--(-1.68,1.412)--(-1.65,1.688)--(-1.62,1.941)--(-1.59,2.157)--(-1.56,2.322)--(-1.53,2.426)--(-1.5,2.461)--(1.5,2.461)--(1.53,2.426)--(1.56,2.322)--(1.59,2.157)--(1.62,1.941)--(1.65,1.688)--(1.68,1.412)--(1.71,1.132)--(1.74,0.863)--(1.77,0.62)--(1.8,0.413)--(1.83,0.25)--(1.86,0.132)--(1.89,0.058)--(1.92,0.018)--(1.95,0.003)--(1.98,0)--(2.01,0)--(2.04,0)--(2.07,0)--(2.1,0);
\draw[->] (-2.5,0) -- (2.5,0);
\node[anchor=north] at (2.5,0) {\footnotesize $z$};
\end{tikzpicture}
}
\]

In dimension 2, this becomes
\[
  \begin{pmatrix}
    x_1 \\ x_2 
  \end{pmatrix}
  \longmapsto
  \begin{pmatrix}
    z_1 = f_\theta(x_1) \\
    z_2 = f_\theta(x_1,x_2)
  \end{pmatrix}
\]
\begin{align*}
  \text{Loss}(\theta) = \sum_i
  & \log p_{z_1} \bigl( f_\theta(x_1) \bigr) + \log \va{ \dfrac{ dz_1 }{ dx_1 } } + \\
  & \log p_{z_1} \bigl( f_\theta(x_1,x_2) \bigr) + \log \va{ \dfrac{ dz_2 }{ dx_1 } }.
\end{align*}
For instance, $f_\theta(x_1)$ could be the cdf of a mixture of 5 Gaussians
and $f_\theta(x_1,x_2)$ the cdf of a mixture of 5 Gaussians conditional on $x_2$.

\[
\raisebox{-2em}{%
<<FlowModel2D1,results='hide',echo=FALSE,fig.width=3,fig.height=3,out.width='.2\\hsize',fig.show='hold'>>=
## 1
green <- "#9EE29E"
red <- "#FF8DA7"
blue <- "#B4D2F0"
theta <- seq(0, pi, length=50)
r <- 1/2
x0 <- 1/4
x1 <- -x0 + r * cos(theta)
y1 <- r * sin(theta)
x2 <- +x0 + r * cos(theta)
y2 <- - r * sin(theta)
par( mar = .1 * c(1,1,1,1), xaxs = "i", yaxs = "i" )
plot( NA, xlim = c(-1,1), ylim = c(-1,1), xlab = "", ylab = "", axes = FALSE )
lines(x1,y1, lwd = 50, col = red)
lines(x2,y2, lwd = 50, col = green)
box(lwd=3)
@
}
\!\!\longrightarrow
\raisebox{-2em}{%
<<FlowModel2D2,results='hide',echo=FALSE,fig.width=3,fig.height=3,out.width='.2\\hsize',fig.show='hold'>>=
## 2
x <- seq(-1,1,length = 51)
y <- x^3 - .5*x
par( mar = .1 * c(1,1,1,1), xaxs = "i", yaxs = "i" )
plot( NA, xlim = c(-1,1), ylim = c(-1,1), xlab = "", ylab = "", axes = FALSE )
polygon( c(-1,x,1), c(-1,y,-1), col = green, lwd = 3 )
polygon( c(-1,x,1), c(1,y,1), col = red, lwd = 3 )
box(lwd=3)
@
}
\]
\[
\raisebox{-2em}{%
<<FlowModel2D3,results='hide',echo=FALSE,fig.width=3,fig.height=3,out.width='.2\\hsize',fig.show='hold'>>=
## 3
x <- .7
par( mar = .1 * c(1,1,1,1), xaxs = "i", yaxs = "i" )
plot( NA, xlim = c(-1,1), ylim = c(-1,1), xlab = "", ylab = "", axes = FALSE )
points(-x,x, cex = 10, pch = 16, col = green)
points(+x,x, cex = 10, pch = 16, col = blue)
segments( -x,-x, x,-x, lwd = 50, col = red )
box(lwd = 3)
@
}
\!\!\longrightarrow
\raisebox{-2em}{%
<<FlowModel2D4,results='hide',echo=FALSE,fig.width=3,fig.height=3,out.width='.2\\hsize',fig.show='hold'>>=
## 4
theta <- seq(0,pi/2, length=51)
x <- cos(theta)
y <- sin(theta)
x1 <- x - 1
y1 <- 1 - y
x2 <- 1 - rev(x)
y2 <- 1 - rev(y)
x2 <- 1 - x
y2 <- 1 - y
par( mar = .1 * c(1,1,1,1), xaxs = "i", yaxs = "i" )
plot( NA, xlim = c(-1,1), ylim = c(-1,1), xlab = "", ylab = "", axes = FALSE )
lines(x1,y1)
lines(x2,y2)
polygon(c(-1,x1), c(1,y1), col = green)
polygon(c(x2,1), c(y2,1), col = blue)
polygon(c(-1,rev(x1),x2,1), c(-1,rev(y1),y2,-1), col = red, lwd = 3)
box(lwd = 3)
@
}
\]

In dimension $n$, notice that sampling from a Baysian net is a flow:
use an \emph{autoregressive flow} (AF).
\begin{align*}
  x_1 & \sim p_\theta(x_1) & x_1 &= f_\theta^{-1} (z_1) \\
  x_2 &\sim p_\theta(x_2 | x_1 ) & x_2 &= f_\theta^{-1} (z_2 ; x_1 ) \\
  x_2 &\sim p_\theta(x_3 | x_1, x_2 ) & x_3 &= f_\theta^{-1} ( z_3, x_1, x_2 )
\end{align*}
\[
p_\theta(x) = p\bigl( f_\theta(x) \bigr)
\va{
  \det \dfrac{ \partial f_\theta(x) }{ \partial x }
}
\]

Instead of learning an invertible mapping $x \mapsto z$,
one can learn $z \mapsto x$ (inverse AR flow, IAF):
training is now sequential (slow), but sampling parallelizable (fast)
(ParallelWaveNet, IAF-VAE).

The loss is now
\begin{align*}
  & 
  \E_{ x \sim \text{data} } \bigl[ - \log p_\theta(x) \bigr] = \\
  &\qquad
\E_{ x \sim \text{data} } \biggl[
  - \log p_z\bigl( f_\theta(x) \bigr) -
  \log \va{ \det \dfrac{ \partial f_\theta(x) }{ \partial x } }
  \biggr]
\end{align*}

For \emph{affine flows} (multivariate Gaussians)
\begin{align*}
  z &= f(x) = A^{-1} (x-b) & z &\sim N(0,1) \\
  x &= Az + b & x & \sim N(b, AA') 
\end{align*}
the log-likelihood is expensive to compute (since $\partial f / \partial x = A^{-1}$, we need $\det A$).

The \emph{elementwise flow}
$x \mapsto (f_\theta(x_1), \dots, f_\theta(x_n))$ is not expressive enough,
but could be used for some layers.

NICE and RealNVP split the variables in two
\begin{align*}
  z_{ 1 : d/2 } &= x_{ 1 : d/2 } \\
  z_{ d/2 : d } &= d_{ d/2 : d } \cdot s_\theta( x_{1:d/2})  + t_\theta( x_{1:d/2} )
\end{align*}
where $s_\theta$, $t_\theta$ are arbitrary neural nets.

Split images using a checkerboard pattern or channels.
\[
\begin{tikzpicture}[>=stealth,xscale=3, yscale=.7,inner sep=1pt, outer sep=1pt,baseline=10pt]
\node (x0) at (0,6) {\footnotesize $x: 32\times32\times1$};
\node (x1) at (0,4) {\footnotesize $x_1: 16\times16\times2$};
\node (x2) at (0,2) {\footnotesize $x_2: 8\times8\times4$};
\node (z1) at (1,4) {\footnotesize $z_1: 16\times16\times2$};
\node (z2) at (1,2) {\footnotesize $z_2: 8\times8\times4$};
\node (z3) at (1,0) {\footnotesize $z_3: 4\times4\times16$};
\node[draw] (l1) at (0,5) {\footnotesize layer 1};
\node[draw] (l2) at (0,3) {\footnotesize layer 1};
\node[draw] (l3) at (0,1) {\footnotesize layer 1};
\draw[->] (x0) -- (l1);
\draw[->] (x1) -- (l2);
\draw[->] (x2) -- (l3);
\draw[->] (l1) -- (x1);
\draw[->] (l1) -- (z1);
\draw[->] (l2) -- (x2);
\draw[->] (l2) -- (z2);
\draw[->] (l3) -- (z3);
\end{tikzpicture}
\]

\emph{Flow++} replaces the affine transformations in RealNVP
\[
x_i = z_i \cdot a_\theta \bigl( \text{parent}(x_i) \bigr) +
b_\theta \bigr( \text{parent}( x_i ) \bigr)
\]
with non-linear transformations, e.g., the cdf (or icdf) of Gaussian or logistic mixtures,
or piecewise linear or quadratic functions.
If the data is discrete
\begin{tikzpicture}[>=stealth,xscale=.15, yscale=.05,inner sep=.6pt, outer sep=1pt,baseline=0pt]
  \draw (-.5,0) -- (2.5,0);
  \draw[thick] (0,0) -- (0,2);
  \draw[thick] (1,0) -- (1,4);
  \draw[thick] (2,0) -- (2,3);
  \node[circle,fill] at (0,2) {};
  \node[circle,fill] at (1,4) {};
  \node[circle,fill] at (2,3) {};
\end{tikzpicture},
we do not want a pdf with peaks
\begin{tikzpicture}[>=stealth,xscale=.15, yscale=.05,inner sep=.6pt, outer sep=1pt,baseline=0pt]
  \draw (-.5,0) -- (2.5,0);
  \draw[thick] (-.5,0) --
  (-.2,0) -- (0,2) -- (.2,0) --
  (.8,0) -- (1,4) -- (1.2,0) -- 
  (1.8,0) -- (2,3) -- (2.2,0) --
  (2.5,0);
\end{tikzpicture},
but something closer to a piecewise uniform distribution
\begin{tikzpicture}[>=stealth,xscale=.15, yscale=.05,inner sep=.6pt, outer sep=1pt,baseline=0pt]
  \draw (-1,0) -- (3,0);
  \draw[thick] (-.5,0) -- (-.5,2) -- (.5,2) -- (.5,4) -- (1.5,4) -- (1.5,3) -- (2.5,3) -- (2.5,0);
  \draw (.5,0) -- (.5,4);
  \draw (1.5,0) -- (1.5,3);
\end{tikzpicture}: add $U(-\tfrac12, +\tfrac12)$ to the data (\emph{dequantization}).
Also check \emph{Glow}, FFJORD.

(To check if a latent coordinate $k$ is independent from the others,
take two images $x^{(1)}$, $x^{(2)}$;
compute $z^{(1)}$, $z^{(2)}$;
replace $z^{(1)}_k$ with $z^{(2)}_k$;
compute the corresponding image $x$;
check if it looks real, e.g., with a GAN --
this could also be part of the loss function.)

\textbf{4.}
With AR and flow models,
all variables are observed, but they depend on one another.
With \d{latent variable models}, some variables are hidden,
but the observed variables are conditionally independent given the latent variables.
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=.8,inner sep=1pt, outer sep=1pt]
  \node[anchor=mid] (z) at (0,1) {$z$};
  \node[anchor=mid] (x) at (0,0) {$x$};
  \draw[->] (z) -- node[anchor=west] {\footnotesize $p_\theta(x|z)$} (x);
  \node[anchor=mid] at (1,1) {\rlap{$z \sim p_z$}};
  \node[anchor=mid] at (1,0) {\rlap{$x \sim p_\theta(x|z)$}};
\end{tikzpicture}
\]

The likelihood is
\( p_\theta(x) = \sum_z p_z(z) p_\theta(x|z) \)
and the model can be trained as
\[
\operatorname*{Maximize}_\theta \sum_i \log p_\theta \bigl( x^{(i)} \bigr) =
\sum_i \log \sum _z p_z(z) p_\theta\bigl( x^{(i)} | z \bigr).
\]

If $z$ only takes a small number of values,
the objective is tractable,
e.g., a mixture of 3 Gaussians:
\begin{align*}
  z &\sim \text{Unif} \{ A, B, C \} \\
  x & \sim N( \mu_z, \sigma_z^2 ).
\end{align*}

\emph{Prior sampling} replaces $\E_{z \sim p_z}[\cdot]$
with the average over a sample $z_k^{(i)} \sim p_z$,
but most terms are negligible unless, by chance,
$z_k$ is close to a latent representation of $x$ --
and things get worse in high dimension: use \emph{importance sampling}.
A good proposal distribution would be
$q(z) = p_\theta(z | x^{(i)} )$,
but it is difficult to sample from.
Instead, use a variational approach and find
$q = N(\mu,\sigma^2)$
close to $p_\theta(z | x^{(i)} )$
by minimizing
\begin{align*}
  \text{KL}\bigl( q(z) \bigm\| p_\theta(z|x^{(i)} \bigr)
  &= \E_{ z \sim q} \log \dfrac{ q(z) }{ p_\theta(z | x^{(i)})  } \\
  &= \E_{ z \sim q } \log \dfrac{ q(z) }{
    p_\theta( x^{(i)} | z ) p(z) / p_\theta(x^{(i)} )
  } \\
  &\hspace*{-3.1cm}=
  \underset{\text{computable}}{%
    \!\!
    \E_{ z \sim q }
  \bigl[
    \log q(z) - \log p_\theta( x^{(i)} | z ) - \log p(z) 
    \bigr]
  }
  +
  \underset{\substack{\text{does not}\\\text{depend on $q$}}}{\log  p_\theta(x^{(i)} ).}
\end{align*}

Instead of finding a distribution $q$ minimizing the KL divergence for each $i$,
use \emph{amortized inference} and solve
\[ \operatorname*{Minimize}_\phi \sum_i \text{KL} \bigl(
q_\phi(z | x^{(i)}) \bigm\| p_\theta(z | x^{(i)}) \bigr)
\]
where $q_\phi$ is a neural net:
$q_\phi(z|x) = N\bigl( \mu_\phi(x) , \sigma^2_\phi(x) \bigr)$.

\[
\begin{tikzpicture}[>=stealth,xscale=2.5,inner sep=1pt, outer sep=1pt]
  \node[circle,draw] (Z) at (0,0) {$Z$};
  \node[circle,draw] (X) at (1,0) {$X$};
  \draw[->] (Z) -- node[anchor=south]{\footnotesize $p_\theta(x|z)$} (X);
  \draw[->,dashed] (X) to[out=-150,in=-30] node[anchor=north]{\footnotesize $q_\phi(z|x)$} (Z);
\end{tikzpicture}
\]

Note that $p_\theta$ is part of the model while $q_\phi$ is merely used for inference.
This is the \emph{importance weighted autoencoder} (IWAE).
\[
\begin{array}{ll}
  \text{Find} & \theta \text{ and } \phi \\
  \text{To maximize} & \displaystyle \sum_i  \log \dfrac1K \sum_k
  \dfrac{ p_x( z_k^{(i)} ) }{ q( z_k^{(i)} ) } p_\theta( x^{(i)}| z_k^{(i)} )    \\
  & \displaystyle
  - \sum_i \text{KL}
  \bigl(
    q_\phi( x | x^{(i)} )
  \bigm\|
    p_\theta( z | x^{(i)} )
  \bigr) \\
  \text{Where} & z_k^{(i)}   \sim q_\phi( \cdot | x^{(i)} )
\end{array}
\]
The traditional \d{VAE} uses $K=1$.

The VAE loss can also be derived from Jensen's inequality:
\begin{align*}
  \sum_i \log p_\theta(x^{(i)}) &=
  \sum_i \log \sum_z p(z) p_\theta( x^{(i)}| z ) \\
  &= \sum_i \log \sum_z \dfrac{ q(z) }{ q(z) } p(z) p_\theta( x^{(i)} | z ) \\
  &= \sum_i \log \E_{ z \sim q } \biggl[ \dfrac{ p(z) }{ q(z) } p_\theta( x^{(i)} | z ) \biggr] \\
  &\geq \sum_i \E_{ z \sim q } \log \dfrac{ p(z) }{ q(z) } p_\theta( x^{(i)} | z )
\end{align*}
Jensen's inqeuality, $\log \E X \geq \E \log X$,
is an equality if $X$ is constant, \ie, if $q(z) \propto p_\theta( z | x^{(i)} )$:
\[ \sum_o \log p_\theta( x^{(i)} ) = \max_q \sum_i \E_{ z \sim q } \log
\dfrac{ p(z) p_\theta( x^{(i)}| z ) }{ q(z) }. \]
This is the \emph{variational lower bound} (VLB, or evidence lover bound, ELBO).
To train the model, maximize the VLB wrt both $q$ and $\theta$.

The VAE objective can also be derived by computing
$\text{KL} \bigl( q(z) \bigm\| p(z|x) \bigr)$:
\[ \log p(x) =
\E_{ z \sim q } \biggl[
  \log \dfrac{ p(z) p(x|z) }{ q(z) } 
\biggr] +
\text{KL}\bigl( q(z) \bigm\| p(z|x) \bigr).
\]

The optimization wrt $q$ is tricky because the objective is an expectation wrt $q$.
The \emph{likelihood ratio gradient} (score function, \textsc{reinforce})
\[ \nabla_{\!\phi} \E_{ z \sim q_\phi} \bigl[ f(z) \bigr] =
\E_{ z \sim q_\phi} \bigl[
  \nabla_{\!\phi} \log q_\phi(z) \cdot f(z) 
  \bigr]
\]
is very noisy
(try to minimize
$\E_{ x \sim N(\mu,1)} \n{x-5}^2$: the gradient is $\tfrac12(x-\mu) \n{x-5}^2$ --
each step is in a random direction, but they are slightly longer in the right direction).
Whenever possible, the \emph{reparametrization trick} (or \emph{pathwise derivative}) works better:
\[
\E_{ z \sim N(\mu,\sigma^2) } \bigl[ f(x) \bigr] =
\E_{ \epsilon \sim N(0,1) } \bigl[ f(\mu + \sigma\epsilon) \bigr]
\]

The \emph{$\beta$-VAE} forces the latent representation to be even more Gaussian
($\beta \gg 1$):
\[
\text{Loss} = \E_{ z \sim q_\phi(z|x) } \bigl[ \log p_\theta(x|z) \bigr] -
  \beta \cdot \text{KL} \bigl( q_\phi(z|x) \bigm\| p(z) \bigr).
\]

The \emph{VQ-VAE} provides a better separation between classes by quantizing the latent space.
The VQ-VAE-v2 (current SOTA) uses a hierarchical latent space (with progressive up- and down-sampling)
and self-attention; contrary to GANs, it does not suffer from mode collapse.

More complex distributions for $p(x|z)$, e.g., PixelCNN, tend to forget the latent code...

Variational approximation has other uses.
Flow++ does not use uniform quantization, which results in piecewise constant distributions,
\begin{tikzpicture}[>=stealth,xscale=.15, yscale=.05,inner sep=.6pt, outer sep=1pt,baseline=0pt]
  \draw (-1,0) -- (3,0);
  \draw[thick] (-.5,0) -- (-.5,2) -- (.5,2) -- (.5,4) -- (1.5,4) -- (1.5,3) -- (2.5,3) -- (2.5,0);
  \draw (.5,0) -- (.5,4);
  \draw (1.5,0) -- (1.5,3);
\end{tikzpicture},
but learns it (\emph{variational dequantization})
\begin{tikzpicture}[>=stealth,xscale=.15, yscale=.05,inner sep=.6pt, outer sep=1pt,baseline=0pt]
  \draw (-1,0) -- (3,0);
  \draw[thick] (-.5,0) -- (0,2) -- (1,4) -- (2,3) -- (2.5,0);
  \draw (.5,0) -- (.5,3);
  \draw (1.5,0) -- (1.5,3.5);
\end{tikzpicture}.

Mutual information can be approximated as
\begin{align*}
  I(z;x)
  &= H(z) - H(z|x) \\
  &= H(z) - \E_{ (z,x) \sim p(z,x) } \bigl[ - \log p(z|x) \bigr] \\
  &= H(z) + E\bigl[ \log q(z|x) - \log q(z|x) + \log p(z|x) \bigr] \\
  &= H(z) + E \bigl[ \log q(z|x) \bigr] + \text{KL} \\
  &\geq H(z) + E\bigl[ \log q(z|x) \bigr]
\end{align*}
% Mutual information
\[
\begin{tikzpicture}[>=stealth,scale=.8,inner sep=1pt, outer sep=1pt]
  \def\firstcircle{(-1,0) circle (2)}
  \def\secondcircle{(1,0) circle (2)}
  \fill[yellow!50] \firstcircle;
  \fill[blue!30] \secondcircle;
  \begin{scope}
    \clip \secondcircle;
    \fill[green!40] \firstcircle;
  \end{scope}
  \draw \firstcircle; 
  \draw \secondcircle;
  \node at (-2,0) {$H(X|Y)$};
  \node at (2,0) {$H(Y|X)$};
  \node at (0,0) {$I(X;Y)$};
  \node at (2.8,1.8) {$H(Y)$};
  \node at (-2.8,1.8) {$H(X)$};
\end{tikzpicture}
\]

\textbf{5,6.}
Implicit models learn a mapping $z \mapsto x$
without explicit density estimation -- just samples.
We can no longer compute
$\text{KL} ( p_{\text{data}} \| p_{\text{model}} )$:
we will use other distances (MMD, JSD, EMD, etc.)

A \d{generative adversarial network} (GAN)
is a minimax game between a generator and a discriminator
\[
  \min_G \max_D \E_{ x \sim \text{data} } \log D x + \E_ { z \sim p_z} \log( 1 - D G z ). 
\]

To evaluate the quality of the generated images,
the kernel density estimator (aka \emph{Parzen window density estimator})
does not work well in high dimension.
The \emph{inception score} uses a pretrained classifier:
the class of each generated image should be easy to recognize
$p(y|x)$ has low entropy) and the classes should be diverse
$p(y)$ has high entropy).
\begin{align*}
  \text{IS} &= \exp \bigl[ H(y) - H(y|x) \bigr] \\
  &= \exp \E_{ x \sim \text{generated} } \text{KL} \bigl( p(y|x) \bigm\| p(y) \bigr) 
\end{align*}
It is still suceptible to model collapse.
The \emph{Frechet inception distance} (FID)
compares the mean and covariance of the features (Inception-v3 pool3) of the real and generated images:
\[
d^2 = \n{ m - m_w }^2 + \tr \bigl( C + C_w - 2 (C C_w)^{1/2} \bigr).
\]
Those evaluation methods are not good enough to be used as objectives, though.

The optimal discriminator is
\[ D^*(x) = \dfrac{ p_{\text{data}} (x) }{ p_{\text{data}}(x) + p_{\text{generated}}(x) }; \]
the objective is then
\[ V(G,D^*) = - \log 4 + \text{JSD}( p_{\text{data}} \| p_{\text{generated}} ). \]
The Jensen-Shannon divergence is between the KL (no mode collapse, blurry)
and the inverse KL (mode collapse) divergences.
If the discriminator is too good, it saturates (its gradient is zero -- uninformative):
for the generator loss (only), change the second term from $\log(1-DGz)$ to $-\log DGz$:
the uninformative gradients are no longer for the fake samples but for the real ones.
(It is no longer a zero-sum game: the loss is different for $G$ and $D$.)
% GAN losses
\[
