    \draw (0,0) -- (6,0) -- (6,6) -- (0,6) -- cycle;
    \draw[very thick] (1,1) -- (2,2)
    to[out=90,in=90,looseness=2]
    (4,4) -- (5,5);
    \node[anchor=north] at (3,-.5) {\footnotesize not monotone};
  \end{scope}
  \begin{scope}[shift={(6,0)}]
    \draw (0,0) -- (6,0) -- (6,6) -- (0,6) -- cycle;
    \draw[very thick] (1,1) -- (2.5,2.5);
    \draw[very thick] (3.5,3.5) -- (5,5);
    \node[anchor=north] at (3,-.5) {\footnotesize monotone\\[-5pt]not maximal};
  \end{scope}
  \begin{scope}[shift={(12,0)}]
    \draw (0,0) -- (6,0) -- (6,6) -- (0,6) -- cycle;
    \draw[very thick] (1,1) to[out=75,in=180] (3.5,3.5) -- (5,5);
    \node[anchor=north] at (3,-.5) {\footnotesize maximal\\[-5pt] monotone};
  \end{scope}
  \begin{scope}[shift={(18,0)}]
    \draw (0,0) -- (6,0) -- (6,6) -- (0,6) -- cycle;
    \draw[very thick] (1,1) to[out=75,in=180] (3.5,2) -- (3.5,3.5) -- (5,5);
    \node[anchor=north] at (3,-.5) {\footnotesize maximal\\[-2.5pt]monotone\\[-5pt](not a function)};
  \end{scope}
