  \node[anchor=east]  at (-1.1,1) {\footnotesize yellow};
  \node[anchor=west] at (1.1,1) {\footnotesize blue};
  \node at (0,-.6) {HSV};
\end{tikzpicture}
\quad
\begin{tikzpicture}[>=stealth,yscale=1,xscale=.5,inner sep = 1pt, outer sep = 0pt,baseline=0]
  \node[circle,fill] (B) at (0,0) {};
  \node[circle,fill] (Y) at (-1,1) {};
  \node[circle,fill] (R) at (1,1) {};
  \node[circle,fill] (W) at (0,2) {};
  \draw (B) -- (Y) -- (W);
  \draw (B) -- (R) -- (W);
  \draw (Y) to[out=-15, in=-165] (R);  
  \node[anchor=north] at (0,0) {\footnotesize black};
  \node[anchor=south] at (0,2.1) {\footnotesize white};
  \node[anchor=east]  at (-1.1,1) {\footnotesize yellow};
  \node[anchor=west] at (1.1,1) {\footnotesize blue};
  \node at (0,-.6) {HSL};
\end{tikzpicture}
\quad
\begin{tikzpicture}[>=stealth,yscale=1,xscale=.5,inner sep = 1pt, outer sep = 0pt,baseline=0]
  \node[circle,fill] (B) at (0,0) {};
  \node[circle,fill] (Y) at (-1,1.3) {};
  \node[circle,fill] (R) at (1,.7) {};
  \node[circle,fill] (W) at (0,2) {};
  \draw (B) -- (Y) -- (W);
  \draw (B) -- (R) -- (W);
  \draw (Y) to[out=-35, in=180] (R);
  \node[anchor=north] at (0,0) {\footnotesize black};
  \node[anchor=south] at (0,2.1) {\footnotesize white};
  \node[anchor=east]  at (-1.1,1.3) {\footnotesize yellow};
  \node[anchor=west] at (1.1,.7) {\footnotesize blue};
  \node at (0,-.6) {HCL};
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Tensor learning for regression}\\
  W. Guo and I. Patras (2012)
\end{book}
A \emph{tensor regression}
is a linear regression with tensors,
e.g., $Y_i = X_{ijk\ell} W_{jk\ell} + b$
where the weight tensor $W$ has low weight
(e.g., a CP decomposition -- use alternating optimization)

\nextbook
\begin{book}
  \emph{TensorLy: tensor learning for Python}\\
  J. Kossaifi et al. (2019)
\end{book}

\nextbook
\begin{book}
  \emph{ETAS: an R package for fitting\\ the space time ETAS model of earthquake data}
\end{book}
The ETAS (epidemic-type aftershock sequence) marked point process
is a Hawkes-like model for earthquakes (time, position, magnitude).
% Complicated formula

\nextbook
\begin{book}
  \emph{Just interpolate:\\ kernel ridge regression can generalize}\\
  T. Liang and A. Rakhlin (2018)
\end{book}
In ridge regression
\[ \operatorname*{Minimize}_\beta \n{ y - X \beta } ^2 + \lambda \n{ \beta } ^2 \]
we can let $\beta \to 0$.
If the model is overparametrized,
the OLS solution is not unique and interpolates the data;
the problem becomes
\[
\begin{array}{ll}
  \text{Find} & \beta \\
  \text{To minimize} & \n{ \beta }^2 \\
  \text{Such that} & y = X \beta.
\end{array}
\]

\nextbook
\begin{book}
  \emph{Surprises in high-dimensional\\ ridgeless least squares interpolation}\\
  T. Hastie et al. (2020)
\end{book}
Interpolation does not contradict generalization.

\nextbook
\begin{book}
  \emph{A continuous time view\\ of early stopping for least squares}\\
  A. ALi et al. (2019)
\end{book}
Early stopped gradient approximates ridge regression:
with the gradient flow
and $t=1/\lambda$, the error is at most 1.7 times that of the ridge.
\begin{align*}
  & \beta \leftarrow \beta + \epsilon \dfrac{ X' }{ n } ( y - X \beta ) && \text{Gradient descent}\\
  & \dot \beta = \dfrac{ X' }{ n } ( y - X \beta ) && \text{Gradient flow} \\
  & \beta(\lambda) = ( X' X - n \lambda I )^{-1} X' y && \text{Ridge} \\
  & \beta(t) = ( X' X )^\dagger ( I - \exp - t X' X / n ) X' y
\end{align*}

\nextbook
\begin{book}
  \emph{Computing the Oja median in R:\\ the package OjaNP}\\
  D. Fischer et al. (2020)
\end{book}
There are several multivariate generalizations of the median:
\begin{compactitem}[--]
\item The \emph{marginal median} is the coordinate-wise median;
  it is not affine equivariant;
\item The \emph{Tuckey median} is the intersection of the minimal halfplanes containing at least half the data; 
\item The \emph{spatial median} $\mu$ minimizes $\sum_i \n{ x_i - \mu }_2$;
  it is not affine-equivariant;
\item The \emph{Oja median} is
  \[ \argmin_\mu \sum_{ i_1 < \cdots < i_k } V( x_{i_1}, \dots, x_{i_k} , \mu )\]
  where $V(x_1,\dots,x_{k+1})$ is the volume of the simplex $(x_1,\dots,x_{k+1})$ in $\RR^k$.
\end{compactitem}

They define \emph{signs}
\begin{align*}
  \operatorname{msgn} x &= [ \operatorname{sign} x_1, \dots, \operatorname{sign}x_k ] \\
  \operatorname{msgn}_X x &= \operatorname{msgn}( x - \operatorname{mmed} X ) \\
  \operatorname{ssgn} x &= \dfrac{ x }{ \n x } \text{ if $x \neq 0$ } \\
  \operatorname{ssgn}_X x &= \operatorname{ssgn}( x - \operatorname{smed} X ) \\
  \operatorname{osgn}_X x &= \!\!\!\!\!\!\sum_{ i_1 < \cdots < i_{k-1} } \!\!\!\!\!\nabla_{\!x} \det [ x_{i_1} - m , \dots , x_{i_{k-1}} - m, x - m ]
\end{align*}
and ranks $\tfrac1n \sum \text{sign}(x_i-x)$,
and rank (or sign) correlation matrices.

\nextbook
\begin{book}
  \emph{Covatest: an R package for selecting a class\\ of space-time covariance functions}\\
  C. Cappello et al. (2020)
\end{book}
Classes of space-time covariance functions include:
\begin{compactitem}[--]
\item Sum-product: the increments of $C$, in the space and time directions, are constant
  \[ C( \mathbf h, u ) = k_1 C_0(\mathbf h) C_1(u) + k_2 C_2(\mathbf h) + k_3 C_3(u) ; \]
\item Integrated product: the increments of $1/C$ are constant; 
\item Gneiting: the increments of $\log C$ are constant.
\end{compactitem}

\nextbook
\begin{book}
  \emph{BayesNetBP: an R package for probabilistic reasoning in Bayesian networks}\\
  H. Yu et al. (2020)
\end{book}
Exact inference in directed probabilistic graphical models (PGM), assuming the structure known
(use \texttt{bnlearn}, \texttt{deal}, \texttt{catnet}, \texttt{pcalg} if needed) --
\texttt{gRain} is limited to discrete Bayesian networks.

\nextbook
\begin{book}
  \emph{mlogit: random utility models in R}\\
  Y. Croissant (2020)
\end{book}
R package for generalizations of the multinomial logit/probit model
(modeling discrete choices driven by n unobserved utility function):
heteroskedasticity,
correlated errors,
individual heterogeneity (mixed models).

\nextbook
\begin{book}
  \emph{Pseudo-counts:\\ how to compute them efficiently in R}\\
  M. Happ et al. (2020)
\end{book}
Comparing two or more samples with rank-based tests
can lead to paradoxical results
(e.g., $\mu_1 < \mu_2 < \mu_3 < \mu_1$):
replace the ranks
$\tfrac1a \sum \hat F(x)$
with the pseudo-ranks $\hat F(x)$
where
\begin{align*}
  Y &\sim \text{Categorical} \bigl( \llbracket 1, a \rrbracket, p \bigr) \\
  X & \sim F_Y \\
  F &= \sum p_i F_i
\end{align*}

\nextbook
\begin{book}
  \emph{A data envelopment analysis\\ toolbox for Matlab}\\
  I.C. \'Alvarez et al. (2020)
\end{book}
Data envelopment analysis (DEA) is a way of measuring the ``distance''
(of a firm, turning some input into some output) to the efficient frontier.
\begin{align*}
  n &\text{: \# firms}  & X \in \RR^{m\times n} & \text{ inputs} \\
  m &\text{: \# inputs}  & \rlap{\ensuremath{Y \in \RR^{s\times n}}} \hphantom{X \in \RR^{m\times n}} & \text{ outputs} \\
  s &\text{: \# outputs} 
\end{align*}
Let
\( P = \{ (x,y) : \exists \lambda \in \RR_+^n
\ x \geq X \lambda , \ y \leq Y \lambda , \ \lambda' \mathbf 1 = 1 \}
\)
be the set of attainable solutions
(remove $\lambda ' \mathbf = 1$ is everything is scalable).

The \emph{radial input-oriented model} measures the efficiency of firm $i$ as
$\theta_i = \min \{ \theta \,: \,( \theta x_i, y_i ) \in P \}$.
If $\theta_i < 1$, we can improve $(x_i,y_i)$ (produce the same with less).
The \emph{input excess} and \emph{output shortfall}
are $\theta x - X \lambda$ and $Y \lambda - y$.
Similarly, the radial output oriented model is
$\phi_i = \max \{ \phi \,:\,(x_i,\phi y_i) \in P \}$.
There are also directional variants.
\[
\begin{tikzpicture}[>=stealth,yscale=.4,xscale=.4,inner sep = 1pt, outer sep = 0pt,baseline=0]
