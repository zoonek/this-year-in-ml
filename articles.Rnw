  \draw[col1] (A-\i) -- (B-\i); 
\foreach[evaluate=\i as \j using int(\i+1)] \i in {1,2,3,4,5,6} 
  \draw[col2] (A-\j) -- (B-\i); 
\foreach[evaluate=\i as \j using int(\i-1)] \i in {1,2,3,4,5,6} 
  \draw[col3] (A-\j) -- (B-\i); 
\end{tikzpicture}
