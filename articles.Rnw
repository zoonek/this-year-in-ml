\nextbook
\begin{book}
  \emph{Community detection via semi-synchronous label propagation algorithms}\\
  G. Cordasco and L. gargano 
\end{book}
Label propagation (LPA) computes communities on a graph, by starting to put each node in its own
community and then assigning each node to the majority community of its neighbours
(breaking ties at random),
until convergence.
The synchronous version of the algorithm can exhibit cyclic oscillations;
the asynchronous version can wrongly produce a giant community.

For bipartite graphs,
alternatingly updating all the nodes of one of the partitions is more stable.
This semi-asynchronous algorithm can be generalized to arbitrary graphs,
by choosing a node colouring such that adjacent nodes have different colours.

\nextbook
\begin{book}
  \emph{Peirce's tutorial on existential graphs}\\
  J.F. Sowa 
\end{book}

In MS514, Peirce presents a graphical language for first order logic (FOL).

A \emph{line of identity} represents an existential classifier.

\begin{align*}
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \node (B) at (0,0) {\phantom{$A$}};
    \node (A) at (1,0) {\phantom{$A$}};
    \draw[thick] (B) -- (A);
  \end{tikzpicture}
  && \exists x
\end{align*}

It can be connected to one or several predicates.
\begin{align*}
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (B) at (0,0) {\phantom{$A$}};
    \node (A) at (1,0) {$A$};
    \draw[thick] (B) -- (A);
  \end{tikzpicture}
  && \exists x \ A(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (A) at (0,0) {$A$};
    \node (B) at (1,0) {$B$};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \exists x \ A(x) \wedge B(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \node (C) at (-90:6mm) {$C$};
    \node (A) at (-210:6mm) {$A$};
    \node (B) at (-330:6mm) {$B$};
    \draw[thick] (0,0) -- (A);
    \draw[thick] (0,0) -- (B);
    \draw[thick] (0,0) -- (C);
  \end{tikzpicture}
  && \exists x \ A(x) \wedge B(x) \wedge C(x)\\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (S) at (0,0) {$S$};
    \node (V) at (1,0) {$V$};
    \node (O) at (2,0) {$O$};
    \draw[thick] (S) -- (V) -- (O);
  \end{tikzpicture}
  && \exists x,y \ S(x) \wedge O(y) \wedge V(x,y)
\end{align*}

Conjunction is implicit.
\begin{align*}
  &
  \begin{tikzpicture}[>=stealth,xscale=.9,yscale=1,inner sep=2pt,outer sep=0pt,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (AA) at (0,0) {\vphantom{$A$}};
    \node (A)  at (1,0) {$A$};
    \node (BB) at (1.5,0) {\vphantom{$B$}};
    \node (B)  at (2.5,0) {$B$};
    \draw[thick] (AA) -- (A);
    \draw[thick] (BB) -- (B);
  \end{tikzpicture}
  && \exists x \exists y \ A(x) \wedge B(y)
\end{align*}

Shaded ellipses represent negations.
\begin{align*}
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.65,.12) ellipse (6mm and 3mm);
    \node (B) at (0,0) {\phantom{$A$}};
    \node (A) at (1,0) {$A$};
    \draw[thick] (B) -- (A);
  \end{tikzpicture}
  && \neg \exists x \ A(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.85,.12) ellipse (4mm and 3mm);
    \node (B) at (0,0) {\phantom{$A$}};
    \node (A) at (1,0) {$A$};
    \draw[thick] (B) -- (A);
  \end{tikzpicture}
  && \exists x \ \neg A(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.65,.12) ellipse (8mm and 3mm);
    \draw[fill=white] (.95,.12) ellipse (3mm and 2mm);
    \node (B) at (0,0) {\phantom{$A$}};
    \node (A) at (1,0) {$A$};
    \draw[thick] (B) -- (A);
  \end{tikzpicture}
  && \forall x \ A(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.55,.12) ellipse (8mm and 3mm);
    \draw[fill=white] (.95,.12) ellipse (3mm and 2mm);
    \node (A) at (0,0) {$A$};
    \node (B) at (1,0) {$B$};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \forall x\  A(x) \Rightarrow B(x) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (p) at (0,0) {$p$};
    \node (q) at (1,0) {$q$};
  \end{tikzpicture}
  && p \wedge q \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.05) ellipse (9mm and 3.5mm);
    \draw[fill=white] (1,.05) ellipse (2.5mm and 2mm);
    \draw[fill=white] (0,.05) ellipse (2.5mm and 2mm);
    \node (p) at (0,0) {$p$};
    \node (q) at (1,0) {$q$};
  \end{tikzpicture}
  && p \vee q \\ 
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.05) ellipse (9mm and 3.5mm);
    \draw[fill=white] (1,.05) ellipse (2.5mm and 2mm);
    \node (p) at (0,0) {$p$};
    \node (q) at (1,0) {$q$};
  \end{tikzpicture}
  && p \Rightarrow q \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=0pt,outer sep=0pt,baseline=0]
    \draw[fill=black!15] (-.1,.25) ellipse (6.5mm and 5mm);
    %\draw[fill=white] (0,0) ellipse (2.5mm and 2mm);
    \node[circle,inner sep=.5pt] (A) at (0,.5) {$A$};
    \node[circle,draw,fill=white,inner sep=.5pt] (B) at (0,0) {$B$};
    \draw[thick] (A) to[out=180, in=180, looseness=2] (B);
  \end{tikzpicture}
  && \forall x \ A(x) \Rightarrow B(x)\text{, \ie, } A \subset B \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.75,.05) ellipse (11mm and 4mm);
    \draw[fill=white] (.5,.05)  ellipse (2mm and 2mm);
    \draw[fill=white] (1,.05)   ellipse (2mm and 2mm);
    \draw[fill=white] (1.5,.05) ellipse (2mm and 2mm);
    \node (p) at (0,0) {$p$};
    \node (q) at (.5,0) {$q$};
    \node (r) at (1,0) {$r$};
    \node (s) at (1.5,0) {$s$};
  \end{tikzpicture}
  && p \implies (q \wedge r \wedge s ) \\
\end{align*}

Lines can be replaced with explicit equalities
\begin{align*}
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \draw[thick] (0,0) -- (1,0);
  \end{tikzpicture}
  && \exists x \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \node (A) at (-.2,0) {\vphantom{is}};
    \node (B) at (1.2,0) {\vphantom{is}};
    \node (is) at (.5,0) {is};
    \draw[thick] (A) -- (is) -- (B);
  \end{tikzpicture}
  && \exists x \exists y \ x = y\\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.1) ellipse (3mm and 2mm);
    \node (A) at (-.2,0) {\vphantom{is}};
    \node (B) at (1.2,0) {\vphantom{is}};
    \node (is) at (.5,0) {is};
    \draw[thick] (A) -- (is) -- (B);
  \end{tikzpicture}
  && \exists x \exists y \ x \neq y \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.1) ellipse (2mm and 2mm);
    \node (A) at (-.2,0) {\vphantom{is}};
    \node (B) at (1.2,0) {\vphantom{is}};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \exists x \exists y \ x \neq y \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.12) ellipse (2mm and 2mm);
    \node (A) at (-.2,0) {$A$};
    \node (B) at (1.2,0) {$A$};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \exists x \exists y \ x \neq y \wedge A(x) \wedge A(y) \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.5,.12) ellipse (10mm and 3mm);
    \draw[fill=white] (.5,.12) ellipse (2mm and 2mm);
    \node (A) at (-.2,0) {$A$};
    \node (B) at (1.2,0) {$A$};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \text{at most one }A \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0,
      baseline=0pt,every node/.style={anchor=base}
    ]
    \draw[fill=black!15] (.8,.12) ellipse (7mm and 3mm);
    \draw[fill=white] (.5,.12) ellipse (2mm and 2mm);
    \node (A) at (-.2,0) {$A$};
    \node (B) at (1.2,0) {$A$};
    \draw[thick] (A) -- (B);
  \end{tikzpicture}
  && \text{exactly one }A \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \draw[fill=black!15] (90:6mm) ellipse (2mm and 2mm);
    \draw[fill=black!15] (210:6mm) ellipse (2mm and 2mm);
    \draw[fill=black!15] (330:6mm) ellipse (2mm and 2mm);
    \draw[thick] (0,0) ellipse (6mm and 6mm);
  \end{tikzpicture}
  && \text{at least 3} \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \draw[fill=black!15] (0,0) ellipse (6mm and 6mm);
    \draw[fill=white] (-90:3mm)  ellipse (1.5mm and 1.5mm);
    \draw[fill=white] (-210:3mm) ellipse (1.5mm and 1.5mm);
    \draw[fill=white] (-330:3mm) ellipse (1.5mm and 1.5mm);
    \draw[thick] (0,0) -- (-90:8mm);
    \draw[thick] (0,0) -- (-210:8mm);
    \draw[thick] (0,0) -- (-330:8mm);
  \end{tikzpicture}
  && \text{at most 3} \\
  &
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
    \draw[fill=black!15] (0,0) ellipse (4mm and 4mm);
    \draw[fill=white] (-90:2mm)  ellipse (1mm and 1mm);
    \draw[fill=white] (-210:2mm) ellipse (1mm and 1mm);
    \draw[fill=white] (-330:2mm) ellipse (1mm and 1mm);
    \draw[fill=black!15] (90:7mm) ellipse (2mm and 2mm);
    \draw[fill=black!15] (210:7mm) ellipse (2mm and 2mm);
    \draw[fill=black!15] (330:7mm) ellipse (2mm and 2mm);
    \draw[thick] (0,0) ellipse (7mm and 7mm);
    \draw[thick] (0,0) -- (-90:7mm);
    \draw[thick] (0,0) -- (-210:7mm);
    \draw[thick] (0,0) -- (-330:7mm);
  \end{tikzpicture}
  && \text{exactly 3}
\end{align*}

There are 3 rules of inference:
\begin{compactitem}[--]
\item[1.] You can erase anyting in the unshaded areas (e.g., cut lines);
  you can add anything in the shaded areas\;
\item[2.] Lines can be extended into any enclosed area;
  lines can be retracted from any enclosed areas;
  anything can be copied inwards;
  anything can be deleted outwards;
\item[3.] You can add or remove vacant ring-shaped areas (double negations).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Deep learning on graphs}\\
  Y. Ma and J. Tang
\end{book}

\textbf{4.} Graph embedding models look for (graph or node)
representations preserving some information about the graph or node,
\[
\begin{tikzpicture}[>=stealth,xscale=1.7,yscale=.7,inner sep=1pt,outer sep=1pt,baseline=0]
  \node (G)  at (0,2.5) {graph};
  \node (E)  at (2,2.5) {embedding};
  \node (I1) at (0,1) {information};
  \node (I2) at (2,1) {information};
  \node (R)  at (1,0) {reconstruction error};
  \draw[->] (G) to node[pos=.4,left=0pt] {\footnotesize extractor} (I1);
  \draw[->] (E) to node[pos=.4,right=0pt] {\footnotesize reconstructor} (I2);
  \draw[->] (I1) -- (R);
  \draw[->] (I2) -- (R);
\end{tikzpicture}
\]
e.g., random-walk-based co-occurrence
(DeepWalk is word2vec on random walks)
or structural similarity (struc2vec)
\begin{align*}
  g_0(v_1,v_2) & = 0 \\
  g_k(v1,v2) &= g_{k-1}(v_1,v_2) + d\bigl( s N_k(v_1) , s N_k(v_2) \bigr) 
\end{align*}
where
\begin{align*}
  & v_1, v_2 \text{ are nodes} \\
  & N_k(v) \text{ is the set of $k$-hop neighbours of $v$} \\
  & s(N) \text{ is the degree distribution of the nodes in $N$} \\
  & d \text{ is the DTW distance}
\end{align*}
or neighbourhood similarity
\[ s_{ij} = \dfrac{ A_i A_j ' }{ \n{ A_i } \n{ A_j } } \]
or community membership,
or the adjacency matrix
\[ A_{ij} \sim \text{Bernoulli} \bigl( \sigma( u_i ' u_j ) \bigr) . \]

\textbf{5.}
GNNs combine filtering layers
(which change the features but not the graph structure)
and pooling layers (which coarsen the graph).

Filtering layers include
\begin{compactitem}[--]
\item Spectral filters
  \( f \longmapsto U \gamma(\Lambda) U' f, \)
  where
  \begin{align*}
    & L = D - A \text{ or } D^{-1/2} (D-A) D^{-1/2} \\
    & L = U \Lambda U' \\
    & \gamma(\lambda) = ( 1 + c \lambda )^{-1} \text{ (low pass filter)}
  \end{align*}
  or $\gamma$ is a (learned) Chebychev polynomial;
\item Aggregation of the neighbouring values (mean, sum, max,
  or even LSTM for some (possibly arbitrary) order of the neighbours);
\item Attention, \ie, weighted average of the neighbouring values,
  with data-dependent weights;
\item Mixture models (MoNet) are a type of attention
  where the weights are computed from the degrees
  \begin{align*}
    c_{ij} &= \begin{bmatrix} \sqrt{ d_i } \\ \sqrt{ d_j } \end{bmatrix} \\
    \alpha_{ij} &= \exp - \tfrac12 \n{ c_{ij} } ^2 _{ (\mu,\Sigma) } \\
    \n{ c }^2_{(\mu,\Sigma)} &= (c-\mu) ' \Sigma^{-1} (c-\mu) \\
    \mu, \Sigma &\text{: learnable parameters} 
  \end{align*}
\item GRU and LSTM cells
  (considering that the aggregated current value of the neighbours is the previous state).
\end{compactitem}

Flat graph pooling contracts the graph to a single node,
by aggregating the node features with mean or max,
or with a gating mechanism.
\[
\begin{tikzpicture}[>=stealth,xscale=1.7,yscale=.7,inner sep=1pt,outer sep=1pt,baseline=0]
  \node[anchor=east] (A) at (0,1) {node features};
  \node (B) at (1,2) {node weights};
  \node (C) at (1,0) {node features};
  \node[anchor=west] (D) at (2,1) {multiply};
  \draw[->] (A) -- (B);
  \draw[->] (A) -- (C);
  \draw[->] (B) -- (D);  
  \draw[->] (C) -- (D);  
\end{tikzpicture}
\]

Hierarchical pooling progressively shrinks the graph,
\begin{compactitem}[--]
\item by selecting the most ``important'' nodes, where the importance
  is computed from the node features, directly (gPool) or with a GCN (SAGPool),
\item or by collapsing nodes into ``supernodes'', computed with
  spectral clustering (EigenPool) or with a GCN to get cluster
  membership probabilities (diffpool)
  \begin{align*}
    & A \leftarrow S' A S \\
    & F \leftarrow S' F
  \end{align*}
\end{compactitem}

\textbf{6.} GNNs can be the target of attacks
(credit scoring, spam, etc.).
\emph{Evasion attacks} target a trained network;
\emph{poisoning attacks} corrupt the training data.
The goal can be targeted (change the classification of a few nodes)
or not (reduce the model performance).
The attacker may alter the node features,
add or delete nodes or edges;
the attacker may have access to the model weights,
or to the training data (greybox attack: they train a surrogate model and attack it),
or just a black box.

White box attacks often use min-max (or bilevel) optimization,
or meta-learning;
black-box attacks can use reinforcement learning.

To defend against those attacks:
\begin{compactitem}[--]
\item Use adversarial samples during training;
\item Clean the graph (``purification''), removing edges whose ends have low feature similarity,
  or reducing the rank of the adjacency matrix; 
\item Downweight suspicious nodes (replace the hidden representations
  with Gaussian distributions, and the the variance as a suspiciousness gauge)
  or penalize suspicious edges
  (with attention weights, trained on a clean graph to which you apply
  an adversarial attack, so that you know which edges are adversarial);
\item Jointly learn the purification (a new adjacency matrix, $S$, close to the original one $A$,
  low rank, with smooth features), and train a GNN.
\end{compactitem}

\textbf{7.} To train GNNs on large networks,
GraphSAGE samples the neighbours.
Instead of sampling the neighbours for each node separately,
sample a set of nodes $N$ (you need to define the probability distribution)
and use $\mathscr N _i \inter N$ instead of $\mathscr N_i$, for a whole layer
(or for all layers).

Edge-based node samplers sample pairs of nodes with high influence on one another.

Random-walk-based samplers improve the connectivity.

\textbf{9.}
LSTMs can be generalized to trees
or arbitrary graphs (Tree-LSTM, Graph-LSTM):
just aggregate the inputs before feeding them to the LSTM cell.

To generate graphs (AE, VAE, GAN), simply generate the adjacency matrix.

\textbf{10.}
For many NLP tasks, first process the sentence with a BiLSTM;
then use a GNN on the parse treee.

Node embeddings of knowledge graphs help various downstream tasks, and knowledge graph completion.

\textbf{14.}
To limit oversmoothing, add jump-layer connections,
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=3pt,outer sep=1pt,baseline=0]
  \node (A) at (0,0) {};
  \node[draw,thick,inner sep=3pt] (B) at (1,0) {};
  \node[draw,thick,inner sep=3pt] (C) at (2,0) {};
  \node[draw,thick,inner sep=3pt] (D) at (3,0) {};
  \node[draw,thick,inner sep=3pt] (E) at (4,0) {};
  \node (F) at (5,0) {};
  \draw[->] (A) to[bend left=20] (F);
  \draw[->] (B) to[bend left=20] (F);
  \draw[->] (C) to[bend left=20] (F);
  \draw[->] (D) to[bend left=20] (F);
  \draw[->] (A) -- (B);
  \draw[->] (B) -- (C);
  \draw[->] (C) -- (D);
  \draw[->] (D) -- (E);
  \draw[->] (E) -- (F);
\end{tikzpicture}
\]
randomly drop edges,
or add regularization terms to force the representations of distant nodes to be distinct.

Self-supervised learning on graphs can predict:
\begin{compactitem}[--]
\item Node properties (degree, centrality, clustering coefficient, features);
\item Pairwise similarity or ranking of node properties;
\item Edge presence (if some were removed before training);
\item Pairwise distances;
\item Context (word2vec).
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{A fast and high quality multilevel scheme\\ for partitioning irregular graphs}\\
  G. Karypis and V. Kumar (1998)
\end{book}
Multilevel partitioning (Metis):
\begin{compactitem}[--]
\item First reduces the size of the graph (coarsening) by collapsing some edges;
\item Then partitions (clusters) it, using an algorithm of your choice;
\item Finally refines the solution
  back to the original graph (Kernigham-Lin).
\end{compactitem}
\nextbook
\begin{book}
  \emph{A fast kernel-based multilevel algorithm\\ for graph clustering}\\
  I. Dhillon et al. (2005)
\end{book}
To cluster the nodes of a graph, use (weighted) $k$-means
with kernel matrix
$\sigma I + A$, $\sigma I - D + A$
or $\sigma D^{-1} + D^{-1} A D^{-1}$
(and $w=1$ or $w=\text{degree}$).

To coarsen a graph (prior to clustering),
visit the vertices in a random order:
\begin{compactitem}[--]
\item If $x$ is marked, continue;
\item If $x$ is unmarked and all its neighbours are marked, mark it and continue;
\item Otherwise, merge $x$ with the vertex $y$ maximizing
  \[ \dfrac{ e_{xy} }{ w_x } + \dfrac{ e_{xy} }{ w_y } \]
  and mark both $x$ and $y$.
\end{compactitem}

This can also be used to order the nodes, when plotting the adjacency matrix.

\nextbook
\begin{book}
  \emph{Weighted graph cuts without eigenvectors:\\ a multilevel approach}\\
  I.S. Shillon et al. (2007)
\end{book}
More details on the \texttt{graclus} algorithm.

\nextbook
\begin{book}
  \emph{Simplifying graph convolutional networks}\\
  F. Wu et al. (2019)
\end{book}
Remove the nonlinearities and collapse the weight matrices between consecutive layers:
\begin{align*}
  Y &= \text{softmax}( S^k X W ) \\
  S &= D^{-1/2} (A+I) D^{-1/2}
\end{align*}
  
\nextbook
\begin{book}
  \emph{Knowledge graphs: a guided tour}\\
  A. Hogan
\end{book}
% Literature review

\nextbook
\begin{book}
  \emph{General $E(2)$-equivariant steerable CNNs}\\
  M. Weiler and G. Cesa (2019)
\end{book}
Consider a Euclidean graph $G \leq E(2) = ( \RR, + ) \rtimes O(2)$.
A \emph{steerable feature field} is defined by a feature field and its type
\begin{align*}
  f &: \RR^2 \to \RR^c && \text{feature field} \\
  \rho &: G \to \text{GL}(\RR^c) && \text{representation}.
\end{align*}
For instance, for scalar fields, or RGB fields, $\rho = 1$
(trivial representation), but for vector fields,
$\rho(t,g) = g$ is another meaningful choice.

Equivariant maps are convolutions with a \emph{steerable} kernel
$k: \RR^2 \to \RR^{ c_{\text{out}} \times c_{\text{in}} } $
\[ \forall g \in G \ \forall x \in \RR^2 \
k(gx) = \rho_{\text{out}}(g) k(x) \rho_{\text{in}}(g^{-1}). \]
(To solve those constraints, first decompose $\rho_{\text{out}}$
and $\rho_{\text{in}}$ into irreducible components.)

You cannot use arbitrary nonlinearities
(they have to be equivariant as well):
\begin{compactitem}[--]
\item For unitary representations, nonlinearities acting only on the norm
  $ x \mapsto \sigma(x) \cdot x / \n x$
  are equivariant:
  \begin{compactitem}[\ensuremath{\cdot}]
  \item NormReLU, $\sigma(u) = \text{ReLU}(u-b)$
  \item Squashing, $\sigma(u) = u^2 / ( u^2 + 1 )$
  \item Gating $\sigma(u) = u / ( 1 + e^{-s(x)} )$,
    where $s$ is a scalar field;    
  \end{compactitem}
\item For regular representations
  (representations on $\RR^{\va G}$, permuting the axes),
  or quotient representations
  (regular representations of $G/H$),
  coordinatewise nonlinearities are equivariant.
\end{compactitem}

Implementation in \texttt{e2cnn}.
  
\nextbook
\begin{book}
  \emph{Overcoming oversmoothness\\ in graph convolutional networks\\ via hybrid scattering networks}\\
  F. Wenkel et al.
\end{book}
The \emph{lazy random walk matrix}
(the random walk matrix is $WD^{-1}$)
$P = \tfrac12(I+WD^{-1})$
\[ (PX)_i = \dfrac12 X_i + \sum_{j \sim i} \dfrac{ X_j }{ d_j } \]
defines wavelets
\begin{align*}
  \Psi_0 &= I = P \\
  \Psi_k &= P^{ 2^{k-1} } - P^{ 2^k }
\end{align*}
and the \emph{geometric scattering transform}
\[ U: x \mapsto ( \Psi_{k_m} \circ \sigma \circ \cdots \circ \Psi_{k_2} \circ \sigma \circ \Psi_{k_1} ) (x) . \]

Combine low-pass layers
$X \mapsto \sigma( A X \Theta + B ), $
band-pass layers
$X \mapsto \sigma\bigl( U (X \Theta) + B \bigr)$,
aggregation (or concatenation, or attention)
and \emph{graph residual convolution}
\[ X \mapsto \bigl[ (1-\lambda) I + \lambda W D^{-1} \bigr] X \Theta + B \]
to limit oversmooting and underreaching in GNNs.
\nextbook
\begin{book}
  \emph{Scattering GCN: overcoming oversmoothness in graph convolution networks}\\
  Y. Min et al. (2020)
\end{book}
% Idem
  
\nextbook
\begin{book}
  \emph{Can hybrid geometric scattering networks help solve the maximum clique problem?}\\
  Y. Min et al. (2022)
\end{book}
Use a scattering GCN to predict which nodes are in the maximum clique,
using eccentricity, clustering coefficient, and logarithm of degree as node features,
and \[ L(p) = - p' W p + \beta p' \bar W p \]
as loss,
where $\bar W$ is the adjacency matrix of the complement of $G$ (same node, non-edges as edges).

