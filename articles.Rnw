\nextbook
\begin{book}
  \emph{The curse of recursion: training on\\ generated data makes models forget}\\
  O. Shumailov et al.
\end{book}
Training on generated data causes model collapse:
\begin{compactitem}[--]
\item At each generation, since the data is finite, there is a nonzero probability that some of the data distribution will be lost;
  the tails will disappear, and the distribution will progressively drift; 
\item Since the model is only an approximation
  (it does not perfectly reproduce the target distribution),
  the generated data will follow a slightly different distribution,
  for instance, assigning a nonzero probability outside the support of the target distribution.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Differentiable Euler characteristic transforms for shape classification}\\
  E. R\"oell and B. Rieck
\end{book}
The Euler characteristic of a simplicial complex $K$ is
\[ \chi(K) = \sum_{ n \geq 0 } (-1)^k \va{ K^n } \]
where $\va{ K^n}$ is the number of $n$-simplices.
If the 0-simplices $\sigma \in K^0$
have coordinates $x_\sigma \in \RR^n$,
a function $f: \RR^n \to R$
defines a function $f: K \to \RR$ by
\begin{align*}
  \tilde f(\sigma) &= x_\sigma &&\text{for 0-simplices} \\
  \tilde f(\sigma) &= \max_{ \tau \subset \sigma} \tilde f(\tau) &&\text{for higher-dimensional simplices}
\end{align*}
and a filtration
$K_r = \tilde f^{-1} \bigl( (-\infty , r ] \bigr) $.

The \emph{Euler characteristic transform} (ECT)
of $K$ is the function
\[ \left\{
\begin{array}{rcl}
  \SS^{n-1} \times \RR & \longrightarrow & \ZZ \\
  (\xi,h) & \longmapsto & \chi \bigl( \tilde f^{-1}_\xi \bigl( (-\infty,r] \bigr)\bigr)
\end{array}
\right.    
\]
where $f_\xi = \langle \bigcdot , \xi \rangle$.

It can be written as a sum of step functions
\[ \text{ECT}(\xi, h ) = \sum_k (-1)^k \sum_{ \sigma_k } \mathbf 1_{
  \bigl[ \tilde f_\xi ( \sigma_k ) , \infty \bigr)
  } (h) . \]
To make it differentiable, replace the step functions with sigmoids.  

\nextbook
\begin{book}
  \emph{Beyond word frequency: bursts, lulls, and scaling in the empirical distribution of words}\\
  E. G. Altmann et al. 
\end{book}
Words have different recurrence time distributions;
they can be modeled with a ``stretched exponential'' (aka Weibul)
\[ F_\beta(\tau) = \exp ( - a \tau ^ \beta ) . \]
This can be explained with a renewal process:
the probability of using a word decays as a power law since the last use of that word.

