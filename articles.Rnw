\draw[->] (z) -- (G);
\draw[->] (D) -- (output);
\draw[->] (G) -| (D);
\draw[->] (y) -| (D);
\end{tikzpicture}
\]
with \emph{gradient penalty}
and \emph{perceptual loss} 
($L^2$ norm of the difference of CNN features).
\nextbook
\begin{book}
  \emph{Improved training of Wasserstein GANs} \\
  I. Gulrajani et al.
\end{book}
Replace the weight clipping used to make the WGAN critic Lipschitz with a penalty on the norm of its gradient. 

\nextbook
\begin{book}
  \emph{Non-local neural networks} \\
  X. Wang et al.
\end{book}
Self-attention, for images, is a generalization of non-local means,
\[ y_i \propto \sum_j w( x_i , x_j ) g(x_j) \]
with, e.g., $w(x_i,x_j) = \exp (A x_i)' (B x_j)$.

\nextbook
\begin{book}
  \emph{Constructing unrestricted adversarial examples with generative models} \\
  Y. Song et al. (2018)
\end{book}
Train a GAN to model the class-conditioned distribution over inputs,
then search its latent space 
(conditional on the desired class)
for an adversarial example 
(of the desired class according to the GAN, but misclassified by the target classifier).

\nextbook
\begin{book}
  \emph{MolGAN: an implicit generative model\\ for small molecular graphs} \\
  N. De Cao and T. Kipf
\end{book}
Use a GAN (WGAN with gradient penalty) to generate molecules
(a vector for the atom types, a matrix for the link types, for a fixed number of atoms)
and add a loss to force the generator to output molecules with desirable properties 
(e.g., easy to synthesize, using the RDKit chemoinformatics software).

