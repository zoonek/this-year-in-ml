  \draw (i0) -- (H) -- (m0) -- (o0);
  \draw (i1) -- (m1) -- (o1);
  \draw[blue] (i2) -- (X) -- (Z) -- (o2);
  \draw[blue] (oX) -- (X);
  \draw[blue] (oZ) -- (Z);
  \node[anchor=east] at (0,.5) {$\dfrac{\ket{00} + \ket{11}}{\sqrt2}$};
\end{tikzpicture}
\]

The \emph{query} for $x \in \{0,1\}^N$ is the unitary map (a permutation matrix)
\[ O_x : \left\{
\begin{array}{rcl}
  ( \CC^2 )^{\tens n} \tens \CC^2 & \longrightarrow & ( \CC^2 )^{\tens n} \tens \CC^2  \\
  \ket{ i, b } & \longmapsto & \ket{ i, b \oplus x_i }
\end{array}
\right.
\]
where $n = \lceil \log_2 N \rceil$.
The \emph{phase query} $O_{x,\pm}$ uses
$\ket{ i, - } \mapsto (-1)^{x_i} \ket{ i, - }$ instead.

The \emph{Deutsch-Josza algorithm} tells if $x \in \{0,1\}^N$ is
constant or half 1's and half 0's.
