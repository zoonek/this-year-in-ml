  \emph{Screening data points\\ in empirical risk minimization\\ via ellipsoidal regions and safe loss functions}\\
  G. Mialon et al. (2020)
\end{book}
% Not read
\begin{align*}
  f^*(y) &= \max_t \langle t,y \rangle - f(t) &&
  \hspace{-1cm}\text{Fenchel conjugate} \\
  f^{**}(t) &= \max_y \langle y,t\rangle - f^*(y) &&\hspace{-1cm}\text{biconjugate} \\
  f_\mu(t) &= \max_y \langle y,t\rangle - f^*(y) - \mu \Omega(y) \\
  &= \min_z f(z) + \mu \Omega^* \left( \dfrac{ t-z }{ \mu } \right) \\
  &= t \mathbin{\square_\mu} \Omega^* &&\hspace{-1cm}\text{infimum convolution}
\end{align*}

\nextbook
\begin{book}
  \emph{safeaipackage: a Python package\\ for AI risk measurement }\\
  G. Babaei
\end{book}
Given a (nonnegative) random variable $Y$:
\begin{compactitem}[--]
\item The Lorenz curve is \texttt{(ts, cumsum(Y[i]))},
  where \texttt{ts=linspace(0,1,len(Y))},
  \texttt{i=argsort(Y)};
\item The dual Lorenz curve uses \texttt{i=argsort(-Y)};
\item The concordance curve uses \texttt{i=argsort($y'$)}
  where $y'$ is another variable.
\end{compactitem}
The area under the concordance curve is
\[ \dfrac12 \dfrac{
  \cov \bigl[
    Y[i'] , F(Y[i])
    \bigr]
}{
  \cov \bigl[
    Y[i] , F(Y[i])
    \bigr]
} - \dfrac12 \in [0,1]
\]
Different choices of $(Y,Y')$ give different measures:
\begin{compactitem}[--]
\item Accuracy (``RGA''): $(y,\hat y)$ (for binary data, this is the AUC);
\item Robustness: $(\hat y, \hat y^p)$, where $\hat y^p$ are forecasts after some perturbation;
\item Explainability: $(\hat y, \hat y^{-k})$, where $\hat y^{-k}$ is the forecast of a model fitted without variable $k$;
\item Fairness: $(\hat y, \hat y^{-k})$, where $k$ is some protected attribute;
\item Privacy: $(\hat y, \hat y^{-m})$, where $\hat y^{-k}$ are forecasts of a model fitted without observation $m$.
\end{compactitem}

