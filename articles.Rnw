Ensemble several models: different loss functions (SMAPE, MASE, MAPE),
window lengths, random initialization.

\nextbook
\begin{book}
  \emph{How powerful are graph neural networks?}\\
  K. Xu et al. (2019)
\end{book}
For $\epsilon \in \RR \setminus \QQ$,
there exists $f:\RR\to\RR$ such that
\[ \left\{
\begin{array}{rcl}
  \QQ \times \text{Multisets}(\QQ) & \longrightarrow & \RR \\
  \bigl( u , (v_i)_i \bigr) & \longmapsto & (1+\epsilon) f(u) + \sum\limits_i f(v_i) 
\end{array}
\right. \]
be injective.
This suggests the following aggregation, for graph neural nets (GIN):
\[
h_v \leftarrow \text{MLP}
\biggl(
(1+\epsilon) h_v + \sum_{ u \in N(v) } h_h 
\biggr)
\]
where $\epsilon$ is learned.

\nextbook
\begin{book}
  \emph{Principal neighbourhood aggregation\\ for graph nets}\\
  G. Corso et al. (2020)
\end{book}
% PNA
Do not use a single aggregation operator, but several (mean, standard deviation, minimum, maximum),
and rescale them with the degree (on a logarithmic scale, otherwise the messages would be amplified
or attenuated exponentially).
\[
\left(
\dfrac{ \log(d+1) }{ \langle \log(d+1) \rangle }
\right)^{ \!\! +1,\ -1\text{, or } 0 }
\]

\nextbook
\begin{book}
  \emph{Learning aggregation functions}\\
  G. Pellegrini et al. (2021)
\end{book}
Principal neighbourhood aggregation (PNA) uses a finite set of ($4\times3=12$) aggregations.
Instead, try
\begin{align*}
  \text{LAF}(x) &= \dfrac{
    \alpha L_{a,b}(x) + \beta L_{c,d}(1-x)
  }{
    \gamma L_{d,f}(x) + \delta L_{g,h}(1-x)
  } \\
  L_{a,b}(x) &= \biggl( \sum_i x_i ^b \biggr) ^{\!\!a}
  \qquad \quad
  x \in [0,1]^n
\end{align*}

\nextbook
\begin{book}
  \emph{Neural message passing\\ for quantum chemistry}\\
  J. Gilmer et al. (2017)
\end{book}
% MPNN
\begin{align*}
  m_v &\leftarrow \sum_{ w \in N(v) } M( h_v , h_w , e_{vw} ) \\
  h_v &\leftarrow U( h_v , m_v )
\end{align*}

\nextbook
\begin{book}
  \emph{Rethinking graph transformers\\ with spectral attention}\\
  D. Kreuzer et al. (2021)
\end{book}
Transformers use positional embeddings, with sines and cosines.
For graphs, we could use the first eigenvectors of the Laplacian (GT),
but this ignores the eigenvalues.
Instead, SAN learns the positional embedding:
for each node,
transform the eigenvalues $\lambda_1,\dots,\lambda_m$
and eigenvectors $\phi_{ij},\dots,\phi_{mj}$ as
\[
(2\times m)
\xmapsto[2\times k]{\text{linear}} (k\times m)
\xmapsto[m\times m]{\text{transformer}} (k\times m)
\xmapsto{\text{sum}} (k\times1).
\]
Randomly flip the sign of the eigenvectors
to make the model sign-invariant.

\nextbook
\begin{book}
  \emph{A generalization of transformer networks\\ to graphs}\\
  V. P. Dwivedi and X. Bresson (2021)
\end{book}
The graph transformer (GT) layer
uses the low-frequency eigenvectors of the Laplacian as positional encoding.

\nextbook
\begin{book}
  \emph{Training graph neural networks\\ with 1000 layers}\\
  G. Li et al. (2021)
\end{book}
Use reversible (block-triangular) connections.

\nextbook
\begin{book}
  \emph{A dual-stage attention-based recurrent neural network for time series prediction}\\
  Y. Qin et al.
\end{book}
Stack two LSTM layers with attention (DARNN).
\begin{align*}
  \alpha_{st} &\propto f( h_{t-1}, x_t ) \qquad s < t \\
  h_t &= \text{LSTM}( h_{h-1} , \sum_{ s < t } \alpha_{st} x_s ) \\
  \beta_{st} &\propto g( \ell_{t-1} , h_s ) \qquad s<t \\
  d_t &= \text{LSTM}( d_{t-1} ; y_{t-1} , \sum_{s<t} \beta_{st} h_s ) \\
  \hat y_T &= \phi( d_T , \sum_{s<T} \beta_{sT} h_s )
\end{align*}

\nextbook
\begin{book}
  \emph{Gradients are not all you need}\\
  L. Metz et al. (2021)
\end{book}
Exact gradients (from automatic differentiation)
may be less informative than approximate (black-box) ones.

This phenomenon appears, in particular, in iterated systems: RNNs,
rigid body physics, ODE solvers, optimization layers, etc.

To limit the problem: initialize the RNNs close to the identity, use LSTMs, use conservation laws
(and other known properties), try truncated BPTT, truncated gradients, or, even black-box gradients.

\nextbook
\begin{book}
  \emph{Top2vec: distributed representations of topics}\\
  D. Angelov
\end{book}
$\text{top2vec} = \text{doc2vec} + \text{UMAP} + \text{HDBScan}$

\nextbook
\begin{book}
  \emph{Supervised linear dimension reduction methods:
  review, extensions and comparisons}\\
  S. Xu et al. 
\end{book}
Prefer PLS (an eigen decomposition)
or LSPCA (manifold optimization).
\begin{align*}
  \text{PCA: } &
  \operatorname*{Minimize}_{ U' U = I } \n{ X - X U U' } ^2 \\
  \text{PLS: } &
  \operatorname*{Maximize}_{ \n u = 1 } \bigl[ (X u)' y \bigr] ^2 \\[-2mm]
  & \text{(and iterate after projecting $X$ and $y$ on $u^\perp$)} \\
  \text{LSPCA: } &
  \operatorname*{Minimize}_{\substack{
      \beta, U \\ \text{s.t. } U' U = I
  }}
  \n{ y - X U \beta }^2 + \lambda \n{ X - X U U' }^2
\end{align*}

\nextbook
\begin{book}
  \emph{A new coefficient of correlation}\\
  S. Chatterjee
\end{book}
To assess if $Y = f(X)$ (for $f$ measurable but not necessarily monotonic):
\begin{compactitem}[--]
\item Sort the observations along $X$:
  \[ (X_{(1)}, Y_{(1)}), \dots, (X_{(n)}, Y_{(n)}); \]
\item Compute the ranks $r_i$ of $Y_{(i)}$;
\item Let
  $ \xi(X,Y) = 1 - \dfrac{ 3 }{ n^2 - 1 } \sum_i \n{ r_{i+1} - r_i }. $
\end{compactitem}
It converges to
\[
\dfrac{
  \int \operatorname*{Var}_X \E_Y [ \mathbf 1_{ Y \geq t } | X ] d p_Y(t) 
}{
  \int \operatorname*{Var}_Y [ \mathbf 1_{ Y \geq t } ] d p_Y(t) 
}
\]
which is 0 iff $X \indep Y$ and 1 iff $Y = f(X)$ a.s. for some measurable $f$.
If $X \indep Y$, it is asymptotically Gaussian:
\[ \sqrt n \, \xi_n(X,Y) \xrightarrow{d} N(0, 2/5). \]

Alternatives include:
\begin{compactitem}[--]
\item The maximum information coefficient (MIC):
  maximum of $\text{MI}(U;V) / \log \min(x,y)$,
  where $\text{MI}(U;V) = \text{KL}( p_{U,V} \| p_U p_V )$
  and $(U,V)$ is the discretization of the scatterplot of $(X,Y)$
  on an $x \times y$ grid, with $xy \leq n^{0.6}$;
\item The distance correlation
  \begin{align*}
    a_{ij} &= \n{ X_i - X_j } \\
    b_{ij} &= \n{ Y_i - Y_j } \\
    A_{ij} &= a_{ij} - a_{i\bigcdot} - a_{\bigcdot j} \\
    B_{ij} &= b_{ij} - b_{i\bigcdot} - b_{\bigcdot j} \\
    \text{dCor} &= \cor(A,B)
  \end{align*}
\item HHG: for each pair $(i,j)$, $i \neq j$,
  compute the $\chi^2$ statistic to test indepence on the $2\times2$ contingency table
  for $\va{ X_i - X } < \va{ X_i - X_j }$
  and  $\va{ Y_i - Y } < \va{ Y_i - Y_j }$
\item Hilbert-Schmidt independence criterion (HSIC)
  \begin{align*}
    \text{HSIC} &=
    \dfrac1{n^2} \sum_{ij} k_{ij} \ell_{ij}
    + \dfrac1{n^4} \sum_{ijqr} k_{ij} \ell_{qr}
    - \dfrac2{n^3} \sum_{ijq} k_{ij} \ell_{iq} \\
    k_{ij} &= k(X_i,X_j) \\
    \ell_{ij} &= \ell( Y_i, Y_j ) \\
    k(x,y) &= \ell(x,y) = \exp - \dfrac12 \biggl( \dfrac{ x-y }{ \sigma } \biggr) ^2
  \end{align*}
\end{compactitem}

R implementations in \texttt{XICOR}, \text{energy} (dCor),
\texttt{minerva} (MIC), \texttt{HHG}, \texttt{dHSIC}.

\nextbook
\begin{book}
  \emph{On the power of Chatterjee's rank correlation}\\
  H. Shi et al.
\end{book}
Prefer Hoeffding's $D$,
Blum-Kiefer-Rosenblatt's $R$,
or Bergsma-Dassios-Yanagimoto's $\tau^*$
to Chatterjee's rank correlation.
\begin{align*}
  D &= \int \bigl[ F(x,y) - F(x) G(y) \bigr] ^2 dF(x,y) \\
  R &= \int \bigl[ F(x,y) - F(x) G(y) \bigr] ^2 dF(x) dF(y) \\
  \tau^* &= 4 I( x_1, x_3 < x_2, x_4; \ y_1, y_3 < y_2, y_4 ) \\
  &+ 4 I( x_1, x_3 < x_2, x_4; \ y_2, y_4 < y_1, y_3 ) \\
  &- 8 I( x_1, x_3 < x_2, x_4; \ y_1, y_4 < y_2, y_3 )
\end{align*}
where $I(x_1,x_2 < x_3,x_4) = \mathbf1_{ \max(x_1,x_2) < \min(x_3,x_4) }$.

\nextbook
\begin{book}
  \emph{A simple measure of conditional dependence}\\
  M. Azadkia and S. Chatterjee
\end{book}
Conditional independence can be measured as
\[ T(Y,Z | X) = \dfrac{
  \int \E_X \operatorname*{Var}_Z \bigl[ P_Y( Y \geq t | Z, X ) | X \bigr] d F_Y(t) 
}{
  \int \E_X \operatorname*{Var}_Y \bigl[ \mathbf 1_{ Y \geq t } | X \bigr] d F_Y(t) 
}. \]
To estimate it:
\begin{compactitem}[--]
\item Let $N(i)$ be the index of the nearest neighbour of $X_i$;
\item Let $M(i)$ be the index of the nearest neighbour of $(X_i,Z_i)$;
\item Let $R_i = \sum_j \mathbf 1_{ Y_j \geq Y_i }$ be the rank of $Y_i$;
\end{compactitem}
\[ T_n \dfrac{
  \sum \min( R_i, R_{M(i)} ) - \min( R_i , R_{N(i)} )
}{
  \sum R_i - \min(  R_i , R_{N(i)} )
}. \]
It can be used for variable selection:
add the variable $X_j$
maximizing $T_n( Y , X_j | X_{j_1} , \dots , X_{j_k} )$
until $T_n \leq 0$.

R implementation in \texttt{FOCI}.

\nextbook
\begin{book}
  \emph{The oracle estimator is sub-optimal for global minimum variance portfolio optimization}\\
  C. Bongiorno and D. Challet
\end{book}
\emph{Rotationallty invariant estimators} (RIE) of the variance matrix
\[ \forall\, U \!\in\! O_n \quad \Sigma ( U' \hat S U ) = U' \Sigma(\hat S) U \]
filter the eigenvalues of the sample variance matrix $\hat S$
while keeping its eigenvectors.
The RIE optinmal for the Frobenius distance (between the estimator and the (unknown) true variance matrix)
is not optimal for minimum variance portfolio optimization.

\nextbook
\begin{book}
  \emph{A new parametrization of correlation matrices}\\
  I. Archakov and P.R. Hansen (2020)
\end{book}
A correlation matrix $C$ can be parametrized with the off-diagonal elements of $\log C$:
$C \mapsto \operatorname{vecl} \log C$.
This generalizes the Fisher transform:
\[ \log \begin{pmatrix} 1 & \rho \\ \rho & 1 \end{pmatrix} =
\begin{pmatrix}
  \dfrac12 \log(1-\rho^2) &
  \dfrac12 \log \dfrac{1+\rho}{1-\rho} \\ 
  \dfrac12 \log \dfrac{1+\rho}{1-\rho} &
  \dfrac12 \log(1-\rho^2) 
\end{pmatrix}.
\]
For covariance matrices, add $(\log \sigma_i)_i$.

To compute the inverse (without the diagonal elements of $\log C$),
iterate $x \mapsto x - \log \operatorname{diag} e^{ A[x] }$,
where $A[x]$ is $A$ with its diagonal replaced by $x$,
and return $C = e^{ A[x] }$;
we then have $\operatorname{vecl} \log C = \operatorname{vecl} A$.

\nextbook
\begin{book}
  \emph{Completing correlation matrices}\\
  O. Dreyer et al. (2021)
\end{book}
% not read
Complete concentration matrices by maximizing
the entropy of the resulting Gaussian distribution.
If the known correlations form a chordal graph,
this can be done efficiently.

\nextbook
\begin{book}
  \emph{The Hurst roughness exponent\\ and its model-free estimation}\\
  X. Han and A. Schied (2021)
\end{book}
The \emph{standard Hurst exponent} measures the long-range dependence of a time series (or function),
using its autocorrelation,
The \emph{Hurst roughness exponent}
(the $p$th variation of $x$ converges to 0 if $p>1/H$ and to infinity if $p<1/H$)
measures the roughness of a function.
They sometimes coincide (fBM), but not always.

The Gladyshev estimator is not scale-invariant, but can be made so.
% Technical, but should be easy to implement

\nextbook
\begin{book}
  \emph{Portfolio optimization with idiosyncratic\\ and systemic risks for financial networks}\\
  Y. Yang et al. (2021)
\end{book}
Replace the variance matrix $V$ with $\lambda \Sigma + (1-\lambda) H$,
where $\Sigma$ is the matrix of covariances ($V$), or Kendall's $\tau$'s, or tail dependence coefficients,
and $H = (\sigma \sigma' ) \odot (CC')$
where $\sigma = \operatorname{diag} V$ and $C$ is the vector of clustering coefficients.

\nextbook
\begin{book}
  \emph{Portfolio optimization with options}\\
  J.R. Chan et al. (2021)
\end{book}
For portfolios of options, replace the variance matrix, in the Markowitz optimization problem, with
\[ \Lambda_{ij} = \dfrac{ P( O_i^+ , O_j^+ ) }{ P( O_i^+ ) P(O_j^+) }, \]
where $O_i^+$ is the event ``option $i$ expires in the money''
(it can be computed from the pairwise copulas of stock prices and the option strikes).
% Formulas for calls, puts, strangles

\nextbook
\begin{book}
  \emph{Online estimation and optimization\\ of utility-based shortfall risk}\\
  A.S. Menon et al.
\end{book}
\emph{Utility-based shortfall risk} (UBSR) generalizes CVaR (it is no longer coherent):
\[ \text{SR}_\lambda(X) = \inf\{ t \in \RR \ :\ \E[ U(t+x) ] \geq -\lambda \}. \]

\nextbook
\begin{book}
  \emph{Mean-covariance robust risk measurement}\\
  V.A. Nguyen et al. (2021)
\end{book}
The \emph{Chebychev ambiguity set} around a mean-covariance pair $(\mu,\Sigma)$
is the set of probability distributions with that expectation and that variance.
The \emph{Gelbrich distance} between mean-covariance pairs $(\mu_1,\Sigma_1)$ and $(\mu_2,\Sigma_2)$ is
\[ \sqrt{
  \n{ \mu_1 - \mu_2 }^2 +
  \operatorname{Tr}
  \bigl[
    \Sigma_1 + \Sigma_2 - 2 ( \Sigma_2^{1/2} \Sigma_1 \Sigma_2^{1/2} )^{1/2}   
  \bigr].
} \]
It is the Wasserstein distance between $N(\mu_1,\Sigma_1)$ and $N(\mu_2,\Sigma_2)$.

The \emph{Gelbrich ambiguity set} $G_\rho(\mu,\Sigma)$ is the set of distributions $q$
whose mean-variance pair is at distance at most $\rho$ of $(\mu,\Sigma)$.

For a (translation-invariant, positive homogeneous, law-invariant) risk measure R,
\[ \sup_{ q \in G_\rho(\mu,\Sigma) } \operatorname*{R}_{ X \sim q } \!\![ - w' X ] \!=\!
- \mu ' w + \alpha \sqrt{ w' \Sigma w } + \rho \sqrt{ 1 + \alpha ^2 } \n{ w }
\]
where the risk coefficient $\alpha$ can be computed explicitly for
VaR, CVaR,
spectral risk measures,
Kusuoka risk measures (supremums of spectral risk measures),
distorsion measures
($\operatorname{R}[X] = \int_\RR \tau dh\bigl(F_X(\tau)\bigr)$ for some non-decreasing $[0,1]\to[0,1]$).

