\nextbook
\begin{book}
  \emph{Non-additive measures}\\
  V. Torra et al. (2014)
\end{book}

A \d{non-additive measure} (or \emph{capacity}, or fuzzy measure) satisfies
\[ A \subset B \Rightarrow \mu(A) \leq \mu(B). \]
It can model negative and positive interactions,
\begin{align*}
  \mu(A \sqcup B ) &< \mu(A) + \mu(B) \\
  \mu(A \sqcup B ) &> \mu(A) + \mu(B).
\end{align*}

For instance, a 2-book set $\{x_1,x_2\}$ may be more valuable
than the individual books,
\[ v(\{x_1,x_2\}) > v(\{x_1\}) + v(\{x_2\}). \]

In a workshop, if $\mu(A)$ is the number of widgets produced by the workes in A,
we have $\mu(A\sqcup B) = \mu(A) + \mu(B)$ if they work independently,
$\mu(A \sqcup B) > \mu(A) + \mu(B)$ if they cooperate,
$\mu(A \sqcup B) < \mu(A) + \mu(B)$ if the interfere.

Examples include
\begin{compactitem}[--]
\item Sugeno $\lambda$- measures,
  \[ \mu(A \sqcup B) = \mu(A) + \mu()B) + \lambda \mu(A) \mu(B); \]
\item Distorted probabilities $\mu(A) = f(P(A))$,
  with $f$ non-decreasing and $P$ a probability;
\item $\bot$-decomposable non-additive measures,
  $\mu(A \sqcup B) = \mu(A) \bot \mu(B)$,
  where $\bot$ is a $t$-conorm,
  \begin{align*}
    & a \bot b = b \bot a \\
    & a \leq c, \ b \leq d \Rightarrow a \bot b \leq c \bot d \\
    & a \bot ( b \bot c ) = ( a \bot b ) \bot c \\
    & a \bot 0 = a
  \end{align*}
\end{compactitem}

The \emph{M\"obius transform} of $\mu$ is
\[ m(A) = \sum_{ B \subset A } (-1)^{ \va A - \va B } \mu(B) \]
and satisfies
\[ \mu(A) = \sum_{ B \subset A} m(B). \]

The \d{Choquet integral} is
\begin{align*}
  C_\mu(f) &= \int_0^\infty \mu_f(r) dr \\
  \mu_f(r) &= \mu \{ x \, :\, f(x) > r \} \\
  C_\mu(f) &= \sum \bigl( f(x_{s(i)}) - f( x_{s(i-1)}) \bigr) \mu( A_{s(i)} ) \\
  A_{s(i)} &= \{ x_{s(i)}, \dots, x_{s(N)} \}
\end{align*}
where the $f(x_{s(i)})$ are in increasing order.
(In the book example, $C_v(n)$ is the value of $n_1$ copies of volume 1 and $n_2$ copies of volume 2,
if we sell $n_1 \wedge n_2$ 2-book sets and the rest as individual volumes.)
The \emph{Sugeno integral} is
\begin{align*}
  S_\mu(f) &= \sum_{ r \in [0,1] } r \wedge \mu_f(r) \\
  &= \max_i \min \bigl\{ f(x_{s(i)}) , \mu(A_{s(i)})  \bigr\}.
\end{align*}

%\textbf{3.} 
The \emph{generalized fuzzy integral}
of a simple function
\[ f = \bigoplus_{i=1}^n a_i \mathbf 1 _{A_i} \qquad
A_1 \varsupsetneq \cdots \varsupsetneq A_n \]
is
\[ \text{GF}_\mu(f) = \bigoplus a_i \boxdot \mu(A_i). \]
The Choquet integral is obtained with $\oplus = + $ and $\boxdot = \cdot$,
the Sugeno integral with $\oplus = \text{max}$ and $\boxdot = \text{min}$.

%\textbf{4.}
There are several notions of \emph{entropy} for non-additive measures.
\begin{align*}
  H_Y(v) &= \sum_i h \biggl(
  \sum_{\substack{
      A \subset N \\ i \not\in A
  }}
  \gamma_{\va A} ^n \bigl( v( A \union \{i\} ) - v(A) \bigr)
  \biggr) \\
  H_{MR}(v) &= \sum_i
  \sum_{\substack{
      A \subset N \\ i \not\in A
  }}
  \gamma_{\va A} ^n h \bigl( v( A \union \{i\} ) - v(A) \bigr) \\
  h(x) &= - x \log x \\
  \gamma_k^n &= \dfrac{ ( n - k - 1 ) ! \, k ! }{ n! }.
\end{align*}
A maximal chain
$\nothing = C_0 \varsubsetneq \cdots \varsubsetneq C_n = \llbracket 1, n \rrbracket$
defines a probability distribution
\[ p_C = \bigl( v(C_1) - v(C_0) , \dots , v(c_n) - v(c_{n-1}) \bigr) \]
and yet another entropy
\[ M_{\text{min}}(v) = \min_C H( p_C ). \]

\textbf{5a.}
The von Neumann-Morgenstern theorem states that a preference order on subsets of a convex set $X$
satisfies
\begin{compactitem}
\item[(i)] $ p \succ q \Rightarrow \lambda p (1-\lambda) r \succ \lambda q + (1-\lambda) r $
  %(independence)
\item[(ii)] $p \succ q$ and $q \succ r$ $\Rightarrow$ $\exists \alpha, \beta \in (0,1)$
  \[ \alpha p + (1-\alpha)r \prec q \prec \beta p + (1-\beta) r  \]
\end{compactitem}
iff there exists $u : \mathscr P(X) \to \RR$ such that
\begin{compactitem}[--]
\item $ p \succ q \Leftrightarrow u(p) \geq u(q) $
\item (affine) $\forall p,q \in \mathscr P(X) \ \forall \lambda \in [0,1] $
  \[u\bigl( \lambda p + (1-\lambda) q ) = \lambda u(p) + (1-\lambda) u(q) \]
\end{compactitem}
Such a $u$ is unique up to a positive affine transformation.
This result can be generalized to \emph{mixture spaces}
(replace $\lambda p + (1-\lambda) q$ with $h_\lambda(p,q)$),
\emph{subjective probabilities}, \ie, preference orders such that
\[ E \inter G = F \inter G = \nothing \Rightarrow ( E \succ F \Leftrightarrow E \union G \succ F \union G ), \]
and \emph{Savage acts}, \ie, maps $f:S\to X$.

\textbf{5b.}
An urn contains 30 red balls and 60 black-or-yellow balls;
you are presented with four lotteries:
\begin{compactitem}[--]
\item Get \$100 if you pick a red ball;
\item Get \$100 if you pick a black ball;
\item Get \$100 if you pick a red or yellow ball;
\item Get \$100 if you pick a black or yellow ball;
\end{compactitem}
For most people,
$R \succ B$, but $\textit{RY} \prec \textit{BY}$:
this cannot be formalized by expected utility theory
(\d{Ellsberg's paradox}),
but can be with the Choquet integral utility model,
which accounts for both uncertainty (probability theory)
and imprecision (or knightian uncertainty -- fuzzy sets).

\textbf{5c.}
The Choquet integral can be generalized to functions taking negative values,
\[ \int a \,dv = \int_{-\infty}^0 \bigl[ v(a\geq y) - v(S)  \bigr] dy +
\int_0^\infty v(a \geq y) dy. \]

If $v$ is \emph{convex} (supermodular), \ie,
\[ \forall A,B \quad v(A\union B) + v(A\inter B) \geq v(A) + v(B), \]
its core $\{ p \,:\, \forall A \  p(A) \geq v(A) \}$ is non-empty and
\[ \int a \, dv = \min_{ p \in \text{Core}(v) } \int a \, dp. \]

\textbf{6.}
The \emph{M\"obius transform} can be defined for a function on a poset
$f : (P, \leq) \to \RR$.
\begin{align*}
  \mu(x,y) &= \begin{cases}
    1 & \text{if $x = y$} \\
    - \!\!\!\!\sum\limits_{ y \leq z < x } \mu(y,z) &\text{if $y<x$} \\
    0 & \text{otherwise}
  \end{cases} \\
  \Delta^{\!f}(x) &= \sum_{ y \leq x} \mu(x,y) f(y) \\
  f(x) &= \sum_{ y \leq x } \Delta^{\!f}(y)
\end{align*}
It measures the extra contribution not achieved by smaller coalitions.

Let $\bar v$ be the multilinear extension of the non-additive measure $v: \{0,1\}^n \to \RR$.
The \d{Shapley value} is
\begin{align*}
  \phi_i(v) &= \sum_{ S \ni i } \dfrac1{\va S} \Delta^{\!v}(S) \\
  &= \int_0^1 \dfrac{ \partial }{ \partial x_i } \bar v( t, \dots, t ) dt.
\end{align*}
It is characterized by: 
\begin{compactitem}[--]
\item Symmetry: $\phi_{\sigma(i)}(\sigma v)= \phi_i(v)$;
\item Efficiency: $v(X) = \sum \phi_i(v)$;
\item Null-zero: $\bigl( \forall S \ v(S\union i) = v(S) \bigr) \Rightarrow \phi_i(v) = 0$;
\item Additivity: $\phi(v+w) = \phi(v) + \phi(w)$.
\end{compactitem}
It can be generalized
\begin{compactitem}[--]
\item From singletons $\{i\}$ to arbitrary subsets;
\item To bi-cooperative games, where $v(S,T)$ is the value if voters in $S$ vote $+1$,
  those in $T$ vote $-1$, and the rest abstain;
\item To a subset of $\mathscr P(X)$ (feasible coalitions), described by a graph.
\end{compactitem}

