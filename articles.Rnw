\begin{align*}
k_{ij}(\tau) &= \sum_q \alpha_{ij}^q \exp\bigl[
  - \tfrac12 ( \tau + \theta_{ij}^q ) ' \Sigma_{ij}^q ( \tau + \theta_{ij}^q )
\bigr]
\cdot \\
&\qquad
\cos [
  ( \tau + \theta_{ij}^q ) ' \mu_{ij}^q + \phi_{ij}^q
]
\end{align*}

