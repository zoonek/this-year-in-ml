\nextbook
\begin{book}
  \emph{Improving graph neural network expressivity via subgraph isomorphism counting}\\
  G. Bouritsas et al.
\end{book}
Graph neural nets (GNN) are blind to structural properties, such as triangles and larger cycles.
Add node and edge features counting small subgraphs containing a given node or edge.
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.5,inner sep=1.5pt,outer sep=0pt,baseline=0]
  \node[draw,circle,ultra thick,red!70!black] (A) at (0,0) {};
  \node[draw,circle,ultra thick,blue!70!black] (B) at (1,0) {};
  \node[draw,circle,ultra thick,red!70!black] (C) at (2,0) {};
  \draw[thick] (A) -- (B) -- (C);
  \begin{scope}[shift={(5,0)}]
  \node[draw,circle,ultra thick] (A) at (0,0) {};
  \node[draw,circle,ultra thick] (B) at (1,0) {};
  \node[draw,circle,ultra thick] (C) at (60:1) {};
  \draw[thick] (A) -- (B) -- (C) -- (A);  
  \end{scope}
\end{tikzpicture}
\]
 
\nextbook
\begin{book}
  \emph{Weisfeiler and Leman go sparse:\\ towards scalable higher-order graph embeddings}\\
  C. Morris et al. (2020)
\end{book}
Generalize the Weisleiler-Lehman (WL) graph isomorphism algorithm by considering $k$-tuples of nodes,
two tuples being neighbours if they differ by only one node,
and if those nodes are neighbours.
  
\nextbook
\begin{book}
  \emph{A theoretical comparison\\ of graph neural network extensions}\\
  P.A. Papp and R. Wattenhofer (2022)
\end{book}
To increase the expressiveness of GNNs:
\begin{compactitem}[--]
\item Add node features, e.g., the number of cycles of length $k$ (or some other motif) containing that node;
\item Add, as node features, the isomorphism class of the $k$-hop neighbourhoods;
\item Drop $k$ nodes at random, and consider the resulting collection of graphs;
\item Mark $k$ nodes at random, and consider the resulting collection of graphs.
\end{compactitem}

\nextbook
\begin{book}
  \emph{SpeqNets: sparsity-aware permutation-equivariant graph networks}\\
  C. Morris et al. (2022)
\end{book}
The $k$-dimensional Weisfeiler-Lehman algorithm ($k$-WL) generalizes the WL algorithm (1-WL) by considering all $k$-tuples of nodes (there are exponentially many).
The $(k,s)$-LWL algorithm considers a subset of all $k$-tuples,
viz those whose induced graph has at most $s$ components.  
  
\nextbook
\begin{book}
  \emph{Spectre: spectral conditioning\\ helps to overcome the expressivity limits\\ of one-shot graph generators}\\
  K. Martinkus et al. (2022)
\end{book}
Generate graphs, with a GAN, by conditioning on the first eigenvalues and eigenvectors of the Laplacian matrix
(which encode global properties):
\begin{compactitem}[--]
\item First, generate eigenvalues;
\item Then, generate the eigenvectors,
  conditioned on the eigenvalues,
  starting with a bank of orthogonal matrices,
  and multiplying them, on both sides, by orthogonal matrices
  (exponentials of skew-symmetric matrices,
  computed by a PointNetST);
  note that not all eigenvalues and eigenvectors come from valid Laplacians;
\item Use a PPGN (provably powerful graph network) to refine
  the appoximate Laplacian, $L = U \text{diag}(\Lambda) U'$,
  and convert it to an adjacency matrix;
\item Use a discriminator for each step; the last one ensures the adjacency matrix is consistent
  with the eigenvalues and eigenvectors.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Provably powerful graph networks}\\
  H. Maron et al. (2019)
\end{book}
Adding a matrix multiplication layer to GNNs increases their expressiveness to 3-WL.
% PPGN
\[
\begin{tikzpicture}[>=stealth,xscale=1.3,yscale=1,inner sep=2pt,outer sep=1pt,baseline=0,
          every path/.style={thick}
]    
  \node (X) at (-.25,0) {$X$};
  \node[draw] (A) at (1,1) {MLP};
  \node[draw] (B) at (1,0) {MLP};
  \node[draw] (C) at (2.75,-.25) {MLP};
  \node[circle,draw,inner sep=0pt] (T) at (2,.5) {\footnotesize$\times$};
  \node (O) at (3.5,-.25) {};
  \draw[->] (X) -- (0.25,0) |- (A);
  \draw[->] (X) -- (B);
  \draw[->] (X) -- (0.25,0) -- (0.25,-1) -| (C);
  \draw[->] (A) -| (T);
  \draw[->] (B) -| (T);
  \draw[->] (T) -| (C);
  \draw[->] (C) -- (O);  
\end{tikzpicture}
\]

\begin{align*}
  & X \in \RR^{ h \times n \times n } \\
  & M_1 = \text{MLP}_1(X) \in \RR^{ h \times n \times n } \\
  & M_2 = \text{MLP}_2(X) \\
  & M^i = M_1^i M_2^i \in \RR^{n\times n} \\
  & M \in \RR^{ n \times n } \\
  & Y = \text{MLP}_3( X \| M ) \in \RR^{h\times n \times n}\\
  & \text{repeat $n$ times, with skip-connections}
\end{align*}
  
\nextbook
\begin{book}
  \emph{Local augmentation for graph neural networks}\\
  S. Liu et al. (2022)
\end{book}
To augment data, find similar nodes and look at their neighbourhoods.
  
\nextbook
\begin{book}
  \emph{Janossy pooling:\\ learning deep permutation-invariant\\ functions for variable-size inputs}\\
  R.L. Murphy et al. (2019)
\end{book}
Arbitrary permutation-invariant functions can be defined as averages (of permutation-sensitive functions $f$)
over all orderings.
\[ \operatorname*{Mean}_{ \sigma \in \mathfrak S_n } f( x_\sigma ) \]
They can be approximated using:
\begin{compactitem}[--]
\item Canonical orderings;
\item Functions $f$ using only their first $k$ arguments,
  $f(x_1,\dots,x_n) = f(x_1,\dots,x_k)$, $k \ll n$,
  \ie, accounting for order-$k$ interactions at most;
\item Random orderings (and stochastic optimization).
\end{compactitem}
The permutation-sensitive function $f$ could be an LSTM.  
  
\nextbook
\begin{book}
  \emph{G-Mixup: graph data augmentation\\ for graph classification}\\
  X. Han et al.
\end{book}
To apply Mixup to graphs, estimate a graphon for each class,
and sample from a convex combination of them.

%TODO: PLOT?

To estimate a graph from a set of graphs,
first align them by sorting their nodes by degree,
estimate a step function graphon for each graph,
and average them -- this assumes the marginal
$\int W(x,y) dx = W(y)$ is very different from a constant function.

\nextbook
\begin{book}
  \emph{GenLabel: Mixup relabeling\\ using generative models}\\
  J.Y. Sohn et al. (2022)
\end{book}
Mixup can suffer from \emph{manifold intrusion}:
mixing two classes may intrude into the manifold of another one.
\[
\begin{tikzpicture}[>=stealth,scale=2.5,inner sep=1pt,outer sep=0pt,baseline=0]
  \node[ellipse,draw,very thick] (A) at (0,0) {class 1};
  \node[ellipse,draw,very thick] (B) at (1,0) {class 2};
  \node[ellipse,draw,very thick] (C) at (2,0) {class 3};
  \draw[ultra thick] (A) -- (B) -- (C);
\end{tikzpicture}
\]
Additionally, the linear labeling is suboptimal
for softmax regression.
Replacing
\[ y_{\text{mix}} = \lambda e_1 + ( 1-\lambda) e_2 \]
with
\[ y_{\text{gen}} \propto \sum_i \hat p_i( x_{\text{mix}} ) e_i, \]
where $\hat p = p(x|y)$ is a generative model,
addresses both issues. 
  
\nextbook
\begin{book}
  \emph{Large-scale representation learning on graph via bootstrapping}\\
  S. Thakoor et al. 
\end{book}
For self-supervised training on graph data, consider two augmentations,
$g_1$, $g_2$ of a graph,
and train two encoders,
$e_1$ such that $e_1(g_1) \approx e_2(g_2)$,
and set $e_2 = \text{EMA}(e_1)$.
  
\nextbook
\begin{book}
  \emph{Structure-aware transformer\\ for graph representation learning}\\
  D. Chen et al. (2022)
\end{book}
Transformers augment the data with a positional embedding.
For graphs, node distances are not enough: also add structural information.
  
\nextbook
\begin{book}
  \emph{Interpretatble and generalizable graph learning via stochastic attention mechanism}\\
  S. Miao et al. (2022)
\end{book}
Add noise \emph{inside} the network (in the attention mechanism);
this also helps identify task-relevant subgraphs.
  
\nextbook
\begin{book}
  \emph{Mention memory: incorporating textual knowledge into transformers\\ through entity mention attention}\\
  M. de Jong (2022)
\end{book}
Combine language model and knowledge base (entity mention embeddings)
with an attention mechanism.
  
\nextbook
\begin{book}
  \emph{Logical rule induction and theory learning using neural theorem proving}\\
  A. Campero et al.
\end{book}
Use a dense representation of facts as ($V$,$S$,$O$,belief)
and rules as
\[ (
\underset{\text{conclusion}}{V_0 S_0 O_0} 
\underset{\text{premise}}{V_1 S_1 O_1 \, V_2 S_2 O_2}
) \]
and define the belief of a conclusion as
\[
\langle v ,   V_0 \rangle \langle s ,   S_0 \rangle \langle o ,   O_0 \rangle
\langle v_1 , V_1 \rangle \langle s_1 , S_1 \rangle \langle o_1 , O_1 \rangle
\langle v_2 , V_2 \rangle \langle s_2 , S_2 \rangle \langle o_2 , O_2 \rangle
\]
and use forward chaining for derive new facts.
  
\nextbook
\begin{book}
  \emph{Learning hierarchy-aware knowledge graph embeddings for link prediction}\\
  Z. Zhang et al. (2020)
\end{book}
Use polar coordinates to find an embedding of entities (head, taill)
and relations accounting for hierarchy.
\[ \text{score} = - \n{ h_m \odot r_m - t_m } _2 - \lambda
\n{ \sin( h_p + r_p - t_p ) } _1
\]

There are many other score functions: TransE, RotatE, ComplEx, etc.
  
