\draw[->] (x)  -- (h1);
\draw[->] (x)  -- (h2);
\draw[->] (h1) -- (y1);
\draw[->] (h2) -- (y2);
\draw[->] (y1) -- (h2);
\end{tikzpicture}
\ \rightsquigarrow\ 
\begin{tikzpicture}[xscale=1,yscale=1,>=stealth,inner sep=1pt, outer sep=1pt,baseline=25pt
]
\node (x)  at (0,0) {$x$};
\node (h1) at (0,1) {$h_1$};
\node (h2) at (1,1) {$h_2$};
\node (h3) at (2,1) {$h_3$};
