    \node[label=right:{2}] at (.4,.5) {}; \fill (.4,.5) circle (.03);
    \node[label=above:{3}] at (.8,.4) {}; \fill (.8,.4) circle (.03);
    \node[label=right:{4}] at (.5,.2) {}; \fill (.5,.2) circle (.03);
  \end{tikzpicture}
