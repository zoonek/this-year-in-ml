\]
Continuous monotone functions are maximal.

An affine functrion $f(x) = Ax + b$ is maximal monotone iff $A + A^T \succcurlyeq 0$;
it is strongly monotone with parameter $\lambda_{\text{min}}( A + A^T ) / 2$;
it is the subdifferential of a CCP iff $A = A^T$ and $A \succcurlyeq 0$.
This generalizes to differentiable functions
$F : \RR^n \to \RR^n$ and their derivative $A = DF(x)$.

Projections are monotone.
If $C \subset \RR^n$ is closed convex, its \emph{normal cone operator}
$N_C = \partial I_C$ is
\[ N_C(x) = \begin{cases}
  \{ y \,:\, \forall z \in C \ y^T ( z - x ) \leq 0 \} & \text{if } x \in C \\
  \nothing & \text{otherwise}
\end{cases}
\]
\[
\begin{tikzpicture}[>=stealth,scale=.5,inner sep=1pt,outer sep=1pt,baseline=0]
  \fill[thick,blue!30] (1,0) to [out=-90,in=0] (0,-1) -- (0,0) -- cycle;
  \draw[thick,blue!70!black] (1,0) -- (0,0) -- (0,-1);
  \draw[thick,blue!70!black] (0,1) -- (1,1);
  \node[anchor=south east] at (0,0) {\footnotesize$x_2$};
  \node[anchor=east] at (0,1) {\footnotesize$x_1$};
  \node[circle,fill] at (0,0) {};
  \draw[thick] (0,0) -- (0,1)
  to[out=90,in=0] (-1,2)
  to[out=180,in=90] (-2,1)
  to[out=-90,in=180] (-1,0) -- cycle;
  \node[circle,fill] at (0,1) {};
  \node[anchor=north west] at (.6,-.6) {\color{blue!70!black}\footnotesize$N_C(x_2)$};
  \node[anchor=west] at (1,1) {\color{blue!70!black}\footnotesize$N_C(x_1)$};
\end{tikzpicture}
\]

The \emph{saddle subdifferential} of
$f : \RR^m  \times \RR^n \to \RR \union \{\infty\}$ is
\[ F(x,y) = \begin{pmatrix}
  \partial_x f(x,y) \\
  - \partial_y f(x,y) 
\end{pmatrix};
\]
if $f$ is convex in $x$ and concave in $y$,
$F$ is often maximal.

For the optimization problem
\[ \begin{array}{ll@{\quad}l}
  \text{Find} & x \\
  \text{To minimize} & f_0(x) \\
  \text{Such that} & \forall i \ f_i(x) \leq 0 & \text{CCP} \\
  & \forall j \ h_j(x) = 0 & \text{affine}
\end{array} \]
the KKT operator is
\[ T(x, \lambda,  \nu) = \begin{pmatrix}
  \partial_x L(x, \lambda) \\
  - F(x) + N_{ \lambda \geq 0 } \\
  - H(x) 
\end{pmatrix} \]
where $F = (f_1,\dots,f_m)$, $H = (h_1,\dots,h_p)$,
\[
L(x, \lambda, \nu) = \begin{cases}
  f_0(x) + \sum \lambda_i f_i(x) + \sum \nu_j h_j(x)  & \text{if } \lambda \geq 0 \\
  - \infty & \text{otherwise};
\end{cases}
\]
it is monotone, and its zero set is the set of optimal primal-dual pairs.

\textbf{5a.}
Fixed point iterations of a \emph{contraction} converge,
at least geometrically.
If $f$ is strongly convex and strongly smppth with parameters $m$ and $L$,
\emph{gradient descent}
\[ x_{k+1} = x_k - \alpha \nabla f(x_k) \qquad \alpha \in (0,2L) \]
converges to a minimizer of $f$.
If $F$ is strongly monotone and Lipschitz with parameters $m$ and $L$,
$(I-\alpha F)$ is a contraction for $\alpha \in (0,2m/L^2)$,
and the \emph{forward step method} converges
\[ x_{k+1} = x_k - \alpha F(x_k). \]

\textbf{5b.}
Iterations of \emph{averaged operators} converge to a solution, if one exists
(for non-expansive, but non-averaged operators, they need not converge).
If $f$ is convex (not strongly) and Lipschitz,
$I-\alpha \nabla f$ is averaged, and gradient descent converges.

\textbf{5c.} The \emph{dual ascent} for
\[ \operatorname*{Minimize}_x f(x) \text{ such that } Ax = b \]
is gradient ascent on the dual,
$\operatorname*{Minimize}_y g(y)$ where
$g(y) = - \bigl( f^* ( - A ' y ) - y' b \bigr)$,
\begin{align*}
  x_{k+1} &= \argmin_x L( x, y_k ) \\
  y_{k+1} &= y_k + \alpha ( A x_{k+1} - b )
\end{align*}

The \emph{convex feasibility problem} looks for $x \in C \inter D$,
where $C$ and $D$ are non-empty, closed, convex.
\[ \operatorname*{Minimize}_x \theta d^2(x,C) + (1-\theta) d^2(x,D) \]
The gradient method gives
\begin{align*}
  x_{k+1}^C &= \Pi_C(x_k) \\
  x_{k+1}^D &= \Pi_D(x_k) \\
  x_{k+1} &= \theta x_{k+1}^C + (1-\theta) x_{k+1}^D
\end{align*}

\textbf{6a.} The \d{resolvent} and \d{Cayley operator}
of a relation on $\RR^n$ are
\begin{align*}
  R &= ( I + \alpha A )^{-1} \\
  C &= 2R - I.
\end{align*}
If $A$ is monotone, $R$ and $C$ are non-expansive.
If $A$ is maximal monotone,
$\operatorname{dom} R = \operatorname{dom} C = \RR^n$
(fixed point iterations are always defined);
$0 \in A(x)$ iff $x = R_A(x)$ iff $x = C_A(x)$.
If $A$ is strongly monotone,
then $R$ is Lipschitz with $L = 1/(1+\alpha m)$.
If $A$ is strongly monotone and Lipschitz,
then $C$ is a contraction with
\[ L = \biggl( 1 - \dfrac{ 4 \alpha m }{ (1+\alpha L)^2 } \biggr)^{1/2}. \]
If $A$ is maximal and single-valued,
$C = (I-\alpha A)(I + \alpha A)^{-1}$.

If $A$ is a symmetric matrix with positive eigenvalues,
$R$ has eigenvalues in $(0,1]$, $C$ in $(-1,1]$.

The resolvent of the subdifferential of a convex function $f$
is the \emph{proximal operator}
\[ R(x) = ( I + \alpha \partial f )^{-1} (x) = \argmin_u f(u) + \dfrac1{2\alpha} \n{ u-x }^2 .\]
For the normal cone operator
$N_C (x) = \partial I_C(x)$,
\begin{align*}
  R &= ( I + \alpha N_C )^{-1} = \Pi_C &&\text{projection} \\
  C &= 2 \Pi_C - I - Q_C && \text{overprojection}.
\end{align*}

To solve $0 \in A(x)$, where $A$ is maximal monotone,
the \emph{Cayley} and \emph{proximal point} methods iterate
\begin{align*}
  x_{k+1} &= C( x_k ) & \text{(may not converge)} \\
  x_{k+1} &= R(x_k) & \text{(converges: $R$ is averaged)}.
\end{align*}

\textbf{6b.}
To solve
$\operatorname*{Minimize}_x f(x) \text{ s.t. } Ax = b$,
where $f$ is CCP,
the \emph{method of multipliers} looks for a dual variable $y$
such that $0 \in - \nabla g$
with the \emph{proximal point method},
$y \leftarrow R_{ -\nabla g } (y) $.
\begin{align*}
  x_{k+1} = \argmin_x L_\alpha( x, y_k ) \\
  y_{k+1} &= y_k + \alpha ( A x_{k+1} - b ).
\end{align*}

The \emph{proximal method of multipliers} uses the KKT
operator $T$ instead,
$(x,y) \leftarrow R_T(x,y)$:
\begin{align*}
  x_{k+1} &= \argmin_x L_{ \alpha_1 } ( x, y_k ) + \dfrac{ \alpha_2 }{ 2 } \n{ x - x_k }^2 \\
  y_{k+1} &= y_k + \alpha_1 ( A x_{k+1} - b ).
\end{align*}

To find a zero of $F(x) = Ax - b$,
where $A + A^T \succcurlyeq 0$, so that
$F$ is maximal monotone, the proximal point method with $R_F = (I + \epsilon^{-1} F )^{-1} $
gives the \emph{iterative refinement}
\begin{align*}
  r_k &= A x_k - b \\
  x_{k+1} &= x_k - ( A + \epsilon I)^{-1} r_k 
\end{align*}
($A + \epsilon I$ is often better conditioned than $A$).

If $F$ is maximal monotone, then so is
$L^-T F L^{-1}$;
the corresponding prximal point method
(\emph{generalized proximal point method}) is
$x_{k+1} = ( A + \alpha F)^{-1} A x_k$,
where $A = L^T L \succ 0$.

\textbf{7a.} To solve $0 \in (A+B)(x)$, where $A$ and $B$ are maximal monotone,
\emph{forward-backward operator splitting} uses the fixed point iteration
$ x = (I + \alpha B)^{-1} ( I - \alpha A )(x)$, \ie
$x_{k+1} = R_B( x_k - \alpha A x_k )$;
for $\alpha \in (0,2/L)$ (if $A$ is $L$-Lipshitz)
or $\alpha \in (0, 2m/L^2)$;
it is averaged.

The \emph{proximal gradient method} solves
$\operatorname*{Minimize}_x f(x) + g(x)$,
$f$, $g$ CCP,
by applying forward-backward splitting to
$0 \in ( \partial f + \partial g )(x)$,
assuming $f$ is differentiable,
\[ x_{k+1} = \argmin_x
f(x_k) + \nabla f(x_k) ^T (x - x_k ) + g(x) + \dfrac1{2\alpha} \n{ x - x_k }^2 . \]

\emph{Forward-backward-forward splitting} writes
$0 \in(A+B)(x)$ as
\[ x = \bigl( (I-\alpha A) R_B( I - \alpha A) + \alpha A \bigr) (x),
\qquad \alpha \in (0,1/L), \]
which gives
\begin{align*}
  x_{k+\frac12} &= R_B( x_k - \alpha A x_k ) \\
  x_{k+1} &= x_{k+\frac12} - \alpha( A x_{k+\frac12} - A x_k )
\end{align*}
For $B=0$, this is the \emph{extra gradient} method
\begin{align*}
  x_{k+\frac12} &= x_k - \alpha A x_k \\
  x_{k+1} &= x_k - \alpha A x_{k+\frac12}.  
\end{align*}

The \emph{Combettes-Pesquet} method solves
$0 \in (A+B+C)(x)$ with
forward-backward-forward splitting by writing it as
\[ 0 \in \begin{pmatrix} Ax \\ B^{-1} u \end{pmatrix} +
\begin{pmatrix}  u + Cx \\ -x \end{pmatrix}. \]

\emph{Peaceman-Rachford splitting}
solves $0 \in (A+B)(x)$
using $C_A C_B (z) = z$, $x = R_B(z)$.
\begin{align*}
  x_{k+\frac12} &= R_B z_k \\
  z_{k+\frac12} &= 2 x_{k+\frac12} - z_k \\
  x_{k+1} &= R_A( z_{k+\frac12} ) \\
  z_{k+1} &= 2z_{k+1} - z_{k+\frac12}
\end{align*}

\emph{Douglas-Rachford} splitting uses
\( ( \frac12 I + \frac12 C_A c_B ) (z) = z \), $x = R_B(z)$,
\ie,
\begin{align*}
  x_{k+\frac12} &= R_B(x_k) \\
  z_{k+\frac12} &= 2 x_{k+\frac12} - z_k \\
  x_{k+1} &= R_A( z_{k+\frac12} ) \\
  z_{k+1} &= z_k + x_{k+1} - x_{k+\frac12}.
\end{align*}
For instance, to solve
$\operatorname*{Minimize}_x \sum f_i(x)$,
rewrite it as
\[ \operatorname*{Minimize}_{x_1,\dots,x_n} \sum f_i(x_i)
\text{ s.t. } x_1=x_2=\cdots=x_n, \]
then, as
\[ 0 \in \begin{pmatrix} \partial f_1(x_1) \\ \vdots \\ \partial f_n(x_n) \end{pmatrix}
+ N_{[x_1=\cdots=x_n]} ( x_1,\dots,x_n ), \]
which gives
\begin{align*}
  x_i &\leftarrow \argmin_x f_i(x) + \dfrac1{2\alpha} \n{ x - z_i }^2 \\
  z_1 &\leftarrow z_i + 2 \bar x - \bar z - x_i.
\end{align*}

\emph{Davis-Yin 3-operator splitting} solves
$0 \in (A+B+C)(x)$,
where $A$, $B$, $C$ are maximal monotone,
by writing it as
$Tz = z, \ x = R_B(z)$,
where $T = C_A( C_B - \alpha C R_B ) - \alpha C R_B$;
the iteration is
\begin{align*}
  x_{k+\frac12} &= R_B(z_k) \\
  z_{k+\frac12} &= 2 x_{k+\frac12} - z_k \\
  x_{k+1} &= R_A( z_{k+\frac12} - \alpha C x_{k+\frac12} ) \\
  z_{k+1} &= z_k + x_{k+1} - x_{k+\frac12}
\end{align*}

\textbf{7b.} The proximal gradient solves
$\operatorname*{Minimize}_x f(x) + \lambda \n x _1 $,
where $f$ is CCP,
as (\emph{iterative shrinkage thresholding algorithm}, ISTA)
\begin{align*}
  x &\leftarrow S_{\alpha \lambda} ( x - \alpha \nabla f(x) ) \\
  S_k(x)_i &= \text{sign}(x_i) \bigl( \va{ x_i } - \kappa \bigr)_+.
\end{align*}

The proximal gradient solves
$\operatorname*{Minimize}_{x \in C} f(x)$,
$f$ CCP, $C$ convex, as (\emph{projected gradient})
\[ x \leftarrow \Pi_C \bigl( x - \alpha \nabla f(x) \bigr) . \]

The proximal gradient solves the convex feasibility problem
$x \in C \inter D$, \ie,
$\operatorname*{Minimize}_{ x \in C } d(x, D)^2$,
as (\emph{alternating projections}
\[ x \leftarrow \Pi_C \Pi_D x. \]
Douglas-Rachford splitting solves it as
$0 \in ( N_C + N_D )(x)$
\begin{align*}
  x_{k+\frac12} &= \Pi_D( z_k ) \\
  x_{k+1} &= \Pi_C( 2 x_{k+\frac12} - z_k ) \\
  z_{k+1} &= z_k + x_{k+1} - x_{k+\frac12}.
\end{align*}

\emph{Chambolle-Pock} solves
$\operatorname*{Minimize}_x f(x) + g(Mx)$
by rewriting it as
\[ 0 \in \begin{pmatrix} \partial f(x) \\ \partial g^*(u) \end{pmatrix}
+ \begin{pmatrix} 0 & M^T \\ -M & 0 \end{pmatrix}
\begin{pmatrix} x \\ u \end{pmatrix}
\]
and applying the generalized proximal point method
with $A = \begin{pmatrix} I & - \alpha M^T \\ - \alpha M & I \end{pmatrix}$
\begin{align*}
  x_{k+1} &= R_{ \partial f } ( x_k - \alpha M^T u_k ) \\
  u_{k+} &= R_{\partial g^*} \bigl( u_k + \alpha M ( 2 x_{k+1} - x_k ) \bigr)
\end{align*}
(if $R_{g^*}$ is easier to compute than $R_PM^T \partial g M$).

The linear program
$\operatorname*{Minimize}_{x \geq 0} c^T x \text{ s.t. } Ax=b$
can be written as $0 \in (T_1+T_2)(x, \nu, \lambda)$,
where
\[
T_1(x,\nu,\lambda) = \begin{pmatrix}
  x + A^T \nu - \lambda \\
  - ( Ax - b ) \\
  x 
\end{pmatrix}
\qquad
T_2(x,\nu,\lambda) = \begin{pmatrix}
  0 \\
  0 \\
  N_{ [ \lambda \geq 0 ] }
\end{pmatrix}
\]
and solved with forward-backward-forward splitting.

The convex-concave game
$\operatorname*{Maximize}_y \operatorname*{Minimize}_x f(x,y)$
can be written $0 \in F(x,y)$, where
\[ F(x,y) = \begin{pmatrix}
  \partial_x f(x,y) \\
  \partial_y - f(x,y) 
\end{pmatrix}
\]
and solved with forward-backward-forward splitting
(\emph{extra gradient})
\begin{align*}
  x_{k+\frac12} &= x_k - \alpha \nabla_x f( x_k, y_k ) \\
  y_{k+\frac12} &= y_k + \alpha \nabla_y f( x_k, y_k ) \\
  x_{k+1} &= x_k - \alpha \nabla_x f( x_{k+\frac12} , y_{k+\frac12} ) \\
  y_{k+1} &= y_k + \alpha \nabla_y f( x_{k+\frac12} , y_{k+\frac12} )
\end{align*}

The \emph{complementarity problem}
\[ \begin{array}{ll}
  \text{Find} & x \in K \\
  \text{Such that} & F(x) \in K^* \\
  & x \perp F(x) 
\end{array} \]
(with $F$ maximal monotone and Lipschitz)
can be written as
$ 0 \in ( F + N_K )(x) $
and solved with forward-backward-forward splitting
\begin{align*}
  x_{k+\frac12} &= \Pi_K( x_k - \alpha F x_k ) \\
  x_k &= x_{k+\frac12} - \alpha ( F x_{k+\frac12} - F x_k ).
\end{align*}

\emph{Quasidefinite} systems
\[ Kx=b, \qquad
K = \begin{pmatrix}
  - A & C \\ C^T & B 
\end{pmatrix},
\qquad
A, B \succ 0
\]
can be written as
\[
F(x) = 0,
\qquad F(x) = J ( K x - b ),
\quad J = \begin{pmatrix} -I & 0 \\ 0 & I \end{pmatrix}, \]
split using
\[
K_1 = \begin{pmatrix} -A & 0 \\ 0 & B \end{pmatrix},
\qquad
K_2 = \begin{pmatrix} 0 & C \\ C^T & 0 \end{pmatrix},
\]
and solved with Peaceman-Rachford.

\emph{ADMM} solves
\[ \begin{array}{ll}
  \text{Find} & x, z \\
  \text{To minimize} & f(x) + g(z) \\
  \text{Such that} & Ax + Bz = c
\end{array} \]
by applying Douglas-Rachford to the dual problem
\[ \operatorname*{Maximize}_\nu - f^* ( - A ^T \nu ) - g^* ( - B^T \nu ) + c^T \nu \]
(there are other derivations of ADMM).

\nextbook
\begin{book}
  \emph{Parameter selection and pre-conditioning\\ for a graph form solver}\\
  C. Fougner and S. Boyd (2015)
\end{book}
The \emph{graph form} optimization problem
\[ \begin{array}{ll}
  \text{Find} & x, y \\
  \text{To minimize} & f(y) + g(x) \\
  \text{Such that} & y = Ax
\end{array} \]
can be solved with ADMM
\begin{align*}
  (x',y') &= \operatorname{prox}_g ( x - \tilde x) , \operatorname{prox}_f ( y - \tilde y ) \\
  (x,y) &= \Pi ( x' + \tilde x , y' + \tilde y ) \\
  (\tilde x, \tilde y) &= \bigl(
  \tilde x - ( x - x' ) ,
  \tilde y - ( y - y' )
  \bigr).
\end{align*}
This can be sped up with
\begin{compactitem}[--]
\item Over-relaxation: replace $x'$ with
  $\alpha x' + (1-\alpha) x$, $\alpha \in (1.5, 1.8)$;
\item Approximate projection
\item Preconditioning:
  replace $y$, $x$ and $A$ with $Dy$, $E^{-1}x$ and $DAE$ respectively,
  such that the singular values of $DAE$ be close to 1
  \[ \operatorname{cond}(DAE) \approx 1, \qquad \n{ DAE }_2 \approx 1; \]
\item Adaptive proximal penalty $\rho$,
  \[ \operatorname{prox}_f v = \argmin_z f(z) + \dfrac\rho2 \n{x-v}_2^2 \]
  (start with a large $|rho$,
  which encourages primal feasibility,
  then, when the primal variables $(x,y)$ converge, decrease it;
  when the dual variables $(\tilde x, \tilde y)$ converge, increase it again).
\end{compactitem}

Applications include portfolio optimization:
$w' \mu - \lambda w' ( FF' + D ) w$ becomes
\begin{align*}
  g(x) &= x' \mu - \lambda x' D x + I( x \geq 0 ) \\
  f(y) &= \lambda y' y + I( y_{m+1} = 1 ) \\
  y &= \begin{pmatrix} F' \\ \mathbf 1 ' \end{pmatrix} x.
\end{align*}

C++ implementation: \texttt{pogs}.

\nextbook
\begin{book}
  \emph{Pretrained transformers for text ranking: BERT and beyond}\\
  J. Lin at al. (2021)
\end{book}

Information retrieval is often done in two steps:
first identify a set of documents ``close'' to the query,
with a bag-of-words approach such as BM25 (lucene)
\[ \text{BM}_{25}(q,d) =
\sum_{t \in q \inter d}
\log \dfrac{ N - \text{df}_t + .5 }{ \text{df}_t + .5 }
\cdot
\dfrac{
  \text{df}_{d,t}(k+1)
}{
  \text{tf}_{d,t} + k \cdot ( 1-n+b \ell_d / L )
} \]
(where $\ell_d$ is the length of document $d$ and $L$ the average document length),
second, rerank those documents, e.g., using
\begin{compactitem}[--]
\item Cosine similarity between query and document embeddings
\item An \d{interaction model}, \ie, a neural network exploiting the histogram of similarities between query terms and document terms
\end{compactitem}
\[
