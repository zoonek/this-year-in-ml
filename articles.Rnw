  \node[circle,fill] at (1,1) {};
  \node[circle,fill] at (2,2) {};
  \node[anchor=south west] at (2,2) {\footnotesize$x$};
  \node[anchor=west] at (1.1,.9) {\footnotesize$\Pi_C(x)$};
  \node[anchor=east] at (0,0) {\footnotesize$Q_C(x)$};
  \draw (0,0) -- (2,2);
\end{tikzpicture}
\]

\textbf{4.} A relation $f$ is \emph{monotone} if
\[ \forall x, y \ (fx - fy )^T ( x - y ) \geq 0 ; \]
it is \emph{maximal} if there is no larger monotone relation
(for the inclusion, on $\RR^n \times \RR^n$);
it is \emph{strongly monotone} if $\forall x, y \ (fx - fy )^T (x-y) \geq m \n{x-y}^2$
($m>0$).
For a strongly monotone Lipschitz relation,
\[ \forall x, y \ m \n{ x - y }^2 \leq ( fx - fy )^T (x-y) \overset{\text{CS}}{\leq} L \n{ x-y }^2,
\]
the condition number is $\kappa = L/m$.

If $F$ is maximal monotone, then so if $F^{-1}$.

If $F$ is strongly monotone with parameter $m$,
the $F^{-1}$ is Lipschitz with constant $1/m$
(but if $F$ is Lipschitz, $F^{-1}$ need not be strongly monotone).

If $f$ is CCP, then $\partial f$ is maximal monotone.

A CCP $f$ is strongly convex if $f(x) - m \n x ^2$ is convex or, equivalently,
if $\partial f$ is strongly monotone with parameter $m$.
A CPP $f$ is strongly convex with parameter $m$ iff $f^*$ is strongly smooth with parameter $L=1/m$.
\[
\begin{tikzpicture}[>=stealth,xscale=.3,yscale=.2,inner sep=1pt,outer sep=1pt,baseline=0,
  every text node part/.style={align=center, text width=2.5cm},
  ]
