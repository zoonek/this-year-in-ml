\nextbook
\begin{book}
  \emph{Stochastic interpolants:\\ a unifying framework for flows and diffusions}\\
  M.S. Albergo et al.
\end{book}
Given two probability distributions $p_0$ and $p_1$,
we want to progressively transform samples from $p_0$ into samples from $p_1$ (or the opposite).

Score-based diffusion models consider an OU process transforming $p_0$ into
an (approximate) Gaussian $p_0$,
we sample $x_1$ from $p_1$ (a Gaussian) and use the backward SDE
(its drift involves the score function $\nabla_{!x} \log p_t(x)$,
which has to be learned)
to get a corresponding $x_0$.
The path $(x_t)_t$ is stochastic,
but one can use an ODE instead,
and get a deterministic path.

% TODO: PLOT

Many paths give rise to the same intermediate distribution $p_t$:
deterministic, with straight lines (optimal transport) or not (normalizing flows,
in discrete ``time'', or neural ODE, in continuous time), or stochastic.

A \emph{stochastic interpolant} between $p_0$ and $p_1$ is a stochastic process $x$ of the form
\[ x_t = I( t, x_0, x_1 ) + \gamma(t) z, \qquad t \in [0,1] \]
where
\begin{align*}
  & I(0,x_0,x_1) = x_0 \\
  & I(1,x_0,x_1) = x_1 \\
  & \gamma(0) = \gamma(1) = 1 \\
  & \gamma \geq 0 \\
  & (x_0,x_1) \sim \nu \\
  & \text{pr}_{1\#} \nu = p_0, \ \text{pr}_{2\#} \nu = p_1 \\
  & z \sim N(0,I).
\end{align*}
For instance,
\[ x_t = (1-t) x_0 + t x_1 + \sqrt{ 1t(1-t) } z \]
or (pure noise for $t=\tfrac12$)
\[ x_t = \cos^2(\pi t) \bigl( \mathbf1_{ t < \tfrac12} x_0 + \mathbf1_{ t>\tfrac12} x_1 ) +
\sqrt{ 2 t (1-t) } z. \]
The density $(p_t)_t$ satisfies the \emph{transport equation}
\[ \partial_t p + \nabla \cdot (bp) = 0 \]
where the \emph{velocity} is
\begin{align*}
  & b(t,x) = \E[ \dot x_t | x_t = x ] \\
  & b = \argmin_b \E_{\substack{
      (x_0,x_1) \sim \nu \\
      z \sim N(0,I) \\
      t \sim \text{Unif}(0,1)
  }} \left[
    \tfrac12 \va{ b(t,x_t) }^2 = \dot x_t \cdot b(t,x_t) 
    \right] \\
  & b = v - \dot \gamma \gamma s
\end{align*}
Its \emph{score} is
\begin{align*}
  s &= \nabla_x \log p_t(x) = \gamma^{-1} \E[ z | x_t = x ] \\
  &= \argmin \E_{ x_0,x_1,z,t } \left[
    \tfrac12 \va{ s(t,x_t) }^2 + \gamma(t)^{-1} z \cdot s(t,x_t) 
    \right] \\
  &= \argmin \E[ \va s ^2 + e \nabla \cdot s ].
\end{align*}
The \emph{denoiser} is
\begin{align*}
  \eta(t,x) &= \E[ z | x_t | x ] \\
  \eta &= \argmin \E_{ x_0,x_1,z,t } \left[
    \tfrac12 \va{ \eta(t,x_t) }^2 = z \cdot \eta(t,x_t )
    \right]
\end{align*}
The \emph{velocity field} is
\begin{align*}
  v(t,x) &= \E\bigl[ \partial_t I(t,x_0,x_1) | x_t = x \bigr] \\
  v &= \argmin \E\bigl[ \tfrac12 \va v ^2 - \nabla_t Y \cdot v \bigr].
\end{align*}
The forward and backward \emph{Fokker-Plank equations} are
\begin{align*}
  \partial_t p + \nabla \cdot ( b_F p ) &= \epsilon \Delta p & p(0) &= p_0 \\
  \partial_t p + \nabla \cdot ( b_B p ) &= - \epsilon \Delta p & p(1) &= p_1
\end{align*}
where $\epsilon$ is a non-negative (or positive semi-definite) function,
and the forward and backward drifts are
\begin{align*}
  b_F(t,x) &= b(t,x) + \epsilon(t) s(t,x) \\
  b_B(t,x) &= b(t,x) - \epsilon(t) s(t,x).
\end{align*}
They are more robust than the transport equation to errors in the velocity and scores.

The following processes have the same law as the stochastic interpolant $x_t$.
\begin{align*}
  \dfrac{ d }{ dt} X_t &= b(t,X_t) & X_0 &\sim p_0 \\
  d X_t^F &= b_F(t,X_t^F) dt + \sqrt{ 2 \epsilon(t) } dW_t & X_0^F &\sim p_0 \\
  d X_t^B &= b_B(t,X_t^B) dt + \sqrt{ 2 \epsilon(t) } dW^B_t & X_1^B &\sim p_1 \\
  && W_t^B &= W_{1-t}
\end{align*}

The density $p_t$ can be computed from solutions of the ODE
\begin{align*}
  p_t(x)
  &= \exp \left(
  - \int_0^t \nabla \cdot b\bigl( \tau, X_{t,\tau}(x) \bigr) d\tau
  \right) p_0\bigl( X_{t,0} (x) \bigr) \\
  &= \exp \left(
  \int_t^1 \nabla \cdot b\bigl( \tau, X_{t,\tau}(x) \bigr) d\tau
  \right) p_1\bigl( X_{t,1} (x) \bigr)  
\end{align*}
where
\begin{align*}
  \dfrac{ d }{dt} X_{st}(x) &= b \bigl( t, X_{st} (x) \bigr) \\
  X_{ss}(s) &= x.
\end{align*}
For the SDEs:
\begin{align*}
  p_1^F(x) &= \E \left[
    \exp \left( \!- \!\!
    \int_0^1 \!\!\nabla \cdot b_F(t,Y_t^B) dt
    \right) p_0( Y_0^B)
    \middle| Y_1^B = x
    \right] \\
  p_1^B(x) &= \E \left[
    \exp \left( \!- \!\!
    \int_0^1 \!\!\nabla \cdot b_B(t,Y_t^F) dt
    \right) p_1( Y_1^F)
    \middle| Y_0^F = x
    \right]
\end{align*}

Other interpolants include:
\begin{compactitem}[--]
\item Diffusive interpolant
  \begin{align*}
    & x_t = I(t,x_0,x_1) + \sqrt{ 2 a(t) } B_t \\
    & B \text{: Brownian bridge}
  \end{align*}
\item One-sided interpolant
  \begin{align*}
    x_t &= \alpha(t) x_0 + J(t,x_1) \\
    \alpha &: \ 0 \leadsto 1 \\
    J &: \ 0 \leadsto x_1
  \end{align*}
\item Mirror interpolant (cf denoisers)
  \begin{align*}
    x_t &= k(t,x_1) + \gamma(t) z \\
    k &: \ x_1 \leadsto x_1
  \end{align*}
\item Linear interpolant
  \begin{align*}
    &x_t = \alpha(t) x_0 + \beta(t) x_1 + \gamma(t) z \\
    &\alpha(0) = \beta(1) = 1 \\
    &\alpha(1) = \beta(0) = \gamma(0) = \gamma(1) = 0 \\
    &\forall t \ \alpha^2 + \beta^2 + \gamma^2 = 1
  \end{align*}
\end{compactitem}

The \emph{Schr\"odinger bridge} problem is
\[ \begin{array}{ll}
  \text{Find} & u, p \\[4pt]
  \text{To minimize} & \displaystyle \iint\limits_{\substack{ t \in [0,1] \\ x \in \RR^n }} \va u ^2 p \\[6pt]
  \text{Such that}
  & \partial_t p + \nabla \cdot (up) = \epsilon \Delta p \\
  & p(0) = p_0, \ p(1) = p_1 
\end{array} \]
Its solution is $p, \nabla \lambda$, where
\begin{align*}
  \partial_t p + \nabla \cdot ( \nabla \lambda p ) = \epsilon \Delta p \\
  \partial_t \lambda + \tfrac12 \va{ \nabla \lambda }^2 = \epsilon \Delta \lambda.
\end{align*}

\nextbook
\begin{book}
  \emph{How to avoid machine learning pitfalls:\\ a guide for academic researchers}\\
  M.A. Jones
\end{book}

\nextbook
\begin{book}
  \emph{Flow matching for generative modeling}\\
  Y. Lipman et al.
\end{book}
A time-dependent vector field $v:[0,1]\times\RR^d \to \RR^d$
defines a flow $\phi: [0,1] \times \RR^d \to \RR^d$
\begin{align*}
  \dot \phi_t(x) &= v_t \bigl( \phi_t(x) \bigr) \\
  \phi_0(x) &= x
\end{align*}
and a probability density path
\[ p_t = ( \phi_t )_* ( p_0 ) \]
or, equivalently (\emph{continuity equation})
\[ \dot p + \div (pv ) = 0. \]

For each observation $x_1 \in \text{Data}$,
the optimal transport from $N(0,I)$ to
$N(x_1, \sigma_{\text{min}}^2)$ defines the \emph{conditional probability path}
\[ x_t \sim N\bigr( t x_1 , \bigl[ 1 - \sigma_{\text{min}} \bigr] ^2 \bigr) = p_t ( \cdot | x_1 ) \]
and the corresponding conditional vector field
\[ u_t = \dfrac{ x_1 - ( 1 - \sigma_{\text{min}} ) x }{ 1 - ( 1 - \sigma_{\text{min}} ) t } \]
(the deterministic probability flow of denoising diffusion models is more complex and can overshoot).

Find a vector field $v_t$ (a deep neural network) $v_t$ minimizing the
\emph{conditional flow matching} (CFM) objective
\[ \E_{\substack{
    t \sim \text{Unif}(0,1) \\
    x_1 \sim \text{Data} \\
    x \sim p_t( \cdot | x_1 )
}} \n{ v_t(x) - u_t( x | x_1 ) }^2 \]
(easier to train than score matching).

\nextbook
\begin{book}
  \emph{Improving and generalizing\\ flow-based generative models\\ with minibatch optimal transport}\\
  A. Tong et al.
\end{book}
The flow-matching objective
\[ \mathscr L(\theta) = \E_{\substack{
    t \sim \text{Unif}(0,1) \\
    x_1 \sim \text{Data} \\
    x \sim p_t(\cdot | x_0)
}}
\n{ v_\theta(t,x) - u_t(x|x_1) } ^2 \mathstrut \]
where
\begin{align*}
  p_t &= N\bigl( t x_1 , (t \sigma - t + 1 )^2 \bigr) \\
  u_t( x | x_1 ) &= \dfrac{ x_1 - (1-\sigma) x }{ 1 - (1-\sigma) t } 
\end{align*}
can be generalized to
\[ \E_{\substack{
    t \sim \text{Unif}(0,1) \\
    x_0, x_1 \sim q \\
    x \sim p_t(x_0,x_1)
    }}
\n{ v_\theta(t,x) - u_t(x|x_0,x_1) \mathstrut } ^2 \]
where
\begin{align*}
  q(x_0,x_1) &= q(x_0) q(x_1) \text{ (independent coupling)} \\
  u_t(x|x_0,x_1) &= x_1 - x_0 \\
  p_t(\cdot | x_0,x_1) &= N\bigl( t x_1 + (1-t) x_0 , \sigma^2 \bigr)
\end{align*}
or $q={}$optimal transport from $q_0$ to $q_1$,
or the entropy-regularized optimal transport.
\begin{align*}
  q &= \argmin_{\substack{
      (\text{pr}_0)_\#^{\mathstrut} \pi = q_0 \\
      (\text{pr}_1)_\#^{\mathstrut} \pi = q_1
  }} \text{KL} ( \pi \| \pi_{\text{ref}} ) \\
  p_t &= N \bigl( t x_1 + (1-t) x_0 , t(1-t) \sigma^2 \bigr) \\
  u_t &= \dfrac{ 1 - 2t }{ 2t(1-t) } \bigl[ x - \bigl( t x_1 + (1-t) x_0 \bigr) \bigr] + (x_1-x_0)
\end{align*}
Implementation in \texttt{torchcfm}.

\nextbook
\begin{book}
  \emph{Minibatch optimal transport distances; analysis and applications}\\
  K. Fatras et al.
\end{book}
Computing the optimal distance
on minibatches and averaging is efficient and biased
(and it is no longer a distance);
it can be debiased.

\nextbook
\begin{book}
  \emph{Poisson flow generative models}\\
  Y. Xu et al.
\end{book}
Given a probability distribution on $\RR^n$,
put electric charges in $[z=0] \subset \RR^n \times \RR$
according to it, and consider the motion of a particle (of the same charge)
starting at $(x,\epsilon) \in \RR^n\times\RR$, $\epsilon>0$:
after a while, those particles will be uniformly distributed on a hemisphere.

To generate data from this distribution,
start with uniform data on a large hemisphere,
and let it evolve along the reverse process.

Learn the Poisson field from data.
\begin{align*}
  & \Delta \phi = - \rho && \text{Poisson equation} \\
  & \rho : \RR^{n+1} \to \RR && \text{Source function} \\
  & \phi: \RR^{n+1} \to \RR && \text{Potential function} \\
  & E = - \nabla \phi && \text{Poisson field} \\
  & \dfrac{ \partial p }{ \partial t } = - \nabla \cdot ( p E ) && \text{Gradient flow} \\
  & \phi(x) = \int G(x,y) \rho(y) dy \\
  & G(x,y) \propto \n{ x - y }^{ (n+1) - 2 }
\end{align*}

\nextbook
\begin{book}
  \emph{PFGM++: unlocking the potential\\ of physics-inspired generative models}\\
  Y. Xu et al.
\end{book}
PFGM adds one dimension; instead, add $D$ dimensions.
The limit $D\to\infty$ corresponds to diffusion models, but smaller values give more robust models.

\nextbook
\begin{book}
  \emph{Elucidating the design space\\ of diffusion-based generative models}\\
  T. Karras et al.
\end{book}
Diffusion models consider a process in which
we progressively add noise to a sample from the data distribution
\begin{align*}
  x_0 &\sim p_0 \ \text{(data)} \\
  x_{k+1} &= x_k + \epsilon_{k+1}, \quad \epsilon_{k+1} \sim N( 0, \sigma_{k+1}^2 I ).
\end{align*}
For $k \gg 1$, $x_k$ is approximately Gaussian
\[ x_k \sim p_k \approx N(0, \sigma^2 I ). \]
Diffusion models try to reverse that process,
starting with $x_k \sim N(0,\sigma^2 I)$,
and trying to find $x_0 \sim p_0$.

Instead of looking at samples $x_k$, we can look at the corresponding distributions
\[ p_{k+1} = p_k * N( 0, \sigma_{k+1}^2 I ). \]
In the continuous limit, we have a probability flow
\begin{align*}
  x(0) &\sim p_0 \\
  \dot x &= - \dot \sigma \sigma \nabla_x \log p_t.
\end{align*}
\emph{Deterministic diffusion} models sample from $p_0$ as follows:
\begin{compactitem}[--]
\item Learn the score function $s = \nabla_x \log p_t$ from data;
\item Sample from $x(1) \sim N(0,\sigma^2 I) \approx p_1$;
\item Solve the ODE using $x(1)$ as final condition;
\item $x_0$ is then distributed as $p_0$.
\end{compactitem}
The ODE $\dot y = f(t,y)$ can be solved with Euler's method
\[ y_{i+1} = y_i + h f(t_i, y_i) \]
or \emph{Heun's method} (aka improved Euler, trapezoidal)
\begin{align*}
  \tilde y_{i+1} &= y_i + h f( t_i, y_i ) \\
  y_{i+1} &= y_1 + h \dfrac{ f(t_i,y_1) + f(t_{i+1} , \tilde y_{i+1}) }2.
\end{align*}
If we keep the stochasticity, the ODE becomes an SDE
\[ dx_{\pm} = - \dot \sigma \sigma s dt \pm \beta \sigma^2 s dt + \sqrt{ 2 \beta } \sigma dW \]
where $\beta = \dot \sigma / \sigma$ (other choices are possible), \ie
\begin{align*}
  d x_+ &= \sqrt{2\beta} \sigma dW && \text{adding noise} \\
  dx_- &= - 2 \dot \sigma\sigma s dt + \sqrt{2\beta} \sigma d\bar W && \text{denoising.}
\end{align*}
This is Anderson's \emph{time reversal} formula
\begin{align*}
  dX &= \mu dt + \sigma dW \\
  d\bar X &= ( \mu - \sigma^2 s) dt + \sigma d \bar W \\
  s &= \nabla_x \log p
\end{align*}
(valid if $\sigma=\sigma_t$ does not depend on $t$).
As in the deterministic case, \emph{stochastic diffusion} models sample from $p_0$:
\begin{compactitem}[--]
\item Learn the score function from data;
\item Sample $x(1)\sim N(0,\sigma^2I) \approx p_1$;
\item Solve (\ie, sample from) the backward SDE;
\item $x(0)$ is then distributed as $p_0$.
\end{compactitem}
To solve (\ie, sample from) an SDE
$dX = \mu dt + \sigma dW$,
Euler-Maruyama performs an ODE step and then adds noise;
\begin{align*}
  &\text{Euler} & \Delta X &= \mu \Delta t + \sigma \Delta W \\
  &\text{Milstein} & \Delta X &= \mu \Delta y + \sigma \Delta W + \tfrac12 \sigma \sigma' \bigl[ (\Delta W)^2 - \Delta y \bigr] \\
  &\text{RK} & \hat y_n &= y_n + \mu(y_n) \Delta t + \sigma(y_n) (\Delta t)^{1/2} \\
  && y_{n_1} &= y_n + \mu(y_n) \Delta t + \sigma(y_n) \Delta W + {} \\
  &&&\hphantom{{}={}}
  \dfrac{ \sigma(\hat y_n ) - \sigma( y_n ) }{ 2 }
  \dfrac{ (\Delta W)^2 - \Delta t }{ \sqrt{ \Delta t } }
\end{align*}
reversing those operations (pay attention to the step size:
it has to remain the same SDE).
\begin{align*}
  \tilde x_{i+1} &= x_1 + \mu(x_i,t_i) h \\
  x_{i+1} &= \tilde x_{i+1} + \sigma(x_i,t_i) ( W_{i+1} - W_i )
\end{align*}
The score can be computed from a \emph{denoiser}
\begin{align*}
  & D(\cdot,\sigma) = \argmin_D \E_{ y \sim \text{Data} }
  \E_{ \epsilon \sim N(0,\sigma^2 I) }
  \n{ D( y + \epsilon , \sigma ) - y \mathstrut} ^2 \\
  & \nabla_x \log p(x,\sigma) = \dfrac{ D(x,\sigma) - x }{ \sigma^2 }
\end{align*}
Do not learn $D$ directly (the magnitudes of the inputs and outputs depend on $\sigma$)
but $F$
\[ D(x,\sigma) = x - \sigma F(x) \]
or, better

\[ D(x, \sigma) =
\tikzmarknode{C1}{c_1(\sigma)}
+
\tikzmarknode{C2}{c_2(\sigma)}
F \bigl(
\tikzmarknode{C3}{c_3(\sigma)} x
,
\tikzmarknode{C4}{c_4(\sigma)}
\bigr)
\vrule height 0pt depth 2.1cm width 0pt
\begin{tikzpicture}[>=stealth, overlay, remember picture]
  \node (C1b) [below= 10mm of C1]{\footnotesize$
    \dfrac{ \sigma_{\text{data}}^2 }{ \sigma^2 + \sigma_{\text{data}}^2 }
  $};
  \node (C2b) [below= 3mm of C2]{\footnotesize$
    \dfrac{ \sigma \cdot \sigma_{\text{data}} }{ \sqrt{ \sigma^2 + \sigma_{\text{data}}^2 } }
    $}; 
  \node (C3b) [below= 10mm of C3]{\footnotesize$
    \dfrac{ 1 }{ \sqrt{ \sigma^2 + \sigma_{\text{data}}^2 } }
    $};
  \node (C4b) [below= 3mm of C4]{\footnotesize$\log \sigma$};
  \draw[->] (C1b) -- (C1);
  \draw[->] (C2b) -- (C2);
  \draw[->] (C3b) -- (C3);
  \draw[->] (C4b) -- (C4);
\end{tikzpicture}
\]

In the loss, use $1/c_2^2$ as weights.

Use data augmentation but, to prevent the augmentations from leaking into the generated images,
use the augmentation parameters as conditioning inputs fo $F$, and set them to zero during inference.

\nextbook
\begin{book}
  \emph{The unreasonable effectiveness\\ of deep features as a perceptual metric}\\
  R. Zhang et al.
\end{book}
The average distance between latent representations
is more consistent with human evaluations than traditional metrics.
Add a linear layer after the latent representation,
or fine-tune the whole network, if you have data (LPIPS, learned perceptual image patch similarity).

\nextbook
\begin{book}
  \emph{Tackling decision processes\\ with non-cummulative objectives\\ using reinforcement learning}\\
  M. N\"agele et al.
\end{book}
Non-cummulative MDPs (NCMDP) maximize an arbitrary function of the rewards,
rather than their discounted sum: Sharpe ratio, weakest link (maximize the minimum reward),
optimization (find the state with the maximum reward).
To apply classical RL algorithms, turn the NCMDP into an MDP:
\begin{compactitem}[--]
\item Replace the rewards with $f(r_{\leq t})$ - $f(r_{< t})$;
\item Augment the state space to make the decision process Markov (sufficient statistics).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Text embeddings reveal\\ (almost) as much as text}\\
  J.X. Morris et al.
\end{book}
To invert vector embeddings of text,
one could learn a mapping
\[ \left\{
\begin{array}{r@{\ }c@{\ }l}
  \text{embeddings} & \longrightarrow & \text{distributions on text} \\
  e & \longmapsto & p(t|e).
\end{array}
\right. \]
Instead, train an error-correcting model
$(e,\epsilon) \longmapsto p(t|e,\epsilon)$
and apply it iteratively
%\[ e \mapsto t \mapsto \bigl( e , \text{emb}(t) - e \bigr) \mapsto t \mapsto \cdots \]
\[ e \longmapsto t \longmapsto \bigl( e , \text{emb}(t) - e \bigr) \longmapsto t \longmapsto \cdots \]
(4 times is enough).

\nextbook
\begin{book}
  \emph{Lag-Llama: towards foundation models\\ for probabilistic time series forecasting}\\
  K. Rasul et al.
\end{book}
Pretrain a transformer on 8000 time series (with stratified sampling),
using lag features and time features,
and Freq-Mix, Freq-Mask data augmentation,
for univariate probabilistic forecasts (output the parameters of a Student $T$ distribution).
Also check:
AutoArima, AutoETS, CrostonSBA, DynOptTheta, NPTS;
AutoGluon (DeepAR, PatchTST, TFT);
N-BEATS, Informer, Autoformer, ETSFormer; OneFitsAll.

\nextbook
\begin{book}
  \emph{MOMENT: A family of open\\ time-series foundation models}\\
  M. Goswami et al.
\end{book}
The \emph{time series pile} is a large collection of time series from various domains.
Train a simple transformer (3 sizes)
for masked prediction
(divide the time series into patches, mask some of them,
project to a $d$-dimensional embedding, apply a transformer, and reconstruct the patches);
use for forecasting, prediction, anomaly detection, imputation.

Non-transformer approaches may work better: ARIMA (short-horizon forecasting),
N-BEATS (long-horizon), $k$-NN (anomaly detection).
\\
Also check: Time-LLM, GPT4TS (OneFitsAll), TimesNet, PatchTST, FedFormer, DLinear, Stationary, LightTS, SeasonalNaive, AnomalyTransformer

\nextbook
\begin{book}
  \emph{One Fits All: power general time series analysis by pretrainined LM}\\
  T. Zhou et al.
\end{book}
LLMs are of the form
\[
\!
\begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=2pt,outer sep=1pt]
  \node (A) {\smash[b]{input}};
  \node[fill=blue!10] (B) [right=3mm of A] {encoder\strut};
  \node[fill=blue!10] (C) [right=3mm of B] {transformers\strut};
  \node[fill=blue!10] (D) [right=3mm of C] {decoder\strut};
  \node (E) [right=3mm of D] {\smash[b]{output.}};
  \draw[->] (A) -- (B);
  \draw[->] (B) -- (C);
  \draw[->] (C) -- (D);
  \draw[->] (D) -- (E);
\end{tikzpicture}
\]
Freeze the transformers (the ``intelligence'' of the model)
and retrain just the encoder (patch embedding) and decoder, for time series tasks
(imputation, classification, anomaly detection, long-term/short-term/few-shot/zero-shot forecasting).

\nextbook
\begin{book}
  \emph{A time series is worth 64 words:\\ long-term forecasting with transformers}\\
  Y. Nie et al.
\end{book}
PatchTST (time series transformer):
\begin{compactitem}[--]
\item Does not use pointwise attention, but segments the time series into patches;
\item Independently processes the components of a multivariate time series,
  with shared weights for the embedding and transformers.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Informer: beyond efficient transformer\\ for long sequence time series forecasting}\\
  H. Zhou et al.
\end{book}
The sparsity of a query $q_i$ is
\[ \text{KL}\bigl( \text{Unif} \,\|\, p(k_j|q_i) \bigr); \]
up to a constant
\[ \log \sum_j \exp \dfrac{ q_i k_j^\top }{ \sqrt d }  -
\operatorname*{Mean}_j \dfrac{ q_i k_j^\top }{ \sqrt d }.
\]

\emph{ProbSparse} attention is
\[ (Q,K,V) \longmapsto
\text{Softmax} \left( \dfrac{ \bar Q K^\top }{ \sqrt d } \right) V \]
where $\bar Q$ only contains the top-$u$ entries of $Q$
(the others are uninformative).

Self-attention distillation reduces the time dimension
(1-dimensional convolution, width=3, maxpooling, stride=2).

\nextbook
\begin{book}
  \emph{Autoformer: decomposition transformers\\ with autocorrelation\\ for long-term series forecasting}\\
  H. Wu et al.
\end{book}
Autocorrelation self-attention uses a convolution between keys and values instead of a product.
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.4,inner sep=0pt,outer sep=1pt,baseline=0]
  \node (Q) at (0,4) {$Q$};
  \node (K) at (0,2) {$K$};
  \node (V) at (0,0) {$V$};
  \node[draw,inner sep = 2pt] (F1) at (1,4) {$\mathscr F$};
  \node[draw,inner sep = 2pt] (F2) at (1,2) {$\mathscr F$};
  \node[draw,inner sep = 2pt] (F3) at (3,3) {$\mathscr F^{-1}$};
  \node[circle,draw] (x1) at (2,3) {\footnotesize$\times$};
  \node[circle,draw] (x2) at (4,1.5) {\footnotesize$\times$};
  \node[anchor=south] at (4,3) {\footnotesize \ \ top-$k$};
  \node (o) at (4.7,1.5) {};
  \draw[->] (Q) -- (F1);
  \draw[->] (K) -- (F2);
  \draw[->] (V) -| (x2);
  \draw[->] (F1) -| (x1);
  \draw[->] (F2) -| (x1);
  \draw[->] (x1) -- (F3);
  \draw[->] (F3) -| (x2);
  \draw[->] (x2) -- (o);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{FEDFormer: frequency enhanced decomposed transformer for long-term series forecasting}\\
  T. Zhou et al.
\end{book}
Use a seasonal-trend decomposition, and apply the transformer in the frequency domain.

\nextbook
\begin{book}
  \emph{ITransformer: inverted transformers\\ are effective for time series forecasting}\\
  Y. Liu et al.
\end{book}
(For multivariate time series),
instead of attention between timestamps, use attention between time series.

\nextbook
\begin{book}
  \emph{Anomaly transformer: time series anomaly detection with association discrepancy}\\
  J. Xu et al.
\end{book}
Anomalies, in a time series, may be similar to their immediate neighbourhood,
but not the whole series.
The \emph{anomaly transformer}
measures this by the discrepancy (symmetrized KL divergence)
between the ``prior association''
\[ P_i = \phi \left(
- \dfrac{ \va{j-i} }{ \sigma_i }
\right)_{ 1 \leq j \leq N}
\]
and the ``series association''
\[ S_i = \text{Softmax} \left(
\dfrac{ Q_i K^\top }{ \sqrt d }
\right). \]
The prior association is trained to minimize discrepancy.
The series association is trained to maximize discrepancy and reconstruct the input.

\nextbook
\begin{book}
  \emph{Mamba: linear time sequence modeling\\ with selective state spaces}\\
  A. Gu and T. Dao
\end{book}
The S4 model is a continuous model
\begin{align*}
  \dot h &= A h + Bx \\
  y &= C h,
\end{align*}
discretized
\[
\begin{aligned}
  h_t &= \bar A h_{t-1} + \bar B x_t \\
  y_t &= C h_t
\end{aligned}
\qquad
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.9,inner sep=0pt,outer sep=1pt,baseline=23]
  \node (h1) at (0,1) {$h_{t-1}$};
  \node (h2) at (1,1) {$h_t$};
  \node (x) at (1,0) {$x_t$};
  \node (y) at (1,2) {$y_t$};
  \draw[->] (h1) to node[below=1pt]{\footnotesize $B$} (h2);
  \draw[->] (x) to node[right=1pt]{\footnotesize $A$} (h2);
  \draw[->] (h2) to node[right=1pt]{\footnotesize $C$} (y);  
\end{tikzpicture}
\]

The discretization can be naive
\begin{align*}
  \bar A &= I + h A \\
  \bar B &= h B 
\end{align*}
or not
\begin{align*}
  \bar A &= \exp( \Delta A ) \\
  \bar B &= ( \Delta A )^{-1} ( \bar A - I ) ( \Delta B ).
\end{align*}
The matrix $A$ is structured, e.g., diagonal.
The state space model (SSM)
is applied independently to each channel.
Since the model's dynamics are constant over time
(linear time invariant (LTI) model),
it can be computed efficiently.

In the S6 model, $B$, $C$, $\Delta$
depend on the input $x$ (linearly, with a softplus for $\Delta$).
It can still be implemented efficiently.

\nextbook
\begin{book}
  \emph{A decoder-only foundation model\\ for time series forecasting}\\
  A. Das et al.
\end{book}
Yet another time series foundational model,
which breaks down the time series into patches
(with larger patches in the output than in the input, for long-term forecasts).

\nextbook
\begin{book}
  \emph{Time-LLM: time series forecasting\\ by reprogramming large language models}\\
  M. Jin et al.
\end{book}
Use a pretrained LLM for time series forecasting:
as inputs, provide an embedding (pre-trained, frozen)
of a textual description of the time series (metadata in the prompt)
and a sequence of patch embeddings (trained transformer);
process with a pretrained, frozen LLM;
and decode the output into a time series (trained transformer).
\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.9,inner sep=0pt,outer sep=1pt,baseline=0]
  \node[align=center] (i1) at (0,5.2) {textual\\description};
  \node[align=center] (i2) at (2,5.2) {time series\\patches};
  \node[inner sep = 2pt, fill=black!10] (L1) at (0,4) {LLM};
  \node[inner sep = 2pt, fill=green!15] (T1) at (2,4) {Transformer};
  \node (e1) at (0,3) {embedding};
  \node (e2) at (2,3) {embedding};
  \node[inner sep = 2pt, fill=black!10] (L2) at (1,2) {LLM};
  \node[inner sep = 2pt, fill=green!15] (T2) at (1,1) {Transformer};
  \node (o)  at (1,0) {output time series};
  \draw[->] (i1) -- (L1);
  \draw[->] (i2) -- (T1);
  \draw[->] (L1) -- (e1);
  \draw[->] (T1) -- (e2);
  \draw[->] (e1) -- (L2);
  \draw[->] (e2) -- (L2);
  \draw[->] (L2) -- (T2);
  \draw[->] (T2) -- (o);
  \node[anchor=west, inner sep = 2pt, fill=black!10] at (3,.6) {Frozen};
  \node[anchor=west, inner sep = 2pt, fill=green!15] at (3,0) {Trained};
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Learning programs by learning from failures}\\
  A. Cropper and R. Morel
\end{book}
\texttt{Popper} is an inductive logic programming (ILP) system
(learning from  failures, LFF):
\begin{compactitem}[--]
\item Start with a set of hypotheses;
\item Pick one of them, check if it fits the data;
\item Prune the set of hypotheses if it does not
  (remove its generalizations if the hypothesis entails a negative example (too general),
  remove its specializations if it does not entail all the positive examples (too specific).
\end{compactitem}
Also check: Aleph, Metagol (Prolog), ILASP3 (answer set programming),
$\partial$ILP (neural nets).

\nextbook
\begin{book}
  \emph{Direct least squares fitting of ellipses}\\
  A. Fitzgibbon et al. (1999)
\end{book}
To fit an ellipse (not an arbitrary conic) to a cloud of points
\[ \begin{array}{ll}
  \text{Find} & \underline a = (a\ b\ c\ d\ e\ f)' \\
  \text{To minimize} & \sum_i F( \underline a \cdot \underline x _i ) ^2 \\
  \text{Subject to} & b^2 - 4 ac = -1 \\
  \text{Where} & \underline x = ( x^2 \ xy \ y^2 \ x \ y\ 1 )'
\end{array} \]
(the constraint can be written $a' C a = 1$).

Using Lagrange multipliers, this reduces to
a generalized eigenvalue problem
\begin{align*}
  & D' D a = \lambda C A \\
  & a' C a = 1
\end{align*}
where the design matrix is $D = [ \underline x_1 , \dots , \underline x_n ]'$.
The solution is given by the unique positive eigenvalue.
  
\nextbook
\begin{book}
  \emph{Topological time series analysis}\\
  J.A. Perea
\end{book}
The \emph{maximum persistence} (length of the longest interval in the 1-dimensional barcode)
is a useful feature, e.g., for periodicity quantification
(gene expression, video) and regime (changepoint) detection.

\nextbook
\begin{book}
  \emph{Sliding windows and persistence:\\ an application of topological methods\\ to signal analysis}\\
  J.A. Perea and J. Harer (2013)
\end{book}
\emph{Maximum persistence} can be used to quantify periodicity (deciding whether a time series is periodic).
% Technical
Also check: \texttt{jtk\_cycle}, Lomb-Scargle.

\nextbook
\begin{book}
  \emph{\texttt{Jtk\_cycle}: an efficient non-parametric algorithm for detecting rhythmic components in genome-scale datasets}\\
  M.E. Hughes et al. (2010)
\end{book}
% Badly written; no details
To test if a signal is periodic:
\[ \argmax_{\phi, T} \tau \bigl( x[i] , s_{\phi,T}[i] \bigr) \]
where $x$ is the data, $i=\text{argsort}(x)$, $\tau$ is Kendall's tau,
and $s_{\phi,T}$ is a signal with phase $\phi$ and period $T$ --
but the objective function oscillates a lot.
R implementation in \texttt{MetaCycle}.

\nextbook
\begin{book}
  \emph{MetaCycle: an integrated R package\\ to evaluate periodicity in large scale data}\\
  G. Wu et al.
\end{book}
% No details

\nextbook
\begin{book}
  \emph{Universal differential equations\\ for scientific machine learning}\\
  C. Rackaukas et al. (2021)
\end{book}
UDEs model physical systems as $x'' = f_\theta(x) + \epsilon(x)$, where
\begin{compactitem}[--]
\item $f_\theta$ is a known function corresponding to a known approximation of the phenomenon (or 0);
\item $\theta$ are unknown parameters (mass of an object, charge of a particle, etc.);
\item $\epsilon$ is a free-form unknown function (e.g., a neural net);
\item The ODE can be replaced with a PDE.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Down with determinants}\\
  S. Axler (1995)
\end{book}
Most of linear algebra (eigenvalues, minimal polynomial, characteristic polynomial, Jordan form, etc.)
can be done without determinants --
they are still needed for the change-of-variable formula in multiple integrals,
but they can be defined as the product of the eigenvalues, with multiplicity.
More details in his book, \emph{Linear algebra done right}.

\nextbook
\begin{book}
  \emph{A survey of the Schr\"odinger problem and some of its connections with optimal transport}\\
  C. L\'eonard (2014)
\end{book}
The \emph{dynamic Schr\"odinger problem} (Schr\"odinger bridge) is
\[ \operatorname*{Minimize}_P \text{KL}( P \| R ) \text{ such that } P_0 = \mu_0, \ P_1 = \mu_1 \]
where
\begin{compactitem}[--]
\item $P$ is a probability measure on $\mathscr C^0\bigl( [0,1] , \RR^n \bigr)$;
\item $R$ is the law of Brownian motion on $\RR^n$ (unbounded measure);
\item $\mu_0$, $\mu_1$ are probability measures on $\RR^n$ (prescribed marginals).
\end{compactitem}

The \emph{static Schr\"odinger problem} is
\[ \operatorname*{Minimize}_\pi \text{KL} \bigl( \pi \| R_{01} \bigr)
\text{ such that } \pi_0 = \mu_0, \ \pi_1 = \mu_1 \]
where
\begin{compactitem}[--]
\item $R_{01}$ is the joint law of the initial and final positions of $R$;
\item $\pi$ is a probability measure on $(\RR^n)^2$.
\end{compactitem}
The two are linked by
\[ P(\cdot) = \int_{ (\RR^n)^2 } R^{xy} (\cdot) \pi(dx\,dy) \]
where $R^{xy}$ is the Brownian bridge from $x$ to $y$
\[R^{xy}(\cdot) = R(\cdot | X_0 = x, X_1 = y)\]
(the Schr\"odinger bridge is a mixture of Brownian bridges, governed by $\pi$).

These are eerily similar to the (Monge-Kantorovich) dynamical and static optimal transport problems.

\nextbook
\begin{book}
  \emph{An introduction to Otto's calculus}\\
  L. Ambrosio et al. (2021)
\end{book}
The Wasserstein distance on $\mathscr P_2^a(\RR^2)$,
the space of absolutely continuous measures
$\mu = \rho dx$, comes from the scalar product on $T_\rho \mathscr P_2^a(\RR^n)$
\[ \langle s , s' \rangle = \int \langle \nabla \phi , \nabla \phi' \rangle \rho dx \]
where
\begin{compactitem}[\ensuremath{\bigcdot}]
\item $s, s' \in T_\rho \mathscr P_2^a(\RR^n)$, \ie, they are functions with zero mean,
  $\int s \rho dx = 0$;
\item $ - \div \bigl[ (\nabla \phi) \rho ] = s $;
\item $ - \div \bigl[ (\nabla \phi') \rho ] = s' $.
\end{compactitem}
The gradient flow $\rho_t$ for the vector field $\nabla \phi_t$ is the solution of the continuity equation
\[ \dfrac{ d }{ dt } \rho_t + \div \bigl[ (\nabla \phi_t ) \rho_t \bigr] = 0. \]
% Not read; technical; many undefined notations

\nextbook
\begin{book}
  \emph{Comment: causal inference competitions: where should we aim?}\\
  E. Karavani et al.
\end{book}
Because of the ``fundamental problem of causal inference''
(we cannot observe counterfactuals),
we have to limit ourselves to simulation studies.
But they rely on strong/arbitrary assumptions,
which may not hold in real setups:
vary the parameters of the DGP, and score them separately
(only aggregate the scores if you need to select a single winner).
It is possible to use real observational data,
when there is a soon-to-be published experimental trial.

% TODO: CAUSALITY COMPETITIONS?

\nextbook
\begin{book}
  \emph{Adjustment identification distance:\\ a gadjid for  causal structure learning}\\
  L. Henckel et al.
\end{book}
To define a causal distance between two DAGs, $g_{\text{true}}$ and $g_{\text{guess}}$
\begin{compactitem}[--]
\item For each pair of nodes $(TmY)$, compute a valid adjustment set in $g_{\text{guess}}$;
\item Check if it is a valid adjustment set in $g_{\text{true}}$;
\item Count the discrepancies.
\end{compactitem}
There are many possible choices for the valid adjustment set:
\begin{compactitem}[--]
\item The parents of $T$(this gives the SID, structural intervention ``distance'' --
  note that $d( g_{\text{true}}, g_{\text{guess}} ) = 0$ iff $g_{\text{true}} \subset g_{\text{guess}}$);
\item All the nodes before $T$ in a topological order; 
\item The ``optimal adjustment set''.
\end{compactitem}This can be generalized to other (non-adjustment-based) identification strategies,
provided you can check if it is valid.

Implementation (Rust/Python) for DAGs and CPDAGs in \texttt{gadjid}.

\nextbook
\begin{book}
  \emph{Graphical criteria\\ for efficient total effect estimation\\ via adjustment in causal linear models}\\
  L. Henkel et al. (2020)
\end{book}
% Clear, with examples
Parent adjustment is not optimal,
in terms of asymptotic variance.
Instead, use
$\text{pa}( \text{cn} ) \setminus \text{forb}$,
where
\begin{compactitem}[--]
\item cn are the ``causal nodes''  of $X \to Y$, \ie, nodes on a directed path
  $X \to \cdots \to Y$, excluding $X$ but including $Y$ (mediators);
\item pa are the parents;
\item $\text{forb} = \text{de} ( \text{cn} ) \union \{ X \}$: forbidden nodes;
\item dec(cn) are the descendants of cn, including cn.
\end{compactitem}
The adjustment set prefers variables explaining less of $X$ and more of $Y$.
For instance, if the DAG is
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline=0]
  \node (A) at (0,1) {$A$};
  \node (B) at (3,1) {$B$};
  \node (X) at (0,0) {$X$};
  \node (Y) at (3,0) {$Y$};
  \node (u) at (1,1) {};
  \node (v) at (2,1) {};
  \draw[->] (A) -- (u);
  \draw[->] (u) -- (v);
  \draw[->] (v) -- (B);
  \draw[->] (B) -- (Y);
  \draw[->] (X) -- (Y);
  \draw[->] (A) -- (X);
\end{tikzpicture}
\]
do not condition on $A$, but on $B$.

\nextbook
\begin{book}
  \emph{Measuring causality with the\\ variability of the largest eigenvalue}\\
  A.R. Dominguez and O.H. Yadav (2024)
\end{book}
% No.
$\lambda_1 / ( \lambda_1 + \lambda_2 )$
where $\{\lambda_1, \lambda_2\}$ is the spectrum of $\var[ Y_t, X_{t-k} ]$.

\nextbook
\begin{book}
  \emph{Efficient causal graph discovery\\ using large language models}\\
  T. Jiralerspong et al.
\end{book}
To learn causality from metadata, using an LLM,
do not feed the pairs of variables one by one
(``which is more likely? 1. $A \to B$ 2. $B \to A$ 3. $A \leftarrow \cdot \rightarrow B$ 4. $A \indep B$)
but progressively
\begin{compactitem}[--]
\item Which are the variables not caused by any other?
\item Which are the variables caused directly by $X$? (Give all the conclusions so far to the LLM; you can also provide more information, e.g., $\cor(X,\cdot)$.)
\item Continue, depth-first, until you have exhausted all the variables.
\end{compactitem}

\nextbook
\begin{book}
  \emph{A survey on causal discovery:\\ theory and practice}\\
  A. Zanga and F. Stella (2023)
\end{book}
Conditional independence relations cannot distinguish between
all DAGs: they can only recover the \emph{Markov equivalence class}  (MEC)
of the causal model, which can be described by its CPDAG
(completed partial directed acyclic graph),
a PDAG where
\begin{compactitem}[--]
\item All undirected edges are reversible (you can choose either direction, that will not change the MEC);
\item All directed edges are compelled (if you flip them, the graph moves to another MEC).
\end{compactitem}

If we want to account for missing confounders,
things get more complicated, and the graphs (partial ancestral graphs, PAG)
have 4 types of edges:
\begin{compactitem}[--]
\item 
$X 
\begin{tikzpicture}[>=stealth,scale=.5,inner sep=1pt,outer sep=0pt,baseline=-3]
  \node[circle] (A) at (0,0) {};
  \node[circle] (B) at (1,0) {};
  \draw[->] (0,0) -- (1,0);
\end{tikzpicture}
Y$ cause
\item 
$X 
\begin{tikzpicture}[>=stealth,scale=.5,inner sep=1pt,outer sep=0pt,baseline=-3]
  \node[circle] (A) at (0,0) {};
  \node[circle] (B) at (1,0) {};
  \draw[<->] (0,0) -- (1,0);
\end{tikzpicture}
Y$ unobserved confounder
\item $X 
  \begin{tikzpicture}[>=stealth,scale=.5,inner sep=1pt,outer sep=0pt,baseline=-3]
  \node[circle,draw] (A) at (0,0) {};
  \node[circle] (B) at (1,0) {};
  \draw[->] (A) -- (1,0);
\end{tikzpicture}
Y$ cause or missing confounder
\item $X 
  \begin{tikzpicture}[>=stealth,scale=.5,inner sep=1pt,outer sep=0pt,baseline=-3]
  \node[circle,draw] (A) at (0,0) {};
  \node[circle,draw] (B) at (1,0) {};
  \draw[-] (A) -- (B);
\end{tikzpicture}
Y$ any of the above
\end{compactitem}
Allowing for cycles (feedback) complicates things further
($\sigma$-separation and directed mixed graphs).

Here are some causal discovery algorithms.
\begin{compactitem}[--]
\item The \emph{PC algorithm} starts with a complete graph,
  uses conditional independence tests to remove edges and identify colliders,
  and finally orients some of the remaining edges, assuming we have found all the colliders.
\item The \emph{FCI} algorithm generalizes this to account for unobserved confounders.
\item The \emph{GES} algorithm (greedy equivalence search) adds the edges one by one,
  to increase a score (BIC, AIC, BDeu, BDs). % No details...
\item \emph{FGES} is an efficient implementation of GES, avoiding recomputations.
\item Greedy FCI (\emph{GFCI}), is FCI on the GES skeleton.
\item \emph{LinGAM} assumes the SCM is linear with non-Gaussian independent noise
  $ x = A x + \epsilon$ (with $A$ triangular),
  \ie, $\epsilon = (I-A) x$, and uses ICA to find the linear transformation
  of $x$  whose coordinates maximize non-Gaussianity.
\item \emph{NOTEARS} looks for a matrix $A$ such that $x \approx Ax$,
  with the constraint that it be acyclic -- this can be formulated as
  $\tr \exp \va A = n$, where $A$ is the elementwise absolute value and $n$ the number of variables.
\item Interventional algorithms include GIES, IGSP, FCI-JCI, $\Psi$-FCI, DCDI, etc.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Methods and tools\\ for causal discovery and causal inference}\\
  A.R. Nogueira et al. (2022)
