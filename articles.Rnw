\nextbook
\begin{book}
  \emph{Introducing localgauss, an R package\\ for estimating and visualizing\\ local Gaussian correlation}\\
  G.D. Berensten et al. (2014)
\end{book}
To assess local changes in correlation, look at:
\begin{compactitem}[--]
\item The correlation curve, $x \mapsto \rho(x)$,
  \begin{align*}
    \rho &= \beta \dfrac{ \sigma_X }{ \sigma_Y } =
    \dfrac{ \beta \sigma_X }{ \sqrt{ ( \beta \sigma_X )^2 + \sigma_\epsilon^2 } } \\
    \beta(x) &= \dfrac{ d }{ dx } \E[ Y | X = x ] \\
    \sigma\epsilon^2(x) &= \var[ Y | X = x ];
  \end{align*}
\item The conditional correlation (exceedance correlation) --
  but, for a Gaussian distribution it tends to 0 in the tails (unless $\va\rho=0$);
\item The Holland-Wang dependence
  \[ \gamma(x,y) = \dfrac{ \partial^2 }{ \partial x \partial y } \log f_{X,Y}(x,y), \]
  but it is not in $[-1,+1]$ --
  in the Gaussian case,
  \[ \gamma = \dfrac{ \rho }{ 1 - \rho^2 } \dfrac{ 1 }{ \sigma_X \sigma_Y }; \]
\item The \emph{local Gaussian correlation}, obtained by maximizing the \emph{local likelihood}
  \begin{align*}
    & f \text{: density} \\
    & \phi_\theta \text{: Gaussian density with parameter $\theta$} \\
    & \operatorname*{Minimize}_{\theta_x} \int \! k_h(v-x) \bigl[ \phi_{\theta_x} (v) - \log \phi_{\theta_x} (v) f(v) \bigr] dv \\
    & \llap{\ie} \int\! k_h(v-x) \nabla_{\!\theta} \log \phi_\theta(v) \bigl[ f(v) - \phi_\theta(v) \bigr] dv = 0.
  \end{align*}
\end{compactitem}
\hbox to \hsize{%
<<localgauss,results='hide',echo=FALSE,fig.width=5,fig.height=5,out.width='.45\\hsize',fig.show='hold'>>=
library(copula)
library(localgauss)
library(ggplot2)

c <- claytonCopula(3)
xy <- rCopula(1e4,c)
xy <- qnorm(xy)
r <- localgauss( xy[,1], xy[,2] )

## From localgauss 0.35 (they removed the plotting function in 0.40...)
plot.localgauss=function(x,..., plot.text=TRUE,plot.points=FALSE,tsize=3,
  lowcol="cyan",highcol="magenta",point.col="black",
  point.size=NULL,xlab="",ylab="",divergent.col.grad=T){
        # to provide consistency with S3 generic functions
        lgobj = x
        # Dummies to trick R CMD check 
        x.obs <- NULL; rm(x.obs);
        y.obs <- NULL; rm(y.obs);
        #Objects to plot.
        dat.obs = data.frame(x.obs=lgobj$x,y.obs=lgobj$y)
        rho = lgobj$par.est[,5]
        x = lgobj$xy.mat[,1]
        y = lgobj$xy.mat[,2]
        
        #Format rho with leading sign.
        rho.label = formatC(rho,digits=2, format="f",flag="+")                      
        #Dataframe for plotting rho.
        d = data.frame(x=x,y=y,rho=rho,rho.label=rho.label,stringsAsFactors=FALSE)  
        
        #Make a ggplot using the geom "tile".
        g = ggplot() + layer(data=d, mapping=aes(x=x, y=y, fill=rho, label=rho.label),geom="tile",stat="identity",position="identity",params=list(na.rm=TRUE)) # Plot estimated rho.
        
        # Add a new colour gradient to graph with possible different colours. Either divergent from 0, or continously from lowcol to highcol.
        lims=c(floor(min(rho)*10),ceiling(max(rho)*10))/10      
        breaks = seq(lims[1],lims[2],by=(lims[2]-lims[1])/10)  #adjust breaks after the range of rho
        if(divergent.col.grad)
        gr = scale_fill_gradient2(midpoint=0,low=lowcol, high=highcol, space="Lab", limits=lims,breaks=breaks)  
        else
        gr=scale_fill_gradient(low = lowcol, high = highcol, space = "Lab",limits=lims, breaks=breaks)  
        
    g = g + gr 
        
        #Should we overlay the original observations?
        if(plot.points) 
                if(is.null(point.size))
                        g = g + layer(data=dat.obs, mapping=aes(x=x.obs,y=y.obs), geom="point",
                stat="identity",position="identity",params=list(na.rm = TRUE,colour=point.col))
                else
                        g = g + layer(data=dat.obs, mapping=aes(x=x.obs,y=y.obs), geom="point", stat="identity",position="identity",params=list(colour=point.col,size=point.size,na.rm = TRUE))
        
        #Add numerical values of the local correlation to the graph if wanted
        if(plot.text)
                g = g + layer(stat = "identity",position = "identity",data=d, mapping=aes(x=x, y=y, label=rho.label),geom="text",
            params=list(size=tsize,na.rm = FALSE,color='white'))
        
        #Add labels
        g = g + scale_x_continuous(name=xlab)
        g = g + scale_y_continuous(name=ylab)
                
        # Return plot
        return(g)
}
g <- plot(r, lowcol="pink",highcol="darkred",point.col="black")
g <- g + theme_void() + theme(legend.position = "none") + geom_text(color='white')
print(g)
@
\hss
<<localgauss2,results='hide',echo=FALSE,fig.width=5,fig.height=5,out.width='.45\\hsize',fig.show='hold'>>=
if( FALSE ) { 
  g <- ggplot( data.frame( x=r$xy.mat[,1], rho=r$par.est[,"rho"] ), aes(x,rho) ) + geom_point() + geom_smooth()
  g <- g + theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
  panel.background = element_blank(), axis.line = element_line(colour = "black"))
  print( g )
}
x   <- r$xy.mat[,1]
rho <- r$par.est[,"rho"]
par( las = 1, mar = c(4,4,1,1) )
plot( x, rho, lwd = 2 , ylab = expression(rho) )
@
}

\nextbook
\begin{book}
  \emph{Recognizing and visualizing copulas: an approach using local Gaussian approximation}\\
  G.D. Berentsen et al. (2014)
\end{book}
Use Gaussian pseudo-observations to compute the local Gaussian correlations.

\nextbook
\begin{book}
  \emph{Dynamic copula methods in finance}\\
  U. Cherubini et al. (2012)
\end{book}

\textbf{0.} Given the joint distribution of $(X,Y)$,
we want to describe the joint distribution (copula and margins)
of $(X,Y,X+Y)$.
Applications include credit risk (sum of non-Gaussian, dependent risks)
and market dynamics (non-independent increments -- with the added requirement
that the resulting process be Markov and a martingale).

% 1. Correlation risk in finance
\textbf{1.}
Correlation trading (resp. correlation risk) exploits (resp. measures the impact of)
changes in correlation.
% Are the volatilities and correlations the same in the P and Q worlds?
Copula-based models should not introduce any spurious arbitrage,
e.g., when pricing derivatives with different expiry dates,
or when aggregating risk (VaR).

% 2. Copulas
\textbf{2.} The price of a bivariate digital put, MDP (receive \$1 if $S_A \leq K_A$
and $S_B \leq K_B$) is related to the price of the univariate digital puts,
DP$_A$, DP$_B$, via the copula $C$:
\begin{align*}
  \text{MDP} &= v P[ S_A \leq K_A , \ S_B \leq K_B ] \\
  &= v C\bigl( Q_A(K_A), Q_B(K_B) \bigr) \\
  &= v C\biggl( \dfrac{ \text{DP}_A }{ v }, \dfrac{ \text{DP}_B }{ v } \biggl)
\end{align*}
where $v$ is the discount factor.
Other examples include:
bivariate digital corridor, digital best-of, first-to-default, nth-to-default.

The \emph{Fr\'echet} copulas are mixtures of the mix, max and independence copulas.

The \emph{Kendall function} of an Archimedean copula
\[ k(t) = P\bigl[ C(U,V) \leq t \bigr] = t - \dfrac{ \phi(t) }{ \phi'(t) } \]
is useful to derive closed-form formulas for Archimedean copulas.

The following bivariate copula is not exchangeable:
\[ (u,v) \longmapsto u^\alpha v^\beta C( u^{1-\alpha}, v^{1-\beta} ), \quad \alpha, \beta \in [0,1]. \]

Archimedean copulas can be made hierarchical, by replacing
$ C(\cdots) = \phi^{-1} \bigl[ \phi(\cdot) + \phi(\cdot) + \phi(\cdot) + \phi(\cdot) \bigr] $ with
\(
    {\color{blue}\phi_3}^{-1} \bigl[
    {\color{blue}\phi_3} {\color{red}\phi_1}^{-1}\bigl( {\color{red}\phi_1}(\cdot) + {\color{red}\phi_1}(\cdot) \bigr) +
    {\color{blue}\phi_3} {\color{green!50!black}\phi_2}^{-1}\bigl( {\color{green!50!black}\phi_2}(\cdot) + {\color{green!50!black}\phi_2}(\cdot) \bigr) 
    \bigr].
\)

The conditional probabilities are
\begin{align*}
  P[ X \leq x \mid Y = y ] &=
  \left.
  \dfrac{ \partial C\bigl( F_X(s) , v \bigr) }{ \partial v }
  \right|_{ v = F_Y(y) } \\
  P[ X \leq x \mid Y \leq y ] &=
  \int_0^{ F_Y(y) } \partial_2 C\bigl( F_X(x), w ) dw.
\end{align*}
In particular, for a \emph{1-factor copula}, \ie,
if the $X_i$'s are independent given $X_1$,
\begin{align*}
  & P \bigl[ U_2 \leq u_2, \dots , U_n \leq u_n \mid U_1 = u_1 \bigr] = \prod_{ i>1 } \partial_1 C ( u_1, u_i ) \\
  & C(u_1,\dots,u_n) = \int_0^{u_1} \prod_{ i>1} \partial_1 C(u,u_i) du.
\end{align*}
This can be generalized to more factors.

% 3. Copula functions and asset price dynamics
\textbf{3.}
Copulas can be used to describe, not only cross-sectional data,
but also time dependence -- but we need to impose a few constraints on the result:
\begin{compactitem}[--]
\item The Markov property, which results from the efficient market hypothesis --
  the price should contain all the information;
\item The martingale property: the time series should be unpredictable.
\end{compactitem}

Given a Markov process $(U_t)_t$ with uniform margins, we have, for $s \leq r \leq t$,
\begin{align*}
  &P(U_s \leq u_s, U_t \leq u_t ) \\
  &= \int P[ U_s \leq u_s , U_t \leq u_t \mid U_r \leq u ] du \\
  &= \int P[ U_s \leq u_s \mid U_r = u ] \cdot P[ U_t \leq u_t \mid U_r \leq u ] du \\
  &= \int \partial_2 C_{sr} (u_s, u) \cdot \partial_1 C_{rt} (u,u_t) du
\end{align*}
We can define a product a bivariate copulas:
\[ A * B (u,v) = \int_0^1 \partial_2 A(u,t) \partial_1 A(t,v) dt. \]
It is associative, non-commutative, and satisfies
\begin{align*}
  C * \Pi &= \Pi * C = \Pi && \text{(zero)} \\
  C * M &= M * C = C && \text{(one)} \\
  W * W &= M && \text{(minus one)} \\
  W * C * W &= \hat C && \text{survival copula}
\end{align*}
More generally,
$A*B(x,y)=A\star B(x,1,y)$, where
\begin{align*}
& A \star B ( u_1, \dots , u_{m+n-1} ) = \\
& \int_0^1
\partial_m A( u_1,\dots,u_{m-1},\xi)
\partial_1 B( \xi, u_{m+1},\dots,u_{m+n-1})
d\xi.
\end{align*}
A stochastic process is Markov if its copulas satisfy
\[
  C_{t_1,\dots,t_n} = C_{t_1,t_2} \star C_{t_2,t_3} \star \cdots \star C_{t_{n-1} t_n}. 
\]
It is mixing if
$ \lim\limits_{k\to\infty} C_{i,i+1} = \Pi. $

It is right-continuous if
$ \lim\limits_{k\to 0^+} C_{i,i+k} = M. $

Brownian dynamics are defined by
$C_{st} = C^{\text{Gauss}}_{ \rho^{t-s} }. $.

Farlie-Gumbel-Morgenstern dynamics can only produce very low correlations.
\begin{align*}
  & C(u,v) =uv + \theta u v (1-u) (1-v) \qquad \theta \in [-1,1] \\
  & \theta_{st} = \tfrac13 \theta_{sr} \theta_{rt} \\
  & \theta_n = 3 \left( \dfrac \theta 3 \right) ^n
\end{align*}

Time-changed Brownian copulas are more flexible:
every semi-martingale is a time-changed Brownian motion
(with the quadratic variation for martingales and,
more genrally, L\'evy subordinators or other increasing processes,
such as cummulated volatility or cummulated jump intensity).

The $C$-convolution of $F_X$ and $F_Y$ is the copula of $(X,X+Y)$:
\begin{align*}
  F_X \overset{C}{*} F_Y (u,v) &= C_{X, X+Y} (u,v) \\
  &= \!\!\int_0^u \!\!\!\partial_1 C\bigl[ w, F_Y\bigl( F_{X+Y}^{-1} (v) + F_X^{-1}(w) \bigr) \bigr] dw \\
  F_{X+Y}(t) &= \int_0^1 \partial_1 C \bigl[ w , F_Y\bigl( t - F_X^{-1} (w) \bigr) \bigr] dw.
\end{align*}

A Markov process $(X_t)_t$ is a martingale iff
\begin{compactitem}
\item[(i)] The increments $X_t-X_s$ have finite mean;
\item[(ii)] $\forall s, t\ \forall u \in [0,1]$ almost everywhere
  \[ \int_0^1 F_{ X_t - X_s }^{-1} (v) \partial_1 C_{ X_s, X_t-X_s } ( u, dv ) = 0. \]
\end{compactitem}
This is the case, for instance, if the increments and the copula are symmetric:
$\check C(u,v) := u - C(u,1-v) = C(u,v)$.

% 4. Copula-based econometrics
\textbf{4.}
The \emph{$c$-quantile curve} of $y$ conditioned on $x$,
$q(x,p)$, is the value of $y$ such that
\[ p = F(y|x) = \partial_1 C \bigl( F_X(x) , F_Y(y) \bigr) .\]
A \emph{stationary copula-based Markov process}
is defined by its invariant distribution $G^*$ and the copula $C$ of
$(C_{t-1} , X_t)$.
Ti estimate it, use the empirical distribution for $G^*$,
and the MLE for the copula $C$.

The $\alpha$-mising coefficients are
\[ \alpha_k = \sup_{ m \in \ZZ } \sup_{\substack{A \in \mathscr F_{-\infty}^m \\ B \in \mathscr F_{m+k}^{\infty} }}
\va{ P(A \inter B) - P(A) P(B) }.
\]

The $\beta$-mixing coefficients are similar,
but use partitions
$\{A_1,\dots,A_I\}$,
$\{B_1,\dots,B_J\}$
of $\Omega$ and
$\sum_{ij} \va{ P(A_i \inter B_j) - P(A_i) P(B_j) }$.

The $\rho$-mixing coefficients are
\[ \rho_k = \sup_{ m \in \ZZ } \sup_{\substack{
    f  \in L^2 ( \mathscr F_{-\infty}^m ) \\
    g  \in L^2 ( \mathscr F_{m+k}^{\infty} )
}}
\cor(f,g).
\]

The maximum correlation of a copula $C$ is
\[ \rho_C = \sup_{\substack{
    f, g \in L^2(0,1) \\
    \int \! f = \int \! g = 0 \\
    \int \! f^2 = \int \! g^2 = 1
}} \iint f(u) g(v) C(du,dv).
\]

if $\rho_C < 1$, then a stationary Markov process defined from $C$
is $\alpha$- and $\rho$-mixing, \ie,
$\alpha_k \to 0$, $\rho_k \to 0$ when $k \to \infty$.
This is the case for the Student and Marshall-Olkin copulas.

A process $(X_t)_t$ has long memory if $H(t,h) \sim_{h\to\infty} A h^{-p}$,
$A>0$, $p>0$,
and short memory if $H(t,h) = O(e^{-Ah})$, $A>0$,
where the Hellinger measure of dependence between $X_t$ and $X_{t+h}$ is
\[ H(t,h) = 1 - \iint f_{ X_t X_{t+h} } ^{1/2}\!(x,y) \, f_{X_t} ^{1/2}(x) \, f_{ X_{t+h} } ^{1/2}\!(y) \, dx dy. \]
It can be computed from the copulas
$\tfrac12 \iint (c^{1/2} -1)^2 -1 $
and replaced by other measures of dependence:
$\iint c^2-1$, $\iint c \log c$, $\iint C(u,v)-uv$, $\iint \bigl(C(u,v)-uv\bigr)^2$,
$\sup \va{ C(u,v) - uv }$.

We can also define non-parametric Markov processes
(\ie, processes with functional parameters), for instance,
\[ X_t = \begin{cases}
  X_{t-1} + \epsilon_t & \text{with probability $\eta(X_{t-1})$} \\
  \epsilon_t & \text{otherwise}.
\end{cases}
\]

\nextbook
\begin{book}
  \emph{Analyzing dependent data with vine copulas:\\ a practical guide with R}\\
  C. Czado (2019)
\end{book}

\textbf{1.}
Distribution $F$, density $f$, copula $C$, copula density $c$, conditional density and $h$-functions
are related as follows.
\begin{align*}
  F(x_1,\dots,x_d) &= C\bigl( F_1(x_1) , \dots, F_d(x_d) \bigr) \\
  f(x_1,\dots,x_d) &= f\bigl( F_1(x_1) , \dots, F_d(x_d) \bigr) f_1(x_1) \cdots f_d(x_d)\\
  c(u_1,\dots,u_d) &= \dfrac{ \partial ^d C(u_1,\dots,u_d) }{ \partial u_1 \cdots \partial u_d } \\
  f(x_1 | x_2) &= c_{12} \bigl( F_1(x_1) , F_2(x_2) \bigr) f(x_2) \\
  F(x_1|x_2) &= \left. \dfrac{ \partial C \bigl( F_1(x_1) , u_2 \bigr) }{ \partial u_2 } \right|_{ u_1 = F_2(x_2) } \\
  h_{1|2}(u_1|u_2) &= \dfrac{ \partial C(u_1,u_2) }{ \partial u_2 } 
\end{align*}

\textbf{2.} Some dependence measures can be computed from the copula.
\begin{align*}
  \rho &= 12 \iint_{[0,1]^2} u v dC(u,v) - 3 \\
  \tau &= 4 \iint_{[0,1]^2} C(u,v) dC(u,v) - 1 \\
  \lambda_L &= \lim_{ t \to 0^+ } \dfrac{ C(t,t) }{ t }
\end{align*}

\textbf{3.} Bivariate copula classes include:
elliptical (Gaussian, Student),
Archimedian (defined from a generator function, $C(u,v)=\phi^{-1}\bigl( \phi(u) + \phi(v) \bigr)$,
Clayton,
Gumbel, Frank, Joe,
a few 2-parameter families
(Clayton-Gumbel (BB1),
Joe-Gumbel (BB6),
Joe-Clayton (BB7),
Joe-Frank (BB8)),
Tawn (3 parameters, with shapes not symmetric along the diagonal),
Marshall-Olkin, etc.

\emph{Extreme value copulas}
are the limiting copulas of
\( ( \max_{1 \leq i \leq n} X_i , \max_{1 \leq i \leq n} Y_i ) \);
they are the copulas satisfying
\[ \forall m \in \NN^\times \ \ \forall u,v \in [0,1] \ \ C(u,v) = C(u^{1/m},v^{1/m})^m. \]
They are the copulas of the form
\[ C(u,v) = \exp \left[
  \log(uv) A \! \left( \dfrac{ \log v }{ \log(uv) } \right)
\right]
\]
where $A : [0,1] \to [\tfrac12,1]$ is called the \emph{Pickands dependence function}.

Copulas can be plotted in $x$-scale (original), $u$-scale (uniform margins)
or $z$-scale (Gaussian margins).

<<CopNormMargins,results='hide',echo=FALSE,fig.width=5,fig.height=2.5,out.width='\\hsize',fig.show='hold'>>=
library(rvinecopulib)
library(DBQR)
par( mfcol=c(2,4), mar=c(0,0,0,0) + .5 )
contour(bicop_dist("indep", 0), margins='unif', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("indep", 0), margins='norm', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("gaussian", 0, .5), margins='unif', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("gaussian", 0, .5), margins='norm', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("t", 0, c(.5,2)), margins='unif', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("t", 0, c(.5,2)), margins='norm', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("clayton", 0, 3), margins='unif', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
contour(bicop_dist("clayton", 0, 3), margins='norm', col = dbColours[1], drawlabels=FALSE, lwd=3, axes=FALSE)
box()
@

To sample from a bivariate copula:
\[
\left\{
\begin{aligned}
  u &\sim \text{Unif} \\
  v &\sim h_{2|1}( \cdot | u )
\end{aligned}
\right.
\quad\text{\ie}\quad
\left\{
\begin{aligned}
  u &\sim \text{Unif} \\
  \epsilon &\sim \text{Unif} \\
  v &= h_{2|1}^{-1}(\epsilon | u ).
\end{aligned}
\right.
\]

To estimate copula parameters, first process the margins
(parametrically or not -- this may involve regression or time series modeling)
and invert the formula giving Kendall's $\tau$ from the ccopula parameter.

Let $C_{12|3}$ be the conditional distribution of $U_1,U_2$ given $U_3$.
The margins are no longer uniform: it is not a copula.
The margins are $C_{1|3}$ and $C_{2|3}$: the \emph{conditional bivariate copula} is
\[ C_{12;3} (u_1,u_2|v_3) = C_{12|3} \bigl(
  C_{1|3}^{-1}(u_1|v_3),   C_{2|3}^{-1}(u_2|v_3)
\bigr). \]
Conditional copulas depend on the conditioning value,
but it can be averaged out:
\[ C_{12;3}^A(u_1,u_2) = \int C_{12;3}( u_1,u_2 | v_3 ) dv_3. \]
It is a copula, which can also be obtained as the \emph{partial copula}, \ie,
the distribution of (these are uniform)
\begin{align*}
  V_{1|3} &= C_{2|3} ( U_2 | U_3 ) \\
  V_{2|3} &= C_{2|3} ( U_2 | U_3 ).
\end{align*}

\textbf{4.}
A 3-variate copula can be decomposed using bivariate copula
(pair copula construction, PCC)
by repeatedly using $f_{1|2} = c_{12} f_1$:
\begin{align*}
  f_{123} &= f_{1|23} f_{2|3} f_3 \\
  f_{2|3} &= c_{23} f_2 \\
  f_{1|23} &= c_{12;3} f_{1|3} \\
  &= c_{12;3} c_{13} f_1 \\
  f_{123} &= c_{12;3} c_{13} c_{23} f_1 f_2 f_3.
\end{align*}
The conditional copula $c_{12;3}$ depends on $x_3$, but we will assume it does not
(\emph{simplified} PCC).
\begin{align*}
  f_{123}(x_1,x_2,x_3) &=
  c_{12;3} \bigl( F_{1|3}(x_1|x_3) , F_{2|3}( x_2|x_3 ) ; x_3  \bigr) \cdot \\
  & \hphantom{{}={}} c_{13} \bigl( F_1(x_1) , F_3(x_3) \bigr) \cdot \\
  & \hphantom{{}={}} c_{23} \bigl( F_2(x_2) , F_3(x_3) \bigr) \cdot \\
  & \hphantom{{}={}} f_1(x_1) f_2(x_2) f_3(x_3)
\end{align*}

Conversely, we can define a 3-variate copula density as
\begin{align*}
  c(u_1,u_2,u_3) &=
  c_{12;3} \bigl( C_{1|3} (u_1|u_3) , C_{2|3} (u_2|u_3) \bigr) \cdot \\
  & \hphantom{{}={}} c_{13}(u_1,u_3) c_{23}(u_2,u_3)
\end{align*}
where $C_{1|2} (u_1|u_2) = \partial C_{12} / \partial u_2$.
The copula $c_{12}$ can be computed by integration.

In dimension $d$, there are many possible decompositions.
\begin{align*}
  c_{1\cdots d} &= \prod_{i<j} c_{ij : i+1,\dots,j-1} && \text{D-vine} &&
  % D-vine
\begin{tikzpicture}[>=stealth,yscale=.2,xscale=.15,inner sep = 1pt, outer sep = 0pt,baseline=5]
  \node[circle,fill] at (-4,3) {};
  \node[circle,fill] at (-2,3) {};
  \node[circle,fill] at (0,3) {};
  \node[circle,fill] at (2,3) {};
  \node[circle,fill] at (4,3) {};
  \draw (-4,3) -- (4,3);
  \node[circle,fill] at (-3,2) {};
  \node[circle,fill] at (-1,2) {};
  \node[circle,fill] at (1,2) {};
  \node[circle,fill] at (3,2) {};
  \draw (-3,2) -- (3,2);
  \node[circle,fill] at (-2,1) {};
  \node[circle,fill] at (0,1) {};
  \node[circle,fill] at (2,1) {};
  \draw (-2,1) -- (2,1);
  \node[circle,fill] at (-1,0) {};
  \node[circle,fill] at (1,0) {};
  \draw (-1,0) -- (1,0);
\end{tikzpicture}
\\
c_{1\cdots d} &= \prod_{i<j} c_{ij : 1,\dots,i-1} && \text{C-vine}   &&
% C-vine
\begin{tikzpicture}[>=stealth,yscale=.3,xscale=.3,inner sep = 1pt, outer sep = 0pt,baseline=-2]
  \node[circle,fill] (O) at (0,0) {};
  \node[circle,fill] (A) at (60:1cm) {};
  \node[circle,fill] (B) at (20:1cm) {};
  \node[circle,fill] (C) at (-20:1cm) {};
  \node[circle,fill] (D) at (-60:1cm) {};
  \draw (O) -- (A);
  \draw (O) -- (B);
  \draw (O) -- (C);
  \draw (O) -- (D);
  \begin{scope}[xshift=2cm]
    \node[circle,fill] (O) at (0,0) {};
    \node[circle,fill] (A) at (40:1cm) {};
    \node[circle,fill] (B) at (0:1cm) {};
    \node[circle,fill] (C) at (-40:1cm) {};
    \draw (O) -- (A);
    \draw (O) -- (B);
    \draw (O) -- (C);
  \end{scope}
  \begin{scope}[xshift=4cm]
    \node[circle,fill] (O) at (0,0) {};
    \node[circle,fill] (A) at (20:1cm) {};
    \node[circle,fill] (B) at (-20:1cm) {};
    \draw (O) -- (A);
    \draw (O) -- (B);
  \end{scope}
  \begin{scope}[xshift=6cm]
    \node[circle,fill] (O) at (0,0) {};
    \node[circle,fill] (A) at (0:1cm) {};
    \draw (O) -- (A);
  \end{scope}
\end{tikzpicture}
\end{align*}

\textbf{5.}
A \d{regular vine} (R-vine)
is a sequence of trees $T_1,\dots,T_{d-1}$ such that
\begin{compactitem}
\item[(i)]   $V(T_1) = \llbracket 1, d \rrbracket$;
\item[(ii)]  $V(T_i) = E(T_{i-1})$;
\item[(iii)] $\{a,b\} \in E(T_i) \implies \va{ a \inter b } = 1$.
\end{compactitem}
To simplify the notations, let $A_e = \text{union}(\text{flatten}(e))$
be the complete union and $D_{\{a,b\}} = A_a \inter A_b$ the conditioning set.

A \emph{D-vine} is a vine whose trees are chains.

A \emph{C-vine} is a vine whose trees are stars.

Regular vines can model multivariate Gaussian or Student distributions,
with the partial correlations as parameters.

Regular vines can be encoded in triangular matrices.

\textbf{6.}
To sample from a multivariate distribution:
\begin{align*}
  w_1 &\overset{\text{iid}}{\sim} U(0,1) \\
  x_1 &= F_1^{-1}(w_1) \\
  x_2 &= F_2^{-1}(w_2 | x_1) \\
  &\vdots \\
  x_d &= F_d^{-1}(w_d | x_1,\dots,d_{d-1})   
\end{align*}

\textbf{7.} To find a good starting point for the optimization,
start to estimate the parameters sequentially.
For instance, for $c_{123} = c_{12|3} c_{13} c_{12}$,
first estimate $c_{12}$, $c_{13}$,
then estimate $c_{12|3}$ from the \emph{pseudo-observations}
$C_{1|3}( u_{k1} | u_{k3} )$,
$C_{2|3}( u_{k2} | u_{k3} )$
(for observation $k$).

\textbf{8.}
If the vine structure is known, but not the copula families,
select them with the AIC, sequentially or not.

If the vine structure is not known,
use a greedy approach
(Di\ss mann algorithm),
with a minimum spanning tree for each tree,
computed from $\va\tau$, AIC, a copula gof $p$-value, etc.
For C-vines, it suffices to choose the root of the tree.
For D-vines, it suffices to choose the order of the nodes
(a Hamiltonian path, with a TSP solver).

\textbf{9.}
To compare models, use the AIC, BIC, KLIC (KL criterion -- log-likelihood)
or the likelihood ratio test (with correction for model complexity).

\textbf{10.}
With stock return data:
fit univariate GARCH(1,1) models with Student innovations and use the residuals;
find a representative stock in each sector (high $\sum_i \va{\tau_{ij}}$);
fit a C-vine copula to each sector
(\texttt{VineCopula::RVineStructSelect});
use it for portfolio VaR computation (you need parametric margins).

\textbf{11.}
Recent developments in vine copula based modeling include:
\begin{compactitem}[--]
\item Bayesian vine copulas: they provide credible intervals;
\item Intependence tests, for the pair copulas, to simplify the models
  (you can also truncate them);
\item Factor vine copulas (?);
\item Non-parametric pair copulas;
\item Non-simplified vines (with covariates);
\item Tests for constant conditional correlation,
  to select the vine structure violating the simplifying assumption as little as possible;
\item Goodness-of-fit (gof) tests;
\item Approximate KL divergence betwwen vine copulas;
\item Relation between graphical models and vine copulas
  (conditional independences correspond to independence copulas);
\item Conversely, vine copulas inside graphical models;
\item Discrete variables;
\item D-vine-copula-based quantile regression;
\item Factor structure for vine copulas.
\end{compactitem}

Applications include:
\begin{compactitem}[--]
\item Copulas with a time-varying dependence structure;
\item D-vines for longitudinal data;
\item Modeling the relations between the entries of realized variance matrices
  (parametrized with the logarithm of the Cholesky decomposition);
\item Medical diagnostic test accuracy (copula of TP, TN, P);
\item Survival data;
\item Copulas with zero inflation (in insurance).
\end{compactitem}

For software implementations,
check \texttt{VineCopula} (supercedes \texttt{CDVine})
and \texttt{vinecopulib} (C++/R/Python).

<<PairsCopulasMAGIC,results='hide',echo=FALSE,fig.width=5,fig.height=5,out.width='\\hsize',fig.show='hold'>>=
library(rvinecopulib)
d <- read.csv("/tmp/magic04.data", header=FALSE)
#d <- read.csv("https://archive.ics.uci.edu/ml/machine-learning-databases/magic/magic04.data", header=FALSE)
d <- d[,1:10]
u <- pseudo_obs(d)
# pairs_copula_data(u)  # VERY SLOW + too many points
n <- ncol(d)
op <- par( mfrow=c(n,n), mar=c(0,0,0,0) )
for( i in 1:n ) {
  for( j in 1:n ) {
    if( i == j ) {
      plot.new()
    } else if (i<j) {
      plot.new()
      rvinecopulib:::lp_pairs_copula_data(u[,j],u[,i] )
    } else {
      plot.new()
      rvinecopulib:::lp_pairs_copula_data(u[,j],u[,i], margins='unif')
    }    
  }
}
par(op)
@

\nextbook
\begin{book}
  \emph{Simulating copulas: stochastic models, sampling algorithms and applications}\\
  J.F. Mai and M. Scherer (2017)
\end{book}

% 1. Introduction
\textbf{1.}
Bivariate copulas can be sampled as
$ \bigl( C_{1|2}^{-1}(U_1|U_2), U_2 \bigr)$,
where $U_1, U_2 \sim U(0,1)$ and $C_{1|2}(u_1|u_2) = \partial C / \partial u_2$.

Measures of dependence can be computed from the copula:
\begingroup
\allowdisplaybreaks
\begin{align*}
  \tau &= 1 - 4 \iint \dfrac{ \partial C }{ \partial u_1 } \dfrac{ \partial C }{ \partial u_2 } \\
  \rho &= \dfrac{ \iint C - \iint \Pi }{ \iint M - \iint \Pi }
\end{align*}
\endgroup
where $\Pi(\mathbf u) = \prod u_i$ is the independence copula and
$M(\mathbf u) = \min_i u_i$ the comonotonicity copula.

For an \emph{exchangeable copula}, the correlation (the same for all pairs)
satisfies $ \rho \geq -1 / (d-1) $.

An \d{extendible} sequence of random variables is part of an infinite exchangeable sequence:
the correlation is then nonnegative,
but it need not have positive orthant dependency,
\[ P [ \forall i \ X_i \geq x_i ] \geq \prod_i P[ X_i \geq x_i ]. \]

\emph{Homogeneous mixtures}, $\theta \sim F$, $X_i \overset{\text{iid}}{\sim} F_\theta$,
are exactly the extendible sequences (DeFinetti).

Heterogeneous mixtures partition the dimensions and use a different distribution for each part.

Extreme value distributions
$C(u_1^t, \dots, u_d^t) = C(u_1,\dots,u_d)^t$ have a Pickand representation
\begin{align*}
  &\delta : \text{measure on the simplex $\Delta_d$} \\
  &P(w_1,\dots,w_d) = \int_{\Delta_d} \! \max \{ w_1 u_1, \dots, w_d u_d \} \, \delta(du) \\
  &C(u_1,\dots,u_d) = \left( \prod u_i \right) ^ { P( \log \mathbf u / \mathbf 1' \log \mathbf u ) }.
\end{align*}

% 2. Archimedean copulas
\textbf{2.}
With the sampling procedure
\begin{align*}
  & M \sim F \\
  & X_1,\dots,X_d \sim \text{Exp}(M),
\end{align*}
the cdf of the margins is $\phi(x) = \E[ e^{-xM} ]$, \ie, the Laplace transform of $F$,
and the survival copula of $(X_1,\dots,X_d)$ is
$C(u_1,\dots,u_d) = \phi( \phi^{-1} u_1 + \cdots + \phi^{-1} u_d )$
(archimedean copula).
If $\phi$ is not completely monotonic,
the same formula may still define a copula for small values of $d$,
but it may not be extendible, just exchangeable.

Archimedean copulas can be rescaled:
\begin{compactitem}[--]
\item An $\alpha$-stable L\'evy subordinator $\Lambda$m stopped at $M$,
  defines a new random variable $\hat M = \Lambda_M$ with Laplace transform $\phi(x^\alpha)$
  (the Laplace transform of a L\'evy subordinator is $\psi(x) = x^\alpha$);
\item The Laplace transform of $M_1 + \cdots + M_\beta$ is $\phi(x)^\beta$.
\end{compactitem}

Hierarchical (\d{H-extendible}) archimedean copulas are defined as
\[ C_{\phi_0} \bigl(
C_{\phi_1}( u_{11}, \dots, u_{1d_1} ),
\dots,
C_{\phi_J}( u_{J1}, \dots, u_{Jd_J} )
\bigr), \]
provided the generators are compatible:
$\phi_j$ and $(\phi_0^{-1} \circ \phi_j)'$ completely monotonic.
They can be sampled as
\begin{align*}
  & E_{ji} \sim \text{Exp}(1) \\
  & M \text{ with Laplace transform } \phi \\
  & \Lambda^{\!(1)},\dots,\Lambda^{\!(J)} \text{ L\'evy subordinators with exponents } \psi_j \\
  & U_{ji} = ( \phi_0 \circ \psi_j )( E_{ji} / \Lambda _M ^{(j)} ).
\end{align*}

Archimedean copulas can be made asymmetric, e.g.,
\begin{align*}
  V & \sim C_\phi \\
  \tilde U & \sim \Pi \\
  U_k &= \max \{ V_k^{1/\alpha_k} , \tilde U_k ^{1/\alpha_k} \}
\end{align*}

% 3. Marshall-Olkin copulas
\textbf{3.}
The lack of memory characterizing exponential distributions,
\( P[ X \geq x+y | X \geq y ] = P[ X \geq x ] \),
generalizes, in dimension $d$, to the \emph{Marshall-Olkin distribution}
\begin{align*}
  \bar F( x_1, \dots, x_n) &= P[ \forall i \ X_i \geq x_i ] \\
  &= \exp \Biggl[ - \sum_{\substack{ I \subset \llbracket 1 , d \rrbracket \\ I \neq \nothing }}
    \lambda_I \cdot \max_i x_i
    \Biggr].
\end{align*}
There are $2^d-1$ parameters.
It can be interpreted as the time-to-failure,
when the failure of a group of items $I \subset \llbracket 1, d \rrbracket$
has a different cause for each $I$.

To sample from it:
\begin{align*}
  E_I &\sim \text{Exp}( \lambda_I ) \text{ for each } I \subset \llbracket 1, d \rrbracket,\ I \neq \nothing \\
  X_k &= \min \{\,  E_I \ :\ I \ni k \,\}.
\end{align*}

The corresponding survival copula is
\[ \hat C(u_1, \dots, u_d) =
\prod_I \min_{ k \in I } u_k ^ { \lambda_I / \!\!\sum\limits_{ J \ni k } \lambda_J }.
\]
They can be sampled as
\begin{align*}
  & Y_i \sim \text{Cat} \bigl( \mathscr P ( \llbracket 1, d \rrbracket ) \setminus \{\nothing\} \bigr) \\
  & P( Y_i = I ) = \lambda_I / \textstyle \sum \lambda_J
  % , \ I \subset \llbracket 1, d \rrbracket , \ I \neq \nothing
  \\
  & \epsilon_i \sim \text{Exp}\bigl( \textstyle \sum \lambda_J \bigr) \\
  & X_k = \epsilon_1 + \epsilon_2 + \cdots + \epsilon_{ \min\{ i \ :\ k \in Y_i \} }.
\end{align*}

The MO copula is an extreme value copula (but the MO distribution is not an extreme value distribution),
has a singular component,
has an interpretation in terms of shocks (insurance, credit risk),
and positive upper tail dependence (but lower tail independence).

For an exchangeable Marshall-Olkin copula,
$\va I = \va J \Rightarrow \lambda_I = \lambda_J$ and
\[ C( u_1 , \dots , u_d ) =  \prod u_{(k)} ^{ a_{k-1} } \]
where $\forall i, j \ (-1)^i \Delta^{\!i} a_j \geq 0$
(d-monotone sequence).

To sample from it:
\begin{compactitem}[--]
\item Sample the time until the first shock (the minimum of exponential variables is still exponential);
\item Sample the number of components affected;
\item Iterate.
\end{compactitem}

If the sequence $(a_k)_k$ can be extended to an infinite completely monotone sequence
(wiith $a_0=1$, this is the case iff $a_k=E[X]$, for some random variable $X$ with values in $[0,1]$;
equivalently, the Hankel determinants are nonnegative),
this is an extendible MO copula.

A completely monotone sequence defines a L\'evy subordinator with $\psi(1)=1$ and a
\emph{L\'evy-frailty copula}
$ C_\psi( u_1, \dots, u_d) = \prod  u_{(i)} ^ { \psi(i) - \psi(i-1) }. $

To sample from it:
\begin{align*}
  E_k &\sim \text{Exp}(1) \\
  \Lambda_t &\sim \text{L\'evy} (\psi) \\
  X_k &= \inf \{ t > 0 \ :\ \Lambda_t > E_k \} \\
  U_k &= \exp( - X_k ).
\end{align*}
There is an h-extendible variant.

% 4. Elliptical copulas
\textbf{4.}
Spherical distributions can be recognized from their charaacteristic function
$ \phi_X(t) = \E[ e^{ i t' X } ] = \varphi( \n t ^2 )$
(but not all univariate functions define a characteristic function:
there are fewer as the dimension increases).
Extendible spherical distributions are mixtures of Gaussians,
$\sqrt W Z$, $Z \sim N(0,I)$.

For elliptical distributions $X \sim E_d(\mu,\Sigma,\phi)$,
$\phi(t) = e^{it'\mu} \phi(t'\Sigma t)$;
they are extendible if $\mu = \mu_1 \mathbf 1$ and
\[\Sigma = \sigma^2
  \begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)}]
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells,
  row sep={3ex,between origins},column sep={3ex,between origins},
  inner sep = 1pt,
  left delimiter={(},right delimiter={)},
]{
  1 && \rho \\
  \\
  \rho && 1 \\
};
\draw (m-1-1)-- (m-3-3);
\end{tikzpicture}
\]
h-extendible elliptic copulas have a block correlation matrix.

% 5. Pair copula construction (PCC)
% Same contents (and author) as the previous book

% 6. Sampling univariate random variables
% RNG tests; sampling from common distributions (N, Gamma, t, alpha-stable, etc.)

% 7. Monte Carlo
\textbf{7.} Variance can be reduced with antithetic variables ($\mathbf u \mapsto 1-\mathbf u$),
control variates (e.g., from an independence structure -- it may not work well),
or importance sampling (e.g., by increasing the dependence).

% 8. Further copula families
\textbf{8.} Exchangeable Marshall-Olkin copulas
\[ C(u_1,\dots,u_d) = \prod u_{(k)} ^{ a_{k-1} } \]
can be generalized to \emph{Shock copulas}
\[ C(u_1,\dots,u_d) = \prod g_k( u_{(k)} ). \]

A random vector $(X_1,\dots,X_d)$ has a \emph{min-stable exponential distribution},
\ie, $\min\{ c_1 X_1 , \dots , c_d X_d \}$ have univariate exponential distributions
for all $c_1, \dots, c_d \in [0,\infty]$, iff the margins are exponential
and the copula is an extreme value copula.

Extendible extreme value copulas are characterized by
\[ C(u_1,\dots,u_d) = \E \biggl[ \exp -\sum_{k=1}^d \Lambda_{ -\log(u_k) } \biggr] \]
for a strong IDT subordinator $\Lambda$ with $\psi(1)=1$.

% A. L\'evy subordinators
\textbf{A.}
A \d{L\'evy subordinator} is a c\`adl\`ag stochastic process $(\Lambda_t)_{t\geq0}$
with $\Lambda_0=0$ satisfying:
\begin{compactitem}
\item[(i)] Stochastic continuity (no deterministic jumps)
  \[ \forall t\geq0 \ \forall \epsilon > 0 \ \lim_{t\to0} P \bigl[ \va{ \Lambda_{t+h} - \Lambda_t } \geq \epsilon \bigr] = 0 \]
\item[(ii)] Independent increments;
\item[(iii)] Stationary increments: $\Lambda_{t+h} - \Lambda_t \overset{\text{d}}{=} \Lambda_h$;
\item[(iv)] $t \mapsto \Lambda_t$ is a.s. non-decreasing.
\end{compactitem}

$\Lambda_t$ is infintely divisible.

The Laplace transform of a L\'evy subordinator is $\E[ e^{-x \Lambda_t} ] = e^{-t \psi(x) }$
(L\'evy-Khinchin) where
$\psi(x) = \mu x + \int_{[0,\infty]} (1+e^{-tx}) \nu(dt)$
($\psi$ is the Laplace exponent, $\mu$ the drift, $\nu$ the L\'evy measure).

Examples include:
\begin{compactitem}[--]
\item Poisson:
  $\psi(x) = \lambda ( 1 - e^{-x} )$,
  $\nu(B) = \lambda \mathbf 1_{ 1 \in B }$ (number of jumps of size in $B$ per unit of time);
\item Compound Poisson: $\Lambda_t = \mu t + \sum_{1}^{N_t} J_i$;
\item Gamma: $\mu=0$, $\nu(dt) = \beta ( e^{-\eta t} / t ) \mathbf 1_{t>0} dt$,
  $\psi(x) = \beta \log(1+x/\eta)$,
  $\Lambda_t \sim \Gamma(\beta t + \eta)$;
\item Inverse Gaussian
  \begin{align*}
    & \Lambda_t \sim \text{IG}( \beta t, \eta ) \\
    & \Lambda_t = \inf \{ s>0 \ :\ \eta s + X_s = \beta t \} \\
    & X_t \text{ standard Brownian motion}
  \end{align*}
\item $\alpha$-stable:
  $\nu(dt) = \dfrac{ \alpha }{ \Gamma(1-\alpha) } \dfrac{ 1 }{ t^{1+\alpha } } \mathbf 1_{ t>0 } dt. $
\end{compactitem}

An \emph{additive subordinator} has independent, but not necessary stationary, increments.

A \emph{strong IDT subordinator}
is a non-decreasing c\`adl\`ag stochastic process $(\Lambda_t)_t$
with $\Lambda_0=0$, strongly infinitely divisible such that
\[ (\Lambda_t)_{t\geq0} = ( \Lambda^{(1)} _{t/n} + \cdots + \Lambda^{(n)}_{t/n} )_{t\geq0} \]
where $\Lambda^{(i)}$ are iid copies of $\Lambda$.

\nextbook
\begin{book}
  \emph{A partial correlation vine based approach\\ for modeling and forecasting\\ multivariate volatility time series}\\
  N. Barthel et al. (2018)
\end{book}
Partial correlations on the edges of a vine provide an unconstrained parametrization of a correlation matrix.

Model volarilities and partial correlations with a HAR (heterogeneous AR, e.g., 1-, 5- and 22-day lags)
or VARFIMA model.

\nextbook
\begin{book}
  \emph{Pair copula construction\\ for financial applications: a review}\\
  K. Aast (2016)
\end{book}
Applications of the pair copula construction (PCC) include:
\begin{compactitem}[--]
\item VaR and CVaR of a portfolio;
\item Probability of default;
\item Liquidity riskk (bid and ask spread of several assets);
\item Systemic risk (CDS of financial institutions, stock market indices);
\item (Scenario-based) CVaR portfolio optimization (C-vine with skewed Student margins)
\item Option pricing.
\end{compactitem}

\nextbook
\begin{book}
  \emph{kdecopula: an R package for the kernel estimation of bivariate copula densities}\\
  T. Nagler (2017)
\end{book}
To reduce the boundary effect when estimating a non-parametric copula density:
\begin{compactitem}[--]
\item Reflect the data over the sides of the square;
\item Use kernels supported on the square, e.g., Beta;
\item Transform the margins to make them Gaussian.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Evading the curse of dimensionality\\ in nonparametric density estimation\\ with simplified vive copulas}\\
  T. Nagler and C. Czado (2016)
\end{book}
(Truncated, simplified) vine copulas
provide scalable high-dimensional deensity estimators,
by reducing the problem to a sequence of bivariate density estimations.

Implementation: \texttt{rvinecopulib}, \texttt{kde1d}.


\nextbook
\begin{book}
  \emph{ESG, risk and (tail) dependence}\\
  R. Bax  et al. (2021)
\end{book}
For assets $j$, in sector $S$, in ESG category $k \in \{A,B,C,D\}$,
estimate a vine copula with fixed first and second-level trees
\[
% Vine copulas
\begin{tikzpicture}[>=stealth,yscale=.6,xscale=.6,inner sep = 2pt, outer sep = 0pt,baseline=-7]
  \node (S) at (0,0) {$S$};
