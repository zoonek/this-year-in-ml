\nextbook
\begin{book}
  \emph{Measurable Taylor's theorem:\\ an elementary proof}\\
  G. Viggiano
\end{book}
In the Taylor expansion
\[ f(x) = \sum_{ j=0 }^k \dfrac{ f^{(j)} (c) }{ j! } (x-c)^j +
\dfrac{ f^{k+1} (\xi ) }{ (k+1)! } (x-c)^{k+1} \]
for $f \in \mathscr C^{k+1}$,
$\xi$ can be chosen to be a measurable function of $x$ continuous at $c$.

\nextbook
\begin{book}
  \emph{Machine learning\\ for partial differential equations}\\
  S.L. Brunton and J.N. Kutz (2023)
\end{book}

\textbf{1.}
To learn a PDE from observational data,
PDE-FIND uses
\[ u_t = \Theta( u, u_x, u_{xx}, u u_x, \cdots ) \xi  \]
where $\Theta$ is a library of candidate terms, e.g.,
\[ \begin{array}{ll}
  \text{divergence} & \nabla \cdot u \\
  \text{vorticity} & \nabla x u \\
  \text{shearing} & u_x + v_y \\
  \text{stretching} & u_x - v_y  
\end{array} \]
and $\xi$ is a sparse vector.

\textbf{2.}
The \d{Koopman operator}
of a discrete, nonlinear finite-dimensional dynamical system
\[ x_{t+1} = F(x_t) \qquad x_t \in \mathscr X \]
is the linear, infinite-dimensional transformation
\[ K: \left\{
\begin{array}{rcl}
  \RR^{\mathscr X } & \longrightarrow & \RR^{\mathscr X} \\
  g & \longmapsto & Kg = g \circ F.
\end{array}
\right. \]
It satisfies
\[ (Kg) (x_t ) = g \bigl( F(x_t) \bigr) = g( x_{t+1} ). \]

Learn $K$ satisfying those constraints;
diagonalize it,
\[ K \phi_k = \lambda_k \phi_k  \]
(``intrinsinc measurement coordinates'')
and reduce the dimension.
The non-linear system has become linear --
it is easy to solve.

\textbf{3.}
If $u$ is a solution of the linear PDE
$Lu=f$,
then it can be computed from the \d{Green's function}
of the PDE, \ie, the solution $G$ of
$L^\dag G(\bigcdot,\xi) = \delta_\xi$,
where $L^\dag$ is the adjoint of $L$ and $\delta_\xi$ is the Dirac delta,
as follows:
\begin{align*}
  u(x) &= \langle \delta_x , u \rangle \\
  &= \langle L^\dag G(\bigcdot,x) , u \rangle \\
  &= \langle G(\bigcdot,x) , L u \rangle \\
  &= \langle G(\bigcdot,x) , f \rangle \\
  &= \int G(\xi,x) f(\xi) d\xi.
\end{align*}

The PDE can also be solved by looking for an eigen-decomposition of $L$:
\[ L \phi_n = \lambda_n \phi_n. \]
If a solution $u$ can be represented as a sum of eigenfunctions
(Sturm-Liouville theory), then
\[ u = \sum \dfrac{ \langle \phi_n , f \rangle }{ \lambda_n }\phi_n. \]
Neural operators generalize that to nonlinear PDEs.

\nextbook
\begin{book}
  \emph{Numerically stable parallel\\ computation of (co)variance}\\
  R. Schubert and M. Gertz
\end{book}
Do not compute the variance as $\var X = \E[ X^2] - \E[X]^2$,
but (Welford)
\begin{align*}
  \mu_{k+1} &= \dfrac{ k }{ k+1 } \mu_k + \dfrac1{k+1} x_{k+1} \\
  S_{k+1} &= S_k + \dfrac{ k }{ k+1} ( x_{k+1} - \mu_k )^2 .
\end{align*}

\nextbook
\begin{book}
  \emph{Fundamentals of causal inference with R}\\
  B.A. Brumback (2022)
\end{book}
% Confusing notations: the treatment is sometimes $T$, sometimes $A$,
% and this can change in the middle of an equation!
% ($T$ looks better, until you introduce time, e.g., for DiD)

Effect measures include:
\begin{align*}
  & p_0 = \E[ Y(0) ] \\
  & p_1 = \E[Y(1)] \\
  & \dfrac{ p_1 }{ 1-p_1 }, \dfrac{ p_0 }{ 1-p_0 } &&\text{odds} \\
  &\text{RD} = p_1 - p_0 && \text{risk difference} \\
  &\text{RR} = p_1 / p_0 && \text{relative risk} \\
  &\text{RR}^* = \dfrac{ 1 - p_0 }{ 1 - p_1 } && \text{relative risk} \\
  &\text{OR} = \left. \dfrac{p_1}{1-p_1} \middle/ \dfrac{p_0}{1-p_0} \right. && \text{odds ratio} \\
  &\text{NNT} = 1 / \text{RD} && \text{number needed to treat} \\
  &\text{AF} = 1 - 1/\text{RR} && \text{attributable fraction} \\
  &\text{CP} = \dfrac{p_1-p_0}{1-p_0} = 1 - 1/\text{RR}^* && \text{causal power}
\end{align*}

Check the R packages:
\texttt{AER},
\texttt{boot},
\texttt{car},
\texttt{faraway},
\texttt{gee},
\texttt{geepack},
\texttt{Matching},
\texttt{resample}.

\[
\begin{tikzpicture}[>=stealth,scale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node (H) at (1,1) {$H$};
  \node (T) at (0,0) {$T$};
  \node (Y) at (2,0) {$Y$};
  \draw[->] (H) -- (T);
  \draw[->] (H) -- (Y);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\]

\textbf{6.}
There are several ways of adjusting for a sufficient confounder $H$.
\begin{compactitem}[--]
\item Outcome modeling (aka backdoor adjustment),
  using a model $Y \sim T + H$,
  \[ \E \bigl[ Y(t) \bigr] = \sum_h \E\bigl[ Y | T=t, H=h ] P[H=h]; \]
\item Exposure modeling
  (aka inverse propensity score weighting), using a model
  $e: E[T|H] \sim H$,
  \begin{align*}
    \E\bigl[ Y(1) \bigr] &= \E \biggl[ \dfrac{ TY }{ e(H) } \biggr] \\
    \E\bigl[ Y(0) \bigr] &= \E \biggl[ \dfrac{ (1-T) }{ 1-e(H) } Y \biggr] \\
  \end{align*}
\item Doubly robust standardization
  \begin{align*}
    \E\bigl[ Y(1) \bigr] &= \E \biggl[ \dfrac{ T }{ e(H) } Y
      - \dfrac{ T - e(H) }{ e(H) } \hat Y(H,1) \biggr] \\
    \E\bigl[ Y(0) \bigr] &= \E \biggl[ \dfrac{ (1-T) }{ 1-e(H) } Y
      + \dfrac{ T-e(H) }{ 1 - e(H) } \hat Y(H,0) \biggr] \\
  \end{align*}
\item Matching; % Not mentioned
\item Difference-in-differences (DiD),
  under the ``additive equi-confounding'' assumption
  \begin{align*}
  &\E\bigl[ Y_1(0) | A=1 \bigr] - \E\bigl[ Y_1(0) | A=0 \bigr]
  = \\
  &\qquad\qquad\qquad\qquad\qquad
  \E\bigl[ Y_0 | A=1 \bigr] - \E\bigl[ Y_0 | A=0 \bigr]
  \end{align*}
  (the difference between the treated and the non-treated, if we had not treated them,
  is the same as the difference between those two groups before treatment),
  \begin{align*}
    \text{ATT}
    &= \E \bigl[ Y_1(1) - Y_1(0) | A\!=\!1 \bigr] \\
    &= \E\bigl[ Y_1(1) | A\!=\!1\bigr] - \E\bigl[ Y_1(0) | A\!=\!1 \bigr] \\
    &= \E[ Y_1 | A\!=\!1 ] -
    \\ &\hphantom{={}}
    \bigl(
    E[Y_0 | A\!=\!1] - E[Y_0|A\!=\!0] + E[Y_1(0)|A\!=\!0]
    \bigr) \\
    &= \E[ Y_1-Y_0 | A\!=\!1] - \E[ Y_1-Y_0|A\!=\!0]
  \end{align*}
  ($T$ is time, $A$ is the treatment).
  \item Front-door adjustment, given a surrogate marker of the effect of $T$ on $Y$ (a mediator)
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  %\node (X) at (-1,1) {$X$};
  \node (Y) at (2,0) {$Y$};
  \node (M) at (1,0) {$M$};
  \node[circle,densely dotted,draw] (U) at (1,1) {$U$};  
  \draw[->] (U) -- (Y);
  \draw[->] (U) -- (T);
  \draw[->] (T) -- (M);
  \draw[->] (M) -- (Y);
\end{tikzpicture}
\]
\begin{align*}
  E\bigl[ Y(t) \bigr] = \sum_m P[ M\!=\!m | T\!=\!t] \sum_{t'} E[ Y |M\!=\!m,T\!=\!t'] P[T\!=\!t']
\end{align*}
  \item Instrumental variables
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (I) at (-2,0) {$I$};
  \node (Y) at (2,0) {$Y$};
  \node[circle,densely dotted,draw] (U) at (1,1) {$U$};  
  \draw[->] (U) -- (Y);
  \draw[->] (U) -- (T);
  \draw[->] (T) -- (Y);
  \draw[->] (I) -- (T);
\end{tikzpicture}
\]
    with \emph{principal stratification}
    \begin{align*}
      &I\rlap{\text{: treatment assignment}} \\
      &T\text{: treatment} \\
      &C\text{: compliance} \\
      &T(0)=T(1)=1 &&\text{ always taker} \\
      &T(0)=T(1)=0 &&\text{ never taker} \\
      &\forall t \ A(t)=t &&\text{ complier} \\
      &\forall t \ A(t)=1-t &&\text{ defier}
    \end{align*}
    assuming there are no defiers (monotonicity assumption),
    we can compute the complier average causal effect
    \begin{align*}
      \text{CACE} &= \E\bigl[ Y(1) - Y(0) | C=1 ] \\
      &= \dfrac{
        E[ Y|T=1] - E[Y|T=0]
      }{
        P[A=1|T=1] - P[A=1|T=0]
      }
    \end{align*}
  \item Instrumental variables with \emph{structural nested mean models}:
    assuming $Y - Y(0) \indep I | T$,
    we can compute the ATT (with the same formula).
\end{compactitem}

The \emph{propensity score} has many uses:
\begin{compactitem}[--]
\item Inverse propensity weighting; 
\item Backdoor adjustment: the propensity score is a sufficient confounder,
  \[ \forall t \ Y(t) \indep T \,|\, H \implies \forall t \ Y(t) \indep T \,|\, e(H); \]
\item Stratification: computing the ATE in each quartile; 
\item Matching: easier to do on the propensity score $e(H)$
  than on the original confounders $H$.
\end{compactitem}

Adding \emph{precision variables} reduces variance.
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (Y) at (2,0) {$Y$};
  \node (V) at (1,1) {$V$};  
  \draw[->] (V) -- (Y);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\qquad
\text{or}
\qquad
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (V) at (2,2) {$V$};  
  \node (Y) at (2,0) {$Y$};
  \node[circle,densely dotted,draw] (U) at (1,1) {$U$};  
  \draw[->] (U) -- (Y);
  \draw[->] (U) -- (V);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\]

\emph{Mediation analysis} measures the importance of a mediator.
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (Y) at (4,0) {$Y$};
  \node (M) at (2,0) {$M$};  
  \node (H3) at (1,1) {$H_3$};  
  \node (H2) at (3,1) {$H_2$};  
  \node (H1) at (2,2) {$H_1$};  
  \draw[->] (T) -- (M);
  \draw[->] (M) -- (Y);
  \draw [->] (H3) -- (T);
  \draw [->] (H3) -- (M);
  \draw [->] (H2) -- (M);
  \draw [->] (H2) -- (Y);
  \draw [->] (H1) to[out=-165,in=90] (T);
  \draw [->] (H1) to[out=-15,in=90] (Y);
\end{tikzpicture}
\]

Denote the potential outcome $T(t,m)$.
\begin{align*}
  &\text{TE} = T( 1, M(1)) - Y(0,M(0)) && \text{total effect} \\
  &\text{CDE}(m) = Y(1,m) - Y(0,m) &&\text{controlled direct effect} \\
  &\text{CIE}(m) = \text{TE} - \text{CDE}(m) &&\text{controlled indirect effect} \\
  &\text{NDE} = Y(1,M(0)) - Y(0,M(0)) && \text{natural direct effect} \\
  &\text{NIE} = Y(1,M(1)) - Y(1,M(0)) &&\text{natural indirect effect} \\
  &\text{TE} = \text{CDE} + \text{CIE} = \text{NDE} + \text{NIE} \\
  &\text{PE} = \dfrac{ \text{CIE}(m) }{ \text{TE} } \\
  &\text{PM} =  \dfrac{\text{NIE}}{\text{TE}}
\end{align*}

% TODO: I had more formulas...

We can also have time-dependent confounders:
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (H) at (0,0) {$H$};
  \node (Y) at (2,0) {$Y$};
  \node (T1) at (-1,0) {$T_1$};
  \node (T2) at (1,0) {$T_2$};
  \node[circle,densely dotted,draw] (U) at (1,1) {$U$};  
  \draw[->] (U) -- (Y);
  \draw[->] (U) -- (H);
  \draw[->] (H) -- (T2);
  \draw[->] (T2) -- (Y);
  \draw[->] (T1) -- (H);
  \draw[->] (H)  to[out=-30,in=-150] (Y);
  \draw[->] (T1) to[out=-30,in=-135] (Y);
\end{tikzpicture}
\]
we want to know the optimal value of $T_1$ and,
given $T_1$ and $H$, the optimal value of $T_2$.

\nextbook
\begin{book}
  \emph{Conformal predictive portfolio selection}\\
  M. Kato (2024)
\end{book}
Consider a model forecasting future returns $Y_t$ from asset features $X_t$:
\[ \hat Y_{t+1} = \hat f_t( X_{t+1} ) \]
where $\hat f_t$ is trained on
$(X_1,Y_1),(X_2,Y_),\dots,(X_t,Y_t)$.
The returns of a portfolio with weights $w$ are $w' Y_t$;
the forecasted returns are $w' \hat Y_{t+1}$.
Apply conformal prediction (CP)
to those portfolio return predictions:
for each $w$, we have a prediction interval
\[ \hat C_t^w ( X_{t+1} = [ \underline r _{t+1} ^w , \bar r_{t+1}^w ]. \]
Find the portfolio weights minimizing some loss function of those intervals
\[ w^* = \argmin_w \ell\bigl( \hat C_t^w ( X_{t+1} ) \bigr) .\]

For instance:
\begin{compactitem}[--]
\item Start with a finite set of portfolios $\mathscr E$; 
\item Compute their prediction intervals at level $\alpha$:
  $ [ \underline r_w , \bar r_w ] $;
\item Consider a proportion $\beta$ of portfolios,
  $\tilde{\mathscr E} \subset \mathscr E$,
  with the highest
  $\underline r_w$
  (low risk, measured with the VaR);
\item Among those, pick the porfolio with the highest $\bar r_w$.
\end{compactitem}

To account for the time series lack of exchangeability,
use full conformal prediction,
\ie, fit the model on augmented datasets
(add $(X_{t+1},y)$ for all possible values of $y$)
and on all permuted datasets
\[ (X_{\sigma(1)}, y_{\sigma(1)}), \dots, (X_{\sigma(t)}, y_{\sigma(t)}), (X_{\sigma(t+1)}, y) \]
for all $\sigma \in \mathfrak S_n$.
It is actually sufficient to consider only shifts, \ie, permutations of the form
\[ \exists j \in \llbracket 0, t-1 \rrbracket \quad
\forall i \in \llbracket 1, t \rrbracket \quad
\sigma(i) \equiv i+j \ (\text{mod}\ t) \]

\nextbook
\begin{book}
  \emph{Exact and robust conformal inference methods\\ for predictive machine learning\\ with dependent data}\\
  V. Chernozhukov et al.
\end{book}
Conformal prediction for time series: use full conformal prediction
and all shifts of the data.

