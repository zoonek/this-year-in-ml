\nextbook
\begin{book}
  \emph{Kernels and regularization on graphs} \\
  A.J. Smola and R. Kondor (2003)
\end{book}



The \d{graph Laplacian} $L = D - W$
is defined by 
\[ 
f' L f = \tfrac12 \sum_{i{-}j} (f_i - f_j)^2 
\qquad
\text{for } f \in \RR^n.
\]

The pseudo-norm $\n f _L = \langle f , L f \rangle$
is a discrete analogue of 
\[ \n f _\Delta = \langle f , \Delta f \rangle = 
\langle \nabla f , \nabla f \rangle = \int \n{ \nabla f } ^2. \]

Up to row/column/sum operations, the graph Lapalcian 
(or the \d{normalized graph Laplacian}, 
$ \tilde L = I - D^{-1/2} W D^{-1/2} $, 
whose spectrum is in $[0,2]$)
is the only permutation-invariant linear operator.

By analogy with radial basis function regularization 
\begin{align*}
  \Omega(f) &= \bigl\langle f , r(\Delta) f \bigr\rangle = 
  \int \bigl| \hat f(\omega) \bigr|
  r\bigl( \n{\omega}^2 \bigr) d \omega \\
  k(x,y) &= \bigl\langle k(x,\cdot), r(\Delta) k(y,\cdot) \bigr\rangle 
\end{align*}
one can define regularization for functions on a graph, 
$f : V \to \RR$, \ie, $f \in \RR^{\va V}$, 
\begin{align*}
  \Omega(f) &= \bigl\langle 
  f, 
  r(\tilde L) f 
  \bigr\rangle && \text{regularizer} \\
  K &= r(\tilde L)^{-1} && \text{kernel.}
\end{align*}
For instance, 
\begin{align*}
  r(\lambda) &= 1 + \sigma^2 \lambda && \text{regularized Laplacian} \\
  r(\lambda) &= \exp( \sigma^2/2\lambda ) && \text{diffusion} \\
  r(\lambda) &= (a-\lambda)^{-1} &&\text{1-step random walk, $a\geq2$} \\
  r(\lambda) &= (a-\lambda)^{-p} &&\text{$p$-step random walk} \\
  r(\lambda) &= \cos( \lambda \pi / 4 )^{-1} && \text{inverse cosine.}
\end{align*}
To compute $\Omega$ or $K$, use a low-degree polynomial approximation of $r(\lambda)$ or $r(\lambda)^{-1}$: 
Taylor expansion around zero, $\exp(B) \approx (I + B/n)^n$, 
Chebychev polynomials on $[0,2]$, etc.
(more simplifications are available for product graphs).

\nextbook
\begin{book}
  \emph{Geodesics in heat} \\
  K. Crane et al.
\end{book}
The \d{Eikonal equation} 
\begin{align*}
  \va{ \nabla \phi } &= 1 \\
  \left. \phi \right|_\gamma &= 0
\end{align*}
computes the distance to a subset $\gamma \subset M$ of a Riemannian manifold but, being nonlinear and hyperbolic, it is difficult to solve (\emph{fast marching algorithm}).

\emph{Varadhan's formula} gives the distance from the heat kernel,
\[
  \phi(x,y) = \lim_{ t \to 0 } 
  \sqrt{
    - 4 t \log k_{t,x}(y) 
  }
\]
(interpreting the heat equation with random walks: after a small time $t$, a walk reaching $y$ from $x$ has not had time to deviate much from the geodesics), but it is very sensitive to errors in the kernel
(especially if $t$ is small).

The \emph{heat method} 
\begin{compactitem}[--]
\item Integrates the heat flow $\dot u = \Delta u$ for some fixed time $t$;
\item Evaluates the vector field $X = - \nabla u / \va{ \nabla u }$ -- 
we only keep the direction: the amplitude is imprecise and, for geodesics, is known to be one;
\item Find the corresponding distance by solving $ \nabla \phi = X$, \ie, 
$\argmin_\phi \int \va{ \nabla \phi -X }$, \ie,
$\Delta \phi = \nabla \cdot X$ (Poisson).
\end{compactitem}

\nextbook
\begin{book}
  \emph{The emergence of spectral universality\\ in deep networks} \\
  F. Pennington et al.
\end{book}
To study the spectrum of the Jacobian
$d \text{output} / d \text{input}$ 
of a neural net (if all the singular values are close to 1, learning is faster), 
use \d{free probability theory}.
\begin{align*}
  \rho_X(\lambda) &= \Bigl\langle \dfrac1N \sum_{i=1}^n \delta( \lambda - \lambda_i ) \Bigr\rangle_X 
  && \text{Limiting spectral density} \\
  G_X(z) &= \int_\RR \dfrac{ \rho_X(t) }{ z - t } dt && \text{Stieltjes transform ($z \not\in\RR$)} \\
  M_X(z) &= z G_X(z) - 1 && \text{Moment generating function} \\
  M_X^{-1} & &&\text{Its inverse} \\
  s_X(z) &= \dfrac{ 1 + z }{ z M_X^{-1}(z) } && \text{$S$-transform} \\
  S_{AB}(z) &= s_A(z) s_B(z) 
\end{align*}
In the other direction, use 
\[
  \rho_X(\lambda) = - \dfrac1\pi \lim_{ \epsilon \to 0^+} 
  \im G_X( \lambda + i \epsilon).
\]

\nextbook
\begin{book}
  \emph{Spherical CNNs} \\
  T.S. Cohen (2018)
\end{book}
Convolutional layers are translation-invariants; 
they could be computed with a fast Fourier transform (FFT) -- in practice, they are not, because the FFT is slow for small filters.
The Fourier transform can be generalized to signals on the sphere $\SS^2$ (drone vision, molecular structure, weather modeling)
and rotation-invariant transformation, 
but since $\SS^2$ is not a group, 
the Fourier transform yields a signal on $\text{SO}(3)$
(in further layers, we stay in $\text{SO}(3)$: it is already a group.)


For signals $f,g$ on the sphere, one can define a ``correlation'' $f * g$.
\begin{align*}
  & x \in \SS^2 \\
  & f, g : \SS^2 \longrightarrow \RR^k \\
  & Q, R \in \text{SO}(3) \\
  & \langle f, g \rangle = \int_{\SS^2} \bigl\langle f(x) , g(x) \bigr\rangle_{\RR^k} dx \\
  & (L_R f)(x) = f( R^{-1} x ) & \hspace*{-2cm}\text{action of $\text{SO}(3)$ on $\SS^2$} \\
  & (f*g)(R) = \langle L_R f , g \rangle = \langle f , L_R, g \rangle &\text{correlation}
\end{align*}
Those definitions extend to functions on $\text{SO}(3)$.
\begin{align*}
  & f, g : \text{SO}(3) \longrightarrow \RR^k \\
  & \langle f , g \rangle = \int_{ \text{SO}(3) } \bigl\langle f(x) , g(x) \bigr\rangle _{\RR^k} dx \\
  & (L_R f)(Q) = f(R^{-1} Q ) \\
  & ( f * g )(R) = \langle L_R f, g \rangle
\end{align*}

Spherical convolution can be computed with the generalized FFT.

\nextbook
\begin{book}
  \emph{L4: practical loss-based stepsize adaptation\\ for deep learning} \\
  M. Rol\'inek and G. Martius (2018)  
\end{book}
Choose the step size to have the same forecasted loss improvement at each step.
If the loss were linear, we could go to the minimum in one step: 
\begin{align*}
  \text{loss}(\theta_0 + \eta v ) &= \text{loss}(\theta_0) + \eta g' \cdot v = L_{\text{min}} \\
  \eta &= - \dfrac{
    \text{loss}(\theta_0) - L_{\text{min}}
  }{
    g' \cdot b
  }.
\end{align*}
In practice, the step can be $\alpha \eta v$, 
where $g$ is the gradient,
$v$ the direction (gradient, momentum, etc.),
$\alpha = 0.15$
and where $L_{\text{min}}$ is some fraction (say, $0.9$)
of the lowest loss seen so far.

