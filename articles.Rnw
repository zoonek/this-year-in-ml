\nextbook
\begin{book}
  \emph{Portfolio construction\\ as linearly constrained separable optimization}\\
  N. Moehle et al. (2021)
\end{book}
The portfolio optimization problem
\[
\begin{array}{ll}
  \text{Find} & h \\
  \text{To minimize} & \alpha ' h - \gamma h' V h - \phi(h) \\
  \text{Such that} & \ell \leq \mathbf 1 ' h \leq u \\
  \text{Where} & V = X \Sigma X' + D
\end{array}
\]
where $\phi$ models transaction costs, minimum trade size, tax liability,
position limits, minimum holdings size, integer share constraints,
can be formulated as a \emph{separable affine problem}
\[
\begin{array}{ll}
  \text{Find} & h, y \in \RR^n , c \in \RR \\
  \text{To maximize} & \alpha ' h - \gamma ( y' y + h' D h ) \\
  \text{Such that} & y = C X h \\
  & c + \mathbf 1 ' h = 1 \\
  & 1 - u \leq c \leq 1 - \ell \\
  \text{Where} & \Sigma = C C' \ \ \text{Cholesky}
\end{array}
\]
\ie, of the form (after introducing slack variables to remove the inequalities)
\[
\begin{array}{ll}
  \text{Find} & x \\
  \text{To minimize} & \sum f(x_i) \\
  \text{Such that} & Ax = b .
\end{array}
\]
For a lower bound, solve the convex problem
\[ \operatorname*{Minimize}_x \sum f_i^{**} (x_i) \text{ such that } Ax=b \]
where $f^{**}$ is the \emph{convex envelope} of $f$.

<<ConvexEnvelope,results='hide',echo=FALSE,fig.width=6,fig.height=1.5,out.width='\\hsize',fig.show='hold'>>=
xs <- seq(-1,1,length=100)
ys <- (xs+.5)^2 * (xs-.5)^2  - .2*xs^2 - .05 * xs
op <- par( mfrow=c(1,4), mar = c(1,1,1,1) )
k1 <- which.min(ys[1:50])
k4 <- 50 + which.min(ys[50:100]) - 1
k2 <- 35
k3 <- 65
plot(xs,ys, type = "l", axes=FALSE, xlab="", ylab="", lwd = 2)
lines( c(xs[1:k1],xs[k1]), c(ys[1:k1],100), lwd = 4, col = dbColours[1] )
plot(xs,ys, type = "l", axes=FALSE, xlab="", ylab="", lwd = 2)
lines( c(xs[1:k2],xs[k2]), c(ys[1:k2],100), lwd = 4, col = dbColours[1] )
plot(xs,ys, type = "l", axes=FALSE, xlab="", ylab="", lwd = 2)
lines( c(xs[1:k1],xs[k3],xs[k3]), c(ys[1:k1],ys[k3],100), lwd = 4, col = dbColours[1] )
plot(xs,ys, type = "l", axes=FALSE, xlab="", ylab="", lwd = 2)
lines( c(xs[1:k1],xs[k4],xs[k4]), c(ys[1:k1],ys[k4],100), lwd = 4, col = dbColours[1] )
par(op)
@

The problem
\[
\begin{array}{ll}
  \text{Find} & x, z \in \RR^n \\
  \text{To minimize} & I_A(z) + \sum f_i (x_i) \\
  \text{Such that} & x = z \\
  \text{Where} & I_A(z) = \begin{cases}
    0 & \text{if $Az = b$} \\
    \infty & \text{otherwise}
  \end{cases}
\end{array}
\]
can be solved with ADMM: 
\begin{align*}
  & L(x,z,\lambda) = f(x) + I_A(z) + \tfrac12 \n{ x - z + \lambda }^2 \\
  & x \leftarrow \argmin\limits_x L(x,z,\lambda) \\
  & z \leftarrow \argmin\limits_z L(x,z,\lambda) \\
  & \lambda \leftarrow \lambda + x - z.
\end{align*}
The $z$ update reduces
to solving a linear system,
and the $x$ updates are univariate
$x_i \leftarrow \text{prox}_{f_i} ( z_i - \lambda_i )$,
with $f_i$ piecewise quadratic.
ADMM is guaranteed to converge for convex problems:
since it is non-convex,
initialize with the relaxed problem.

Scaling may help
\[
\begin{array}[t]{l@{\ }l}
  \text{Find} & x \\
  \text{To minimize} & \sum f_i(x_i)
  \ \rightsquigarrow \\
  \text{Such that} & Ax=b
\end{array}
\!
\begin{array}[t]{l@{\ }l}
  \text{Find} & \tilde x \\
  \text{To minimize} & \sum f_i( E_{ii} \tilde x_i ) \\
  \text{Such that} & DAE x = Db \\
  \text{Where} & \tilde x = E^{-1} x \\
  & \text{$E$ diagonal} \\
  & \text{$D$ invertible}
\end{array}
\]

