    \draw[->] (IY) -- (Y);
    \draw[->] (X) -- (Y);
    \node at (.5,-1.1) {\footnotesize causality};
  \end{scope}
  \begin{scope}[shift={(2.5,0)},xscale=1.2]
    \node (IX) at (0,1) {$I_X$};
    \node (IY) at (1,1) {$I_Y$};
