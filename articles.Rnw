  %left delimiter={(},right delimiter={)},  
]{
 \mathstrut & \mathstrut & \mathstrut &  & 0\\
 \mathstrut &  &  &  &  \\
 \mathstrut &  &  &  &  \\
  &  &  &  &  \\
0 &  &  &  &  \\
};
\draw (m-1-1.center)-- (m-5-5.center);
