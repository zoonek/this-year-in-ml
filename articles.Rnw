\emph{Double machine learning}
\[
\begin{tikzpicture}[>=stealth,scale=.7,inner sep=2pt,outer sep=0pt,baseline=0]
  \node (W) at (1,1) {$W$};
  \node (T) at (0,0) {$T$};
