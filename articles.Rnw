  \draw[->] (W) -- (T);
  \draw[->] (W) -- (Y);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\]
\[ \texttt{lm} \bigl( \texttt{res}( Y \sim W ) \sim \texttt{res}( T \sim W ) \bigr) \]
(do the inner and outer regressions on different datasets)
for
\begin{compactitem}[--]
\item Treatment: S\&P 500 weekly returns
\item Outcome: some non-US market weekly returns (for the same or next week)
\item Confounders: weekly returns of other non-US markets.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Unsuitability of NOTEARS\\ for causal graph discovery}\\
  M. Kaiser and M. Sipos (2021)
\end{book}
\textsc{Notears}
$ h(w) = \text{trace}( e^{ W \odot W } ) - d$
is not scale-invariant (for weighted adjacency matrices).
\textsc{Golem} has the same problem.
  
\nextbook
\begin{book}
  \emph{DAGMA: learning DAGs via M-matrices\\ and a log-determinant acyclic characterization}\\
  K. Bello et al. (2022)
\end{book}
The \textsc{notears} condition, $\text{Tr}(e^{W\cdot W}) = d$,
for an adjacency matrix $W$ to be that of a DAG,
or \[\text{Tr}\left( I + \dfrac1d W \odot W \right)^{\!d} = d, \]
can be replaced with $h(W)=0$ or, equivalently, $\nabla h(W)=0$,
where
\[ h(W) = - \log \det ( s I - W \odot W ) + d \log s, \]
for $s>0$. In addition, $h(W) \geq 0$,
\[ \nabla h(W) = 2 ( s I - W \odot W )^{ - \top } \odot W. \]
Contrary to \textsc{notears} (where the contribution of large cycles vanishes quickly),
it can detect large cycles.
  
\nextbook
\begin{book}
  \emph{On the role of sparsity and DAG constraints for learning linear DAGs}\\
  I. Ng et al. (2020)
\end{book}
The \textsc{notears} hard constraint
$h(B) = \text{tr}( e^{ B \odot B } ) - d = 0$
can be replaced with a soft constraint (\textsc{golem})
\[ \operatorname*{Minimize}_B \mathscr L( B , x ) + \lambda_1 \n{ B }_1 + \lambda_2 h(B) \]
where the log-likelihood is
\[ \mathscr L(B,x) = \dfrac12 \sum_i \log \sum_k ( x_{ki} - B_i ' x_k ) ^ 2 - \log \bigl| \det (I-B ) \bigr|
\]
(but it is not an exact characterization).
  
\nextbook
\begin{book}
  \emph{DAG-GNN: DAG structure learning\\ with graph neural networks}\\
  Y. Yu et al. (2019)
\end{book}
Given the adjacency matrix of a DAG,
a SEM (structural equation model) is of the form
$X = A' X + Z$, $Z \sim \text{noise}$, \ie,
$X = (I-A')^{-1} Z$.
It can be made non-linear, and the model can be extended to a VAE.
\[
\begin{tikzpicture}[>=stealth,xscale=2,yscale=1,inner sep=2pt,outer sep=0pt,baseline=0]
  \node (Z) at (0,0) {$Z$};
  \node (A) at (1,0) {$\cdot$};
  \node (B) at (2,0) {$\cdot$};
  \node (X) at (3,0) {$X$};
  \draw[->] ([yshift=+1.5pt]Z.east) to node[anchor=south] {\footnotesize$f_1$} ([yshift=+1.5pt]A.west);
  \draw[->] ([yshift=-1.5pt]A.west) to node[anchor=north] {\footnotesize$f_4$} ([yshift=-1.5pt]Z.east);

  \draw[->] ([yshift=+1.5pt]A.east) to node[anchor=south] {\footnotesize$(I-A')^{-1}$} ([yshift=+1.5pt]B.west);
  \draw[->] ([yshift=-1.5pt]B.west) to node[anchor=north] {\footnotesize$(I-A')$} ([yshift=-1.5pt]A.east);

  \draw[->] ([yshift=+1.5pt]B.east) to node[anchor=south] {\footnotesize$f_2$} ([yshift=+1.5pt]X.west);
  \draw[->] ([yshift=-1.5pt]X.west) to node[anchor=north] {\footnotesize$f_3$} ([yshift=-1.5pt]B.east);
\end{tikzpicture}
\]
\begin{align*}
  X &= f_2 \bigl[ (I-A')^{-1} f_1(Z) \bigr] \\
  Z &= f_4 \bigl[ (I-A')^{-1} f_3(X) \bigr]
\end{align*}
To ensure acyclicity:
$\text{tr} ( I + \alpha A \odot A ) ^d = d$.
  
\nextbook
\begin{book}
  \emph{Learning optimal Bayesian networks:\\ a shortest path perspective}\\
  C. Yuan and B. Malone (2013)
\end{book}
To find the best Bayesian network for a given dataset,
it suffices to find the best leaf (childless variable)
and use dynamic programming.
The resulting order is a path in the \emph{Hasse diagram}
of subsets of variables.
Use $A^*$ to restrict the search to promising paths
