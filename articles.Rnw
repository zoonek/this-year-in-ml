\nextbook
\begin{book}
  \emph{NetworkToolbox:\\ methods and measures for brain, cognitive\\ and psychometric network analysis in R} \\
  A.P. Christensen (R Journal 2018)
\end{book}

A correlation (or partial correlation) matrix can be turned into a graph
using the \emph{graphical lasso} 
(\texttt{bootnet}, \texttt{glasso}, \texttt{IsingFit})
or \emph{information filtering}
(maximum spanning tree, planar/triangulated maximally filtered graph (PMFG/TMFG)), e.g.,
\begin{compactitem}[--]
\item Start with the tetrahedron with the largest sum of weights;
\item Add the node and 3 edges maximizing the sum of weights;
\item Iterate until all the nodes have been added.
\end{compactitem}
The (asymmetric) \emph{dependency matrix} is 
\[ 
  D(i,j) = \operatorname*{Mean}_{k \neq j } 
  \cor(i,k) - \operatorname{pCor}(i,k | j ).
\]
The \emph{randomized shortest path betweenness centrality}
has fewer outliers than the betweenness centrality.
The \emph{node impact} is the difference between the average shortest path length without and with it -- 
if positive, its presence makes communities closer together.
Community detection can be used as a replacement for PCA.
Measures of centrality can also be computed within each community.
Also check \texttt{EGA}.

\nextbook
\begin{book}
  \emph{Two betweenness centrality measures\\ based on randomized shortest paths} \\
  I. Kivim\"aki et al. (2016)
\end{book}

The randomized shortest path betweenness is the expected number of visits of a node, 
for the probability distribution on paths between two given modes \[
  P[ \text{path} ] \propto \exp - \dfrac{ \text{path length} }{ \text{temperature} }.
\]

\nextbook
\begin{book}
  \emph{UMAP: uniform manifold approximation\\ and projection for dimension reduction} \\
  L. McInnes et al. (2018)
\end{book}
A \emph{set} is a functor $* \to \mathfrak{Set}$.
A \emph{fuzzy set} is a functor 
$([0,1],\leq) \to \mathfrak{Set}$
(the classical definition of fuzzy sets, as maps $X \to [0,1]$
measuring ``membership strength'', only provides subsets).

A \emph{simplicial set} is a functor $\Delta\op \to \mathfrak{Set}$.
A \emph{fuzzy simplicial set} is a functor 
$\Delta\op \to \mathfrak{Fuzz}$.

\emph{Extended pseudometric spaces} (they allow 
$d(x,y) = \infty$ and do not require $d(x,y) = 0 \implies x = y$)
and non-expansive maps form a category $\mathfrak{EPMet}$.

There is an adjunction between (finite) simplicial fuzzy sets and (finite) EPM spaces
\[
\begin{tikzpicture}[scale=.7,>=stealth,inner sep=2pt, outer sep=1pt]
\node (A) at (0,2) {$\mathfrak{sFuzz}$};
\node at (0,1) {$\dashv$};
\node (B) at (0,0) {$\mathfrak{EPMet}$};
\draw[->] ([xshift=-7pt]A.south) -- 
          node[auto,pos=.5,inner sep = 1pt,anchor=east,align=right]
          {\scriptsize metric\\[-4pt]\scriptsize realization}
          ([xshift=-7pt]B.north);
\draw[->] ([xshift=+7pt]B.north) -- 
          node[auto,pos=.5,inner sep = 1pt,anchor=west,align=left]
          {\scriptsize singular\\[-4pt]\scriptsize complex}
          ([xshift=+7pt]A.south);
\end{tikzpicture}
\]
which allows us to glue, as fuzzy simplicial sets , metric spaces that cannot be glued together in the category of metric spaces. 

The UMAP algorithm computes the weighted $k$-nearest neighbour 
(the 1-skeleton of the fuzzy simplicial set obtained by glueing
the local neighbourhoods of all points), 
with exponentially decaying weights (the weights are given by the adjunction),
and applies a force-directed graph layout algorithm
(the repulsive forces are only applied to a sampling of the vertices).
\nextbook
\begin{book}
  \emph{Efficient k-nearest neighbour graph construction for generic similarity measures} \\
  W. Dong et al. (2011)
\end{book}
The \emph{nearest neighbour descent} algorithm builds an approximate $k$-nearest neighbour graph
by starting with a random neighbourhood for each point and improving the estimate by looking at neighbours of neighbours. 
\nextbook
\begin{book}
  \emph{Visualizing large-scale\\ and high-dimensional data} \\
  J. Tang et al. (2016)
\end{book}
\emph{LargeViz} computes an approximate $k$-nearest neighbour graph, 
using a few random projection trees
(built from hyperplanes equidistant from two random points in each non-leaf node), 
refines it by looking at neighbours of neighbours, 
assigns $t$-SNE weights to the edges, 
and lays out the graph by maximizing 
\[
\prod_{(i,j) \in E}
f \bigl( \n{y_i - y_j} \bigr) ^ {w_{ij}}
\prod_{(i,j) \not\in E}
\bigl[ 1 - f \bigl( \n{y_i - y_j} \bigr) \bigr] ^ \gamma
\]
using gradient descent and edge sampling (proportionally to the weights),
with $f(x) = ( 1 + e^{x^2} )^{-1}$
or $f(x) = ( 1 + ax^2 ) ^ {-1}$.

\nextbook
\begin{book}
  \emph{Homology-preserving dimensionality reduction via manifold landmarking and tearing} \\
  L. Yan et al. (2018)
\end{book}
\d{Isomap} reduces the dimension of a point cloud by computing its $k$-nearest neighbour ($k$-NN)
graph and applying mutidimensional scaling (MDS) 
to the geodesic distance.

\d{L-Isomap} (landmark isomap) only applies MDS to a set of (often randomly selected) ``landmarks'';
the other points are added using the geodesic distance to the landmarks.

The \d{Reeb graph} of a function $f : X \to \RR$
from a manifold $X$
is obtained by contracting each connected component 
of the level sets $f^{-1}(\{a\})$
to a point.
From a cloud of points, use the inverse image of intervals
$f^{-1}((a,b))$ instead (Mapper algorithm)
and some clustering algorithm (e.g., \textsc{dbscan})
to approximate the connected components. The centroids of the components can be used as landmarks.
The function $f$ is often the distance to some fixed point.

Try to cut the $K$-NN graph with a plane orthogonal to one of the edges of the Reeb graph, and check if this preserves more of the topology by looking at the Wasserstein distance,
or the bottleneck distance, 
between the persistence diagrams
of the original point cloud and the dimension-reduced one.

\nextbook
\begin{book}
  \emph{A physical model\\ for efficient ranking in networks} \\
  C. de Bacco et al.
\end{book}
To estimate a hierarchy (to assign a real-valued rank to each node)
from a directed  graph
(in which most edges are top-down or between nodes of similar rank),
\[
\begin{array}{ll}
  \text{Find} & (s_i)_{ i \in V(G) } \in \RR^{ \va{ V(G) } } \\
  \text{To minimize} & \sum\limits_{ (i \to j) \in E(G) }^{}
  ( s_i - s_j - 1 ) ^2
\end{array}
\]

\nextbook
\begin{book}
  \emph{The social bow tie} \\
  H. Mattie et al.
\end{book}
Use the Jaccard similarity of the neighbourhoods of the ends of an edge as a measure of its ``strength''.

\nextbook
\begin{book}
  \emph{Ctrl+Z: Recovering anonymized social graphs} \\
  Y. Zhang et al.
\end{book}
To anonymize graphs, one can add edges to ensure that nodes cannot be identified by their degree
(there are at least $k$ other nodes with the same degree),
or add edges to add noise to the dk2 series (number of edges between nodes of degree $i$ and $j$).

Word2vec on random walks on the graph provide a node embedding. 
The cosine similarity between the embeddings of the ends of an edge measures its plausibility,
and can be used to deanonymize the graph.

\nextbook
\begin{book}
  \emph{Few-shot learning with graph neural networks} \\
  V. Garcia and J. Bruna (2018)
\end{book}
A \d{graph neural network} (GNN)
takes an input signal on its vertices, 
learns a linear combination of local linear operators 
(e.g., the adjacency matrix and its first powers),
and applies a non-linearity -- 
the output is another weighted graph.

Message-passing algorithms suggest to also learn edge features, 
e.g., 
\(
  \phi(x_i,x_j) = \text{MLP}( \va{ x_i - x_j } )
\)
for $ i \sim j$.

\nextbook
\begin{book}
  \emph{Towards gene expression convolutions\\ using gene interaction graphs} \\
  F. Dutil et al.
\end{book}
To take gene interactions into account, 
use a \emph{network-regularized sparse regression},
with penalty $\lambda \va{w} ' L \va w$,
where $L$ is the graph Laplacian, or a graph convolution network.

\nextbook
\begin{book}
  \emph{Graph convolutional neural networks\\ for web-scale recommender systems} \\
  R. Ying et al. (2018)
\end{book}
To train graph convolutional networks (GCN) on large graphs,
do not use the whole neighbourhood bonds, but use random walks
to sample them (rather than random neighbours)

%% 2019-03-09
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{book}
  \emph{Feedback networks} \\
  A.R. Zamir et al.
\end{book}
Add feedback in (otherwise non-recurrent) networks.
%% Feedback network
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=1,outer sep=1pt, inner sep=2pt,
baseline=1
%baseline={(current bounding box.center)}
]
\node (input) at (0,0) {\footnotesize input};
\node[draw]  (LSTM) at (0,1) {\footnotesize LSTM};
\node (output) at (0,2) {\footnotesize output};
\draw[->,thick] (input) -- (LSTM);
\draw[->,thick] (LSTM) -- (output);
\draw[very thick,->,blue,transform canvas={xshift=-8pt}] (LSTM) -- (0,1.5) -- (-1,1.5) -- (-1,.5) -- (0,.5) -- (LSTM);
\end{tikzpicture}
\qquad
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=1,outer sep=1pt, inner sep=2pt,
baseline=1
%baseline={(current bounding box.center)}
]
\node[anchor=north] (previous) at (0,0) {\vbox{%
  \hsize=3cm
  \centering
  \footnotesize 
  information\\ from the previous\\ iterations
}};
\node[anchor=south] (next) at (0,2) {\vbox{%
\hsize=3cm
\centering
\footnotesize 
Increasingly\\ more precise\\ information
}};
\node[draw,inner sep=4pt]  (LSTM) at (0,1) {\footnotesize LSTM};
\node (input) at (-1,.4) {\footnotesize input};
\node (output) at (1,1.6) {\footnotesize output};
\draw[->,thick] (previous) -- (LSTM);
\draw[->,thick] (LSTM) -- (next);
\draw[->,very thick,blue] (input.east) -- ([xshift=-5pt]LSTM.south |- input.east) -- ([xshift=-5pt]LSTM.south);
\draw[->,very thick,blue] ([xshift=+5pt]LSTM.north) -- ([xshift=+5pt]output.west -| LSTM.north) -- (output.west); 
\end{tikzpicture}
\]


\nextbook
\begin{book}
  \emph{Dilated residual networks} \\
  F. Yu et al.
\end{book}
Remove striding and (to keep large receptive fileds) 
use \emph{dilated} convolutions. 
It is possible to remove the gridding artefacts 
by removing the remaining pooling layers and adding more convolutional layers, without residual convolutions, at the end.
