\[ G = H^{\tens n} R_0 H^{\tens n} O_{x,\pm} \]

Unitary operators appearing in quantum mechanics are often of the form
$U = e^{-iHt}$, form some Hermitian operator $H$ (the Hamiltonian).
If $H = \sum H_j$
(where, for instance, the $H_j$'s only act on a small number of qubits),
we would like to decompose $U$ as a product of simpler (smaller) unitary operators,
but $e^{-iHt} \neq \prod e^{-iH_jt}$ in general (if the $H_j$'s do not commute).
The \emph{Lie-Trotter} formula approximates $U$ as
\[ e^{ -i\sum H_j t } \approx \biggl(
\prod_j e^{ i H_j t / r }
\biggr)^r.
\]
There are other Hamiltonian approximations
(linear combination of unitaries (LCU), block-encoded matrices).

The \emph{HHL algorithm} solves a \emph{quantum} linear system $Ax=b$,
\ie, finds a $n$-qubit state close to
\[ \ket x = \dfrac1{\n x} \sum_{i=0}^{N-1} x_i \ket i, \]
Similarly, \emph{quantum machine learning}
learns from data encoded as quantum states
(the model is a quantum circuit, and the parameters are the gate parameters,
e.g., $\theta$ for $R_\theta$).

Error correction is more necessary than with classical computing, but possible.

\nextbook
\begin{book}
  \emph{Quantum mechanics for mathematicians}\\
  A. Alekseev (2019)
\end{book}

\textbf{1.} A finite-dimensional \d{quantum system} is defined by
$(\mathcal H, H)$:
\begin{compactitem}
\item[A1] A Hilbert space over $\CC$, $\mathcal H$;
\item[A2] The set of \emph{observables},
  \[ \mathscr A = \{ A \in \operatorname{End} \mathcal H \,:\,A^* = A \} \]
  (note that $\mathscr A$ is a Lie algebra);
\item[A3] The set of \emph{states}
  \[ \!\!\!\! \mathscr S = \{ M \in \operatorname{End} \mathcal H \,:\, M^* = M,\, \tr M = 1 ,\, M \geq 0 \}; \]
  a \emph{pure state} is a projection in a 1-dimensional subspace;
  pure spaces form the projective space $\PP( \mathcal H )$;
\item[A4] A measurement map
  \[ \left\{
  \begin{array}{rcl}
    \mathscr A \times \mathscr S & \longrightarrow &
    \{ \text{probability measures on $\RR$} \} \\
    (A,M) & \longmapsto & \mu_A^M
  \end{array}
  \right. \]
  defined by
  \begin{align*}
    \mu_A^M(E) &= \tr\bigl( P P_A(E) \bigr) = \sum_{ i \,:\, \lambda_i \in E  } \tr( M P_i ) \\
    A &= \sum \lambda_i P_i \\
    P_i &:\text{ projections on the eigenspaces} \\
    P_A(E) &= \sum_{ i \,:\, \lambda_i \in E } P_i \\
    P_A &: \text{ projection-valued measure}
  \end{align*}
  For a pure state $M = P_u$, $\n u = 1$, and 1-dimensional eigenspaces
  \begin{align*}
    \mu_A^M &= \sum_i \tr( M P_i ) \delta_{ \lambda_i } \\
    &= \sum_i \va{ \langle e_i , u \rangle } ^2 \delta_{\lambda_i} \\
    &= \sum_i p_i \delta_{ \lambda_i };
  \end{align*}
  the $\langle e_i, u \rangle$ are called \emph{probability amplitudes} (without the modulus).
  The mean and variable of an observable $A$ are
  \begin{align*}
    \bar A &= \int_{\RR} \lambda d \mu_A^M = \sum \lambda_i p_i \\
    \var[A] &= \int_{\RR} ( \lambda - \bar A )^2 d \mu_A^M = \sum ( \lambda_i - \bar A ) ^ 2 p_i.
  \end{align*}
  More generally (``functional calculus''), for a function $f : \RR \to \RR$,
  $f(A) = \sum f(\lambda_i) P_i $ is still self-adjoint
  and
  \[ \overline{ f(A) } =
  \int_{\RR} f(\lambda) d \mu_A^M = \sum f(\lambda_i) p_i. \]
\item[A5] $H \in \mathscr A$, the \emph{Hamiltonian} of the system;
  its eigenvalues are denoted $E_1,\dots,E_n$;
  the evolution of the system is then defined by
  \[ \dfrac{ d M(t) }{ dt } = - \dfrac{ i }{ \hbar } [H, M]. \]
  It is often written for pure states $P_u$, \ie, projections
  on 1-dimensional subspaces,
  \[ \dfrac{ d u(t) }{ dt } = - \dfrac{ i }{ \hbar } H u(t). \]
  It can be solved with the (unitary) \emph{evolution operator}
  $U(t) = \exp( - \tfrac{i}{\hbar} H t )$ as
  $u(t) = U(t) u_0$
  (for general states, $M_t = U_t M_0 U_t^{-1}$).
  In the Heisenberg picture, the state is constant
  and the observables change
  \[ \dfrac{ d A(t) }{ dt } = + \dfrac{ i }{ \hbar } [H,A] . \]
\end{compactitem}

The Heisenberg uncertainty principle states
\[ \sigma_{A_1}^2 \sigma_{A_2}^2 \geq \dfrac12 \va{
  \tr M \bigl( [ A_1, A_2 ] \bigr )
} ^2. \]

An observable $A \in \mathscr A$ is a \emph{conserved quantity},
or a \emph{quantum integral} if $[H,A]=0$.

The Lie algebra of symmetries is
\[ \operatorname{sym} H = \{ G \in i \mathscr A \ :\ [B,H] = 0 \} \subset i \mathscr A. \]


The group of symmetries is
\[ \operatorname{Sym} H = \{ g \in U(\mathcal H) \ :\ g H g^{-1} = H \} \]

A set of observables $(H,A_1,\dots,A_m)$ is a quantum \emph{integrable system}
if they commute and their symmetry group
$\operatorname{Sym}(H,A_1,\dots,A_m)$ is as small as possible, \ie,
$U(1)\times\cdots\times U(1)$, \ie, the joint eigenspaces are of dimension 1.
Given a basis of common eigenvectors
$(e_a){1\leq a \leq n}$,
\begin{align*}
  H e_a &= E_a e_a \\
  A_i e_a &= \alpha_a^i e_a
\end{align*}
there is a bijection between the set of \emph{quantum numbers}
$\{ (E_a, \alpha_a^1, \dots, \alpha)a^m) \ :\ 1 \leq a \leq m \}$
and the basis.
Examples include:
\begin{compactitem}[--]
\item The spin $\tfrac12$ particle, $\mathcal H = \CC^2$, with the Pauli matrices
  $\sigma_1$, $\sigma_2$, $\sigma_3$ 
  as an $\RR$-basis of $\mathscr A$ and, for instance,
  $H = \begin{pmatrix} \alpha & 0 \\ 0 & - \alpha \end{pmatrix};$
\item The Heisenberg magnetic chain,
  $\mathcal H = (\CC^2)^{\tens N}$,
  \[\ H = J \sum_{i=1}^N \sum_{a=1}^3 \sigma_a^i \sigma_a^{i+1} \]
  where $\sigma_a^i = 1\tens\cdots\tens1\tens\sigma_a\tens1\cdots\tens1$.
  Note that $L_a = \sum_i \sigma_a^i$ are conserved quantities,
  but there are many more.
\end{compactitem}

\textbf{2.}
Given a (possibly unbounded) operator
on a Hilbert space $\mathcal H$
\[ A : \mathcal H \supset D(A) \longrightarrow \mathcal H \]
with dense domain $D(A)$, its \emph{adjoint} is
$A^*: D(A^*) \rightarrow \mathcal H$
where \[ D(A^*) = \{
v \in \mathcal H \ :\ u \mapsto \langle u, Au \rangle \text{ is bounded on $D(A)$}
\} \]
and $A^*$ is given by the Riesz representation theorem
$\langle v, Au \rangle = \langle A^* v , u \rangle$.
The domain $D(A^*)$ need not be dense.

An operator is \emph{closed} if its graph is closed;
it is \emph{closable} if it admits a closed extension;
it is \emph{symmetric} if $\forall u, v\, \langle Au,v \rangle = \langle u,Av\rangle$.
For a symmetric closable operator,
$A \subset \bar A \subset A^*$. An operator is \emph{self-adjoint} if $A^*=A$
(in particular, $D(A) = D(A^*)$);
it is \emph{essentially self-adjoint} if $\bar A = A^*$.

If $A$ is symmetric,
\[ A^* = A \text{ iff } \im(A+i) = \im(A-i) = \mathcal H. \]

If $A$ is symmetric and closed, it admits a self-adjoint extension
iff $n_+(A) = n_-(A)$;
its self-adjoint extensions are in bijection with unitary operators
\[ U:\,\ker(A^*-i) \to \ker(A^*+i). \]

Given two self-adjoint operators $A$, $B$, with $D(A) \subset D(B)$,
if $\forall u \in D(A) \ \n{ Bu } \leq \alpha \n{ A u } + \beta \n u $,
for some $\alpha < 1$,
then $A+B: D(A) \to \mathcal H$ is self-adjoint (Kato-Rellich).

In $\ell^2$, the operator $A e_i = a_i e_i$,
on
\[ D(A) = \{ \text{sequences eventually zero} \} \]
is symmetric if the $a_i$'s are real;
its adjoint is defined on
\[ D(A^*) = \{ v \ : \ \sum a_i^1 \n{ v_i }^2 < \infty \}; \]
it is essentially self-adjoint: $\bar A = A^*$.

On $L^2([0,1])$, the momentum operator
\[ A = - i \hbar \dfrac d{dx}, \]
defined on $\mathscr C_0^1( [0,1], \CC )$
(continuously differentiable functions $u$ with $u(0)=u(1)=0$)
is symmetric but not essentially self-adjoint:
$\bar A \subsetneq A^*$, since $\mathscr C^1([0,1]) \subset D(A^*)$.
Replacing the boundary conditions with $u(0)=u(1)$ (\ie, replacing $[0,1]$ with $\SS^1$)
fixes the problem.

In $L^2(\RR^n)$, multiplication by a measurable function $V = V(x_1,\dots,x_n)$
is a self-adjoint operator $\hat V$ on
$D(\hat V) = \{
u \in \L^2(\RR^n) \,:\, \int_{\RR^n} V^2 \va{ u }^2 d^n x < \infty \}.$

Using the Fourier transform and the Schwartz functions
$ \mathscr S = \{ u \in \mathscr C^\infty \,:\,
\forall ij \ \sup_x \va{ x^i \partial_j u } < \infty \}
$
one can build self-adjoint extensions of $-i\partial_i$.

In $L^1(\RR^3)$ (not $L^2(\RR^n)$ for $n\geq4$)
$A = - \Delta + \hat V_1 + \hat V_2$,
where $V_1 \in L^2$,
$V_2 \in L^\infty$,
is self-adjoint on $D(-\Delta)$
and bounded below ($\forall u\ \langle u, Au \rangle \geq C \n{ u }^2$).

\textbf{3.}
The \d{spectrum} $\sigma(A)$ of $A : D(A) \to \mathcal H$ is
\[ \{ x \in \CC \,:\, A-z \text{ is not invertible} \}; \]
it is closed. For instance,
\begin{align*}
  A &= - i \dfrac{ d }{ dx } \\
  D(A) &= \mathscr C^1( \SS^1 ) \\
  \sigma(A) &= \ZZ 
\end{align*}
\begin{align*}
  A &= \hat x \\
  D(A) &= \biggl\{ u \in L^2(\RR) \,:\, \int_\RR x^2 \va{ u(x) }^2 dx < \infty \biggr\} \\
  \sigma(A) &= \RR
\end{align*}
If $A: D(A) \to \mathcal H$ is self-adjoint, there is a unique projection-valued measure
$E \mapsto P_A(E)$ on $\RR$
such that
\begin{align*}
  D(A) &= \{ u \in \mathcal H \,:\, \int_\RR \lambda^2 f\langle u, P_A(\lambda) \rangle < \infty \} \\
  Au &= \int_\RR \lambda d \bigl( P_A(\lambda) u \bigr)
  \text{ (Riemann integral)} \\
  \langle u, Au \rangle &= \int_\RR \lambda d\langle u , P_A(\lambda) u \rangle
\end{align*}
where $P_A(\lambda) = P_A\bigl( (-\infty,\lambda) \bigr)$.

For $f \in \mathscr C(\RR, \CC)$, we can define (functional calculus)
$f(A)$ as
\begin{align*}
  D\bigl( f(A) \bigr) &= \biggl\{
  u \in \mathcal H \,:\, \in \va{ f(\lambda) } ^ 2 d\langle u , P_A(\lambda) u \rangle < \infty 
  \biggr\} \\
  f(A) (u) &= \int_\RR f(\lambda) d \bigl( P(\lambda) u \bigr).
\end{align*}
In particular, for the Hamiltinian
$H : D(H) \to \mathcal H$, we can define the 1-parameter subgroup
of unitary evolution operators
\[ U(t) = \exp \biggl( - \dfrac i\hbar H t \biggr). \]

%\textbf{4.} ODEs
%This part of the course, on the Stokes phenomenon and Airy's function,
%and the WKB approximation (asymptotic behaviour when $\hbar \to 0$)
%was not clear.

% Path integrals
\textbf{5.}
Given two self-adjoint operators $A$, $B$,
with $D(A) \inter D(B)$ dense,
such that $A+B$ be self-adjoint,
\[ \forall \psi \ \ 
e^{ i(A+B) } \psi - ( e^{iA/n} e^{iB/n} ) ^n \psi \longrightarrow 0. \]
If, in addition, $A$ and $B$ are bounded below,
\[ \forall \psi \ \ 
e^{ -(A+B) } \psi - ( e^{-A/n} e^{-B/n} ) ^n \psi \longrightarrow 0. \]
The \emph{Feynman path integral} applies this to
$H=A+B$, $A = - (\hbar^2/2m) \Delta$,
$B=V(x)$, and conjectures (wrongly) that the resulting limit can be expressed as an
integral on a space of paths.

If $A : \RR^n \to \RR^n$ is self-adjoint with positive eigenvalues,
then the \emph{Gaussian integral} is
\[ \int_{\RR^n} d^nx e^{
  \displaystyle
  -\tfrac12 \langle x , Ax \rangle + \langle x, y \rangle
} =
\dfrac{
  (2\pi)^{n/2}
}{
  (\det A)^{1/2}
}
e^{
  \displaystyle
  \tfrac12 \langle y, A^{-1} y \rangle
}
\]
(there is a similar formula for complex exponential).

There are several generalizations of the determinant to infinite dimensions.
The \emph{Fredholm determinant} is
\[ \det\nolimits_F ( I - \lambda A^{-1} ) = \prod\biggl( 1 - \dfrac\lambda{\lambda_k} \biggr)
\quad \text{ if } \sum \dfrac1{\va{ \lambda_k }} < \infty \]
(it is a holomorphic function with zeroes at $\lambda = \lambda_k$.
If the eigenvalues of $A$ are positive, its zeta function is
\[ \zeta_A(s) = \sum \dfrac{ 1 }{ \lambda_k ^s }. \]
In finite dimension,
$\zeta(0) = n$ and $\zeta'(0) = \log \det A$;
in infinite dimension, if $\zeta$ admits an analytic continuation to a neighbourhood of 0,
we can define the \emph{$\zeta$-regularized determinant}
\[ \det\nolimits_\zeta(A) = \exp - \zeta'_A(0) \]
and the $\zeta$-regularized dimension $\delta_A = \zeta_A(0)$.
In particular,
$\det\nolimits_\zeta(cA) = c^{ \delta_A } \det\nolimits_\zeta (A).$
Those two notions are related:
\[ \det\nolimits_\zeta( A - \lambda ) = \det\nolimits_\zeta(A) \det\nolimits_F( I - \lambda A^{-1} ). \]
  

\nextbook
\begin{book}
  \emph{SDDP.jl: a Julia package\\ for stochastic dual dynamic programming}\\
  O. Dowson and L. Kapelevich
\end{book}
A multistage stochastic optimization problem is of the form
\[ \begin{array}{ll}
  \text{Find} & u \\
  \text{To maximize} & \E\limits_{\omega_1} \bigl[ V_1( x_1, \omega_1 ) \bigr] \\
  \text{Where}
  & x_1 = 0 \qquad \text{state} \\
  & x_{t+1} = f(x_t, \omega_t, u_t) \\
  & \omega_t \sim p_t  \qquad \text{noise}\\
  & V_t(x_t,\omega_t) = \max\limits_u g(x_t, \omega_t, u ) + \\
  & \hphantom{ V_t(x_t,\omega_t) = \max\limits_u }
  \E\limits_{\omega_{t+1}} \bigl[ V_{t+1} ( x_{t+1} , \omega_{t+1} ) \bigr] \\
  & h( x_{\leq t}, u_{\leq t}, \omega_{\leq_t} ) = 0  \qquad \text{constraints}
\end{array} \]
  
\nextbook
\begin{book}
  \emph{Dynamic low-rank approximation}\\
  O. Koch and C. Lubich (2007)
\end{book}
One can compute a low-rank approximation of a smooth path
$A: [0,1] \to \RR^{m\times n}$ as
\[ X(t) = \argmin_{ X: \rank X = k } \n{ X - A(t) }_2^2. \]
Alternatively, try
\[ \hat Y(t) = \argmin_{ X: \rank X = k } \n{ X - \dot A_t }_2^2; \]
this gives a \emph{smooth} low-rank approximation.




\nextbook
\begin{book}
  \emph{Sheaf neural networks}\\
  J. Hansen and T. Gebhart (2020)
\end{book}
A \emph{cellular sheaf} $\mathscr F$ on a graph $G=(V,E)$ is the datum of
\begin{compactitem}[--]
\item A vector space $\mathscr F(v)$ for each node $v \in V$;
\item A vector space $\mathscr F(e)$ for each edge $e \in E$;
\item A linear map $\mathscr F_{ v \trianglelefteqslant e}: \mathscr Fv \to \mathscr F e$
  for each incident vertex-edge pair $v \trianglelefteqslant e$.
\end{compactitem}
A \emph{0-cochain}, resp. \emph{1-cochain}, is an element of
\begin{align*}
  C^0( G, \mathscr F ) &= \prod_{ v \in V } \mathscr F(v) \\
  \text{resp. }
  C^1( G, \mathscr F ) &= \prod_{ e \in E } \mathscr F(e).
\end{align*}
The \emph{coboundary} map is
\[ \delta: \left\{
\begin{array}{rcl}
  C^0( G, \mathscr F ) & \longrightarrow & C^1(G, \mathscr F) \\
  ( x_v )_{ v \in V } & \longmapsto &
  \bigl( \mathscr F_{ v \trianglelefteqslant e } x_v - \mathscr F_{ u \trianglelefteqslant e } x_u
  \bigr)_{e \in E}
\end{array}
\right.
\]
(for an arbitrary orientation of the edges).

The \emph{sheaf Laplacian} is
$ L_{\mathscr F} = \delta^\top \delta $.
For the \emph{constant sheaf}
$\mathscr F v = \RR$,
$\mathscr F e = \RR$,
$\mathscr F_{v \trianglelefteqslant e} = \text{Id}$,
it is the standard Laplacian.
With different signs for $\mathscr F_{ v \trianglelefteqslant e }$,
it can model \emph{signed} graphs and heterophily.
The \emph{normalized Laplacian} is
$\tilde L_{ \mathscr F} = D^{-1/2} L_{\mathscr F} D^{-1/2}$,
where $D = \operatorname{diag} L_{\mathscr F}$.
The corresponding \emph{diffusion operator} is
$\tilde H_{\mathscr F} = I - \tilde L_{\mathscr F}$.
A \emph{sheaf convolution layer} is
\[ X \longmapsto \rho \bigl[
  \tilde H_{ \mathscr F } \bigl(  (I_{\va V} \tens B) X A \bigr)
  \bigr]
\]
where $\rho$ is an elementwise nonlinearity.

\nextbook
\begin{book}
  \emph{Sheaf neural networks\\ with connection Laplacians}\\
  F. Barbero et al. (2022)
\end{book}
GNNs work poorly on heterophilic data (homophily is an inductive bias)
and suffer from oversmoothing.
Replacing the Laplacian with a sheaf Laplacian can address those problems.
Instead of choosing the sheaf manually using domain knowledge,
or learning it end-to-end,
\[ \mathscr F_{ v \trianglelefteqslant (v,u) } = \Phi( x_v, x_u ) \in \RR^{d\times d}, \]
compute it at preprocessing time, using local PCA:
\begin{align*}
  & i, j: \text{ nodes} \\
  & \hat X_i: \text{ features of the neighbours of $i$} \\
  & \hat X_i = U_i \Sigma_i V_i'  \text{ (SVD)} \\
  & O_i = U_i[ :, :d ] \\
  & O_i' O_j = U \Sigma V' \text{ (SVD)} \\
  & O_{ij} = U V' \\
  & O_{ij} = \mathscr F^\top_{ j \trianglelefteqslant e } \mathscr F_{ i \trianglelefteqslant e}.
\end{align*}
This is the parallel transport:
it gives the entries of $L_{\mathscr F}$, up to sign for the off-diagonal blocks.
  
\nextbook
\begin{book}
  \emph{Neural sheaf diffusion:\\ a topological perspective on heterophily\\ and oversmoothing in GNNs}\\
  C. Bodnar et al. (2022)
\end{book}
A \emph{discrete $O(d)$-bundle} is a cellular sheaf with orthogonal maps
$\mathscr F_{ v \trianglelefteqslant e } \in O(d)$.
If the \emph{transports}
\[ P_{ \gamma: v_1 \to \cdots \to v_n } =
(\mathscr F^\top_{ v_{n-1} \trianglelefteqslant e } \mathscr F_{ v_n \trianglelefteqslant e })
\cdots
(\mathscr F^\top_{ v_{1} \trianglelefteqslant e } \mathscr F_{ v_2 \trianglelefteqslant e })
% check the order -- my notes were inconsistent
\]
are path-independent, then there is a nontrivial global section:
$H^0 \neq 0$ (in fact, $\dim H^0=d$).
Diffusion, if run long enough, yields a signal constant on each connected component.
Diffusion on a well-chosen $O(d)$-bundle can linearly separate classes,
even in presence of heterophily.

Learn the sheaf to use in \emph{neural sheaf diffusion} layers
\[ X_{t+1} = X_t - \sigma \bigl[
  \Delta_{ \mathscr F(t) }
  ( I \tens W_1^t ) X_t W_2^t
  \bigr] \]
as
\[
\mathscr F_{ v \trianglelefteqslant (v,u) } = \Phi( x_v, x_u ) =
\sigma \bigl( V [ x_v \| x_u ] \bigr).
\]

Parametrize orthogonal matrices with \emph{Householder reflections}.

The sheaf Laplacian is a positive semi-definite block matrix;
the diagonal blocks are
\[ ( L_{ \mathscr F} )_{vv} =
\sum_{ v \trianglelefteqslant e } \mathscr F^\top_{ v \trianglelefteqslant e } \mathscr F_{ v \trianglelefteqslant e }
\]
and the off-diagonal blocks are
\[ ( L_{\mathscr F} )_{uv} = - \mathscr F^\top_{ v \trianglelefteqslant e }
\mathscr F_{ u \trianglelefteqslant e }. \]

\nextbook
\begin{book}
  \emph{Efficient orthogonal parametrization\\ of recurrent neural networks\\ using Householder reflections}\\
  Z. Mhammedi et al. (2017)
\end{book}
All orthogonal matrices in $O(n)$
can be written as
$H_n(u_n) H_{n-1}(u_{n-1}) \cdots H_1(u_1)$
where $u_k \in \RR^k \setminus \{0\}$, $u_1 \in \{\pm1\}$,
\[ H_k(u) = \begin{pmatrix}
  I_{n-1} & 0 \\ 0 & I_k - 2 \dfrac{ u u' }{ \n u } 
\end{pmatrix},
\quad
H_1(u) = \begin{pmatrix}
  I & 0 \\ 0 & u
\end{pmatrix}.
\]
Use in RNNs to prevent vanishing or exploding gradients.
  
\nextbook
\begin{book}
  \emph{Knowledge sheaves: a sheaf-theoretic framework for knowledge graph embedding}\\
  T. Gebhart and J. Hansen 
\end{book}
A \emph{knowledge graph schema} is a directed multigraph with entity types as nodes
and relation types as edges.
A \emph{knowledge graph} (KG) is a graph morphism to a KG schema $k: G \to S$.
A \emph{knowledge sheaf} is a cellular sheaf $\mathscr F$ on a KG schema;
it induces a sheaf $k^* \mathscr F$ on the KG.
A \emph{sheaf embedding} of a KG $G$ is a global section
$x \in H^0( G, k^* \mathscr F ) \subset
C^0( G, k^* \mathscr F)$.
It can be learned, together with the sheaf $\mathscr F$, as
\[ \operatorname*{Minimize}_{
  x \in C^0( G, k^* \mathscr F )
} x' L_{ k^* \mathscr F } x
\] with a penalty (negative examples) to avoid the zero solution
(in practice, a marging ranking loss works better).
Translational embeddings (TransE) are a special case.
  
\nextbook
\begin{book}
  \emph{A brief note for sheaf structures on posets}\\
  C.S. Hu (2020)
\end{book}
A \emph{cellular sheaf} on a poset $(P,\leq)$ is a functor
$(P,\leq) \to \mathfrak{Set}$.
In the \emph{Alexandrov topology} on a poset $(P,\leq)$, the open sets are the $U \subset P$
such that
\[ \forall x \in U \ \forall y \in P \ x \leq y \implies y \in U . \]
The \emph{open stars}
$U_x = \{ y \in P \,:\, x \leq y \}$,
$x \in P$, form an open basis.
The closure of $x \in P$ is $\bar x = \{ y \in P \,:\, y \leq x \}.$
A cellular sheaf $\mathscr F$ on $(P,\leq)$ induces a sheaf on $P$
with the Alexandrov topology with $\mathscr F( U_x ) = \mathscr F(x)$.
  
\nextbook
\begin{book}
  \emph{Towards a spectral theory of cellular sheaves}\\
  J. Hansen and R. Ghrist 
\end{book}
A \emph{cellular sheaf} on a \emph{regular cell complex} is the datum of a vector space
$\mathscr F(\sigma)$ for each cell $\sigma$ of $X$, together with a linear transformation
(restriction map)
\( \mathscr F_{ \sigma \trianglelefteqslant \tau }: \mathscr F(\sigma) \to \mathscr F(\tau) \)
for each incident cell pair, such that $\mathscr F_{ \sigma \trianglelefteqslant\sigma } = \text{Id}$
and $\mathscr F_{ \sigma \trianglelefteqslant \tau } \circ
\mathscr F_{ \rho \trianglelefteqslant \sigma } =
\mathscr F_{ \rho \trianglelefteqslant \tau }$.
The space of \emph{cochains} is
\[ C^k( X, \mathscr F ) = \bigoplus_{ \dim \sigma = k } \mathscr F(\sigma) \]
and the coboundary $\delta^k : C^k \to C^{k+1}$ is
\[ \left. \delta^{k+1} \right|_{ \mathscr F(\sigma) }
= \sum_{ \dim \tau = k+1 }
[\sigma:\tau] \mathscr F_{ \sigma \trianglelefteqslant \tau } \]
where the \emph{signed incidence relation} satisfies
\begin{compactitem}[--]
\item $\sigma \trianglelefteqslant \tau \implies
  \sum_\gamma [\sigma : \gamma] [\gamma : \tau] = 0$;
\item $[\sigma:\tau]\neq0$ only if $\sigma \trianglelefteqslant \tau$ and there are
  no cells between $\sigma$ and $\tau$.
\end{compactitem}
The \emph{Hodge Laplacian} is $\Delta = ( \delta + \delta^*) = \delta^*\delta + \delta\delta^*$.
$\Delta^k$ can be decomposed as $\Delta^k = \Delta^k_+ + \Delta^k_-$
with $\Delta_+^k = (\delta^k)^* (\delta^k)$
and $\Delta_-^k = (\delta^{k-1}) (\delta^{k-1})^*$.
The cohomology is then
\[ H^k := \dfrac{ \ker \delta^k }{ \im \delta^{k-1} } = \ker \Delta^k. \]
The degree-zero Laplacian generalizes the graph Laplacian;
its diagonal and off-diagonal blocks are
\begin{align*}
  \Delta_{vv}^0 &= \sum_{ v \trianglelefteqslant e } \mathscr F^*_{ v \trianglelefteqslant e } \mathscr F_{ v \trianglelefteqslant e } \\
  \Delta_{uv}^0 &= - \mathscr F^*_{ u \trianglelefteqslant e } \mathscr F_{ v \trianglelefteqslant e }.
\end{align*}
The Laplacian of a \emph{normalized sheaf}
\[ \forall x, y \in \mathscr F(\sigma) \inter ( \ker \delta  )^\perp \quad
\langle \delta x , \delta y \rangle = \langle x, y \rangle
\]
generalizes the normalized graph Laplacian.

\nextbook
\begin{book}
  \emph{Path homologies of deep forward networks}\\
  S. Chowdhury et al.
\end{book}
An \emph{elementary $p$-path} in a graph $(V,E)$ is a sequence of $p+1$ nodes
$(x_0,\dots,x_p)$; it is \emph{allowed} if $\forall i \ (x_i,x_{i+1}) \in E$.
Let $\Lambda_p(V)$ and $A_p(V)$ be the free vector spaces generated by
elementary and allowed paths.
The boundary of a path is
$\partial_p [x_0,\dots,x_p] = \sum (-1)^i [x_0,\dots,\widehat{ x_i }, \dots, x_p ]
\in \Lambda_p(V)$.
The $\partial$-invariant paths
$\Omega_p = \{ c \in A_p \,:\, \partial_p \in A_{p-1} \}$
form a chain complex
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=1pt, outer sep=1pt]
  \node (A0) at (.1,0) {};
  \node (A1) at (1,0) {$\Omega_2$};
  \node (A2) at (2,0) {$\Omega_1$};
  \node (A3) at (3,0) {$\Omega_0$};
  \node (A4) at (4,0) {$k$};
  \node (A5) at (4.8,0) {$0$};
  \draw[->] (A0) to node[anchor=south]{\footnotesize$\partial_3$} (A1);
  \draw[->] (A1) to node[anchor=south]{\footnotesize$\partial_2$} (A2);
  \draw[->] (A2) to node[anchor=south]{\footnotesize$\partial_1$} (A3);
  \draw[->] (A3) to node[anchor=south]{\footnotesize$\partial_0$} (A4);  
  \draw[->] (A4) -- (A5);
\end{tikzpicture}
\]
defining the \emph{path homology}
$H_p^{\Xi}(G) = \ker \partial_p / \im \partial_p $.
The \emph{directed flag complex} (DFC) is defined %similarly,
from sequences
$(x_0,\dots,x_p)$ satisfying
$\forall i < j \ (x_i,x_j) \in E$.





