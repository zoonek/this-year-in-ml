\nextbook
\begin{book}
  \emph{Word translation without parallel data} \\
  A. Conneau et al. (2018)
\end{book}
To align word embeddings for two different languages, 
given a dictionary of 5000 pairs of words,
find an orthogonal transformation
$W$ that maps one to the other (Procrustes problem),
\[ W^* = \argmin_{ W \in O } \n{ W X - Y }_F  = U V', \]
where $Y X' = U \Sigma V'$ is the SVD.

With no bilingual dictionary, 
learn an orthogonal transformation $W$ and a discriminator to distinguish a random sample 
from $\{Wx_1, \dots, Wx_n\}$
from one from $\{y_1,\dots,y_m\}$.
The orthogonality constraint can be enforced by alternating the gradient updates with 
\[
W \leftarrow (1+\beta) W - \beta W W' W,
\qquad \beta = 10^{-2}.
\]

The alignment can be improved by selecting the most frequent words,
assuming their nearest neighbour is the correct translation and using the Procrustes method.

The notion of nearest neighbour is not symmetric: 
some points are the nearest neighbour of many points (hubs),
others of no points (anti-hubs).

The similarity between source and target words can be measured as 
\[
\text{CSLS}(W\!x,y) = 2 \cos(W\!x,y) 
- \bigl\langle \cos(W\!x,\cdot) \bigr\rangle
- \bigl\langle \cos(\cdot,y)  \bigr\rangle,
\]
where the average cosine similarities are computed over neighbourhoods of $Wx$ and $y$ 
in the bipartite graph of $k$-nearest neighbours.

\nextbook
\begin{book}
  \emph{On the tree-likeness of hyperbolic spaces} \\
  M. Hamann
\end{book}
An $\RR$-tree is a topological space $X$ such that there exists a unique arc between any two points. 

Two geodesic rays (unbounded geodesics, isometric images of $(0,\infty)$), 
$\pi_1$, $\pi_2$ are equivalent if, 
for all sequences $(x_n)_n$ in $\pi_1$, 
there exists $M$ such that 
$\varliminf d(x_n, \pi_2) \leq M$.
The \emph{hyperbolic boundary} $\partial X$ of $X$
is the set of equivalence classes of geodesic rays. 
There are geodesic (double) rays between boundary points 
and between boundary points and interior points. 

Given a proper hyperbolic space $X$
(the closed balls are compact and 
there is a geodesic between any two points),
there exists a topological $\RR$-tree $T$ whose rays are quasi-geodesics and such that every geodesic ray in $X$ lies eventually close to a ray of $T$;
the embedding $T \hookrightarrow X$
extends to $\partial T \hookrightarrow \partial X$
(no longer an embedding).

The \emph{Assouad dimension} is defined by 
\begin{align*}
  S(\alpha,\beta) &= \{ \# V \ :\ 
  \forall x \neq y \in V \ \ 
  \alpha \leq d(x,y) \leq \beta 
  \} \\
  \dim_A(X) &= \inf \bigl\{ s \geq 0 \ :\ 
  \forall\, 0 < \alpha \leq \beta \ \ 
  \exists c \geq 0 \\
  &\qquad\qquad\qquad\quad
  S(\alpha,\beta) \leq c (\beta/\alpha)^s 
  \bigr\}.
\end{align*}

\nextbook
\begin{book}
  \emph{Hyperbolic deep learning\\ for Chinese natural language understanding} \\
  M.V. Micic and H. Chu 
\end{book}
The \emph{hyperbolic skipgram} character embedding replaces 
the Euclidean product with the Lorentzian product
in the hyperboloid model $\HH ^n \subset \RR^{(n,1)}$
\begin{align*}
\langle x, y \rangle_{\mathscr L} &= 
\sum_{i=1}^n x_i y_i - x_{n+1} y_{n+1} \\
\HH^n &= \{ x \in \RR^{(n,1)} \ :\ 
\langle x, x \rangle _{\mathscr L} = -1 
\text{ and }
x_{n+1} > 0
\}
\end{align*}
(with an additive shift $\langle x, y \rangle 	\rightsquigarrow
\langle x, y \rangle_{\mathscr L } + \theta $).

Transform the character embedding from the hyperboloid model to the Poincar\'e model
and apply a \emph{hyperbolic transformer}
to an \emph{intent classification} dataset
(text-based commands to an Alexa-like machine).

Train the character embedding on the linguistic data consortium corpus  and the word embedding (form comparison) on 
the People's daily corpus (both commercial).

\emph{Analytic hyperbolic geometry} 
defines a scalar product and a (non-commutative, non-associative) sum between points in a hyperbolic space (\emph{gyrovectors}): 
\begin{align*}
  \lambda \otimes x &= \exp_0 \bigl( \lambda \log_0 x \bigr) \\
  x \oplus y &= \exp_x \bigl( P_{0 \to x} \log_0 y \bigr)
\end{align*}

\nextbook
\begin{book}
  \emph{State-of-the-art Chinese word segmentation with bi-LSTMs} \\
  J. Ma et al.
\end{book}
Stacked biLSTM, with characters and bigrams as inputs, pre-trained embeddings, dropout (for the LSTM parameters) and hyperparameter tuning; 
data from the Chinese Penn treebank, Chinese universal treebank and SIGHAN2005.
% Stacking and non-stacking LSTM
