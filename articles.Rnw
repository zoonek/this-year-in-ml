  \end{tikzpicture}
  &\qquad\text{M bias} \\
  \begin{tikzpicture}[>=stealth,xscale=.8,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,0) {$T$};
    \node (Y) at (2,0) {$Y$};
    \node[draw,inner sep=1pt] (X) at (1,1) {$X$};
    \node[circle,densely dotted,draw] (U1) at (0,2) {$U_1$};  
    \node[circle,densely dotted,draw] (U2) at (2,2) {$U_2$};  
    \draw[->] (U1) -- (T);
    \draw[->] (U1) -- (X);
    \draw[->] (U2) -- (Y);
    \draw[->] (U2) -- (X);
    \draw[->] (T) -- (Y);
    \draw[-] (U1) -- (U2);
  \end{tikzpicture}
  &\qquad\text{M bias, correlated factors} \\
  \begin{tikzpicture}[>=stealth,xscale=.8,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,0) {$T$};
    \node (Y) at (2,0) {$Y$};
    \node[draw,inner sep=1pt] (X) at (1,1) {$X$};
    \node[circle,densely dotted,draw] (U1) at (0,2) {$U_1$};  
    \node[circle,densely dotted,draw] (U2) at (2,2) {$U_2$};  
    \draw[->] (U1) -- (T);
    \draw[->] (U1) -- (X);
    \draw[->] (U2) -- (Y);
    \draw[->] (U2) -- (X);
    \draw[->] (T) -- (Y);
    \draw[->] (X) -- (Y);
  \end{tikzpicture}
  &\qquad\text{M bias, confounding} \\
  \begin{tikzpicture}[>=stealth,xscale=.8,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,0) {$T$};
    \node (Y) at (2,0) {$Y$};
    \node[draw,inner sep=1pt] (X) at (1,1) {$X$};
    \node[circle,densely dotted,draw] (U1) at (0,2) {$U_1$};  
    \node[circle,densely dotted,draw] (U2) at (2,2) {$U_2$};  
    \draw[->] (U1) -- (T);
    \draw[->] (U1) -- (X);
    \draw[->] (U2) -- (Y);
    \draw[->] (U2) -- (X);
    \draw[->] (T) -- (Y);
    \draw[->] (X) -- (T);
    \draw[->] (X) -- (Y);
  \end{tikzpicture}
  &\qquad\text{butterfly bias} \\
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,0) {$T$};
    \node[draw,inner sep=1pt] (X) at (1,1) {$X$};
    \node (Y) at (2,0) {$Y$};
    \node (M) at (1,0) {$M$};
    \draw[->] (X) -- (M);
    \draw[->] (M) -- (Y);
    \draw[->] (T) -- (M);
  \end{tikzpicture}
  &\qquad\text{may decrease variance} \\
  \begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,1) {$T$};
    \node[draw,inner sep=1pt] (Z) at (1,0) {$Z$};
    \node (Y) at (2,1) {$Y$};
    \draw[->] (T) -- (Y);
    \draw[->] (T) -- (Z);
    \draw[->] (Y) -- (Z);
  \end{tikzpicture}
  &\qquad\text{collider bias} \\
  \begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
    \node (T) at (0,0) {$T$};
    \node[draw,inner sep=1pt] (X) at (1,1) {$X$};
    \node (Y) at (2,0) {$Y$};
    \node[circle,draw,densely dotted] (U) at (2,2) {$U$};
    \draw[->] (T) -- (Y);
    \draw[->] (X) -- (Y);
    \draw[->] (T) -- (X);
    \draw[->] (U) -- (X);
    \draw[->] (U) -- (Y);
  \end{tikzpicture}
  &\qquad\text{collider stratification bias} \\
  \begin{tikzpicture}[>=stealth,xscale=1,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,-.05)}]  
    \node (T) at (0,0) {$T$};
    \node[draw,inner sep=1pt] (Z) at (2,0) {$Z$};
    \node (Y) at (1,0) {$Y$};
    \draw[->] (T) -- (Y);
    \draw[->] (Y) -- (Z);
  \end{tikzpicture}
  &\qquad\text{recall bias}
  \end{align*}
\endgroup
  
% 9. Modern nonlinear regression: trees, forests, boosting, neural nets, ensembling,
% with theoretical results under the "structured sparsity" assumption

\textbf{10.}
We want to compute
\[ \dfrac{ d }{ dt } \E \bigl[ Y | T = t, X = x \bigr]  \]
or
\[ \dfrac{ d }{ dt } \E \bigl[ Y | \text{do}(T = t), X = x \bigr]  \]
(which reduces to the first expression
if $X$ is a sufficient conditioning set).

The partially linear regression model (PLM) is
\[ Y = \beta T + g(X) + \epsilon \qquad \E[ \epsilon | T , X ] = 0; \]
the confounders $X$ have an additive, but nonlinear effect.

If $\tilde Y$ and $\tilde T$ are the residualized $Y$ and $T$ wrt $X$,
then $\beta$ is the coefficient of the linear model
$\tilde Y \sim \tilde T$;
it is given by the first order condition
$\E \bigl[ ( \tilde Y - \beta \tilde T ) \tilde T \bigr] = 0$.
\[ \beta = \E[ \tilde T^2 ]^{-1} \E[ \tilde T \tilde Y ] \]

To precent overfitting, \d{Double ML} (DML)
uses \emph{cross-fitted residuals}:
for observations in fold $k$,
$\tilde Y$ and $\tilde T$ are estimated from models fitted without fold $k$

To reduce bias, if you have several models to predict $T$ and $Y$,
use the best ones by looking at the CVMSE.
\[
\begin{tikzpicture}[>=stealth,xscale=3,yscale=1,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node[rounded corners=2mm,inner sep = 2pt, draw,align=center,densely dotted] (T) at (0,0) {gun\\ownership};
  \node[rounded corners=2mm,inner sep = 2pt, draw,align=center] (X) at (1.1,1) {country\\characteristics};
  \node[rounded corners=2mm,inner sep = 2pt, draw] (Y) at (2,0) {\# murders};
  \node[rounded corners=2mm,inner sep = 2pt, draw] (P) at (0,-1) {\# suicides};
  \draw[->] (X) -- (T);
  \draw[->] (X) -- (P);
  \draw[->] (T) -- (P);
  \draw[->] (T) -- (Y);
  \node[above=0mm of X] {\footnotesize\color{gray}$X$};
  \node[above=0mm of T] {\footnotesize\color{gray}$T$};
  \node[above=0mm of Y] {\footnotesize\color{gray}$Y$};
  \node[below=0mm of P] {\footnotesize\color{gray}proxy for $T$};
\end{tikzpicture}
\]

In the \emph{interactive regression model} (IRM)
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (X) at (1,1) {$X$};
  \node (Y) at (2,0) {$Y$};
  \draw[->] (X) -- (T);
  \draw[->] (X) -- (Y);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\qquad
\begin{aligned}
  T &= m(X) + \tilde T  && \E[ \tilde T | X ] = 0 \\
  Y &= g(T,X) + \epsilon && \E[ \epsilon | T,X] = 0 
\end{aligned}
\]
the treatment is not additively separable,
but it is binary.
To estimate the averate treatment effect
\[ \theta = \E \bigl[ g(1,X) - g(0,X) \bigr] . \]
combine regression adjustment
\[ \hat\theta = \E \bigl[ g(1,X) - g(0,X) \bigr] \]
and propensity score reweighting
\begin{align*}
  \hat\theta &= \E[ Y H ] \\
  H &= \dfrac{ \mathbf1(T=1) }{ m(X) } - \dfrac{ \mathbf1(T=0) }{ 1 - m(X) }
\end{align*}
(Horvitz-Thompson transformation):
this is the \emph{doubly robust parametrization}
\[ \hat \theta = \E \bigl[
  g(1,X) - g(0,X) + \bigl( Y - g(T,X) \bigr) H \bigr]. \]

Propensity scores close to 0 or 1 are problematic: they lead to very large values of $H$.
\[
\begin{tikzpicture}[>=stealth,xscale=5,yscale=1.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[align=center,rounded corners=2mm, inner sep = 2pt, draw, densely dotted] (A) at (0,1) {Firm\\characteristics};
  \node[align=center] (B) at (1,1) {Worker\\characteristics};
  \node (C) at (0,0) {401k eligibility};
  \node[align=center] (D) at (1,0) {Financial\\assets};
  \draw[->] (A) -- (C);
  \draw[->] (B) -- (C);
  \draw[->] (B) -- (D);
  \draw[->,very thick,blue!70!black] (C) -- (D);  
  \draw[->] ([yshift=1pt]A.east) to node[anchor=south]{\footnotesize hiring} ([yshift=1pt]B.west);
  \draw[->] ([yshift=-1pt]B.west) to node[anchor=north]{\footnotesize applying} ([yshift=-1pt]A.east);
\end{tikzpicture}
\]

More generally, \d{double machine learning} (DML)
uses a \emph{score} function
\[
M(\theta, \eta) = \E \bigl[
  \tikzmarknode{psi}{\psi}
  (
  \tikzmarknode{W}{W}
  ;
  \tikzmarknode{theta}{\theta}
  ,
  \tikzmarknode{eta}{\eta}
  ) \bigr]
\vrule height 1.6cm depth 2.1cm width 0pt
\begin{tikzpicture}[>=stealth, overlay, remember picture]
  \node (psi-b)   [align=center, font=\footnotesize, below= 10mm of psi  ]{score\\function};
  \node (W-b)     [align=center, font=\footnotesize, above=  3mm of W    ]{data};
  \node (theta-b) [align=center, font=\footnotesize, below= 3mm of theta]{parameters\\of interest};
  \node (eta-b)   [align=center, font=\footnotesize, above= 8mm of eta  ]{nuisance\\parameters};
  \draw[->,shorten >=2pt] (psi-b) -- (psi);
  \draw[->,shorten >=2pt] (W-b) -- (W);
  \draw[->,shorten >=2pt] (theta-b) -- (theta);
  \draw[->,shorten >=2pt] (eta-b) -- (eta);
\end{tikzpicture}
\]
\[ M(\theta, \eta_0 ) = 0 \iff \theta = \theta_0 \]
satisfying the \emph{Neyman orthogonality condition}
\[ \left. \dfrac{ \partial M(\theta_0 , \eta ) }{ \partial \eta } \right|_{ \eta = \eta_0 } = 0 \]
\ie, $\hat\theta$ is insensitive to small perturbations of $\eta$ around $\eta_0$:
we can use $\hat \eta$ instead
(from a good machine learning model:
lasso, post-lasso,
$\ell^1$-penalized neural net, random forest,
or ensemble of these).
For instance, for the partially linear model (PLM)
\begin{align*}
  \psi &= ( \tilde Y - \theta \tilde T ) \tilde T \\
  &= \bigl[ Y - \ell(X) - \theta \bigl( T - m(X) \bigr) \bigr] \bigl( T - m(x) \bigr) \\
  \eta &= (\ell, m) \ \text{ nuisance parameters;}
\end{align*}
to estimate the ATE in the IRM
\begin{align*}
  \psi &= \bigl[ g(1,X) - g(0,X) \bigr] + H \bigl[ Y - g(T,X) \bigr] - \theta \\
  H &= \dfrac{ T }{ m(X) } - \dfrac{ 1 - T }{ 1 - m(X) } \\
  \eta &= (g, m)
\end{align*}
(and similar score functions for the GATE or the ATET).

Use \emph{sample splitting}: estimate $\hat \eta_k$ on data without the $k$th fold,
then estimate $\hat\theta$ using $\hat\eta_k$ for  for observations in the $k$th fold;
you can also get an estimator of $\var \hat\theta$
and confidence intervals.

% 11. Dimension reduction: PCA , auto-encoders (AE) and embeddings

\textbf{12a.}
We can measure the impact of a non-observed confounder:
\[
\begin{tikzpicture}[>=stealth,scale=1,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (X) at (0,1) {$X$};
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$A$};
  \node (T) at (0,0) {$T$};
  \node (Y) at (1,0) {$Y$\rlap{;}};
  \draw[->] (X) -- (A);
  \draw[->] (X) -- (Y);
  \draw[->] (X) -- (T);
  \draw[->] (A) to node[pos=.35,anchor=south,font=\footnotesize,inner sep=1pt]{$\gamma$} (T);
  \draw[->] (A) to node[anchor=west, font=\footnotesize]{$\delta$} (Y);
  \draw[->] (T) to node[anchor=north,font=\footnotesize]{$\alpha$} (Y);
\end{tikzpicture}
\]
first, remove the effect of the observed confounders $X$
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$\tilde A$};
  \node (T) at (0,0) {$\tilde T$};
  \node (Y) at (2,0) {$\tilde Y$};
  \draw[->] (A) to node[pos=.75,anchor=south,font=\footnotesize,inner sep=2pt]{$\gamma$} (T);
  \draw[->] (A) to node[pos=.75,anchor=south,font=\footnotesize,inner sep=2pt]{$\delta$} (Y);
  \draw[->] (T) to node[anchor=north,font=\footnotesize]{$\alpha$} (Y);
\end{tikzpicture}
\]
then, project $\tilde Y$ on $\tilde T$ to get
\begin{align*}
  \beta &= \E[ \tilde Y \tilde D ] / \E[ \tilde D ^2 ] = \alpha + \phi \\
  \phi &= \dfrac{ \delta \gamma }{ \gamma^2 + \var [ \epsilon_T ] } =
  \text{omitted confounder bias.}
\end{align*}

Assumptions on the size of $\delta$ and $\gamma$ give bounds
on $\phi$
(alternatively, you can make assumptions on the $R^2$ of those models).

\textbf{12b.}
In presence of an \d{instrumental variable} (IV)
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=.8,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$A$};
  \node (T) at (1,0) {$T$};
  \node (Y) at (2,0) {$Y$};
  \node (Z) at (0,0) {$Z$};
  \node (X) at (0,1) {$X$};  
  \draw[->] (Z) to node[anchor=north,font=\footnotesize]{$\beta$} (T);
  \draw[->] (T) to node[anchor=north,font=\footnotesize]{$\alpha$} (Y);
  \draw[->] (X) -- (Z);
  \draw[->] (X) -- (Y);
  \draw[->] (X) -- (Y);
  \draw[->] (A) -- (T);
  \draw[->] (A) -- (Y);
\end{tikzpicture}
\]
the effect $\alpha$ of the treatment $T$
on the outcome $Y$ is identifiable
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$\tilde A$};
  \node (T) at (1,0) {$\tilde T$};
  \node (Y) at (2,0) {$\tilde Y$};
  \node (Z) at (0,0) {$\tilde Z$};
  \draw[->] (Z) to node[anchor=north,font=\footnotesize]{$\beta$} (T);
  \draw[->] (T) to node[anchor=north,font=\footnotesize]{$\alpha$} (Y);
  \draw[->] (A) -- (T);
  \draw[->] (A) -- (Y);
\end{tikzpicture}
\]
e.g., with the score
$\psi = ( \tilde Y - \alpha \tilde T ) \tilde Z $,
leading to
\[ \alpha = \dfrac{ \E[ \tilde Y \tilde Z ] }{ \E[ \tilde T \tilde Z ] } \]
(double machine learning is applicable)
or directly, by estimating $\beta \alpha$ and $\beta$:
\begin{align*}
  \beta\alpha &= \dfrac{ \E[ \tilde Y \tilde Z ] }{ \E[ \tilde Z ^2 ] } \\
  \beta       &= \dfrac{ \E[ \tilde T \tilde Z ] }{ \E[ \tilde Z ^2 ] } \\
  \beta\alpha &= \dfrac{ \beta\alpha}{ \beta } = \dfrac{ \E[ \tilde Y \tilde Z ] }{ \E[ \tilde T \tilde Z ] }.
\end{align*}
(Some of this can be generalized to non-linear IV models.)

\textbf{12c.} \emph{Proxies} of unobserved confounders can also help.
\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$A$};
  \node (Q) at (0,1)  {$Q$};
  \node (S) at (2,1)  {$S$};
  \node (T) at (0,0)  {$T$};
  \node (Y) at (2,0)  {$Y$};
  \node (X) at (1,-1) {$X$};
  \draw[->] (A) -- (Q);
  \draw[->] (A) -- (S);
  \draw[->] (A) -- (T);
  \draw[->] (A) -- (Y);
  \draw[->] (Q) -- (T);
  \draw[->] (S) -- (Y);
  \draw[->] (T) -- (Y);
  \draw[->] (X) -- (T);
  \draw[->] (X) -- (Q);
  \draw[->] (X) -- (A);
  \draw[->] (X) -- (S);
  \draw[->] (X) -- (Y);
\end{tikzpicture}
\qquad\qquad
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[circle,draw,densely dotted,inner sep=1pt] (A) at (1,1) {$\tilde A$};
  \node (Q) at (0,1)  {$\tilde Q$};
  \node (S) at (2,1)  {$\tilde S$};
  \node (T) at (0,0)  {$\tilde T$};
  \node (Y) at (2,0)  {$\tilde Y$};
  \draw[->] (A) -- (Q);
  \draw[->] (A) -- (S);
  \draw[->] (A) -- (T);
  \draw[->] (A) -- (Y);
  \draw[->] (Q) -- (T);
  \draw[->] (S) -- (Y);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\]

% Not clear (p. 333)

\textbf{13.} With \emph{weak instruments}
\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node (Z) at (0,0)  {$\tilde Z$};
  \node (T) at (1,0)  {$\tilde T$};
  \node (Y) at (2,0)  {$\tilde Y$};
  \draw[->] (Z) -- (T);
  \draw[->] (T) to node[anchor=south,inner sep=1pt]{\footnotesize$\alpha$} (Y);
\end{tikzpicture}
\]
\[ \hat\alpha = \dfrac{ \E[ \tilde Z \tilde Y ] }{ \E[ \tilde Z \tilde T ] }, \quad \E[ \tilde Z \tilde T ] \approx 0 , \]
use \emph{Neyman's statistic}
\[ C(\alpha) = \dfrac{
  \E \bigl[ ( \tilde Y - \alpha \tilde T ) \tilde Z \bigr] ^2
}{
  \var \bigl[ ( \tilde Y - \alpha \tilde T ) \tilde Z \bigr]
} \sim N(0,1) ^2 = \chi^2(1)
\]
to test for $H_0 : \alpha = \alpha_0$
and derive confidence intervals.
This generalizes to other score functions $\psi$;
in dimension $m$:
\begin{align*}
  M(\theta) &= \E \bigl[ \psi( W, \theta, \hat\eta ) \bigr] \\
  \Omega(\theta) &= \var \bigl[ \psi( W, \theta, \hat\eta) \bigr] \\
  C(\theta) &= M(\theta) ' \Omega(\theta)^{-1} M(\theta) \sim \chi^2(m)
\end{align*}

\textbf{14.}
``Heterogeneous treatment effects'' refers to the CATE, as opposed to the ATE.
\begin{align*}
  \text{ATE} &= \E[ Y^{(1)} - Y^{(0)} ] \\
  \text{CATE} &= \E[ Y^{(1)} - Y^{(0)} | X = x ] \\
\end{align*}
DML works out of the box:
\begin{compactitem}[--]
\item For models $\hat\mu$ and $\hat g$ to estimate
  \begin{align*}
    \mu(Z) &= P[ T=1 | Z ] \\
    g(Y,Z) &= \E[ Y | T, Z ]
  \end{align*}
\item Set
  \begin{align*}
    \hat Y_i &= H_1 \bigl( Y_1 - \hat g_k(T_i,Z_i) \bigr) + \hat g_k(1,Z_i) - \hat g_k(0,Z_i) \\
    H_i &= \dfrac{ T_1 }{ \hat \mu_k ( Z_i ) } - \dfrac{ 1 - T_i }{ 1 - \hat \mu_k(Z_i) }
  \end{align*}
  where $\hat g_k$, $\hat \mu_k$ are estimated without the fold containing $i$;
\item Regress (linearly, if you want confidence intervals)
  $\hat Y \sim X$.
\end{compactitem}

To get valid confidence intervals with random forests, use \emph{honest forests}:
\begin{compactitem}[--]
\item Use a separate sample to build the tree and to compute the leaf estimates; 
\item Use smaller subsamples, without replacement, instead of boostrap samples.
\end{compactitem}

% Difference with causal forests?

Alternatively, one can look for a \emph{policy}
$\pi: X \mapsto \pi(X) \in [0,1]$
indicating who to treat, maximizing
\[ V(\pi) = \E \bigl[ \pi(X) \bigl( Y^{(1)} - Y^{(0)} \bigr]. \]
This does not give a full picture of treatment heterogeneity:
if the effects are all negative,
$\pi = 0$.
Instead, one can look for a quantile-constrained optimal policy
\[ \operatorname*{Maximize}_\pi \E \bigl[  \pi(X) \bigl( Y^{(1)} - Y^{(0)} \bigr]
\ \text{ st } \ \E \bigl[ \pi(X) \bigr] = q. \]

\textbf{15.} \emph{Meta learning} decomposes the CATE estimation into a sequence of regression problems.
\begin{compactitem}[--]
\item S (single) learner
  \begin{align*}
    \hat g(T,Z) &\approx \E[ Y | T, Z ] \\
    \hat \tau (X) &\approx \E\bigl[ \hat g(1,Z) - \hat g(0,Z) | X \bigr] 
  \end{align*}
\item T (two) learner
  \begin{align*}
    \hat g_1(Z) &\approx \E[ Y | Z, T=1] \\
    \hat g_0(Z) &\approx \E[ Y | Z, T=0 ] \\
    \hat \tau (X) &\approx \E\bigl[ \hat g_1(Z) - \hat g_0(Z) | X ]
  \end{align*}
\item DR (double robust)
  \begin{align*}
    \hat g_1(Z) &\approx \E[ Y | Z, T=1] \\
    \hat g_0(Z) &\approx \E[ Y | Z, T=0 ] \\
    \hat \mu(Z) &\approx \E[ T | Z ] \\
    \hat g(T,Z) &= \hat g_1(Z) T + \hat g_0(Z) (1-T) \\
    H &= \dfrac{ T }{ \hat \mu(Z) } - \dfrac{ 1 - T }{ 1 - \hat \mu(Z) } \\
    \hat Y &= H \bigl( Y - \hat g(T,Z) \bigr) + \hat g_1(Z) - \hat g_0(Z) \\
    \hat\tau(X) &\approx \E[ \hat Y | X ]
  \end{align*}
\item R-learner
  \begin{align*}
    \hat h(Z) &\approx \E[ Y | Z ] \\
    \hat \mu(Z) &\approx \E[ T | Z ] \\
    \check Y &= Y - \hat h(Z) \\
    \check T &= T - \hat \mu(Z) \\
    \hat\tau(X) &= \dfrac{ \E[ \check T ^2 \cdot \check Y / \check T | X ] }{ \E[ \check T ^2 | X ] }
  \end{align*}
  ($\hat\tau$ is a regression $\check Y / \check T \sim X$, with weights $\check T^2$);
\item X-learner
  \begin{align*}
    \hat g_1(Z) &\approx \E[ Y | Z, T=1] \\
    \hat g_0(Z) &\approx \E[ Y | Z, T=0 ] \\
    \hat \mu(Z) &\approx \E[ T | Z ] \\
    \hat\delta_0(Z) &\approx \E[ g_1(Z) - Y | Z, T=0 ] \\
    \hat\delta_1(Z) &\approx \E[ g_0(Z) - Y | Z, T=1 ] \\
    \hat\delta(Z) &= \delta_1(Z) \bigl( 1 - \hat\mu(Z) \bigr) + \delta_0(Z) \hat\mu(Z) \\
    \hat\tau(X) &\approx \E[ \hat\delta(Z) | X ].
  \end{align*}
\end{compactitem}
Which model is best depends on the data
(imbalance, how complicated $\hat g$ and $\hat \mu$ are, etc.) --
try cross-validation and ensembling.

The optimal (unconstrained) policy only looks at the sign of the CATE
\[ \pi^* (X) = \mathbf{1}_{ \tau(X) \geq 0 } \]
but the misclassification cost is sample-dependent:
it is a cost-sensitive classification problem.
You may need to penalize the variance of the policy.

\textbf{16.}
With longitudinal data, under the conditional parallel trends assumption
(parallel trends for $T=0$ and $T=1$, once we condition on $Z$),
DML (double/debiased machine learning)
can compute the ATET (DiD, difference in differences).

\textbf{17.}
If the treatment is assigned (deterministically) by some score
$T = \mathbf{1}_{ X \geq c}$
(as in regression discontinuity design, RDD),
observations close to the threshold are comparable.
\begin{align*}
  \tau_{\text{RD}} &= \E\bigl[ Y(1) - Y(0) | X = c ] \\
  &= \lim_{ x \to c^+ } \E[ Y | X = x ] - \lim_{ x \to c^- } \E[ Y | X = x ] 
\end{align*}

\nextbook
\begin{book}
  \emph{DAG-GNN: DAG structure learning\\ with graph neural networks}\\
  Y. Yu et al. (2019)
\end{book}
One can sample from the linear structural causal model
$ X = AX + Z$, $Z \sim N(0,I)$ as
\[ X = (I-A)^{-1} Z , \quad Z \sim N(0,I). \]
This can be made nonlinear
\[ X = f_2 \bigl[ (I-A)^{-1} f_1(Z) \bigr] , \quad Z \sim N(o,I)  \]
and $f_1$, $f_2$ can be learned as an autoencoder
\begin{align*}
  X &= f_2 \bigl[ (I-A)^{-1} f_1(Z) \bigr] && \text{decoder} \\
  Z &= f_4 \bigl[ (I-A) f_2(Z) \bigr] && \text{encoder}.
\end{align*}
The paper uses a VAE.

\nextbook
\begin{book}
  \emph{Gradient-based neural DAG learning }\\
  S. Lachapelle et al.
\end{book}
NOTEARS solves the optimization problem
\[ \operatorname*{Minimize}_U \operatorname*{Mean}_U \n{ X - XU }_{F}^2 + \lambda \n U _1 \text{ st } \operatorname{Tr} e^{ U \odot U } = d . \]
GraNDAG replaces the linear transformation $X \mapsto XU$ with a neural network,
and uses the neural network connectivity matrix
\[ C = \va{ W^{(L)} } \va{ W^{(L-1)} } \cdots \va{ W^{(1)} } \]
(where $\va W$ is the element-wise absolute value) for the constraint.

\nextbook
\begin{book}
  \emph{CAM: Causal additive models,\\ high-dimensional order search\\ and penalized regression}\\
  P. P\"uhlmann et al. (2014)
\end{book}
CAM is a nonlinear score-based causal discovery algorithm
which first looks for a topological order,
and only then, the causal graph:
\begin{compactitem}[--]
\item If there are too many variables (>30), select 10 candidate parents for each node with GAM boosting
  (preliminary neighbourhood selection);
\item Build a complete DAG with unpenalized GES,
  adding the edge improving the sum of squared residuals (of a GAM) the most;
\item Prune the DAG by looking at the $p$-values of the GAM terms
  (keep those with $p<10^{-3}$).
\end{compactitem}

\nextbook
\begin{book}
  \emph{A\!* Lasso for learning a sparse Bayesian network structure for continuous variables}\\
  J. Xiang and S. Kim
\end{book}
GES is a greedy algorithm to find the DAG with the best score.
Exhaustive search is unreasonable: there are too many DAGs.
But the score is decomposable: the search can be formulated as a shortest path problem
in the subset lattice
(the value of a subset is the best score attainable with the variables in that subset)
which can be solved with dynamic programming.
The lasso loss gives a consistent A\!* heuristic.

\nextbook
\begin{book}
  \emph{A graph autoencoder approach\\ to causal structure learning}\\
  I. Ng et al. (2019)
\end{book}
NOTEARS is linear:
\[ \operatorname*{Minimize}_A \operatorname*{Mean}_i \n{ X_i - A X_i }^2 + \lambda \n A _1 \text{ st } \operatorname{Tr} e^{ A \odot A } = d ; \]
cGAN generalizes it to nonlinear relations
%\[ \operatorname*{Minimize}_A \operatorname*{Mean}_i \n{ X_i - g_2 \bigl( A g_1 (X_i) \bigr)  }^2 + \lambda \n A _1 \text{ st } \operatorname{Tr} e^{ A \odot A } = d \]
\[ \begin{array}{ll}
  \text{Find} & A \\
  \text{To minimize} & \operatorname*{Mean}_i \n{ X_i - g_2 \bigl( A g_1 (X_i) \bigr)  }^2 + \lambda \n A _1 \\[3pt]
  \text{Such that} & \operatorname{Tr} e^{ A \odot A} = d
\end{array} \]
where $g_1$ and $g_2$ are pointwise.

\nextbook
\begin{book}
  \emph{Masked gradient-based\\ causal structure learning}\\
  I. Ng et al. (2022)
\end{book}
MCSL combines NOTEARS and the Gumbel softmax approach to learn the binary adjacency matrix of a nonlinear structural model
\[ X_i = g_i ( A_{\bigcdot i } \odot X ) + \epsilon_1 \]

\nextbook
\begin{book}
  \emph{Ordering-based causal discovery\\ with reinforcement learning}\\
  X. Wang et al.
\end{book}
Use reinforcement learning to find, not directly the DAG,
but just a topological order compatible with it
(there are much fewer orders than DAGs):
\begin{compactitem}[--]
\item State: embedding of the latest variable selected;
\item Action: variable to add;
\item Reward: BIC improvement; 
\item Encoder: $\RR^{n\times d} \to \RR^{n \times d}$ (self-attention);
\item Decoder: LSTM;
\item Optimization: policy gradient, actor critic.
\end{compactitem}
Pretrain on simulated data; fine-tune on the data of interest.
\[ \text{BIC} = \sum_{jk} \log p\bigl( x_{jk} | \text{Pa}(x_{jk}); \theta_j \bigr) - \dfrac{ \va{ \theta_j } }2 \log m \]

\nextbook
\begin{book}
  \emph{Causal discovery with reinforcement learning}\\
  S. Zhu et al.
\end{book}
Score-based causal discovery algorithms, such as GES, are greedy -- finding the best DAG is NP-hard.
Reinforcement learning is an alternative to greedy, exhaustive or random walk search:
\begin{compactitem}[--]
\item State: solution; 
\item Action: new (nearby) solution;
\item Reward: score improvement.
\end{compactitem}
(You may need to tweak the reward to help the system learn, and you may want to look into variants of reinforcement learning optimizing
$\max_t R_t$ instead of $\sum_t \delta^t R_t$ -- \emph{risk-seeking reinforcement learning}.)
Here, the approach is slightly different:
\begin{compactitem}[--]
\item State: bootstrap sample; 
\item Action: DAG;
\item Reward: $\text{score} + \lambda_1 \mathbf 1_{ \text{DAG} } + \lambda_2 \text{NOTEARS}$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Estimation of a structural vector autoregression model using non-Gaussianity}\\
  A. Hyv\"arinen et al.
\end{book}
The VAR model is
\[ X_t = \sum_{ k = 1 }^m B_k X_{t-k} + \epsilon_t . \]
The VAR-LiNGAM model also allows for contemporaneous effects, $B_0$, provided they are acyclic and the noise $\epsilon_t$ is non-Gaussian.
\[ X_t = \sum_{ k = 0 }^m B_k X_{t-k} + \epsilon_t  \]

\nextbook
\begin{book}
  \emph{The evolving causal structure\\ of equity risk factors}\\
  G. D'Acunto et al. (2021)
\end{book}
VAR-LiNGAM, on a moving window, on 11 equity risk factors, with the \texttt{lingam} Python package.

%%%%%%%%% Causality

\nextbook
\begin{book}
  \emph{Causal inference in R workshop}\\
\end{book}
To estimate causation from observational data
with a known causal graph
(no unmeasured confounders, and $\forall x \ P[ T=1 | X=x ] \neq 0, 1$),
one can: 
\begin{compactitem}[--]
\item Adjust for confounders;
\item Fit a propensity model $T \sim X$,
  and use inverse propensity weights (IPW), e.g.,
  \[ w_{\text{ATE}} = \dfrac{ T_i }{ p_i } - \dfrac{ 1 - T_i }{ 1 - p_i } \]
  (there are other similar formulas for ATT, ATC, ATM, ATO, etc.);
\item Use the propensity score to match treated and control samples (\texttt{MatchIt}).
\end{compactitem}
These are estimators of the same quantity.
Use the bootstrap for the confidence intervals
(after reweighting or matching, the observations are no longer independent).

Correlation is sometimes causation (RCT, A/B testing),
but even in these cases,
you may want to adjust for the confounders or use IPW:
the resulting estimators are more efficient.
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.7,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]  
  \node (T) at (0,0) {$T$};
  \node (X) at (1,1) {$X$};
  \node (Y) at (2,0) {$Y$};
  \draw[->] (X) -- (T);
  \draw[->] (T) -- (Y);
\end{tikzpicture}
\]

To graphically assess the propensity scores:
\begin{compactitem}[--] 
\item Histogram of the propensity scores for $T=0$ and $T=1$,
  before and after reweighting; 
\item ``Love plot'', $i \sim \text{smd}_i$,
  before and after reweighting, where the standardized mean difference (smd) for variable $i$ is
  \[ \text{smd} = \dfrac{ \bar x_{ T=1 } - \bar x_{ T = 0 } }{ \sqrt{
      \dfrac{ s^2_{T=1} + s^2_{T=0} }2
    } }
  \]
\item ecdf, and weighted acdf.
\end{compactitem}

\emph{G-computation} (G-formula),
\begin{compactitem}[--]
\item Fits a model $y \sim T + X$;
\item Computes $\widehat{ \text{ATE} } = \left. \hat y \right|_{T=1} - \left. \hat y \right|_{T=0}$
  (using the model on copies of the data with $T:=0$, resp, $T:=1$, for all the observations)
\end{compactitem}

For continuous exposures, one can:
\begin{compactitem}[--]
\item Fit a linear model $T \sim X$ and convert the residuals into probabilities
  \[ p = \phi \biggl( \dfrac{ T - \hat T }{ \hat \sigma } \biggr) \]
\item or bin $T$ into quantiles and use IPW.
\end{compactitem}

\emph{Tipping point sensitivity analysis} (\texttt{tipr}) quantifies
unmeasured confoundedness.

To address \emph{selection bias},
fit a probability of censoring model,
and use inverse probabilities as weights (multiply the probabilities, if you have several such models).
\[
\begin{tikzpicture}[>=stealth,xscale=2,yscale=1,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[align=center] (A) at (.2,2) {New HIV drug};
  \node[align=center] (B) at (1,1) {Symptoms};
  \node[align=center] (C) at (1.8,2) {Underlying\\ HIV severity};
  \node[align=center] (D) at (3,2) {CD4 count\mathstrut};
  \node[align=center,draw=blue!70!black, inner sep=2pt] (E) at (1,0) {loss to followup};
  \draw[->] (A) -- (B);
  \draw[->] (C) -- (B);
  \draw[->] (C) -- (D);
  \draw[->] (B) -- (E);
  \draw[->,color=blue!50!black] (A) to[out=40,in=140] node[anchor=south,inner sep=1pt,font=\footnotesize\color{blue!50!black}] {relation of interest} (D);
  \node[right=1mm of E,align=left,font=\footnotesize\color{blue!50!black}] {we condition\\on a descendant of\\a collider};
\end{tikzpicture}
\]
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=1,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[align=center] (A) at (0,0) {Smoking};
  \node[align=center] (B) at (1,1) {Reckless\\behaviour};
  \node[align=center] (C) at (2,0) {Broken\\bones};
  \node[align=center,draw=blue!70!black, inner sep=2pt] (D) at (3,-1) {Hospitalization};
  \node[align=center] (E) at (4,0) {Glioma};
  \draw[->] (B) -- (A);
  \draw[->] (B) -- (C);
  \draw[->] (C) -- (D);
  \draw[->] (E) -- (D);
  \node[right=1mm of D,align=left,font=\footnotesize\color{blue!50!black}] {we condition\\on a collider};
  \draw[->,color=blue!50!black] (A) to[out=90,in=90,looseness=1.5] node[anchor=south,inner sep=1pt,font=\footnotesize\color{blue!50!black}] {relation of interest} (E);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Causality-inspired models\\for financial time series forecasting}\\
  D.C. Oliveira et al. 
\end{book}
Use causal discovery algorithms such as
\begin{compactitem}[--]
\item SeqICP (invariant causal prediction for sequential data):
  conditional on its parents $X$, the distribution of $Y$ does not depend on the environment or period,
  $Y \indep \text{time} \,|\, X$ or
  \[ Y_t | X_t, t \in I_i \overset{d}{=} Y_t | X_t, t \in I_2 \]
  (but it is overly conservative and tends to return $\operatorname{Pa} Y = \nothing$);
\item Granger causality;
\item VAR-LiNGAM;
\item Dynotears;
\item PCMCI (too slow -- their small example would require two weeks of computations).
\end{compactitem}
LiNGAM and Dynotears work better at forecasting monthly S\&P 500 returns from macroeconomic
variables (FRED-MD, a dataset of 107 macroeconomic variables, with intages, and recommended transformations
to make them stationary, updated monthly).

\nextbook
\begin{book}
  \emph{FRED-MD: a monthly database\\ for macroeconomic research}\\
  M.W. McCracken and S. Ng (2015)
\end{book}
Bry-Boschan on cumsum(PC$_i$), for $i=1,2,3,4$,
to detect regime changes. 

