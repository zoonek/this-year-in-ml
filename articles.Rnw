  \draw[->] (A2) -- (B3);
  \draw[->] (A3) -- (B4);
  \draw[->] (B1) -- (C1);
  \draw[->] (B2) -- (C2);
  \draw[->] (B3) -- (C3);
  \draw[->] (B1) -- (A1);
  \draw[->] (B2) -- (A2);
  \draw[->] (B3) -- (A3);
  \draw[->] (C1) -- (B2);
  \draw[->] (C2) -- (B3);
  \draw[->] (C3) -- (B4);
\end{tikzpicture}
\]

The graph recurrent attention network (GRAN)
also generates the rows one by one,
but each new row is computed by a GNN on the graph built so far.

\nextbook
\begin{book}
  \emph{NodePiece:\\ compositional and parameter-efficient\\ representations of large knowledge graphs}\\
  M. Galkin et al.
\end{book}
Node embeddings do not scale to very large networks:
we would have to learn and store the embedding of all the nodes.
Instead, select (a smaller number of) ``anchor'' nodes (at random),
whose preliminary embeddings will be learned,
and compute the embeddings of all the nodes on the fly, with a (learned) MLP,
taking as inputs the preliminary embeddings of the $k$ closest anchors,
their distances (numbers of hops),
and the features of the edges to/from that node.

\nextbook
\begin{book}
  \emph{Graphon pooling in graph neural networks}\\
  A. Parada-Mayorga et al. (2020)
\end{book}
Pooling, in graph neural networks (GNN), is often deterministic and arbitrary.
Instead, consider the input graph as a locally constant graphon and sample from it,
to have increasingly coarser approximations of the input graph.

There are two ways of sampling from a graphon $W:[0,1]^2\to[0,1]$:
either pick points at random $x_i \sim U(0,1)$ and link them with probabilities $W(x_i,x_j)$,
or randomly partition the interval $[0,1]$ into $\bigsqcup U_i$
and link nodes $i$ and $j$ with probability $\iint_{U_i \times U_j} W(x,y) dxdy / \va{U_i\times U_j}$;
use the latter.

\nextbook
\begin{book}
  \emph{DDG-DA: data distribution generation\\ for predictable concept drift adaptation}\\
  W. Li et al. (2022)
\end{book}
To deal with slow concept drift,
forecast the evolution of the data distribution to adapt the model.
% Python implementation available.

\nextbook
\begin{book}
  \emph{Conditional Sig-Wasserstein GANs\\ for time series generation}\\
  H. Ni
\end{book}
By analogy with the Wasserstein distance
\[ W_1(\mu, \nu) =
\sup_{\substack{ f : X \to \RR \\ \n f _{\text{Lip}} \leq 1 }}
\E_{ X \sim \mu } f(X) -
\E_{ X \sim \nu } f(X),
\]
define the signature-Wasserstein distance between (distributions on) time series
\begin{align*}
  \text{Sig-W}_1(\mu,\nu)
  &= \sup_{\substack{ L \text{ linear} \\ \n L _2 \leq 1 }}
  L \biggl( \E_{X\sim\mu} S(X) - \E_{X\sim\nu} S(X) \biggr) \\
  &= \n{ \E_{X\sim\mu} S(X) - \E_{X\sim\nu} S(X) }_2 \\
  &\approx \n{ \E_{X\sim\mu} S_M(X) - \E_{X\sim\nu} S_M(X) }_2
\end{align*}
(this is the MMD (maximum mean discrepancy) with the truncated signature $S_M$ as features).

For time series continuation,
$\E \bigl[ S( X_{>t} ) | X_{\leq t} \bigr]$
can be computed by linear regression
$ S( X_{>t} ) \sim  S( X_{\leq t} ) $.

Use as a discriminator, with generator:
\[
\begin{tikzpicture}[>=stealth,scale=1,inner sep=0pt,outer sep=1pt,baseline=0,
  %every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
