\[
\begin{pmatrix} \tilde x_A \\ \tilde x_B \end{pmatrix} = 
\begin{pmatrix} \alpha_{AA} & \alpha_{AB} \\ \alpha_{BA} & \alpha_{BB} \end{pmatrix} 
\begin{pmatrix} x_A \\ x_B \end{pmatrix} 
