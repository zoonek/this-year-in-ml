\nextbook
\begin{book}
  \emph{DIGRAC: Digraph clustering\\ based on flow imbalance}\\
  Y. He et al.
\end{book}
DMPA finds clusters in a directed graph,
assuming that the directionality contains relevant information:
identify the clusters from the imbalance between them.
\[
\begin{tikzpicture}[>=stealth,scale=1,inner sep=3pt,outer sep=2pt,baseline=0]
  \node[fill=blue!20,rectangle, rounded corners] (A) at (0,1) {transient cluster};
  \node[fill=blue!20,rectangle, rounded corners] (B) at (0,0) {sink cluster};
  \draw[->] ([xshift=+0pt]A.south) -- ([xshift=+0pt]B.north);
  \draw[->] ([xshift=-6pt]A.south) -- ([xshift=-6pt]B.north);
  \draw[->] ([xshift=+6pt]A.south) -- ([xshift=+6pt]B.north);
  \draw[->] ([xshift=-12pt]A.south) -- ([xshift=-12pt]B.north);
  \draw[->] ([xshift=+12pt]A.south) -- ([xshift=+12pt]B.north);
  \draw[->] ([xshift=-18pt]A.south) -- ([xshift=-18pt]B.north);
  \draw[->] ([xshift=+18pt]A.south) -- ([xshift=+18pt]B.north);
  \draw[->] ([xshift=-24pt]A.south) -- ([xshift=-24pt]B.north);
  \draw[->] ([xshift=+24pt]A.south) -- ([xshift=+24pt]B.north);
\end{tikzpicture}
\]

\begin{align*}
  & n: \text{ number of nodes} \\
  & K: \text{ number of clusters} \\
  & P \in \RR^{ n \times k } : \text{ cluster membership} \\
  & W_{k\ell} = P^{\prime\strut}_{ \bigcdot k } A P^{\strut}_{ \bigcdot \ell} : \text{ probabilistic cut} \\
  & \va{ W_{k\ell} - W_{\ell k} } \text{: imbalance flow} \\
  & V_k = \bigl( \mathbf 1 ' ( A + A') P \bigr)_k \text{: volume} \\
  & C_{k\ell} = 2 \dfrac{ \va{ W_{k\ell} - W_{\ell k} } }{ V_k + V_\ell } \in [0,1] \\
  & \text{loss} = \operatorname*{Mean}_{ k < \ell } C_{k\ell} \\
  \text{or } & \text{loss} = \operatorname*{Top-\ensuremath{\beta}\,Mean}_{ k < \ell } C_{k\ell}  
  \text{ (with $\beta=1$ or 3)}
\end{align*}
Use a GNN to compute $P$.

\nextbook
\begin{book}
  \emph{MagNet: a neural network for directed graphs}\\
  X. Zhang et al.
\end{book}
Graph convolution assumes the graph is undirected.
For directed graphs, consider the magnetic Laplacian instead
(a complex Hermitian matrix, which depends on a parameter $q$).
\begin{align*}
  A_s &= \tfrac12 ( A + A' ) \\
  D_s &= \text{diag}( A_s \mathbf 1 ) \\
  \Theta^{(q)} &= 2\pi q ( A - A' ) \\
  H^{(q)} &= A_s \odot \exp( i \Theta ^{(q)} ) \text{ (element-wise)} \\
  L^{(q)} &= D_s - H^{(q)} \\
  \tilde L ^{(q)} &= I - ( D_s^{-1/2} A_s D_s^{-1/2} ) \odot \exp( i \Theta^{(q)} )
\end{align*}

\nextbook
\begin{book}
  \emph{Statistical inference\\ on random dot product graphs: a survey}\\
  A. Athreya et al. (2017)
\end{book}
The adjacency matrix of an \emph{independent-edge random graph} is
\[ A_{ij} \sim \text{Bernoulli}( P_{ij} ) \]
where $P \in [0,1] ^ { n \times n }$.

For a \emph{latent position} random graph,
$p_{ij} = \kappa(x_i,x_j)$,
$x_i \in \RR^d$, $\kappa: \RR^d \times \RR^d \to [0,1]$.

For a \emph{random dot product} graph, $\kappa(x,y) = x'y$, \ie, $P = X X'$.

For a \emph{stochastic block model} (SBM), $X$ has repeated rows.

The Erd\"os-R\'enyi graph is even simpler: $p_{ij}=p$ is constant.

The latent positions can be recovered by clustering the \emph{adjacency spectral embedding}.
\begin{align*}
  \hat X &= U_A S_A^{1/2} \\
  \va A &= ( A' A ) ^{ 1/2 } \\
  \va A &\approx U_A S_A U'_A \text{ truncated spectral decompositions}
\end{align*}
or the \emph{Laplacian spectral embedding}
\begin{align*}
  \breve X &= U_L S_L ^{1/2} \\
  \va L &\approx U_L S_L U'_L.
\end{align*}

\nextbook
\begin{book}
  \emph{Digraph inception convolutional networks}\\
  Z. Tong et al. (2020)
\end{book}
Spectral graph convolution (GCN)
assumes the graph is undirected.
\begin{align*}
  & X \longmapsto \hat A X \Theta \\
  & \tilde A = A + I \\
  & \tilde D = \text{diag} ( \tilde A \mathbf 1 ) \\
  & \hat A = \tilde D ^{-1/2} \tilde A \tilde D^{-1/2}
\end{align*}
For a directed graph, the page-rank Laplacian is dense,
because of the teleportaiton to arbitrary nodes.
\begin{align*}
  & P_{\text{rw}} = D^{-1} A \\
  & P_{\text{pr}} = ( 1 - \alpha )P_{\text{rw}} + \dfrac{ \alpha }{ n } \mathbf 1 _{ n \times n } \\
  & \pi_{\text{pr}} \text{: stationary distribution for $P_{\text{pr}}$ (unique if $\alpha \!\in\! (0,1)$)} \\
  & \Pi_{\text{pr}} = \text{diag}( \pi_{\text{pr}} ) \\
  & P_{\text{pr}} = I - \dfrac12 \bigl[ \Pi^{1/2} P \Pi^{-1/2} + \Pi^{-1/2} P' \Pi^{1/2} \bigr] 
\end{align*}
Instead, add a node, connected to all other nodes, and only teleport to it
(\ie, consider its personalized page rank)
\[ P_{\text{ppr}} = \begin{pmatrix}
  ( 1 - \alpha ) \tilde D ^{-1} \tilde A & \alpha \mathbf 1 \\
  \dfrac1n \mathbf 1' & 0 
\end{pmatrix}. \]

Multiscale directed graph convolution uses the $k$th order proximity matrix
\begin{align*}
  P_0 &= I \\
  P_1 &= \tilde D ^{-1} \tilde A \\
  P_{k+1} &= ( P_1 ) ^k ( P_1' )^k \inter ( P_1 '' )^k ( P_1 )^k.
\end{align*}

