  node[auto,right=-3pt,pos=.8,draw=none,rectangle,text width=2cm]
  {\footnotesize confounding\\[-1mm]\footnotesize association}
  (Y);
  \draw[dashed,very thick,red!80!black,->] (T) to[out=-30,in=-150,looseness=1]
  node[auto,below=1pt,pos=.5,draw=none,rectangle,text width=2cm]
  {\footnotesize causal\\[-1mm]\footnotesize association}
  (Y);  
\end{tikzpicture}
\]

% 4. Causal models
\textbf{4.} Causal quantities, such as
$P[ Y | \text{do}(T=t) ]$,
can be computed
\begin{compactitem}[--]
\item From the \d{structural causal model} (SCM)
  by replacing the equation for $T$ with $T=t$;
\item From the Bayesian network factorization,
  by setting the factor for $T$ to $\mathbf 1_{T=t}$;
\item From the causal graph, by cutting all edges into $T$
  (\d{manipulated graph}).
\end{compactitem}
It is sometimes possible to convert a causal quantity
(with the ``do'' operator)
into a statistical one, \ie, computable from observational data
(identification).
For instance, if $W$ satisfies the \d{backdoor criterion}
$ T \to Y $, \ie,
\begin{compactitem}[--]
\item $W$ blocks all backdoor (\ie, non-causal) paths from $T$ to $Y$;
\item $W$ does not contain any descendant of $T$,
\end{compactitem}
then, $W$ is a \d{sufficient adjustment set}:
\[ P[ Y | \text{do}(T=t) ] = \sum_w P[ Y, t, w] P[w] \]
(\emph{backdoor adjustment}).

Beware of \emph{$M$-bias}:
in the following graph, do not condition on $Z$ -- it opens a backdoor path.
% M-bias
\[
\begin{tikzpicture}[>=stealth,xscale=.8,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node[draw] (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[fill=black!25] (Z) at (1,1) {Z};
  \node (A) at (0,2) {};
  \node (B) at (2,2) {};
  \draw[->] (T) -- (Y);
  \draw[->] (B) -- (Y);
  \draw[->] (A) -- (T);
  \draw[->] (A) -- (Z);
  \draw[->] (B) -- (Z);
\end{tikzpicture}
\]

% 5. Randomized experiments
\textbf{5.} In \d{randomized experiments}, association is causation.
This can be seen by:
\begin{compactitem}[--]
\item Covariate balance: the treatment and the control groups are identical
  \[ P[X \,|\, T=1] \overset{\text{d}}{=} P[X \,|\, T=0] \]
\item Exchangeability (unconfoundedness)
  \begin{align*}
    E[ Y(1) \,|\, T=1 ] &= E[ Y(1) \,|\, T=0 ] \\
    E[ Y(0) \,|\, T=0 ] &= E[ Y(0) \,|\, T=1 ]
  \end{align*}
\item Absence of backdoor path, because $T$ has no incoming edges: $W=\nothing$ is a
  sufficient adjustment set.
\end{compactitem}

% 6. Non-parametric identification
\textbf{6.} Backdoor adjustment is sufficient but not necessary for identifiability.
For instance, in presence of unobserved confounders $W$,
% Front-door adjustment
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[dashed] (W) at (1,1) {W};
  \node (M) at (1,0) {M};
  \draw[->] (T) -- (M);
  \draw[->] (M) -- (Y);
  \draw[->] (W) -- (T);
  \draw[->] (W) -- (Y);
\end{tikzpicture}
\]

we may be able to use the \emph{frontdoor adjustment},
by separately computing the causal effects $T\to M$ and $M\to Y$,
and combining them.
\[ P[ Y | \text{do}(t) ] =  \sum_m P[m|t] \sum_t P[y|m,t'] P[t']. \]

The \d{do-calculus} gives a complete list of (3) transformations to identify causal quantities,
whenever possible.

% 7. Estimation
\textbf{7.} To estimate the ATE with a sufficient adjustment set $W$,
\begin{align*}
  \tau &= \E[ Y(1) - Y(0) ] \\
  &= \E\nolimits_W\bigl[ \E[Y\,|\,T=1,W] - \E[Y\,|\,T=1,W] \bigr]
\end{align*}
we can fit a statistical model to
\[ \mu(t,w) = \E[ Y \,|\, T=t , W=w ] \]
(conditional outcome modeling, COM),
or separate models to
\begin{align*}
  \mu_0(w) &= \E[ Y \,|\, T=0, W=w ] \\
  \mu_1(w) &= \E[ Y \,|\, T=1, W=w ]
\end{align*}
(grouped conditional outcome modeling, GCOM)
or with a neural net learning a representation of $w$ (TARNet).
\[
\hspace*{-3mm}
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.4,inner sep=1pt,outer sep=0pt,baseline=0]
  \node (t) at (-1,1) {$t$};
  \node (w) at (-1,-1) {$w$};
  \node[draw,thick,text width=1ex] (A) at (0,0) {\vrule height 3em width 0pt};
  \node[text width=1em] (m) at (1,0) {$\mu(t,w)$};
  \draw[->] (t.east) -- (A.west|-t.east);
  \draw[->] (w.east) -- (A.west|-w.east);
  \draw[->] (A) -- (m);  
  \node at (0,-2.5) {COM};
\end{tikzpicture}
\hspace*{9mm}
\begin{tikzpicture}[>=stealth,xscale=.9,yscale=.4,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em]
  \node (w) at (0,0) {$w$};
  \node[draw,thick] (A) at (1,1) {\strut};
  \node[draw,thick] (B) at (1,-1) {\strut};
  \node (m0) at (1.9,1) {$\mu(0,w)$};
  \node (m1) at (1.9,-1) {$\mu(1,w)$};
  \draw[->] (w) to[out=0,in=180] (A);
  \draw[->] (w) to[out=0,in=180] (B);
  \draw[->] (A) -- (m0);
  \draw[->] (B) -- (m1);
  \node at (1,-2.5) {GCOM};
\end{tikzpicture}
\hspace*{7mm}
\begin{tikzpicture}[>=stealth,xscale=.9,yscale=.4,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em]
  \node (w) at (-.8,0) {$w$};
  \node[draw,thick] (C) at (0,0) {\strut};
  \node[draw,thick] (A) at (1,1) {\strut};
  \node[draw,thick] (B) at (1,-1) {\strut};
  \node (m0) at (1.9,1) {$\mu(0,w)$};
  \node (m1) at (1.9,-1) {$\mu(1,w)$};
  \draw[->] (w) -- (C);
  \draw[->] (C) to[out=0,in=180] (A);
  \draw[->] (C) to[out=0,in=180] (B);
  \draw[->] (A) -- (m0);
  \draw[->] (B) -- (m1);
  \node at (1,-2.5) {TARNet};
\end{tikzpicture}
\]

The $X$-learner approach:
\begin{compactitem}[--]
\item Fits models $\hat \mu_0(x)$, $\hat \mu_1(x)$;
\item Fits models
  \begin{align*}
  \hat\tau_1(x) &= Y(1) - \hat\mu_0(x), \\
  \hat\tau_0(x) &= \hat\mu_1(x) - Y(0);
  \end{align*}
\item Combines them
  \[ \hat \tau g(x) \hat \tau_0(x) + \bigl(1-g(x)\bigr) \hat\tau_1(x) \]
  for some $g : \mathscr X \to [0,1]$, e.g., the propensity score, or $1/2$, or 0, or 1.
\end{compactitem}

The conditioning set $W$ can be high-dimensional,
but it can be replaced with the (1-dimensional)
\emph{propensity score}
\( e(w) = P[ T=1 | W=w ] \):
\[ Y(0), Y(1) \indep  W \implies Y(0) , Y(1) \indep e(W). \]
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[fill=black!25] (W) at (1,1) {W};
  \draw[->] (T) -- (Y);
  \draw[->] (W) -- (T);
  \draw[->] (W) -- (Y);
\end{tikzpicture}
\qquad
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=1.6,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[fill=black!25] (W) at (1,1) {W};
  \node[ellipse,text width=2em] (e) at (.5,.5) {$\!e(W)$};
  \draw[->] (T) -- (Y);
  \draw[->] (W) -- (e);
  \draw[->] (e) -- (T);
  \draw[->] (W) -- (Y);
\end{tikzpicture}
\]

In particular,
\[ \E[ Y(t) ] = \E\left[ \dfrac{ \mathbf1_{T=t} \cdot Y }{ P[t|W] } \right]. \]

The propensity score is unknown, but can be estimated, leading to the
\emph{inverse propensity weighting} (IPW) estimator
\[ \hat \tau =
\operatorname*{Mean}_{i\ :\ t_i=1}
\dfrac{ y_i }{ \hat e(w_i) } -
\operatorname*{Mean}_{i\ :\ t_i=0}
\dfrac{ y_i }{ 1 - \hat e(w_i) }
\]
(to trade variance for bias, trim the propensity scores $\hat e$ to $[\epsilon,1-\epsilon]$).

Other methods include:
\begin{compactitem}[--]
\item Doubly robust methods, which model both $\mu(t,w)$ and $e(w)$;
\item Matching;
\item Double machine learning:
  \[ \text{res}( Y \sim W ) \sim \text{res}( T \sim W ) ; \]
\item Causal trees and forests.
\end{compactitem}

For confidence intervals, use the bootstrap.

% 8, Bounds and sensitivity analysis
\textbf{8.} The \emph{observational-counterfactual decomposition} of the ATE
\begin{align*}
  \tau &= \E[ T(1) - Y(0) ] \\
  &= P[T=1] \E[Y|T=1] + P[T=0] \E[Y(1) | T=0] \\
  &\hphantom{={}}
  - P[T=1] \E[ T(0) | T=1 ] + P[T=0] \E[Y|T=0]
\end{align*}
gives \d{bounds} on $\tau$,
(rather large but) finer if we make more assumptions, such as:
\begin{compactitem}[--]
\item Monotone treatment response:
  $\forall i \ Y_i(1) \geq Y_i(0);$ 
\item Monotone treatment selection
  \begin{align*}
    \E[ Y(1) | T=1 ] &\geq \E[ Y(1) | T=0 ] \\
    \E[ Y(0) | T=1 ] &\geq \E[ Y(0) | T=0 ];
  \end{align*}
\item Optimal treatment selection
  \begin{align*}
    Y_i = 1 &\implies Y_i(1) \geq Y_i(0) \\
    Y_i = 0 &\implies Y_i(0) \geq Y_i(1).
  \end{align*}
\end{compactitem}

\d{Sensitivity analysis} examines the question
``how strong should the effect of an unobserved confounder $W$ on $T$ and $Y$ be
for the causal effect of $T$ on $Y$ to drop below some threshold''
(as a contour plot, causal effect $\sim$ confounding effects).
\[
\begin{tikzpicture}[>=stealth,xscale=.7,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[dashed] (W) at (1,1) {W};
  \draw[->] (T) -- (Y);
  \draw[->] (W) -- (T);
  \draw[->] (W) -- (Y);
\end{tikzpicture}
\]

% 7. Instrumental variables
\textbf{7.} \d{Instrumental variables} allow identification in presence
of unobserved counfounders,
but they require parametric assumptions.
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node[dashed] (W) at (1,1) {W};
  \node (Z) at (0,1) {Z};
  \draw[->] (T) -- node[below=0pt,draw=none]{$\delta$} (Y);
  \draw[->] (W) -- (T);
  \draw[->] (W) -- (Y);
  \draw[->] (Z) -- node[left=0pt,draw=none]{$\alpha$} (T);
\end{tikzpicture}
\]

For instance, if the structural equations are linear,
we can measure $\alpha$ and $\alpha\delta$
and use the \emph{Wald estimand}
\[
\delta = \dfrac{
  \E[ Y \,|\, Z = 1 ] - \E[Y \,|\, Z=0]
}{
  \E[T \,|\, Z=1] - \E[T \,|\, Z=0]
}.
\]
In the continuous linear setting,
\[ \delta = \dfrac{ \cov(Y,Z) }{ \cov(T,Z) }; \]
it can also be estimated with \emph{2-stage least squares} (2sls)
\[ \text{lm}\bigl( Y \sim \text{predict}(T\sim Z) \bigr). \]

If the instrument is an encouragement to take the treatment, we can stratify the population into
\begin{compactitem}[--]
\item Compliers: $T=Z$;
\item Always-takers: $T=1$;
\item Always deniers: $T=0$;
\item Defiers: $T = \neg Z$.
\end{compactitem}
If there are no defiers (\emph{monotonicity}),
we can compute the \emph{complier average causal effect},
non-parametrically,
still with the Wald estimand.
\begin{align*}
  \text{CACE} &= \E\bigl[
    Y(1) - Y(0) \,|\, T(1) = 1 , T(0) = 0
    \bigr] \\
  &= \dfrac{
    \E[Y\,|\,Z=1] - \E[Y\,|\,Z=0]
  }{
    \E[T\,|\,Z=1] - \E[T\,|\,Z=0]
  }
\end{align*}

% 10. Difference in differences
\textbf{10.}
Adding a time dimension
% Difference-in-difference
\[
\begin{tikzpicture}[>=stealth,xscale=.6,yscale=.5,inner sep=1pt,outer sep=0pt,baseline=0,thick]
  \node[anchor=east] (C) at (0,1) {Control\ };
  \node[anchor=east] (T) at (0,0) {Treatment\ };
  \draw[->] (C) -- (4.3,1);
  \draw[->] (T) -- (4.3,0);
  \draw (1,1.2) -- (1,.8);
  \draw (3,1.2) -- (3,.8);
  \draw (1,0.2) -- (1,-.2);
  \draw (3,0.2) -- (3,-.2);
  \node[anchor=south,inner sep=4pt] at (1,1) {$t=0$};
  \node[anchor=south,inner sep=4pt] at (3,1) {$t=1$};
  \node[anchor=west] at (4.3,1) {time};
\end{tikzpicture}
\]
and making the \emph{parallel trends assumptions}
\[ Y_1(0) - Y_0(0) \indep T, \]
the \emph{average treatment effect on the treated} (ATT)
can be estimated with the \d{difference-in-differences}
\begin{align*}
  \text{ATT}
  &= \E\bigl[ Y_1(1) - Y_0(0) | T = 1 \bigr] \\
  &= \E[Y_1-Y_0|T=1] - \E[Y_1-Y_0|T=0].
\end{align*}
(But the parallel trends assumption is not stable under
data transformations, e.g., log.)

% 11. Causal discovery from obvservational data
\textbf{11.}
Conditional independence and $d$-separation are equivalent is the graph
is Markov and \emph{faithful} to the probability distribution.
\[
\begin{tikzpicture}[>=stealth,xscale=2,yscale=1,inner sep=1pt,outer sep=0pt,baseline=0]
  \node[anchor=east] (A) at (0,0) {$d$-separation};
  \node[anchor=west] (B) at (1,0) {Conditional independence};
  \draw[->]  ([yshift=+2pt]A.east) -- node[anchor=south,inner sep=3pt]{\footnotesize Markov} ([yshift=+2pt]B.west);  
  \draw[->]  ([yshift=-2pt]B.west) -- node[anchor=north,inner sep=3pt]{\footnotesize faithfulness} ([yshift=-2pt]A.east);  
\end{tikzpicture}
\]

Faithfulness is not always possible: some effects could cancel out.
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=1,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (A) at (1,2) {A};
  \node (B) at (0,1) {B};
  \node (C) at (2,1) {C};
  \node (D) at (1,0) {D};
  \begin{scope}[text width={}]
  \draw[->] (A) -- node[draw=none,pos=.4,left=0pt]{$\alpha$} (B);
  \draw[->] (A) -- node[draw=none,pos=.4,right=0pt]{$\gamma$} (C);
  \draw[->] (B) -- node[draw=none,pos=.6,left=0pt]{$\beta$}(D);
  \draw[->] (C) -- node[draw=none,pos=.6,right=0pt]{$\delta$} (D);
  \end{scope}
  \node[draw=none] at (5,1) {$\rightsquigarrow$};
  \node (a) at (8,2) {A};
  \node (d) at (8,0) {D};
  \draw[->] (a) -- node[right=0pt,draw=none,text width={}]{$\alpha\beta+\gamma\delta=0$} (d);
\end{tikzpicture}
\]

Two graphs are \emph{Markov equivalent}
iff they have the same \emph{skeleton}
and immoralities.

The \d{PC algorithm} identifies the Markov equivalence class of a probability distribution:
\begin{compactitem}[--]
\item Find the skeleton, with conditional independence tests;
\item Find the immoralities, with conditional independence tests;
\item Orient the remaining edges, whenever possible, assuming we have detected all the immoralities.
\end{compactitem}
In the linear Gaussian setting, we cannot distinguish
between $A\to B$ and $A \leftarrow B$,
but in the \begin{compactitem}[--]
\item Linear, non-Gaussian noise,
\item Or nonlinear, additive noise
\end{compactitem}
settings, we can.

% Causal discovery from interventions
\textbf{12.}
While it is not possible to identify the essential graph
$A$---$B$, it is possible with \d{interventions}.
For instance, an intervention on $B$ gives
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (A) at (0,0) {A};
  \node (B) at (1,0) {B};
  \draw[->] (A) -- (B);
  \node[draw=none] at (2,0) {$\rightsquigarrow$};
  \begin{scope}[shift={(3,0)}]
  \node (A) at (0,0) {A};
  \node (B) at (1,0) {B};
  \node (I) at (.5,1) {I};
  \draw[->] (I) -- (B);
  \end{scope}
  \node[anchor=west,text width={},draw=none] at (5,0) {$A \indep B$};

  \begin{scope}[shift={(0,-2)}]
  \node (A) at (0,0) {A};
  \node (B) at (1,0) {B};
  \draw[->] (B) -- (A);
  \node[draw=none] at (2,0) {$\rightsquigarrow$};
  \begin{scope}[shift={(3,0)}]
  \node (A) at (0,0) {A};
  \node (B) at (1,0) {B};
  \node (I) at (.5,1) {I};
  \draw[->] (I) -- (B);
  \draw[->] (B) -- (A);
  \end{scope}
  \node[anchor=west,text width={},draw=none] at (5,0) {$A \,\not\!\indep B$.};
  \end{scope}
\end{tikzpicture}
\]

For $n\geq3$, $n-1$ 1-node interventions are sufficient.
For multinode interventions,
$\lfloor \log_2 n \rfloor + 1$, or $\lceil \log_2 c \rceil$
are sufficient (and necessary, in the worst case),
where $c$ is the size of the largest clique,
if you already know the essential graph.

There are similar results for parametric interventions, \ie,
if we change $P[X_i | \text{pa}_i]$ instead of removing pa$_i$.

% Transfer learning and transportability
\textbf{13.}
\d{Covariate shift} refers to the situation where the distribution of $(x,y)$
changes between training and testing,
but that of $y|x$ remains. More generally, let us assume that the distribution of $x$ changes
e.g., through some (possibly unknown) intervention,
but the causal structure remains.
Without intervention, we can predict $Y$ from its 
\emph{Markov blanket} (parents, children, lovers),
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.8,inner sep=1pt,outer sep=1pt,baseline=0, text width=1.5ex,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node[text width=1em] (Y) at (4,2) {Y};
  \node[fill=red!50] (A) at (3,3) {};
  \node[fill=red!50] (B) at (5,3) {};
  \node[fill=green!50] (C) at (2,2) {};
  \node[fill=blue!50] (D) at (3,1) {};
  \node[fill=blue!50] (E) at (5,1) {};
  \node[fill=green!50] (F) at (6,2) {};
  \draw[->] (A) -- (Y);
  \draw[->] (B) -- (Y);
  \draw[->] (Y) -- (D);
  \draw[->] (Y) -- (E);
  \draw[->] (C) -- (D);
  \draw[->] (F) -- (E);
  \node (A1) at (2,4) {};
  \node (A2) at (1,3) {};
  \node (B1) at (6,4) {};
  \node (B2) at (7,3) {};
  \draw[->] (A1) -- (A);
  \draw[->] (A) -- (A2);
  \draw[->] (B1) -- (B);
  \draw[->] (B) -- (B2);
  \node (D1) at (3,0) {};
  \node (E1) at (5,0) {};
  \draw[->] (D) -- (D1);
  \draw[->] (E) -- (E1);
  \node (C1) at (0,2) {};
  \node (C2) at (1,1) {};
  \node (F1) at (8,2) {};
  \node (F2) at (7,1) {};
  \draw[->] (C1) -- (C);
  \draw[->] (C) -- (C2);
  \draw[->] (F1) -- (F);
  \draw[->] (F) -- (F2);  
\end{tikzpicture}
\]
but with intervention, we should only use the \emph{causal parents} of $Y$.

To study the \emph{transportability} of causal effects across populations,
add a ``selection node'' to indicate which nodes have their causal mechanism changed.
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0, text width=1em,
    every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node (T) at (0,0) {T};
  \node (Y) at (2,0) {Y};
  \node (X) at (1,1) {X};
  \node[rectangle] (S) at (1,2) {S\mathstrut};
  \draw[->] (T) -- (Y);
  \draw[->] (X) -- (Y);
  \draw[->] (X) -- (T);
  \draw[->] (S) -- (X);
\end{tikzpicture}
\]

% Counterfactuals and mediation
\textbf{14.}
\d{Counterfactuals}, such as
$P[ Y(t) | T=t', Y=y ]$,
can be computed from a structural causal model,
but they cannot be written with the do operation, or obtained from observations.

For instance, $ Y := UT + (1-U)(1-T)$,
where
\begin{align*}
  Y=1 &\quad\text{happy} \\
  T=1 &\quad\text{get a dog} \\
  U=1 &\quad\text{dog person.}
\end{align*}
If we observe $T=0$, $Y=0$,
we can compute $U$ (\emph{abduction}),
modify the SCM by setting $T:=t$, and compute $Y(t)$.
If $Y=f(U)$ is not invertible, use a prior on $U$ to get a
\emph{probabilistic counterfactual}.

While unit-level counterfactuals require and SCM,
\emph{population-level counterfactuals}
$E[Y(t) | T=t']$ can be computed as the CATE
(``potential outcome calculus'' generalizes do-calculus).

\nextbook
\begin{book}
  \emph{Causal inference: what if}\\
  M.A. Hern\'an and J.M. Robins (2020)
\end{book}
% Too much text: prefer B. Neal's book

\nextbook
\begin{book}
  \emph{DoWhy: an end-to-end library\\ for causal inference}\\
  A. Sharma and E. Kiciman
\end{book}
Causal inference requires 4 steps:
\begin{compactitem}[--]
\item Provide the causal graph and specify the ``treatment'' and ``outcome'' variables;
\item Identify the ATE (average treatment effect), \ie, convert the causal estimand
  $\E[ Y | \text{do}(X=x) ]$ into a statistical estimand
  (\ie, something computable from observational data): backdoor criterion, frontdoor criterion, instrumental variables, etc.
\item Compute the ATE (propensity score, linear regression, 2-stage least squares, etc.)
\item Robustness tests:
  \begin{compactitem}[\ensuremath{\cdot}]
  \item Add a ranfom variable;
  \item Replace the treatment with a random variable (placebo), or the outcome;
  \item Use a subset of the data;
  \item Add an unmeasured common cause.
  \end{compactitem}
\end{compactitem}

\nextbook
\begin{book}
  \emph{Approximate kernel-based\\ conditional independence tests\\ for fast non-parametric causal discovery}\\
  E.V. Strobl and S. Visweswaran
\end{book}
Replace $X$, $Y$, $Z$ with random Fourier features and define
$\Sigma_{XY\cdot Z} = \Sigma_{XY} - \Sigma_{XZ} \Sigma_{ZZ}^{-1} \Sigma_{ZY}$;
then
$\Sigma_{XY \cdot Z} = 0$ iff $ X \indep Y | Z$.

R implementation in \texttt{RCIT}.

\nextbook
\begin{book}
  \emph{Learning functional causal models\\ with generative neural networks}\\
  O. Goudet et al. 
\end{book}
The causal generative neural network (CGNN) builds a functional causal model (FCM)
by combining
\begin{compactitem}[--]
\item A global approach, selecting a (small number of)
  CPDAG(s)
\item And a local approach (explaining the asymmetry between $Y=f(X)$ and $X=f(Y)$ --
  one is often simpler than the other),
  fitting models of the form
  $X_i = f( \text{pa}_i, E_i )$
  where $f$ is a shallow network and the $E_i$'s are independent noises
  selecting the best generative model by looking at the maximum mean discrepandy (MMD)
  \begin{align*}
  \text{MMD}( \mathscr D, \hat{\mathscr D} ) &=
  \dfrac1{n^2} \sum_{ij} k( x_i, x_j ) +
  \dfrac1{n^2} \sum_{ij} k( \hat x_i , \hat x_j ) \\
  &\hphantom{={}}
  - \dfrac1{n^2} \sum_{ij} k( x_i , \hat x_j )
  \end{align*}
  for some kernel $k$ (e.g., Gaussian).
\end{compactitem}
\[
