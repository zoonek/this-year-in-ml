  >=stealth,yscale=.7,xscale=2
]
\draw[very thick] (-0.5,0.25)--(-0.45,0.2025)--(-0.4,0.16)--(-0.35,0.1225)--(-0.3,0.09)--(-0.25,0.0625)--(-0.2,0.04)--(-0.15,0.0225)--(-0.1,0.01)--(-0.05,0.0025)--(0,0)--(0.05,0.0025)--(0.1,0.01)--(0.15,0.0225)--(0.2,0.04)--(0.25,0.0625)--(0.3,0.09)--(0.35,0.1225)--(0.4,0.16)--(0.45,0.2025)--(0.5,0.25)--(0.55,0.3025)--(0.6,0.36)--(0.65,0.4225)--(0.7,0.49)--(0.75,0.5625)--(0.8,0.64)--(0.85,0.7225)--(0.9,0.81)--(0.95,0.9025)--(1,1)--(1.05,1.1025)--(1.1,1.21)--(1.15,1.3225)--(1.2,1.44)--(1.25,1.5625)--(1.3,1.69)--(1.35,1.8225)--(1.4,1.96)--(1.45,2.1025)--(1.5,2.25);
