\nextbook
\begin{book}
  \emph{Clifford neural layers for PDE modeling}\\
  J. Brandsetter et al. (2023)
\end{book}
To solve PDEs involving ``correlated fields''
(e.g., a scalar field and a vector field: temperature and wind speed),
model them jointly, as a multivector, and use Clifford convolutions and Clifford layers.
  
\nextbook
\begin{book}
  \emph{Deep learning for solving and estimating dynamic macro-finance models}\\
  B. Fan et al.
\end{book}
To solve a PDE
\[ \left\{
\begin{array}{ll}
  f_\theta(x, u, Du) = 0 & x \in \Omega \\
  B(x, u) = 0 & x \in \partial \Omega
\end{array}
\right. \]
train a neural net to minimize
\[ \sum_{ x \in T_f } \n{ f_\theta }^2 + \sum_{z \in T_b} \n{ B }^2 \]
(PINN: physically-informed neural net).
One can add other conditions
\[ I(u,x) = 0 \ \ c \in I \subset \Omega \]
and learn the PDE parameters $\theta$ as well.

Application to dynamic equilibrium models of the financial sector.
% Most of the paper describes these models
Implementation with \texttt{DeepXDE}.
% Code available
  
\nextbook
\begin{book}
  \emph{Nowcasting with signature methods}\\
  S.N. Cohen et al. (2023)
\end{book}
The Kalman filter can be expressed as a regression on signature transform features
(involving only linear features).

Use the signature transform features $\psi$ (on a moving window),
which allow for irregular sampling, for nowcasting.
\[ y_t = \sum_k ( \alpha_k + \beta_k y_{t-} ) \psi_{k,t} + \epsilon_t \]
where $y_{t-}$ is the previous value.
Add an elasticnet penalty, and standardize the features
(otherwise, they decrease factorially fast).

Implementation in \texttt{SigNow}; also check \texttt{esig}, \texttt{iisignature},
\texttt{signatory}.
  
\nextbook
\begin{book}
  \emph{A new approach to decomposition of economic time series into permanent and transitory components with particular attention to measurement of the `business cycle'}\\
  S. Beveridge and C.R. Nelson
\end{book}
A stochastic process $X$, with stationary MA($\infty$) increments
$\Delta X = \psi(L) \epsilon$,
can be decomposed into a stochastic trend (a random walk: its increments are independent)
\begin{align*}
  \text{Trend}_t &= \lim_{s\to\infty} \E [ X_{t+1} | \mathscr F_t ] \\
  &= \psi(1) \sum_{ s \leq t } \epsilon_s
\end{align*}
and a cycle component.
\begin{align*}
  (1-L) X &= \psi(L) \epsilon \\
  &= \psi(1) \epsilon + \bigl[ \psi(L) - \psi(1) \bigr] \epsilon
\end{align*}

\nextbook
\begin{book}
  \emph{A unified approach for jointly estimating\\ the business and financial cycle\\ and the role of financial factors}\\
  T. Berger et al. (2022)
\end{book}
The Beveridge-Nelson decomposition of a VAR(1) process
$\Delta X_t = A \Delta X_{t-1} + \epsilon_t$
is
\begin{align*}
  \text{Trend}_y &= \lim_{s\to\infty} \E [ X_{t+1} | \mathscr F_t ] \\
  &= X_t + A (I-A)^{-1} \Delta X_t.
\end{align*}
  
\nextbook
\begin{book}
  \emph{Trend-cycle decompositions}\\
  E. Zivot (2005)
\end{book}
In the MA($\infty$) representation of an ARIMA$(p,1,q)$ process
\begin{align*}
  \phi(L) \Delta X &= \theta(L) \epsilon && \text{ARMA} \\
  \Delta X &= \psi(L) \epsilon && \text{MA}(\infty)
\end{align*}
$\psi(1)$ is the permanent effect of a shock $\epsilon_t$
on the level of $X_t$.

The Beveridge-Nelson trend is
\[ \text{Trend}_t = \text{Trend}_0 + \psi(1) \sum_{s=1}^t \epsilon_s . \]

The unobserved component model (UC-ARMA) is
\begin{align*}
  X_t &= \text{Trend}_t + \text{Cycle}_t \\
  \text{Trend}_t &= \mu + \text{Trend}_{t-1} + \epsilon_t  & \epsilon_t &\sim N(0,\Sigma) \\
  \phi(L) \text{Cycle} &= \theta(L) \eta & \eta_t &\sim N(0,S).
\end{align*}
If the cycle is a stationary AR process, \ie, $\theta(L)=1$,
and the roots of $\phi$ are outside the uinit circle
(and $\epsilon \indep \eta$), it can be written as a state space model
\[
\left[\!\!\!  
