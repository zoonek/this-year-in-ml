}
\longrightarrow
\underset{\text{\footnotesize flow}}{%
\begin{tikzpicture}[>=stealth,xscale=.3, yscale=1,inner sep=1pt, outer sep=1pt,baseline=10pt]
\draw[thick]
(-2.5,0.001)--(-2.45,0.001)--(-2.4,0.002)--(-2.35,0.002)--(-2.3,0.003)--(-2.25,0.004)--(-2.2,0.006)--(-2.15,0.008)--(-2.1,0.01)--(-2.05,0.013)--(-2,0.016)--(-1.95,0.02)--(-1.9,0.025)--(-1.85,0.031)--(-1.8,0.038)--(-1.75,0.047)--(-1.7,0.057)--(-1.65,0.068)--(-1.6,0.081)--(-1.55,0.095)--(-1.5,0.111)--(-1.45,0.129)--(-1.4,0.148)--(-1.35,0.169)--(-1.3,0.192)--(-1.25,0.216)--(-1.2,0.241)--(-1.15,0.267)--(-1.1,0.295)--(-1.05,0.322)--(-1,0.35)--(-0.95,0.378)--(-0.9,0.406)--(-0.85,0.433)--(-0.8,0.459)--(-0.75,0.484)--(-0.7,0.508)--(-0.65,0.531)--(-0.6,0.552)--(-0.55,0.571)--(-0.5,0.589)--(-0.45,0.606)--(-0.4,0.62)--(-0.35,0.633)--(-0.3,0.645)--(-0.25,0.655)--(-0.2,0.664)--(-0.15,0.672)--(-0.1,0.679)--(-0.05,0.685)--(0,0.691)--(0.05,0.696)--(0.1,0.701)--(0.15,0.706)--(0.2,0.711)--(0.25,0.716)--(0.3,0.721)--(0.35,0.727)--(0.4,0.733)--(0.45,0.739)--(0.5,0.747)--(0.55,0.755)--(0.6,0.763)--(0.65,0.772)--(0.7,0.782)--(0.75,0.792)--(0.8,0.803)--(0.85,0.815)--(0.9,0.826)--(0.95,0.838)--(1,0.85)--(1.05,0.862)--(1.1,0.874)--(1.15,0.885)--(1.2,0.897)--(1.25,0.907)--(1.3,0.918)--(1.35,0.927)--(1.4,0.936)--(1.45,0.945)--(1.5,0.952)--(1.55,0.959)--(1.6,0.965)--(1.65,0.971)--(1.7,0.976)--(1.75,0.98)--(1.8,0.984)--(1.85,0.987)--(1.9,0.989)--(1.95,0.991)--(2,0.993)--(2.05,0.995)--(2.1,0.996)--(2.15,0.997)--(2.2,0.998)--(2.25,0.998)--(2.3,0.999)--(2.35,0.999)--(2.4,0.999)--(2.45,0.999)--(2.5,1);
