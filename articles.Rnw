\nextbook
\begin{book}
  \emph{Risk bounds on aleatoric uncertainty recovery}\\
  Y. Zhang et al. (2023)
\end{book}
To estimate the variance in heteroskedastic regression
\begin{align*}
  Y &= \mu(X) + \epsilon(X) \\
  \mu(X) &= \E[ Y | X = x ] \\
  \sigma^2(x) &= \var[ Y | X = x ]
\end{align*}
use the Gaussian negative log-likelihood
\[ \sum_i \log \sigma^2(x_i) + \dfrac{ \bigl( y_i - \mu(x_i) \bigr)^2 }{ \sigma_i^2 (x_i) } \]
or the generalized method of moments (GMM)
\[ \sum \bigl[ \sigma^2(x_i) - \bigl( y - \mu(x_i) \bigr)^2 \bigr]^2 \]
or a Gaussian process
\begin{align*}
  g &\sim \text{GP} \qquad\text{(prior)} \\
  \sigma^2(x) &= \exp g(x).
\end{align*}

\nextbook
\begin{book}
  \emph{Never mind the metrics --\\ what about the uncertainty?
  Visualizing confusion matrix metric distributions}\\
  D. Lovell et al.
\end{book}
Exhaustive list of performance metrics;
in particular, you should also report balanced accuracy (BA) and the Matthews correlation coefficient (MCC).
\begin{align*}
  \text{BA} &= \dfrac{ \text{TPR} + \text{TNR} }{ 2 } \\
  \phi = \text{MCC} &= \dfrac{ \text{TP} \cdot \text{TN} - \text{FP} \cdot \text{FN} }{
    \sqrt{ \hat p p n \hat n } } \\
  p &= \text{TP} + \text{FN} \\
  n &= \text{FP} + \text{TN} \\
  \hat p &= \text{TP} + \text{FP} \\
  \hat n &= \text{FN} + \text{TN} \\
  \text{TPR} &= \text{TP} / p \\
  \text{TNR} &= \text{TN} / n
\end{align*}
Plot both the ROC and precision-recall curves.
Show, in the background, all possible confusion matrices (as a grid)
with the same size $N$ and prevalence $P/N$ (proportion of positives),
coloured with MCC or BA (you can also add the MCC level curves).

\nextbook
\begin{book}
  \emph{Fisher-Rao distance\\ between multivariate normal distributions:\\ special cases, bounds and applications}\\
  J. Pinele et al. (2020)
\end{book}
There is no known closed formula for the Fisher-Rao distance between Gaussians in general,
but there is one in many special cases.
For instance, when the mean is the same:
\[ d\bigl( (\mu,\Sigma_1) , (\mu,\Sigma_2) \bigr) =
\sqrt{ \tfrac12 \sum ( \log \lambda_i )^2 }
\]
where the $\lambda_i$ are the eigenvalues of $\Sigma_1^{-1/2} \Sigma_2 \Sigma_1^{-1/2}$,
\ie, the generalized eigenvalues of $(\Sigma_1,\Sigma_2)$.
  
\nextbook
\begin{book}
  \emph{Trust region methods\\ on Riemannian manifolds}\\
  P.A. Absil et al.
\end{book}
\emph{Trust region methods}, to minimize $f : \RR^n \to \RR$,
iteratively solve (e.g., with \emph{truncated conjugate gradient})
\[ \operatorname*{Minimize}_{
  \eta \in \RR^n
  ,\
  \n \eta \leq \Delta
}
\underbrace{
  f(x) + f'(x) \eta + \tfrac12 \eta' f''(x) \eta
}_{ m(\eta) },
\]
updating the radius $\Delta$ by looking at the quality of the approximation
\[ \rho = \dfrac{ f(x) - f(x+\eta) }{ m(0) - m(\eta) }, \]
e.g.,
\[ \begin{array}{ll}
  \rho \ll 1 & \text{discard the update and decrease $\Delta$} \\
  \rho < 1 & \text{decrease $\Delta$} \\
  \rho \approx 1 & \text{increase $\Delta$}.
\end{array} \]
It still works if $f''(x)$ is replaced by an approximation of the Hessian.

This generalizes to functions on a Riemannian manifold $f: M \to \RR$,
by using the exponential map $\exp_x : T_x M \to M$
or (since the exponential may be expensive to compute), a \emph{retraction}
\begin{align*}
  & R_x : T_xM \to M \\
  & R_x(0) = x \\
  & D R_x(0) = \text{Id}
\end{align*}
(no condition on the second derivative).

Examples include:
\begin{compactitem}[--]
\item $\operatorname*{Minimize}_{Q \in O_n} \text{trace}(Q'AQN)$,
  where $N = \text{diag}(1,2$,\break$\dots,n)$
  (this gives the eigenvectors of $A$, sorted)
  and we can replace $\exp \Omega$ with a product of Givens rotations;
\item The extreme eigenspace of $(A,B)$
  (the span of the $p$ generalized eigenvectors with the lowest eigenvalues)
  in $\text{Grass}(p,n) = \RR_*^{n\times p} / \text{GL}_p$,
  which is not naturally a submanifold of $\RR^N$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Pymanopt: a Python toolbox for optimization on manifolds using automatic differentiation}\\
  J. Townsend et al. (2016)
\end{book}
Example: find the best rank-$k$ positive semidefinite approximation
of a matrix for the \emph{pseudo-Huber loss} $H(x) = \sqrt{ x^2 + \delta^2 } - \delta$
(which is quadratic for small $x$ and $L^1$ for large $x$)
using a Riemannian trust region solver.

