  \node (P24) at (3,3) {};  
  \node (P31) at (2,0) {};
  \node (P32) at (2,1) {};
  \node (P33) at (2,2) {};
  \node (P34) at (2,3) {};
  \node (P41) at (1,0) {};
  \node (P42) at (1,1) {};
  \node (P43) at (1,2) {};
  \node (P44) at (1,3) {};    
  \node (P51) at (0,0) {};
  \node (P52) at (0,1) {};
  \node (P53) at (0,2) {};
  \node (P54) at (0,3) {};
  \draw[black!30] (P11) -- (P21) -- (P31) -- (P41) -- (P51);
  \draw[black!30] (P12) -- (P22) -- (P32) -- (P42) -- (P52);
  \draw[black!30] (P13) -- (P23) -- (P33) -- (P43) -- (P53);
  \draw[black!30] (P14) -- (P24) -- (P34) -- (P44) -- (P54);
  \draw[thick,->] (P11) -- (P21);
  \draw[thick,->] (P21) -- (P31);
