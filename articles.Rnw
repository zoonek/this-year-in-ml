\begin{book}
  \emph{Diffusion-LM\\ improves controllable text generation}\\
  X.L. Li et al.
\end{book}
Diffusion models can also generate text with a prescribed semantic contents
(or length, or sentence structure, etc.)
\[ \underset{\clap{\scriptsize\text{noise}}}{X_T} \to X_{T-1} \to \cdots \to
\underset{\substack{\clap{\scriptsize\text{word}}\\\clap{\scriptsize\text{vectors}}}}{X_0} \to \text{text} \]
  
\nextbook
\begin{book}
  \emph{Photorealistic text-to-image diffusion models with deep language understanding}\\
  C. Saharia et al. (2022)
\end{book}
Contrary to Dall-E, Imagen uses a very large language model (T5-XXL),
trained on text only, frozen;
it fine-tunes the result with two efficient U-Net steps.
It uses dynamic thresholding to avoid fully-saturated pixels.

Drawbench is a benchmark for text-to-imge generation (list of prompts, challenging for various reasons).

\nextbook
\begin{book}
  \emph{GLIDE: Towards photorealistic\\ image generation and editing\\ with text-guided diffusion models}\\
  A. Nichol et al.
\end{book}
\emph{Diffusion models} are trained by progressively adding noise to an image $x_0$
\begin{align*}
  x_0 &\sim \text{Data} \\
  x_t | x_{t-1} &\sim N\bigl( \sqrt{ \alpha_t }  x_{t-1} , (1-\alpha_t) I \bigr)
\end{align*}
and trying to undo that process
\begin{align*}
  x_T &\sim N(0,I) \\
  x_{t-1} | x_t &\sim N\bigl( \mu_\theta(x_t) , \Sigma_\theta(x_t) \bigr)
\end{align*}
(with $\Sigma_\theta$ diagonal).
If $x_t = x_0 + \epsilon$, the loss tries to recover $\epsilon$
\[ \text{Loss} = \E_{\substack{
    t \sim \text{Unif} \llbracket 1 , T \rrbracket \\
    x_0 \sim \text{Data} \\
    \epsilon \sim N(0,1)
}}
\n{ \epsilon - \epsilon_\theta( x_t , t ) } ^2.
\]
\emph{Guided diffusion} increases the likelihood of a given class~$y$
\[ \hat \mu_\theta( x_t | y ) = \mu_\theta( x_t | y ) + s \cdot \Sigma_\theta ( x_t | y )
\nabla_{\! x_t}  \log p_\phi( y | x_t ). \]

\emph{Classifier-free guidance}
also moves the model away from a ``null label'' $\nothing$ (e.g., an empty prompt)
\[ \hat\epsilon( x_t | y ) =
\epsilon_t( x_t | \nothing ) + s \bigl(
  \epsilon_\theta(x_t|y) - \epsilon_\theta(x_t|\nothing)
\bigr) .
\]

\emph{CLIP-guidance} uses a joint representation of images $f$ and text $g$,
encouraging large fot products $f(x) \cdot g(c)$ for matching pairs (contrastive cross-entropy),
instead of a classifier
\[ \hat \mu_\theta(x_t|y) = \mu_\theta(x_t | y ) + s \cdot \Sigma_\theta( x_t | y ) \nabla_{\!x_t} f(x_t) \cdot g(c). \]

\nextbook
\begin{book}
  \emph{Denoising diffusion probabilistic models}\\
  J. Ho et al.
\end{book}
Initial paper on (unconditional) diffusion models for image generation.
\[ \mu_\theta = \dfrac1{\sqrt\alpha} \left( x - \dfrac{ \beta }{ \sqrt{ 1 - \alpha } } \epsilon_\theta \right) \]

\nextbook
\begin{book}
  \emph{Reverse-time stochastic differential equation for generative modeling}\\
  L. Winkler (2021)
  % Webpage
\end{book}
Given an SDE
\[ dX_t = \mu( X_t , t ) dt + \sigma( X_t , t ) dW, \]
use the Kolmogorov forward equation (KFE)
\[ \partial _t p(x_t) = - \partial_{ x_t } \bigl[ \mu(x_t) p(x_t) \bigr] + \dfrac12
\partial_{x_t}^2 \bigl[ \sigma^2(x_t) p(x_t) \bigr] \]
and the Kolmogorov backward equation ($t\leq s$)
\[ - \partial_t p(x_s|x_t) = \mu(x_t) \partial_{x_t} p(x_s|x_t) + \dfrac12
\sigma^2(x_t) \partial_{x_t}^2 p(x_s|x_t) \]
to derive a PDE for
$p(x_s,x_t) = p(x_s|x_t) p(x_t)$:
\begin{align*}
  - \partial_t p(x_s, x_t) &= \\
  & \hspace*{-1cm}  
  \partial_{x_t}
  \left[
  p(x_s,x_t)
  \left(
  \mu(x_t) - \dfrac{
    \partial_{x_t} \bigl[ \sigma^2(x_t) p(x_t) \bigr]
  }{
    p(x_t)
  }
  \right)
  \right]
  \\
  & \hspace*{-1cm}
  + \dfrac12 \partial_{x_t}^2 \bigl[ p(x_s,x_t) \sigma^2(x_t) \bigr].
\end{align*}
It is the KFE of a SDE.
If the noise $\sigma$ is independent of the input,
we can move it outside of the partial derivative,and we recognize the log-derivative of $p$, the score.
The final SDE is
\[ d \bar x_t = \bigl[ \mu(x_t) - \sigma_t^2 \partial_{x_t} \log p(x_t) \bigr] dt + \sigma_t d\bar W_t. \]

