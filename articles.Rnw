\begin{book}
  \emph{Neural architecture search\\ with reinforcement learning} \\
  B. Zoph and Q.V. Le (2016)
\end{book}

\nextbook
\begin{book}
  \emph{Visualizing the loss landscape of neural nets} \\
  H. Li et al. 
\end{book}
Plot the loss landscape of a neural net using one or two random directions in weight space, 
after \emph{filter normalization} (normalize the weights in each filter (or each layer, for non-CNNs) to make them comparable -- 
BatchNorm or ReLU units make the network scale-invariant).
\begin{compactitem}[--]
\item Small batch sizes lead to wider minima and better generalization;
\item The loss landscape has a central convex region around the minimum,
but is chaotic and non-convex beyond it -- it is important to initialize the network in the convex region;
\item Skip connections, small batches and wide networks (many filters) enlarge this region;
\item  The optimization path is very low-dimensional: use PCA rather than random dimensions to examine it.
\end{compactitem}
% 1 hour for a low-resolution plot with 4 GPUs...

\nextbook
\begin{book}
  \emph{Multi-dimensional graph Fourier transform} \\
  T. Kurokawa et al.
\end{book}
The \d{graph Fourier transform} (GFT)
decomposes a signal $f : V \to \RR$ 
on the eigenvectors of the Laplacian matrix $L = D - W$.
It can be generalized to \emph{cartesian product graphs}
(e.g., time series for sensor networks, which have space and time dimensions),
for which eigenvalues tend to be multiple: 
the eigenvalues (eigenvector) of the Kronecker sum $L_1 \oplus L_2$ are the sums (products) of those of $L_1$ and $L_2$.
It can be used, for instance, for signal filtering,
to remove some frequencies in some directions: 
\[ \hat f_{\text{out}} (\lambda_1, \lambda_2 ) = h(\lambda_1, \lambda_2 ) \hat f_{\text{in}} ( \lambda_1, \lambda_2 ). \]

\nextbook
\begin{book}
  \emph{PassGAN: a deep learning approach\\ for password guessing} \\
  B. Hitaj et al.
\end{book}
GAN to learn the distribution of real passwords from password leaks,
to replace or complement rule-based password crackers
(hashcat, johntheripper).

\nextbook
\begin{book}
  \emph{WESPE: Weakly supervised photo enhancer for digital cameras}\\
  A. Ignatov et al.
\end{book}
GAN-based style transfer for photo enhancement, trained with highly liked Flickr images.

\nextbook
\begin{book}
  \emph{Multi-dimensional sparse super-resolution} \\
  C. Poon and G. Peyr\'e (2017)
\end{book}

The \d{total variation norm} of a measure $\mu$,
\[
  \sup_{\substack{
    \eta \in \mathscr C(X) \\
    \n{ \eta }_{ L^\infty } \leq 1
  }}
  \int_X \eta(x) \, d\mu(x)
\]
generalizes the $\ell^1$ and $L^1$ norms of vectors and functions.
The corresponding penalty (BLASSO) can be used for \emph{sparse superresolution},
\ie, to recover (position and amplitude of) spikes.

\nextbook
\begin{book}
  \emph{StarGAN:\\ unified generative adversarial networks\\ for multi-domain image-to-image translation} \\
  Y. Choi et al.
\end{book}
To translate images between domains (gender, hair colour, mood, age, etc.),
use a single (conditional) generator
$G : (\text{image}, \text{domain}) \longmapsto \text{image}$,
separate discriminators for the source and target domains, 
and a cycle loss to preserve image contents.

Datasets: CelebA (40 labels), RaFD (8 labels).

\nextbook
\begin{book}
  \emph{DeblurGAN: blind motion deblurring using conditional adversarial networks} \\
  O. Kupyn et al. 
\end{book}
To remove motion blur, use a Wasserstein \d{conditional GAN}
% Conditional GAN
\[
\begin{tikzpicture}[>=stealth,yscale=.6,xscale=1,inner sep = 2pt,outer sep = 0pt]
\node[anchor=west] at (-2,2) {\footnotesize Dataset 1};
\node[anchor=west] at (-2,1) {\footnotesize Noise};
\node[anchor=west] at (-2,0) {\footnotesize Dataset 2};
