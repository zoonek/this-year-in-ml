  \node (K) at (2,0) [annotation] {};
  \node (L) at (4,0) [annotation] {};
  \draw (A) -- (B) -- (C) -- (F) -- (E) -- (D) -- (A);
  \draw (B) -- (E);
  \draw (D) -- (J);
  \draw (A) -- (G);
  \draw (E) -- (K);
  \draw (B) -- (H);
  \draw (F) -- (L);
  \draw (C) -- (I);
\end{tikzpicture}
$$
by pseudo-likelihood
$$
\begin{tikzpicture}[xscale=1.5]
