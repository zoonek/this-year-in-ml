      \draw (\k,\i) to [bend left=5] (\k,\j);
  \draw[thick] (\k-.1,-.5) -- (\k+.1,-.5) -- (\k+.1,2.5) -- (\k-.1,2.5) -- cycle;
  \draw[thick] (\k-.1,4.5) -- (\k+.1,4.5) -- (\k+.1,8.5) -- (\k-.1,8.5) -- cycle;
