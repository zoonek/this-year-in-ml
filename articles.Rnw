\draw[->] (B) -- (C);
\node at (1,1) {vs};
\node (A1) at (1.9,0) {\footnotesize \vphantom{y}$x$};
\node (A2) at (2.1,0) {\footnotesize $y$};
\node[draw, text width = 1em, inner sep = 4pt] (B1) at (2,1) {};
\node (C1) at (2,2) {\footnotesize $E(x,y)$ energy};
\draw[->] (A1.north) -- (B1.south -| A1.north);
\draw[->] (A2.north) -- (B1.south -| A2.north);
\draw[->] (B1) -- (C1);
\node at (0,-.7) {$y = f(x)$};
\node at (2,-.7) {$y = \operatorname{Argmin} E(x,y)$};
\end{tikzpicture}
\]

For instance, the model could use a 2-layer neural net to compute features and combine them, linearly and bilinearly, with the label.
The problem can be relaxed from $y \in \{0,1\}^n$ to $y \in [0,1]^n$.

\[
\begin{tikzpicture}[>=stealth,thick,yscale=1, xscale=2,inner sep = 1pt]
\node (x) at (0,0) {$x$};
\node (y) at (1,0) {$y$};
\node (t) at (0,1) {2-layer NN};
\node (l) at (0,2) {\strut linear};
\node (b) at (1,2) {\strut bilinear};
\node (p) at (2,2) {\strut label prior};
\node (e) at (1,3) {Energy};
\draw[->] (x) -- (t);
\draw[->] (t) -- (l);
\draw[->] (y) to [out=110, in=-45, looseness=1]  (l);
\draw[->] (y) -- (b);
\draw[->] (y) -- (p);
\draw[->] (l) -- (e);
\draw[->] (b) -- (e);
\draw[->] (p) -- (e);
\draw[->] (t) -- (b);
\end{tikzpicture}
\]

To learn the model, notice that we want 
$\forall y\ E(x_i,y) \geq E(x_i,y_i)$,
with a larger difference if $y$ and $y_i$ are far apart, e.g., 
$\forall y \ E(x_i,y) - E(x_i,y_i) \geq d(y,y_i) \geq 0. $
This suggests minimizing a \emph{structured SVM} (SSVM) loss 
\[
  \sum_i \max_y \bigl[ d(y,y_i) - E(x_i,y) + E(x_i,y_i) \bigr]_+. 
\]


\nextbook
\begin{book}
  \emph{Machine learning techniques\\ for Stackelberg security games: a survey
} \\
  G. De Nittis and F. Trov\`o (2016)
\end{book}
In the Stackelberg security game (SSG),
a defender protects $T$ targets from an attacker,
by allocating resources $R<T$.
The strategies are
$\{ x \in \RR^T \ :\ 0 \leq x \leq 1, \ x' \mathbf 1 \leq R \}.$
If the adversary attacks $t$, both receive a penalty and a reward:
\begin{align*}
  \text{Attacker}: &\ x_t P_t^a + (1-x_t) R_t^a \\
  \text{Defender}: &\ (1-x_t) P_t^d + x_t R_t^d
\end{align*}
Boundedly rational adversaries attack a target at random,
with a probability depending on their (potentially incorrect) subjective utility.
The subjective utility function can be estimated from data
(poaching and illegal fishing provide real-world data).
The defender's strategy should be robust to suboptimal adversaries.

\nextbook
\begin{book}
  \emph{Apprenticeship learning using inverse reinforcement learning and gradient methods} \\
  G. Neu et al. (2007)
\end{book}
\d{Inverse reinforcement learning} (IRL) 
learns a policy (a map from state features to actions) from an expert's observed behaviour.
Instead, one can learn the reward function for which the optimal policy is as close to the expert's as possible.

\nextbook
\begin{book}
  \emph{Dueling network architectures for deep reinforcement learning} \\
  Z. Wang et al.
\end{book}
In deep reinforcement learning, separately learn the state value function and the state-dependent action advantage function.

\nextbook
\begin{book}
  \emph{Deep successor reinforcement learning} \\
  T.D. Kulkarni et al.
\end{book}
Successor reinforcement learning learns the value function as the inner product between a reward predictor and a successor map.


\nextbook
\begin{book}
  \emph{Convexified convolutional neural networks} \\
  Y. Zhang et al. (2016)
\end{book}
Training a 1-hidden-layer CNN with linear activations is an optimization problem 
with a low-rank constraint (corresponding to weight sharing) 
which can be relaxed into a nuclear norm constraint.
For non-linear activations, use a kernel (RKHS).
For deeper networks, this no longer works, 
but greedy layer-wise training seems a good heuristic.

\nextbook
\begin{book}
  \emph{End-to-end kernel learning\\ with supervised convolutional kernel networks} \\
  J. Mairal (2016)
\end{book}
A \emph{convolutional kernel network}
uses the kernel trick to increase the dimension and add non-linearities
\[ 
\RR^n \xrightarrow{\phi} \RR^N \xrightarrow{\text{projection}} \RR^m, \quad N \gg n, m 
\]
without explicitly computing the high-dimensional coordinates.
The kernel parameters can be learnt as usual.

\nextbook
\begin{book}
  \emph{Network in network} \\
  M. Lin et al.
\end{book}
CNNs slide simple masks over an image, to detect features.
Instead, one could slide slightly deeper networks (``micro-networks'').

\nextbook
\begin{book}
  \emph{Towards a mathematical theory\\ of super-resolution} \\
  E.J. Cand\`es and C. Fernandez-Granda (2012)
\end{book}
It is possible to recover a spike train (\ie, a discrete complex measure, 
$x = \sum_i a_i \delta_{t_i}$) from low-resolution measurements or,
equivalently, from a truncated Fourier transform $\hat x = \mathscr F_n x$,
by solving a convex problem
\[
\begin{array}{ll}
  \text{Find} & y\text{, a complex measure} \\
  \text{To minimize} & \n{ y }_{\text{TV}} \\
  \text{Such that} & \mathscr F_n y = \hat x
\end{array}
\]
provided the spikes are sufficiently separated,
where the total variance of a measure $\mu$ on $[0,1]$
is a continuous analogue of the $\ell^1$ norm:
\[ \n{ \mu }_{\text{TV}} := \va \mu ( [0,1] ). \]

\nextbook
\begin{book}
  \emph{Multiscale Retinex} \\
  A.B. Petro et al. (2014)
\end{book}
The \emph{retinex} algorithm is a local contrast enhancement algorithm.
Consider random walks from a point, $x_0, x_1, \dots, x_n$;
compute 
\[ L = \sum \delta \left( \log \dfrac{ I(x_k) }{ I(x_{k+1}) } \right), \]
where $\delta(u) = u \mathbf 1_{ \va u \geq t }$
is a thresholding function, and use $\langle L \rangle$ as the new luminance.

Alternatively, use the ratio of a pixel value to the average of its neighbours
(with Gaussian weights);
repeat for several scales ($\sigma = 15$, 80, 250), and average.
Restore the colours to their original range,
or apply the algorithm to the intensity channel only.

\nextbook
\begin{book}
  \emph{A point set generation network for 3D object reconstruction from a single image} \\
  H. Fan et al.
\end{book}
To reconstruct a 3D scene as a cloud of points (union of balls -- this eliminates overlap and connectivity problems),
learn a neural net consuming an image and random data. The resulting shape eampler also accounts for ground truth ambiguity.

\nextbook
\begin{book}
  \emph{Spatial transformer networks} \\
  M. Jaderberg et al.
\end{book}
Add a transformation layer, to help align images -- it is differentiable,
so it will go through gradient descent.

\nextbook
\begin{book}
  \emph{StackGAN:\,text\,to\,photorealistic\,image\,synthesis\\ with stacked generative adversarial networks} \\
  H. Zhang et al.
\end{book}
Stack several GANs, generating images of increasing resolution.

\nextbook
\begin{book}
  \emph{The more you know:\\ using knowledge graphs for image classification} \\
  K. Marino et al.
\end{book}
LSTMs can be generalized to arbitrary DAGs
(instead of time, 
