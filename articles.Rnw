\nextbook
\begin{book}
  \emph{Structural agnostic modeling:\\ adversarial learning of causal graphs}\\
  D. Kalainathan et al.
\end{book}
For each variable $X_i$, train a neural network
$X_i = f( a_i \odot X_{\setminus i} , E_i )$,
where the $a_i$'s are binary gates (with penalties to ensure sparsity and acyclicity).

\nextbook
\begin{book}
  \emph{Efficient differentiable quadratic programming layers: an ADMM approach}\\
  A. Butler and R.H. Kwon (2021)
\end{book}
Quadratic optimization problems
\[ \begin{array}{ll}
  \text{Find} & z \\
  \text{To minimize} & \tfrac12 z' Q z + z' p \\
  \text{Such that} & A z = b \\
  & \ell \leq z \leq u 
\end{array} \]
can be solved with ADMM
\begin{align*}
  f(x) &= \dfrac12 z' Q z + z' p + I_{Ax=b} \\
  g(z) &= I_{ \ell \leq z \leq u }
\end{align*}
\[ \begin{array}{ll}
  \text{Find} & x, z \\
  \text{To minimize} & f(x) + g(z) \\
  \text{Such that} & x = z;
\end{array} \]
each step can be solved analytically.
\begin{align*}
  x &\leftarrow \argmin_{ x \,:\,  Ax = b}
  \dfrac12 x' Q x + x' p + \dfrac{\rho}2 \n{ x - z + \mu }^2 \\
  z &\leftarrow \argmin_{ \ell \leq z \leq u } \n{ x - z + \mu } ^ 2\\
  \mu &\leftarrow \mu + x - z
\end{align*}
It can also be used for optimization as a layer
(when $Q$, $p$, $A$, $b$, $\ell$, $u$ depend on $\theta$):
to compute the gradient, use the fixed point property
of the ADMM iteration: it is less computationally-intensity than the KKT conditions.

\nextbook
\begin{book}
  \emph{Graph representation learning}\\
  W.L. Hamilton (2020)
\end{book}

% 1. Introduction
\textbf{1.}
Machine learning on graphs covers the following tasks:
\begin{compactitem}[--]
\item Node classification,
\item Relation prediction,
\item Graph classification (or regression)
\end{compactitem}
but also: node clustering (community detection), graph clustering, etc.

% 2. Traditional approaches
\textbf{2.} Traditional node and graph features include:
degree, centralities (eigenvector, closeness, betweenness),
clustering coefficient (different normalizations),
graphlet count,
Weisfeiler-Lehman kernel,
path-based kernel (e.g., distribution of degree sequences in random walks,
or in shortest paths).

Measures of neighbourhood overlap include:
\begin{align*}
  &
  \dfrac{ \va{ N(u) \inter N(v) } }{ d_u + d_v } , \quad
  \dfrac{ \va{ N(u) \inter N(v) } }{ \sqrt{ d_u d_v } } , \quad
  \dfrac{ \va{ N(u) \inter N(v) } }{ \va{ N(u) \union N(v) } }
  \\
  & \sum_{ w \in N(u) \inter N(v) } \dfrac1{ d_w}, \quad
  \sum_w \dfrac1{\log d_w}, \quad
  \sum \beta^i ( A^i )_{uv};
\end{align*}
some can be directly computed from the adjacency matrix:
\[ ( I - \beta A )^{-1} - I , \quad D^{-1} ( I - \beta A )^{-1} D^{-1} . \]

The graph Laplacian $L = D - A$ satisfies
\[ x' L x = \sum_{ u,v \in E } ( x_u - x_v )^2; \]
it is often normalized as
$L_{\text{sym}} = D^{-1/2} L D^{1/2}$
or $L_{\text{rw}} = D^{-1} L$.
The \emph{ratio cut} and \emph{normalized cut}
\begin{align*}
  \text{RCut}(\mathscr A_1 , \dots , \mathscr A_n ) &=
  \sum_k \dfrac{
    \va{ (u,v) \in E \, :\, u \in \mathscr A_k, \ v \not\in \mathscr A_k }
  }{
    \va{ \mathscr A_k }
  } \\
  \text{NCut}(\mathscr A_1 , \dots , \mathscr A_n ) &=
  \sum_k \dfrac{
    \va{ (u,v) \in E \, :\, u \in \mathscr A_k, \ v \not\in \mathscr A_k }
  }{
    \sum\limits_{ u \in \mathscr A_k} d_u 
  }
\end{align*}
are maximized (after relaxation) by the second smallest eigenvector
of $L$ or $L_{\text{rw}}$.
Spectral clustering applies $k$-means to the smallest eigenvectors of $L$.

% 3. Neighbourhood reconstruction
\textbf{3.} We can compute node embedding with an encoder-decoder architecture (for a fixed graph)
\[ \begin{array}{rr@{\,}c@{\,}l}
  \textsc{enc} : & V & \longrightarrow & \RR^d \\
  \textsc{dec} : & \RR^d \times \RR^d & \longrightarrow & \RR^+.
\end{array} \]
The decoder could be
$ (a,b) \longmapsto \n{ a - b }^2 $,
$ a' b $,
or $ e^{ a' b } $;
the loss could be
$\textsc{dec}( z_u, z_v ) \cdot S_{u,v}$,
$\n{ \textsc{dec}( z_u, z_v ) - S_{u,v} }$,
$- S_{uv} \log \textsc{dec}( z_u, z_v )$
for some node similarity measure $S$, e.g.,
$S = A$, or $S = (A, A^2, \dots, A^k)$,
or some node neighbourhood overlap measure.

These can often be seen as matrix factorizations, e.g.,
\[ \operatorname*{Minimize}_Z \n{ Z Z' - S }_2^2 , \]
or random walk embeddings.

Those shallow embeddings have limitations.

% 4. Multi-relational graphs (knowledge graphs, KG)
\textbf{4.} These decoders can be generalized to multirelational graphs,
e.g., knowledge graphs (KG), and matrix factorizations become tensor factorizations:
\begin{align*}
  & z_u' R_\tau z_v \\
  & - \n{ z_u + r_\tau - z_v } \\
  & - \n{ g_{1,\tau}(z_u) + r_\tau = g_{2,\tau}(z_v) } \\
  & \langle z_u , r_\tau , z_v \rangle = \sum_i z_{ui} r_{\tau i} z_{vi} \\
  & \re \langle z_u , r_\tau , \bar z_v \rangle \\
  & - \n{ z_u \odot r_\tau = z_v }
\end{align*}
(the complex decoder allows for asymmetric relations).

% 5. GNN
\textbf{5.}
GNNs are neural networks transforming the adjacency matrix of a graph
in a permutation-equivariant (or -invariant) way:
$f(P A P') = P f(A)$ (or $f(PAP')=f(A)$),
by message passing:
\begin{align*}
  m_{N(u)} &\leftarrow \textsc{aggregate}\bigl( \{ h_v , \ v \in N(u) \} \bigr) \\
  h_u & \leftarrow \textsc{update} ( h_u , m_{N(u)} ).
\end{align*}
It is common to add self-loops and omit the explicit update step:
\[ h_u \leftarrow \textsc{aggregate} \bigl(
\bigl\{ h_v , \ v \in N(u) \union \{ u \} \bigr\}
\bigr). \]
The aggregation can be
\begin{align*}
  m_u &= \sum_v h_v && \text{(GNN)} \\
  m_u &= \dfrac1{  \va{ N(u) } } \sum_v h_v \\
  m_u &= \sum_v \dfrac{ h_v }{ \sqrt{
       \va{ N(u) } \va{ N(v) }
  }} && \text{(GCN)}.
\end{align*}
The sum can be replaced by
\begin{align*}
  m_u &= \text{MLP} \biggl( \sum_{ v \in N(u) } \text{MLP} ( h_v ) \biggr) \\
  m_u &= \text{MLP} \biggl( \dfrac1{ \va{ N(u) } ! }
  \sum_{ \pi \in \mathfrak S_{ \va{N(u)} } }
  \textsc{lstm}( h_{v_1} , \dots , h_{ v_{\va{N(u)}} } )
  \biggr)
\end{align*}

% TODO: $\pi$ is not used in the formula...

(approximated with a random set of permutations,
or even a single one,
corresponding to some canonical ordering, e.g., by degree).

We can also add attention
\begin{align*}
  m_{ N(u) } &= \sum_v \alpha_{u,v} h_v \\
  \alpha_{u,v} & \propto \exp a' [ W h_u \oplus W h_v ] && \text{(GAT)} \\
  \alpha_{u,v} & \propto \exp ( h' u W h_v ) && \text{(bilinear attention)} \\
  \alpha_{u,v} &\propto \exp \textsc{mlp} ( h_u, h_v ).
\end{align*}
To limit oversmoothing,
try skip connections, gated updates,
\[ h_u \leftarrow \textsc{gru}( h_u , m_{N(u)} ) \]
or jumping knowledge (JK) connections.
% Skip-connections, jumping knowledge (JK) connections
