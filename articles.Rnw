\node (decoder2) at (3,0) {\footnotesize decoder};
\node (decoder3) at (3,-1) {\footnotesize decoder};
\node (output1) at (4,1) {\footnotesize output\rlap{ (instrument 1)}};
\node (output2) at (4,0) {\footnotesize output\rlap{ (instrument 2)}};
\node (output3) at (4,-1) {\footnotesize output\rlap{ (instrument 3)}};
\draw[->] (input) -- (encoder);
\draw[->] (encoder) -- (latent);
\draw[->] (latent) -- (decoder1.west);
\draw[->] (latent) -- (decoder2.west);
\draw[->] (latent) -- (decoder3.west);
\draw[->] (decoder1) -- (output1);
\draw[->] (decoder2) -- (output2);
\draw[->] (decoder3) -- (output3);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{EraseReLU: A simple way to ease the training of deep convolutional networks} \\
  X. Dong et al.
\end{book}
There might be too many nonlinearities in some neural nets:
removing the last ReLU of all basic modules may improve performance.

\nextbook
\begin{book}
  \emph{Shifting mean activation towards zero\\ with bipolar activation functions} \\
  L.H. Eidner and A. N\o kland (2018)  
\end{book}
Replace the nonlinearity $x \longmapsto \sigma(x)$
with $x \longmapsto ( \sigma(x), - \sigma(-x) )$
or with 
\[
x_i \longmapsto
\begin{cases}
    \sigma(   x_i ) & \text{if } i \equiv 1 \ (\text{mod } 2) \\
  - \sigma( - x_i ) & \text{if } i \equiv 0 \ (\text{mod } 2)
\end{cases}
\]
The \emph{orthogonal partition linear unit} (OPLU)
partitions the coordinates into pairs and sorts them.
\[
(x_i) _{ 1 \leq i \leq 2n } \longmapsto
\begin{pmatrix}
  \max( x_{2i-1}, x_{2i} ) \\
  \min( x_{2i-1}, x_{2i} ) 
\end{pmatrix}_{ 1 \leq i \leq n }
\]

\nextbook
\begin{book}
  \emph{SMASH: one-shot model architecture search through hypernetworks} \\
  A. Brock et al. 
\end{book}
Encode neural network topologies as binary vectors, from a few building blocks (ResNet, FractalNet, etc.), and map them to weights.
