\nextbook
\begin{book}
  \emph{Enhancing causal discovery in financial networks with piecewise quantile regression}\\
  C. Cornell et al.
\end{book}
VAR model, with pinball loss, to forecast the 10\%, 50\%, 90\% quantiles,
using piecewise linear transformations of the predictors,
with knots at the 10\% and 90\% quantiles to detect tail interactions.

\nextbook
\begin{book}
  \emph{semopy: a Python package\\ for structural equation modeling}\\
  G. Meschcheryakov and A.A. Igolkina (2019)
\end{book}
A \d{structural equation model} (SEM) is a model of the form
\begin{align*}
  \eta &= B \eta + \epsilon && \text{latent} \\
  y &= \Lambda \eta + \delta && \text{observed}
\end{align*}
where the sparsity structure of $B$ and $\Lambda$
(and of $\var \epsilon$, $\var \delta$) is known, e.g.,
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node (y1) at (0,8) {$y_1$};
  \node (y2) at (0,6) {$y_2$};
  \node (y3) at (0,4) {$y_3$};
  \node (y4) at (3,2) {$y_4$};
  \node (y5) at (3,0) {$y_5$};
  \node (y6) at (4,2) {$y_6$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e1) at (1,6) {$\eta_1$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e2) at (1,4) {$\eta_2$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e3) at (2,1) {$\eta_3$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e4) at (3.5,4) {$\eta_4$};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x1) at (1,2) {$x_1$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x2) at (1,0) {$x_2$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x3) at (2,4) {$x_3$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x4) at (5,4) {$x_4$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x5) at (6,4) {$x_5$\vrule height .65em depth 0pt width 0pt};
  \draw[->] (e1) -- (y1);
  \draw[->] (e1) -- (y2);
  \draw[->] (e1) -- (y3);
  \draw[->,thick,blue!50!black] (e1) -- (x3);
  \draw[->] (e2) -- (y3);
  \draw[->,thick,blue!50!black] (e2) -- (x3);
  \draw[->] (e3) -- (y4);
  \draw[->] (e3) -- (y5);
  \draw[->] (e4) -- (y4);
  \draw[->] (e4) -- (y6);
  \draw[->,thick,blue!50!black] (e4) -- (x4);
  \draw[->,thick,blue!50!black] (x1) -- (e3);
  \draw[->,thick,blue!50!black] (x1) -- (x3);
  \draw[->,thick,blue!50!black] (x2) -- (e3);
  \draw[->,thick,blue!50!black] (x3) -- (e4);
  \draw[->,thick,blue!50!black] (x4) to[out=140,in=40] (x3);
  \draw[->,thick,blue!50!black] (x4) -- (x5);
  \draw[<->,thick,purple!80!blue!60] (e2) to [out=-120,in=120] (x2);
  \draw[<->,thick,purple!80!blue!60] (y5) to[out=0,in=-90] (y6);
\end{tikzpicture}
\]
It can be estimated by comparing the sample variance matrix of the observed variables, $S = \var y$,
with that of the model, $\Sigma_\theta$, e.g.,
\begin{align*}
  \ell(\theta) &= \n{ \Sigma_\theta - S }_F^2 \\
  \ell(\theta) &= \n{ I - \Sigma_\theta S^{-1} }_F^2 \\
  \ell(\theta) &= \tr( S \Sigma_\theta^{-1} ) + \log \det \Sigma _\theta \qquad \text{(Wishart)}.
\end{align*}

\nextbook
\begin{book}
  \emph{semopy 2: a structural equation modeling package with random effects in Python}\\
  G. Mosccheryakov et al. (2021)
\end{book}
A \emph{structural equation model} (SEM) is a linear model
\[ x = A x + \epsilon \]
where some of the variables are not observed (latent)
and the sparsity structure of $A$ and $\var \epsilon$ is known.
There are special cases:
\begin{compactitem}[--]
\item A \emph{path analysis} (PA) model only has observed variables
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x1) at (0,1) {$x_1$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x2) at (1,1) {$x_2$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x3) at (2,1) {$x_3$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x4) at (3,2) {$x_4$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x5) at (3,0) {$x_5$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x6) at (4,2) {$x_6$\vrule height .65em depth 0pt width 0pt};
  \node[thick,draw=blue!50!black,fill=blue!10,inner sep=2pt] (x7) at (4,0) {$x_7$\vrule height .65em depth 0pt width 0pt};
  \draw[->,thick,blue!50!black] (x1) -- (x2);
  \draw[->,thick,blue!50!black] (x2) -- (x3);
  \draw[->,thick,blue!50!black] (x3) -- (x4);
  \draw[->,thick,blue!50!black] (x3) -- (x5);
  \draw[->,thick,blue!50!black] (x4) -- (x6);
  \draw[->,thick,blue!50!black] (x5) -- (x7);  
\end{tikzpicture}
\]
\item A \emph{confirmatory factor analysis} (CFA) model
  has no relations between the latent variables
  and between observed variables,
  just relations from latent to observed variables,
  and covariance between latent variables
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.5,inner sep=0pt,outer sep=1pt,baseline={(0,.3)}]
  \node (y1) at (0,0) {$y_1$};
  \node (y2) at (1,0) {$y_2$};
  \node (y3) at (2,0) {$y_3$};
  \node (y4) at (3,0) {$y_4$};
  \node (y5) at (4,0) {$y_5$};
  \node (y6) at (5,0) {$y_6$};
  \node (y7) at (6,0) {$y_7$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e1) at (1.5,2) {$\eta_1$};
  \node[circle,thick,draw=blue!50!black,fill=blue!10,inner sep=1pt] (e2) at (4.5,2) {$\eta_2$};
  \draw[->] (e1) -- (y1);
  \draw[->] (e1) -- (y2);
  \draw[->] (e1) -- (y3);
  \draw[->] (e1) -- (y4);
  \draw[->] (e2) -- (y4);
  \draw[->] (e2) -- (y5);
  \draw[->] (e2) -- (y6);
  \draw[->] (e2) -- (y7);
  \draw[<->,thick,purple!80!blue!60] (e1) to [out=30,in=150] (e2);  
\end{tikzpicture}
\]
\end{compactitem}
Historically, SEMs distinguished between:
\begin{compactitem}[--]
\item Observed variables (non-leaves: $x_i$);
\item Indicators (leaves: $y_i$).
\end{compactitem}

\emph{Exploratory factor analysis} (EFA) looks for a latent structure explaining the observed variables.
A heuristic approach could be:
\begin{compactitem}[--]
\item Compute the correlations $(\rho_{ij})_{1 \leq i,j\leq m}$
  and the corresponding distances $D_{ij} = 1 - \va{\rho_{ij}}$;
\item Run the OPTICS clustering algorithm,
  with \texttt{min\_cluster\_size=2}, to estimate the number $k$ of latent factors; 
\item Compute a sparse PCA (SPCA) and keep the first $k$ components;
\item Refine the CFA by fitting the SEM and dropping the coefficients with a large $p$-value.
\end{compactitem}





%%%%%%%%% Change point

\nextbook
\begin{book}
  \emph{Random forests for change point detection}\\
  M. Londschien et al. (2023)
\end{book}
To find a breakpoint,
compare the performance of classification models predicting, from $x_t$,
if $t \in [t_0,\tau]$
or $t \in [\tau,t_1]$:
the best performance is obtained if $\tau$ is a breakpoint.
This can be generalized to several (an unknown number of) breakpoints,
and efficiently approximated.

Alternatives include:
\begin{compactitem}[--]
\item E-divisive (ECP), which finds breakpoints minimizing the energy distance between segments;
  the \emph{energy distance} between two random variables can be computed from their characteristic functions:
  \begin{align*}
    \mathscr E_a (X,Y) &= \int_{ \RR^d } \va{ \phi_X(t) - \phi_Y(t) } w(t) dt \\
    w(t) &\propto \va{ t }^{ -d-\alpha } \\
    \alpha&= 2.
  \end{align*}
\end{compactitem}

\nextbook
\begin{book}
  \emph{A kernel multiple change-point algorithm\\ via model selection}\\
  S. Arlot et al. (2012)
\end{book}
Kernel change point methods (KCP) minimize (with dynamic programming)
the kernel least squares criterion
\begin{align*}
  R(\tau) = {}& \dfrac1n \sum_{ i = 1 } ^n k(x_i,x_i ) \\
& - \dfrac1n \sum_\ell \dfrac1{ \tau_\ell - \tau_{\ell-1} }
\sum_{i,j \in \llbracket \tau_{\ell-1} +1 , \tau_\ell \rrbracket } k(x_i,x_j)
\end{align*}
with a penalty for the number $D$ of segments
\[ \dfrac1n \left[ c_1 \log \binom{n-1}{D-1} + c_2 D \right]. \]

The loss can also be written
\[ R(\tau) = \dfrac1n \n{ \Phi(\mathbf x ) - \Pi_\tau \Phi(\mathbf x ) \mathstrut } ^2 \]
where
\begin{align*}
  & k(x,y) = \bigl\langle \Phi(x), \Phi(y) \bigr\rangle \\
  & \Phi: \left\{
  \begin{array}{rcl} \mathscr X & \longrightarrow & \mathscr H \\ x & \longmapsto & k(x,\bigcdot) \end{array}
  \right. \qquad \text{RKHS} \\
  & \mathbf x = (x_1,\dots,x_n) \\
  & \Phi(\mathbf x) = \bigl( \Phi(x_1), \dots, \Phi(x_n) \bigr) 
\end{align*}
$F_\tau$ is the subset of $\mathscr H^n$ of locally constant sequences with locally constant pattern (coarser than) $\tau$;
$\Pi_\tau$ is the orthogonal projection in $F_\tau$.

For the $d$-dimensional simplex
(e.g., if $x_i$ is a histogram -- histogram features are often used for image or audio data),
use the $\chi^2$ kernel
\[ k(x,y) = \exp - \dfrac1{h \cdot d} \sum_{i=1}^d \dfrac{ (x_i-x_j)^2 }{ x_i + x_j } \]
(for some bandwidth $h>0$).




%%%%%%%%%%%% REcSys

\nextbook
\begin{book}
  \emph{Recommendation with generative models}\\
  Y. Deldjoo et al. (2024)
\end{book}

Classical RecSys data contains user, item, timestamp, feedback (explicit (rating) or implicit (click)).

Matrix factorization models the feedback as
\[ R_{ui} = \gamma_u \cdot \gamma_i ; \]
one can add offset and bias
\[ R_{ui} = \alpha + \beta_u + \beta_i + \gamma_u \cdot \gamma_i \]
or include the previous item $j$
\[ R_{uij} = \gamma_u \gamma_i + \beta_i^{\text{next}} \beta_j^{\text{previous}}. \]

User-free models only look at the similarity with items in the user's history
\[ R_{ui} = \operatorname*{Mean}_{ j \in u \setminus \{ i \} } \gamma_i \cdot \gamma_j^{\text{history}}. \]

Generative models produce a \emph{probabilistic forecast}:
there is not a single output, but a probability distribution of outputs,
from which we can sample.

A user's history is a sequence of tokens:
we can use LLM-like models to forecast the next token.

RecSys can generate sets (or sequences) of items instead of isolated items:
the items should be complementary or substitutable (ex: outfits).

GANs can improve traditional RecSys training by providing hard negatives (instead of uniformly sampled ones).
But GANs can also be used to model normal users,
and create hard-to-detect fake profiles.

Generative models also provide data augmentation.

Traditional RecSys, when followed by LLM-based reranking,
can be seen as the retrieval part of a RAG system.

The data can also contain text (user profiles, item reviews)
and metadata.

Conversational RecSys provide textual explanations (personalized reviews),
and allow for interactive query refinement --
but also personalized content and advertising.

%%%%%% MAB

\nextbook
\begin{book}
  \emph{A contextual bandit approach to personalized news article recommendation}\\
  L. Li et al. (2010)
\end{book}
The UCB algorithm, for multi-arm bandits (MAB), chooses the arm $i$ maximizing
\[ \text{UCB}_i = \hat\mu_i + \sqrt{ \dfrac{ 2 \log t }{ n_i } } . \]
For contextual bandits, use
\begin{align*}
  \text{LinUCB}_i &= x_i ' \hat\theta_i + \alpha \sqrt{ x_i ' A_i ^{-1} x_i } \\
  A_i &= X_i ' X_i + I \\
  \hat\theta_i &= ( X_i ' X_i + I )^{-1} X_i ' b_i \quad \text{(ridge)} \\
  x_i &\text{: feature vector} \\
  X_i &\text{: design matrix} \\
  b_i &\text{: response vector}
\end{align*}
This can be generalized to hybrid models
(some parameters are shared among the arms).

\nextbook
\begin{book}
  \emph{Thompson sampling\\ for contextual bandits with linear payoffs}\\
  S. Agrawal and N. Goyal (2013)
\end{book}
\emph{Thompson sampling} can be generalized to contextual MABs:
\begin{compactitem}[--]
\item Compute the posterior distribution of $\theta_i$, for each $i$:
  $N(\hat\theta_i, \alpha^2 A^{-1} )$;
\item Sample from them; 
\item Choose the arm $i$ maximizing $x_i ' \theta_i$.
\end{compactitem}
\emph{LinTS} is similar to LinUCB:
the former picks the arm maximizing a random sample,
the latter an arm maximizing an upper bound.

\nextbook
\begin{book}
  \emph{Value-difference based exploration: adaptive control between epsilon-greedy and softmax}\\
  M. Tokic and G. Palm
\end{book}
% Not read
The \emph{softmax} MAB algorithm is a modification of $\epsilon$-greedy
paying attention to the difference in rewards:
it picks the arm $i$ with probability
$p_i \propto \exp( \hat\mu_i / \tau )$.

\nextbook
\begin{book}
  \emph{Algorithms for the multi-armed bandit problem}\\
  V. Kuleshov and D. Precup (2009)
\end{book}
The \emph{pursuit} MAB algorithm is
\[ p(t+1) = p(t) + \beta \bigl[ e_i - p(t) \bigr] \]
where $e_i$ is the basis vector for
\[ i = \argmax_i \hat\mu_i(t) . \]
The \emph{Boltzman} (softmax) algorithm uses
\[ p_i(t+1) \propto \exp \hat\mu_i(t) / \tau. \]
The \emph{reinforcement comparison} method uses ``preferences'' $\pi$
instead of average rewards $\hat\mu$:
\[ p_i(t+1) \propto \exp \pi_i(t) \]
where $\pi_i(t+1) = \pi_i(t) + \beta \bigl[ r(t) - \bar r(t) \bigr] $
if arm $i$ is chosen at time $t$ and gives reward $r(t)$.

There are many variants of \emph{UCB}:
\begin{align*}
  j(t) &= \argmax_i \hat\mu_i + \sqrt{ \dfrac{ 2 \log t }{ n_i } } \\
  j(t) &= \argmax_i \hat\mu_i + \sqrt{
    \dfrac{ \log t }{ n_i } \min \biggl\{ \dfrac14 , V_i \biggr\}
  } \\
  V_i(t) &= \hat\sigma_i(t) + \sqrt{
    \dfrac{ 2 \log t }{ n_i(t) }
    }
\end{align*}






\nextbook
\begin{book}
  \emph{Introduction\\ to conformal prediction with Python}\\
  C. Molnar (2023)
\end{book}

\textbf{6.}
Conformal prediction (CP) works as follows:
\begin{compactitem}[--]
\item Split the data into training and calibration
  (and test, and validation) sets; 
\item Train the model on the training set
\item Compute a \emph{non-conformity score} for all observations in the calibration set
  (any measure of how unusual $y$ is, given $x$), e.g.,
  $ 1 - \hat p(y|x)$, for a classification model; 
\item Compute its $1-\alpha$ quantile $\hat q$
  (with a finite-sample adjustment);
\item Given new data, $x$, return all the $y$'s whose non-conformity score is below $\hat q$ as \emph{prediction set}.
\end{compactitem}
(This is inductive CP;
transductive CP uses the whole dataset, but needs to refit the model many times).
For the splits, you can use a single split, cross-validation (CV) or leave-out-one (LOO).

\textbf{7.}
For classification:
\begin{compactitem}[--]
\item The \emph{score method} uses the probabilities of the true classes to compute the conformity scores:
  $s_i = 1 - \hat p(x_i)_{ y_i }$
  (where $\hat p(x_i)$ is the vector of predicted probabilities);
  it is not \emph{adaptive}:
  it only guarantees \emph{marginal coverage},
  not \emph{class-conditional coverage} -- the coverage is $1-\alpha$ only on average,
  but it can be much higher/lower for easier/harder classes.
\item \emph{Adaptive prediction sets} (APS)
  use cummulated probabilities, from the largest down to the true class; 
  at test time, compute the cummulated sorted probabilities, and return the classes until the threshold
  (you can include the label just above the threshold, or not (but this can lead to empty prediction sets),
  or (better) decide at random);
\item Top-$k$ uses the rank of the true class;
  the prediction sets all have the same size; 
\item Regularized APS (RAPS)
  penalizes the inclusion of too many classes; 
\item Group-balanced conformal prediction applies conformal prediction separately for each group;
\item Class-conditional APS uses group-balanced CP
  for the classes to predict:
  since they are not known at test time, it computes the CP for all classes, and returns the union of the forecasts.
\end{compactitem}

\textbf{8.}
For regression:
\begin{compactitem}[--]
\item $s(y,x) = \bigl| y - \hat f(x) \bigr|$
  gives prediction intervals all of the same size
  (this is fine if the data is homoskedastic);
\item Locally adaptive CP
  \[s(y,x) = \dfrac{ \bigl| y - \hat f(x) \bigr| }{ \hat \sigma(x) } \]
  accounts for heteroskedasticity
  (but can output excessively large intervals if the data is homoskedastic).
\end{compactitem}
Instead of conformalizing (mean) regression, we can conformalize quantile regression
\[ s(y,x) = \max \bigl\{
\hat f _{\text{low}} (x) - y , y - \hat f_{\text{up}}(x) 
\bigr\} \]
(the distance to the nearest interval boundary, with a negative sign if inside).

\textbf{9.} Conformal prediction can be generalized to time series
(EnbPI, in spite of non-exchangeability),
multilabel classification,
outlier detection (CP provides accurate control of the false positive rate).

Implementation: \texttt{mapie}; also check \texttt{crepes}, \texttt{nixtla}.

