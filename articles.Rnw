  \node[right=0pt of A2,fill=green!20] (A3) {};
  \node[right=0pt of A3,fill=green!20] (A4) {};
  \node[right=0pt of A4,fill=green!20] (A5) {};
  \node[right=0pt of A5,fill=blue!20] (A6) {};
  \node[right=0pt of A6,fill=blue!20] (A7) {};
  \node[right=0pt of A7,fill=blue!20] (A8) {};
  \node[right=0pt of A8,fill=orange!20] (A9) {};
  \node[above=4mm of A1,fill=purple!40] (B0) {};
  \node[above=4mm of A4,fill=green!40] (B1) {};
  \node[above=4mm of A7,fill=blue!40] (B2) {};
  \draw[->] (B0) -- (A0.north);
  \draw[->] (B0) -- (A1.north);
  \draw[->] (B0) -- (A2.north);
  %\draw[->] (B1) -- (A3.north);
  %\draw[->] (B1) -- (A4.north);
  %\draw[->] (B1) -- (A5.north);
  \draw[->] (B2) -- (A6.north);
  \draw[->] (B2) -- (A7.north);
  \draw[->] (B2) -- (A8.north);
  \draw[->] (A9.north) to[out=90,in=90,looseness=1] (B2.north);
  \draw[->] (A9.north) to[out=90,in=90,looseness=1] (B1.north);
  \draw[->] (A9.north) to[out=90,in=90,looseness=1] (B0.north);
  \node[draw=none,above=.5mm of A4,text width = 4cm] {\scriptsize no attention};
  \end{scope}
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Training data-efficient image transformers and distilation through attention}\\
  H. Touvron et al.
\end{book}
Vision transformers add a (learned) class token to the patch tokens
(not unlike the \textsc{[cls]} token for language) and use it to forecast the true label.

``Distillation through attention''
adds another ``distillation'' token,
and uses it to forecast the teacher's hard label
(rather than the teacher's softmax).

\nextbook
\begin{book}
  \emph{An optimal control perspective\\ on diffusion based generative modeling}\\
  J. Berner et al. (2022)
\end{book}
The marginals of a time-reversed It\=o process can be represented as the marginals of another It\=o process.
If
\begin{align*}
  & Y_0 \sim \mathscr D \\
  & dY = f(Y,s) ds + \sigma(s) d B_s \\
  & X_0 \sim Y_T \\
  & dX = \mu(X,s) ds + \sigma(s) d B_s \\
  & \mu = \sigma \sigma ' \nabla_{\!x} \log p_Y - f \\
  & f : \RR^d \times [0,T] \longrightarrow \RR^d \\
  & \sigma : [0,T] \longrightarrow \RR^{d \times d},
\end{align*}
then $X_T \sim \mathscr D$.
More generally,
$p_T = \cev p_X$ a.e., \ie,
$Y_{T-t} \overset{d}{=} X_t$ a.e.

\nextbook
\begin{book}
  \emph{Language models\\ (mostly) know what  they know}\\
  S. Kadavath et al.
\end{book}
Their self-evaluation is better calibrated
if they are provided with several of their own samples.

\nextbook
\begin{book}
  \emph{Non-adversarial training of neural SDEs\\ with signature kernel scores}\\
  Z. Issa et al.
\end{book}
% Too technical
Find $\theta$ such that the SDE
\[ d X_t = \mu_\theta(X_t,t) dt + \sigma_\theta(X_t,t) dW_t \]
minimizes
\[ \mathscr L(\theta) = \E_{ Y \sim \text{data} } \left[
  \E_{ x,x' \sim p_\theta } k(x,x')
  - 2
  \E_{ x \sim p_\theta } k(x,y) 
  \right] \]
where the \emph{signature kernel} is defined by a PDE
\begin{align*}
  k(x,y) &= \bigl\langle S(x) , S(y) \bigr\rangle = f(T,T) \\
  f(s,t) &= \int_0^t \int_0^s f(u,v) \bigl\langle d x_u . d x_b \bigr\rangle.
\end{align*}

\nextbook
\begin{book}
  \emph{Higher order kernel mean embeddings\\ to capture filtrations of stochastic processes}\\
  C. Salvi et al.
\end{book}
The signature kernel is
\[ k(x,y) = \bigl\langle S(x) , S(y) \bigr\rangle \]
where $x$, $y$ are paths
$[0,T] \to \RR^d$
and $S$ is the signature transform.
It can be computes as $k(x,y) = u(T,T)$,
where $u$ is the solution of
\begin{align*}
  \dfrac{ \partial^2 u }{ \partial s \partial t } &= \bigl\langle \dot x(s), \dot y(t) \bigr\rangle u \\
  u(0,\bigcdot) &= u(\bigcdot,0) = 1
\end{align*}

\nextbook
\begin{book}
  \emph{Deep into the domain shift: transfer learning through dependence regularization}\\
  S. Ma et al.
\end{book}
Domain adaptation learns domain-invariant features.

Separately penalize differences in the dependence structure (copula) and in the marginals.

\nextbook
\begin{book}
  \emph{Sophia: a scalable stochastic second-order optimizer for language model pretraining}\\
  H. Liu et al.
\end{book}
Use the diagonal Hessian as preconditioner;
only update it every few iterations;
clip the updates.

Estimate the diagonal Hessian as
(Hutchinson, unbiased)
\begin{align*}
  H &\approx u \odot \nabla \langle \text{loss}, u \rangle \\
  u &\sim N(0,I) 
\end{align*}
or (Gauss-Newton-Bartlett, biased)
\begin{align*}
  \hat g &= \nabla \dfrac1B \sum_b \text{loss} \bigl( f_\theta(x_b) , \hat y_b \bigr) \\
  \hat y _b &\sim \operatorname{softmax} f_\theta(x_b).
\end{align*}

\nextbook
\begin{book}
  \emph{Transformers can do Bayesian inference}\\
  S. M\"uller et al.
\end{book}
A \emph{Prior data fitted network} (PFN) forecasts the (posterior) distribution
\[ q_\theta : y_{ n + 1 } \,|\, (x1,y1), \dots , (x_n, y_n), x_{n+1} . \]
The distribution $q_\theta$ is modeled as a ``Riemann distribution'':
a discretized continuous distribution
with equal (prior) probability bins
(if the marginal distribution of $y$ is not bounded,
use a half-Gaussian for the tails).
Use a transformer encoder (with no positional encoding):
it is $\mathfrak S_n$-invariant.

%TODO: PLOT

Applications include
sampling from Gaussian processes (with a hyper-prior),
tabular data,
Bayesian neural nets.

