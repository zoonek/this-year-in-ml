  \node[circle,inner sep=1pt,fill] (A) at (4,7) {};
  \node[circle,inner sep=1.25pt,draw,thick] (B) at (4,6) {};
  \node[rectangle,inner sep=2.5pt,draw,thick] (C) at (4,5) {};
  \node[left=-2pt of C,  rectangle,inner sep=2.5pt,draw,thick] (Cb) {};
  \node[left=-2pt of Cb, rectangle,inner sep=2.5pt,draw,thick] (Cc) {};
  \node[anchor=west] at (4.5,7) {latent representation};
  \node[anchor=west] at (4.5,6) {RNN};
  \node[anchor=west] at (4.5,5) {adjacency matrix row};
\end{tikzpicture}
\]
where each row
\begin{tikzpicture}[>=stealth,scale=.5,inner sep=0pt,outer sep=1pt,baseline=-1mm,
  %every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
  \node[circle,inner sep=1.25pt,draw,thick] (B) at (0,0) {};
  \node[rectangle,inner sep=2.5pt,draw,thick] (C) at (1,0) {};
  \node[right=-2pt of C,  rectangle,inner sep=2.5pt,draw,thick] (Cb) {};
  \node[right=-2pt of Cb, rectangle,inner sep=2.5pt,draw,thick] (Cc) {};
  \draw[->] (B) -- (C);
\end{tikzpicture}
is generated by a node-level RNN
\[
\begin{tikzpicture}[>=stealth,scale=.5,inner sep=0pt,outer sep=1pt,baseline=0,
  %every node/.style={circle,draw},
  every text node part/.style={align=center}
  ]
