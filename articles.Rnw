  \end{scope}
  \begin{scope}[shift={(4,0)}]
    \node (h2) at (0,0) {$h_2$};
    \node (g) at (1,0) {$g^{-1}$};
    \node (h2p) at (2,0) {$h_2'$};
    \node[above=0pt of h2] (h1) {$h_1$};
    \node[above=0pt of h2p] (h1p) {$h_1'$};
    \draw[->] (h1p) -- (h1);
    \draw[->] (h1p) -| (g);
    \draw[->] (h2p) -- (g);
    \draw[->] (g) -- (h2);
    \node[draw=none,text width = 3cm] at (1,-.6) {\footnotesize inverse};
  \end{scope}
\end{tikzpicture}
\]

