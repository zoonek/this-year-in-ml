\nextbook
\begin{book}
  \emph{DAGs with no curl:\\ an efficient DAG structure learning approach}\\
  Y. Yu et al.
\end{book}
Given a set of vertices $V$, consider alternating functions on vertices, edges and triangles
\begin{align*}
  L^2(V) &= \{ f : V \to \RR \} \\
  L^2_\wedge(E) &= \{ Y: Y \times Y \to \RR \ :\ \forall i,j \ Y(i,j) = - Y(j,i) \} \\
  L^2_\wedge(T) &= \{ \Theta: V \times V \times V \to \RR \ :\
  \forall i,j,k \ \Theta(i,j,k) = - \Theta(j,i,k) = - \Theta( i,k,j)
  \}
\end{align*}
and define gradient, divergence and Laplacian
\[
\begin{tikzpicture}[>=stealth,scale=2.6,inner sep=1pt,outer sep=2pt,every node/.style={anchor=base}]
  \node (A) at (0,0) {$L^2(V)$};
  \node (B) at (1,0) {$L^2_\wedge(E)$};
  \node (C) at (2,0) {$L^2_\wedge(T)$};
  \draw[->] ([yshift=+.6pt]A.east) to node[anchor=south,outer sep=0pt]{\footnotesize grad} ([yshift=+.6pt]B.west);
  \draw[->] ([yshift=-.6pt]B.west) to node[anchor=north,outer sep=0pt]{\footnotesize $\text{grad}^*=\text{div}$} ([yshift=-.6pt]A.east);
  \draw[->] ([yshift=+.6pt]B.east) to node[anchor=south,outer sep=0pt]{\footnotesize curl} ([yshift=+.6pt]C.west);
  \draw[->] ([yshift=-.6pt]C.west) to node[anchor=north,outer sep=0pt]{\footnotesize $\text{curl}^*$} ([yshift=-.6pt]B.east);
  \draw[->] (A) to[out=-120,in=-60,looseness=4] node [anchor=north east, pos=.4, outer sep=-2pt] {\footnotesize $\Delta_0$} (A);
  \draw[->] (B) to[out=-120,in=-60,looseness=4] node [anchor=north east, pos=.4, outer sep=-2pt] {\footnotesize $\Delta_1$} (B);
\end{tikzpicture}
\]
\begin{align*}
  & ( \grad p )(ij) = p(j) - p(i) \\
  & ( \grad^* Y)(i) = - \sum_j Y(i,j) \\
  & \div Y = - \grad^* Y \\
  & (\curl Y)(i,j,k) = Y(i,j) + Y(j,k) + Y(k,i) \\
  & (\curl^* \Theta) (i,j) = \sum_k \Theta(i,j,k) \\
  & \Delta_0 = \grad^* \grad \\
  & \Delta_1 = \grad \grad^* + \curl^* \curl 
\end{align*}
Note that
\begin{align*}
  \curl \grad &= 0 \\
  \grad^* \curl^* &= 0.
\end{align*}

Any alternating edge function $Y$ can be decomposed as
\[ Y = \grad \phi + \curl^* \Psi + H \]
where $\Delta_1 H = 0$, $\curl H = 0$, $\div H = 0$;
$\phi$ can be recovered as
\begin{align*}
  \phi &= - \Delta_0^\dagger \div Y \\
  \phi(d) &= 0 \\
  \Delta_0 &=
\left[\!\!\!  
\begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)},outer sep=0pt]
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells,
  row sep={2.5ex,between origins},column sep={4ex,between origins},
  ampersand replacement=\&% <= to change col separator for align env  
]{
  d-1 \&\&\&\& 0 \\
  \&\& -1 \\
  \& -1 \\
  \&\&\& d-1 \\
  0 \&\&\&\& 0 \\  % Do not forget the \\ on the last line!
};
\draw (m-1-1) -- (m-4-4);
\draw (m-1-5) -- (m-5-5);
\draw (m-5-1) -- (m-5-5);
\end{tikzpicture}
\!\!\!\right]
\end{align*}

Weighted adjacency matrices of DAGs are exactly matrices of the form
$A = W \odot \text{ReLU}( \grad p )$,
where $W$ is skew symmetric;
the vector $p$ defines a topological order on the graph
(it is a complicated way of saying that $A$ is defined by a topological order and an upper triangular matrix).

We could use that parametrization to find a DAG from data,
but the problem is non-convex and restarts do not help much.

Instead, use
\begin{align*}
  A &= \argmin_A F(A,X) + \lambda h(A) \\
  \intertext{(with $\lambda=10^3$ instead of NOTEARS's $\lambda=10^{16}$)}
  C(A)_{ij} &= 1 \text{ iff there is a directed path from $i$ to $j$} \\
  p &= - \Delta_0^\dagger \div \dfrac12 \bigl( C(A) - C(A)^\top \bigr) \\
  W_{ij} &= \begin{cases}
    0 & \text{if } p_i = p_j \text{ or } A_{ij} = A_{ji} = 0 \\
    \dfrac{ A_{ij} }{ p_j - p_i } & \text{if } A_{ij} \neq 0 \text{ and } A_{ji} = 0 \\
    \dfrac{ A_{ji} }{ p_j - p_i } & \text{if } A_{ij} = 0 \text{ and } A_{ji} \neq 0 
  \end{cases} \\
  A &= W \odot \text{ReLU}( \grad p ) .
\end{align*}
You can refine the solution
\[ W = \argmin_W F\bigl( W \odot \text{ReLU}( \grad p ) , X \bigr). \]

[Note that this removes \emph{all} edges involved in a cycle --
that may be too much: I would remove one, or remove the weakest.]

\nextbook
\begin{book}
  \emph{Boosting differentiable causal discovery\\ via adaptive sample reweighting}\\
  A. Zhang et al.
\end{book}
Differentiable score-based causal discovery (e.g., \textsc{Notears}, Golem, GraN-DAG, GES)
relies too much on easy-to-fit samples:
\emph{ReScore} uses boosting
(fit the DAG, reweigh the samples, iterate).

\nextbook
\begin{book}
  \emph{CUTS: neural causal discovery\\ from irregular time series data}\\
  Y. CHeng et al.
\end{book}
Neural Granger causal discovery with missing values:
jointly (alternatively) impute missing values and fit the DAG (no instantaneous effect)
\begin{align*}
  & s_{\tau i j } \sim \text{Ber} ( 1 - m_{\tau i j } ) &&\text{DAG} \\
  & \hat x_t = f_\phi( X \odot S ) \\
  &\tilde x_t \leftarrow (1-\alpha) \tilde x_t + \alpha \hat x_t && \text{imputed values} \\
  & m_{\tau i j } = \sigma ( \theta_{\tau i j } ) \\
  & \sigma: \text{ sigmoid} \\
  & \theta, \phi \text{: parameters to estimate}
\end{align*}

\nextbook
\begin{book}
  \emph{Score matching enables causal discovery\\ of nonlinear additive noise models}\\
  P. Rolland et al.
\end{book}
The Hessian of the data log-likelihood can be used to identify the leaves of the DAG, and find a topological order.

The nonlinear additive (Gaussian) noise model
\[ X_i = f_i\bigl( \text{Pa}_i(X) \bigr) + \epsilon_i \]
is identifiable: the DAG can be recovered from the joint distribution of $X$ or, equivalently, from the score function
\[ s(x) = \nabla_{\!x} \log p(x) . \]

From Stein's identity
\[ \E_{ \mathbf x \sim p } \bigl[
  \mathbf h(x) \nabla \log p(\mathbf x ) ^\top + \nabla \mathbf h( \mathbf x ) 
  \bigr] = 0 \]
we can estimate the score at the sample points
\begin{align*}
  G &= \bigl( s( x^1) , \dots, s(x^n) \bigr) \\
  \hat G &= - ( K + \eta I )^{-1} \langle \nabla , K \rangle \\
  K_{ij} &= \mathbf h ( \mathbf x_i )^\top \mathbf h ( \mathbf x_j ) = \kappa( \mathbf x_i, \mathbf x_j ) \quad \text{RBF kernel} \\
  \langle \nabla K \rangle _{ij} &= \sum_{ k=1 }^n \nabla_{\!x_j^k} \kappa( \mathbf x_i , \mathbf x_k ).
\end{align*}

The leaves of the DAG are exactly the variables $j$ satisfying
\[ \var \left[ \dfrac{ \partial s_j(\mathbf x ) }{ \partial x_j } \right] = 0 : \]
to find a topological order,
iteratively remove the nodes $j$ with the smallest $\var[ \partial x_j / \partial x_j ]$
(you need to recompute the score after each removal).

To compute the Jacobian of the score, use the second order Stein identity
\[ \E[ h \nabla s ] = \E[ \nabla^2 h - h s s' ]. \]

\nextbook
\begin{book}
  \emph{Diffusion models for causal discovery\\ via topological ordering}\\
  P. Sanchez et al.
\end{book}
The Hessian of the data log-likelihood can be used to identify the leaves of the DAG, and find a topological order.

Instead of computing the Hessian with a second order Stein estimator
over an RBF kernel
(kernel methods scale poorly to a large number of observations),
DiffAn trains a neural net (diffusion -- denoising
uses score matching) to compute the score.
The model can be updated after each iteration (leaf removal) without retraining:
\[ \nabla \log p( \mathbf x_\ell) = \nabla \log p(x) - H_\ell \dfrac{ s_\ell }{ H_{\ell\ell} }. \]

\nextbook
\begin{book}
  \emph{Estimation of non-normalized\\ statistical models by score matching}\\
  A. Hyv\"arinen
\end{book}
To fit a non-normalized probability density
\[ p_\theta(\xi) = \dfrac{ q_\theta(\xi) }{ Z(\theta) }, \]
fit its score function
\[ \psi_\theta(\xi) = \nabla_{ \! \xi } \log p_\theta(\xi) = \nabla_{\!\xi} \log q_\theta(\xi)  \]
by minimizing
\[ J(\theta) = \dfrac12 \E_{ \xi \sim \text{data} } \n{
  \psi_\theta(\xi) - \psi(\xi)
}^2 . \]
We do not need to estimate the score function of the data, $\psi$:
expand the square and integrate by parts
\begin{align*}
  \int p(\xi) \psi(\xi) \psi_\theta(xi)^\top d\xi
  &= \sum_i \int p(\xi) \dfrac{ \partial \log p(\xi) }{ \partial \xi_i } \psi_\theta(\xi) _i d\xi \\
  &= \sum_i \int p(\xi) \dfrac1{p(\xi)} \dfrac{ \partial p(\xi) }{ \partial \xi_i } \psi_\theta(\xi)_i d\xi \\
  &= - \sum_i \int p(\xi) \dfrac{ \partial \psi_\theta(\xi)_i }{ \partial \xi_i } d\xi 
\end{align*}
and minimize
\[ \tilde J(\theta) = \dfrac1T \sum_t \sum_i
\dfrac{ \partial \psi_\theta(x_y) _i }{ \partial \xi_i }
+ \dfrac12 \psi_\theta(x_t)_i^2.
\]

\nextbook
\begin{book}
  \emph{DAG learning on the permutahedron}\\
  V. Zantedeschi et al.
\end{book}
% Not clear
One can learn a DAG in two steps:
\begin{compactitem}[--]
\item First, find a topological ordering, 
\item Then, find a DAG consistent with that ordering -- an upper triangular matrix.
\end{compactitem}
The \emph{permutahedron} is
\[ P_n = \text{Conv} \{ \rho^\sigma \ : \ \sigma \in \mathfrak S_n \} \]
where Conv is the convex hull,
\begin{align*}
  \rho &= [1,2,\dots,n] \\
  \rho^\sigma &= [ \sigma(1), \sigma(2), \dots, \sigma(n) ].
\end{align*}
The sorting operator
\[ \sigma(\theta) \in \argmax_{ \sigma \in \mathfrak S_n } \theta' \rho ^\sigma \]
can be relaxed to
\[ \mu(\theta) = \argmax_{ \mu \in P_n } \theta' \mu - \lambda \n{ \mu }_2^2 . \]

The combinatorial optimization problem
\[ \argmax_{ \alpha \in \Delta } s' \alpha \]
can be relaxed to the \emph{top-k sparsemax}
\[ \argmax_{\substack{
    \alpha \in \Delta \\ \n \alpha _0 \leq k
}} s' \alpha - \n{ \alpha }_2^2 \]
or the \emph{sparseMAP}, if $s$ has a low-dimensional parametrization $s = B' r$
\[ \argmax_{ \alpha \in \Delta } r' B \alpha - \n{ B \alpha }_2^2. \]

%TODO: PLOT?

\nextbook
\begin{book}
  \emph{SparseMAP:\\ differentialble sparse structured inference}\\
  V. Niculae et al. (2018)
\end{book}
The \emph{softmax} of $x \in \RR^n$ is the intersection of the half-line
$[0, \exp(x))$ with the probability simplex.

The \emph{sparsemax} is
the projection of $x$ onto the probability simplex.

The \emph{sparseMAP} generalizes this to other polytopes
(e.g., the permutahedron, the convex hull of permutation matrices).
\begin{align*}
  \text{softmax}\,\theta &= \argmax_{ y \in \Delta }
  \theta' y - \sum y_i \log y_i \\
  \text{sparsemax} \, \theta &=
  \argmax_{ y \in \Delta } \theta' y - \dfrac12 \n{ y }_2^2 \\
  &= \argmin_{ y \in \Delta } \n{ y - \theta }_2^2 \\
  \text{sparseMAP}_{M,N}(\eta) &= \argmax_{\substack{
      u \\
      u = My \\
      y \in \Delta \\
      \theta = [M \ N ] \eta 
  }}
  \theta' y - \dfrac12 \n{ M y }_2^2  
\end{align*}

\nextbook
\begin{book}
  \emph{Efficient marginalization of discrete and structured latent variables via sparsity}\\
  G.M. Correia et al.
\end{book}
% Top-k sparsemax
\begin{align*}
  \text{sparsemax}(s) &= \argmin_{ \xi \in \Delta } \n{ \xi - s }_2^2 \\
  \text{sparsemax}_k(s) &= \argmin_{\substack{
      \xi \in \Delta \\
      \n \xi _0 \leq k 
  }} \n{ \xi - s }_2^2 \\
  \text{sparseMAP}(s) &= \argmin_{ \xi \in \Delta } \n{ A \xi - s } _2^2
\end{align*}

