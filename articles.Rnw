\nextbook
\begin{book}
  \emph{Causality inspired representation learning\\ for domain generalization}\\
  F. Lv et al.
\end{book}
Define augmentations of an image in Fourier space, by keeping the phase,
and mixing the amplitude with that of another image.
\begin{align*}
  \mathscr F (x) &= A(x) e^{ - i P(x) } \\
  A( x^{\text{aug}} ) &= ( 1 - \lambda ) A(x) + \lambda A(x').
\end{align*}

Learn latent features $r$ such that
$\cor(r, r^{\text{aug}}) \approx I$.

Lean a mask $m = \text{GumbelSoftmax}(w)$
to distinguish between relevant (``causal'')
and irrelevant features:
the classifiers try to have good performance on both
$m\odot r$ and $(1-m)\odot r$,
while the mask tries to have good performance on $m \odot r$
and bad performance on $(1-m) \odot r$.
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=.7,inner sep=2pt,outer sep=0pt,baseline=0]
  \node (x1) at (0,5) {$x$};
  \node (x2) at (0,1) {$x$};
  \node[fill=blue!20] (g1) at (1,5) {$g$};
  \node[fill=blue!20] (g2) at (1,1) {$g$};
  \node (r1) at (2,5) {$r$};
  \node (r2) at (2,1) {$r^{\text{aug}}$};
  \node (C)  at (2,3) {$C = \cor( r, r^{\text{aug}} )$};
  \node (m1) at (3,6) {$m\odot r$};
  \node (m2) at (3,4) {$(1-m)\odot r$};
  \node (m3) at (3,2) {$m\odot r$};
  \node (m4) at (3,0) {$(1-m)\odot r$};
  \node[fill=blue!20] (h1) at (4,6) {$h_1$};
  \node[fill=blue!20] (h2) at (4,4) {$h_2$};
  \node[fill=blue!20] (h3) at (4,2) {$h_1$};
  \node[fill=blue!20] (h4) at (4,0) {$h_2$};
  \node (y1) at (5,6) {$\hat y_1$};
  \node (y2) at (5,4) {$\hat y_2$};
  \node (y3) at (5,2) {$\hat y_1^{\text{aug}}$};
  \node (y4) at (5,0) {$\hat y_2^{\text{aug}}$};
  \draw[->] (x1) -- (g1);
  \draw[->] (x2) -- (g2);
  \draw[->] (g1) -- (r1);
  \draw[->] (g2) -- (r2);
  \draw[->] (r1) -- (C);
  \draw[->] (r2) -- (C);
  \draw[->] (r1) -- (m1);
  \draw[->] (r1) -- (m2);
  \draw[->] (r2) -- (m3);
  \draw[->] (r2) -- (m4);
  \draw[->] (m1) -- (h1);
  \draw[->] (m2) -- (h2);
  \draw[->] (m3) -- (h3);
  \draw[->] (m4) -- (h4);
  \draw[->] (h1) -- (y1);
  \draw[->] (h2) -- (y2);
  \draw[->] (h3) -- (y3);
  \draw[->] (h4) -- (y4);  
\end{tikzpicture}
\]

\begin{align*}
  & \mathscr L_c = \n{ C - I } ^2 \\
  & \mathscr L_{\text{sup}} = \ell( \hat y_1, y ) + \ell( \hat y_1^{\text{avg}} , y ) \\
  & \mathscr L_{\text{inf}} = \ell( \hat y_2, y ) + \ell( \hat y_2^{\text{avg}} , y ) \\
  & \operatorname*{Minimize}_{ g, f_1, f_2 }
  \mathscr L_c + 
  \mathscr L_{\text{sup}} + 
  \mathscr L_{\text{inf}} \\
  & \operatorname*{Maximize}_{w}
  \mathscr L_{\text{sup}} -
  \mathscr L_{\text{inf}} 
\end{align*}

The \emph{Gumbel softmax} is an approximate, differentiable $k$-hot vector of size $N$;
it can be computed as follows.
\begin{align*}
  & \tau = 0.5 \\
  & N: \text{ size of the vector} \\
  & k: \text{ desired number of 1's} \\
  & p \in \Delta_N \text{ probability vector (to be learned)} \\
  & U_{ij} \sim \text{Unif}(0,1) \\
  & \xi_{ij} = - \log ( - \log U_{ij} ) \text{ Gumbel} \\
  & m_j = \max_i \dfrac{
    \exp \dfrac{ \log p_j + \xi_{ij} }{ \tau }
  }{
    \sum_{ j' }
    \exp \dfrac{ \log p_{j'} + \xi_{ij'} }{ \tau }
  }
\end{align*}

