\nextbook
\begin{book}
  \emph{Embedding and correlation tensor\ for XRP transaction networks}\\
  A. Chakraborty et al. (2022)
\end{book}
Take XRP transactions:
\begin{compactitem}[--]
\item For each week, compute a network, with wallets as nodes and transactions as edges; 
\item Compute node embeddings (deepwalk or node2vec);
\item Only keep nodes present each week; % look-ahead bias?
\item Compute the correlations
  \[ M_{ij}^{\alpha\beta} = \operatorname*{Cor}_{[ t-\Delta T, t + \Delta T ]} [ V_i^\alpha, V_j^\beta] \]
  where $i$, $j$ are nodes, and $\alpha$, $\beta$ coordinates.
\item Compute a double SVD
  \begin{align*}
    M_{ij}^{\alpha\beta} &= U_{ik} \Delta_k^{\alpha\beta} V_{kj} \\
    \Delta_k^{\alpha\beta} &= L^{\alpha \gamma} D_k^\gamma R^{\gamma\beta} \\
    \text{\ie, } M_{ij}^{\alpha\beta} &= D_k^\gamma ( U_{ik} V_{kj} ) ( L^{\alpha \gamma} R^{\gamma\beta} )
  \end{align*}
\end{compactitem}
\[
\begin{tikzpicture}[>=stealth,scale=.7,inner sep=1pt,outer sep=0pt,baseline=0]
  \begin{scope}[shift={(.5,0)}]
  \node[draw,inner sep=2pt] (M) at (0,0) {$M$};
  \node (a) at (135:1cm)  {$\alpha$};
  \node (b) at (45:1cm)   {$\beta$};
  \node (i) at (-135:1cm) {$i$};
  \node (j) at (-45:1cm)  {$j$};
  \draw (M) -- (a);
  \draw (M) -- (b);
  \draw (M) -- (i);
  \draw (M) -- (j);
  \end{scope}
  \node at (2,0) {$=$};
  \begin{scope}[shift={(3.5,0)}]
    \node[draw,inner sep=2pt] (D) at (0,0) {$D$};
    \node[draw,inner sep=2pt] (L) at (120:13mm)  {$L$};
    \node[draw,inner sep=2pt] (R) at (60:13mm)   {$R$};
    \node[draw,inner sep=2pt] (U) at (-120:15mm) {$U$};
    \node[draw,inner sep=2pt] (V) at (-60:15mm)  {$V$};
    \node[above=3mm of L] (a) {$\alpha$};
    \node[above=3mm of R] (b) {$\beta$};
    \node[below=3mm of U] (i) {$i$};
    \node[below=3mm of V] (j) {$j$};
    \draw (D) -- (0,.4) to[out=90,in=-90] (L);
    \draw (D) -- (0,.4) to[out=90,in=-90] (R);
    \draw (D) -- (0,-.4) to[out=-90,in=+90] (U);
    \draw (D) -- (0,-.4) to[out=-90,in=+90] (V);
    \draw (L) -- (a);
    \draw (R) -- (b);
    \draw (U) -- (i);
    \draw (V) -- (j);
    \node at (0,.7) {\scriptsize$\gamma$};
    \node at (.3,-.5) {\scriptsize$k$};
  \end{scope}
\end{tikzpicture}
\]

