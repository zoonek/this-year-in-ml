  \node (y) at (1,-.5) {$x_{k+1}$};
  \node[draw] (A) at (0,2) {$A$};
  \node[circle,inner sep=0pt,draw] (P) at (1,1) {\footnotesize$+$};
  \draw[->] (x) -- (1,3) -| (A);
  \draw[->] (x) -- (P);
  \draw[->] (P) -- (y);
  \draw[->] (A) |- (P);
  \node at (1,-1.5) {Euler\vphantom{Runge-Kutta}};
\end{tikzpicture}
\qquad\qquad
\begin{tikzpicture}[>=stealth,yscale=.6,xscale=.6,inner sep=1pt,outer sep=1pt]
  \node (x) at (2,6.7) {$x_k$};
  \node (y) at (2,0) {$x_{k+1}$};
  \node[draw] (A1) at (0,5) {$A$};
  \node[draw] (A2) at (1,4) {$A$};
  \node[draw] (A3) at (2,3) {$A$};
  \node[draw] (A4) at (3,2) {$A$};
  \node[circle,inner sep=0pt,draw] (P) at (2,1) {\footnotesize$+$};
  \node[circle,inner sep=0pt,draw] (P2) at (1,5) {\footnotesize$+$};
  \node[circle,inner sep=0pt,draw] (P3) at (2,4) {\footnotesize$+$};
  \node[circle,inner sep=0pt,draw] (P4) at (3,3) {\footnotesize$+$};
  \draw[->] (x) -- (2,6);
  \draw[->] (2,6) -| (A1);
  \draw[->] (2,6) -| (P2);
  \draw[->] (2,6) -| (P3);
  \draw[->] (2,6) -| (P4);
  \draw[->] (A1) |- (P);
  \draw[->] (A2) -- (P);
  \draw[->] (A3) -- (P);
  \draw[->] (A4) -- (P);
  \draw[->] (2,6) -- (4,6) -- (4,1) -- (P);
  \draw[->] (A1) -- (P2);
  \draw[->] (A2) -- (P3);
  \draw[->] (A3) -- (P4);
  \draw[->] (P2) -- (A2);
  \draw[->] (P3) -- (A3);
  \draw[->] (P4) -- (A4);
  \draw[->] (P) -- (y);
  \node at (2,-.667) {Runge-Kutta};
\end{tikzpicture}
\]
For the attention matrix $A$, either learn it (linear PDE),
or use
\[ A(X_i,X_j) = \text{Softmax} \dfrac{ ( W_k ' X_i )' (W_Q ' X_j) }{ d_k } \]
where $W_K$ and $W_Q$ are learned.

Try to re-wire the graph after each backward step by thresholding the attention.

\nextbook
\begin{book}
  \emph{Fit without fear: remarkable mathematical phenomena of deep learning\\ through the prism of interpolation}\\
  M. Belkin
\end{book}
Interpolating models, which overfit the data, may perform well out of sample.
Examples include:
\begin{compactitem}[--]
\item $k$-nearest neighbour with a singular kernel,
  $k(x,z) = \n{ x-z}^{-\alpha}$, $\alpha>0$ (or a logarithmic kernel)
\[
<<kNNSingularKernel,results='hide',echo=FALSE,fig.width=4,fig.height=2,out.width='.8\\hsize',fig.show='hold'>>=
## The plot in the paper used a logarithmic kernel
set.seed(2)
k <- 30
x <- runif(k,-1,2)
y <- x + .2 * rnorm(k)
k <- function(u,v, alpha=1)
  abs(u-v)^-alpha
f <- function(u, alpha=1) 
  sum( k(x,u,alpha) * y ) / sum( k(x,u,alpha) )
f <- Vectorize(f)
xs <- seq(0,1, length=1000)
op <- par( mar=c(0,1,0,1) )
ys <- f(xs,alpha=.5)
xs <- c(xs,x)
ys <- c(ys,y)
i <- order(xs)
xs <- xs[i]
ys <- ys[i]
i <- which( xs > 0 & xs < 1 )
xs <- xs[i]
ys <- ys[i]
ylim <- range(na.omit(ys))
d <- diff(range(ylim))
ylim <- ylim + .04*d*c(-1,1)
plot(xs, ys, type='l', lwd=3, axes=FALSE, xlab='', ylab='', col=dbColours[2], xlim = c(0,1), ylim = ylim )
points(x,y, pch=16)
#abline(0,1)
#box()
par(op)
@
\]
\item Random ReLU features, $f_w(x) = \sum w_k ( a_k x + b_k )_+$;
\[
\hspace*{-2mm}  
<<RandomReLUFeatures,results='hide',echo=FALSE,fig.width=6,fig.height=2,out.width='\\hsize',fig.show='hold'>>=

library(CVXR)

set.seed(3)

k <- 10
x <- seq(-.95,.95,length=k)
y <- abs(x) + .2 * rnorm(k)

op <- par( mfrow=c(1,3), mar=c(1,1,1,1) )

for( n in c(6, 18, 100) ) {

  a <- rep(1,n)
  b <- seq(-2,2,length=n)
  X <- t(pmax( a %o% x + b, 0 ))

  w <- Variable(n)
  loss <- norm2( y - X %*% w )
  penalty <- 1e-4 * norm2(w)
  p <- Problem( Minimize( loss + penalty ) )
  r <- solve(p)
  w <- r$getValue(w)

  d <- diff(range(y))
  plot(x, y, cex=2, pch=16, axes=FALSE, xlab='', ylab='', ylim=range(y) + .2*d*c(-1,1))
  xs <- seq(-1,1,length=1000)
  lines( xs, t(pmax( a %o% xs + b, 0 )) %*% w, col=dbColours[2], lwd=3 )
  points(x, y, cex=2, pch=16)
  box()
}
par(op)
@
\]
\item Random Fourier features
  \begin{align*}
    f_w(x) &= \sum_{k=1}^m w_k e^{ i \langle v_k , x \rangle } \\
    v_k &\overset{\text{iid}}{\sim} N(0,I) \quad \text{fixed} \\
    w &= \argmin_{ w\,:\, \forall i\, f_w(x_i) = y_i } \n w 
  \end{align*}
<<DoubleDescentMNIST01loss,results='hide',echo=FALSE,fig.width=6,fig.height=2,out.width='\\hsize',fig.show='hold'>>=
library(dslabs)
m <- NULL
try( m <- read_mnist("/tmp") )
if( length(m) == 0 ) {
  cat( "Downloading MNIST data" )
  read_mnist( download = TRUE, destdir = '/tmp' )
  m <- read_mnist( path = '/tmp' )
}

library(CVXR)
N <- 50  # The paper had 10_000; with 50, the model is actually random...
x <- m$train$images[1:N,]
y <- m$train$labels[1:N]

Y <- matrix(NA, nr=N, nc=10)
for( i in 0:9 )
  Y[,i+1] <- y == i

x_test <- m$test$images
y_test <- m$test$labels
Y_test <- matrix(NA, nr=length(y_test), nc=10)
for( i in 0:9 )
  Y_test[,i+1] <- y_test == i

ks <- c(10,20,50,100,200,500,1000)
ks <- unique( round( 10 ^ seq(0, 3, length=50)[-1] ) )
y1 <- y2 <- y3 <- NA * ks

for( i in seq_along(ks) ) {

  k <- ks[i]
  V <- matrix( rnorm(dim(x)[2] * k), nr = dim(x)[2], nc = k )

  X <- x %*% V
  X <- cbind( cos(X), sin(X) )

  W <- Variable( 2*k, 10 )
  Y_hat <- X %*% W
  loss <- norm2( Y_hat - Y )
  penalty <- 1e-4 * norm2(W)

  p <- Problem( Minimize( loss + penalty ) )
  r <- solve(p)
  W <- r$getValue(W)

  X_test <- x_test %*% V
  X_test <- cbind( cos(X_test), sin(X_test) )
  Y_test_hat <- X_test %*% W
  Y_test_hat - Y_test

  y1[i] <- r$getValue(loss)
  y2[i] <- sum( ( Y_test_hat - Y_test )^2 )
  y3[i] <- r$getValue(penalty)

  # Number of incorrectly classified
  #y1[i] <- ( dim(Y)[1] - sum( apply( Y, 1, which.max ) == apply( r$getValue(Y_hat ), 1, which.max ) ) ) / dim(Y)[1]
  #y2[i] <- ( dim(Y_test)[1] - sum( apply( Y_test, 1, which.max ) == apply( Y_test_hat, 1, which.max ) ) ) / dim(Y_test)[1]


  cat( "k=", k, "  train_loss=", y1[i], "  test_loss=", y2[i], "  penalty=", y3[i], "\n", sep='' )

}
op <- par( mfrow=c(1,3), mar = c(4,1,2,1) )
plot( ks, y1, type = 'l', lwd=3, col=dbColours[1], log = 'x', ylab='', xlab="Features", main = 'Train loss', axes=FALSE ); axis(1)
plot( ks, y2, type = 'l', lwd=3, col=dbColours[1], log = 'x', ylab='', xlab="Features", main = 'Test loss',  axes=FALSE ); axis(1)
plot( ks, y3, type = 'l', lwd=3, col=dbColours[1], log = 'x', ylab='', xlab="Features", main = 'Penalty',    axes=FALSE ); axis(1)
par(op)
@
\item Linear regression $\beta = X^\dag y$.
\end{compactitem}

In the under-parametried regime, we minimize the loss.
In the over-parametrized regime, we minimize some penalty
(it does not really matter which one) under the constraint that the loss be zero.
The test error exhibits a ``double descent'' pattern.

Since global minima form a (potentially curved) submanifold,
the problem is not locally convex. Instead, the \emph{PL condition}
suffices for gradient descent convergence:
\[ \forall w \qquad \dfrac12 \n{ \nabla \ell(w) }^2 \geq \mu \bigl[ \ell(w) - \ell(w^*) \bigr]. \]
It is non-local, but may be replaced by PL*, locally:
\[ \dfrac12 \n{ \nabla \ell(w) } ^2 \geq \mu \cdot \ell(w) \]
with $\mu = \lambda_{\text{min}(k)}$, where $k$ is the tangent kernel:
\[ k_{x,y}(w) = \bigl\langle \nabla_{\!w} f(x) , \nabla_{\!w} f(y) \bigr\rangle. \]

\nextbook
\begin{book}
  \emph{Decoupled weight decay regularization}\\
  I. Loshchilov and F. Hutter  (2019)
\end{book}
Gradient descent
$ \theta \leftarrow \theta - \alpha \nabla f(\theta) $
can be regularized with weight decay
\[ \theta \leftarrow (1-\lambda) \theta - \alpha \nabla f(\theta) . \]
For SGD, this is equivalent to $L^2$ regularization;
for Adam, it is not: weight decay works, $L^2$ regularization does not --
do not put it in the loss function, keep it separate. 

\nextbook
\begin{book}
  \emph{Lookahead optimizer:\\ $k$ steps forward, 1 step back}\\
  M.R. Zhang et al. (2019)
\end{book}
Iterate:
\begin{compactitem}[--]
\item Run the optimizer for $k$ steps, from $\phi_0 = \theta_t$ to $\phi_k$;
\item Update $\theta$ in the direction of $\phi_k$:
  $\theta_{t+1} = \phi_0 + \alpha ( \phi_k - \phi_0 )$.
\end{compactitem}
There is a principled way of choosing $\alpha$.

\nextbook
\begin{book}
  \emph{Unsupervised deep embedding\\ for clustering analysis}\\
  J. Xie et al. (2016)
\end{book}
Jointly learn a low-dimensional data representation and a clustering:
\begin{compactitem}[--]
\item Initialize the data representation with an autoencoder
  $x \mapsto z = f_\theta(x)$;
\item Initialize the cluster centroids $(\mu_j)_{1\leq j \leq k}$ ($k$ known), e.g., with $k$-means on the $z_i$'s';
\item Measure the similarity  between point $z_i$ and centroid $\mu_j$
  with a $t$ distribution (as with $t$-SNE) with $\alpha=1$ degrees of freedom,
  \[ q_{ij} \propto \bigl( 1 + \alpha^{-1} \n{ z_i - \mu_j }^2 \bigr) ^ { ( \alpha + 1 ) / 2 },
  \qquad \sum_j q_{ij} = 1; \]
\item As in self-training, define target distributions using the high-confidence predictions,
  \[ p_{ij} \propto q_{ij}^2 / f_j, \qquad f_j = \sum_i q_{ij} ; \]
\item Jointly optimize $\theta$ and $\mu$ to minimize
  \[ \sum_i \text{KL} ( p_i \| q_i ) = \sum_{ij} p_{ij} \log \dfrac{ p_{ij} }{ q_{ij} }. \]
\end{compactitem}

\nextbook
\begin{book}
  \emph{MLP-Mixer:\\ an all-MLP architecture for vision}\\
  I. Tolstikhin et al.
\end{book}
The MLP mixer processes images by splitting them into patches and successively applying two types of layers:
\begin{compactitem}[--]
\item MLP on the patch dimension (the same for all channels and offsets (columns));
\item MLP on the offset and channel dimensions (the same for each patch (row)).
\end{compactitem}

% 20 lines of JAX code

\nextbook
\begin{book}
  \emph{Patches are all you need}\\
\end{book}
Replace the MLP operations in MLP-mixer with convolutions.

\nextbook
\begin{book}
  \emph{Liquid time-constant networks}\\
  R. Hasani et al. (2021)
\end{book}
There are many variants of neural ODEs:
\begin{align*}
  &\text{NODE}   & \dfrac{ d x_t }{ dt } &= f_\theta( x_t, I_t, t ) \\
  &\text{CT-RNN} & \dfrac{ d x_t }{ dt } &= - \dfrac{ x_t }{ \tau } + f_\theta( x_t, I_t, t ) \\
  &\text{LTC}    & \dfrac{ d x_t }{ dt } &= - \dfrac{ x_t }{ \tau } + f_\theta( x_t, I_t, t ) (A-x_t)
\end{align*}
The effective time scale is no longer a constant $\tau$:
\[ \dfrac{ 1 }{ \tau_{\text{eff}} } = \dfrac1\tau + f.  \]

\nextbook
\begin{book}
  \emph{Bayesian algorithm execution: estimating computatble properties of black-box functions using mutual information}\\
  W. Neiswanger et al. (2021)
\end{book}
Bayesian optimization can be generalized to black-box algorithms $\mathscr A$
estimating some property of a function $f$
from a set of points $(x_1,y_1),\dots,(x_n,y_n)$ (execution path),
with increasing precision as $n\to\infty$:
optimization, numeric integraion, root finding.
Use the acquisition function
\[ \text{EIG}(x) = H[ \mathscr A | \text{Data} ] -
\!\!\!
\E_{ y_x \sim \text{GP}(\text{Data}) }
\!\!\!
H\bigl[ \mathscr A | \text{Data} \union \{(x,y)\} \bigr],
\]
approximated using the execution path and/or approximate Bayesian computation (ABC).

\nextbook
\begin{book}
  \emph{Fast and accurate network embeddings\\ via very sparse random projection}\\
  H. Chen et al. (2019)
\end{book}
Node embeddings are often computed in two steps:
\begin{compactitem}[--]
\item Form a node similarity matrix: DeepWalk, \ie, $A^k$, or, more generally,
  $\sum_{\ell=1}^k \alpha_\ell A^\ell$;
\item Reduce its dimension: SVD, or skipgram, \ie, factorization of
  \[ M_{uv} = \log \dfrac{ S_{uv} \cdot \va S }{ D_u \cdot D_v } - b . \]
\end{compactitem}
Use:
\begin{compactitem}[--]
\item A sparse ranfom projection
  \[ P_{ij} = \begin{cases}
    +\sqrt s & \text{with probability $1/2s$} \\
    0  & \text{with probability $1-1/s$} \\
    -\sqrt s & \text{with probability $1/2s$}
  \end{cases}
  \]
\item Normalize $A^k$ (its entries have a heavy-tailed distribution):
  \[ \widetilde{ A_{ij}^k } = A_{ij}^k \left( \dfrac{ d_j }{ 2m } \right) ^ {\lambda-1} \]
  where the normalization strength $\lambda-1$ is chosen by the user.
\end{compactitem}
Available in Neo4j.
\nextbook
\begin{book}
  \emph{Database-friendly random projections: Johnson-Lindenstrauss with binary coins}\\
  D. Achlioptas (2002)
\end{book}

\nextbook
\begin{book}
  \emph{Accurate intelligible models with pairwise interactions}\\
  Y. Lou et al. (2013)
\end{book}
Generalized additive models with interactions (GA\!$^2$M), aka
\emph{explainable boosting machines} (EBM)
can be estimated efficiently (greedily, after estimating and fixing the 1-dimensional functions,
and approximating the interactions on the residuals using cuts).

Implementation in \texttt{interpret} (R/Python).

\nextbook
\begin{book}
  \emph{Landscape of R packages for explainable artificial intelligence}\\
  S. Maksymiuk et al. (2021)
\end{book}
Start with \texttt{DALEX} (also available in Python), \texttt{flashlight} or \texttt{iml};
look at: feature importance (permutations), Shapley score, ceteris paribus curve, partial dependence plot.

(In Python: \texttt{aix360}, \texttt{eli5}, \texttt{interpret}, \texttt{lime}, \texttt{shap}, \texttt{skater}.)

\nextbook
\begin{book}
  \emph{AutoGL:\\ a library for automated graph learning}\\
  C. Guan et al.
\end{book}

\nextbook
\begin{book}
  \emph{Uncertainty, volatility and\\ persistence norms of financial time series}\\
  S. Rudkin et al. (2021)
\end{book}

\nextbook
\begin{book}
  \emph{Multilivel Monte Carlo methods}\\
  M.B. Giles
\end{book}
Monte Carlo variance reduction with control variates uses
\[ \E[f] = \E\bigl[ f - \lambda \bigl( g - \E[g] \bigr) \bigr] \]
where $\E[g]$ is known;
the optimal value of $\lambda$ is
\[ \lambda = \cor(f,g) \sqrt{ \dfrac{ \var f }{ \var g } }. \]

Two-level MLMC uses
$ \E[P_1] = \E[P_0] - \E[ P_1 - P_0 ] $
where $P_0$ is a cheap approximation of $P_1$
(and we have taken $\lambda=1$).

More generally, MLMC uses
\[ \E[ P_L ] = \E[ P_0 ] + \sum \E[ P_\ell - P_{\ell-1} ] \]
where the expectation at level $\ell$ uses
$N_\ell \propto \sqrt{ V_\ell / C_\ell }$
samples, and $V_\ell$, $C_\ell$ are the variance and cost of one sample.

Generalizations include:
\begin{compactitem}[--]
\item Randomized MLMC: use a fixed number $N$ of samples, but randomly select the level $\ell$ of each;
\item Richardson approximation;
\item Multi-index monte Carlo (time and space discretizations);
\item Non-geometric grid;
\item Quasi Monte Carlo.
\end{compactitem}

Applications include:
SDEs (Euler and Milstein),
L\'evy processes, SPDE,
nested simulations
\[ \E\nolimits_Z \bigl[ f\bigl( \E\nolimits_W [ g(Z,W) ] \bigr) \bigr]. \]

\emph{Parametric integration} is related:
to estimate $\E[ f_\lambda (X) ]$ as a function of $\lambda$,
first estimate $\E[f_0(X)]$, $\E[f_1(X)]$, then $\E[ f_{1/2}(X) ]$
using $(f_0+f_1)/2$ as a covariate
and continue recursively.

\nextbook
\begin{book}
  \emph{Multilevel Monte Carlo path simulation}\\
  M.B. Giles
\end{book}
% Original paper

\nextbook
\begin{book}
  \emph{Pair-copula constructions for financial applications: a review}\\
  K. Aas (2016)
\end{book}
Financial applications of vine copulas in finance include:
\begin{compactitem}[--]
\item VaR or CVaR for small portfolios;
\item Vine CAPM (with C-vines (stars) or R-vines (unconstrained));
\item Credit risk (probability of default), systemic risk (CDS),
  liquidity risk (bid-ask spread), operational risk;
\item Scenario generation, for CVaR optimization
  or multivariate option pricing.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Bayesian inference for latent factor copulas and application to financial risk forecasting}\\
  B. Schamberger et al. (2017)
\end{book}
In the 1-factor latent model,
$u_i \indep u_j \,|\, v$,
we can infer the values of $v$ (unobserved)
and of the copulas $c_j$ of $(u_j,v)$
(assuming their families,
Gaussian or Gumbel, are known,
and parametrizing them with the Fisher $z$ transform of their Kendall $\tau$'s,
$z = \tanh^{-1}(\tau)$)
with Gibbs sampling
and \emph{adaptive rejection metropolis sampling} (ARMS).

Application: portfolio VaR.

\nextbook
\begin{book}
  \emph{Asymmetric CAPM dependence\\ for large dimensions:\\ the canonical vine autoregressive model}\\
  A. Heinen and A. Valdesogo
\end{book}
As an alternative to the multivariate GARCH model,
for more than 30 assets,
use a $C$-vine (star-shaped),
whose bivariate copula parameter vary with time
in a DCC fashion, with GARCH residuals
