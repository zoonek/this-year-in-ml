\end{tikzpicture}
alone, the network is difficult to train).

Previous solutions used
complicated architectures (lattice networks),
or a gradient penalty followed a search for non-monotonicity (MILP, SMT).
  
\nextbook
\begin{book}
  \emph{How to address monotonicity\\ for model risk management}\\
  D. Chen and W. Ye
\end{book}
There are several notions of monotonicity between features
(e.g., past and present values of the same feature)
\begin{align*}
  \forall c \geq 0 & \ \ f(x) \leq f(x+c) \\
  \forall c \geq 0 & \ \ f(x,x+c) \leq f(x+c,x) \\
  \forall c \geq 0 & \ \ f(x,y+c) \leq f(x+c,y)
\end{align*}
(for instance, the probability of recidivism
is strongly monotonic wrt felonies and dismeanors).
For individual or weak monotonicity, used a GAM
with $f_i' \geq 0$ or $f_i' \geq f_j'$.
For strong pairwise monotonicity,
use a GAM or a NAM (neural additive model),
with univariate and bivariate features
(groves of NAMs, GNAM)
and penalties to ensure the required monotonicities.

\nextbook
\begin{book}
  \emph{LinSATNet:\\ the positive linear satisfiability neural networks}\\
  R. Wang et al. (2023)
\end{book}
The \emph{Sinkhorn algorithm} converts a positive matrix
$ S \in  \RR_{\geq0}^{m\times n}$
to a doubly stochastic one by alternatively normalizing its rows and columns to match marginal distributions
$u \in \RR_{\geq0}^m$, $v \in \RR_{\geq0}^n$.
It can be generalized to multiple sets of marginal distributions (it still converges).

To enforce constraints
$Ax \leq B$, $Cx \geq D$, $Ex=F$,
where $A$, $B$, $C$, $D$, $E$, $F$ have nonnegative entries,
to some input $y$,
apply the generalized Sinkhorn algorithm to $S$
\begin{align*}
  S &= \exp( W / \tau ) \\
  W &= \begin{bmatrix} y' & \beta \\ \beta \mathbf 1 ' & \beta \end{bmatrix} =
  \left[
    \begin{array}{c|c}
    y_1 \cdots y_\ell & \beta \\
    \hline
    \beta \cdots \beta & \beta
    \end{array}
    \right]
\end{align*}
with marginals encoding the constraints
\begin{align*}
  a'x &\leq b & u &= [a' \ b] & v &= \begin{bmatrix}b \\ a' \mathbf 1 \end{bmatrix} \\
  c'x &\geq d & u &= [c' \ \gamma d ] & v &= \begin{bmatrix} (\gamma+1) d \\ c' \mathbf 1 - d \end{bmatrix}
  & \gamma &= \left\lfloor \dfrac{ c' \mathbf 1 }{ d } \right\rfloor \\
  e' x &= f & u &= [ e' \ 0 ] & v &= \begin{bmatrix} f \\ e' \mathbf 1 - f \end{bmatrix}
\end{align*}
  
\nextbook
\begin{book}
  \emph{Autocoreset: an automatic practical\\ coreset construction framework}\\
  A. Maalouf et al.
\end{book}
% Fishy
A \emph{coreset} is a (weighted) subset of the training data on which
the loss function takes similar values.
Given a matrix $M \in \RR^{n\times m}$,
a vector summarization $\epsilon$-coreset is a subset
$J \subset [n]$ and a weight function
$w: J \to \RR_+$
such that
\[ \n{ \sum_{ i \in [n] } M_{i\bigcdot} - \sum_{j\in J} w(j) M_{j\cdot} }_2^2 \leq \epsilon. \]
Given
\begin{align*}
  & \theta_1,\dots,\theta_m \\
  & \text{Data} = \{x_1,\dots,x_n\}, \\
  & M_{ij} = \ell( x_i, \theta_j )
\end{align*}
iterate
\begin{align*}
  & (I,w) = \text{Coreset}_m(M) \\
  & \theta^* = \argmin_\theta \sum_{i\in I} w(i) f(x_i,\theta) \\
  & M_{i,m+1} = \ell( x_i, \theta^* ).
\end{align*}
  
\nextbook
\begin{book}
  \emph{Lowering the pre-training tax\\ for gradient-based subset training:\\
  a lightweight distributed pre-training toolkit}\\
  Y. Ro et al. (2023)
\end{book}
Pretrain using all the data, in a distributed fashion, as a model soup,
with each model trained independently on a subset of the data (to limit communication);
then, find a subset of the data with the same gradient distribution as the
whole data,
and finish training on that.
  
\nextbook
\begin{book}
  \emph{Compositional exemplars\\ for in-context learning}\\
  Y. Ye et al. (2023)
\end{book}
Determinantal point process (DPP) to select (with maximum a posteriori (MAP) estimators)
examples for few-shot learning.
\begin{align*}
  P(S) &= \dfrac{ \det L_S }{ \det( L _ I ) } \\
  L_{ij} &= k( a_i, a_j )
\end{align*}
modified to include a relevance term:
\begin{align*}
  a_i &: \text{ examplar} \\
  x &: \text{ task} \\
  r_i&= g( a_i , x ) \text{ relevance of $a_i$ to $x$} \\
  \tilde L &= \text{diag}(r) L \text{diag}(r) \\
  \log \det \tilde L_S &= \sum_{ i \in S } \log r_i^2 + \log \det L_S
\end{align*}

