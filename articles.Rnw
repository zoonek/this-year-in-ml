\begin{align*}
  I(X;Y|Z) &=
  \E_{ z \sim p_Z } \bigl[ I(X;Y) | Z = z \bigr] \\
  &= I(Y; X,Z) - I( Y; Z ) \\
  I(Z_1,\dots,Z_n | X ) &= \sum I( Z_i ; X | Z_1,\dots,Z_{i-1} ) \\
  \text{NMI}(X,Y) &= \dfrac{ I(X;Y) }{ \min\bigl( H(X), H(Y) \bigr) } \leq 1
\end{align*}
\begin{align*}
  X\to Y \to Z \text{ Markov} &\implies X \indep Z \,|\, Y \\
  &\implies I(X;Y) \geq I(X;Z)
\end{align*}

% 7. Linear algebra
\textbf{7.}
The \emph{induced norm} of a matrix $A \in \RR^{m\times n}$ is
\[ \n A _p = \max_{ \n x = 1 } \n{ A x }_p; \]
in particular,
\[ \n A _2 = \sqrt{ \lambda_{\text{max}}( A^\top A ) } = \max_i \sigma_i \]
is the largest singular value.

The \emph{nuclear norm} (or trace norm) is
\[ \n A _* = \tr \sqrt{ A^\top A } = \sum_i \sigma_i = \sum_i \va{ \sigma_i } = \n{ \sigma }_1;
\]
as an $L^1$ norm, it has a sparsifying effect on the singular values:
it encourages low-rank matrices.
The \emph{Shatten norm} generalizes it:
\[ \n A _p = \bigl( \sum \sigma_i^p \bigr)^{1/p} . \]
The \emph{Frobenius norm} is the $L^2$ norm of the entries of a matrix,
\[ \n A _F^2 = \n{ \operatorname{vec} A }_2^2 = \tr ( R^\top A) = \E_{ v \sim N(0,I) } \n{ A v }_2^2. \]

To invert (or compute the determinant) of a partitioned matrix
$\begin{pmatrix} * & * \\ * & * \end{pmatrix}$,
pre-multiply it by
$\begin{pmatrix} I & * \\ 0 & I \end{pmatrix}$
to get $\begin{pmatrix} * & 0 \\ * & * \end{pmatrix}$,
and post-multiply the result with
$\begin{pmatrix} I & 0 \\ * & I \end{pmatrix}$
to get
to get $\begin{pmatrix} * & 0 \\ 0 & * \end{pmatrix}$,
which is easier to invert;
the result contains \emph{Schur complements}
$E - F H^{-1} G$.
\[
\footnotesize
\begin{bmatrix} I & - F H^{-1} \\ 0 & I \end{bmatrix}
\begin{bmatrix} E & F \\ G & H \end{bmatrix}
\begin{bmatrix} I & 0 \\ - H^{-1} G & I \end{bmatrix}
=
\begin{bmatrix} E - F H^{-1} G & 0 \\ 0 & H \end{bmatrix}
\]
Using instead 
$\begin{pmatrix} I & 0 \\ * & I \end{pmatrix}$
and
$\begin{pmatrix} I & * \\ 0 & I \end{pmatrix}$
and equating the resulting formulas gives the \emph{Woodbury formula}
(inverse of a Schur complement)
\[ ( E - F H^{-1} G )^{-1} = E^{-1} + E^{-1} F ( H - G E^{-1} F )^{-1} G E^{-1} \]
(the matrix to invert on the rhs can have a different, smaller dimension).

Applications include
\begin{align*}
  \underset{N\times N}{ ( \Sigma + X X' )} ^{-1} &=
  \Sigma^{-1} - \Sigma^{-1} X
  \underset{ D \times D }{ ( I + X' \Sigma^{-1} X ) }
  ^{-1} X' \Sigma^{-1}, \\
  \intertext{the rank-1 update}
  (A + uv')^{-1} &=
  A^{-1} - \dfrac{ A^{-1} u v' A^{-1} }{ 1 + v' A' u } \\
  \intertext{and the distribution of a conditional Gaussian}
  X_1 | X_2 &\sim N(\bar \mu, \bar\Sigma) \\
  \bar\mu &= \mu_1 + \Sigma_{12} \Sigma_{22}^{-1} ( x_2 - \mu_2 ) \\
  \bar\Sigma &= \Sigma_{11} - \Sigma_{12} \Sigma_{22}^{-1} \Sigma_{21}.
\end{align*}

PCA whitening
\begin{align*}
  \Sigma &= \dfrac1N X' X = E D E' && \text{(eigendecomposition)} \\
  X &= U S V' && \text{(SVD)} \\
  W_{\text{pca}} &= D^{-1/2} E' \\
  Y &= \underset{N\times D}X \underset{D\times D}{ W_{\text{pca}} }
\end{align*}
ensures $\cov Y = I$, but we can add any rotation matrix;
\emph{Mahalanobis whitening} keeps the transformed data as close as possible
to the original
\[ W_{\textsc{zca}} = E D^{-1/2} E' = \Sigma^{-1/2} = V S^{-1} V'. \]

The Schur complement of 
$E$
in
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=12]
  \draw (0,0) rectangle (2,1);
  \draw (0,1.1) rectangle (2,3);
  \draw (2.1,1.1) rectangle (3,3);
  \draw (2.1,0) rectangle (3,1);
  \node at (1,.5) {$G$};
  \node at (2.5,.5) {$H$};
  \node at (1,2) {$E$};
  \node at (2.5,2) {$F$};
\end{tikzpicture}
is
\begin{align*}
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (2,2);
  \draw (0,2.2) -- (2,2.2);
  \node at (1,1) {$E$};
\end{tikzpicture}
&=
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=2]
  \draw (0,0) rectangle (1,1);
  \node at (.5,.5) {$H$};
\end{tikzpicture}
-
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=2]
  \draw (0,0) rectangle (2,1);
  \node at (1,.5) {$G$};
\end{tikzpicture}
\,
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (2,2);
  \node at (1,1) {$E$};
\end{tikzpicture}
^{-1}
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (1,2);
  \node at (.5,1) {$F$};
\end{tikzpicture} \\
\bar E &= H - G E^{-1} F.
\end{align*}
Similarly,
\begin{align*}
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (2,2);
  \draw (0,2.2) -- (2,2.2);
  \node at (1,1) {$H$};
\end{tikzpicture}
&=
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=2]
  \draw (0,0) rectangle (1,1);
  \node at (.5,.5) {$E$};
\end{tikzpicture}
-
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=2]
  \draw (0,0) rectangle (2,1);
  \node at (1,.5) {$F$};
\end{tikzpicture}
\,
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (2,2);
  \node at (1,1) {$H$};
\end{tikzpicture}
^{-1}
\begin{tikzpicture}[>=stealth,scale=.4,inner sep=1pt, outer sep=1pt,baseline=8]
  \draw (0,0) rectangle (1,2);
  \node at (.5,1) {$G$};
\end{tikzpicture} \\
\bar H &= E - F H^{-1} G.
\end{align*}

% 8. Optimization
\textbf{8.}
\emph{Gradient descent},
with learning rate $\eta<2/L$,
where $L$ is the Lipschitz constant of the gradient, is guaranteed to converge,
\[ \theta_{t+1} = \theta_t - \eta \nabla \mathscr L (\theta_t). \]

The \emph{Armijo-Goldstein condition}, for the stepsize ensure
sufficient reduction of the objective function without performing an exact line search,
\[ \ell( \theta_t + \eta d_t ) \leq \mathscr L(\theta_t) + c \eta d_t^\top \nabla \mathscr L ((\theta_t), \]
where $d_t$ is the descent direction, e.g., $-\nabla\mathscr L(\theta_y)$, and
$c=10^{-4}$.

\emph{Momentum} methods (heavy ball, Nesterov)
modify the descent direction using past (or extrapolated) gradients.

\emph{Second order} methods approximate 
Newton's method
\[ \theta_{t+1} = \theta_t  - \eta \bigl( \nabla^2 \mathscr L (\theta_t) \bigr)^{-1}
\nabla \mathscr L (\theta_t) \]
by using approximations of the Hessian (BFGS) or adding constraints
(trust region, if the Hessian is not positive semi-definite,
if the objective function is not convex).

To choose the learning rate, check the loss after a few epochs,
for several learning rates (e.g., in $[10^{-5},10^1]$).
Common learning rate schedules include
\begin{compactitem}[--]
\item Exponential decay;
\item Polynomial decay;
\item One cycle (linear warm-up, followed by cosine cool-down);
\item Cyclical learning rate.
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.2,inner sep=1pt,outer sep=0pt,baseline=0]
  \draw[thick, gray, densely dotted] (1,1) -- (7,1);
  \draw[thick, gray, densely dotted] (1,5.5) -- (7,2.5);
  \draw[very thick,blue!50!black] (1,1) -- (2,5) -- (3,1) -- (4,4) -- (5,1) -- (6,3) -- (7,1);
  \draw[->] (.5,0) -- (7.5,0);
  \draw[->] (.5,0) -- (.5,6);
  \node[anchor=north east] at (7.5,0) {\footnotesize epochs};
  \node[anchor=south] at (.5,6) {\footnotesize learning rate};
\end{tikzpicture}
\]
\end{compactitem}

Stochastic variance reduced gradient (\emph{SVRG})
uses a control variate:
a baseline value of the gradient, computed on the whole dataset,
updated once in a while.
\[ g_t = \nabla \mathscr L (\theta_t) - \nabla \mathscr L_t (\tilde\theta) + \nabla\mathscr L (\tilde\theta) \]

\emph{SAGA} is similar, but keeps track of the latest gradient
of each minibatch to progressively update the gradient.

\emph{Preconditioned} SGD
\[ \theta_{t+1} = \theta_n - \eta M_t^{-1} g_t \]
includes AdaGrad, RMSProp, AdaDelta, Adam;
non-diagonal preconditioners include full-matrix AdaGrad
\begin{align*}
  M_t &= \bigl[ (G_t G_t^\top )^{1/2} + \epsilon T \bigr] ^{-1} \\
  G_t &= [ g_1, \dots, g_1 ]
\end{align*}
and \emph{Shampoo} (a block-diagonal, Kronecker approximation).

The constrained optimization problem
\[ \operatorname*{Maximize}_\theta \mathscr L(\theta)
\text{ such that } g(\theta) \leq 0, \ h(\theta) = 0 \]
can be written
\[ \operatorname*{Minimize}_\theta \max_{\mu\geq0,\ \lambda}
\underbrace{
  \mathscr L(\theta) + \mu^\top g(\theta) + \lambda^\top h(\theta).
}_{L(\theta,\mu,\nu) \text{: generalized Lagragian}}
\]
If $\mathscr L$ and $g$ are convex,
the critical points satisfy the Karush-Kuhn-Tucker (KKT) conditions
\begin{align*}
  & g(\theta) \leq 0 , \ h(\theta) = 0 && \hspace*{-2.5cm}\text{feasibility} \\
  & \nabla \mathscr L(\theta) + \sum \mu_i \nabla g_i(\theta) + \sum \lambda_j \nabla h_j(\theta) = 0 \\
  & \mu \geq 0  && \hspace*{-2.5cm} \text{dual feasibility} \\
  & \mu \odot g = 0
\end{align*}

To optimize objective functions of the form
\[ \mathscr L(\theta) = \mathscr L_{\text{smooth}}(\theta) + \mathscr L_{\text{rough}}(\theta), \]
the \emph{proximal gradient} method uses
\[ \theta_{t+1} = \text{prox}_{\eta \mathscr L_{\text{rough}}} \bigl[
  \theta_t - \eta \nabla\mathscr L_{\text{smooth}}(\theta_t)
  \bigr] \]
where the proximal operator is
\begin{align*}
  \text{prox}_{\eta\mathscr L} (\theta)
  &= \argmin_z \left(
  \mathscr L(z) + \dfrac1{2\eta} \n{ z - \theta }_2^2
  \right) \\
  &= \argmin_z \mathscr L(z) \text{ such that } \n{z - \theta }_2 \leq \rho
\end{align*}
(where $\rho$ depends on $\eta$).
Examples include
\begin{compactitem}[--]
\item Projected gradient (hard constraint $\theta \in C$, \ie,
  $\mathscr L_{\text{rough}} = I_C$);
\item $L^1$ regularization (soft thresholding)
  \begin{align*}
    \text{prox}_{\lambda \n\cdot_1}(\theta)
    &= \argmin_x \n z + \dfrac1{2\lambda} (z - \theta)^2 \\
    &= \begin{cases}
      \theta - \lambda & \text{if } \theta \geq \lambda \\
      0                & \text{if } \va\theta \leq \lambda \\
      \theta + \lambda & \text{if } \theta \leq - \lambda
    \end{cases}
  \end{align*}
\item Quantization
  \[ \mathscr L_{\text{rough}}(\theta) =
  \inf_{\theta_0 \in C} \n{ \theta - \theta_0 }_1, \]
  where $C = \{\pm1\}^D$ (the proximal operator is a generalization of soft-thresholding: ProxQuant).
\end{compactitem}
  
The \emph{MM algorithm} (minorize-maximize) maximizes a function $\ell(\cdot)$ by using a surrogate function $G(\cdot,\cdot)$ such that
\begin{align*}
  Q(\theta,\theta') &\leq \ell(\theta) \\
  Q(\theta,\theta) &= \ell(\theta) 
\end{align*}
by iterating
$\displaystyle \theta_{t+1} = \argmax_\theta Q(\theta, \theta_t)$.

The \emph{EM algorithm} maximizes the likelihood of the observed data $y$ by marginalizing the unobserved (latent, missing) data $z$
\[ \ell(\theta) = \sum_n \log p(y_n|\theta) =
\sum_n \log \sum_z p(y_n, z|\theta) \]
by using Jensen's inequality
\begin{align*}
  \ell(\theta)
  &= \sum_n \log \sum_z q_n(z) \dfrac{ p(y_n,z|\theta) }{ q_n(z) } \\
  &\geq \sum_n \sum_z q_n(z) \log \dfrac{ p(y_n,z|\theta) }{ q_n(z) } \\
  &= \text{ELBO}(\theta, q_{1:N}) \\
  Q(\theta,\theta') &= \text{ELBO}\bigl(
  \theta, p(z_n|y_n,\theta)_{ n \in \llbracket 1, N \rrbracket}
  \bigr)
\end{align*}
It can be used to compute the MLE or MAP estimator
of a Gaussian mixture model.

% 9. Linear discriminant analysis
\textbf{9.}
A \emph{generative classifier} is a model of the form
\[ p(y|x) \propto p(x|y) p(y) \]
(as opposed to a discriminative classifier,
which models $p(y|x)$ directly).
For instance, Gaussian discriminant analysis uses
\[ X\,|\,Y=y \,\sim\, N(\mu_y , \Sigma_y); \]
if the covariance matrices $\Sigma_y$ do not depend on $y$,
this is \emph{linear discriminant analysis} (LDA);
if not, this is quadratic disriminant analysis (QDA).

\emph{Fisher linear discriminant analysis} (FLDA)
first reduces the dimension, choosing the projection giving the best classification possible.

The naive Bayes classifier assumes that the features are independent
when conditioned on the class label
\[ p(\mathbf x | y) = \prod_d p(x_d | y). \]

%% 10. Logistic regression
\textbf{10.}
(Binary) \emph{logistic regression} is a discriminative classification model
\[ Y \,|\,X=x \,\sim\, \text{Bernoulli} \bigl( \sigma(w'x+b) \bigr). \]
The gradient and the Hessian of the log-likelihood
can be computed explicitly;
Newton's method can be formulated as
an iteratively-reweighted least squares (IRLS) problem;
\emph{Fisher scoring} replaces the Hessian with its expectation,
the Fisher information matrix.

(Multinomial) logistic regression can be fitted with \emph{bound optimization}
(aka the MM algorithm)
\begin{align*}
  \ell(\theta) &= Q(\theta, \theta') \\
  Q(\theta, \theta') &= \ell(\theta') + (\theta - \theta') ^{\!\top} \nabla \ell(\theta') +
  \tfrac12 (\theta-\theta')^{\!\top} \!B (\theta-\theta') \\
  \theta_{t+1} &= \theta_t - B^{-1} \nabla \ell(\theta_t) 
\end{align*}
where $\forall \theta\ H(\theta) \succcurlyeq B$.
For binary logistic regression,
$B=-\tfrac14 X^\top X$ works.

Multinomial logistic regression
\( p(y|x) \propto \exp( w_y^\top x) \)
can be generalized to \emph{maximum entropy classifiers}
\[ p(y|x) \propto \exp\bigl[ w^\top \phi_y(x) \bigr] \]
(they are often used in NLP).

For consistent hierarchical classification (taxonomy),
add mutual exclusion constraints between sibling label nodes.

If there is a large number of classes, try a hierarchical softmax,
\ie, a tree of binary classifiers structured, e.g., with Huffman coding.

To deal with class imbalance, try:
\begin{compactitem}[--]
\item Logit adjustment; % ???
\item Resampling, to make the data more balanced;
  \[ p_y \propto N_y^q \qquad q \in [0,1] \]
\item Nearest mean classifier
  \[ f(x) = \argmin_y \n{
    \phi(x) - \operatorname*{Mean}_{ i : y_i = y} \phi(x_i)
    }_2^2 \]
  where $\phi$ are learned features, from a DNN,
  trained on the original, unbalanced data.
\end{compactitem}

To make logistic regression robust,
\emph{bitempered logistic regression}
\begin{compactitem}[--]
\item Uses \emph{tempered cross-entropy} as loss function,
  to reduce the influence of mislabeled points far away from the decision boundary;
\item Uses a \emph{tempered softmax}
  to reduce the influence of mislabeled points close to the decision boundary.
\end{compactitem}

For Bayesian logistic regression, use a Laplace approximation

% I have not read the rest of this chapter

% 11. Linear regression
\textbf{11.} Least squares regression can be fitted with:
\begin{compactitem}[--]
\item $\hat w = ( X' X )^{-1} X' y$; 
\item SVD (more numerically stable);
\item QR (faster if $X$ is tall);
\item Conjugate gradient (if $X \succcurlyeq 0$);
\item GMRES (if $X$ is sparse);
\end{compactitem}

The gradient and Hessian of the residual sum of squares are
\begin{align*}
  \nabla_w \text{RSS}(w) &= X'X w - X' y \\
  \nabla_w^2 \text{RSS}(w) &= X'X.
\end{align*}

Modeling $(X,Y)$ as a joint Gaussian and conditioning on $X$ is equivalent to linear regression
(only for Gaussian models).

\emph{Ridge} regression linear regression MAP)
can be fitted with standard OLS regression by adding
virtual data to account for the prior;
use empirical Bayes
\[ \lambda = \argmax_\lambda \log p(D|\lambda) \]
to choose the regularization parameter $\lambda$.

The \emph{lasso} is a MAP estimator with a Laplace prior;
it can lead to unstable results if some predictors are highly correlated
(sometimes including one, sometimes the other) --
the \emph{elasticnet} addresses that problem
(if there is a group of highly correlated predictors,
it tends to include either none or all of them, with comparable weights:
\emph{soft grouping}).

The lasso can be solved with:
\begin{compactitem}[--]
\item Coordinate descent (soft-thresholding, one coordinate at a time);
\item Projected gradient descent (after writing the lasso loss as a quadratic program,
  by splititng $w = w_+ - w_-$;
\item Proximal gradient descent (ISTA);
\item LARS (a continuation method, aka homotopy method)
  to get the whole regularization path: start with a large value of $\lambda$,
  so that the model only uses one predictor,
  progressively decrease $\lambda$
  (it is possible to find, analytically, the value of $\lambda$ when the set of predictors used changes);
\item LAR (a greedy simplification of LARS: it only adds predictors, but never removes them).
\end{compactitem}

For \emph{spline} regression, check \texttt{patsy.bs}.
B-splines use a fixed number of knots.
Smoothing splines use $N$ knots if there are $N$ data points
and add an $\ell^2$ regularization.

Generalized additive models (GAM) can be estimated with backfitting.

A Student (SGD, EM) or Laplace (LP) likelihood leads to
robust regression.
The Huber loss is faster.

RANSAC makes regression robust by fitting a model to a small subset of points,
using it to remove outliers,
and refitting the model on the inliers (with multiple restarts).

Bayesian linear regression generalizes ridge regression
(which is just a MAP estimator).

MAP with an empirical Bayes prior on the regression coefficients
results in a sparse estimate $\hat w$
(automatic relevancy determination, ARD, sparse Bayesian learning).

% 12. Generalized linear models
\textbf{12.}
A GLM is a conditional exponential family
\begin{align*}
  p(y | x,w,\sigma) &\propto h( y,\sigma^2) \exp \dfrac{ \langle y , w' x \rangle }{ \sigma^2} \\
  &= h(y,\sigma^2) \exp\dfrac{ \langle y, \eta \rangle - A(\eta ) }{ \sigma^2 } \\
  \eta &= w' x \text{ (natural parameter)} \\
  \E[ y | x,w,\sigma^2] &= A'(\eta) = \ell^{-1}(\eta) \\
  \var[ y|x,w,\sigma^2] &= A''(\eta) \sigma^2 \\
  \ell&\text{: link function}
\end{align*}

% 13.Neural nets for tabular data
\textbf{13.} The perceptron used a (non-differentiable) Heaviside activation function.

MLPs can be used for
\begin{compactitem}[--]
\item Heteroskedastic regression;
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.3,inner sep=1pt,outer sep=1pt,baseline=0]
  \node (x) at (0,3) {$x$};
  \node (y) at (0,0) {$y$};
  \node[draw,thick,text width=1em,text height=1ex] (A) at (1,3) {};
  \node[draw,thick,text width=1em,text height=1ex] (B) at (2,4) {};
  \node[draw,thick,text width=1em,text height=1ex] (C) at (2,2) {};
  \node (m) at (3,4) {$\mu$};
  \node (s) at (3,2) {$\sigma$};
  \node[anchor=west] (loss) at (4,1) {loss};
  \draw[->] (x) -- (A);
  \draw[->] (A) -- (B);
  \draw[->] (A) -- (C);
  \draw[->] (B) -- (m);
  \draw[->] (C) -- (s);
  \draw[->] (m) to[out=0,in=90,looseness=.8] (loss);
  \draw[->] (s) to[out=0,in=140,looseness=1] (loss);
  \draw[->] (y) to[out=0,in=200,looseness=1] (loss);
\end{tikzpicture}
\]
\item Classification (tabular/image/text data);
\item etc.
\end{compactitem}

Activation functions include:
ReLU, leaky ReLU, ELU, SELU, Swish (aka SiLU), GELU, etc.

Initialization schemes include Xavier (logistic), He (ReLU),
LeCun, LSUV (layer sequential unit variance:
start with orthogonal weight matrices, and rescale them so that the activations have unit variance on the first minibatch).

Rrgularization includes
early stopping,
weight decay,
sparsity (but prefer block-sparse matrices: GPUs are optimized for dense matrix operations),
dropout,
Bayesian neural nets,
(stochastic) gradient descent (implicit regularization).
%% entropySGD, sharpness aware minimization, stochastic weight averaging

Other feed-forward networks include:
\begin{compactitem}[--]
\item RBF networks:
  \begin{align*}
    y|x &\sim N( w' \phi_\mu(x) , \sigma_y^2 ) \\
    \phi_\mu(x) &= \bigl[ k(x,\mu_1), \dots, k(x,\mu_m) \bigr] \\
    k(x,\mu) &= \exp - \dfrac1{2\sigma_x^2} \n{ x - \mu }^2 
  \end{align*}
  (if the $\mu_i$'s are fixed, this is a linear regression);
\item Mixtures of experts
  (for multi-modal output distributions, one-to-many functions)
  \begin{align*}
    z &\sim \text{Cat} \bigl( \operatorname{Softmax} f(x) \bigr) \\
    y &\sim N\bigl( \mu_z(x), \sigma_z^2(x) \bigr)
  \end{align*}
\end{compactitem}

% 14. Neural networks for images (too superficial)
% 15. Neural networks for sequences (review)

% 16. Exemplar-based methods
\textbf{16.}
Distance-based methods, such as \emph{$k$-nearest neighbours},
suffer from the curse of dimensionality:
in high dimension,
the nearest point is far away, and all pairwise distances tend to be the same.
Efficient implementations can use k-d trees or LSH
(in Python, check \texttt{faiss}).

\emph{Metric learning} searches for a Mahalanobis matrix $M$
such that the distance
\[ d(x,x') = \sqrt{ (x-x')^\top M (x-x') } \]
works well when used for $k$-nn classification
(or such that samples in the same class are close
and samples in different classes are far apart).

This can be solved with semidefinite programming.
Alternatively, parametrize $M$ as $M = w' w$.

The probability that $j$ is the nearest neighbour of $i$ is
\[ p_{ij} \propto \exp- \n{ W x_i - W x_j }_2^2. \]
We can choose $W$ such that it maximizes the expected number of samples correctly classified with 1-nn (neighbourhood component analysis, NCA).
Latent coincidence analysis (LCA) estimates the model
\begin{align*}
  Z &\sim N( Wx, \sigma^2 I ) \\
  Z' &\sim N( W x' , \sigma^2 I ) \\
  P[y=y'] &= \exp - \n{ z - z' }^2
\end{align*}

\emph{Deep metric learning} (DML)
also learns an embedding and computes the distances in embedding space
(you can then remove $M$).

Losses for DML include
\begin{compactitem}[--]
\item Pairwise contrastive loss (hinge loss);
\item Triplet loss (may require hard negative mining);
\item $n$-pairs loss (InfoNCE).
\end{compactitem}

The word ``kernel'' has several (sometimes overlappping) meanings in statistics:
\begin{compactitem}[--]
\item A \emph{density kernel} is a function
  $\RR^n\times\RR^n \to \RR$
  with non-negative values, used for smoothing
  (kernel density estimation (KDE), kernel regression)
\item A \emph{positive definite kernel} is a function
  $\kappa: \RR^n \times \RR^n  \to \RR$, such that
  \[
  \forall  l \ \forall x_1,\dots,x_m \in \RR^n
  \ \ 
  \bigl( \kappa(x_i,x_j)\bigr)_{ i \leq i,j \leq m }^{\mathstrut}
  \succcurlyeq 0
  \]
  is positive definite;
  it is used for the ``kernel trick'';
\item The transition kernel of a Markov chain;
\item A convolution kernel;
\item etc.  
\end{compactitem}

% 17. Kernel methods
\textbf{17.}
Positive definite kernels (aka \emph{Mercer kernels})
correspond to feature maps:
for structured objects
(graphs, text, etc.), it may be easier to define kernels
than features (string kernel, random walk kernel).

Random features can approximate the RBF kernel.

% Gaussian processes
% SVM
% Sparse vector machines, relevance vector machines (?)

% 18. Trees, forests bagging, boosting
\textbf{18.}
Classification and regression trees (CART) are fitted greedily,
splitting the nodes by looking at:
\begin{compactitem}[--]
\item The Gini index (a generalized entropy -- the Herfindahl index);
\item The entropy (aka deviance).
\end{compactitem}

\emph{Bagging} uses random subsets of the data.
\emph{Random forests} also use random subsets of the variables.
\emph{Boosting} successively fits models on data weighted by the errors
made by the best linear combination of the models so far.
Bagging and random forests reduce the variance;
boosting reduces the bias.

% Gradient boosting
% xgboost
% Interpretation: feature importance, partial dependency plot

% 19. Learning with fewer labeled examples
\textbf{19.}
Empirical risk minimization (ERM) minimizes the expected loss
wrt the empirical distribution -- but a sum of Dirac masses is unlikely to be a good approximation of the population distribution.
Data augmentation attempts to address this problem (vicinal risk minimization).

\emph{Transfer learning} adapts a pretrained model
\begin{compactitem}[--]
\item By fine-tuning it;
\item By replacing its last layers;
\item By adding adjustment layers (``adapters'') inside.
\end{compactitem}

Self-supervised learning (SSL) often uses
\begin{compactitem}[--]
\item Imputation tasks (fill-in-the-blank);
\item Proxy tasks,  in particular \emph{contrastive tasks}:
  attempting to tell if two samples are related
  (e.g., augmentations of the same sample, or in the same class)
  or not (SimCLR).
\end{compactitem}

In \emph{transfer learning}, the input is similar, but the output is different.
In \emph{domain adaptation}, the inputs are different,
but the output labels are the same.
For instance, domain adversarial learning trains a classifier whose latent representation
is unable to distinguish between the source and target domains.

\emph{Self-training} with \emph{pseudo-labels}
(using predictions as labels for unlabeled data) suffers from
\emph{confirmation bias}: only keep pseudo-labels the model is confident in.
Co-training and tri-training estimate that confidence
by training several models,
either on (independent) sets of features, or on subsets of the data.

\emph{Entropy minimization} is another for of semi-supervised learning,
which implements the \emph{cluster assumption}:
the decision boundary should be in a low-density region of the data manifold.

\emph{Label propagation} is another semi-supervised learning technique:
build a similarity graph of samples,
and propagate the labels from the labeled samples. 

Data augmentation can also be applied to unlabeled data;
perturbations of a data point should not cause a large change in the output
(\emph{consistency regularization}).

Deep generative models, such as VAEs,
can also be leveraged for semi-supervised learning.
\[
\begin{tikzpicture}[>=stealth,xscale=1.5,yscale=1,inner sep=1pt,outer sep=1pt,baseline=0]
  \node (x) at (0,1) {$x$};
  \node (z) at (1,1) {$z$};
  \node (u) at (2,1) {$x$};
  \node (y) at (1,0) {$y$};
  \draw[->] (x) to node[above=0pt]{\footnotesize $q(z|x)$} (z);
  \draw[->] (z) to node[above=0pt]{\footnotesize $p(x|z)$} (u);
  \draw[->] (z) -- (y);
\end{tikzpicture}
\]

You can also train the discriminant of a GAN to output ``fake'' or the class label
(instead of ``fake''/``real'').

% MAML
% Few-shot learning

% 20. Dimension reduction
\textbf{20.}
To select the number of principal components to retain,
some suggest to look at the maximum of the \emph{profile likelihood}:
the likelihood of a Gaussian $N(\mu_1,\sigma^2)$ on
$\lambda_1 \geq \cdots \geq \lambda_L$
and $N(\mu_2,\sigma^2)$ on
$\lambda_{L+1}\geq\dots\geq \lambda_n$
(the two Gaussian have the same variance).

Factor analysis (FA)
\begin{align*}
  z &\sim N(\mu_0, \Sigma_0) \\
  x &= Wz + \mu + \epsilon \\
  \epsilon &\sim N(0,\Psi) 
\end{align*}
can be computed with the EM algorithm.

\emph{Probabilistic PCA} (PPCA) is the special case
$\Psi = \sigma^2 I$.
FA can be generalized:
non-linear FA, mixture FA,
exponential family FA, etc.

For paired data, check
\begin{compactitem}[--]
\item Supervised PCA
  \begin{align*}
    z &\sim N(0,I) \\
    x &= W_1 z + \epsilon & \epsilon &\sim N(0,\sigma_1^2I) \\
    y &= W_2 z + \epsilon & \eta     &\sim N(0,\sigma_2^2I)
  \end{align*}
\item Partial least squares
  \begin{align*}
    z_0 &\sim N(0,I) \\
    z_1 &\sim N(0,I) \\
    x &= W_1 z_0 + B z_1 + \epsilon & \epsilon &\sim N(0,\sigma_1^2I) \\
    y &= W_2 z_0 + \epsilon & \eta     &\sim N(0,\sigma_2^2I)
  \end{align*}
\item Canonical correlation analysis
  \begin{align*}
    z_0 &\sim N(0,I) \\
    z_1 &\sim N(0,I) \\
    z_2 &\sim N(0,I) \\
    x &= W_1 z_0 + B_1 z_1 + \epsilon & \epsilon &\sim N(0,\sigma_1^2I) \\
    y &= W_2 z_0 + B_2 z_2 + \epsilon & \eta     &\sim N(0,\sigma_2^2I)
  \end{align*}  
\end{compactitem}
Auto-encoders are non-linear generalizations of PCA;
the latent representation is usually a narrow bottleneck layer
\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.4,inner sep=1pt,outer sep=1pt,baseline=0]
  \draw[thick] (-1,-2) rectangle (-1.2,2);
  \draw[thick] (+1,-2) rectangle (+1.2,2);
  \draw[thick] (-.1,-1) rectangle (+.1,1);
  \draw[->] (-.9,1.8)  -- (-.2,1);
  \draw[->] (-.9,0)  -- (-.2,0);
  \draw[->] (-.9,-1.8) -- (-.2,-1);
  \draw[->] (.2,1) -- (.9,1.8);
  \draw[->] (.2,0) -- (.9,0);
  \draw[->] (.2,-1) -- (.9,-1.8);
  \node[anchor=north] at (-1,-2.1) {\footnotesize input};
  \node[anchor=north] at (0,-2.1) {\footnotesize latent};
  \node[anchor=north] at (1,-2.1) {\footnotesize output};
\end{tikzpicture}
\]
but one could use a larger layer, if it is regularized (noise, sparsity, etc.)
\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.4,inner sep=1pt,outer sep=1pt,baseline=0]
  \draw[thick] (-1,-1) rectangle (-1.2,1);
  \draw[thick] (+1,-1) rectangle (+1.2,1);
  \draw[thick] (-.1,-2) rectangle (+.1,2);
  \draw[->] (-.9,1)  -- (-.2,1.8);
  \draw[->] (-.9,0)  -- (-.2,0);
  \draw[->] (-.9,-1) -- (-.2,-1.8);
  \draw[->] (.2,1.8) -- (.9,1);
  \draw[->] (.2,0) -- (.9,0);
  \draw[->] (.2,-1.8) -- (.9,-1);
  \node[anchor=north] at (-1,-2.1) {\footnotesize input};
  \node[anchor=north] at (0,-2.1) {\footnotesize latent};
  \node[anchor=north] at (1,-2.1) {\footnotesize output};
\end{tikzpicture}
\]

% VAE

There are many \emph{manifold learning} algorithms:
\begin{compactitem}[--]
\item Multidimensional scaling (MDS -- actually PCA)
  \[ \operatorname*{Minimize}_z \sum \bigl(
  \langle \tilde x_i , \tilde x_j \rangle - 
  \langle \tilde z_i , \tilde z_j \rangle
  \bigr) ^2 \]
  where the $\tilde x_i$'s are the centered data points;
\item Metric MDS
  \[ \operatorname*{Minimize}_z \sum \bigl(
  \n{ x_i - x_j } - \n{ z_i - z_j }
  \bigr)^2 \]
\item
  Non-metric MDS
  \[ \operatorname*{Minimize}_{
    f \text{monotonic}, \ z
  }
  \dfrac{
    \displaystyle
    \sum \bigl[
    f\bigl( \n{ x_i - x_j } ) - \n{ z_i - z_j }
    \bigr]^2
  }{
    \displaystyle
    \sum \n{ z_i - z_j }^2
  }
\]
\item Sammon (metric MDS with more weight on shorter distances)
  \[ \operatorname*{Minimize}_z \sum
  \dfrac{ 
    \bigl(
    \n{ x_i - x_j } - \n{ z_i - z_j }
    \bigr)^2
  }{
    \n{ x_i - x_j }
  }
  \]
\item Isomap is MDS on the $k$-nearest neighbour graph of the datapoints
\item Kernel PCA (kPCA) is PCA on the Gram matrix for some kernel
\item Maximum variance unfolding (MVU)
  %\[ \operatorname*{Maximize}_z \sum \n{ z_i - z_j }^2
  %\text{ st }
  %\forall (i,j) \in G \ \n{z_i - z_j } = \n{ x_i - x_j }
  %\]
  \[ \begin{array}{ll}
    \text{Find} & z \\
    \text{To maximize} & \displaystyle \sum \n{ z_i - z_j }^2 \\
    \text{Such that} & 
    \forall (i,j) \in G \quad \n{z_i - z_j } = \n{ x_i - x_j }
  \end{array} \]
  where $G$ is the $k$-NN graph
  (this can be formulated as a semidefinite program)
\item Local linear embedding (LLE)
  \[ \operatorname*{Minimize}_z
  \sum_i \n{ z_i - \sum_j w_{ij} z_j } ^2 \]
  where the $w_{ij}$ are the barycentric coordinates of $x_i$ in the $k$-nn graph
  ($W$ is sparse)
  \[W = \argmin_w \sum \n{ x_i - \sum_{ i \sim j} w_{ij} x_j }^2
  \text{ st } \forall i \ \sum w_{ij} = 1 \]
\item Laplacian eigenmaps
  \[ \operatorname*{Minimize}_z \sum W_{ij} \n{ z_i - z_j }^2 \text{ st } W^\top D Z = I \]
  where
  \[ W_{ij} = \exp - \dfrac{ \n{ x_i - x_j }^2 }{ 2 \sigma^2 } \]
  if $i \sim j$ is in the $k$-nn graph
  (this is equivalent to the generalized eigenvalue problem
  $ L z_i = \lambda_i D z_i $, where $L = D - W$,
  and $D$ is the degree matrix $D_{ii} = \sum_{ij} W_{ij}$.
\end{compactitem}

\emph{Stochastic neighbour embedding} (SNE) replaces distances with probability distributions
\[ p_{j|i} \propto \exp - \dfrac{ \n{ x_i - x_j }^2 }{ 2 \sigma_i^2 } \]
(the probability that $j$ is a neighbour of $i$)
and looks for points $z_i$ with similar probability distributions
\[ q_{j|i} \propto \exp - \n{ z_i - z_j }^2 \]
(the variance is fixed)
as measured by the KL divergence
\[ \operatorname*{Minimize}_z \sum_i \text{KL}( p_i \| p_j ) =
\sum_{ij} p_{j|i} \log \dfrac{ p_{j|i} }{ q_{j|i} }. \]
Symmetric SNE uses
\[ \operatorname*{Minimize}_z \text{KL} ( p \| q ) \]
where
\[ p_{ij} \propto \exp - \dfrac{ \n{ x_i - x_j }^2 }{ \sigma^2 }. \]
T-distributed SNE (t-SNE) uses a Cauchy distribution
(Student $T$ with 1 degree of freedom) instead of a Gaussian
to limit over-crowding
\[ q_{ij} \propto \dfrac1{ 1 + \n{ z_i - z_j }^2 }. \]
The scales $\sigma_i$ are chosen so that the $p_i$'s have a
user-specified perplexity (\ie, entropy),
which can be interpreted as the effective number of neighbours.

UMAP is faster than t-SNE and tends to preserve the global structure better.

Latent semantic indexing (LSI) is a low-rank factorization of the term-document
(or tf-idf) matrix.

Latent semantic analysis (LSA) is the SVD of the word co-occurrence matrix,
or the PMI (pointwise mutual information) matrix
\[ \text{PMI}_{ij} = \log \dfrac{ p(i,j) }{ p(i) p(j) }
\quad \text{or} \quad
\max( \text{PMI}_{ij}, 0 ). \]

GloVe is a simplified , faster alternative to word2vec's skipgram.

% 21. Clustering
\textbf{21.}
There is no satisfactory way of assessing the quality of a clustering:
\begin{compactitem}[--]
\item Purity $= \sum _i \dfrac{ N_i }{ N } p_i , $
  where $N_i$ is the size of cluster $i$
  and $p_i$ its purity, \ie, the proportion of items belonging to the majority class
  (but this does not penalize the number of clusters);
\item Rand index: accuracy of the classifier of pairs, using ``are in the same cluster'' as a predictor of ``are in the same class'';
\item Adjusted Rand index, which compares the Rand index with its expected value;
\item Mutual information (but this does not penalize the number of clusters);
\item Normalized mutual information
  \[ \text{NMI}(U,V) = \dfrac{ I(U;V) }{ \tfrac12 \bigl[ H(U) + H(V) \bigr] }. \]
\end{compactitem}


% Hierarchical agglomerative clustering (HAC)
% k-means (aka vector quantization, VQ), k-means++, k-medoids
% Biclustering

To estimate the number of clusters, one could look at the distortion,
the silhouette, or (better) the BIC
(from the log marginal likelihood)
of a probabilistic model, e.g., a GMM (Gaussian mixture model).

The eigenspace, for the eigenvalue 0, of the (weighted) Laplacian
of a graph is spanned by the indicator vectors of its connected component.
\emph{Spectral clustering} is $k$-means in the span of the eigenvectors of the Laplacian
of the similarity matrix with the smallest eigenvalues
(prefer the normalized Lapalcian, $L_{\text{sym}} = D^{-1/2} L D^{-1/2}$.
It is a relaxation of the normalized cut problem.


% 22. Recommender systems
\textbf{22.}
Recommender systems can use:
\begin{compactitem}[--]
\item Matrix factorization (fitted with alternating least squares, ALS,
  or SGD, which handles missing values);
\item Auto-encoders $\hat Y = W^\top \phi( V Y )$;
\item Factorization machines
  \begin{align*}
    x &= [ \text{one-hot}(u), \text{one-hot}(i) ] \\
    f(x) &= \mu + \sum w_i x_i + \sum_{i < j} ( v_i^\top v_j ) x_i x_j 
  \end{align*}
\item Neural matrix factorization
  \begin{align*}
    & P_{u \bigcdot} , U_{u \bigcdot} \text{: user embeddings} \\
    & Q_{i \bigcdot} , V_{i \bigcdot} \text{: item embeddings} \\
    & z_{ui}^1 = P_{u\bigcdot} \odot Q_{i\bigcdot} \\
    & z_{ui}^2 = \text{MLP}\bigl( [ U_{u\bigcdot}, V_{i\bigcdot} ] \bigr)\\
    & \hat Y_{ui} = \sigma \bigl( w^\top [ z_{ui}^1, z_{ui}^2 ] \bigr)     
  \end{align*}
\end{compactitem}
They can also leverage implicit feedback
(if a user did not rate an item, they were not really interested in it).

% 23. Graph embeddings
\textbf{23.}
To compute node embeddings,
try to reconstruct the graph, using:
\begin{compactitem}[--]
\item A dot-product decoder,
  $\hat w = z z^\top$;
\item A distance decoder, $\hat w_{ij} = d(z_i,z_j)$,
  possibly with a Poincar\'e (hyperbolic) distance,
  \[ d(z_i, z_j) = \operatorname{arccosh} \left[
    1 + \dfrac{ 2 \n{ z_i - z_j }^2 }{ ( 1 - \n{z_i}^2 )( 1 - \n{z_j} ^2 ) }
    \right].
  \]
\end{compactitem}
For directed graphs, learn two embeddings per node:
a source and a target embedding.

DeepWalk, Node2Vec use a skipgram method on random walks to compute node embeddings.


%%%% AdiaLab causality award

\nextbook
\begin{book}
  \emph{Getting more for less:\\ better A/B testing via causal regularization}\\
  K. Webster (2022)
\end{book}
Price changes can be decomposed into market impact (caused by your trade)
and alpha (everything else).
You cannot estimate trade impact from actual trades:
they have alpha. You can estimate them from random (alpha-less) trades but,
since they are costly, you have very few of them.
Instead, estimate trade impact  on actual trades, but with a regularized model
(e.g., ridge regression), and use random trades to select the regularization parameter

\nextbook
\begin{book}
  \emph{Investment decisions\\ under almost complete causal ignorance}\\
  J. Simonian (2022)
\end{book}
The \emph{probability distance} between two DAGs is the number of conditional independencies
entailed by one and not by the other
(normalized by the number of possible independencies).
The \emph{counterfactual distance}  is the number of causes (pairs of nodes $(X,Y)$,
such that there exists a causal path $X \to \cdots \to Y$)
present in one but not in the other (normalized by the number of possible causes).
Take the sum of those two distances.

If you hesitate between several causal graphs,
you could pick that minimizing
$\lambda_i = \sum_{j\neq i} d(G_i,G_j)$.
Alternatively, you could build a strategy for each of them, investing $w_{ik}$ in asset $k$,
and build a portfolio, with weights $\sum_i w_{ik} x_k$,
maximizing $\sum_{ik} \lambda_i w_{ik} x_k$ (and subject to constraints of your choice).

\nextbook
\begin{book}
  \emph{Addendum on how many times\\ cointelated pairs cross paths}\\
  B. Mahdavi-Damghani and S. Roberts (2020)
\end{book}
The cointelation (sic) model allows for arbitrary short-term correlation (even $\rho=-1$)
and mean reversion ($\rho=1$) in the long term.
\begin{align*}
  \dfrac{ dX }{ X } &= \mu dt + \sigma dW_1 && \text{leading} \\
  dY &= \theta (X-Y) dy + \sigma Y dW_2 && \text{lagging} \\
  d\langle W_1, W_2 \rangle &= \rho dt
\end{align*}

\nextbook
\begin{book}
  \emph{Performance analysis\\ of matrix completion optimization\\ with applications to block causal inference}\\
  A. Capponi and M. Stojnic (2023)
\end{book}
Low-rank matrix completion (nuclear norm minimization) assumes the data is missing completely at random. If the missing data shows a block pattern (e.g., corresponding to a counterfactual treatment), recovery is still possible if
\[ \dfrac kn < 1 - 2 \sqrt{ \eta - \eta^2 }, \qquad \eta = \ell_1 / n. \]

\nextbook
\begin{book}
  \emph{A new entropic measure\\ for the causality of the financial time series}\\
\end{book}
% Not clear. Unlabeled axes
Granger causality asssumes numeric (univariate) time series.
For more complex data, such as ETF transaction imbalance,
\begin{compactitem}[--]
\item Convert the data to images (2-dimensional fingerprints,
  transaction rate vs imbalance dollar value);
\item Train a (convolutional) GAN to genetate similar data;
\item Measure if the data was easy to reproduce.
\end{compactitem}
\[ \operatorname{Mean} \log_2 \dfrac{
  \cos( \text{train}, \text{fake} )
}{
  \cos( \text{test}, \text{fake} )
}
\quad \text{or} \quad
\dfrac{
  \text{KL} ( \text{test} \| \text{fake} ) 
}{
  \text{KL} ( \text{train} \| \text{fake} )
}
\]

\nextbook
\begin{book}
  \emph{Forking paths in financial economics}\\
  G. Coqueret (2023)
\end{book}
Replace bootstrap samples by ``forking paths'',
\ie, (hundreds of) samples, obtained by varying the preprocessing options and the hyperparameters.
To check for $p$-hacking, look at the histogram of $p$-values (on a linear scale):
it should be (approximately) decreasing and convex.
There are several forms of $p$-hacking:
\begin{compactitem}[--]
\item Simple $p$-hacking looks for a ``path'' (preprocessing pipeline) with a good $p$-value;
\item Robust $p$-hacking looks for a path whose neighbourhood has good $p$-values, to provide robustness checks;
\item Vicious $p$-hacking is a variant also requiring robustness to $p$-hacking tests.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Estimating categorical counterfactuals\\ via deep twin networks}\\
  A. Vlontzos et al. (2021)
\end{book}
Causal inference is not limited to the study of \emph{interventions}
\[ \E\bigl[ Y \,|\,\text{do}(T=1) \bigr]; \]
we can also look at \emph{counterfactuals}
\[ \E\bigl[ Y \,|\, Y=0, \text{do}(T=1) \bigr]. \]
They can be estimated with Bayesian inference
on the \emph{twin network}: duplicate $T$ and $Y$; observe $T_1$ and $Y_1$;
intervene on $T_2$; compute the effect on $Y_2$.
\[
\begin{tikzpicture}[>=stealth,xscale=.8,yscale=1,inner sep=1pt,outer sep=1pt,baseline=0]
  \begin{scope}
    \node (T) at (0,0) {$T$};
    \node (Y) at (2,0) {$Y$};
    \node (Z) at (1,1) {$Z$};
    \node (U) at (2,1) {$U$};
    \draw[->] (T) -- (Y);
    \draw[->] (Z) -- (T);
    \draw[->] (Z) -- (Y);
    \draw[->] (U) -- (Y);
  \end{scope}
  \begin{scope}[shift={(4,0)}]
    \node (T) at (0,0) {$T$};
    \node (Y) at (2,0) {$Y$};
    \node (T2) at (0,2) {$T^*$};
    \node (Y2) at (2,2) {$Y^*$};
    \node (Z) at (1,1) {$Z$};
    \node (U) at (2,1) {$U$};
    \draw[->] (T) -- (Y);
    \draw[->] (T2) -- (Y2);
    \draw[->] (Z) -- (T);
    \draw[->] (Z) -- (Y);
    \draw[->] (U) -- (Y);
    \draw[->] (Z) -- (T2);
    \draw[->] (Z) -- (Y2);
    \draw[->] (U) -- (Y2);
  \end{scope}  
\end{tikzpicture}
\]

Unfortunately, the counterfactual is not always identifiable, e.g.,
\begin{align*}
  U &\text{: unobserved, 4-valued} \\
  T &\text{: binary}\\
  Y &=X, 0, 1 \text{ or } \neg X \text{, depending on $U$}
\end{align*}
where $U$ has distribution
$(\tfrac12, \tfrac16, \tfrac16, \tfrac16)$
or
$(\tfrac13, \tfrac13, \tfrac13, 0)$.
However, if $T\to Y$ is monotonic, counterfactuals are identifiable.
      
Train a neural network, whose architecture mimicks the twin network,
with a monotonicity constraint
(penalty, counter-example-guided learning, lattice network),
using domain-knowledge (or average treatment effect, ATE) to order the values of $T$.

\nextbook
\begin{book}
  \emph{Metastable financial markets}\\
  D. Marcondes and A. Simonis
\end{book}
The market can be modeled as a hidden Markov model (HMM),
e.g., with state space
\[ \{ \text{momentum up}, \text{momentum down} \} \times \{ \text{low vol}, \text{high vol} \}. \]
It is \emph{metastable}: there are clusters of states in which the market remains
a very long time
(there are low-probability connections between those clusters).

\nextbook
\begin{book}
  \emph{A changing stock-bond correlation:\\ explaining short-term fluctuations}\\
  G. Flannery
\end{book}
Forecast the short-term (3-month) correlation between stocks and bonds using:
\begin{compactitem}[--]
\item Whether individual investors' forecasts of stock and bond markets have the same sign;
\item Prospective inflation volatility;
\item Whether the signs of the 21-day changes in the 2-year and 10-year government yield have been the same in the past 3 months.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Linear and non-linear causality\\ in financial markets}\\
  H. Ma et al. 
\end{book}
% Not clear
Nonlinear generalizations of Granger causality include:
\begin{compactitem}[--]
\item \emph{Transfer entropy}
  \begin{align*}
    \text{TE}_{X\to Y} &= H( Y_{t+1}, Y_t ) + H( Y_t, X_t ) + \\
    &\hphantom{={}} - H( Y_{t+1}, Y_t, X_t) - H(Y_t)
  \end{align*}
  (divide by $\sqrt{ H(Y_{t+1},Y_t) H(X_{t+1},X_t) }$ to normalize to $[0,1]$);
\item Convergent cross-mapping % Not clear; computed from a delay embedding
\end{compactitem}
To separate linear and nonlinear dependence,
use \emph{Fourier transform surrogates}: 
start with a univariate series $x$,
compute its Fourier transform
randomize the phases, and compute the inverse Fourier transform $\tilde x$ --
this destroys the nonlinearities:
\[ \rho_{\text{linear}}(x,y) = \rho( \tilde x, \tilde y ) \]
(average over several surrogates).
%% Then they compute correlations of correlations of correlations -- confusing

Some systems exhibit spans of positive and negative correlations, e.g.,
\begin{align*}
  x_{t+1} &= x_t \cdot \bigl( r_x - r_x x_t - \beta_{y\to x} y_t \bigr) \\
  y_{t+1} &= y_t \cdot \bigl( r_y - r_y y_t - \beta_{x\to y} x_t \bigr) \\
\end{align*}
with $r_x=3.8$, $r_y=3.5$, $\beta_{y\to x}=0.02$, $\beta_{x\to y}=0.1$.

\nextbook
\begin{book}
  \emph{Modeling systemic risk: a time-varying nonparametric causal inference framework}\\
  J. Etesami et al.
\end{book}
To measure the causal relations between financial institutions,
from time series data,
try the ``directed information graph'',
which generalizes Granger causality by looking at the regret
(difference between a model with $X$ and one without),
\[ \text{DI}_{X\to Y} = \E_t \log \dfrac{
  \operatorname{P}[ Y_t = y_t | X_{<t} , Y_{<t}, Z_t ]
}{
  \operatorname{P}[ Y_t = y_t |         Y_{<t}, Z_t ]
} \]
where $Z$ are all the other variables.
It is the conditional mutual information
\[ E_t I( Y_t ; X_{<t} | Z_{<t} , Y_{<t} ) \]
(use a $k$-nn estimator).

\nextbook
\begin{book}
  \emph{Analyzing stock-bond correlation:\\ a dynamic causal system perspective}\\
  S. Du and Z. Zhang (2023)
\end{book}
The \emph{convergent cross mapping} method generalizes Granger causality $X\to Y$ as
$\cot(Y,\hat Y)$,
where $\hat Y$ is the forecast from a $k$-nn model (with Gaussian weights) on a delay embedding.
Use
$\text{CCM}_{ \text{Bonds} \to \text{Equities} }$ and
$\text{CCM}_{ \text{Equities} \to \text{Bonds} }$
to forecast $\cor( \text{Equities} , \text{Bonds} )$.

% The $S$-map is apparently a local linear regression  % Not clear
% \[ y_{t+p} \sim y_t + y_{t-1} + \cdots + y_{t-k+1}. \]

\nextbook
\begin{book}
  \emph{Causal network representations\\ in factor investing}\\
  C. Howard et al. (2024)
\end{book}
Use DyNoTears on the constituents of the S\&P 500.
Applications include:
\begin{compactitem}[--]
\item Clustering (Node2Vec + $k$-means), for peer group neutralization;
\item Long-short low centrality strategy;
\item Market timing with the network density average eccentricity):
  lower eccentricity heralds left skewed and leptokurtic returns
  (and sometimes market crashes).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Towards automating causal discovery\\ in financial markets and beyond}\\
  A. Sokolov et al. (2023)
\end{book}
Finance is not a closed, stationary system:
the causal graph changes over time.
LLMs can help -- they only need a textual description of the variables, no actual data --
the domain knowledge provided by LLMs can be used as prior for (score-based)
causal discovery algorithms, but they do not scale beyond 30 nodes.

To remedy this, ask an LLM to:
\begin{compactitem}[--]
\item Cluster the features;
\item Provide a label and a textual description for each cluster;
\item Provide a causal DAG between the clusters;
\item Provide a causal DAG (separately) within each cluster;
\item Review those DAGs and fix any mistake made.
\end{compactitem}

Then, one can take the product of the between-cluster DAG and the within-cluster DAGs.

Use do-calculus to assess the strength of eacg edge:
\begin{compactitem}[--]
\item Separately inside each cluster
\item For the between-cluster DAG, replace the features insode each cluster with their first principal component.
\end{compactitem}

\nextbook
\begin{book}
  \emph{On the three demons in causality in finance:\\ time resolution, nonstationarity\\ and latent factors}\\
  X. Dong et al.
\end{book}
Financial data pose a few problems for causal discovery:
\begin{compactitem}[--]
\item The observed data has a lower frequency than the causal data, and is often aggregated
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.8,inner sep=1pt,outer sep=1pt,baseline=0]
  \begin{scope}[every node/.style={
        anchor=base, text width = 1ex,
        text height = .5ex, text depth = .5ex,
        circle, draw, thick, densely dotted, align=center
    }]
  \node (A1) at (0,2) {};
  \node (A2) at (2,2) {};
  \node (A3) at (4,2) {};
  \node (A4) at (6,2) {};
  \node (B1) at (2,3) {};
  \node (B2) at (4,3) {};
  \node (B3) at (6,3) {};
  \node (B4) at (8,3) {};
  \end{scope}
  \begin{scope}[every node/.style={
        anchor=base, text width = 1ex,
        text height = .5ex, text depth = .5ex,
        circle, draw, thick, align=center
    }]
  \node (C2) at (3,1) {};
  \node (D2) at (3,0) {};
  \node (C4) at (9,1) {};
  \node (D4) at (9,0) {};
  \end{scope}
  \draw[->,thick] (A1) -- (B1);
  \draw[->,thick] (A2) -- (B2);
  \draw[->,thick] (A3) -- (B3);
  \draw[->,thick] (A4) -- (B4);
  \draw[->,thick] (A1) -- (A2);
  \draw[->,thick] (A2) -- (A3);
  \draw[->,thick] (A3) -- (A4);
  \draw[->,thick] (B1) -- (B2);
  \draw[->,thick] (B2) -- (B3);
  \draw[->,thick] (B3) -- (B4);
  \draw[->,thick,red!60!black] (A1) to[out=-50,in=155] (D2);
  \draw[->,thick,red!60!black] (B1) to[out=-45,in=90] (C2);
  \draw[->,thick,red!60!black] (A4) to[out=-50,in=155] (D4);
  \draw[->,thick,red!60!black] (B4) to[out=-45,in=90] (C4);
\end{tikzpicture}
\]
\item The data is not stationary -- adding a new variable, time, can help;
\item There are unobserved confounders;
  algorithms like FCI tend to output the most general graph
  (a clique for each latent variable),
  even when rank deficientcy suggests a simpler structure.
\[
