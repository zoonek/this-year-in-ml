\nextbook
\begin{book}
  \emph{Self-interpretable time series prediction with counterfactual explanations}\\
  J. Yan and H. Wang
\end{book}
CountTS is a variational Bayes model for time series tasks (classification, regression, etc.).

%TODO: PLOT (?)

\begin{align*}
  &\hspace*{-2cm}\text{Data generation:} \\
  u &\sim N(0,I) \\
  z &\sim N \bigl( \mu(u,x) , \sigma^2(u,x) \bigr) \\
  y &\sim N \bigl( \mu(u,z) , \sigma^2(u,z) \bigr) \\
  &\hspace*{-2cm}\text{Inference:} \\
  y &\sim x \\
  u &\sim x, y \\
  z &\sim x, y
\end{align*}

\emph{Feasible} counterfactual explanations only change non-constant parts of the input
(e.g., they do not suggest to change the age of the patient).
  
\nextbook
\begin{book}
  \emph{Sequential multi-dimensional self-suppervised learning for clinical time series}\\
  A. Raghu et al. (2023)
\end{book}
Use both a global and a cross-sectional
self-supervised learning (SSL) loss, e.g, NX-Xent (SimCLR)
\[
\operatorname{Mean}_i - \log \dfrac{
  \exp ( \text{sim}_{ij} / \gamma )
}{
  \sum_{ k \neq i } \exp ( \text{sim}_{ik} / \gamma )
}
\]
or VICReg.
  
\nextbook
\begin{book}
  \emph{Modeling temporal data as continuous functions with stochastic process diffusion}\\
  M. Bilo\v s et al.  (2023)
\end{book}
DDPM (denoising diffusion probabilistic model)
for time series in function space,
with noise given by
\begin{compactitem}[--]
\item A Gaussian process (GP) with RBF kernel
  $\kappa(\tau) = \exp( - \gamma \tau^2 )$;
\item An OR diffusion
  \[ d \epsilon_t = - \gamma \epsilon_t dt + d W_t, \]
  sampled as a time-changed, scaled Wiener process
  $\exp( - \gamma t ) W_{ \exp(2 \gamma t ) }$,
  \ie, a GP with a Mat\'ern kernel, $\nu=1/2$,
  $\kappa(\tau) = \exp - \gamma \va t $.
\end{compactitem}
Applications: forecasting and imputation,
for irregular time series.
  
\nextbook
\begin{book}
  \emph{Probabilistic imputation for time series classification with missing data}\\
\end{book}
VAE-like model for multiple imputation in time series, in the MNAR setup.

\nextbook
\begin{book}
  \emph{Sequential Monte Carlo learning\\ for time series structure discovery}\\
  F.A. Saad et al. (2023)
\end{book}
Particle filter (SMC) to select a GP kernel, from a probabilistic context-free grammar (PCFG)
\begin{align*}
  B &= \text{Linear} \,|\, \text{Periodic} \,|\, \text{Gamma} \,|\, \cdots \\
  \oplus &= + | \times | \,\text{ChangePoint} \\
  K &= B | ( K_1 \oplus K_2 )
\end{align*}
to model a univariate time series.
  
\nextbook
\begin{book}
  \emph{I\,$^2$SB: Image-to-image Schr\"odinger bridge}\\
  G.H. Liu et al.
\end{book}
The Schr\"odinger bridge generalizes diffusion models.
  
\nextbook
\begin{book}
  \emph{Provably convergent Schr\"odinger bridge\\ with applications to probabilistic\\ time series imputation}\\
  Y. Chen et al.
\end{book}
The Schr\"odinger bridge from measure $\mu$ to measure $\nu$
wrt the prior stochastic process $q$ is the stochastic process
\[ p = \argmin_{\substack{ p_0 = \mu \\ \ p_1 = \nu }} \text{KL}( p \| q ). \]
It generalizes diffusions.
\begin{align*}
  dx_t &= f( x_t, t ) dt + g(t) d W_t \\
  d x_t &= \bigl[ f(x_t,t) - g(t)^2 \nabla \log p_t(x_t) \bigr] dt + g(t) d \bar W_t \\[2mm]
  d x_t &= \bigl[ f(x_t,t) - g(t)^2 \nabla \log \vec\psi(x_t) \bigr] dt + g(t) d W_t \\
  d x_t &= \bigl[ f(x_t,t) + g(t)^2 \nabla \log \cev\psi(x_t) \bigr] dt + g(t) d \bar W_t \\  
\end{align*}

\nextbook
\begin{book}
  \emph{Regions of reliability in the evaluation\\ of multivariate probabilistic forecasts}\\
  \'E. Marcotte et al.
\end{book}
A \emph{scoring rule} measures if an observation $y \sim \mathscr D$
is consistent with a forecasted distribution $\hat{\mathscr D}$; for instance,
\begin{align*}
  \text{NLL}( y, \hat{\mathscr D} ) &= - \log p_{ \hat{\mathscr D} } (y) \\
  \text{ES}(  y, \hat{\mathscr D} ) &= \E_{ x \sim \hat{\mathscr D} }
  \n{ y - x } ^ 2 - \dfrac12 \E_{ x, x' \sim \hat{\mathscr D} } \n{ x - x' }^2 \\
  \text{CRPS}( y, \hat{\mathscr D} ) &=
  \int_{-\infty} ^ {+\infty} \bigl(
  \Phi_{ \hat{\mathscr D} } (x) - \mathbf 1 _{ x \geq y } \bigr) ^2 dx \\
  \text{VG}(y, \hat{\mathscr D}) &= \sum_{a,b} \left(
  \va{ y_a - y_b }^p - \E_{ x \sim \hat{\mathscr D} } \va{ x_a - x_b }^p 
  \right) ^2 \\
  \text{DS}(y, \hat{\mathscr D}) &= \log \va{ \det \Sigma_{ \hat{\mathscr D} } }
  + ( y - \mu_{ \hat{\mathscr D} } ) '
  \Sigma_{ \hat{\mathscr D} }^{ -1 }
  ( y - \mu_{ \hat{\mathscr D} } ) .
\end{align*}
A scoring rule $S$ is \emph{proper} if
\[ \forall \hat{\mathscr D} \ \E_{ y \sim \mathscr D } S( y, \mathscr D )
\leq \E_{ y \sim \mathscr D } S( y, \hat{\mathscr D} ). \]
With small samples, they may fail to spot forecasts with significant imperfections.
  
\nextbook
\begin{book}
  \emph{Learning the dynamics\\ of sparsely observed interacting systems}\\
  L. Bleistein et al. (2023)
\end{book}
Given a controlled differential equation (CDE)
$ d y_t = G( y_t, x_t ) dt$,
its solution map
$\Psi: ( x_{ [0,t] } , t ) \longmapsto y_t $
is linear in signature space:
$ \Psi( x_{ [0,t] } , t ) = S_N( x_{ [0,t] } ) ' \theta $.
The signature transform allows $x$ and $y$ to be irregularly observed time series;
$y$ can be sparser.
  
\nextbook
\begin{book}
  \emph{Sequential predictive\\ conformal inference for time series}\\
  C. Xu and Y. Xie (2023)
\end{book}
Conformal inference assumes the data is exchangeable: this assumption does not hold for time series.
One could adjust the significance level $\alpha$ to recover the desired coverage (AdaptCI),
or leverage the serial dependence
of the non-conformity scores with (random forest) quantile regressions (SPCI).
  
\nextbook
\begin{book}
  \emph{Resurecting recurrent neural networks\\ for long sequences}\\
  A. Orvieto et al. (2023)
\end{book}
Stacking linear recurrent units (LRU -- no non-linearity)
\begin{align*}
  x_t &= \text{diag}(\lambda) x_{t-1} + \gamma \odot u_t \\
  \lambda_j &= \exp\bigl( -e^{\nu_j} + i e^{\theta_j} \bigr) \\
  \gamma_j &= \sqrt{ 1 - \lambda_j ^2 } \\
  u &= \text{input}
\end{align*}
and non-linear MLP blocks recovers the long-range performance of S4.

\nextbook
\begin{book}
  \emph{Generalized teacher forcing\\ for learning chaotic dynamics}\\
  F. Hess et al. (2023)
\end{book}
To model (chaotic) dynamical systems and avoid exploding gradients, use:
\begin{compactitem}[--]
\item Generalized teacher forcing,
  $\tilde z_t = ( 1 - \alpha) z_t + \alpha \hat z_t $,
  where $z_t$ is from the model and $\hat z_t$ is observed;
\item A 1-layer RNN, with skip-connection, and clipped ReLU
\begin{tikzpicture}[>=stealth,xscale=.2, yscale=.18,inner sep=1pt,outer sep=0pt,baseline=-2]
  \draw (-1,0) -- (2,0);
  \draw (0,-.5) -- (0,1);
  \draw[very thick] (-1,0) -- (0,0) -- (1,1) -- (2,1);
\end{tikzpicture}
\end{compactitem}
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.7,inner sep=2pt,outer sep=1pt,baseline=17]
  \node (z) at (0,1) {$z_{t-1}$};
  \node[fill=blue!15] (w2) at (1,2) {$W_2$};
  \node[fill=blue!15] (w1) at (3,2) {$W_1$};
  \node[fill=blue!15] (phi) at (2,2) {$\phi$};
  \node[fill=blue!15] (A) at (3,0) {$A$};
  \node[circle,draw,inner sep=0pt] (p) at (4,1) {\footnotesize$+$};
