\nextbook
\begin{book}
  \emph{Non-parametric online market regime detection and regime clustering\\ for multidimensional and\\ path-dependent data structures}\\
  B. Horvath and Z. Issa (2023)
\end{book}
The maximum mean discrepancy (MMD) between probability distributions $p$, $q$
on a topological space $X$ is
\begin{align*}
  d(p,q) &= \sup_{ f \in \mathscr F } \E_{ x \sim p } \bigl[ f(x) \bigr] - \E_{y\sim q}\bigl[ f(y) \bigr] \\
  \hat d(p,q) &= \sup_{ f \in \mathscr F }
  \dfrac1n \sum_i f(x_i) - \dfrac1m \sum_j f(y_j)
\end{align*}
where $\mathscr F$ is a set of functions $X \to \RR$,
for instance, the unit ball of a RKHS -- this is then a distance, and
\begin{align*}
  \hat d(p,q) &=
  \dfrac1{ n(n-1) } \sum_{ i \neq j } \kappa( x_i , x_j )
  - \dfrac{ 2 }{ m n } \sum_{ i, j } \kappa( x_i, y_j ) + {}\\
  &\hphantom{{}={}}
  + \dfrac{ 1 }{ m(m-1) } \sum_{i \neq j } \kappa( y_i, y_j ).
\end{align*}


A RKHS on a set $X$ is the datum of:
\begin{compactitem}[--]
\item A vector space $\mathscr H$ of function $X \to \RR$;
\item A scalar product $\langle \cdot , \cdot \rangle$ on $\mathscr H$;
\item A positive definite function $\kappa : X \times X \to \RR$ such that:
  \begin{compactitem}[\ensuremath{\bigcdot}]
  \item $\bigl( \mathscr H , \langle \cdot,\cdot\rangle \bigr)$ is a Hilbert space;
  \item $\forall x \in X \ \kappa(\cdot,x) \in \mathscr H$
  \item $\forall x \in X \ \forall f \in \mathscr H
    \bigl\langle f , \kappa(\cdot , x ) \bigr\rangle = f(x)$.
  \end{compactitem}
\end{compactitem}

The \emph{signature kernel} is
\[ \kappa(x,y) = \bigl\langle S(x) , S(y) \bigr\rangle \]
where $S(x) \in T(\!(V)\!)$ is the signature transform
of $x : [0,1] \to V$.
It is the solution $\kappa(x,y) = f(1,1)$ of the hyperbolic PDE
\[ f(s,t) = 1 + \int_0^s \int_0^t f(u,v) \langle dx_u , dy_v \rangle_V \]
(there is no need to truncate the signature).

The \emph{kernel scoring rule} compares an observation $y$ with a probability distribution
\begin{align*}
  s(p,y) &= \E_{ x, x' \sim p } \kappa(x,x') - 2 \E_{ x \sim p } \kappa(x,y) \\
  \hat s(p,y) &= \dfrac{1}{n(n-1)} \sum_{i\neq j} \kappa(x_i, x_j) - \dfrac2n \sum_i \kappa(x_i,y)
\end{align*}
Apply to changepoint detection,
with time-augmented subpaths
(normalize the subpaths if needed).
\[ \begin{bmatrix}
  1      & x_i    & x_{i+1} & \cdots & x_{i+h_2-1} \\
  2      & \vdots & \vdots &        & \vdots \\
  \vdots & \vdots & \vdots &        & \vdots \\
  h_1    & x_{i+h_1-1} & x_{i+h_1} & \cdots & x_{i+h_1+h_2-2} 
\end{bmatrix} \]

