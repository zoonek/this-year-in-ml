\nextbook
\begin{book}
  \emph{Fast and flexible temporal point processes\\ with triangular maps}\\
  O. Schur et al. (2020)
\end{book}
A \emph{triangular map} is a map
$f : \RR^N \to \RR^N$
such that $f_i(x_1,\dots,x_n)$ only depends on $(x_1,\dots,x_i)$ and $f_i$ is increasing in $x_i$.
They are used in normalizing flows:
if $x \sim p$, then $F(x) \sim \tilde p$, with
\[ p(x) = \va{ \det J_F(x) } \tilde p \bigl( F(x) \bigr) =
\left( \prod \dfrac{ \partial f_i }{ \partial x_i } \right) \tilde p\bigl( F(x) \bigr) . \]
This formula is strangely similar to the likelihood of a temporal point process (TPP)
\begin{align*}
  p(t) &= \prod \lambda(t_i) \exp - \int_0^T \lambda(u) du \\
  &= \left( \prod \dfrac{ d\Lambda}{dt} (t_i) \right)
  \exp - \Lambda (T) 
\end{align*}
where $\Lambda(T) = \int_0^T \lambda(u) du$.

To sample, draw $z$ from a homogeneous Poisson process on $[0,\Lambda(T)]$
and compute $t=F^{-1}(z)$.

Examples include:
\begin{compactitem}[--]
\item Inhomogeneous Poisson processes:
  $\Lambda$ is deterministic and $F=\Lambda$ (elementwise);
\item Renewal processes: $\Lambda(t) = \Phi(t-t_1) + \sum_{ j \leq i } \Phi(t_j-t_i), $
  where $t_i$ is the last event before $t$,
  and $\Lambda = C \circ \Phi \circ D$,
  where
  \[
  D =
\left(\!\!\!  
\begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)}]
%\begin{tikzpicture}[baseline=(current bounding box.center)]
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells,
  row sep={3ex,between origins},column sep={3ex,between origins}
]{
  1 &&& 0 \\
  -1 \\
  \\
  0 && -1 & 1 \\
};
\draw (m-1-1)-- (m-4-4);
\draw (m-2-1)-- (m-4-3);
\end{tikzpicture}
\!\!\!\right)
  \]
  computes pairwise differences, $C=D^{-1}$ (cummulated sum) and $\Phi$ acts elementwise.
\item Modulated renewal process:
  \[ \Lambda(t) = \Phi \bigl( \Lambda(r) - \Lambda(t_i) \bigr) +
  \sum_{j\leq i} \Phi\bigl( \Lambda(t_j) - \Lambda(t_{j-1}) \bigr)
  \]
  and $F = C \Phi D \Lambda$.
\end{compactitem}

Use rational quadratic splines for $\Phi$ and $\Lambda$.

Generalize the model to $F = C \Phi_2 B_L \cdots B_1 \Phi_1 D \Lambda$
where the $B_\ell$ are lower-triangular block-diagonal matrices.

\nextbook
\begin{book}
  \emph{Eigengame: PCA as a Nash equilibrium}\\
  I. Gemp et al. (2020)
\end{book}
To find the first eigenvector  of a symmetric matrix $M = X' X$,
one can solve the optimization problem
\[ \begin{array}{ll}
  \text{Find} & v \\
  \text{To maximize} & \tfrac12 v' M v \\
  \text{Such that} & \n v = 1
\end{array} \]
with Oja's rule (Krasulina's algorithm):
\begin{align*}
  & M v && \text{gradient} \\
  & (I+vv') Mv && \text{projection of $Mv$ on $T\SS^{n-1}$} \\
  & v \leftarrow v + \eta (I+vv') Mv && \text{gradient step} \\
  & v \leftarrow v / \n v && \text{Projection on $\SS^{n-1}$} 
\end{align*}

This can be generalized to the top $k$ eigenvectors:
replace $\SS^{n-1}$ with the Stiefel maniold
and use Gram-Schmidt orthonormalization (matrix Krasulina).

We can recover the span of the top $k$ eigenvectors by solving
\[ \begin{array}{ll}
  \text{ Find} & V \in \RR^{n\times k} \qquad (k<n) \\
  \text{To maximize} & \tr ( V' M V) \\
  \text{Such that} & V' V = I.
\end{array} \]
For $k=n$, we want to maximize the trace, minimize the off-diagonal elements;
to recover the order of the eigenvectors, each is only penalized by the previous ones.
\begin{align*}
  v_1 & \leftarrow \argmax_{ v_1 ' v_1 = 1 } \langle v_1 , M v_1 \rangle \\
  v_2 & \leftarrow \argmax_{ v_2 ' v_2 = 1 } \langle v_2 , M v_2 \rangle -
  \dfrac{ \langle v_2 , M v_1 \rangle ^ 2 }{ \langle v_1 , M v_1 \rangle } \\
  v_i & \leftarrow \argmax_{ v_i ' v_i = 1 } \langle v_i , M v_i \rangle -
  \sum_{j<i} \dfrac{ \langle v_i , M v_j \rangle ^ 2 }{ \langle v_j , M v_j \rangle }
\end{align*}
(the constraints $v_i ' v_j = 0$ are redundant:
$\langle v_i M v_j \rangle = \lambda \langle v_i , v_j \rangle $
at the optimum.)
The $i$th objective can also be written
\begin{align*}
  u_i(v_i) &= \langle v_i , M v_i \rangle -   \sum_{j<i} \dfrac{ \langle v_i , M v_j \rangle ^ 2 }{ \langle v_j , M v_j \rangle } \\
  &= \n{ X v_i }^2 - \sum_{ j<i } \dfrac{ \langle X v_i , X v_j \rangle ^2 }{ \langle X v_j , X v_j \rangle }.
\end{align*}

PCA is the unique strict Nash equilibrium of this $k$-player differentiable game.
Solve with Riemannian gradient ascent on the sphere, sequentially or (asynchronously) in parallel.

\nextbook
\begin{book}
  \emph{Learning undirected graphs\\ in financial markets}\\
  J.V.M. Cardodo and D.P. Palomar (2020)
\end{book}
Do not learn a graph but its Laplacian $L = D - W$
\[ \begin{array}{ll}
  \text{Find} & L \\
  \text{To minimize} & \tr(LS) - \log \operatorname{gdet} L + h_\alpha(L) \\
  \text{Such that} & L \mathbf 1 = 0 \\
  & \forall i \neq j \quad L_{ij} = L_{ji} \leq 0 
\end{array} \]
where $S$ is the (detoned) correlation and gdet the pseudo-determinant
(the product of the nonzero (positive) eigenvalues).

To constrain the number of connected components
$k = \dim \ker L$, note that
\begin{align*}
  & \dim \ker L \geq k \ \Longleftrightarrow \ \sum_{i=1}^k \lambda_i(L) = 0 \\
  & \sum_{i=1}^k \lambda_l(L) = \min_{\substack{ V \in \RR^{p\times k} \\ V' V = I }} \tr( V' L V ).
\end{align*}
The resulting problem can be solved in an alternating fashion.
\[ \begin{array}{ll}
  \text{Find} & L \succcurlyeq 0 \\
  & V \in \RR^{p \times k } \\
  \text{To minimize} & \tr(LS) - \log \operatorname{gdet} L + \eta \tr( V'LV ) \\
  \text{Such that} & L \mathbf 1 = 0 \\
  & \forall i \neq j \quad L_{ij} = L_{ji} \leq 0 \\
  & \diag L = \mathbf 1 \\
  & V' V = I 
\end{array} \]

\nextbook
\begin{book}
  \emph{A step towards neural genome assembly}\\
  L. Vr\v cek et al. (2020)
\end{book}
De novo genome assembly looks for a path in a graph, avoiding short tips
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=1pt, outer sep=1pt]
  \foreach \i in {-2,...,3}
    \node[fill,circle] at (\i,0) {};
  \foreach[evaluate=\i as \j using int(\i+1)] \i in {-2,...,2}{
    \draw (\i,0) -- (\j,0);
  }
  \node[fill,circle] at (30:1) {};
  \node[fill,circle] at (1.707,.5) {};
  \draw (0,0) -- (30:1) -- (1.707,.5);
\end{tikzpicture},
transitive edges
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=1pt, outer sep=1pt]
  \foreach \i in {-3,...,2}
    \node[fill,circle] at (\i,0) {};
  \foreach[evaluate=\i as \j using int(\i+1)] \i in {-3,...,1}{
    \draw (\i,0) -- (\j,0);
  }
  \draw (-2,0) to[bend right=30]  (0,0);
  \draw (-2,0) to[bend left=45] (1,0);
\end{tikzpicture}
and choosing a branch in bubbles
\begin{tikzpicture}[>=stealth,xscale=.3,yscale=.2,inner sep=1pt, outer sep=1pt]  
  \foreach \i in {-3,-2,3,4}
    \node[fill,circle] at (\i,0) {};
  \foreach \i in {-1,...,2} {
    \node[fill,circle] at (\i,1) {};
    \node[fill,circle] at (\i,-1) {};
  }
  \foreach[evaluate=\i as \j using int(\i+1)] \i in {-1,0,1}{
    \draw (\i,1) -- (\j,1);
    \draw (\i,-1) -- (\j,-1);
  }
  \draw (-2,0) -- (-1,1);
  \draw (-2,0) -- (-1,-1);
  \draw (3,0) -- (2,1);  
  \draw (3,0) -- (2,-1);
  \draw (-3,0) -- (-2,0);
  \draw (3,0) -- (4,0);
  \draw (2,1) -- (3,1);
  \draw (0,-1) -- (-1,-2);
  \node[fill,circle] at (-1,-2) {};
  \node[fill,circle] at (3,1) {};
\end{tikzpicture}.

Use a GNN for each of those three problems.

\nextbook
\begin{book}
  \emph{Sanity checks for saliency maps}\\
  J. Adebayo (2018)
\end{book}
It is difficult to assess the quality of model explanations.
Saliency maps (gradient, gradient$\odot$input, integrated gradient, guided backprop, guided GradGAM, smoothGrad) are misleading:
they often give results similar to a simple (task-agnostic) edge detector -- compare them with an untrained model,
or a model with shuffled labels.

\nextbook
\begin{book}
  \emph{Coupling-based invertible neural networks are universal diffeomorphism approximators}\\
  T. Teshima et al. (2020)
\end{book}
A set $\mathscr M$ of functions $\RR^m \to \RR^n$ is a \emph{distributionlly universal approximator} if,
for all absolutely continuous measure $\mu$ on $\RR^m$,
for all measure $\nu$ on $\RR^n$,
there exists a sequence $ (g_i)_i$ in $\mathscr M$ such that
$g_i {}_* \mu \overset{d}{\underset{i\to\infty}{\longrightarrow}} \nu $.

\emph{Affine coupling flows} are transformations of the form
$\psi(x,y) = ( x, e^{s(x)} \odot  y + t(x) )$
(the exponential is elementwise).

Combining affine flows (with $y$ 1-dimensional) and invertible affine transformations
gives an $L^p$ universal approximator,
and therefore a distributionally universal approximator.

\nextbook
\begin{book}
  \emph{Ignorance is bliss: adversarial robustness\\ by design through analog computing\\ and synaptic asymmetry}\\
  A. Cappelli et al. (2020)
\end{book}
To fight adversarial attacks, insert a non-differentiable layer
(an optical processing unit (OPU), $m = \va{ R x }^2 $, $R$ random,
input and output quantized to 8 bits)
and use direct feedback alignment (DFA)
instead of backpropagation to differentiate through it.

\nextbook
\begin{book}
  \emph{Hard negative mixing for contrastive learning}\\
  Y. Kalantidis et al. (2020)
\end{book}
Contrastive learning (learning an embedding in which different augmentations of the same image are closer than those of another image)
benefits from better positive pairs (more data augmentation) or better negative paits
(SinCLR, MoCo): MoCHi creates synthetic negatives by
averaging two negative samples, or a negative and a positive sample.

\nextbook
\begin{book}
  \emph{SuperLoss:\\ a generic loss for robust curriculum learning}\\  
\end{book}
Early in training, downweight hard samples,
identified by a large loss,
(or a large loss with high confidence)
by changing the loss function.
% The formula looks wrong

\nextbook
\begin{book}
  \emph{Deep transformation invariant clustering}\\
  T. Monnier et al.
\end{book}
Image clustering often relies on latent representations.
Instead, work in pixel space, and jointly learn prootypes (for each cluster) and transformations
(to align each image to its prototype -- or the inverse).
It is an image (parametric) analogue of dynamic time warp (DTW).
\begin{align*}
  & \text{Clustering} &&
  \argmin_{ c_1 \dots c_K } \sum_i \ell\bigl( x_i, \{ c_1, \dots , c_K \} \bigr) \\
  & \text{TI clustering} &&
  \argmin_{ c_1 \dots c_K } \sum_i \min_{\beta_1 \dots \beta_K} \ell\bigl( x_i, \{ T_{\beta_1} c_1, \dots , T_{\beta_K} c_K \} \bigr) \\
  & \text{DTI clustering} &&
  \argmin_{\substack{  c_1 \dots c_K \\ f_1 \dots f_K }} \sum_i \ell\bigl( x_i, \{ T_{f_1(x_i)} c_1, \dots , T_{f_K(x_i)} c_K \} \bigr)
\end{align*}
The transformation parameters are computed by a neural network $f$.
Each transformation is a sequence of parametric transformations
$T_{\beta^1} \circ \cdots \circ T_{\beta^M}$, inclusing:
\begin{compactitem}[--]
\item Affine colour transformations; 
\item Spatial transformers networks; 
\item Morphological transformations, with the max and min of dilation and erosion replaced by softmax ($\alpha>0$)
  and softmin ($\alpha<0$).
  \[
  T(x)_{uv} = \dfrac{
    \sum\limits_{u'v'} x_{u+u' , v+v'}  \cdot a_{u+u' , v+v'}  \cdot \exp \alpha x_{u+u' , v+v'} 
  }{
    \sum\limits_{u'v'} a_{u+u' , v+v'}  \cdot \exp \alpha x_{u+u' , v+v'} 
  }
  \]
\end{compactitem}
The loss function can be from $k$-means of a Gaussian mixture (GMM).
During training:
\begin{compactitem}[--]
\item Reassign tiny clusters to a noisy copy of the largest cluster;
\item Progressively add more complex transtormations (curriculum learning).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Image analysis using mathematical morphology}\\
  R.M. Haralich et al. (1987)
\end{book}

\nextbook
\begin{book}
  \emph{Spatial transformer network}\\
  M. Jaderberg et al. (2016)
\end{book}
Transform an image with a parametric transformation $T_\theta$
(affine, projective, peicewise affine, thin plate spline)
with the parameters computed from the image itself:
\[ x \longmapsto T_{\theta(x)} (x). \]

\nextbook
\begin{book}
  \emph{Learning energy-based models\\ by diffusion recovery likelihood}\\
  (ICLR 2021)
\end{book}
An energy-based model (EBM)
$p_\theta(x) = f_\theta(x) / Z_\theta$
can describe a distribution on images $x$ (use a CNN for $f_\theta$):
training is done with the gradient
\[ \E_{ x \sim \text{data} } \dfrac{ \partial f_\theta(x) }{ \partial \theta } - \E_{ x \sim p_\theta } \dfrac{ \partial f_\theta (x) }{ \partial \theta } \]
and sampling with Langevin Monte Carlo
\[ x_{t+1} \leftarrow x_t + \dfrac{ \delta^2 }2 \nabla_{\!x} f_\theta(x_t) + \delta \epsilon_t \]
but convergence is slow.

\emph{Recovery likelihood}, from a noisy image $\tilde x = x + \sigma \epsilon$
(or $\tilde x = a x + \sigma \epsilon$, $a$, $\sigma$ constants)
is easier to sample from (less multimodal)
\[ p(x|\tilde x) = \dfrac{
  \exp \biggl[
    f_\theta(x) - \dfrac{ \n{ \tilde x - x } ^ 2 }{2\sigma^2}
    \biggr]
}{
  \tilde Z_\theta( \tilde x )
}
\]
Use a sequence of EBMs, trained on increasingly noise versions of the dataset.

\nextbook
\begin{book}
  \emph{Score-based generative modeling\\ through stochastic differential equations}\\
  (ICLR 2021)
\end{book}
Score-based generative models consider a sequence of noise scales
$\sigma_1 < \cdots < \sigma_N$,
going from the data distribution $p_{\text{data}}$ to near-Gaussian noise
$p_{\text{data}} * N(0,\sigma_N I)$,
and learn a score function $s_\theta$ minimizing
\[
%\operatorname*{Minimize}_\theta
\sum_i \sigma_i^2 \E_{ s \sim \text{Data} }
\E_{ \tilde x \sim p_{\sigma_i} ( \tilde x | x ) }
\n{
  s_\theta( \tilde x , \sigma_i ) -
  \nabla_{\!\tilde x} \log p_{\sigma_i} ( \tilde x | x ) 
}^2
\]
Stochastic differential equations (SDE)
provide a continuous generalization,
progressively adding noise to an image with a diffusion
\[ dx = f(x,t) dt + g(t) dW \]
and removing it with the \emph{reverse-time SDE}
\[ dx = \bigl[ f(x,t) - g^2(t) \nabla_{\!x} \log p_t(x) \bigr] dt + g(t) dW. \]

\nextbook
\begin{book}
  \emph{Reinforcement learning upside down:\\ don't predict rewards, just map them to actions}\\
  J. Schmidthuber (2019)
\end{book}
UDRL learns a mapping
\[ ( \text{state}, \text{horizon} , \text{reward} ) \longmapsto \text{action} \]
using training data from the past
\[ ( s_1, t_2-t_1, r_{[t_1,t_2]}, a_{[t_1,t_2]} ) \]
and extrapolate (use it to find actions leading to a higher reward in a shorter time frame).

\nextbook
\begin{book}
  \emph{Extrapolation towards imaginary 0-nearest neighbour and its improved convergence rate}\\
  A. Okuno and H. Shimodaira (2020)
\end{book}
The $k$-nearest neighbour classifier is a weighted average, often with positive constant weights --
but real weights can remove the bias and improve convergemce.

Instead, the multiscale $k$-NN uses adaptive weights, by extrapolating the values as $k\to0$,
with a linear regression
$k$-NN $\sim$ distance$_k^2$.

\nextbook
\begin{book}
  \emph{It is not what machines can learn,\\ it is what we cannot teach}\\
  G. Yehuda et al. (2020)
\end{book}
Deep learning cannot solve NP-complete problems from data:
that would require non-polynomial data generation.

\nextbook
\begin{book}
  \emph{Movement pruning:\\ adaptive sparsity by fine-tuning}\\
  V. Sanh et al. (2020)
\end{book}
For transfer learning, do not prune small weights, but weights that move towards zero when fine-tuning.
\[
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=1pt, outer sep=1pt]
  \fill[blue!20] (-1,-2) -- (1,-2) -- (1,2) -- (-1,2) -- cycle;
  \draw[->] (-2,0) -- (2.4,0);
  \draw[->] (0,-2) -- (0,2.4);
  \node[anchor=south] at (0,2.4) {\footnotesize a\rlap{fter}};
  \node[anchor=south] at (2.4,0) {\footnotesize b\rlap{efore}};
\end{tikzpicture}
\qquad
\qquad
\qquad
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=1pt, outer sep=1pt]
  \fill[blue!20] (-2,0) -- (-2,-2) -- (2,2) -- (2,0) -- cycle; 
  \draw[->] (-2,0) -- (2.4,0);
  \draw[->] (0,-2) -- (0,2.4);
  \node[anchor=south] at (0,2.4) {\footnotesize a\rlap{fter}};
  \node[anchor=south] at (2.4,0) {\footnotesize b\rlap{efore}};
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{On ranking via sorting\\ by estimated expected utility}\\
  C. Calauz\`enes and N. Usunier (2020)
\end{book}
Learning-to-rank loss functions include
\begin{compactitem}[--]
\item The discounted cummulated gain
  \[ \text{DCG}_p = \sum_{i=1}^p \dfrac{ \text{relevance}_i }{ \log(1+i) } \]
\item The expected reciprocal rank, the expectation of the inverse of the ranl of the first relevant result,
  $\E[1/\text{rank}]$, which encourages diversity.
\end{compactitem}
A loss is compatible with expected utility iff the set of optimal ranking is connected (by transpositions of adjacent items).  

\nextbook
\begin{book}
  \emph{Tight nonparametric convergence rates\\ for stochastic gradient descent\\ under the noiseless linear model}\\
  R. Berthier et al. (2020)
\end{book}
Kernel SGD performs interpolation as
\[ f_k \leftarrow f_{k-1} - \gamma \bigl( f_{k-1}(x_k) - y_k \bigr) k(\cdot, x_k). \]
% Too technical

\nextbook
\begin{book}
  \emph{Leverage the average:\\ an analysis of KL regularization in RL}\\
  N. Vieillard et al. (2020)
\end{book}
Add the following penalties:
\begin{compactitem}[--]
\item Entropy, $\tau H(\pi)$, to penalize deterministic policies; 
\item Kullback-Leibler $ - \lambda \text{KL}(\pi\|\pi_k)$, to remain close to the previous policy.
\end{compactitem}
\nextbook
\begin{book}
  \emph{Munchausen reinforcement learning}\\
  N. Vieillard et al. (2020)
\end{book}
Augment the reward with the log-policy:
\[ r(s,a) \rightsquigarrow r(s,a) + \alpha \log \hat \pi (s|a). \]
For the optimal policy:
\[
\log \pi^*(a|s) = \begin{cases}
  0 & \text{if $a$ is optimal} \\
  -\infty & \text{otherwise}.
\end{cases}
\]

\nextbook
\begin{book}
  \emph{Neumiss networks: differentiable programming for supervised learning with missing values}\\
  M. Le Morvan et al. (2020)
\end{book}
Under Gaussian assumptions, the linear model with missing values
(MCAR, MAR -- MNAR is more complex and requires more assumptions) is
\begin{align*}
  f(x_{\text{obs}})
  &= \langle \beta_{\text{obs}} , x_{\text{obs}} \rangle + {} \\
  &\hphantom{{}={}}
  \bigl\langle
  \beta_{\text{mis}} , \mu_{\text{mis}} + \Sigma_{\text{mis},\text{obs}}
  \Sigma_{\text{obs}}^{-1} ( x_{\text{obs}} - \mu_{\text{obs}} )
  \bigr\rangle.  
\end{align*}
The model can be estimated with a neural network:
\begin{compactitem}[--]
\item $\beta$, $\mu$, $\Sigma$ are parameters to estimate; 
\item At each step, mutiply elementwise the vectors with the missingness pattern $m$ or $1-m$,
  and matrices by $mm'$; 
\item For $\Sigma^{-1}$, use a Neumann series, \ie,
  $\Sigma^{-1} = \sum_{k\geq0} (I-\Sigma)^k$,
  but learn the weights $W$ (instead of using $W-I-\Sigma$).
  \begin{align*}
    S_0 &= W_0 \\
    S_1 &= ( W_1 \odot mm' ) S_0 + I \\
    S_2 &= ( W_2 \odot mm' ) S_1 + I \\
    S_2 &\odot mm' \approx \Sigma_{\text{obs}} ^{-1}     
  \end{align*}
\end{compactitem}

\nextbook
\begin{book}
  \emph{Statistical and topological properties\\ of sliced probability divergences}\\
  K. Nadjahi et al. (2020)
\end{book}
The sliced Wasserstein distance (average of the Wasserstein distances after projection on random 1-dimensional subspaces)
has good theoretical properties
(similar to, and sometimes even better than the original Wasserstein distance).

The \emph{generalized sliced Wasserstein distance}
uses a nonlinear projection, e.g., a neural network with a 1-dimensional output.

\nextbook
\begin{book}
  \emph{The dynamics of learning\\ with feedback alignment} \\
  M. Refinetti et al. (2020)
\end{book}
Backpropagation propagates the error $\epsilon$ of a neural net
from the output to the input:
each layer receives this error, transformed by a product of matrices
$A_{\ell+1} A_{\ell+2} \cdots A_n \epsilon$.

Instead, \d{direct feedback alignment} (DFA) uses fixed random matrices.

Evidence from shallow networks shows two phases:
\begin{compactitem}[--]
\item First, the weights change until the DFA direction becomes aligned with the actual gradient; 
\item Only then does learning actually start. 
\end{compactitem}

\nextbook
\begin{book}
  \emph{Direct feedback alignment scales to modern deep learning tasks and architectures}\\
  J. Launay et al. (2020)
\end{book}
Extensive survey of DFA on complex architectures: they fail with CNNs, struggle with graph neural nets,
but work surprisingly well with everything else (fully-connected networks, attention, etc.).

%% 2020-12-21
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{Low-dimensional hyperbolic\\ knowledge graph embedding}\\
  I. Chami et al. (2020)
\end{book}
A knowledge graph encodes different types of relations:
hierarchical (e.g., ``is a''), symmetric (e.g., ``married to''),
asymmetric, etc.

Embed both entities and relations in hyperbolic space,
with a \emph{learned} curvature $c$, different for each type of relation.

For the relations $r$, do not only learn an embedding,
but also a rotation $\text{Rot}_r$,
and a reflection $\text{Ref}_r$;
apply them to the head $h$ of the triplet $(h,r,t)$;
combine them with an attention mechanism,
and translate (M\"obius addition) with the relation embedding
\[ \text{Att}( \text{Rot}_r \cdot h , \text{Ref}_r \cdot h ) \oplus^c r. \]

Data from WorldNet, Freebase, Yago3.

The (non-commutative, non-associative) M\"obius addition
is defined from the parallel transport:
\[ x \oplus y = \exp_x P_{0 \to x} \log_0 y . \]

\nextbook
\begin{book}
  \emph{Learning clique forests}\\
  G.P. Massara and T. Aste (2019)
\end{book}
A \emph{clique} is a maximal complete subgraph.
A \emph{separator} is an intersection of two cliques.
A \emph{clique graph} has cliques as nodes and separators as edges.
It is a \d{clique forest} if it has no cycles (forest)
and satisfies the ``clique intersection property'':
if $C_1$ and $C_2$ are cliques, then $C_1\inter C_2$ is in all the cliques on the path from $C_1$ to $C_2$.

A \emph{perfect elimination order}
is an ordering $\sigma = (v_1, \dots, v_n)$
of the vertices
such that each $\text{Adj}(v_i) \inter G_{i:n}$ is a clique in $G_{i:n}$,
where $\text{Adj}(v)$ is the set of vertices adjacent to $v$.

A graph is \emph{chordal} iff if has a clique forest iff it has a perfect elimination order.
The junction tree algorithm provides efficient exact inferrence on chordal undirected probabilistic graphical models (chordal Markov random fields).

The \d{maximally filtered clique forest} (MFCF)
is an alternative to the graphical lasso
(or other PGM structure inference algorithms: PC, etc.)
which progressively builds a clique forest
by adding vertices one by one with \emph{clique expansion}
to maximize the gain
(increase in the ``score'', e.g., the sum of the edge weights (correlations), or the log-likelihood).
\[ % Clique expansion
\def\a{%
\node[circle,fill] (A) at (-1,0) {};
\node[circle,fill] (B) at (+1,0) {};
\node[circle,fill] (C) at (0,-1) {};
\node[circle,fill] (D) at (0,+1) {};
\draw (A) -- (B);
\draw (C) -- (D);
\draw (A) -- (C) -- (B) -- (D) -- (A);
}
\begin{tikzpicture}[>=stealth,yscale=.5,xscale=.4,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
  \a
\end{tikzpicture}
\ \longrightarrow\ 
\underset{\substack{\text{isolated}\\\text{node}}}{%
\begin{tikzpicture}[>=stealth,yscale=.5,xscale=.4,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
  \a
  \node[circle,fill,blue!80!black] (E) at (1,1) {};
\end{tikzpicture}}
\text{\ \  or }
\underset{\substack{\text{new clique}\\+\\\text{separator}}}{%
\begin{tikzpicture}[>=stealth,yscale=.5,xscale=.4,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
  \a
  \node[circle,fill,blue!80!black] (E) at (1,1) {};
  \draw[very thick,blue!80!black] (B) -- (E) -- (D);
\end{tikzpicture}}
\text{ or\ \ }
\underset{\substack{\text{larger}\\\text{clique}}}{%
\begin{tikzpicture}[>=stealth,yscale=.5,xscale=.4,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
  \a
  \node[circle,fill,blue!80!black] (E) at (1,1) {};
  \draw[very thick,blue!80!black] (B) -- (E) -- (D);
  \draw[very thick,blue!80!black] (A) -- (E) -- (C);
\end{tikzpicture}}
\]

\nextbook
\begin{book}
  \emph{Complex networks on hyperbolic surfaces}\\
  T. Aste et al. (2004)
\end{book}
Filter a graph by progressively adding edges as long as it remains embeddable in  an orientable surface of genus $g$.

The geneus of a graph
(minimum genus of an orientable surface on which the graph can be embedded without edge intersections)
is a measure of complexity;
it is higher for small-world networks (which have ``wormholes'').

\nextbook
\begin{book}
  \emph{A tool for filtering information\\ in complex systems}\\
  M. Tuminello et al. (2005)
\end{book}
Idem.

\nextbook
\begin{book}
  \emph{Network filtering for big data:\\ triangulated maximally filtered graph}\\
  G.P. Massara et al. (2015)
\end{book}
The planar maximally filtered graph (PMFG)
can be construicted greedily,
but with $p$ planarity tests at $O(p^2)$, it is still $O(p^3)$.

The \d{deltahedron heuristic}
starts with a tetrahedron
$K_4 = 
\begin{tikzpicture}[yscale=.2,xscale=.2,inner sep = 1pt, outer sep = 0pt, baseline=-.7mm]
  \node[circle,fill] (A) at (0,0) {};
  \node[circle,fill] (B) at (90:1) {};
  \node[circle,fill] (C) at (-30:1) {};
  \node[circle,fill] (D) at (-150:1) {};
  \draw[thick] (0,0) -- (90:1) -- (-150:1) -- (-30:1) -- (90:1);
  \draw[thick] (-30:1) -- (0,0) -- (-150:1); 
\end{tikzpicture}
$
and progressively adds vertices
$ 
\begin{tikzpicture}[yscale=.2,xscale=.3,inner sep = 1.5pt, outer sep = 0pt, baseline=-.7mm]
  \node[circle,fill] (A) at (0,0) {};
  \draw[thick] (0,0) -- (180:1);
  \draw[thick] (-150:1) -- (0,0) -- (150:1); 
\end{tikzpicture}
$.
\[
T_2 :
\begin{tikzpicture}[scale=.5,inner sep = 1.5pt, outer sep = 0pt, baseline=-.7mm]
  \node[circle,fill] (B) at (90:1) {};
  \node[circle,fill] (C) at (-30:1) {};
  \node[circle,fill] (D) at (-150:1) {};
  \draw[thick] (90:1) -- (-150:1) -- (-30:1) -- (90:1);
\end{tikzpicture}
\ \longmapsto\ 
\begin{tikzpicture}[scale=.5,inner sep = 1.5pt, outer sep = 0pt, baseline=-.7mm]
  \node[circle,fill] (A) at (0,0) {};
  \node[circle,fill] (B) at (90:1) {};
  \node[circle,fill] (C) at (-30:1) {};
  \node[circle,fill] (D) at (-150:1) {};
  \draw[thick] (0,0) -- (90:1) -- (-150:1) -- (-30:1) -- (90:1);
  \draw[thick] (-30:1) -- (0,0) -- (-150:1); 
\end{tikzpicture}
\]

Choose the triangle to maximize the sum of the edge weights;
add the vertices in some predetermined order,
e.g., using the sum or maximum of the incident edges.
The result is a tree of 4-cliques separated by 3-cliques.

The \emph{triangulated maximally filtered graph} (TMFG)
chooses the optimal vertex and triangle at each step;
it is still $O(p^2)$.
It can be extended with more local moves
\[
\begin{array}{rcccl}
  T_1 : &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \node[circle,fill] (A) at (-1,0) {};
    \node[circle,fill] (B) at (0,1) {};
    \node[circle,fill] (C) at (1,0) {};
    \node[circle,fill] (D) at (0,-1) {};
    \draw[thick] (-1,0) -- (0,1) -- (1,0) -- (0,-1) -- cycle;
    \draw[thick] (0,-1) -- (0,1);
  \end{tikzpicture}
  & \longmapsto &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \node[circle,fill] (A) at (-1,0) {};
    \node[circle,fill] (B) at (0,1) {};
    \node[circle,fill] (C) at (1,0) {};
    \node[circle,fill] (D) at (0,-1) {};
    \draw[thick] (-1,0) -- (0,1) -- (1,0) -- (0,-1) -- cycle;
    \draw[thick] (-1,0) -- (1,0);
  \end{tikzpicture}
  \\[5mm]
  A : &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \node[circle,fill] (A) at (-1,0) {};
    \node[circle,fill] (B) at (0,1) {};
    \node[circle,fill] (C) at (1,0) {};
    \node[circle,fill] (D) at (0,-1) {};
    \draw[thick] (-1,0) -- (0,1) -- (1,0) -- (0,-1) -- cycle;
    \draw[thick] (-1,0) -- (1,0);
  \end{tikzpicture}
  & \longmapsto &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \node[circle,fill] (A) at (-1,0) {};
    \node[circle,fill] (B) at (0,1) {};
    \node[circle,fill] (C) at (1,0) {};
    \node[circle,fill] (D) at (0,-1) {};
    \node[circle,fill] (E) at (0,0) {};    
    \draw[thick] (-1,0) -- (0,1) -- (1,0) -- (0,-1) -- cycle;
    \draw[thick] (-1,0) -- (1,0);
    \draw[thick] (0,-1) -- (0,1);
  \end{tikzpicture}
  & \text{ (non-chordal)}\\[5mm]
  S : &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \draw[thick] (0,0) -- (90:1) -- (-150:1) -- (-30:1) -- (90:1);
    \draw[thick] (-30:1) -- (0,0) -- (-150:1); 
    \node[circle,fill,red] (A) at (0,0) {};
    \node[circle,fill] (B) at (90:1) {};
    \node[circle,fill,green] (C) at (-30:1) {};
    \node[circle,fill,blue] (D) at (-150:1) {};
  \end{tikzpicture}
  & \longmapsto &
  \begin{tikzpicture}[scale=.5,inner sep = 2pt, outer sep = 0pt, baseline=-.7mm]
    \draw[thick] (0,0) -- (90:1) -- (-150:1) -- (-30:1) -- (90:1);
    \draw[thick] (-30:1) -- (0,0) -- (-150:1); 
    \node[circle,fill,green] (A) at (0,0) {};
    \node[circle,fill] (B) at (90:1) {};
    \node[circle,fill,blue] (C) at (-30:1) {};
    \node[circle,fill,red] (D) at (-150:1) {};
  \end{tikzpicture}
\end{array}
\]

\nextbook
\begin{book}
  \emph{Topological regularization\\ with information filtering networks}\\
  T. Aste
\end{book}
The maximally filtered clique forest (MFCF),
from the squared Kendall correlation,
with different maximum clique sizes,
can be used to infer the sparsity structure of the concentration matrix of a multivariate Gaussian or Student distribution,
as an approximate penalty.
Use training/validation sets to separately estimate the model and choose the hyperparameter (maximum clique size).

\nextbook
\begin{book}
  \emph{Topological regularization\\ via persistence sensitive optimization}\\
  A. Nigmetov et al. (2020)
\end{book}
Persistence holomogy can help control the complexity of the solution of an optimization problem,
e.g., the decision boundary of a classifier, or the latent representation of an auto-encoder,
by removing low-persistence 0-dimensional features (noise).
\[ \text{Loss} = \sum_{ d_i - b_i \leq \epsilon } ( d_i - b_i )^2 \]
The 0-dimensional persistence diagram of a function $f : X \to \RR$ is
\[ \text{Dgm}(f) = \bigl\{ \bigl( f(v_{\text{birth}}), f(v_{\text{death}}) \bigr) \bigr\}. \]
An $\epsilon$-simplification of $f$ is a function $g$ such that
$\n{ f - g  }_\infty \leq \epsilon $
and
\[ \text{Dgm}(g) = \bigl\{ (b,d) \in \text{Dgm}\,f \ :\ \va{ d - b } > \epsilon \bigr\}. \]

Persistence-sensitive optimization (PSO)
alternates between two gradient descents (each with its own momentum):
\begin{compactitem}[--]
\item Gradient step to reduce $\text{Loss}(\theta)$;
\item $\epsilon$-simplification $g$ of $f_\theta$;
\item Gradient step to reduce $\n{ f_\theta - g }^2$ ($g$ fixed).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Second-order optimization made practical}\\
  R. Anil et al. (2020)
\end{book}
Updates for gradient-based optimization are of the form
$w \leftarrow w - \eta g$.
Preconditioning methods are $w \leftarrow w - P g$,
where $P$
is an $n \times n$ matrix computed
from the Hessian (Newton) or gradient-gradient correlations.
AdaGrad assumes $P$ is diagonal, while \emph{Shampoo} uses
\begin{align*}
  & W \in \RR^{m \times n} \\
  & L_t = \sum_{s = 1}^t G_s G_s ' \in \RR^{m \times m} \\
  & R_t = \sum G_s ' G_s \in \RR^{n \times n} \\
  & w \leftarrow w - \eta L^{-1/4} G R^{ -1/4 }.
\end{align*}
The condition number for $L$ is bad ($\geq 10^7$):
double precision computations are required.

Also check: K-FAC, GGT.

\nextbook
\begin{book}
  \emph{The non-convex Burer-Monteiro approach works on smooth semi-definite programs}\\
  N. Boumal et al. (2018)
\end{book}
The semi-definite program
\[
\begin{array}{ll}
  \text{Find} & X \in \RR^{n \times n} \\
  \text{To minimize} & \langle C , X \rangle \\
  \text{Such that} & AX = b \\
  & X \succcurlyeq 0
\end{array}
\]
can be reformulated,
if $X$ has rank $p$, as
\[
\begin{array}{ll}
  \text{Find} & Y \in \RR^{n \times p} \\
  \text{To minimize} & \langle C Y , Y \rangle \\
  \text{Such that} & A Y Y' = b.
\end{array}
\]
It is not convex but, under reasonable assumptions,
first- and second-order optimality conditions are also sufficient.

\nextbook
\begin{book}
  \emph{Fairwashing explanations\\ with off-manifold detergent}\\
  C.J. Anders et al. (2020)
\end{book}
Most explanations of black-box methods
(gradient, $x \odot \text{grad}$ (contribution), integrated gradient,
layerwise relevance propagation)
ignore the data manifold
and can be manipulated:
keep the model as is on the data manifold
and alter it orthogonally --
in practice, add the desired explanation to the loss function (it is Goohart's law).

Projecting the explanations tangentially to the manifold makes them more robust
(use the $k$-nearest neighbours, or an autoencoder, to estimate the tangent space).

\nextbook
\begin{book}
  \emph{NCVis: noise contrastive approach\\ for scalable visualization}\\
  A. Artemenkov and M. Panov (2020)
\end{book}
\emph{Noise contrastive estimation} (NCE) maximizes
\begin{align*}
& \E_{ x \sim \text{data} }
\log \dfrac{
  p_\theta(x)
}{
  p_\theta(x) + \nu p_{\text{noise}}(x)
}
+ {} \\
&\qquad \nu \E_{ x \sim \text{noise} }
\log \dfrac{
  \nu p_{\text{noise}}(x)
}{
  p_\theta(x) + \nu p_{\text{noise}}(x)
}
\end{align*}

Simplify t-SNE by:
\begin{compactitem}[--]
\item Replacing the Gaussian distributions in the input space with uniform distributions on the $k$ nearest neighbours;
\item Treating the normalization constant in the low-dimensional space as a parameter; 
\item Using NCE with, as noise distribution, the data distribution on edges with one end replaced at random.
\end{compactitem}

Python code available. Also check UMAP (slower), FIt-SNE.

\nextbook
\begin{book}
  \emph{Efficient algorithms for $t$-distributed stochastic neighbourhood embedding}\\
  G.C. Linderman et al. (2017)
\end{book}
FIt-SNE is a faster implementation of $t$-SNE (\texttt{fast\_tsne} in R or Python).

It is also useful in dimension 1:
plot it several times, with dodging, and colours from DBscan or features of interest.

\nextbook
\begin{book}
  \emph{Arbitrary style transfer in real-time\\ with adaptive instance normalization}\\
  X. Huang and S. Belongie (2017)
\end{book}
Instead of \emph{training} a style transfer network so that the statistics of the latent representation
match those of the target image (a time-consuming optimization),
\d{AdaIN} (adaptive instance normalization) just \emph{rescales} them.

\nextbook
\begin{book}
  \emph{RealMix: towards realistic\\ semisupervised deep learning algorithms}\\
  V. Nairet et al (2019)
\end{book}
Semi-supervised learning relies on a few ideas:
\begin{compactitem}[--]
\item Consistency training:
  outputs on unlabeled data should be invariant to small perturbations;
\item Entropy minimization:
  decision boundaries should avoid dense regions (the model should be more confident);
\item MixUp: linear interpolation of (labeled) data points; 
\item Data augmentation;
\item Out-of-distribution masking:
  mask unlabeled samples with low confidence
  (to account for different distributions in the labeled and unlabeled sets);
\item Training signal annealing: limit training on labeled samples (there are too few of them)
  to avoid averfitting.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Inclusive GAN: improving data\\ and minority coverage in generative models}\\
  N. Yu et al. (2020)
\end{book}
Implicit maximum likelihood estimation (IMLE)
alleviates the mode collapse problem of GANs
by matching each real sample with a generated one
(instead of the opposite).
\[
\operatorname*{Minimize}_\theta \E_{ z_1,...z_n \sim N(0,I) } \E_{ x \sim \text{data} } \min_i
\n{ G_\theta (z_i ) - x } ^ 2
\]
(use a fast nearest neighbour algorithm, e.g., prioritized DCI).
One can combine adversarial and reconstructive (IMLE) losses.

\nextbook
\begin{book}
  \emph{Fast $k$-nearest neighbour search\\ via prioritized DCI}\\
  K. Li and J. Malik (2017)
\end{book}
Fast (approximate) nearest neighbour search can be done with k-d-trees (only in low dimension)
or locality-sensitive hashing (LSH -- but performance degrades if there are large density variations).

\emph{Dynamic continuous indexing} (DCI) does not partition the points,
but uses indices, each ordering the points in a random direction.
\emph{Prioritied DCI} does not visit one point from each index at each iteration,
but prioritizes them
(with the distance, along the projection direction, between the query and the next point).

\nextbook
\begin{book}
  \emph{Finding nearest neighbours\\ in growth-restricted metrics}\\
  D.R. Karger and I.M. Ruhl (2002)
\end{book}
To perform nearest neighbour seach in an arbitrary metric space, store,
for each observation, a random list of neighbours at distance $\leq r$,
for several values of $r$, and use them, progressively reducing $r$,
to move closer to the target point.

A discrete metric space has $(\rho,c)$-expansion if
\[ \forall p \in X \quad \va{ B_p(r) } \leq \rho \implies \va{ B_p(2r) } \leq c \va{ B_p(r) }. \]
For instance, $(\ZZ^d, L^1)$ has $(1,2^d)$-expansion.

Applications if the KR dimension include internet routing and machine learning (the manifold hypothesis).

\nextbook
\begin{book}
  \emph{JASS: Japanese-specific sequence to sequence pretraining for neural machine translation}\\
  Z. Mao et al. (2020)
\end{book}
Pretrain the model on units larger than words ({\Japanese 文節}$\approx$ noun or verb phrase)
on a masked prediction or reordering task.

\nextbook
\begin{book}
  \emph{Tapas: weakly supervised table parsing\\ via pre-training}\\
  J. Herzig et al. (2020)
\end{book}
Train a BERT model for question answering on table data (free-form questions,
asking which cells to select and which aggregation function (sum, avg, count, nop) to use)
on data from Wikipedia (Infobox, Wikitable).

\nextbook
\begin{book}
  \emph{Synthesizer: rethinking self-attention\\ for transformer models}\\
  Y. Tay et al. (2020)
\end{book}
In the transformer $X \mapsto \text{Softmax} (QK') V$,
replace the dot product $QK'$ with:
\begin{compactitem}[--]
\item a shallow net $F : \RR^d \to \RR^\ell$, operating identically on each of the $\ell$ tokens $\RR^{d\times\ell} \to \RR^{\ell\times\ell}$
\item or a random matrix.
\end{compactitem}

\nextbook
\begin{book}
  \emph{SIGN: scalable inception graph neural network}\\
  F. Frasca et al. (2020)
\end{book}
Graph neural nets do not scale well to large graphs:
one often uses seed nodes
(picked at random, or using PageRank),
adds their neighbourhoods,
and only computes the loss on the seed nodes.

Instead, use a shallow net of the form
\[ X \mapsto A_0 X \Theta_0,\dots,A_r X \Theta_r \overset{\sigma}{\mapsto} Z \mapsto Z\Omega \overset{\sigma}{\mapsto} \sigma(Z\Omega) \]
where $\Theta_k$ and $\Omega$ are parameters
and the $A_k's$ are fixed operators
(so that $A_k X$ can be precomputed),
e.g., $B^k$,
where $B$ is the adjacency, the personalized pagerank adjacency, or triangle-based adjacency.


\nextbook % Interesting
\begin{book} 
  \emph{Erd\"os goes neural:\\ an unsupervised learning framework\\ for combinatorial optimization on graphs}\\
  N. Karalias and A. Loukas (2020)
\end{book}
To solve combinatorial optimization problems with deep learning,
do not directly look for a solution, but for a \emph{probability distribution} on candidate solutions:
if $\E[ f(S)] = a$,
we know there is a solution $S$ with $f(S) \leq a$.

For instance, given a graph $G$, to find a set of vertices $S \subset V(G)$ minimizing $f(S)$,
for some nonnegative function $f$, use independent Bernoulli distributions
on the vertices and
\( \text{Loss} = \E [ f(S) ] / (1 - t) \):
by the Markov inequality, it guarantees
\[ P \bigl[ f(S) \leq \text{loss} \bigr] \geq t . \]

To account for constraints $ S \in \Omega $,
add $\mathbf 1_{ S \in \Omega} \cdot \beta$
to $f$
and find a computable differentiable upper bound for $P[ S \in \Omega ]$.

For box constraints
\[ \sum_{ v_i \in S } a_i \in [ b_\ell, h_h ], \]
rescale the probabilities
to satisfy the constraint in expectation
\begin{align*}
  & p_i \leftarrow \text{clamp} ( c p_i , 0, 1 ) \\
  & \sum_{ v_i \in V } a_i p_i = \dfrac12 ( b_\ell +b_h ).
\end{align*}

To retrieve integral solutions,
use (sampling or)
conditional expectations:
sort the vertices by decreasing probabilities and decide to add them to $S$ one by one,
by comparing
\begin{align*}
  & \E \bigl[ f(S) \ |\ v_{i+1} \in S \bigr] \\
  \text{and }& 
  \E \bigl[ f(S) \ |\ v_{i+1} \not\in S, \ S_i \subset S \bigr].
\end{align*}

Applications include max-clique and constrained min-cut.

\nextbook
\begin{book}
  \emph{An alternative to backpropagation\\ in deep reinforcement learning}\\
  S. Chung (2020)
\end{book}
If the mapping from state $S$ to action $A$ is given by a multi-layer network of \emph{stochastic units}
\[ H_\ell \sim P( H_\ell | H_{\ell-1}, W_{\!\ell} ), \]
the \textsc{reinforce} gradient estimator
\[ \nabla_{\!W} \E G = \E[ G \nabla_{\!W} \log P( A | S ) ] \]
can be written
\[ \nabla _{\!W_{\!\ell}} \E G = \E[ G \nabla_{\!W_{\!\ell}} \log P( H_\ell | H_{\ell-1} ) ] \]
which suggests the update rule
\[ W_{\!\ell} \leftarrow W_{\!\ell} + \alpha G \nabla_{\! W_{\!\ell} } \log P( H_\ell | H_{\ell-1} ). \]
The following has lower variance
\[ W_{\!\ell} \leftarrow W_{\!\ell} + \alpha G \E [ \nabla_{\!W_{\!\ell}} \log P( H_\ell | H_{\ell-1} ) | S,A ] \]
and the expectation can be approximated at the mode
$\hat H_\ell$ of $P(H_\ell | S,A)$
\[ W_{\!\ell}\leftarrow W_{\!\ell} + \alpha G \nabla _{\!W_{\!\ell}} \log ( \hat H_\ell | \hat H_{\ell-1} ); \]
the modes can be estimated by gradient ascent.

\nextbook
\begin{book}
  \emph{Realm: retrieval-augmented\\ language model pre-training}\\
  K. Guu et al. (2020)
\end{book}
Augment a masked language model (\textsc{bert}) with a retrieval system (maximum inner product search)
and train them together.

\nextbook
\begin{book}
  \emph{Sampled softmax with random Fourier features}\\
  A.S.  Rawat et al. (2020)
\end{book}
Since sampling from the full softmax distribution $p$ is expensive
\begin{align*}
  & h: \text{ input embedding} \\
  & c_i : \text{ embedding of class $i$} \\
  & o_i = \tau h'c_i \text{ raw score (logit)} \\
  & p_i = e^{o_i} / Z \text{ probability} \\
  & t: \text{ true label} \\
  & \mathscr L(x,t): \text{ loss} \\
  & \nabla_{\!\theta} \mathscr L = - \nabla_{\!\theta} o_t + \E_{ s \sim p } [ \nabla_{\!\theta} o_s ] 
\end{align*}
it is often replaced by an easier distribution, e.g., uniform, or some prior -- but the softmax
distribution is the only one which gives an unbiased estimator.
To have a low bias, we need the $p_i/q_i$ to be close to 1.

Kernel-based sampling uses $q_i \propto k(h,c_i)$,
where $k: \RR^d\times\RR^d \to \RR$ is some kernel.
If the kernel can be linearized, $k(h,c) = \phi(h)' \phi(c)$,
for $\phi: \RR^d \to \RR^D$,
sampling can be done in $O(D \log n)$
by a divide-and-conqueer algorithm (put the classes in a binary tree: we only need $\sum_{c \in S} \phi(c)$
for the subtrees $S$).

The softmax is obtained for
$k(h,c) = \exp(\tau h' c)$.
The quadratic kernel
\begin{align*}
  k(h,c) &= \alpha ( h' c )^2 + 1 \\
  \phi(x) &= [ \sqrt \alpha (z \tens z), 1 ]
\end{align*}
is not a good approximation of the exponential kernel,
and does not scale well with the embedding dimension~$d$.

Use \emph{random Fourier features} (and a normalized embedding)
\begin{align*}
  \phi(u) &= \dfrac1{\sqrt D} \bigl[ \cos w_1' u, \dots, \cos w_D'u, \sin w_1'u, \dots, \sin w_D' u \bigr] \\
  w_i &\sim N(1,1/\tau) \\
  & \hspace*{-5mm}\exp -\dfrac\tau2 \n{x-y} \approx \phi(x) ' \phi(y).
\end{align*}
  
\nextbook
\begin{book}
  \emph{Transformers are RNNs: fast autoregressive transformers with linear attention}\\
  A. Katharopoulos et al. (2020)
\end{book}
The softmax in the attention mechanism can be linearlized, e.g., with a quadratic kernel,
random Fourier features, or $\phi(x) = \text{elu}(x) + 1$.

\nextbook
\begin{book}
  \emph{Language ID in the wild:\\ unexpected challenges on the path\\ to a thousand-language web text corpus}\\
  I. Caswell et al. (2020)
\end{book}
Language identification on real (dirty, web-crawled)
data for low-resource languages is tricky:
avoid overly cleaned data, deduplicate, balance the data, use curated wordlists (500/language),
train a transformer and check the types or errors
(mojibake, create use of Uniciode, obfuscationm boilerplate,
high-resource nearly language, $n$-gram overlap, antspeak, repetitions, etc.)
  
\nextbook
\begin{book}
  \emph{A convenient generalization\\ of Schlick's bias and gain functions}\\
  J.T. Barron (2020)
\end{book}
Increasing functions $[0,1]\to[0,1]$ with at most one inflection point
($a,t\in(0,1)$, $s\geq0$).
\begin{align*}
  B(x,a) &= \dfrac{ x }{ (1/a-2 )( 1-x ) + 1 } \\
  G(x,a) &= \begin{cases}
    \dfrac{ B(2x,a) }{ 2 } & \text{ if } x < 1/2 \\
    \dfrac{ B(2x-1,1-a) + 1 }{ 2 } & \text{ if } x \geq 1/2
  \end{cases} \\
  C(x,s,t) &= \begin{cases}
    \dfrac{ tx }{ x + s(t-x) + \epsilon } & \text{ if } x < t \\
    \dfrac{ (1-t) (x-1) }{ 1 - x - s(t-x) + \epsilon } + 1 & \text{ if } x \geq t
  \end{cases}
\end{align*}
<<SchlickGainBias,results='hide',echo=FALSE,fig.width=6,fig.height=2,out.width='\\hsize',fig.show='hold'>>=
library(DBQR)
B <- function(x,a) x / ( ( 1/a - 2 ) * ( 1-x) + 1 )
G <- function(x,a) 
  ifelse( 
    x < .5,
    B(2*x,a)/2,
    ( B(2*x-1,1-a) + 1 )/2
  )
C <- function(x,s,t, epsilon=1e-8) 
  ifelse( 
    x < t,
    t*x / ( x + s*(t-x) + epsilon ),
    (1-t)*(x-1) /( 1-x-s*(t-x)+epsilon ) + 1
  )
op <- par( mfrow=c(1,3), mar = c(.1,.5,2,.5) )
curve( B(x,.5), xlim = c(0,1), axes = FALSE, main = "B(x,a)" )
for( a in c(.01, .05, .2, .5, .8, .95, .99) )
  curve( B(x,a), xlim = c(0,1), axes = FALSE, add = TRUE, lwd = 3, col = dbColours[1] )
box()
curve( G(x,.5), xlim = c(0,1), axes = FALSE, main = "G(x,a)" )
for( a in c(.05,.2, .5,.8,.95) )
  curve( G(x,a), xlim = c(0,1), axes = FALSE, add = TRUE, lwd = 3, col = dbColours[1] )
box()
curve( C(x,1,.5), xlim = c(0,1), axes = FALSE, main = "C(x,s,t)" )
ts <- c(0,.25,.5,.75,1)
ss <- c(64,8,1,1/8,1/64)
#for( i in seq_along(ts) ) { t <- ts[i]
for( t in ts ) { 
  for( i in seq_along(ss) ) { s <- ss[i] 
  #for( s in ss ) {
  curve( C(x,s,t), xlim = c(0,1), axes = FALSE, add=TRUE, lwd = 3, col = dbColours[i] )
  }
}
box()
par(op)
@

\nextbook
\begin{book}
  \emph{$q$-neurons: neuron activations based on stochastic Jackson's derivative operators}\\
  F. Nielsen and K. Sun (2018)
\end{book}
Replace the activation function $f$ with
\[ g_q(x) = \dfrac{ f(x) - f(qx) }{ 1-q }, \]
with $q \sim N(1,\sigma^2)$ (but remove a small interval around 1 for stability).
The gradient of $g$ contains second-order information:
\[ \lim_{ \var q \to 0} g'_q(x) = f'(x) + f''(x)  x. \]

The $q$- and $(p,q)$-derivatives (from quantum calculus) are
\begin{align*}
  D_qf(x) &= \dfrac{ f(x) - f(qx) }{ (1-q) x } \\
  D_{p,q}(x) &= \dfrac{ f(px) - f(qx) }{ (p-q) x }.
\end{align*}

\nextbook
\begin{book}
  \emph{Learning\\ with differentiable perturbed optimizers }\\
  Q. Berthet et al. (2020)
\end{book}
To differentiate through an Argmax
\begin{align*}
  C &= \text{Conv} \{ y_1, \dots, y_n \} \\
  F(\theta) &= \max_{ y \in \{ y_1, \dots, y_n \} } \langle y, \theta \rangle
  = \max_{y \in C} \langle y, \theta \rangle \\
  y^*(\theta) &= \argmax_{ y \in C } \langle y, \theta \rangle
  = \nabla_{\!\theta} \max_{ y \in C } \langle y, \theta \rangle
\end{align*}
add noise $z \sim \exp -U(z)$
(this generalizes the Gumbel softmax trick, for which $C=\Delta$ is the standard simplex).
\begin{align*}
  F_\epsilon(\theta) &= \E_z \bigl[ F(\theta) + \epsilon Z \bigr] \\
  y^*_\epsilon(\theta) &= \E_z \bigl[ \argmax_y \langle y, \theta + \epsilon Z \rangle \bigr] = \nabla_{\!\theta} F_\epsilon(\theta)
\end{align*}
The Jacobian can be computed with Monte Carlo simulations.
\begin{align*}
  y^*_\epsilon(\theta) &= \E \bigl[ F(\theta+\epsilon Z ) \nabla_{\!Z} \nu(Z) / \epsilon ] \\
  J_\theta y_\epsilon^* (\theta) &=
  \E\bigl[
    F(\theta + \epsilon Z ) \nabla_{\!X} \nu(Z) \nabla_{\!Z} \nu(Z) ' - \nabla_{\!Z} \nu(Z)^2 / \epsilon^2
  \bigr]
\end{align*}
Applications include rank correlation, shortest path.

\nextbook
\begin{book}
  \emph{Geometric distances via optimal transport}\\
  D. Alvarez-Melis and N. Fusi (2020)
\end{book}
Optimal transport on $(\mathcal X, \mathcal Y)$
can be used to compare datasets
(e.g., to choose the closest one for transfer learning).
If the labels are not the same,
replace them with the corresponding distribution in feature space (input),
and use the optimal transport distance between those distributions
as ``distance'' (transportation cost) between the labels.

\nextbook
\begin{book}
  \emph{Lambda networks: modeling long-range interactions without attention}\\
  (2020)
\end{book}
Lambda layers are a variant of / an alternative to attention layers,
which map a context to a linear function,
which is then applied to the input (keys).

\nextbook
\begin{book}
  \emph{Fourier neural operator\\ for parametric partial differential equations}\\
  Z. Li et al. (2020)
\end{book}
An infinite-dimensional generalization of neural nets approximates a function
\[ G : A = \mathscr F ( D, \RR^{d_a} ) \longrightarrow U = \mathscr F( D, \RR^{d_u} ) \]
by minimizing
\( \E\limits_{ a \sim \mu } \text{Cost} \bigl( G_\theta(a), G(a) \bigr). \)
First, lift the input to a higher-dimensional representation,
with a shallow neural net
\begin{align*}
  v_0 &: D \longrightarrow \RR^{d_a} \\
  v_1 &: D \overset{v_0}{\longrightarrow} \RR^{d_a} \overset{P}{\longrightarrow} \RR^{d_v} ,
\end{align*}
then apply iterative updates
\[
v_{t+1} (x) = \sigma \left(
W v_t(x) +
\int_D k_\phi( x-y ) v_t(y) dy
\right);
\]
parametrize $k_\phi : \RR^{d_a} \longrightarrow \RR^{ d_v \times d_v } $
in Fourier space
and use the FFT to compute the convolution.
  
\nextbook
\begin{book}
  \emph{Algebraic statistics in practice}\\
  M. Casanellas et al. (2019)
\end{book}
Exponential random graph models (ERGM) are of the form
\[ p_\theta(G) \propto \exp \langle T(G) , \theta \rangle . \]
The \emph{fiber} of $G$ is the set of graphs with the same sufficient statistic
$\{ G' \ :\ T(G') = T(G) \}$.
For log-linear models, \ie, $T(G) = B A_G$,
where $A_G$ is the adjacency matrix,
\emph{toric ideals} can help describe the fiber and sample from it (Metropilis-Hastings),
to perform goodness-of-fit tests.

The number of Markov equivalance classes (MEC) of directed graphical models on $n$ nodes,
and the number of MECs with only one GDAG, are open problems in combinatorics.

To infer the structure of a directed graphical model with conditional independence tests,
it has to be \emph{faithful}, \ie, causal effects should not cancel out:
(for Gaussian linear structural equation models (SEM)), that condition defines a real algebraic surface,
and the volume of tubes around it tells us how many samples are needed.

Instead of testing all conditional independence relations, choose an order on the vertices
and only test for
\( X_i \indep X_j \,|\, X_{ \leq j, \neq i,j }, \ i<j . \)
Prefer the order leading to the sparsest DAG (sparsest permutation search --
a vertex on the permutahedron,
polytope whose vertices are orderings of $\llbracket 1, n \rrbracket$
and with edges when two permutations differ by a transposition of adjacent elements).
(Things get even more complicated with unobserved variables.)

Phylogenetics models consider a probability distribution
on $\{A,C,T,G\}^n$ at the root of the tree (e.g., uniform),
a transition matrix for each edge (e.g., with a single parameter, $P(x|y)$ for $x \neq y$),
and we observe the probabilities on the leaves.
Some relations between the probabilities on the leaves (the fact that some matrix has low rank)
depend on the structure of the tree and the model:
they can help identify the tree, select the model,
or prove model identifiability.

\nextbook
\begin{book}
  \emph{Factor investing with Black-Litterman-Bayes: incorporating factor views and priors\\ in portfolio construction}\\
  P.N. Kolm and G. Ritter (2020)
\end{book}

\textbf{1.} The simplified Black-Litterman framework models stock returns as 
\begin{align*}
  r &\sim N(\mu,\Sigma) && \text{stock returns} \\
  Z &\sim N(0,Ω) && \text{views uncertainty} \\
  Q &= Pr + Z   && \text{views}
\end{align*}
and then computes the conditional distribution of returns given the views,
$ r \,|\, Q=q $.

\textbf{2.}
The textbook Black-Litterman model is more complicated: the views are not on the returns but on the expected returns.
\begin{align*}
  \mu &\sim N(\pi,C) && \text{expected stock returns} \\
  r &\sim N(\mu,\Sigma) && \text{stock returns} \\ 
  Z &\sim N(0,\Omega) && \text{uncertainty of the views}\\
  Q &= P\mu + Z && \text{views on expected returns}
\end{align*}
We can then compute the conditional distributions $\mu \,|\, Q=q$ and $r \,|\, Q=q$,
and the optimal (unconstrained) portfolio
\[ w^* = \argmax_w w' \mu - \dfrac12 \lambda w' \Sigma w = \lambda^{-1} \Sigma^{-1} \mu. \]

\textbf{3.}
The \emph{factor Black-Literman}
replaces the stock return model, $r \sim N(\mu,\Sigma)$, with a factor model, $r = Xf + \epsilon$;
the views are on the expected factor returns $\mu$ (not the factor returns).
\begin{align*}
  \mu &\sim N(\xi,V) && \text{expected factor returns} \\
  f &\sim N(\mu,F) && \text{factor returns} \\
  r &= X f + \epsilon && \text{factor model} \\
  \epsilon &\sim N(0,D) \\
  Z &\sim N(0,\Omega) && \text{uncertainty of the views}\\
  Q &= \mu + Z && \text{views on expected factor returns}
\end{align*}
From this model, we can compute the conditional distributions
of the expected factor returns $\mu \,|\, Q=q$,
then of the factor returns $f \,|\, Q=q$, then of the stock returns $r \,|\, Q=q$.

