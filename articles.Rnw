  \draw (I1) -- (p) -- (Z1) -- (o1);
  \draw (o) -- (p);
  \node[anchor=west] at (4,.5) {$\dfrac{\ket{00} + \ket{11}}{\sqrt2}$};
\end{tikzpicture}
\]

% quantum teleportation
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.5,inner sep=2pt,outer sep=0pt,baseline=0,
%          every path/.style={thick}
  ]
% https://tex.stackexchange.com/questions/416055/measurement-meter-quantum-circuit-with-tikz
\tikzset{meter/.append style={
    draw, thin,
    inner sep=2pt, rectangle,
    font=\vphantom{A},
    minimum width=15, line width=.8,
    path picture={
      \draw[thin]
        ([shift={(.05,-.1)}]path picture bounding box.north west)
        to[bend left=30]
        ([shift={(-.1,.05)}]path picture bounding box.south east);
      \draw[thin,->]
        ([shift={(-.2,.05)}]path picture bounding box.south) --
        ([shift={(.2,-.05)}]path picture bounding box.north);
    }
}}
  \node[anchor=east] (i0) at (0,2) {Alice $\ket\psi$};
  \node (i1) at (0,1) {};
  \node (i2) at (0,0) {};
  \node[draw] (H) at (1,2) {$H$};
