%% 2013-08-01
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{LOF: Identifying density-based local outliers}\\
  M.M. Breunig et al. (2000)
\end{book}
One can use the ideas behind density-based clustering (\textsc{dbscan})
to define the degree of outlier-ness of a point~$p$,
\begin{align*}
  \textsc{lof}_k(p) &= \dfrac1k \! \sum_{ q \in N_k(p) } \!\!\dfrac{\ell_k(q)}{\ell_k(p)} \\
  \ell_k(p) &= \dfrac1k \! \sum_{q \in N_k(p)} \!\! d_k(p,q) & \text{local reachability density} \\
  d_k(p,q) &= \rlap{$ \max \{ d_k(q), d(p,q) \} $}& \text{reachability distance} \\
  d_k(p) &= \rlap{\text{distance to the $k$th nearest neighbour.}}
\end{align*}
% The formulas in the article are more complicated because they account for ties
Being local, the method still works if the data has clusters of different densities.
Fraud detection is the most prominent application of outlier detection.

\begin{center}
  \setkeys{Gin}{width=6cm}%
<<OutliersLOF,results='hide',echo=FALSE,fig.width=6,fig.height=3>>=
set.seed(1)
par(mar=.2*c(1,1,1,1))
x <- c(.1*rnorm(100), 4+rnorm(100))
y <- c(.1*rnorm(100), 2+.3*rnorm(100))
plot(x,y, axes=FALSE, xlab="", ylab="", main="")
box()
points( .4, .4, col="red", pch=16 )
@
\end{center}

\nextbook
\begin{book}
  \emph{A scalable and efficient outlier detection strategy for categorical data}\\
  A. Koufakou et al. (2007)
\end{book}
Here are a few ideas to detect outliers in categorical data: 
\begin{compactitem}[--]
\item Greedy algorithm to identify observations whose removal reduces the entropy the most;
\item Observations containing few frequent item sets (FIS)
\begin{align*}
  \textsc{fpof}(x) & \propto \sum_{\substack{ F \in \textsc{fis} \\ F \subset x }}  \text{Support}(x) \\
  \textsc{fis} &= \{ I \ :\ \va{ \text{Support}\,I } > n \}
\end{align*}
\item Observations containing many infrequent itemsets
\[ \text{Otley}(x) = \sum_{\substack{ I \subset x \\ \va{\text{Support}\, I} \leq n}} \dfrac1{\va I} \]
\item Observations containing rare values for most variables (\ie, consider the variables separately)
\[ \textsc{avf}(x) = \dfrac1m \sum_i f(x_i) \]
where $f(x_i)$ is the proportion of points in which the $i$th variable has value $x_i$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Frequent pattern growth (FP-growth) algorithm. An introduction}\\
  F. Verhein (2008)
\end{book}
The \emph{apriori} algorithm for frequent item set (FIS) mining 
\begin{align*}
  L_1 &= \{ \text{frequent items} \} \\
  &= \{\, \{x\} \ :\ \text{Support}\, \{ x \} \geq n \,\} \\
  C_{k+1} &= \{\, a \union \{x\},\  a \in L_k,\  \{x\} \in L_1,\  x \not\in a \,\} \\
  L_{k+1} &= \{\, c \in C_{k+1} \ :\ \text{Support}\,c \geq n \,\}
\end{align*}
is expensive (double loops to compute the candidates $C_k$ and the frequent $k$-item sets $L_k$).

The FP-growth algorithm processes the data into an \emph{FP-tree}: 
\begin{compactitem}[--]
\item Compute the support of each item;
\item For each transaction, sort the items by decreasing support;
\item Build the corresponding \emph{prefix tree}, 
  storing the support of each prefix in the nodes, 
  with links between identical items.
\end{compactitem}
\[
