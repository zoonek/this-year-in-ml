  \draw (C) -- node[draw,fill=white] {\scriptsize 13} (A);
  \draw (B) -- node[draw,fill=white] {\scriptsize 23} (C);
\end{tikzpicture}
\ \text{ or }\ 
\begin{tikzpicture}[scale=.6,>=stealth,inner sep=1pt, outer sep=0pt, baseline=-6pt,
n/.style={circle, fill}
  ]
  \node (O) at (0,0) {};
  \node[n] (C) at (-90:1) {};
  \node[n] (B) at (30:1) {};
  \node[n] (A) at (150:1) {};
  \draw (O) -- (A);
  \draw (O) -- (B);
  \draw (O) -- (C);
  \node[draw,fill=white] at (0,0) {\scriptsize 123};
\end{tikzpicture}
?
\]

Directed models can be sampled by \emph{ancestral sampling}
(after choosing a topological ordering of the nodes).
Undirected models can be sampled, approximately, by Gibbs sampling.
Introducing hidden variables can replace many dependencies.
\[
\begin{tikzpicture}[xscale=.5,yscale=.25,>=stealth,inner sep=1pt, outer sep=1pt, baseline=12pt,
n/.style={circle, fill}
  ]
\foreach \i in {0,1,2,3,4} 
  \node[n] (A-\i) at (0,\i) {};
\foreach \i in {0,1,2,3,4} 
