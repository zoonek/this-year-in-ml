\node[neuron] (E2) at (4,-1) {};
\node (F1) at (5,1) {};
\node (F2) at (5,-1) {};
\draw[->,thick] (A) -- (B1);
\draw[->,thick] (A) -- (B2);
\draw[->,thick] (B1) -- (C1);
\draw[->,thick] (B1) -- (C2);
\draw[->,thick] (B2) -- (C1);
\draw[->,thick] (B2) -- (C2);
\draw[->,thick] (C1) -- (D1);
\draw[->,thick] (C1) -- (D2);
\draw[->,thick] (C2) -- (D1);
\draw[->,thick] (C2) -- (D2);
\draw[->,thick] (D1) -- (E1);
\draw[->,thick] (D1) -- (E2);
\draw[->,thick] (D2) -- (E1);
\draw[->,thick] (D2) -- (E2);
\draw[->,thick] (E1) -- (F1);
\draw[->,thick] (E2) -- (F2);
