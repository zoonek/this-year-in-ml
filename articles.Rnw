\nextbook
\begin{book}
  \emph{A condition number for joint optimization\\ of cycle-consistent networks}\\
  L.J. Guibas et al.
  (NeurIPS 2019)
\end{book}
A \emph{mapping graph} is a graph $(V,E)$,
with a set $D_u$ associated to each vertex and a mapping
$D_u \to D_v$ associated to each edge $u \to v$.
It is \emph{cycle-consistent} if the composition of the mappings along any cycle is the identity
(as with CycleGAN or back-translation).

\nextbook
\begin{book}
  \emph{Cascade RPN: delving into high quality region proposal network with adaptive convolution}\\
  T. Vu et al.
  (NeurIPS 2019)
\end{book}

