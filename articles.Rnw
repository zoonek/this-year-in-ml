\]
can be generalized to hyperrectangles,
or replaced with the \emph{region connection calculus} (RCC8)
\[
\begin{tikzpicture}[>=stealth,xscale=.1,yscale=.1,inner sep=1pt,outer sep=1pt,baseline=0]
  \begin{scope}[shift={(0,0)}]
    \draw (0,0) -- (11,0) -- (11,6) -- (0,6) -- cycle;
    \draw[very thick] (3,3) circle (2);
    \draw[very thick] (8,3) circle (2);    
  \end{scope}
  \begin{scope}[shift={(11,0)}]
    \draw (0,0) -- (11,0) -- (11,6) -- (0,6) -- cycle;
    \draw[very thick] (3.5,3) circle (2);
    \draw[very thick] (7.5,3) circle (2);    
  \end{scope}
  \begin{scope}[shift={(22,0)}]
    \draw (0,0) -- (11,0) -- (11,6) -- (0,6) -- cycle;
    \draw[very thick] (5.5,3) circle (2);
    \draw[very thick] (6.5,3) circle (1);    
  \end{scope}
  \begin{scope}[shift={(33,0)}]
    \draw (0,0) -- (11,0) -- (11,6) -- (0,6) -- cycle;
    \draw[very thick] (5.5,3) circle (2);
    \draw[very thick] (5.5,3) circle (1);    
  \end{scope}
