  (-0.7,-0.021) -- (-0.65,-0.024) -- (-0.6,-0.028) -- (-0.55,-0.033) -- (-0.5,-0.038) -- (-0.45,-0.043) -- (-0.4,-0.048) -- (-0.35,-0.052) -- (-0.3,-0.055) -- (-0.25,-0.056) -- (-0.2,-0.054) -- (-0.15,-0.048) -- (-0.1,-0.038) -- (-0.0499999999999999,-0.022) -- (0,0) -- (0.05,0.028) -- (0.1,0.062) -- (0.15,0.102) -- (0.2,0.146) -- (0.25,0.194) -- (0.3,0.245) -- (0.35,0.298) -- (0.4,0.352) -- (0.45,0.407) -- (0.5,0.462) -- (0.55,0.517) -- (0.6,0.572) -- (0.65,0.626) -- (0.7,0.679) -- (0.75,0.733) -- (0.8,0.786) -- (0.85,0.838) -- (0.9,0.89) -- (0.95,0.942) -- (1,0.993);
  \draw (-.7,.1) -- (1,.1);
