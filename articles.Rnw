%% 2021-10-09
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{multimode: an R package for mode assessment}\\
  J. Ameijeiras-Alonso et al. (2021)
\end{book}
To visually assess the presence of several models in univariate data:
\begin{compactitem}[--]
\item The \emph{mode tree} plots the modes versus the bandwidth of a kernel density estimator (kde);
\item The \emph{mode forest} is a set of bootstrapped mode trees;
\item The significant zero (\emph{SiZer}) map plots the significance of the sign of the slope of a kde
  (whether a confidence interval for $f'_h(x)$ is in $\RR_-$, $\RR_+$ or contains zero)
  as a function of $x$ and the bandwidth $h$.
\end{compactitem}
There are also statistical tests.

<<multimodeSiZer,results='hide',echo=FALSE,fig.width=5,fig.height=1.85,out.width='\\hsize',fig.show='hold'>>=
library(multimode)
op <- par( mfrow=c(1,3), las=1, mar = c(3,2,2,1) )
modetree(geyser, bws=c(.1,10), main = 'Mode tree' )
modeforest(geyser, bws=c(.1,10), c(.1,10), B=99, n=512, gridsize=c(100,151), main = 'Mode forest')
sizer( geyser, col.sizer=c(dbColours[4], "grey", dbColours[1], "white"), addlegend=FALSE, main = 'SiZer' )
par(op)
@
  
\nextbook
\begin{book}
  \emph{mosum: a package for moving sums\\ in change-point analysis}\\
  A. Meier et al. (2021)
\end{book}
To detect changepoints (on the mean), compute the average on a window of size $G$
before and after all potential breakpoints $k$
\[
T_G(k) = \sqrt{ \dfrac G2 } \biggl(
\operatorname*{Mean}_{ k < t \leq t+G } X_t - 
\operatorname*{Mean}_{ k -G < t \leq t } X_t 
\biggr)
\]
and return $\argmax_k \va{ T_G(k) } / \sigma_k$.
You can try several (or asymmetric) bandwidths.
  
\nextbook
\begin{book}
  \emph{Conformal prediction with Orange}\\
  T. Ho\v cevar et al. (2021)
\end{book}
A \emph{conformal predictor} predicts a \emph{set} of labels with low nonconformity,
for some user-chosen nonconformity function such as:
\begin{compactitem}[--]
\item Distance to the closest neighbour with the same label;
\item Predicted probability of the correct class;
s\item Difference of predicted probabilities of the two most likely classes;
\item (For regression) absolute error of the prediction.
\end{compactitem}
Also check \texttt{conformal} (R), \texttt{nonconformist} (Python).
  
\nextbook
\begin{book}
  \emph{gdpc: an R package\\ for generalized dynamic principal components}\\
  D. Pe\~na et al. (2020)
\end{book}
The first \emph{dynamic principal component} of a multivariate time series
$(z_{\bigcdot t} )_t$ is the univariate time seties $(f_t)_t$
such that $(f_{t-k},\dots,f_t)$ gives the best reconstruction of $z_{\bigcdot t}$:
\[ z_{it} \approx \alpha_i + \sum_{j=0}^k \beta_{ij} f_{t-j} \]
(it is noisy at the ends of the sample and therefore not useful for forecasting);
$\beta$ can be computed from $f$ with OLS and conversely.
The loss can be a square loss, or a robust alternative.
The original DPC was a linear combination (and convolution) of the observations.
  
\nextbook
\begin{book}
  \emph{Generalized dynamic principal components}\\
  D. Pe\~na and V.J. Yohai (2015)
\end{book}
  
\nextbook
\begin{book}
  \emph{Dimension reduction for time series\\ in a blind source separation context using R}\\
  K. Nordhausen et al. (2021)
\end{book}
Diagonalize, not just the covariance matrix, but (jointly)
several cross-covariance matrices, for several lags.

Blind source separation of a multivariate time series $(z_t)_t$ assumes that the signals are autocorrelated,
but that the noise is not:
\begin{align*}
  & x_t = \mu + \Omega z_t \\
  & \cov_\tau (z_t ) = \E[ z_t z_{t+\tau} ' ] = \begin{pmatrix} \Lambda_\tau & 0 \\ 0 & 0 \end{pmatrix}.
\end{align*}
\textsc{Amuse} uses the eigendecomposition of the autocovariance matrix
of the standardized time series
$x_t^{\text{st}} = U \Lambda_\tau U'$, $UU'=I$.
To allow the eigenvalues to be similar,
\textsc{sobi} approximately jointly diagonalizes several autocovariance matrices, maximizing
\[ \sum_{ \tau \in \mathscr T } \sum_i \left( u_i' \cov_\tau( x_t^{\text{st}} ) u_i \right)^2,
\quad U \text{ orthogonal}. \]
This can be generalized (g\textsc{fobi}) to include 4th cross-moments
$B_\tau = \E[ x_{t+\tau} x_t ' x_t x_{t+\tau} ' ]$
by maximizing
\[ \sum_{ \tau } \sum_i \left( u_i' B( x_t^{\text{st}} ) u_i \right)^2 \]
or by using a wider class of cumulants (g\textsc{jade}).
\[
  \sum_\tau \sum_i \sum_{jk} \left( u_i' C_\tau^{jk} ( x_t^{\text{st}} ) u_i \right)^2
\]
\begin{align*}
  C_\tau^{jk} & = \E[ x_{t+\tau} x_t ' e_{jk} x_t x_{t+\tau} ] \\
  & \hphantom{={}} - \cov_\tau(x_t) ( e_{jk} + e_{kj} ) \cov _\tau (x_t) ' - \tr(e_{jk}) I_p \\
  ( e_{jk} )_{jk} &:\text{ standard basis of } \RR^{p\times p} 
\end{align*}
or by inserting a nonlinear function $g$ in the moment computations
($y \mapsto y^2$ or $y \mapsto \log \cosh y$)
\[
\sum_{\tau, i}
\E\left[ g(u_i' x_t^{\text{st}} ) g(u_i' x_{t+\tau}^{\text{st}} )^2 \right] -
\E\left[ g(u_i' x_t^{\text{st}} ) \right] \E\left[ g(u_i' x_{t+\tau}^{\text{st}} )^2 \right]
\]
or by combining linear and quadratic parts
\[
\lambda     \sum_{i, \tau} \left( u_i C_\tau u_i ' \right)^2 + 
(1-\lambda) \sum_{i, \tau} \E \left[ (u_i' x_t^{\text{st}} )^2 (u_i' x_{t+\tau}^{\text{st}} )^2 \right].
\]

For supervised dimension reduction
(\textsc{tsir}, \textsc{tsave}, \textsc{tssh}),
approximately jointly diagonalize
\begin{align*}
  G_\tau(x_t^{\text{st}}, y_t) &= \cov \E[ z_t | y_{t+\tau} ] \\
  \text{or }
  G_\tau(x_t^{\text{st}}, y_t) &= \E \bigl[ I_p - \cov( z_t | y_{t+\tau} ) \bigr]   
\end{align*}
by maximizing 
\[ \sum_{\tau, i} ( u_i ' G_\tau u_i ) ^2 . \]

\nextbook
\begin{book}
  \emph{Dimension reduction in R}\\
  S. Weisberg (2002, 2015)
\end{book}
Supervised dimension reduction of $X$ given $Y$
looks for a subspace $\Span B$ such that the distributions
\[
Y \mid X=x
\quad \text{and} \quad
Y \mid BX=Bx
\] coincide,
by using the first eigenvectors of
\begin{align*}
  M &= \dfrac1n \sum_j \bar z_j \bar z_j '
  \\
  M &= \dfrac1n \sum_j \bigl( I - \var[ Z | Y - j ] \bigr)^2
  \\
  M &= \sum_i y_i z_i z'_i
  \\
  M &= \sum \text{res}( y \sim x ) _i z_i z'_i
\end{align*}
(\textsc{sir} (sliced inverse regression),
\textsc{save} (sliced average variance estimates),
\textsc{phd} (principal Hessian directions))
where \begin{compactitem}[--]
\item $z$ is the standardization of $x$;
\item $y$ is discrete, with values $j=1,\dots,h$
  (slice it into equal-sized bins if needed);
\item $z_j = \E[ Z \mid Y = j ]$.
\end{compactitem}
Implementation in \texttt{dr}.
  
\nextbook
\begin{book}
  \emph{Principal component analysis\\ with sparse fused loading}\\
  J. Guo et al. (2010)
\end{book}
Adding an $L^1$ penalty to PCA does not give enough sparsity:
relax the orthogonality constraint by looking for $A$ and $B$ such that
$X \approx X BB'$ (projection of $X$ on $\Span B$),
$B \approx A$, $A$ orthogonal:
\[
\hspace*{-1.5mm}
\begin{array}{ll}
  \text{Find} & A, B \\
  \text{To minimize\hspace*{-2.5mm}} & \n{ X \!-\! X B A' }^2 +
  \lambda_1 \!\sum\limits_k \n{ \beta_k }_1 +
  \lambda_2 \!\sum\limits_k \n{ \beta_k }_2 ^2 \\
  \text{Such that} & A A' = I.
\end{array}
\]
You can replace the second penalty with a \emph{fusion penalty}
to pull the coefficients together when the correlation is high.
\[
\lambda_2 \sum_k \sum_{s<t}
\va{ \rho_{st} }
\va{ \beta_{sk} - \text{sign}(\rho_{st}) \beta_{tk} }
\]
  
\nextbook
\begin{book}
  \emph{SQUAREM: an R package\\ for off-the-shelf acceleration of EM, MM\\ and other EM-like monotone algorithms}\\
  Y. Du and R. Varadhan (2020)
\end{book}
The square iterative method (\textsc{squarem}) speeds up the convergence of EM-like monotone iterative algorithms
\begin{align*}
  \theta_{n+1} &= F(\theta_n) \\
  L(\theta_{n+1}) & \geq L(\theta_n) 
\end{align*}
by iterating:
\begin{align*}
  & \theta_1 = F(\theta_0) \\
  & \theta_2 = F(\theta_1) \\
  & r = \theta_1 - \theta_0 \\
  & v = ( \theta_2 - \theta_1 ) - r \\
  & \alpha = - \n r / \n v \\
  & \theta_3 = \theta_0 - 2 \alpha r + \alpha^2 v \\
  & \text{if } L(\theta_3) > L(\theta_2) - \eta: \\
  & \qquad \theta_0 = F(\theta_3) \\
  & \text{else:} \\
  & \qquad \theta_0 = \theta_2.
\end{align*}
Examples include:
\begin{compactitem}[--]
\item Poisson mixtures;
\item Ecdf estimation from interval-censored data;
\item Admixture (estimating the proportion of each ancestral population in each individual, and the proportion of each allele in each ancestry);
\item MM for logistic regression;
\item Factor analysis
  \begin{align*}
    Z & \sim N(0,I) && \text{latent} \\
    Y & \sim N( \beta' Z , \Delta ) && \text{observed.}
  \end{align*}
\end{compactitem}

\nextbook
\begin{book}
  \emph{The R package smicd:\\ statistical methods for interval-censored data}\\
  P. Walter
\end{book}
  
\nextbook
\begin{book}
  \emph{Fully hyperbolic convolutional neural networks}\\
  K. Lensink et al.
\end{book}
Hyperbolic networks
\[ Y_{j+1} = 2 Y_j - Y_{j-1} + f_\theta(Y_j), \]
\ie, discretizations of $\ddot y = f_\theta(y) $
are invertible (we can recover $Y_{j-1}$ from $Y_j$ and $Y_{j+1}$).
Combine them with learned discrete wavelet transforms
to coarsen the state and increase the dimension without losing information.

% Nice plot

\nextbook
\begin{book}
  \emph{Generative ODE modeling\\ with known unknowns}\\
  O. Linial et al. (2021)
\end{book}
To estimate the parameters $\theta$ of an ODE
$\dot z = f_\theta(z)$
for which only an (unknown) transformation of the state $z=g(z)$ is observed,
use an autoencoder
\[
\begin{tikzpicture}[>=stealth,xscale=2.2,inner sep = 1pt, outer sep = 0pt]
  \node (A) at (0,0) {$(x_t)_t$};
  \node (B) at (1,0) {$\theta, z_0$};
  \node (C) at (2.4,0) {$(z_t)_t$};
  \node (D) at (3.4,0) {$(x_t)_t$};
  \draw[|->] (A) -- node[auto,above=1pt,pos=.5] {\footnotesize encoder} (B);
  \draw[|->] (B) -- node[auto,above=1pt,pos=.5] {\footnotesize known ODE} node[auto,below=1pt,pos=.5] {\footnotesize $\dot z = f_\theta(z)$} (C);
  \draw[|->] (C) -- node[auto,above=1pt,pos=.5] {\footnotesize decoder} (D);
\end{tikzpicture}
\]
  
\nextbook
\begin{book}
  \emph{Exterior point operator splitting\\ for nonconvex learning}\\
  S. Das Gupta et al. (2021)
\end{book}
A closed set is \emph{prox-regular} at a point if projection onto it
is single-valued in the neighbourhood of this point.
Examples include sparsity and low rank:
\begin{align*}
  N &= \{ x \in \RR^d \ :\ \# x \leq k \} \\
  N &= \{ X \in \RR^{m\times d} \ :\ \operatorname{rank} X \leq k \}.
\end{align*}

To solve the optimization problem
\[
\begin{array}{ll}
  \text{Find} & x \\
  \text{To minimize} & f(x) + \tfrac12 \beta \n x ^2 \\
  \text{Such that} & x \in C \inter N 
\end{array}
\]
where $f$ is convex, $C$ is convex, $N$ is non-convex but prox-regular around local minima,
replace the constraint with an indicator function
\[
\begin{array}{ll}
  \text{Find} & x \\
  \text{To minimize} & f(x) + \tfrac12 \beta \n x ^2 + \iota(x)\\[1mm]
  \text{Where} & \iota(x) = \begin{cases}
    0 &\text{if } x \in C \inter N \\
    \infty & \text{otherwise},
  \end{cases}
\end{array}
\]
regularize it
\begin{align*}
  \iota_\mu(x) &= \min_y \iota(y) + \dfrac1{2\mu} \n{ y - x } ^2 \\
  &= \dfrac1{2\mu} d(x, C \inter N )^2
\end{align*}
and progressively decrease $\mu$ (e.g., from 1 to $10^{-4}$).

To solve each subproblem
\[ \operatorname*{Minimize}_x f(x) + \underbrace{ \iota_\mu(x) + \tfrac12 \beta \n x ^2 }_{\boldsymbol{\iota}(x)} \]
use ADMM (Douglas-Rachford)
\begin{align*}
  x & \leftarrow \operatorname{prox}_{\gamma f} z \\
  y & \leftarrow \operatorname{prox}_{\gamma \boldsymbol{\iota}} ( 2 x - z ) \\
  z & \leftarrow z + y -x 
\end{align*}
where $\operatorname{prox}_{\gamma f} z$ is the solution of a convex optimization problem,
often known in closed form, and $\operatorname{prox}_{\gamma \boldsymbol{\iota}}$
can be computed from the projection onto $C\inter N$.

Implementation in \texttt{NExOS.jl}.

\nextbook
\begin{book}
  \emph{High frequency covariance: a Julia package for estimating covariance matrices\\ using high-frequency financial data}\\
  S. Baumann and M. Klymak (2021)
\end{book}
To estimate volatility in presence of microstructure noise:
\begin{compactitem}[--]
\item Either use large intervals, so that the microstructure noise disappears;
\item Or combine the sample volatility estimators at two different scales.
\end{compactitem}

To estimate the covariance from asynchronous time series:
\begin{compactitem}[--]
\item Choose a grid of times and compute the correlation using the last available log-prices
  \[ \cov(X,Y) = \dfrac1N \sum_i ( X_{\leq t_i} - \bar X )( Y _{\leq t_i } - \bar Y ) \]
  (but the correlations are biased downwards);
\item \emph{Refresh time sampling} (BNHLS) uses an adaptive grid
  where the next time is the time at which each asset has an updated price;
  you may want to put assets in blocks of similar trading frequencies;
\item Pre-averaging averages returns on a moving window and multiplies the returns of two assets when the windows intersect;
\item The spectral local method of moments is another estimator;
\item The 2-scale volatility estimator can be used to compute covariances:
  \[ \hspace*{-3mm}
  \cov(X,Y)
  \!=\!
  \dfrac{
    \var[ \gamma X + (1\!-\!\gamma) Y ] -
    \var[ \gamma X - (1\!-\!\gamma) Y ]
  }{4 \gamma ( 1 - \gamma )}
  \]
\end{compactitem}

To make sure the covariance matrix is positive semi-definite:
\begin{compactitem}[--]
\item Linearly interpolate with the identity;
\item Or replace eigenvalues below a threshold with the average of the (positive) eigenvalues thus discarded.
\end{compactitem}

For the correlation matrix, iterate:
\begin{compactitem}[--]
\item Take the nearest positive semi-definite matrix;
\item Take the nearest matrix with unit diagonal and off-diagonal elements in $[-1,+1]$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{On covariation estimation for multivariate continuous It\=o semimartingales with noise\\ in non-synchronous observation schemes}\\
  K. Christensen et al. (2011)
\end{book}
To estimate a covariance matrix from asynchronous data,
in presence of microstructure noise,
first average the returns,
with some kernel function,
pooling $k$ consecutive ticks, $k \propto n$,
then use the Hayashi-Yoshida estimator:
\[
\rho_{\text{HY}} = \dfrac{
  \displaystyle
  \sum\limits_{ I_i^X \inter I_j^Y \neq \nothing } \Delta X_i \Delta Y_j
}{
  \sqrt{ \sum ( \Delta X_i )^2 \sum ( \Delta Y_j )^2 }
}.
\]
  
\nextbook
\begin{book}
  \emph{Estimating the quadratic covariation matrix\\ from observations:\\
  local method of moments and efficiency}\\
  M. Bibinget et al. (2014)
\end{book}
% Too technical
Estimator of the variance matrix, from asynchronous data, in presence of microstructure noise,
from the Fourier coefficients of the time series on subintervals of $[0,1]$
\begin{align*}
  S_{jk\ell} &= \sum_i ( Y_{i\ell} - Y_{i-1,\ell} )
  \, \Phi_{jk} \!\left( \dfrac{ t_{i-1,\ell} + t_{i\ell} }{2} \right) \\
  \Phi_{jk} &=
\begin{tikzpicture}[>=stealth,xscale=.1,yscale=.4,inner sep=0pt,outer sep=2pt,baseline=-3]
\draw (-3,0) -- (21,0);
\draw[ultra thick]
    (-3,0) --
    (3,0) sin (4,1) cos (5,0) sin (6,-1) cos (7,0)
          sin (8,1) cos (9,0) sin (10,-1) cos (11,0)
          sin (12,1) cos (13,0) sin (14,-1) cos (15,0)
          -- (21,0);
\node[anchor=north east] at (3,0) {\footnotesize $kh$};
\node[anchor=north west] at (15,0) {\footnotesize $(k+1)h$};
\draw[dotted] (3,0) -- (3,-1.5);
\draw[dotted] (15,0) -- (15,-1.5);
\draw[<->] (3,-1.5) -- node[auto,below=1pt,pos=.5] {\footnotesize $j$ periods} (15,-1.5);
\end{tikzpicture}
\end{align*}
  
\nextbook
\begin{book}
  \emph{BayesNetBP: an R package for probabilistic reasoning in Bayesian networks}\\
  H. Yu et al. (2020)
\end{book}
To use a
conditional Gaussian Bayesian network (CG-BN, \ie, a PGM with a mixture of
discrete and continuous nodes)
estimated by \texttt{bnlearn}, \texttt{catnet}, \texttt{deal}, \texttt{pcalg},
or Hugin (commercial).
  
\nextbook
\begin{book}
  \emph{ROI: an extensible\\ R optimization infrastructure}\\
  S. Theu\ss l et al. (2020)
\end{book}
The \texttt{ROI} package provides a unified interface to most optimization packages
(linear, mixed integer, conic, quadratic, nonlinear -- there is a long list of supported solvers):
specify the objective (linear, mixed integer, quadratic or nonlinear),
the constraints (linear, second order, semi-definite, (dual) exponential, (dual) power cone, nonlinear),
the bounds (and integrality constraints),
and the solver (the package can provide a list of solvers suitable for the problem).
Some problems can be automatically reformulated (e.g., binary QP to MILP).

Examples include:
\begin{compactitem}[--]
\item Best subset regression (linear regression with an $\ell_0$ penalty);
\item Relative risk regression (logistic regression for the relative risk instead of the odds ratio,
  \ie, with a log link);
\item Convex clustering (sum of norm (SON) clustering):
  \[
  \operatorname*{Minimize}_M \sum_i \n{ M_{i\bigcdot} - X_{i\bigcdot} }_2^2 +
  \lambda \sum_{i<j} \n{ M_{i\bigcdot} - M_{j\bigcdot} }_1 ;
  \]
\item Graphical lasso.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{CVXR: an R package\\ for disciplined convex optimization}\\
  A. Fu et al. (2020)
\end{book}
Long list of examples of convex optimization problems:
\begin{compactitem}[--]
\item Huber regression ($L^2$ for small residuals, $L^1$ for large ones);
\item Quantile regression;
\item Elastic net;
\item Logistic regression ($z \mapsto \log ( 1 + e^z )$ is convex);
\item Graphical lasso
  \[
  \begin{array}{ll}
    \text{Find} & S \\
    \text{To maximize} & \log \det S - \tr ( S \hat \Sigma ) \\
    \text{Such that} & S \succcurlyeq 0 \\
    & \sum \va{ S_{ij} } \leq \alpha
  \end{array}
  \]
\item Saturating hinges (linear splines, constant beyond their boundaries)
  \[
  \begin{array}{ll}
    \text{Find} & w_0, w \\
    \text{To minimize} & \sum_k \ell\bigl( y_i , f(x_i) \bigr) + \lambda \n w _1 \\
    \text{Such that} & \sum_{j=1}^k w_j = 0
  \end{array}
  \]
\item Log-concave distribution estimation on $\llbracket 0, k \rrbracket$.
\item Survey calibration (changing the weights as little as possible so that the
  statistics of the sample match those of the population)
\item Nearly isotonic fit: replace the constraints
  $\beta_{i+1} \geq \beta_i$ with a penalty on $(\beta_i - \beta_{i+1})_+$;
\item Nearly convex fit: idem with $(\beta_i - 2 \beta_{i+1} + \beta_{i+2})_+$
\item Worst case risk of a portfolio with constraints on the asset variance matrix
  (e.g., known variances and correlation signs)
  \[
  \begin{array}{ll}
    \text{Find} & \Sigma \\
    \text{To maximize} & w' \Sigma w \\
    \text{Such that} & \Sigma \succcurlyeq 0 \\
    & \forall i,j \quad L_{ij} \leq \Sigma_{ij} \leq U_{ij}
  \end{array}
  \]
\item Catenary (with a ground constraint);
\item Portfolio optimization;
\item Kelly gambling;
\item Channel capacity (maximum mutual information);
\item Fastest mixing Markov chain on a known directed graph:
  the rate of convergence is the second largest eigenvalue of $P$, \ie,
  $\sigma_{\text{max}}( P - \tfrac1n \mathbf 1 \mathbf 1')$.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{cutpointr: improved estimation and validation of optimal cutpoints in R}\\
  C. Thiele and G. Hirschfeld (2021)
\end{book}
For more robust cutpoints for (logistic-regression-like) classification algorithms
\[ \text{data} \longmapsto \text{score} \longmapsto \mathbf1_{ \text{score} \geq \text{cutpoint} } \]
optimize the Youden index
\begin{align*}
  J &= \text{sensitivity} + \text{specificity} - 1 \\
  \text{sensitivity} &= \dfrac{ \text{TP} }{ \text{TP} + \text{FN} } \\
  \text{specificity} &= \dfrac{ \text{TN} }{ \text{TN} + \text{FP} }
\end{align*}
or some other metric,
not on the sample data, but:
\begin{compactitem}[--]
\item After bootstrap (average the optimal cutpoints);
\item Or after smoothing the cutpoint\,$\mapsto$\,metric function (GAM, splines, loess);
\item Or using a kde of the conditional distributions
  \[
  \text{score} \mid \text{P}
  \quad \text{and} \quad
  \text{score} \mid \text{N}.
  \]
\end{compactitem}

\nextbook
\begin{book}
  \emph{Colorspace: a toolbox for manipulating\\ and assessing colors and palettes}\\
  A. Zeileis et al. (2020)
\end{book}
There are many colour spaces:
\begin{compactitem}[--]
\item RGB;
\item sRGB (device-independent: fixed Gamma);
\item HSV, whose dimensions are confounded: brightness changes dramatically with hue;
\item HLS (very similar);
\item XYZ (not perceptually uniform, unintuitive, but standardized);
\item LUV: perceptually uniform, for emissive technologies,
  but the UV dimensions (red/green and yellow/blue) are unintuitive;
\item LAB (similar, for pigments);
\item polarLUV, aka HCL -- that is the one you should use;
\item polarLAB.
\end{compactitem}
The package provides many predefined palettes,
functions to evaluate a palette (\texttt{demoplot}, \texttt{hclplot},
\texttt{specplot}, \texttt{swatchplot}), some interactively
(\texttt{hcl\_wizard}, \texttt{hcl\_color\_picker}, \texttt{cvd\_emulator})
and also desaturate, lighten, darken.

Many other packages provide collour palettes:
\texttt{RColorBrewer},
\texttt{viridis},
\texttt{rcartocolor},
\texttt{scico},
\texttt{pals},
\texttt{paletteer},
\texttt{wesandreson},
\texttt{Polychrome};
also check
\texttt{colorscience} (more complex algorithms),
\texttt{roloc} (English colour names).
\[
<<colorspace-hclplot,results='hide',echo=FALSE,fig.width=4,fig.height=4,out.width='.5\\hsize',fig.show='hold'>>=
library(DBQR)
library(colorspace)
hclplot( quintile_colours[1:5] )
@
\]

\nextbook
\begin{book}
  \emph{FastSHAP: real-time Shapley value estimation}\\
  N. Jethani et al. 
\end{book}
The Shapley score is the solution of an optimization problem:
\[
\begin{array}{ll}
  \text{Find} & \phi \\
  \text{To minimize} & \E\limits_{ s \sim p} \bigl[ v(s) - v(\mathbf0) - s' \phi \bigr] \\
  \text{Such that} & \mathbf 1' \phi = v(\mathbf1) - v(\mathbf0)
\end{array}
\]
where $p$ is the Shapley kernel;
it can be solved by gradient descent.

If you want Shapley scores for many inputs to the same neural net,
learn a function to compute the solution of that problem
(for the constraint, either ignore it and modify the solution to satisfy it,
or add it as a penalty).

% Why is it so different from KernelSHAP, which solves the same problem anew for each input.

\nextbook
\begin{book}
  \emph{Efficient estimation of bid-ask spreads\\ from open, high, low and close prices}\\
  D. Aria et al. (2021)
\end{book}
Assuming that observed log-prices are the latent prices plus or minus half the spread,
\begin{align*}
  \log P_t &= \log \tilde P_t + S \cdot ( B_t - \tfrac12 ) \\
  B_t & \sim \text{Bernoulli}
\end{align*}
the spread is given by
\[ \cov( \Delta \log P_t , \Delta \log P_{t-1} ) = -\tfrac14 \text{Spread}^2 \]
unless there are periods with no trades.
More generally,
\[ \text{Spread}^2 = - \dfrac{
  4 \cov( \Delta \log P_t , \Delta \log P_{t-1} )
}{
  ( 1 - P[ P_t = P_{t-1} ] ) ^2.
}
\]
This can be extended to OHLC data.
  
\nextbook
\begin{book}
  \emph{A characterization of cross-impact kernels}\\
  M. Rosenbaum and M. Tomas (2021)
\end{book}
Model price impact as
\[ P_t - P_0 = \int_0^t K(t-s) ( d N_s^a - N_s^b ) \]
where $(N^a,N^b)$ is a multi-dimensional Hawkes process with intensity
\[
\begin{pmatrix} \lambda^a_t \\ \lambda^b_t \end{pmatrix} =
\begin{pmatrix} \mu \\ \mu \end{pmatrix}
+ \int_0^t
\begin{pmatrix} 
  \Phi^{aa}(t-s) & \Phi^{ab}(t-s) \\
  \Phi^{ba}(t-s) & \Phi^{bb}(t-s) \\
\end{pmatrix}
\begin{pmatrix} d N^a_s \\ d N^b_s \end{pmatrix}
\]
and $K: \RR_+ \to \RR^{d \times d}$ is the cross-impact kernel.

A martingale-admissible kernel is a kernel for which the prices are a martingale;
this is the case if
\begin{align*}
  P_t \!-\! P_0 &= \text{long-term\,impact} \!\times\! \text{long-term\,order\,imbalance} \\
  &= \biggl( \lim_{s \to \infty} K(s) \biggr)
  \times
  \biggl( \lim_{s\to\infty} \E[ N_s^a - N_s^b | \mathscr F_t ] \biggr).
\end{align*}
A no-arbitrage condition imposes constraints on $K(0)$
and $\lim_{s\to\infty} K(s)$;
there is only one martingale-admissible kernel satisfying those (necessary) conditions;
it need not ensure the absence of arbitrage, but fits the data well,
and one can compute the closest no-arbitrage kernel.

\nextbook
\begin{book}
  \emph{DAGs with NO TEARS:\\ continuous optimization for structure learning}\\
  X. Zheng et al. (2018)
\end{book}
A graph is acyclic if its adjacency matrix satisfies $\tr e^A = d$ -- indeed,
\[ \tr e^A = \tr I + \tr A + \dfrac1{2!} \tr A^2 + \cdots \geq \tr I = d \]
and $\tr A^k$ counts cycles of length $k$.

For a weight matrix $W$, use $h(w) = \tr e^{ W \odot W } - d$
($W\odot W$ has the same sparsity as $W$ and nonnegative entries).
  
\nextbook
\begin{book}
  \emph{Dynotears:\\ structure learning from time series data}\\
  R. Pamfil et al. (2020)
\end{book}
Use the trace exponential function to enforce acyclicity of $W$ in the SVAR model
\[ \mathbf x_t = W \mathbf x_t + A_1 \mathbf x_{t-1} + \cdots + A_p \mathbf x_{t-p} + \epsilon_t. \]
  
\nextbook
\begin{book}
  \emph{Beyond prediction in neural ODEs: identification and interventions}\\
  H. Aliee et al.
\end{book}
Estimating an ODE from a single trajectory is an ill-posed problem:
even in the linear case, the ODE is not uniquely determined:
\[ ( \forall t \ e^{tA} = e^{tB} ) \centernot\implies A = B . \]
Adding a regularizer does not help but, in practice,
this does not seem to matter,
and a simple regularization
\[ \n \theta _{\text{simple}} = \n{ W^{L+1} W^L \cdots W^1 }_{1,1} \]
(the $L^1$ norm of the gradient of the neural network, if we remove the nonlinearities)
correctly recovers causal relations.
  
\nextbook
\begin{book}
  \emph{Forecasting stock returns\\ with large dimensional factor models}\\
  A. Giovannelli and D. Massacci (2021)
\end{book}
Statistical factor models explain current stock returns from risk factors computed from current stock returns.
Instead, explain \emph{future} stock returns using risk factors computed from other time series.
\begin{align*}
  y_{it} &\text{: trailing stock returns} \\
  x_{jt} &\text{: predictors, known at time $t$} \\
  f_{kt} &\text{: factors}\\
  y_{i,t+1}&=\sum_k \beta_{ik} f_{kt} + \epsilon_{i,t+1} \\
  f_{kt} &= \sum_j \gamma_{kj} x_{jt} + \eta_{kt}
\end{align*}
% Their model is dynamic, so it is different -- but the paper is too technical

\nextbook
\begin{book}
  \emph{Industrial forecasting with exponentially smoothed recurrent neural networks}\\
  M. Dixon (2020)
\end{book}
An $\alpha$-RNN is an RNN
\begin{align*}
  h_t &= \tanh ( W x_t + U h_{t-1} + b ) \\
  y_t &= W h_t + b 
\end{align*}
with a smoothed hidden state
\begin{align*}
  \tilde h_t &= \tanh ( W x_t + U h_{t-1} + b ) \\
  h_t &= (1-\alpha) h_{t-1} + \alpha \tilde h _t \\
  y &= W h_t + b
\end{align*}
(apply $\alpha$ coordinate-wise, and re-estimate it from time to time).
  
\nextbook
\begin{book}
  \emph{stratematch: prognostic score stratification\\ using a pilot design}\\
  R.C. Aikens et al.
\end{book}
Before (propensity score or Mahalanobis) matching,
stratify the data (fit a model
$y \sim x | T=0$ on some of the controls -- do not reuse these data).
  
\nextbook
\begin{book}
  \emph{Solving mixed integer programs\\ using neural networks}\\
  V. Nair et al.
\end{book}
Represent a mixed integer program (MIP) as a bipartite graph
with variables and constraints as nodes,
edges whenever a variable appears in a constraint,
and node or edge features from the coefficients of the problem
(and the solution of the relaxation)
and learn two models
(heuristics customized to a dataset):
\begin{compactitem}[--]
\item A branching model, using imitation learning to reproduce a known good
  (but expensive) branch-and-bound heuristic (``full strong branching'');
\item A ``diving'' model, to generate good partial assignments.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Exact combinatorial optimization\\ with graph convolutional neural networks}\\
  M. Gasse et al. (2019)
\end{book}
Imitation learning to reproduce known good heuristics;
list of additional features, mostly from the solution of the relaxed problem.

\nextbook
\begin{book}
  \emph{A unified algorithm for the non-convex penalized estimation: the ncpen package}\\
  D. Kim et al. (2020)
\end{book}
Optimization of a convex loss with a non-convex penalty
can be performed with the CCCP (convex concave procedure, or difference of convex (DC) algorithm):
write the objective as a difference of convex functions
\begin{align*}
  \text{Loss}(\beta) &= L(\beta) + \sum J\bigl( \va{\beta_i} \bigr) \\
  &= \underbrace{ L(\beta) + \kappa \sum \va{\beta_i} }_{\text{convex}}
  +
  \underbrace{ \sum D(\beta_i) }_{\text{concave}} \\
  \text{Loss}(\beta) &\leq L(\beta) + \kappa \sum \va{\beta_i} + \sum \nabla D( \bar \beta_i ) \beta_i \\
  &= U( \bar\beta, \beta)
\end{align*}
and iteratively minimize the upper bound obtained by linearizing the concave term
\[ \bar \beta \leftarrow \argmin_{\beta} U( \bar\beta, \beta ). \]
To minimize $U$, use a quadratic approximation of $L(\beta)$ around $\bar\beta$,
combined with line search.

<<ncpen,results='hide',echo=FALSE,fig.width=5,fig.height=3,out.width='\\hsize',fig.show='hold'>>=
MCP <- function(t, lambda=1, tau=1)
  ifelse( abs(t) <= tau * lambda, lambda * abs(t) - t^2 / 2 / tau, tau * lambda ^2 / 2 )
truncated_l1 <- function(t, lambda=1, tau=1)
  ifelse( abs(t) <= tau, lambda * abs(t), tau*lambda )
modified_log <- function(t, lambda=1, tau=1)
  ifelse( abs(t) <= tau, lambda * abs(t) / tau, lambda * log(abs(t)) + lambda * ( 1 - log(tau) ) )
modified_bridge <- function(t, lambda=1, tau=1)
  ifelse( abs(t) <= tau, lambda / 2 * sqrt(tau) * abs(t), lambda/2 * abs(t) ^ (3/2) )
moderately_clipped_lasso <- function(t, lambda=2, tau=1, gamma=1) {
  before <- function(u) lambda * abs(u) - u^2 / 2 / tau
  after <- function(u) gamma * abs(u)
  threshold <- tau * ( lambda - gamma )
  ifelse( abs(t) <= threshold, before(t), after(t) - after(threshold) + before(threshold) )
}
sparse_ridge <- function(t, lambda=1, tau=1, gamma=1) {
  before <- function(u) lambda * abs(u) - u^2 / 2 / tau
  after <- function(u) gamma * u^2 / 2
  threshold <- tau * lambda / ( tau * gamma + 1 )
  ifelse( abs(t) <= threshold, before(t), after(t) - after(threshold) + before(threshold) )
}
SCAD <- function(t, lambda=1, tau=2) {
  before <- function(u) lambda * abs(u)
  after <- function(u) ( tau * lambda * abs(u) - u^2/2 ) / ( tau - 1 )
  threshold1 <- lambda
  threshold2 <- tau*lambda
  ifelse( abs(t) <= threshold1, before(t),
  ifelse( abs(t) <= threshold2, after(t) - after(threshold1) + before(threshold1),
  after(threshold2) - after(threshold1) + before(threshold1)
  ) )
}
xs <- seq(-2,2,length=101)
xs2a <- xs[ xs < -1 ]
xs2b <- xs[ xs > +1 ]
xs2c <- xs[ abs(xs) <= 1 ]
xs3 <- seq(-3,3,length=101)
xs3a <- xs3[ xs3 < -2 ]
xs3b <- xs3[ xs3 > +2 ]
xs3c <- xs3[ xs3 <= -1 ]
xs3d <- xs3[ xs3 >= +1 ]
xs3e <- xs3[ abs(xs3) <= 1 ]
seq(-3,3,length=101)
xs3 <- seq(-3,3,length=101)
op <- par( mfrow=c(3,3), mar=c(2,1,2,1) )
plot(xs, abs(xs), type = "l", lwd = 5, col=dbColours[1], xlab="", ylab="", main="Lasso", axes = FALSE)
plot(xs, xs**2, type="l", lwd = 5, col=dbColours[3], xlab="", ylab="", axes=FALSE, main="Ridge")
plot(xs3, SCAD(xs3), xlab="", ylab="", axes=FALSE, main="SCAD")
lines(xs3c, SCAD(xs3c), lwd=5, col=dbColours[4] )
lines(xs3d, SCAD(xs3d), lwd=5, col=dbColours[4] )
lines(xs3a, SCAD(xs3a), lwd=5, col=dbColours[2] )
lines(xs3b, SCAD(xs3b), lwd=5, col=dbColours[2] )
lines(xs3e, SCAD(xs3e), lwd=5, col=dbColours[1] )
plot(xs, MCP(xs), type = "l", xlab="", ylab="", axes = FALSE, main="MCP" )
lines(xs2a, MCP(xs2a), lwd = 5, col = dbColours[2] )
lines(xs2b, MCP(xs2b), lwd = 5, col = dbColours[2] )
lines(xs2c, MCP(xs2c), lwd = 5, col = dbColours[4] )
plot(xs, truncated_l1(xs), type = "l", xlab = "", ylab = "", axes = FALSE, main="Truncated L1")
lines( xs2a, truncated_l1(xs2a), col = dbColours[2], lwd = 5 )
lines( xs2b, truncated_l1(xs2b), col = dbColours[2], lwd = 5 )
lines( xs2c, truncated_l1(xs2c), col = dbColours[1], lwd = 5 )
plot(xs, moderately_clipped_lasso(xs), type = "l", xlab = "", ylab = "", axes = FALSE, main = "Moderately clipped lasso")
lines( xs2a, moderately_clipped_lasso(xs2a), lwd = 5, col = dbColours[1] )
lines( xs2b, moderately_clipped_lasso(xs2b), lwd = 5, col = dbColours[1] )
lines( xs2c, moderately_clipped_lasso(xs2c), lwd = 5, col = dbColours[4] )
plot(xs, sparse_ridge(xs), type = "l", xlab = "", ylab = "", axes = FALSE, main="Sparse ridge")
lines( xs2a, sparse_ridge(xs2a), lwd = 5, col = dbColours[3] )
lines( xs2b, sparse_ridge(xs2b), lwd = 5, col = dbColours[3] )
lines( xs2c, sparse_ridge(xs2c), lwd = 5, col = dbColours[4] )
plot(xs, modified_log(xs), type = "l", xlab="", ylab="", axes=FALSE, main="Modified log")
lines(xs2a, modified_log(xs2a), lwd=5, col=dbColours[14] )
lines(xs2b, modified_log(xs2b), lwd=5, col=dbColours[14] )
lines(xs2c, modified_log(xs2c), lwd=5, col=dbColours[1] )
plot(xs, modified_bridge(xs), type="l", xlab="", ylab="", axes=FALSE, main="Modified bridge")
lines(xs2a, modified_bridge(xs2a), lwd=5, col=dbColours[14] )
lines(xs2b, modified_bridge(xs2b), lwd=5, col=dbColours[14] )
lines(xs2c, modified_bridge(xs2c), lwd=5, col=dbColours[1] )
par(op)
@

\nextbook
\begin{book}
  \emph{ROCnReg: an R package for receiver operating characteristic curve inference\\ with and without covariates}\\
  M.X. Rodr\'iguez-\'Alvarez and V. In\'acio (2020)
\end{book}
The ROC curve plots the true and false positive fractions
\begin{align*}
  x &= P[ Y \geq c \mid D = 0 ] \\
  y &= P[ Y \geq c \mid D = 1 ].
\end{align*}
The \emph{partial area under the curve} (pAUC) is the area under the curve
such that $x \in [0,u_1]$ (largest acceptable FPR)
or $y \in [v_1,1]$ (lowest acceptable TPR).
The \emph{Youden index} is
\[ \text{YI} = \max_p \va{ \text{ROC}(p) - p }. \]

One can also consider the \emph{covariate-specific ROC}
$\text{ROC}(p|x)$
and the \emph{covariate-adjusted} one
\[ \text{AROC}(p) = \int \text{ROC}(p|x) dP(x) \]
(it is different from the \emph{pooled ROC}).

One can compute bootstrap estimates of the ROC curve
(it can be considered as a cdf)
and confidence intervals for the AUC;
there are also frequentist and Bayesian approaches.

\nextbook
\begin{book} 
  \emph{Precision-recall-gain curves:\\ PR analysis done right}\\
  P.A. Flach and M. Kull
\end{book}
In case of class imbalance, if there are too many negative samples,
ignore the true negatives and consider the precision-recall curve.

Rescale $1/$precision and $1/$recall, linearly, so that they span $[0,1]$,
before making the precision-recall plot and computing its area under the curve
(ignore the negative gains).
\begin{align*}
  \text{precG} &= \dfrac{ \text{prec} - \pi }{ (1-\pi) \text{prec} }
  = 1 -\dfrac{ \pi }{ 1 - \pi } \dfrac{ \text{FP} }{ \text{TP} } \\
  \text{recG} &= \dfrac{ \text{rec} - \pi }{ (1-\pi) \text{rec} }
  = 1 -\dfrac{ \pi }{ 1 - \pi } \dfrac{ \text{FN} }{ \text{TP} } \\
\end{align*}

\nextbook
\begin{book}
  \emph{NlinTS: an R package\\ for causality detection in time series}\\
  Y. Hmamouche (2020)
\end{book}
Nonlinear generalizations of Granger causality include
\begin{compactitem}[--]
\item Nonlinear models, \ie, comparing
  \begin{align*}
    Y_t &= f( Y_{<t} ) + \epsilon_t \\
    \llap{\text{and }} Y_t &= g( Y_{<t}, X_{<t} ) + \epsilon_t
  \end{align*}
  where $f$ and $g$ are neural networks;
\item Transfer entropy
  \begin{align*}
    \text{TE}_{X \to Y} &= I( Y_t ; X_{<t} \mid Y_{<t} ) \\
    &= H( Y_t \mid Y_{<t} ) - H( Y_t \mid Y_{<t} , X_{<t} )
  \end{align*}
  which can be normalized by dividing by $H( Y_t \mid Y_{<t} )$.
\end{compactitem}
Estimators of transfer entropy often rely on discretization.
Instead, one can use nearest neighbours.
\begin{align*}
  H(X) &= - \E_{ x \sim p } \bigl[ \log p(x) \bigr] \\
  \hat H(X) &= -\dfrac1n \sum \log \hat p (x_i) \\
  \hat H(X) &= \Gamma(n) - \Gamma(k) + \log c + \dfrac mn \sum d_i
\end{align*}
(assuming that $\hat p$ is locally constant in balls around each $x_i$,
where $\Gamma$ is the gamma function,
$m$ the dimension,
$d_i$ twice the distance between $x_i$ and its $k$th nearest neighbour,
and $c$ the volume of the unit ball.
(The estimator can be improved by letting $k$ vary with~$i$.)

\nextbook
\begin{book}
  \emph{tsmp: an R package for time series\\ with matrix profile}\\
  F. Bischoff and P.P. Rodrigues (2020)
\end{book}
% not clear, potentially useful

\nextbook
\begin{book}
  \emph{Model-based clustering\\ of multivariate ordinal data\\ relying on a stochastic binary search algorithm}\\
  C. Biernacki and J. Jacques (2015)
\end{book}
To sample from the BOS (binary ordinal search) model for ordinal data on $\llbracket 1, m \rrbracket$
with location $\mu$ and precision $\pi$, search $\mu$ in $\llbracket 1,m \rrbracket$
with stochastic binary search:
\begin{compactitem}[--]
\item Start with the interval of candidates $\llbracket 1 , m \rrbracket$;
\item Pick an element at random in the interval of candidates;
\item Compare it with $\mu$, with probability $\pi$;
  if there is no comparison, select the result with probabilities proportional
  to the lengths of the intervals $e_<$, $e_=$, $e_>$;
\item Reduce the interval accordingly;
\item Continue until the interval is a singleton.
\end{compactitem}

It can be estimated with the EM algorithm if $m\leq 8$
(the latent variables are the pivots chosen and whether the comparisons were performed).
One can also consider mixtures and/or multivariate extensions.

\nextbook
\begin{book}
  \emph{OneStep:\\ Le Cam's one-step estimation procedure}\\
  A. Brouste et al. (2020)
\end{book}
Instead of computing the MLE:
\begin{compactitem}[--]
\item Start with a crude estimate, e.g., from moment matching, quantile matching,
  or the MLE on a small sample of the data;
\item Do only one Newton step
  \[ \theta \leftarrow \theta - I_\theta^{-1} \dfrac1n \sum \dot \ell ( \theta , x_i ) \]
  using the information matrix $I_\theta$ if known,
  or an estimator \[ \hat I_\theta = - \dfrac1n \sum \ddot \ell ( \theta , x_i ). \]
\end{compactitem}
It is faster than the MLE, and still asymptotically efficient.

\nextbook
\begin{book}
  \emph{Regularized transformation models:\\ the tramnet package}\\
  L. Kook and T. Hothorn
\end{book}
Statistical models often estimate a conditional mean: they look for a function $f$ such that
\[ f(x) = \E[ Y | X\!=\!x ]. \]
Instead, \emph{transformation models} estimate the whole conditional distribution
\[ Y | X\!=\!x \,\,\sim\,\, f( \cdot | X\!=\!x). \]
They can still be linear:
$ f(Y) - X' \beta \sim N(0,1)$.
The transformation can be parametrized with \emph{Bernstein polynomials}
\[ b_{n,k} = \binom nk x^k (1-x)^{n-k}, \]
for which monotonicity is easy to enforce
($\sum_k \theta_k b_{k,n}$, $\theta_k \leq \theta_{k+1}$;
cf the \texttt{basefun} package).
The models can be stratified (a different transformation for each value
of a categorical variable, but the same linear parameters $\beta$).

\nextbook
\begin{book}
  \emph{Skew-t expected information matrix evaluation and use for standard error calculations}\\
  R.D. Martin et al. (2020)
\end{book}
The standard skew normal distribution has density $f(x) = 2 \phi(x) \Phi(\alpha x)$.
The standard $T$ distribution is the distribution of $T = Z / (\chi_\nu^2/\nu)$,
where $Z \sim N(0,1)$ and $\chi_\nu^2$ are independent.
The standard skew-$T$ distribution
is the distribution of $T = Z / (\chi_\nu^2/\nu)$,
where $Z \sim \text{SN}(0,1,\alpha)$.

\nextbook
\begin{book}
  \emph{SimilaR:\\ R code clone and plagiarism detection}\\
  M. Bartoszuk and M. Gagolewski (2020)
\end{book}
Detect plagiarism from the \emph{program dependence graph}:
a tree, indicating how statements are nested (like the AST, but with no ordering),
with ``data dependence edges''
constraining the order in which the statements can be executed.

In addition, canonicalize statements (e.g., spurious braces),
recognize duplicated variables, remove dead code,
assume functions have no side effect (and can be memoized),
rewrite map-like expressions (\texttt{apply*}) as loops.

\nextbook
\begin{book}
  \emph{ROBustness in network (robin):\\ an R package for comparison\\ and validation of communities}\\
  V. Policastro et al. (2020)
\end{book}
To assess the significance of communities in a graph,
check how much perturbation is needed to alter them (titration).

\nextbook
\begin{book}
  \emph{AQuadtree: an R package for quadtree anonymization of point data}\\
  R. Lagonigro et al. (2020)
\end{book}
To preserve privacy, bin spatial data in a quadtree,
putting isolated points in an ``isolated'' bin instead of discarding them.

\nextbook
\begin{book}
  \emph{RNGforGPD: an R package for generation\\ of univariate generalized Poisson data}\\
  H. Li et al. (2020)
\end{book}
The generalized Poisson distribution (GPD)
\[ P(y) = \begin{cases}
  \theta( \theta + \lambda y ) ^ {y-1} e^{ - \theta - \lambda y } \\
  0 \text{ if } \lambda <0 \text{ and } y > \lfloor - \theta / \lambda \rfloor
\end{cases} \]
allows for over- and under-dispersion in count data.

Its multivariate generalization is 
\begin{align*}
  X_i &\sim \text{GPD}(\theta_i, \lambda_i)  && i \in \llbracket 0, m \rrbracket \\
  Y_i &= X_i + X_0  && i \in \llbracket 1, m \rrbracket 
\end{align*}

\nextbook
\begin{book}
  \emph{Package wsbackfit for smooth backfitting estimationo of generalized structured models}\\
  J. Roca-Pardi\~ nas et al. (2020)
\end{book}
\emph{Generalized structured models} (GSM)
\[ \Lambda(Y) = G\bigl( Z , \beta , g(X) \bigr) + S\bigl( T , \delta , s(U) \bigr), \]
with $G$,$S$, $\Lambda$ known, $\beta$, $g$, $\delta$, $s$ unknown,
generalize GAMs
\[ Y = \sum g_i(X_i) + \epsilon \]
and \emph{varying coefficient models}
\[ Y = \sum g_i(X_i) Z_i + \epsilon. \]

\nextbook
\begin{book}
  \emph{gk: an R package for the g-and-k and generalized g-and-h distributions}\\
  D. Prangle (2020)
\end{book}
The g-and-k and g-and-h distributions are 4-parameter univariate distributions
of the form
\begin{align*}
  X &= A + B G(Z) H(Z) \\
  Z &\sim N(0,1)
\end{align*}
where $A$ and $B$ are location and scale parameters,
$G$ introduces asymmetry, and $H$ fattens the tails.
\begin{align*}
  G(z) &= 1 + c \tanh ( g z / 2 ) \\
  H(z) &= z ( 1 + z^2 ) ^k \\
  H(z) &= z \exp( h z^2 / 2 ).
\end{align*}
(They are only defined from their quantiles:
the density is not available in closed form.)

\nextbook
\begin{book}
  \emph{A new versatile discrete distribution}\\
  R. Turner (2020)
\end{book}
The \emph{Beta-binomial distribution}
\begin{align*}
  p &\sim \text{Beta} (\alpha, \beta) \\
  X &\sim \text{Bin}(n,p)
\end{align*}
only allows for over-dispersion and its maximum likelihood estimation is unreliable.
Instead, try the \emph{discretized beta}
\[
p(x) \propto \text{dbeta}_{\alpha, \beta} \left( \dfrac{ x+1 }{ N+2 } \right),
\quad x \in \llbracket 0, N \rrbracket.
\]

\nextbook
\begin{book}
  \emph{Linear fractional stable motion\\ with the rlfsm R package}\\
  S. Mazur and D. Otryakhin (2020)
\end{book}
LFSM generalizes fractional Brownian motion (fBM):
\[ X_t = \int \bigl[ (t+s)_+ ^{ H - 1/\alpha } - (-s)_+^{ H - 1/\alpha } \bigr] dL_s, \]
where $L$ is a symmetric $\alpha$-stable L\'evy motion.

\nextbook
\begin{book}
  \emph{IndexNumber: an R package for measuring the evolution of magnitures}\\
  A. Saavedra-Nieves and P. Saavedra-Nieves (2020)
\end{book}
There are many ways of combining quantities and prices over time,
in a CPI-like fashion:
Paasche, Marshall-Edgeworth, Laspeyres, Fisher indices.

\nextbook
\begin{book}
  \emph{The Lambert way to Gaussianize heavy-tailed data with the inverse of Tukey's $h$ transformation as a special case}\\
  G.M. Goerg (2014)
\end{book}
Tukey's $h$ distribution
\begin{align*}
  U &\sim N(0,1) \\
  Z &= U \exp( \tfrac12 h U^2 ),
\end{align*}
which can be generalized to $Y=\sigma Z + \mu$,
has fat tails.
Conversely, one can use the inverse transformation
(expressible with the Lamber $W$ function, \ie,
the inverse of $u \mapsto u e^u$)
to remove fat tails.

\nextbook
\begin{book}
  \emph{Finding optimal normalizing transformations via bestNormalize}\\
  R.A. Peterson (2020)
\end{book}
To make your data more Gaussian,
try $\log$, $\sqrt\cdot$, $\exp$, Argsinh,
Box-Cox (power transformation),
Yeo-Johnson (Box-Cox, separately for positive and negative inputs),
Lambert $W\times F$,
and ordered quantiles.

\nextbook
\begin{book}
  \emph{R Journal} (2020)\\
\end{book}

The \texttt{crqa} package (recurrence quantification analysis, RQA)
extracts features from a recurrence (or cross-recurrence) plot.

For fast topological data analysis (TDA),
prefer Ghudi in \texttt{TDA} in dimension 2, and Ripser in \texttt{TDAstats} in higher dimensions.

The \texttt{biglasso} package provides out-of-code lasso,
with memory-mapped files and \emph{feature screening rules}.

The \texttt{DChaos} package provides several estimators of the Lyapunov exponent.

The \texttt{ProjectManagement} package designs Gantt charts, identifies critical activities,
computes early and last times of each activity,
manages resources and costs -- e.g., to allocate delay costs using Shapley values.

The futures API
\begin{minted}{R}
  f <- future(expr)
  v <- value(f)
  r <- resolved(f)
\end{minted}
enables asynchronous and parallel processing.
Also check \texttt{future.apply}, \texttt{furrr}. \texttt{doFuture};
\texttt{parallel}, \texttt{foreach}, \texttt{doMC} (Unix), \texttt{doParallel} (Windows);
\texttt{parallely}, \texttt{globals}, \texttt{listenv}.

The \texttt{KSPM} package provides kernel regression.

The \texttt{gofCopula} package provide all the goodness-of-fit tests you can think of,
for the most common copulas.

The \texttt{ari} package generates videos from a presentation and a script, using ffmpeg (\texttt{tuneR})
and (paid) text-to-speech APIs (AWS Polly, Microsoft or Google).

The R-Docker ecosystem has become very large.

Seeded CCA is CCA after dimension reduction
(when $p>n$, it is faster than penalized CCA).

When reshaping data (normalizing a data-frame),
one may use regular expressions,
e.g.,
\texttt{(.*)[.](.*)};
the capture groups can be namaed
\texttt{(?<part>,*)[.](?<dim>.*)};
named argument can simplify this syntax:
\texttt{part='.*', '[.]', dim='.*'}.
Alternatives include \texttt{reshape2},
\texttt{data.table},
\texttt{tidyr},
\texttt{tidyfast},
\texttt{tidyfst}, etc.

The \texttt{TULIP} package provides (six) sparse generalizations of LDA;
it uses \texttt{tensr} for tensor computations.

The \texttt{NTS} package provides non-linear time series models, such as
threshold AR (TAR), functional AR
\[ X_t = \sum_i \phi_i * X_{t-i} + \epsilon_t, \]
where $X_t$, $\epsilon_t$, $\phi_i$ are functions,
and non-linear non-Gaussian state space models
(sequential Monte Carlo, SMC).

The \texttt{cran2copr} package uses Redhat's copr buildsystem to turn CRAN packages
requiring compilation into (rpm-installable) binary packages. Also check \texttt{bspm}
for cross-distribution binary packages.


\nextbook
\begin{book}
  \emph{Deep matrix tri-factorization:\\ mining vertex-wise interactions\\ in multi-space attributed graphs}\\
  Y. He (2020)
\end{book}
Given the incidence matrix of a graph, $G \in \{0,1\}^{n\times n}$,
and node features $S \in \RR^{n\times s}$, $O \in \RR^{n\times o}$,
matrix tri-factorization approximates the graph by finding $\hat S$, $\hat O$, $W$
minimizing
\[ \n{ G - \hat S W \hat O' }^2 + \lambda_1 \n{ S - \hat S } + \lambda_2 \n{ O - \hat O } \]
and can help predict missing edges.
The matrix $W$ ``harmonizes'' the two feature spaces, linearly:
instead, replace the bilinear mapping $(S,O) \mapsto S W O'$ with a neural net;
this generalizes to more than two feature spaces.

\nextbook
\begin{book}
  \emph{Fast nonnegative matrix tri-factorization\\ for large-scale data co-clustering}\\
  H. Wang et al.
\end{book}
The fast nonnegative matrix factorization
\[
\begin{array}{ll}
  \text{Find} & F \in \RR^{d \times m} \\
  & S \in \RR^{m \times c} \\
  & G \in \RR^{ n \times c } \\
  \text{To minimize} & \n{ X - FSG' }^2 \\
  \text{Such that} & F, S, G \geq 0 \\
  & F, G \in \Psi
\end{array}
\]
where $\Psi$ is the set of cluster indicator matrices
(\ie, boolean object$\times$cluster matrices:
$g_{ij}=1$ if $x_i$ belongs to cluster $j$).
It generalizes $k$-means but clusters both rows and columns.

Regularize by adding terms
$\tr( G' L_d G )$ and $\tr( F' L_f F )$
where $L = I - D^{-1/2} W D^{1/2}$
is the normalized graph Laplacian.

\nextbook
\begin{book}
  \emph{Scalable non-negative matrix tri-factorization}\\
  A. \v Copar et al. (2017)
\end{book}
Matrix trifactorization
\[ \operatorname*{Minimize}_{ U, S, V } \n{ X - U S V' }^2, \]
estimated by gradient descent
\begin{align*}
  U &\leftarrow U \odot \dfrac{ X V S' }{ U S V' V S' } \\
  V &\leftarrow V \odot \dfrac{ X' U S }{ V S' U' U S } \\
  S &\leftarrow S \odot \dfrac{ U' X V }{ U' U S V' V }
\end{align*}
possibly with orthogonality constraints $U'U=I$, $V'V=I$,
\begin{align*}
  U &\leftarrow U \odot \sqrt{ \dfrac{ X V S' }{ U U' X V S' } } \\
  V &\leftarrow V \odot \sqrt{ \dfrac{ X' U S }{ V V' S' U S } } \\
  S &\leftarrow S \odot \sqrt{ \dfrac{ U' X V }{ U' U S V' V } } 
\end{align*}
can be computed blockwise.

%%%%%

\nextbook
\begin{book}
  \emph{Constant function market makers:\\ multi-asset trades via convex optimization}\\
  G. Angeris et al. (2021)
\end{book}
Decentralized (crypto-currency) exchanges (DES)
do not use a limit order book (LOB)
but a constant function market maker (CFMM), an automated market maker implemented as a smart contract,
and to which anyone can contribute liquidity (as with an ETF).
Its reserves are $R \in \RR_+^n$ (for $n$ assets)
and it maintains a vector of weights $v \in \RR_+^N$, $\mathbf 1 ' v = 1$
for the stakes of the liquidity providers.
A trade $(\Delta, \Lambda)$
(``I give $\Delta \in \RR_+^n$ and want $\Lambda \in RR_+^n$)
is accepted if $\phi(R + \Delta - \Lambda) = \phi(R)$
(or $R+\gamma\Delta - \Lambda$, $\gamma <1$, to account for a trading fee),
for some concave, increasing, differentiable function $\phi$, such as
\begin{align*}
  \phi(R) &= p' R \qquad \text{ (pegged: constant prices)} \\
  \phi(R) &= \prod R_i ^{ w_i } \\
  \phi(R) &= ( 1-\alpha) \mathbf 1 ' R + \alpha \prod R_i^{w_i} \\
  \phi(R) &= \mathbf 1' R - \alpha \prod R_i^{-1}. 
\end{align*}
The unscaled prices are
\[ p_i = \dfrac{ \partial \phi(R) }{ \partial R_i }; \]
the prices are $p_i/p_n$ if asset $n$ is the num\'eraire.

\nextbook
\begin{book}
  \emph{Inverse options on a Black-Scholes world}\\
  C. Alexander and A. Imeraj (2021)
\end{book}
Options on Deribit, an unregulated bitcoin exchange, are \emph{inverse option}:
options to buy or sell bitcoin, priced, margined and settled in bitcoin,
which avoids the use of USD.
\begin{align*}
  \text{Payoff}_{\text{Call}}(S) &= K. \max( K^{-1} - S^{-1}, 0 ) \\
  S&:\text{ price of BTC in USD} \\
  K&:\text{ strike in USD}
\end{align*}

\nextbook
\begin{book}
  \emph{They chose not to tell you}\\
  B. Knuteson (2021)
\end{book}
Overnight returns are less volatile, and higher, than intraday returns.

<<OvernightVsIntraday,results='hide',echo=FALSE,fig.width=6,fig.height=4,out.width='\\hsize',fig.show='hold'>>=
library(quantmod)
library(DBQR)
x <- getSymbols("^FCHI", auto.assign=FALSE)
intraday <- log( Cl(x) / Op(x) )
overnight <- log( Op(x) / Cl(stats::lag(x,1)) )
intraday <- dbCoalesce( intraday, 0 )
overnight <- dbCoalesce( overnight, 0 )
d <- exp( cbind( intraday = cumsum(intraday), overnight = cumsum(overnight) ) )
op <- par( mar = c(3,3,3,1), lend = 1 )
matplot(d, log='y', main = "CAC 40", ylab = "Wealth", lwd = 5, col = c( dbColours[3], dbColours[1] ) )
legend( "topleft", c( "Overnight", "Intraday" ), lwd = 10, col = c( dbColours[1], dbColours[3] ) )
par(op)
@

\nextbook
\begin{book}
  \emph{A sparsity algorithm\\ with applications to corporate credit rating}\\
  D. Wang et al. (2021)
\end{book}
When looking for a counterfactual explanation of the output of a black-box model,
\ie, the minimum change to the input to change the output,
add a sparsifying penalty to the optimization problem,
to make the explanation more actionable.

\nextbook
\begin{book}
  \emph{Financial return distributions:\\ past, present and covid-19}\\
  M. W\k atorek et al. (2021)
\end{book}
To model distribution tails:
\begin{align*}
  f(x) &\sim \va x ^{ -(1+\alpha) } & \hspace*{-7mm} 0 < \alpha < 2 &&& \text{$\alpha$-stable} \\
  f(x) &\sim \va x ^{ -(1+\alpha) } e^{-\gamma\va x} & \gamma > 0 &&& \text{truncated $\alpha$-stable} \\
  f(x) &\sim \va \exp( x^{-\beta} ) &  \hspace*{-7mm} 0 < \beta < 1 &&& \text{stretched exponential} \\
  f(x) &\sim e_q( - \beta x^2 ) && && \text{$q$-Gaussian}  
\end{align*}
where the $q$-Gaussian distribution maximizes the Tsallis entropy
if the first and second moments are fixed,
and the $q$-exponential is
\[ e_q(x) = \bigl[ 1 + (1-q) x \bigr] _+ ^{ 1 / (1-q) } . \]

\nextbook
\begin{book}
  \emph{End-to-end risk budgeting portfolio optimization with neural networks}\\
  A.S. Uysal et al. (2021)
\end{book}
Do not use risk budgeting blindly: use it end-to-end,
to maximize the information ratio (with \texttt{cvxpylayers}):
\begin{compactitem}[--]
\item Start with features (returns and volatility for 7 ETFs);
\item Use a neural network to compute the risk budgeting parameters, $b$, $c$;
\item Solve the rist budgeting problem
  \[
  \begin{array}{ll}
    \text{Find} & y \geq 0 \\
    \text{To minimize} & y' \Sigma y \\
    \text{Such that} & \sum b_i \log y_i \geq c
  \end{array}
  \]
\item Compute the weights, $w = y / \n{y} _1$;
\item Compute the information ratio.
\end{compactitem}

\nextbook
\begin{book}
  \emph{The unreasonable effectiveness\\ of optimal transport in economics}\\
  A. Galichon (2021)
\end{book}
Applications of optimal transport in economics include many 2-player situations,
such as \emph{matching problems}
\begin{align*}
  &x: \text{ worker} \\
  &y: \text{ job} \\
  &\alpha_{xy}: \text{ job satisfaction} \\
  &\gamma_{xy}: \text{ output} \\
  &w_{xy}: \text{ wage} \\
  &u_x = \max_y ( \alpha_{xy} + w_{xy} )_+ \\
  &v_y = \max_x ( \gamma_{xy} + w_{xy} )_+ \\
  &\text{Maximize } u_x \text{ and } v_y
\end{align*}
or hedonic models
\begin{align*}
  &x: \text{ producer} \\
  &y: \text{ consumer} \\
  &z: \text{ quality} \\  
  &P_z: \text{ price} \\ 
  &C_{xz}: \text{ production cost} \\
  &U_{yz}: \text{ utility} \\
  &\text{Maximize } P_z - C_{xz} \text{ and } U_{yz} - P_z.
\end{align*}

If $P$ (resp. $Q$) is the martingale measure for options on $X$ (resp. $Y$),
the price of an option with payoff $u(X)$, resp. $v(Y)$, is $\E\nolimits_P u(X)$, resp. $\E\nolimits_Q  v(Y)$.
If the market is incomplete and there is no unique martingale measure for $(X,Y)$,
the price of an option with payoff $\Phi(X,Y)$ is at most
\[ \max_{ \pi \in \mathscr M (P,Q) } \E\nolimits_\pi \Phi(X,Y). \]

If $P = \text{Unif}(0,1)$,
the solution of the optimal transport problem is the graph of the cdf of $Q$ --
it defines quantiles. Replacing $[0,1]$ with $[0,1]^n$ gives \emph{multivariate quantiles}.

Inverse optimal transport tries to recover the transport cost $\Phi_{xy}$
from the optimal transport plan $\pi_{xy}$,
often from covariates $\phi_{xyk}$
\[ \pi_{xy} = \exp \bigl[ \sum_k \lambda_k \phi_{xyk} - u_x - v_y \bigr] \]
($\lambda$, $u$, $v$ unknown),
for instance, to link import-exports $\pi$ to several measures of country similarity $\phi_{xyk}$.

\nextbook
\begin{book}
  \emph{Stock price prediction using BERT and GAN}\\
  P. Sonkiya et al. (2021)
\end{book}
Use a GAN to forecast returns (e.g., from technical indicators):
you get a distribution of plausible returns (as with a Bayesian model) --
or an ensemble of forecasts.

\nextbook
\begin{book}
  \emph{Deep risk models: a deep learning solution\\ for mining latent risk factors\\ to improve covariance matrix estimation}\\
  H. Lin et al.
\end{book}
Feed stock returns to:
\begin{compactitem}[--]
\item A GRU, then a FC layer;
\item A GAT (graph attention network), then a GRU and a FC layer
\end{compactitem}
to generate risk factor returns, which are then used linearly, to reproduce stock returns
(the loss is the explained variance, and, to stabilize the model,
the explained forward variance), with a penalty for multicolinearity (VIF).

\nextbook
\begin{book}
  \emph{Correlation scenarios\\ and correlation stress testing}\\
  N. Packham and F. Woebbeking (2021)
\end{book}
Model the correlation matrix as
\begin{align*}
  c_{ij} = \tanh \bigl[ \eta
    & + \sum_k \lambda_k \mathbf1_{\text{only one of $i$ and $j$ is exposed to $k$}} \\
    & + \sum_k \nu_k \mathbf1_{\text{both $i$ and $j$ are exposed to $k$}} \bigr] \\
\end{align*}
where $i$ and $j$ are the assets, and $k$ the risk factors.

\nextbook
\begin{book}
  \emph{Malliavin calculus in finance}\\
  E. Al\'os and D.G. Lorite (2021)
\end{book}

\textbf{1.}
The implied volatility surface is the relation
\[ \sigma \sim \log (F/K) + T \]
where $F$ is the forward price.
For $T$ fixed, it exhibits a smile, a skew;
as $T \to \infty$, it becomes more symmetric and flatter;
empirically, the slope is proportional to $1/\sqrt T$.

In incomplete markets, delta hedging can be replaced by
gamma hedging (hedging $\Delta$ and $\Gamma$ using bond, underlying and vanilla options)
or vega hedging (hedging $\Delta$ and vega).

The implied volatility can be expressed as a weighted average of future volatilities.
\[
I_0 = \dfrac{
  \displaystyle \int_0^T \!\! e^{rt} \sigma_t ^2 \dfrac{ \partial^2 \text{BS} }{ \partial x^2 } S^2 dt 
}{
  \displaystyle \int_0^T \!\! e^{rt} \dfrac{ \partial^2 \text{BS} }{ \partial x^2 } S^2 dt 
}
\]

\textbf{2.}
The realized variance is an estimator of the integrated variance,
\[ \int_s^t \sigma_u^2 du \approx \sum r_{t_i, t_{i+1}} \quad \text{(log-returns)}, \]
but it is contaminated by microstructure noise.

Prefer the Fourier estimator of volatility
\[
\sum_j (\Delta_j X)^2 
+
\sum_{ j \neq \ell}
\biggl(
\sum_{-N} ^N e^{ ik( t_j - t_\ell ) } 
\biggr)
\Delta_j X
\,
\Delta_\ell X.
\]

Spot volatility exhibits jumps, clustering, roughness and long memory
(there is evidence for and against both short and long memory -- one could have both,
e.g., with the sum of a long-memory process and a short-memory one).

Under reasonable assumptions, a \emph{local volatility model}
\[ \dfrac{ dS}{S} = r dt + \sigma(t,S) dW \]
consistent with observed prices exists (\ie, it has the correct marginals, but unrealistic dynamics),
from Gy\"ongi's lemma and Dupire's formula
\[
\sigma^2(T,K) = \dfrac{
  \partial_T C + r K \partial _K C 
}{
  \tfrac12 K^2 \partial^2_K C
}.
\]
For instance, the CEV (constant elasticity of variance) model
\[ dS = \mu S dy + \sigma S^\gamma dW, \]
for $\gamma < 1$, ensures $\cor(S,\sigma)<0$ and produces a downward sloping skew.

Stochastic volatility models have two sources of randomness,
\begin{align*}
  dS &= r S dt + \sigma S dW \\
  \sigma &= f(Y) \\
  dY &= a(t,Y)dy + b(t,Y) dB;
\end{align*}
the function $f$ can be exponential, square root, absolute value;
the process $Y$ can be log-normal, Ornstein-Uhlenbeck or CIR.

For instance, the Heston model uses the square root of a CIR process,
\begin{align*}
  \sigma &= \sqrt v \\
  dv &= k ( \theta - v ) dt + \nu \sqrt v dB,
\end{align*}
where $\nu$ is the vol-of-vol.

The SABR (stochastic alpha beta rho) model is
\begin{align*}
  dF &= \sigma F^\beta dW && \beta \in [0,1] \text{\ \  (often, $\beta=1$)}\\
  d\sigma &= \alpha \sigma dB && \alpha > 0 \\
  &&& \rho = \dfrac{ d \langle W, B \rangle_t }{ dt }.
\end{align*}

Stochastic-local volatility models combine both ideas
\[ \dfrac{dS}{S} = r dt + \sigma_t \lambda(t,S) dW, \]
where $\sigma$ is a diffusion.

Rough volatility models are stochastic volatility models driven by a fractional Brownian motion,
such as the rough Bergomi model.
\begin{align*}
  dS &= r S dt + \sigma S dW \\
  \log \dfrac{ \sigma_t^2 }{ \sigma_0^2 } &= \nu \sqrt{2H} Z_t - \tfrac12 \nu^2 t^{2H} \\
  Z_t &= \int_0^t (t-s)^{H-\frac12} dB, \qquad H < \tfrac12.
\end{align*}

The variance swap payoff is
\[ \sum \log \dfrac{ S_i }{ S_{i-1} } - K, \]
where $K$ (fair price) is chosen so that the initial contract price be zero.
The fair price of its continuous analogue is
\[ \E \int_0^T \sigma_t^2 dt = 2 \E \log \dfrac{ S_t }{ S_0 }. \]

The volatility swap payoff is
\[ \sqrt{ \sum \log \dfrac{ S_i }{ S_{i-1} } } - K; \]
the fair price of its continuous analogue 
\[ \E \sqrt{ \int_0^T \sigma_t^2 dt } \]
is more difficult to compute.

The gamma swap is a weighted variance swap
\[ \int_0^T a(u) \sigma_u^2 du \]
with $a(u) = S_u / S_0$;
it can be replicated with a European option with payoff
\[ \dfrac{ S_T }{ S_0 } \log \dfrac{ S_T }{ S_0 } . \]

For arithmetic variance swaps, $a(u) = S_u^2$.

\textbf{3.}
Malliavin calculus is a calculus of variations for stochastic processes.

The \d{Malliavin derivative} is an inverse $D$ of the operator
\[ h \longmapsto W(h) = \int_0^T h(s) dW_s \]
satisfying $DW(h) = h$ and $Df(A) = f'(A) DA$.

If $F = f( W(h_1), \dots, W(h_n) )$,
it is defined as
\[ DF = \sum \partial_i f( W(h_1), \dots, W(h_n) ) h_i; \]
it is then extended to the closure of the set of such functions.

% TODO: DIAGRAM

For instance, for Brownian motion,
$D_s W_t = \mathbf1_{[0,t]}(s)$.

For exponential Brownian motion,
$D_r S_t = \sigma S_t \mathbf1_{[0,t]}(r)$.

It satisfies the following properties.
\begin{align*}
  & \E \langle DF, h \rangle = \E\bigl[ F W(h) \bigr] \\
  & D \psi(F_1,\dots,F_n) = \sum\partial_i \psi DF_i \\
  & D( FG ) = (DF) G + F (DG) \\
  & E\bigl[ G \langle DF, h \rangle \bigr] + \E\bigl[ F \langle DG , h \rangle \bigr] = E\bigl[ F G W(h) \bigr] \\
  & D_r A_t = 0 \text{ for $r>t$ if $A$ is adapted} \\
  & D_s \E\nolimits_t[A] = \E[ D_s A ] \mathbf1_{[0,t]} (s)
\end{align*}

The \d{divergence operator}, or \d{Skorohod integral},
is the adjoint of the Malliavin derivative.
\[ \E \langle DF, u \rangle = \E[ F \delta(u) ] \]
It generalizes the Ito integral to non-adapted processes.
\[ \delta(u) = \int_0^T u(s) dW(s) \]

For processes of the form $u(s) = \sum A_i h_i(s)$.
\[ \delta(u) = \sum_i A_i W(h_i) - \langle D A_i, h_i \rangle. \]
In particular
\begin{align*}
  & \delta \biggl[ \sum A_i \mathbf1_{[t_i,t_{i+1}]} (s) \biggr] = \\
  & \qquad \qquad 
  \sum A_i ( W_{t_{i+1}} - W_{t_i} ) - \sum \int_{t_i}^{t_{i+1}} D_s A_i ds
\end{align*}
where the second term is zero if the $A_i$ are adapted
(Ito integral).

For a diffusion
\[ dX = \mu ds + \sigma dW \]
the Malliavin derivative is
\[ D X_t = \int_0^t  D \mu_s ds + \sigma \mathbf1_{[0,t]} + \int_0^t D \sigma_s dW_s; \]
it can be computed as the solution of a SDE or, after a change of variable, an ODE.
It is easy to compute for most volatility models.

\textbf{4.}
If $F$ is $\mathscr F_T$-measurable, it can be expressed as
(\emph{martingale representation theorem})
\[ F = \E[F] + \int_0^T m(T,s) dW_s. \]
The \d{Clark-Ocone-Haussman formula} gives an explicit martingale representation,
\[ F = \E[F] + \int_0^T \E\nolimits_r [ D_r F ] dW_r. \]
It can be used to build hedging strategies
(apply it to the final value of the replicating portfolio,
$V_T = \alpha_T S_T + \beta_T e^{rT}$)
or price VIX options (apply it to $\sigma_t^2$).

The \d{integration by parts formula}
\[ \E\bigl[ f'(F) G \bigr] = \E \biggl[ f(F) \, \delta\biggl( \dfrac{ G u }{ \langle D F , u \rangle } \biggr) \biggr] \]
can be used to compute the espectation of a derivative (Greeks), with Monte Carlo simulations.

The \d{anticipating Ito formula} generalizes Ito's formula to non-adapted processes.

\textbf{5.}
\d{Fractional Brownian motion} (fBM) is a Gaussian process with covariance function
\[ \E[ B_t B_s ] = \tfrac12 \bigl( t^{2H} + s^{2H} - \va{t-s}^{2H} \bigr); \]
in particular, $B_t - B_s \sim N \bigl( 0 , \va{t-s}^{2H} \bigr).$
For $H \neq \tfrac12$, it is not Markovian, it is not a martingale, nor a semi-martingale, and the increments are correlated:
$ \E \bigl[ (B_t-B_s) (B_u - B_r) \bigr] = \cdots \neq 0 $.
It is self-similar,
$(B_{at})_t \overset{\text{d}}{=} (a^H B_t)_t$,
and $\lambda$-H\"older continuous for $\lambda < H$.

Since it is not a semi-martingale, we cannot use Ito calculus to define stochastic integration.

It has a representation as
\begin{align*}
  B_t &= \int_0^t K(t,s) dW_s \\
  K(t,s) &\propto (t-s)^{H-\frac12} + {}\\
  &\hphantom{{}\propto{}} 
  (\tfrac12-H) \int_s^t (u-s) ^ { H-\frac32} \biggl( 1 - \Bigl(\dfrac su\Bigr)^{\!\frac12 - H} \biggr) du
\end{align*}

The \d{Riemann-Liouville fractional Brownian motion} (RLfBM) truncates this kernel
and only keeps the first term,
\[ B_t \propto \int_0^t (t-s)^{H-\frac12} dW_s. \]

The Malliavin derivative is $D_s B_t = K(s,t)$;
one can also compute the Malliavin derivative of most rough volatility models.

