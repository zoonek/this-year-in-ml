\nextbook
\begin{book}
  \emph{Wasserstein-Kelly portfolios:\\ a robust data-driven solution\\ to optimize portfolio growth}\\
  J.Y.M. Li (2023)
\end{book}
The Kelly portfolio
\[ \begin{array}{ll}
  \text{Find} & w \\
  \text{To maximize} & \E_R \log ( 1 + w' R ) \\
  \text{Such that} & w \geq 0 , \ w' \mathbf 1 = 1
\end{array} \]
where $R$ are the asset simple returns,
can be made \emph{distributionally robust}
by considering the Wasserstein ball of log-returns centered on the empirical log-return distribution
(with the \emph{simple} return ball, the optimization problem is unbounded).
\[ \begin{array}{ll}
  \text{Find} & w \\
  \text{To maximize} & \inf\limits_{ F \in \mathcal B } \E\limits_{ r \sim R } \log w' e^r \\
  \text{Such that} & w \geq 0 , \ w' \mathbf 1 = 1 \\
  \text{Where} & \mathcal B = \{ F \,:\, W_p( F, F_r ) \leq \epsilon \}
\end{array} \]
This can be solved with \texttt{cvxpy}, after reformulation.
  
\nextbook
\begin{book}
  \emph{Probabilistic forecasting with factor quantile regression: application to electricity trading}\\
  L. Maciejowska et al. (2023)
\end{book}
Given several forecasts $\hat y_1 , \dots , \hat y_d$ (different models,
or the same model estimated on different windows),
forecast quantiles of $y$ with a linear regression
$\hat y_\alpha \sim \hat y_1 + \cdots + \hat y_d$
or a principal component regression.
  
\nextbook
\begin{book}
  \emph{An adaptive volatility method for probability forecasting and its application to the M6 financial forecasting competition}\\
  J. de Vilmarest and N. Werge (2023)
\end{book}
The adaptive volatility model (AdaVol)
is a non-stationary GARCH-like model.
\begin{align*}
  \epsilon_t &:\text{ log-returns} \\
  \gamma_t &:\text{ sample volatility of }\epsilon \\
  \sigma_t &:\text{ target volatility of }\epsilon \text{ (unobserved)} \\
  \eta_t &\sim N(0,1) \\
  \epsilon_t &= \sigma_t \eta_t \\
  \sigma_t^2 - \gamma_{t-1}^2 &=
  \sum_{i=1}^p \alpha_i ( \epsilon_{t-i}^2 - \gamma_{t-1}^2 )+
  \sum_{j=1}^q \beta_j  ( \sigma_{t-j}^2 - \gamma_{t-1}^2 )
\end{align*}
  
