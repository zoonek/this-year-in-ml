% Super-resolution

\nextbook
\begin{book}
  \emph{RAISR: rapid and accurate\\ image super resolution} \\
  Y. Romano et al.
\end{book}
Image upscaling (``super-resolution'')
algorithms used to be simple interpolators (nearest neighbour, bilinear, bicubic),
but more recent algorithms use an \emph{image prior} and learn a non-linear map
\[ 
  \text{low-resolution patch} 
  \mapsto
  \text{high-resolution patch}
\]
e.g., using sparse coding or CNNs.
To speed up the computations, one can instead learn a (linear) map 
\[
  \text{bilinear upscaled LR patch}
  \mapsto
  \text{(sharpened) HR patch}
\]
refining a cheaply-upscaled image.
To make the algorithm more adaptive,
cluster the image patches (coarsely, by hashing the local gradient statistics, angle, strength, coherence, from an eigen analysis) and learn a filter for each cluster. 

\nextbook
\begin{book}
  \emph{A+: adjusted anchored neighborhood regression for fast super-resolution} \\
  R. Timofte et al.
\end{book}
Sparse coding for image super-resolution.

\nextbook
\begin{book}
  \emph{Image super-resolution\\ using deep convolutional networks} \\
  C. Dong et al.
\end{book}
CNNs for image super-resolution.










% NLP

\nextbook
\begin{book}
  \emph{Enriching word vectors\\ with subword information} \\
  P. Bojanowski et al.
\end{book}
To compute word embeddings of rare words or in morphologically rich languages,
represent words as bags of $n$-grams.

\nextbook
\begin{book}
  \emph{Charagram: embdedding words and sentences via character $n$-grams} \\
  J. Wieting et al.
\end{book}
Character $n$-gram count vector embedding for sentences, 
trained with the paraphrase pairs database (for word or sentence similarity), 
or the Penn treebank (for POS tagging).

\nextbook
\begin{book}
  \emph{Correlated topic models} \\
  B.M. Blei and J.D. Lafferty
\end{book}
Correlation between topics can be introduced in latent Dirichlet analysis (LDA)
by replacing the Dirichlet distribution 
\begin{align*}
  Y_i &\overset{\text{iid}}{\sim} \Gamma(\alpha_i, \theta) \\
  X &= Y / (Y' \mathbf 1) \sim \text{Dir}(\alpha_1,\dots,\alpha_n)
\end{align*}
with a \d{logistic normal distribution}
\begin{align*}
  Y &\sim N(\mu, \Sigma) \\
  X &= Y / ( Y' \mathbf 1).
\end{align*}

\nextbook
\begin{book}
  \emph{Content-based recommendations\\ with Poisson factorization} \\
  P. Gopalan et al.
\end{book}
The collaborative topic \d{Poisson factorization} is suited to sparse,
long-tailed data, and amenable to variational inference. 
\begin{align*}
  k &: \text{ topics} \\
  v &: \text{ words} \\
  d &: \text{ documents} \\
  u &: \text{ users} \\
  \beta_{vk} &\sim \Gamma \\
  \theta_{dk} &\sim \Gamma \\
  w_{dv} &\sim \text{Poisson}( \theta'_d \beta_v) \\
  % Without the users, it is a Poisson factorization
  \eta_{uk} &\sim \Gamma \\
  \epsilon_{dk} &\sim \Gamma \\
  r_{ud} &\sim \text{Poisson}\bigl( \eta'_u ( \theta_d + \epsilon_d ) \bigr)
\end{align*}






% Reinforcement learning

\nextbook
\begin{book}
  \emph{Learning to search better than your teacher} \\
  K.W. Chang et al. (2015)
\end{book}
Structured prediction problems (e.g., building the parse tree of a sentence)
can be turned into reinforcement learning problems by expressing the prediction as a sequence of actions (e.g., growing the tree).
\d{Learning to search} tries to replicate a reference policy
(\ie, a map 
$\text{state features} \to \text{action}$)
instead of solving the full reinforcement learning problem.
Locally optimal learning to search (LOLS) tries to modify the reference policy 
(no longer assumed optimal) to improve the performance. 




% Unsorted

\nextbook
\begin{book}
  \emph{Deep unsupervised learning\\ using nonequilibrium thermodynamics} \\
  J. Sohl-Dickstein et al. (2015)
\end{book}
To model a probability distribution (e.g., pixels in the MNIST dataset),
find a diffusion that transforms it into a tractable one (e.g., Gaussian).
% Not clear why this should work.

\nextbook
\begin{book}
  \emph{Stochastic differential equation\\ mixed effects models for tumor growth\\ and response to treatment} \\
  J.L. Forman and U. Picchini
\end{book}
Biological phenomena are often modeled by ODEs, but SDEs may be a better choice;
as state space models, they can be estimated with particle filters (sequential Monte Carlo, SMC).
Mixed effects SDE (SDEMEM) can be estimated with approximate Bayesian computations (ABC)
or \emph{synthetic likelihood} (similar to ABC, but we assume 
the summary statistics are Gaussian, \ie, we only look at the mean and variance: 
it is a simulated method of moments).

\nextbook
\begin{book}
  \emph{A note on the validity of cross-validation\\ for evaluating time series prediction} \\
  C. Bergmeir et al. (2015)
\end{book}
Even in presence of auto-correlation, most estimators remain consistent
(the variance of the limiting distributions and the resulting tests are affected, though);
likewise, cross-validation can be applied to time series without any modification.

\nextbook
\begin{book}
  \emph{Faster principal component regression via optimal polynomial approximation to sgn(x)} \\
  Z. Allen-Whi and Y. Li (2016)
\end{book}
To project a vector $v \in \RR^n$ to the subspace spanned 
by the eigenvectors of $A$ with eigenvalues at least $\lambda_0$, without computing the eigenvectors, compute 
$g(A) = \text{sign}( \lambda - \lambda_0 - \epsilon )$;
use a polynomial approximation of $g$.

\nextbook
\begin{book}
  \emph{DART: dropouts meet\\ multiple additive regression trees} \\
  K.V. Rashmi and R. Gilad-Bachrach (2015)
\end{book}
Boosted regression trees, with dropout of complete trees.

\nextbook
\begin{book}
  \emph{Tensors and their eigenvectors} \\
  B. Sturmfels (2016)
\end{book}
A \emph{symmetric} $n\times n\times \cdots \times n$
tensor $T = ( t_{ i_1 \cdots i_d} )$
can be seen as a homogeneous polynomial of degree $d$ in $n$ variables 
$ T = \sum t_{ i_1 \cdots i_d} x_{i_1} \cdots x_{i_d} $ 
(symmetric matrices correspond to bilinear forms) and, 
therefore, as a hypersurface in $\PP^{d-1}$.

A vector $v \in \RR^n$ is an eigenvector of $T$ if 
$(\nabla T) v = \lambda v$ for some $\lambda$.
Algebraic geometry can help count the number of eigenvalues or singular values of (symmetric) tensors.

\nextbook
\begin{book}
  \emph{Code-based cryptography}\\
  I. M\'arquez-Corbella (FUN 2016)
\end{book}

Quantum computers can solve the integer factorization and the discrete log problems in reasonable time.
Code-based cryptography relies on NP-completeness and could form the base of \d{post-quantum crypto-systems}.
A linear code is a subspace of $\FF_q^n$ of dimension $k$,
defined either as the kernel of a \emph{parity check matrix} $H$
or as the image of a linear map $G: \FF_q^k \to \FF_q^n$ of rank $k$.
The \emph{syndrome} of a received word $x$ is $Hx$; it is also the syndrome of the error
In the \emph{McEliece cryptosystem}, 
the public key is a generator matrix $G$ with added noise,
and the private key is an efficient decoding algorithm for $G$.
In the \emph{Niederreiter cryptosystem},
the public key is a parity check matrix 
and the private key is an efficient syndrome decoder.

While promising, most code-based cryptosystems have been broken --
Goppa codes are the main exception.

%% 2017-01
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{Determinantal point processes} \\
  A. Kulesza and B. Taskar (2012)
\end{book}
\d{Determinantal point processes} (DPP)
are distributions over subsets $Y \subset \mathscr Y$
of the form 
\begin{align*}
  P( A \subset \mathbf Y ) &= \det( K_A ) && 0 \preccurlyeq K \preccurlyeq I \\
  P( \mathbf Y = Y ) &\propto \det( L_Y ) && L \succcurlyeq 0 \\
  P( \mathbf Y = Y ) &=  \dfrac{ \det( L_Y )  }{ \det( L + I ) }.
\end{align*}
The two formulations are related by $K = I - (L+I)^{-1}$
and the first one is slightly more general
(it allows $P( \mathbf Y = \nothing ) \neq 0 $).

DPPs favour diverse sets: 
\begin{align*}
P( i, j \in \mathbf Y ) &= K_{ii} K_{jj} - K_{ij}^2 \\ 
&= P( i \in \mathbf Y ) P( j \in \mathbf Y) - K_{ij} ^2  \\
&< P( i \in \mathbf Y ) P( j \in \mathbf Y)
\end{align*}

Applications of DPPs include ranking search results
or summarizing documents by extracting a few sentences. 
They remain tractable until $\va{ \mathscr Y } = 10,000$.

To sample from a DPP: 
\begin{compactitem}[--]
\item Compute the eigen decomposition $L = \sum \lambda_n v_n v_n ' $;
\item Select a subset $V$ of eigenvectors,
including $v_i$ with probability 
$\lambda_i / ( \lambda_1 + 1 )$;
\item Select $i \in \mathscr Y$ with probability 
\[ \dfrac1{ \va V } \sum_{ v \in V } ( v' e_i )^2; \]
\item Replace $V$ with an orthonormal basis of $e_i^\perp \inter \Span V$;
\item Repeat until $V$ is empty.
\end{compactitem}

Finding the model of a DPP is NP-hard. 
The function $\log P$ is submodular (easy to minimize, hard to maximize --
the greedy algorithm for approximate maximization only works for \emph{monotone} submodular functions).

Alternatives to DPP include: 
\begin{compactitem}[--]
\item Mat\'ern repulsive process: 
  start with a Poisson point process and remove points more than $\epsilon$ apart (either both points, or just the last one)
\item Pairwise Markov process
  \[ P( \mathbf Y = Y ) \propto \prod_{ i \in Y } \psi_1(i) \prod_{ i,j \in Y } \psi_{12}(i,j); \]
\item Area interaction process 
  \[ P( \mathbf Y = Y ) \propto \gamma^{ - \!\!\sum\limits_{ y \in Y } \operatorname{Area} B(y,\epsilon) }; \]
\item Determinants can be replaced with 
  permanents, immanents, $\alpha$-determinants or hyperdeterminants;
\item Quasi-random (low discrepancy) processes.
\end{compactitem}

The $L$ matrix can be written $L = B' B$, 
$B = U \diag(q)$,
where $q$ measures the (unary) quality of the items,
and the columns $\phi_i$ of $U$ are (normalized) features for item~$i$.

DPPs are similar to Markov random fields (MRF),
but they allow negative interactions --
inference for pairwise MRFs is tractable, approximately, provided the potentials are associative, 
\ie, endpoints tend to have the same value.

For sampling, normalization, marginalization,
the dual representation $C = B B'$, 
instead of the larger $L = B' B$,
is often sufficient (you still need $B$, though).

The likelihood can be expressed as a single determinant
\begin{align*}
P(Y)
&= \dfrac{ \det L_Y }{ \det( L + I ) }  \\
&= \det( I_Y K + I_{\bar Y} ( I - K ) ) \\
&= \va{ \det( K - I_{ \bar Y } ) }
.
\end{align*}

To fit a DPP, use feature vectors $\phi$ for the items
$L_{ij} = q_i q_j \phi_i ' \phi_j $,
and parametrize the quality 
$q_i = \exp \tfrac12 \theta ' \phi_i$
(one can use different features for the quality).
Mixtures of DPPs are also easy to fit.

A $k$-DPP is a DPP constrained with $\va{\mathbf Y} = k$
(it is no longer a DPP):
we still have 
$P(\mathbf Y = Y ) \propto \det L_Y$,
but the normalization constant is different
\[ 
P(\mathbf Y = Y ) = 
\dfrac{ 
  \det L_Y
}{
  \sum\limits_{ \va X = k } \det L_X
} =
\dfrac{ 
  \det L_Y
}{
  e_k( \lambda_1,\dots,\lambda_n )
}
\]
where $\lambda_1$,\dots,$\lambda_n$
are the eigenvalues of $L$ 
and $e_k$ is the elementary symmetric polynomial 
\[
e_k( \lambda_1, \dots, \lambda_n ) = \sum_{\substack{
  J \subset \llbracket 1, n \rrbracket \\ 
  \va J = k
}}
\prod _{ i \in J }
\lambda_i,
\]
which can be computed recursively as
$ e_k^n = e_k^{n-1} + \lambda_n e_{k-1}^{n-1}$.
The sampling algorithm for DPPs can be adapted to $k$-DPPs (use exactly $k$ eigenvectors).

Structured DPPs (SDPP), 
\ie, 
DPPs whose quality and diversity feature factor multiplicatively and additively, 
\begin{align*}
  q(y) &= \prod_{ \alpha \in F } q_\alpha( y_\alpha ) \\
  \phi(y) &= \sum_{ \alpha \in F } \phi_\alpha( y_\alpha )
\end{align*}
can be handled with message passing algorithms.
They can model paths, grammar derivations, etc.

\nextbook
\begin{book}
  \emph{Diversity networks} \\
  Z. Mariet and S. Sra (2016)
\end{book}
To reduce the number of neurons in a neural net,
sample a diverse set of neurons using a determinantal point process (DPP),
$ P(Y) \propto \det L_Y $,
with a Gaussian RBF kernel 
$ L_{ij} = \epsilon + \exp - \beta \n{ v_i - v_j }^2 $
and fuse the remaining neurons.

\nextbook
\begin{book}
  \emph{Discriminants, resultants\\ and multidimenstional determinants} \\
  I.M. Gelfand et al. (1994)
\end{book}

Let $A$ be a set of monomials.
The \emph{discriminant} of $f \in \Span A$ is an irreducible polynomial in the coefficients of $f$
that vanishes whenever $f$ has a multiple root $(x_1,\dots,x_k)$ with $\forall i \ x_i \neq 0$.

The \emph{resultant} of polynomials $f_0,\dots,f_k$
%(of bounded degrees)
in $k$ variables is an irreducible polynomial in their coefficients,
vanishing whenever they have a common root;
it is the discriminant of 
$ f_0(\mathbf x) + \sum_{ i \geq 1 } y_i f_i(\mathbf x) .$

The \emph{determinant} of a matrix 
$(a_{ij})_{ij}$
is the discriminant of the bilinear form 
$\sum a_{ij} x_i x_j$.
The \emph{hyperdeterminant}
of a tensor 
$( a_{ i_1 \dots i_r } ) _{ i_1 \dots i_r }$
is the discriminant of the homogeneous polynomial 
$\sum a_{  i_1 \dots i_r  } x_{  i_1 \dots i_r  }. $

% Not read. Algebraic geometry.

\nextbook
\begin{book}
  \emph{Learning with submodular functions:\\ a convex optimization perspective} \\
  F. Bach (2013)
\end{book}

\textbf{1.}
Submodular functions are a combinatorial analogue of \emph{concave} functions, 
in an attempt to build a theory of ``combinatorial convex optimization''.
Surprisingly, they also have many \emph{convex} aspects. 
They generalize matroidal ranks.
It turns out that both maximizing (NP-hard) and minimizing (polynomial)
submodular functions are interesting problems.

There are three main uses of submodular functions in optimization: 
\begin{compactitem}[--]
\item As the objective of a combinatorial optimization problem;
\item To penalize the support of a vector: lasso, group lasso, etc. (structured sparsity);
\item To penalize the level set of a vector (clustering).
\end{compactitem}

\textbf{2.}
A set function $f : 2^V \to \RR$ is \d{submodular} if 
\[ \forall A, B \qquad F(A) + F(B) \geq F(A \union B) + F(A\inter B); \]
it suffices to check (diminishing returns)
\[ 
%\forall A \ \forall k, \ell \not\in A \ 
  F\bigl( A \union \{ k \} \bigr) - F(A) \geq F\bigl( A \union \{k,\ell\} \bigr) - F\bigl(A \union \{\ell\} \bigr). 
\]

The following operations preserve submodularity: 
restriction, extension ($F(A) = G(B \inter A)$), 
contraction ($F(A)= G(A\union B) - G(B)$, on $V \setminus B$), 
partial minimization.

Examples include $\va A$, $\mathbf 1_{ A \neq \nothing }$,
$\# \{ i \ :\ A \inter G_i \neq \nothing \}$
where $V = \coprod G_i$ is a partition, 
or the number of edges from $A$ to $V\setminus A$ in an undirected graph.

A vector $s \in \RR^p$ defines a \d{modular} function
\[ s(A) = \sum_{ i \in A } s_i, \qquad A \subset \llbracket 1, n \rrbracket. \]

The submodular and \d{base polyhedron} are 
\begin{align*}
  P(F) &= \bigl\{\, s \in \RR^p \ :\ \forall A \subset \llbracket 1, p \rrbracket \quad s(A) \leq F(A) \, \bigr\} \\
  B(F) &= \bigl\{\, s \in P(f) \ : \  s(V) = F(V) \, \bigr\}
\end{align*}
\[
\begin{tikzpicture}[scale=.5]
\fill[blue!20] (-1,2) -- (1,2) -- (2,1) -- (2,-1) -- (-1,-1) -- cycle;
\draw[red!50!black,ultra thick] (2,1) -- (1,2);
\node at (2.25,1.75) {\footnotesize\color{red!40!black}$B(F)$};
\node at (1,.5) {\footnotesize\color{blue!40!black}$P(F)$};
\draw (-1,0) -- (2.5,0);
\draw (0,-1) -- (0,2.5);
\end{tikzpicture}
\]

A \d{polymatroidal rank function} is a non-decreasing submodular function.
A submodular function $F$ can be expressed as a sum of a modular and a polymatroidal function 
(set $s_k = F(V) - F(V\setminus\{k\})$: $G = F - s $ is polymatroidal).

\textbf{3.}
A submodular function $F$ is defined on the vertices of the hypercube $[0,1]^p$.
Its \d{Lov\'asz extension} (or \emph{Choquet integral}) is the linear interpolation 
on the $n!$ simplexes corresponding to the orderings of $(x_1,\dots,x_p) \in [0,1]^p$.
% It is also the support function of the submodular polyhedron $I^*_{P(F)} = \sup_{ s \in P(F) } w' s$.

A set function $F$ is submodular iff its Lov\'asz extension is convex; 
they have the same minima.

The Lov\'asz extension has a probabilistic interpretation: 
\[
  f(w) = E_{ u \sim U(0,1) } \bigl[ F\{ i \ :\ w_i \geq u_i \} \bigr]
\]
The \emph{multilinear extension} is neither convex nor concave: 
\begin{align*}
  \tilde f( w ) &= E_{ B \sim w } \bigl[ F(B) \bigr] \\
  &= \sum_{ A \subset V } F(A) \prod_{ i \in A } w_i \prod_{ i \not \in A } ( 1 - w_i ).
\end{align*}

\textbf{4.}
A \d{greedy algorithm} can maximize linear functions on the base polyhedron; 
in particular, this gives its extreme points.

\textbf{5.} The \d{convex closure} fo $F : 2^V \to \RR$
is the largest convex function 
$f : \RR^p \to \RR\union\{\infty\}$
such that $ \forall A \subset V \ f(\mathbf 1_A) \leq F(A)$.
It can be obtained by Fenchel biconjugation; 
it is an extension of $F$, \ie, 
$f(\mathbf 1_A) = F(A)$; it has the same minima.
For submodular functions, it is the Lov\'asz extension.

A penalty $\Omega$ can add \d{structural sparsity} to machine learning models, 
\[ \argmin_w \text{Loss}( y, x, w ) + \lambda \Omega(w). \]
For instance, $\Omega = \# \supp w = \n{ w }_0$
or $\Omega(w) = F(\supp w)$, 
for some set function $F$, e.g., a partition count.

The convex envelope of 
$w \mapsto F(\supp w)$,
on the $\ell^\infty$ ball, for a non-decreasing submodular function $F$, 
is $\Omega_\infty : w \mapsto f(\va w)$, 
where $f$ is the Lov\'asz extension of~$F$.
For instance, the counting function gives the lasso, 
and the partition count $\sum \n\cdot _\infty$, 
which is not exactly the group lasso -- the ball has spurious edges.

Those spurious edges can be removed by replacing $F(\supp w)$ with 
\[ \dfrac1p \n{ w }_p^p + \dfrac1q F(\supp w), \qquad \dfrac1p + \dfrac1p = 1, \quad p \in (1,\infty). \]
For $\Omega(w) = \#\supp w$, this gives $\Omega_p = \n\cdot _p$; 
for partition counting, this gives the group lasso $\Omega_p = \sum \n \cdot _p$.
% There is a formula for the dual $\Omega_p^*$, but not for $\Omega_p$.

But those spurious edges can be used: 
they create clustering of the components of $w$.
For instance, 
\begin{align*}
F(A) &= \mathbf 1_{A \neq \nothing, V}, \\
f(w) &= \max \va{ w_i - w_j }
\end{align*}
creates clusters for the largest and smallest values.
Similarly, 
\begin{align*}
F(A) &= \max \{ \va{A}, \va{V\setminus A} \}, \\
f(w) &= \sum_k \min(n-k,k) \va{ w_{(k+1)} - w_{(k)} }
\end{align*}
creates a cluster in the middle 
and therefore highlights outliers.

\textbf{6a.} 
Concave functions of cardinality, 
$F(A) = \phi(\va A)$ are submodular.

\textbf{6b.} 
\emph{Cut functions}, 
\[ F(A) = \sum_{\substack{ i \in A \\ j \not\in A }} d_{ij} \]
(for undirected graphs, they can also be written 
$F(A) = \tfrac12 \mathbf 1'_A Q \mathbf 1_A$,
where $Q$ is the graph Laplacian)
are submodular,
with Lov\'asz extension
$f(w) = \sum d_{ij} ( w_i - w_j )_+$.
Examples include the total variation
(in one dimension, 
for a chain 
\raisebox{1pt}{%
\begin{tikzpicture}[scale=.2]
\tikzstyle{every node}=[circle, fill=black, inner sep=1pt, outer sep=0pt]
\node[circle] (A) at (0,0) {};
\node[circle] (B) at (1,0) {};
\node[circle] (C) at (2,0) {};
\node[circle] (D) at (3,0) {};
\draw[thick] (A) -- (D);
\end{tikzpicture}},
or in two dimensions, for a grid
\raisebox{-2.5pt}{\begin{tikzpicture}[scale=.15]
\tikzstyle{every node}=[circle, fill=black, inner sep=1pt, outer sep=0pt]
\foreach \i in {0,1,2}
  \foreach \j in {0,1,2}
    \node[circle] at (\i,\j) {};
\foreach \i in {0,1,2}
  \draw[thick] (\i,0) -- (\i,2);
\foreach \i in {0,1,2}
  \draw[thick] (0,\i) -- (2,\i);
\end{tikzpicture}})
or the isotonic penalty
(for the graph of an order relation).

If $G : 2^{V \union W} \to \RR$ is submodular,
then so is its \emph{partial minimization}
\[
  F : \left\{
  \begin{array}{rcl}
    2^V & \to & \RR \\
    A & \mapsto & \min\limits_{B \subset W} G(A \union B)
  \end{array}
  \right.
\]
A function is \emph{regular} if it is the partial minimization of a cut function.

\textbf{6c.} 
Given a non-negative function $D: 2^V \to \RR_+$,
the \emph{set cover function} 
\[
  F : \left\{
  \begin{array}{rcl}
  2^V & \to & \RR \\
  A & \mapsto & F(A) = \sum\limits_{ B \inter A \neq \nothing } D(B)
  \end{array}
  \right.
\]
is modular
and its Lov\'asz extension is 
\[ f(w) = \sum_B D(B) \max_{k \in B} w_k. \]
The corresponding $\Omega_p$ norm is an overlapping group lasso penalty,
with no double counting 
(contrary to $\sum D(B) \n{ w_B }_p$).
M\"obius inversion
\begin{align*}
  F(A) &= \sum_{B \subset A} G(B) \\
  G(A) &= \sum_{B \subset A} (-1)^{\va{A\setminus B}} F(B)
\end{align*}
can recover $D$,
\begin{align*}
  F(V) - F(V\setminus A) &= \sum_{B \subset A} \! D(B) \\
  D(A) &= \sum_{B \subset A} \! (-1)^{\va{A} - \va{B}} \bigl( F(V) - F(V\!\setminus\! B) \bigr). \\
\end{align*}
Set covers can also be defined as 
$F(A) = \mu\bigl( \bigcup_{ k \in A } S_k \bigr)$, where $S_k \subset W$,
for a measure space $(W,\mu)$.
Examples include: 
\begin{compactitem}[--]
\item Contiguous subsets of a chain;
\item Contiguous 2-element subsets of a chain, to avoid isolated points;
\item Convex subsets of a 2-dimension grids, to prefer convex supports;
\item Tree structures, to ensure that if a variable is there, then so are its ancestors (gene networks, wavelet bases, models with interactions).
\end{compactitem}

\textbf{6d.} 
Given a weighted directed graph $W$, consider flow functions, 
with sources $S \subset W$ and sinks $V \subset W$. 
The \emph{maximum net flow} out of $A \subset V$, 
\[ F(A) = \max_{\phi\text{ flow}} \phi(W,A) - \phi(A,W), \]
is submodular
(from the maxflow-mincut theorem, it is the partial minimization of a cut function).

\textbf{6e.}
Given discrete random variables $(X_1,\dots,X_p)$, 
the \emph{joint entropy} $F(A)$ of $(X_k)_{k\in A}$ defines a modular function.
If $(X_1,\dots,X_n)$ is Gaussian, 
the joint entropy is $H(X_A) = \tfrac12 \log\det( 2 \pi e Q_{AA} )$
and $F(A) = \log \det Q_{AA}$ defines a submodular function.

To cluster points $x_1,\dots,x_n$,
compute their (Gaussian, etc.) kernel
$k_{ij} = k( x_i,x_j)$
and try to approximate it as two independent ones, \ie, 
\[ K \approx \begin{pmatrix} K_A & 0 \\ 0 & K_{V\setminus A} \end{pmatrix} \]
for some $A \subset V = \llbracket 1, n \rrbracket$.
With a prior 
$p(A) \propto \prod_{k \in A} \eta_k \prod_{k \not\in A} (1 - \eta_k) $
(\ie, each point has probability $\eta_k$ of being in $A$, and the point memberships are independent),
the negative likelihood becomes 
\begin{align*}
  \ell(A) &= D_{\text{KL}} 
  \left(
    K
    \,\middle\|\,
    \begin{pmatrix} K_A & 0 \\ 0 & K_{V\setminus A} \end{pmatrix}
  \right)
  \\
  &\qquad
  - \sum_{k \in     A} \log \eta_k 
  - \sum_{k \not\in A} \log ( 1 - \eta_k ).
\end{align*}
The first term, the mutual information, is submodular, the second, modular.
(\emph{Determinantal point processes}, used to ensure diversity in recommender system results, rely on the same idea.)

\textbf{6f.} 
Given a positive semidefinite matrix $Q$ and a function $h: \RR_+ \to \RR$,
$F(A) = \tr h(Q_AA)$ defines a submodular function for some choices of $h$ 
(concavity is not enough), e.g., $h(\lambda) = \lambda^p$, $p \in [0,1]$.

% 7. Non-smooth convex optimization
\textbf{7.}
To minimize a convex Lipschitz function on a convex set: 
\begin{compactitem}[--]
\item Projected gradient;
\item \emph{Ellipsoid}: if you cut an ellipsoid in half, it can be circumscribed by a smaller one
  (slow in practice);
\item \emph{Kelley's method} is a \d{bundle method}:
  it keeps the information from all the previous iterations.
  The points previously examines give a piecewise lower bound of the objective function: 
  Kelley's method minimizes this lower bound;
\item The ellipsoid method creates a lot of empty space: 
  we can consider polytopes instead, and their centers of gravity; 
  the center of gravity is not efficiently computable, 
  but can be replaced with the \emph{analytic center}.
  The analytic center of $\{ w \ :\ \forall i \ a_i ' w \leq b_i \}$, 
  $\argmin_w \sum -\log ( b_i - a_i ' w )$,
  can be computed with Newton's algorithm.  
\end{compactitem}

To minimize $\Psi + h$, where $\Psi$ is smooth and strongly convex,
and $h$ convex (non-smooth) and positively homogeneous,
notice that $h$ can be written 
$h(w) = \sup_{ s \in K } s' w$,
for some convex set $K$.
\begin{compactitem}[--]
\item \emph{Simplicial methods} are bundle methods 
  that replace $h$ with a piecewise approximation, inner (convex hull) or outer,
  \[
  \hspace*{-7mm}
<<InnerOuterApproximation,results='hide',echo=FALSE,fig.width=6,fig.height=1.5,out.width='\\hsize',fig.show='hold'>>=
n <- 50
k <- 5
theta <- seq(0,2*pi, length = n)
i <- c(.5, 1.2, 1.8, 3, 3.9) * pi/2
i <- apply( abs( outer( i, theta, `-` ) ), 1, which.min )
j <- c(i, i[1])
x <- cos(theta)
y <- sin(theta)
if( FALSE ) { 
 par( mar = c(0,0,0,0) )
 plot( x, y, type = "l", lwd = 4, paxes = FALSE, xlim = c(-2,2), ylim = c(-2,2) )
 points( x[i], y[i], pch = 16, cex = 2 )
 lines( x[j], y[j], lwd = 2 )
 for( k in i ) 
   abline( 1/sin(theta[k]), -1/tan(theta[k]) )
}

p <- matrix(NA, nc = 2, nr = length(i))
for( k in seq_along(i) ) {
  k1 <- i[k]
  k2 <- i[ ( k %% length(i) ) + 1 ] 
  A <- matrix( c(cos(theta[k1]), cos(theta[k2]), sin(theta[k1]), sin(theta[k2])), 2, 2 )
  p[k,] <- solve( A, c(1,1) )
}
if( FALSE ) 
  points(p)

enlarge <- function( A, B, d ) {
  lambda <- d / sqrt(sum((B-A)^2))
  rbind(
    A - lambda * (B-A),
    B + lambda * (B-A)
  )
}
for( k in seq_along(i) ) {
  k1 <- k
  k2 <- ( k %% length(i) ) + 1
  AB <- enlarge( p[k1,], p[k2,], .5 )
  if( FALSE )
    segments( AB[1,1], AB[1,2], AB[2,1], AB[2,2], lwd = 3 )
}

op <- par( mfrow = c(1,2), mar = c(0,1,0,1) )
plot(p, type = "n", axes = FALSE)
polygon( x[j], y[j], col = "grey90" )
lines(x, y, lwd = 4)
points( x[i], y[i], pch = 16, cex = 2 )
lines( x[j], y[j], lwd = 2 )

plot(p, type = "n", axes = FALSE)
polygon( p[,1], p[,2], col = "grey90" )
points( x[i], y[i], pch = 16, cex = 2 )
lines(x, y, lwd = 4)
for( k in seq_along(i) ) {
  k1 <- k
  k2 <- ( k %% length(i) ) + 1
  AB <- enlarge( p[k1,], p[k2,], .5 )
  segments( AB[1,1], AB[1,2], AB[2,1], AB[2,2], lwd = 2 )
}
par(op)
@
\]
  and iterates 
  \[
  w_{t+1} \leftarrow \argmin_w \Psi(w) + \max_{ 1 \leq i \leq t } s_i' w, \quad s_i = h'(w_i).
  \]
\item \emph{Proximal methods} (aka 
  proximal gradient, forward-backward splitting, iterative shrinkage thresholding)
  repalce $\Psi$ with a first-order approximation 
  and add a further penalty to avoid moving too fast
  \[
  \min_w \Psi(w_0) + (w-w_0)' \Psi'(w_0) + h(w) + \lambda \n{ w - w_0 }_2^2
  \]
  (there is one optimization at each step (the proximal operator)
  but, for many penalties, it can be computed in closed form)
\end{compactitem}

% Linear programs can be solved with the simplex algorithm.
Quadratic programs can be solved with an \d{active set} method,
based on the following remarks:
if the indices of the non-zero components (``active set'') are known,
the problem is easy to solve; it is easy to check if a solution is optimal and, 
if not, to find a variable to add to or remove from the active set.
This applies, for instance, to least squares with a polyhedral penalty 
(the epigraph of $h$ is a polyhedron -- minimizing $h$ amounts to solving a linear program).

% 8,9. Separable optimization
\textbf{8.} 
If $f$ is the Lov\'asz extension of a submodular function $F$, 
the \emph{separable optimization} problem 
\[
\operatorname*{Minimize}_{w \in \RR^p } f(w) + \sum \psi_i(w_i) 
\]
(proximal problem) has dual 
\[
\operatorname*{Maximize} _{ s \in B(F) } - \sum \psi_i^* ( -s_i ).
\]
It can be solved by solving the family of submodular optimization problems 
\[ A^\alpha = \argmin_{ A \subset V } F(A) + \sum_{i \in A}  \psi_i'(\alpha) \]
(the second term is the modular function 
$\psi'(\alpha) \in \RR^p$)
and setting 
\[ u_i = \sup \{ \alpha \in \RR \ :\  i \in A^\alpha \}. \]

Since $\alpha < \beta \implies A^\beta \subset A^\alpha$,
solving the intial convex optimization problem gives the solution to all those submodular optimization problems
(the solution is not unique: 
$\{ i \,:\, u_i > \alpha \}$ and 
$\{ i \, :\, u_i \geq \alpha \}$
are the minimal and maximal minimizers).

% TODO: Quadratic optimization

\textbf{9.}
The \emph{divide-and-conquer} algorithm
solves the dual problem
\begin{align*}
  &t \leftarrow \argmin_{ t : t(V) = F(V) } \sum_i \psi_i^*( - t_i ) \\
  &A \leftarrow \argmin F - t \\
  &\text{If } F(A) = t(A) \text{, return } t \\
  &s_A \leftarrow \argmin_{ s \in B(F_A) } \sum_{i \in A} \psi_i^*(-s_i) \\
  &s_{V\setminus A} \leftarrow \argmin_{ s \in B(F^A) } \sum_{i \not\in A} \psi_i^*(-s_i) \\
  &\text{return } (s_A, s_{V\setminus A})
\end{align*}
where $F_A = \left.F\right|_A$ and $F^A(B) = F(A\union B) - F(A)$ (contraction).

For quadratic separable problems, 
\ie, $\psi_i(w_i) = \tfrac12 w_i^2$,
the dual is $\min_{s \in B(F) } \tfrac12 \n{ s }_2^2$.
The \d{Frank-Wolfe minimum norm point} algorithm 
solves the optimization problem 
\[
\begin{array}{ll}
  \text{Find} & \eta \\
  \text{To minimize} & \n{ \sum \eta_i x_i }_2 ^2 \\
  \text{Such that} & \eta \geq 0, \ \eta' \mathbf 1 = 1
\end{array}
\]
(\ie, the point in the convex hull of the $x_i$'s closest to the origin)
where the $x_i$'s are the extreme points of $B(F)$
(they do not have to be explicitly computed),
using an active set algorithm.

To minimize a convex function on a convex polytope,
the \d{conditional gradient} approximates it with a linear function, 
finds the minimizer,
and moves towards it.

% 10. Submodular function minimization
\textbf{10.} 
Combinatorial algorithms to minimize a submodular function $F$  use 
\[ 
\min_{A \subset V } F(A) = \max_{ s \in B(F) } s_-(V) = F(V) - \min_{ s \in B(F) } \n{ s }_1,
\]
where $(s_-)_k = \min\{ s, 0 \}$: 
for instance, the simplex can minimize $s_-$ on $B(F)$.

Instead, one can use convex optimization algorithms to
solve 
$\min_{ w \in [0,1]^p } f(w)$: 
\begin{compactitem}[--]
\item Ellipsoid method;
\item Subgradient
\begin{align*}
  s_t &\leftarrow \argmax_{ s \in B(F) } w_t ' s \\
  w_{t+1 } &\leftarrow \text{Project}_{[0,1]^p} ( w_t - \gamma_t s_t );
\end{align*}
\item Conditional gradient;
\item Analytic center cutting plane (ACCP -- in practice, this performs best).
\end{compactitem}

One could also solve 
$\min_{ s \in B(F) } \tfrac12 \n{ s }_2^2 $
or, equivalently, 
$ \min_{ w \in [0,1]^p } f(w) + \tfrac12 \n{ w }_2^2 $
(minimum norm point).

% 11. Other submodular optimization problems
\textbf{11.}
Maximizing submodular functions is NP-hard, 
but, for non-decreasing ones,
the \d{greedy algorithm} (start with $A=\nothing$
and iteratively add $k \in V\setminus A$ that maximizes $F(A \union \{k\})$)
has a performance guarantee: 
$ F(A) \geq ( 1 - e^{-1} ) F(A^*).$
In general, local search (look at $A \union \{k\}$ and $A \setminus \{k\}$)
can help.

Submodular maximization can be expressed as a (non-convex) continuous optimization 
\[ 
  \max_{ A \subset V } F(A) = \dfrac12 F(V) + \dfrac12 \max_{ s \in B(F) } \n{ s }_1.
\]

Differences of submodular functions $F-G$ 
can be minimized (locally) by iterating 
\begin{compactitem}[--]
\item Find $s \in \RR^p$ (\ie, a modular function) such that $s(A) = G(A)$
  and $\forall B \ s(B) \leq G(B)$;
\item Update $ A \leftarrow \argmin( F - s )$.
\end{compactitem}
The minimum has a geometric interpretation, in terms of Haussdorff distance
\begin{align*}
  &\min_{ A \subset V } F(A) - G(A) = {} \\
  & \qquad\qquad \dfrac12 \bigl( F(V) - G(V) \bigr)
  -\dfrac12 \min_{ s \in B(G) } \max_ {t \in B(F) } \n{ t - s } _1.
\end{align*}

% 12. Experiments

\nextbook
\begin{book}
  \emph{Probabilistic topic models} \\
  M. Steyvers and T. Griffiths 
\end{book}
Topic models can be expressed as matrix factorizations: 
\[
\underset{\text{word}\times\text{document}}{\text{cooccurrences}}
= 
\underset{\text{word}\times\text{topic}}{\text{mixture components}}
\times
\underset{\text{topic}\times\text{document}}{\text{mixture weights}}
\]
but, contrary to LSA (SVD), 
there are constraints on the matrices (probabilities are non-negative and sum to 1)
and there is a prior.
They can be estimated via Gibbs sampling.
