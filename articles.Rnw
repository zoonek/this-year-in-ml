  \draw[line width=2pt,blue!50] (-1,1) -- (0,0) -- (1.5,0);
  \node[anchor=south] at (0,1.5) {\footnotesize$x'-x$};
  \footnotesize
  \node[anchor=north,align=center,text width = 2cm,inner sep = 4pt] at (2,0) {distance to the boundary};
\end{tikzpicture}
\longmapsto
\qquad
\begin{tikzpicture}[>=stealth,scale=.7,inner sep=1pt,outer sep=0pt,baseline=8]
  \draw[->] (-2,0) -- (2,0);
  \draw[->] (0,0) -- (0,1.5);
  \draw[line width = 2pt,blue!50] (-2,0) -- (-1.5,0) to[out=0,in=180] (-1,1) to[out=0,in=180] (.5,0) -- (1.5,0);
\end{tikzpicture}
\]
