\end{book}
\begin{align*}
  B &: \text{ exposures} \\
  X &= B f + \epsilon \\
  P &: \text{ factor-mimicking portfolios} \\
  w &= Bp + \eta \\
  \eta&: \text{residual weights} \\
  \omega &= \dfrac{ \Omega \eta }{ \eta' \Omega \eta } \\
  C_{ik} &= \dfrac{ \omega_{ik} ^2 }{ \sum_\ell \omega_{i\ell}^2 } \\
  \Delta &= \epsilon ' \text{diag}(\eta) C
\end{align*}
  
