  \node[circle,draw,inner sep=0pt] (A6) at (6,0) {\footnotesize+};
  \node[anchor=east,outer sep=0pt] (A0) at (0,0) {past\\[-1mm]+\\[-1mm]noise};
  \node (A1) at (1,0) {};
  \node (A2) at (2,0) {};
  \node (A3) at (3,0) {};
  %\node (A4) at (4,0) {};
  \node (A5) at (5,0) {};
  %\node (A6) at (6,0) {};
  \node (A7) at (7,0) {};
  \draw[->] (A0) -- node[above=1pt] {\footnotesize linear} (A1);
  \draw[->] (A1) -- node[above=1pt] {\footnotesize ReLU} (A2);
  \draw[->] (A2) -- node[above=1pt] {\footnotesize linear} (A3);
  \draw[->] (A3) -- node[above=1pt] {\footnotesize ReLU} (A4);
  \draw[->] (A4) -- node[above=1pt] {\footnotesize linear} (A5);
