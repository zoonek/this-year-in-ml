\nextbook
\begin{book}
  \emph{A primer on monotone operator methods}\\
  A.K. Ryu and S. Boyd (2016)
\end{book}

\textbf{2.} A \emph{relation} (or \emph{operator}, or correspondance,
or set-valued function) on $\RR^n$
is a subset $F \subset \RR^n \times \RR^n$.
Its \emph{subdifferential} is
\[ \partial f = \{ (x,g( \ :\
\forall z \ f(z) \geq f(x) + g^T (z-x) \} \]
\begin{align*}
  (v,u) \in \partial f
  & \iff (u,v) \in ( \partial f )^{-1} \\
  & \iff v \in \argmin_x f(x) - u^T x \\
  & \iff f(v) + f^*(u) = v^T u 
\end{align*}
where $f^*(y) = \sum_x y^T x - f(x) $.

A function $f : \RR^n \to \RR\union\{\infty\}$ is \emph{closed}
if its epigraph
\[ \operatorname{epi} f = \{ (x,t) \ :\ x \in \operatorname{dom} f , \ f(x) \leq t \}; \]
it is \emph{proper} if its domain is non-empty.
If f is \emph{CCP} (convex, closed, proper),
$f^{**} = f$, and $(\partial f)^{-1} = \partial f^*$.

\textbf{3.}
A Lipschitz relation with constant $L$ is a function;
if $L<1$, it is a contraction;
if $L=1$, it is \emph{non-expansive}.
The set of fixed points of a non-expansive function,
$(I-F)^{-1}(0)$, is closed and convex (but possibly empty);
for a contraction, it has exactly one point.

An \emph{averaged} operator is of the form $F = (1-\theta) I + \theta G$,
$\theta \in (0,1)$, $G$ non-expansive;
$F$ is still non-expansive, and has the same fixed points as $G$.

Projections, and \emph{overprojections} (on a compact set $C$) are non-expansive.
\begin{align*}
  \Pi_C(x) &= \argmin_{z \in C} \n{ z - x } \\
  Q_C &= 2 \Pi_C - I 
\end{align*}
\[
\begin{tikzpicture}[>=stealth,xscale=.5,yscale=.5,inner sep=1pt,outer sep=1pt,baseline=0]
  \draw[fill=black!10,thick] (1,1)
  to[out=135,in=0,looseness=1] (-1,2)
  to[out=180,in=45] (-3,1.5)
  to[out=-135,in=135] (-3,0)
  to[out=-45,in=180] (0,-1)
  to[out=0,in=-45] cycle;
