\nextbook
\begin{book}
  \emph{Learning long-term dependencies\\ via Fourier recurrent units} \\
  J. Zhang et al.
\end{book}
Statistical recurrent units (SRU) keep moving averages of past hidden states; 
Fourier recurrent units keep their (truncated) Fourier transform.



\nextbook
\begin{book}
  \emph{Learning in reproducing kernel Kre\u\i n spaces} \\
  D. Oglic and T. G\"artner (2018)
\end{book}
A \d{Kre\u\i n space} is a vector space $H$ with a non-degenerate  symmetric but indefinite bilinear form
admitting a decomposition 
$H = H_+ \oplus H_-$ into orthogonal Hilbert spaces such that 
$\langle f , g \rangle _H = 
\langle f_+ , g_+ \rangle _{H_+} - 
\langle f_- , g_- \rangle _{H_-}.
$
The inner product 
$
\langle \cdot , \cdot \rangle _{H_+} +
\langle \cdot , \cdot \rangle _{H_-}
$
makes $H$ a Hilbert space; 
its topology does not depend on the choice of decomposition.

A \emph{reproducing kernel Kre\u\i n space} is a Kre\u\i n space $K \subset \RR^X$
for which the evaluation is continuous.
If $k : X \times X \to \RR$
is a difference of positive kernels (not every non-degenerate symmetric kernel is),
it defines a reproducible kernel Kre\u\i n space.

\nextbook
\begin{book}
  \emph{Goodness-of-fit testing for discrete distributions via Stein discrepancy} \\
  J. Yang et al. (2018)
\end{book}
To characterize convergence in distribution towards $p$,
the \d{Stein method} uses a ``Stein operator''
$\mathscr A_p$, usually defined from the score function of $p$
(which can be computed from an unnormalized probability distribution), e.g., 
\[
  \mathscr A _p f(x) = \nabla \log p(x) f(x) + \nabla f(x), 
\]
and a set of test functions $\mathscr F$, e.g., 
$W^{2,\infty}$,
or the unit ball of a RKHS, such that 
\[
\forall f \in \mathscr F \  \E_{ x \sim q } \bigl[ \mathscr A _p f(x) \bigr] = 0 \quad \text{iff} \quad q=p.
\]
The \emph{Stein discrepancy}
\[
  \sup_{ f \in \mathscr F } \E _{ x \sim q } \bigl[ \mathscr A_p f(x) \bigr]
\]
can be used as a goodness of fit statistic for unnormalized distributions.

For discrete distributions, use
\begin{align*}
  \Delta_i f(\mathbf x ) &= f( \mathbf x ) - f( \sigma_i \mathbf x ) \\
  \Delta^*_i f(\mathbf x ) &= f( \mathbf x ) - f( \sigma_i^{-1} \mathbf x ) \\
  s_i( \mathbf x ) &= \dfrac{ \Delta_i p(\mathbf x ) }{ p( \mathbf x ) } \\
  \mathscr A_p f(\mathbf x ) &=  s( \mathbf x ) f( \mathbf x )' - \Delta^* f(\mathbf x )
\end{align*}
where $\mathbf x \in X^d$, 
$X$ is finite,
$\sigma$ is a cyclic permutation of $X$, 
$\sigma_i$ only acts on the $i$th component,
$f : X^d \to \RR ^m$, 
$p$ is a distribution on $X^d$.
For the unit ball of a RKHS, 
\[ D( q \,\|\, p ) = \sup_f \E_{x \sim q} \bigl[ \tr \mathscr A _p f(x) \bigr] \]
can be computed as 
\[ D( q \,\|\, p ) = \E_{x, y \sim q} \bigl[ \kappa_p( x, y ) \bigr]. \]

\nextbook
\begin{book}
  \emph{A spline theory of deep networks} \\
  R. Balestriero and R.G. Baraniuk (2018)
\end{book}
To make the features learned by a neural net more orthogonal, 
add a penalty 
\[ \lambda \cdot \sum_{ i \neq j } \va{ \langle w_{i\cdot} , w_{j\cdot} \rangle }^2. \]

\nextbook
\begin{book}
  \emph{Non-overlap-promoting variable selection} \\
  P. Xie et al. (2018)
\end{book}
The multilogistic model has a vector of parameters $w_i$ for each class $i$.
Easy-to-interpret sparse vectors with little overlap can be obtained with an $\ell^1$ penalty
and a penalty encouraging the vectors $w_i$ to be orthogonal or orthonormal, \ie, 
encouraging the Gram matrix $G_{ij} = w_i ' w_j$ to be close to the identity.

The \d{log-determinant divergence} measures how close two matrices are.
\[ D(X,Y) = \tr( X Y^{-1} ) - \log \det ( X Y^{-1} ) \]

\nextbook
\begin{book}
  \emph{Variable selection via penalized neural network: a drop-out-one loss approach} \\
  M. Ye and Y. Sun (2018)
\end{book}
Variant of backward elimination (stepwise regression),
with a neural network, for variable selection: 
fit a complete model, 
drop one variable \emph{without re-fitting},
discard it if the change in loss is small.

\nextbook
\begin{book}
  \emph{Nonparametric variable importance\\ using an augmented neural network\\ with multitask learning} \\
  J. Feng et al. (2018)
\end{book}
To estimate (local) variable importance 
\[ \bigl( E[Y|X] - E[Y|X_{-i}] \bigr) ^2 \]
in a neural network,
augment its input with a mask indicating which variables to use.

\nextbook
\begin{book}
  \emph{Accelerated spectral ranking} \\
  A. Agarwal et al. (2018)
\end{book}
Pairwise or multiway comparisons 
(sports ranking, recommendation systems, social choice)
can be aggregated: 
the Bradley-Terry model weights
\[ P[i \succ j] = \dfrac{ w_i }{ w_i + w_j } \]
are the centralities of a graph,
and can be estimated with random walks.

\nextbook
\begin{book}
  \emph{Ranking distributions based on noisy sorting} \\
  A. El Mesaoudi-Paul et al. (2018)
\end{book}
Define a probability distribution of $\mathfrak S_n$
by using a sorting algorithm (insertion, quicksort) with comparisons replaced by Bernoulli trials;
the Bernoulli parameters are pairwise preferences.
Other distributions on $\mathfrak S_n$ include: 
\begin{compactitem}[--]
\item \d{Mallows}: $P[\sigma] \propto \exp - k \tau(\sigma)$,
  where $\tau$ is Kendall's tau
  (it can be centered on a permutation $\sigma_0 \neq \text{Id}$ by using $\tau(\sigma_0 \sigma \sigma_0^{-1})$);
\item Generalized Mallows: $P[\sigma] \propto \exp - \sum k_i d_i(\sigma)$,
where $d_i(\sigma) = \sum_{ j>i} \mathbf 1_{ \sigma^{-1} (j) < \sigma^{-1} (i)}$
(it can be further generalized to account for a hierarchical structure on $\llbracket 1 , n \rrbracket$);
\item \d{Plackett-Luce}: 
$P[\sigma(i) = k | \sigma(1), \dots, \sigma(i-1) ] \propto \theta_k$, \ie, 
\[ 
P[\sigma] = \prod_i \dfrac{ 
  \theta_{ \sigma^{-1}(i) } 
}{
  \theta_{ \sigma^{-1}(i) } + 
  \theta_{ \sigma^{-1}(i+1) } + 
  \cdots 
  \theta_{ \sigma^{-1}(n) }
} 
\]
\item \d{Babington-Smith}: 
  the orderings of pairs are independent Bernoulli trials, rejected if they do not give an order relation,
  \[ P[\sigma] \propto \prod_{ i < j } P_{ \sigma^{-1}(i), \sigma^{-1}(j) }, \]
\end{compactitem}

\nextbook
\begin{book}
  \emph{A probabilistic theory of supervised similarity learning for pointwise ROC curve optimization} \\
  R. Vogel et al. (2018)
\end{book}
\emph{Pointwise ROC optimization} maximizes the TPR (true positive rate)
for a fixed FPR (false positive rate).

\emph{Pairwise bipartite ranking} learns to recognize if two observations $x$, $x'$
have the same label 
$y=y'$ 
(e.g., if two photographs are of the same person), 
\( (x,x') \mapsto \mathbf 1 _{ y = y' }. \)

\nextbook
\begin{book}
  \emph{Fast stochastic AUC maximization\\ with $O(1/n)$ convergence rate} \\
  M. Liu et al. (2018)
\end{book}
The AUC
is often maximized using a surrogate square loss
\begin{align*}
  \text{AUC} &= P[ f(x_1) < f(x_2) \ |\  y_1 = +1, y_2 = -1 ] \\
  \text{Loss}(f) &= E\bigl[ \bigl( f(x_1) - f(x_2) - 1 \bigr) ^ 2 \,|\, y_1 = +1 , y_2 = -1 \bigr];
\end{align*}
this can be turned into a saddle point problem.
% Complicated formula -- I do not know where it comes from

\nextbook
\begin{book}
  \emph{Accelerated stochastic mirror descent:\\ from continuous-time dynamics\\ to discrete-time algorithms} \\
  P. Xu et al. (2018)
\end{book}
% SDE interpretation of SMD
\emph{Stochastic mirror descent} (SMD)
\begin{align*}
  y_{k+1} & \leftarrow \nabla h( x_k ) - \eta \nabla f( x_k ) \\
  x_{k+1} &\leftarrow \nabla h^* ( y_{k+1} )
\end{align*}
minimizes $E[f]$, where $h$ is convex on $X$, 
e.g., $h(x) = \n{x}_2^2$ on $\RR^2$ 
or $h(x) = \sum x_i \log x_i$ on $\Delta_n$,
and $h^*(y) = \sup _{x\in X} \langle y, x \rangle - h(x)$.

\nextbook
\begin{book}
  \emph{Batch Bayesian optimization\\ via multi-objective acquisition ensemble\\ for automated analog circuit design} \\
  W. Lyu et al. (2018)
\end{book}
Multiobjective optimization of multiple acquisition functions leads to (single-objective) \emph{batch} optimization.

\nextbook
\begin{book}
  \emph{Subspace embedding and linear regression\\ with Orlicz norm} \\
  A. Andoni et al. (2018)
\end{book}
Orlicz norms generalize $\ell^p$ norms and (when used for losses rather than penalties)
provide robust estimators (not unlike $\ell^p$, $1 \leq p < 2$).
\begin{align*}
  f(x) &= \begin{cases}
    \tfrac12 x^2 & \text{if } \va x \leq \delta \\
    \delta( \va x - \tfrac12 \delta ) & \text{otherwise} 
  \end{cases} \qquad \text{(Huber)}\\
  G(x) &= f\bigl( f^{-1}(1) x \bigr) \\
  \n{ x }_G &= \inf \Bigl\{\, \alpha > 0 \ :\ \sum G( \va{ x_i } / \alpha ) \leq 1 \,\Bigr\}
\end{align*}

\nextbook
