%% 2019-07-04
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\begin{book}
  \emph{Statistical inference\\ using the Morse-Smale complex} \\
  Y.C. Chen et al. (2015)
\end{book}
The \d{Morse-Smale complex} of a function $f: X \to \RR$ 
decomposes the space $X$ with the intersections of the ascending and descending manifolds, \ie, the basins of attractions of the gradients of $f$ and $-f$.

\d{Mean-shift clustering} (or \d{mode clustering})
uses the ascending manifolds as clusters.

\d{Morse-Smale regression} estimates a linear model in each cell of the Morse-Smale complex of a kernel estimator 
$f(x) = E[ Y | X = x ]$.

The \d{Morse-Smale signature graph} (of a density estimate, 
a regression function, or a difference of densities)
has maxima and minima as nodes, 
Morse-Smale cells as edges,
the slope of a linear approximation as edge weights, 
and uses multidimensional scaling (MDS) for node coordinates.

The \d{Morse-Smale energy test} compares two probability distributions, using half the data to estimate the Morse-Smale complex of the difference of densities,
and the other half to perform an energy (distance correlation) test 
in each cell, with a Bonferroni correction.

\nextbook
\begin{book}
  \emph{Morse-Smale regression} \\
  S. Gerber et al. (2013)
\end{book}
The \d{Morse-Smale complex} of a function $f:X \to \RR$
known on a finite set of points can be computed from the $k$-nearest neighbour graph,
following the paths of steepest descent or ascent (\emph{quick-shift} algorithm).

The cell of a new point can be predicted using a kernel density estimator or a support vector machine (SVM).

Morse-Smale regression fits a linear model in each cell, 
either with discontinuities
\[ \hat f(x) = a_i + b_i \quad \text{if $x \in C_i$} \]
or with weights from the cell prediction model 
\[ \hat f(x) = \sum_i P[ x \in C_i ] ( a_i + b_i x ). \]

The \emph{persistence} of a critical point $x$ is 
$\min_y \n{ f(x) - f(y) }$,
where the minimum is over the set of critical points $y$
in cells adjacent to $x$;
this defines a filtration of Morse-Smale complexes
(use the BIC to select the persistence level, \ie, the number of cells).

\nextbook
\begin{book}
  \emph{Visual exploration\\ of high-dimensional scalar functions} \\
  S. Gerber et al. (2011)
\end{book}
Dimension reduction can help understand high-dimensional clouds of points.
For functions (scalar fields)
defined on an intrinsically high-dimensional cloud of points (or models with many variables interacting in complicated ways):
\begin{compactitem}[--]
\item Build the $k$-nearest graph of the cloud of points ($k$ should increase with dimension);
\item Compute the corresponding Morse-Smale complex; 
one can fine-tune the level of detail -- start at the coarsest level;
\item For each Morse-Smale crystal, estimate an (inverse) local (kernel) regression 
$X \sim y$: it is a path from minimum to maximum;
\item For each such path $r$, compute a few geometric summaries: 
sensitivity $dr/dy$,
average distance to the curve, sampling density -- these form bands around the curves;
\item Project those curves onto the first principal component of the extrema.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Data analysis with the Morse-Smale complex: the \texttt{msr} package for R} \\
  S. Gerber et al.
\end{book}
Implementation of Morse-Smale regression and inverse regression.

%% Link prediction

\nextbook
\begin{book}
  \emph{Link prediction in complex networks: a survey} \\
  L. L\"u and T. Zhou (2010)
\end{book}
Predict missing links in an (undirected, homophilic) network
using local or global similarity measures: 
\begin{compactitem}[--]
\item The number of common neighbours, $\va{ \Gamma(x) \inter \Gamma(y) }$, divided by 1, $k_x + k_y$, $k_x k_y$, 
$\sqrt{ k_x k_y }$, $\max\{ k_x, k_y \}$, $\min\{ k_x, k_y \}$,
$\va{ \Gamma(x) \union \Gamma(y) }$;
\item $k_x k_y$ (preferential attachment -- this uses too little information);
\item The number of common neighbours, with less weight for the more promiscuous ones, 
\[ 
  \sum_{ z \in \Gamma(x) \inter \Gamma(y) } \dfrac1{k_z}, \qquad
  \sum_{ z \in \Gamma(x) \inter \Gamma(y) } \dfrac1{\log k_z}
\]
\item PageRank (random walk with restarts);
\item SimRank;
\item Katz: $(I - \beta A)^{-1}$;
\item The average commute time 
  $(L^\dag)_{xx} + (L^\dag)_{yy} - 2 (L^\dag)_{xy}$, 
  $L = D-A$;
\item  Matrix forest" $(I + \alpha L)^{-1}$;
\item Cosine: $(L^\dag)_{xy} / \sqrt{ (L^\dag)_{xx} (L^\dag)_{yy} }$.
\end{compactitem}

Statistical models are another (slow, inaccurate, not scalable) 
option: 
\begin{compactitem}[--]
\item \emph{Hierarchical structure model}: 
the nodes are the leaves of a dendrogram; 
each internal node $x$ is assigned a number $p_x \in [0,1]$,
and thee link probability is $P[x\text{--}y] = P_{x\wedge y}$, 
where $x \wedge y$ is the lowest common ancestor of the leaves $x$ and $y$;
\item \emph{Stochastic block model}.
\end{compactitem}

% The section on PGM is not clear
\nextbook
\begin{book}
  \emph{The link prediction problem\\ for social networks} \\
  D. Liben-Nowell and J. Kleinberg (2004)
\end{book}
Forecast new links in a (co-authorship network 
using node similarity (Katz, Adamic-Adar, etc.), 
computed from the adjacency matrix, or a low-rank approximation,
or a cleaned version (pruned of low-similarity edges).

\nextbook
\begin{book}
  \emph{Link prediction in evolving networks\\ based on popularity of nodes} \\
  T. Wang et al. 
\end{book}
To predict links in (homophilic) evolving networks,
use the \emph{popularity} of the nodes (proportion of recent edges): 
active nodes attract more links.

\nextbook
\begin{book}
  \emph{Link prediction in complex networks:\\ a mutual information perspective} \\
  F. Tan et al.
\end{book}
Nodes whose neighbours tend to be connected tend to be connected.
\begin{align*}
  \Gamma(x) &= \{ \text{neighbours of $x$} \} \\
  k_x &= \va{ \Gamma(x) } \\
  M &= \text{Number of edges} \\
  N_{\Delta z} &= \text{\# of connected pairs of neighbours of $z$}\\
  N_{\Lambda z} &= \text{\# of disconnected pairs of neighbours of $z$}\\
  p_{xy} &= \dfrac{
    1 - \binom{ M - k_y}{k_x}
  }{ 
    \binom{M}{k_x}
  } \\
  I_{xy} &= - p_{xy} \log p_{xy} \\
  I_z &= \operatorname*{Mean}_{ x, y \in \Gamma(z) }
  \log \dfrac{
    \binom{M}{k_x}
  }{
    \binom{M}{k_x} - \binom{M-k_y}{k_x}
  } + 
  \log \dfrac{
    N_{\Delta z}
  }{
    N_{\Delta x} + N_{\Lambda z}
  } \\
  S(x,y) &= \sum_{
    z \in \Gamma(x) \inter \Gamma(y)
  } I_z - I_{xy}  
\end{align*}

\nextbook
\begin{book}
  \emph{Supervised random walks: predicting\\ and recommending links in social networks} \\
  L. Backstrom and J. Leskovec (2011)
\end{book}
Personalized-PageRank-like measure of similarity
computed from a weighted graph, 
where the (learned) edge weights are computed from edge and node features; 
train with a hinge loss on $P_{i \to j} < P_{i \to k}$,
where $i\to k$ is an edge and $i\to j$ is not.

\nextbook
\begin{book}
  \emph{DeepWalk:\\ online learning of social representations} \\
  B. Perozzi et al. (2014)
\end{book}
Apply \emph{word2vec} (skipgram with negative sampling) 
to random walks on a graph 
to get a vertex embedding.
Use a Huffman-coding-based \emph{hierarchical softmax} 
to deal with the large number of nodes.

\nextbook
\begin{book}
  \emph{node2vec:\\ scalable feature learning for networks} \\
  A. Grover and J. Leskovec (2016)
\end{book}
Random walks on a graph (depth-first search, DFS)
provide an alternative to the traditional notion of neighbourhood
(breadth-first search, BFS).
Use a \emph{biased random walk}
with different probabilities for going back, moving to a neighbour common to the previous node, moving to another neighbour.

\nextbook
\begin{book}
  \emph{Structural deep network embedding} \\
  D. Wang et al. (2016)
\end{book}
Learn an \emph{autoencoder} $x_i \mapsto y_i \mapsto \hat x_i$
where $x_i$ is the $i$th row of the adjacency matrix, 
with
\[ 
  \text{loss} = 
  \sum _{ (ij) \in E } \n{ y_i - y_j }^2 + 
  \sum _{ (ij) \in E } \n{ \hat x_{ij} - x_{ij} }^2 + 
  \text{regularizer;}
\]
the hidden layer $y$ provides a node embedding.

LLE, IsoMap, Laplacian eigenmaps provide other (shallower) embeddings. 

\nextbook
\begin{book}
  \emph{LINE:\\ large-scale information network embedding} \\
  J. Tang et al.
\end{book}
Find a low-dimensional embedding $u_i$ of the nodes to minimize
\[ - \sum_{ (ij) \in E } 
w_{ij} \log \dfrac{ 1 }{ 1 + e^{ - u'_i u_j } }
\quad\text{or}\quad
w_{ij} \log \dfrac{ e^{ u'_i u_j } }{ \sum_k e^{ u'_i u_k } }
\]
(KL divergence between the probability distributions inside the logarithms and 
$\hat p_{ij} = w_{ij} / \sum_{k\ell} w_{k\ell}$
or 
$\hat p_{ij} = w_{ij} / \sum_{k} w_{ik}$.)

\nextbook
\begin{book}
  \emph{Link prediction via subgraph embedding-based convex matrix completion} \\
  Z. Cao et al. (2018)
\end{book}
Compute node representations using word2vec (on random walks)
or GloVe (on $\text{PPMI} = (A + A^2)/2$)
on the graph whose nodes are egonets (of radius $r$) 
and with edges between egonets in the radial context (of radius $R$) of a node.

\nextbook
\begin{book}
  \emph{GraRep: learning graph representations\\ with global structural information} \\
  S. Cao et al.
\end{book}
Word2vec for node embedding cannot distinguish between 
\smash{\begin{tikzpicture}[scale=.2,>=stealth,inner sep=1pt, outer sep = 0pt,
baseline=-2pt,
every node/.style={circle,draw}
]
\node       (O) at (0,0) {};
\node[fill] (N) at (0,1) {};
\node       (S) at (0,-1) {}; 
\node       (W) at (-1,0) {};
\node       (E) at (1,0) {};
\draw (O) -- (N);
\draw (O) -- (S);
\draw (O) -- (E);
\draw (O) -- (W);
\end{tikzpicture}}
and
\smash{\begin{tikzpicture}[scale=.2,>=stealth,inner sep=1pt, outer sep = 0pt,
baseline=-2pt,
every node/.style={circle,draw}
]
\node[fill] (O) at (0,0) {};
\node       (N) at (0,1) {};
\node       (S) at (0,-1) {}; 
\node       (W) at (-1,0) {};
\node       (E) at (1,0) {};
\draw (O) -- (N);
\draw (O) -- (S);
\draw (O) -- (E);
\draw (O) -- (W);
\end{tikzpicture}}
(the contexts are the same):
replace the center word and the context with the first and last vertices of a length-$k$ random walk;
setting the gradient of the loss function to zero 
yields a matrix factorization problem, 
\[ W_i C_j = \log \dfrac{ (A^k)_{ij} }{ (A^k)_{ \cdot j} }
- \log \beta \]
(replace negative values with zero, to reduce noise);
and concatenale all $k$-step representations, 
$k \in \llbracket 1, K \rrbracket$.

\nextbook
\begin{book}
  \emph{New perspectives and methods\\ in link prediction} \\
  R.N. Lichtenwalter et al. (2010)
\end{book}
Use \emph{ensembles} of classifiers to reduce variance 
(C45, J48, naive Bayes, random forests).
Try the following features: 
\begin{compactitem}[--]
\item A variant of rooted PageRank: 
the probability that a random walk with no duplicates, starting at $x$, visits $y$ in at most $k$ steps;
\item The maximum flow that can travel from $x$ to $y$ in at most 5 steps.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Computationally efficient link prediction\\ in a variety of social networks} \\
  M. Fire et al. (2013)
\end{book}
Use a decision tree (J48) with node features
(degree, Katz, number of paths of length 3, shared communities, etc.)
to forecast missing links.

\nextbook
\begin{book}
  \emph{Link prediction\\ with personalized social influence} \\
  Z. Huo et al. (2018)
\end{book}
Given a directed social network (e.g., Twitter),
prune it to keep only significant connections, 
measured by the \emph{mutual information}
between the timing of user $j$'s tweets and the timing of user $i$'s retweets of user $j$'s tweets,
and find node embeddings $S$ and $T$ (source and target)
to model the link probability as 
\[ P[ i \to j ] = \dfrac{ e^{ S_i ' T_j } }{ \sum\limits_k e^{ S_i ' T_k } }. \]


\nextbook
\begin{book}
  \emph{Link prediction in social networks:\\ the state of the art} \\
  P. Wang et al. (2015)
\end{book}
Broken English

\nextbook
\begin{book}
  \emph{Connected patterns inspire\\ link prediction in complex networks} \\
  M.Y. Zhou et al. (2017)
\end{book}
Do not use a raw node similarity score to predict missing links: 
learn a nonlinear transformation of the score.
[Better: learn a nonlinear way of combining several of those scores.]

\nextbook
\begin{book}
  \emph{Link prediction via matrix factorization} \\
  A.K. Menon et al. (2011)
\end{book}
Model the link probabilities as 
\[ P[i\to j] = \sigma( 
  u_i ' \Lambda u_j + b_i + b_j + 
  w' z_{ij} + x_i ' V x_j
) \]
where $\sigma$ is the logistic function, 
$u_i ' \Lambda u_j$ is a matrix factorization,
$x_i$ are the node features,
$w_{ij}$ the edge features
and $x_i' V x_j$ a bilinear model (which works better than a linear one, $v' x_i + v' x_j$); 
add a regularizing penalty for $U$, $V$, $\Lambda$, $W$.

To overcome class imbalance, directly optimize the AUC
by training on pairs of positive and negative samples -- indeed,
\( \text{AUC} = P\bigr[ f(i) > f(j)  \ |\ y_i = 1, \ y_j = 0 \bigl] \)
(either arbitrary pairs, or pairs that share a node).

\nextbook
\begin{book}
  \emph{Link prediction based on graph neural networks} \\
  M. Zhang and Y. Chen (2018)
\end{book}
Graph neural networks can approximate node similarity measures and forecast missing edges.

\nextbook
\begin{book}
  \emph{Link prediction through deep learning} \\
  X.W. Wang et al. (2018)
\end{book}
Consider the adjacency matrix of a network as an image;
reorder the nodes to make patterns more visible, 
using 
\begin{compactitem}[--]
\item (Multiresolution) community detection;
\item Consensus-based relabeling, which minimizes 
\[ \sum_i \dfrac1{k_i} \sum_j \va{ r_{ i,j+1} - r_{i,j} - 1 } \]
where $r_{ij}$ is the index of the $j$th neighbour of node $i$;
\item Or any matrix reordering algorithm;
\end{compactitem}
apply a deep generative model (convolutional VAE or GAN -- 
the latter works better)
on perturbed copies of the adjacency matrix (obtained by removing 5\% of the edges).

\nextbook
\begin{book}
  \emph{Link prediction: fair and effective evaluation} \\
  R. Lichtenwalter and N.V. Chawla
\end{book}
When the data is unbalanced, prefer the area under the 
precision-recall curve to that under the TPR-FPR one (ROC).

\nextbook
\begin{book}
  \emph{Evaluating link prediction methods} \\
  Y. Yang et al. (2013)
\end{book}
Idem

\nextbook
\begin{book}
  \emph{Link propagation: a fast semi-supervised learning algorithm for link prediction} \\
  H. Kashima et al.
\end{book}
Given a node similarity matrix $W$ and a matrix 
indicating the presence ($+1$) or absence ($-1$) of edges $F^*$
(unknown edges are left at 0, and the weights can be 
$\va E / \va{ E^+}$ and $-\va E / \va{E^-}$
if the classes are unbalanced),
\d{link propagation} completes the graph by minimizing 
\[
  %J(F) = 
  \sum_{ijk\ell} w_{ijk\ell} (f_{ij} - f_{k\ell})^2 + 
  \lambda \sum_{(ij) \in E} (f_{ij} - f_{ij}^*)^2 + 
  \mu \sum_{(ij)\not\in E} f_{ij}^2
\]
where the edge similarities are $W \tens W$;
this can be generalized to multiple edge types
(we then have order-3 tensors),
expressed with linear algebra operations,
and optimized with gradient descent.

\nextbook
\begin{book}
  \emph{Link prediction in very large directed graphs: exploiting hierarchical properties in parallel} \\
  D. Garcia-Gasulla and U. Cort\'es
\end{book}
To infer missing links in directed graphs, 
generalize the neighbourhood-based similarity measures
by separating ancestors and descendants, 
$N(x) = A(x) \sqcup D(x)$, e.g., 
\[
  \dfrac{ 
    \n{ A(x) \inter D(y) }
  }{
    \n{ A(x) }
  } + 
  \dfrac{
    \n{ D(x) \union D(y) }
  }{
    \n{ D(x) }
  }.
\]

\nextbook
\begin{book}
  \emph{Modeling relational data\\ with graph convolutional networks} \\
  M. Schlichtkrull et al.
\end{book}
Graph convolutional networks (GCN) can be augmented with node and edge attributes or \emph{types} 
(\emph{relational GCN}).

\nextbook
\begin{book}
  \emph{Graph convolutional neural networks\\ for web-scale recommender systems} \\
  R. Ying et al.
\end{book}
To scale graph convolutional networks to large graphs, 
use samples of the neighbourhoods instead of the whole Laplacian.

\nextbook
\begin{book}
  \emph{Probabilistic relational models} \\  
  L. Getoor et al.
\end{book}

A \d{probabilistic relational model} (PRM) is a \emph{template}
for Bayesian networks, 
linking node \emph{types} rather than nodes
(it can be seen as a Bayesian network on a graph with typed nodes, and parameters (or Bayesian priors on those parameters) shared among all nodes of the same type).
Links can also be probabilistic and modeled from node attributes. 

\nextbook
\begin{book}
  \emph{Probabilistic entity-relationship models,\\ PRMs and plate models} \\
  D. Heckman et al.
\end{book}
Probabilistic relational models (PRM)
probabilistic entity-relation (ER) models (DAPER -- contrary to PRMs, they distinguish between entities and relations)
and plate models are equivalent.

\nextbook
\begin{book}
  \emph{Relational learning with Gaussian processes} \\
  W. Chu et al.
\end{book}
Model links as 
$P[i{-}j] = \sigma\bigl( f(x_i)' f(x_j) \epsilon_{ij} \bigr)$,
where $i$, $j$ are nodes, 
$f \sim \text{GP}$, 
$\epsilon \in \{ \pm 1 \}$ and estimate $P[\epsilon \,|\, \text{links}]$.

\nextbook
\begin{book}
  \emph{Stochastic relational models\\ for discriminative link prediction} \\
  K. Yu et al. 
\end{book}
In a user-movie recommendation problem, 
the ratings are a function 
$\text{Users} \times \text{Movies} \to \RR$
which can be modeled by a \emph{tensor Gaussian process},
\ie, a Gaussian process whose kernel is a Kronecker product 
$
\Sigma _{\text{Users}} \otimes 
\Sigma _{\text{Movies}}.
$

\nextbook
\begin{book}
  \emph{Dependency networks for inference, collaborative filtering and data visualization} \\
  D. Heckerman et al. (2000)
\end{book}
\emph{Dependency networks}, 
in which the parents of a node are its Markov blanket, 
\[ \forall\, Y \not\in \operatorname{pa}(X) \ \ X \indep \,|\ \operatorname{pa}(X), \]
are a potentially cyclic alternative to Bayesian networks, 
which do not lead to causal misinterpretations.

\nextbook
\begin{book}
  \emph{Discriminative probabilistic models\\ for relational data} \\
  B. Taskar et al.
\end{book}
Undirected graphical model template, \ie, graphical model with shared parameters. 

%% Ranking, AUC optimization

\nextbook
\begin{book}
  \emph{BPR: Bayesian personalized ranking\\ from implicit feedback} \\
  S. Rendle et al. (2009)
\end{book}
The classification problem with three types of items,
known positives, unknown positives and unknown negatives,
is sometimes tackled by learning to separate known positives from the rest.
Instead, one can look for a total order such that 
known positives dominate unknown items.
This is similar to AUC optimization, 
but with the Heaviside objective 
\[ 
\sum_{\substack{ i \text{ positive} \\ j \text{ unknown} }}
\mathbf 1_{ x_i(\theta) > x_j(\theta) } 
\]
replaced with a differentiable (penalized) likelihood
\[
\sum_{\substack{ i \text{ positive} \\ j \text{ unknown} }}
\log \sigma\bigl( x_i(\theta) - x_j(\theta) \bigr)
+ \lambda \n{ \theta }^2,
\]
corresponding to a logistic model 
\[ 
P[i>j] = \sigma\bigl( x_i(\theta) - x_j(\theta) \bigr). 
\]

For the item recommendation problem (one more index, for users, 
$x_{ui}$),
the model can be a low-rank matrix factorization 
$X = W H'$ 
or an adaptive $k$-nearest neighbour model, 
\[ 
  x_{ui} = \sum_{\substack{
    u \text{ likes } \ell \\
    \ell \neq i
  }} c_{i\ell},
  \qquad 
  C = H H'.
\]

\nextbook
\begin{book}
  \emph{Optimizing area under the ROC curve\\ using gradient descent} \\
  A. Herschtal and B. Raskutti (2004)
\end{book}
Replace the Heaviside loss 
$ \mathbf 1_{ x_i(\theta) > x_j(\theta) } $
with a differentiable approximation 
$ \sigma\bigl( x_i(\theta) - x_j(\theta) \bigr). $

\nextbook
\begin{book}
  \emph{Naive Bayes for regression} \\
  E. Frank et al. (1999)
\end{book}
Naive Bayes does not work well for regression,
unless there is really a lot of data.
\begin{align*}
  P(Y|X_1,\dots,X_n) 
  &\propto P(X_1,\dots,X_n,Y) \\
  %&= P(X_1 | X_2,\dots,X_n,Y) P(X_2|X_3,\dots,X_n,Y)\cdots P(X_n|Y) P(Y) \\
  &= P(X_1 | X_2\cdots\mkern-.5mu) P(X_2|X_3\cdots\mkern-.5mu)\cdots P(Y) \\
  &\approx P(X_1 |Y) \cdots P(X_n|Y) P(Y)
\end{align*}

%% Topic models and neural networks

\nextbook
\begin{book}
  \emph{Neural variational inference\\ for text processing} \\
  Y. Miao et al. (2016)
\end{book}
Variational autoencoders can model topics (neural variational document model).
% Neural variational document model
\[
\begin{tikzpicture}[xscale=2,>=stealth,inner sep=2pt, outer sep=1pt,
every node/.style={anchor=base,text height=.8em,text depth=.2em}]
\node (Y) at (0,2) {$X$};
\node (H) at (0,1) {$h$};
\node (X) at (0,0) {$X$};
\draw[->] (X) -- node[auto,right=1pt,pos=.5,inner sep = 1pt]{\scriptsize $P(h|X)$} (H);
\draw[->] (H) -- node[auto,right=1pt,pos=.5,inner sep = 1pt]{\scriptsize $P(X|h)$} (Y);
\node at (1.2,1) {\smash{\emph{i.e.},}};
\node (noise) at (2,1) {noise};
\node (bow1) at (3,0) {bag of words};
\node (bow2) at (3,2) {bag of words};
\node (topic) at (3,1) {topic};
\draw[->] (bow1) -- (topic);
\draw[->] (topic) -- (bow2);
\draw[->] (noise) -- (bow2);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Discovering discrete latent topics\\ with neural variational inference} \\
  Y. Miao et al. (2018)
\end{book}
Replace the Dirichlet prior for word distributions in LDA with neural-network-friendly distributions, e.g.,
\begin{compactitem}[--]
\item Gaussian softmax
  \begin{align*}
    x &\sim N(0,I) \\
    p &= \text{softmax}(Ax) 
  \end{align*}
\item Gaussian stick-breaking
  ($\eta \sim \text{Beta}$ would give a Dirichlet distribution)
  \begin{align*}
    x &\sim N(0,I) \\
    \eta &= \operatorname{sigmoid}( Ax ) \\
    p_k &= \eta_k \prod_{1}^{k-1} ( 1 - \eta_i ) \\
    p_n &= \prod ( 1 - \eta_i )
  \end{align*}
\item Recurrent stick-breaking
  \begin{align*}
    x & \sim N(0,I) \\
    \eta &= \text{RNN}(x) \\
    p &= \text{StickBreaking}(\eta)
  \end{align*}
\end{compactitem}

\nextbook
\begin{book}
  \emph{TopicRNN: a recurrent neural network\\ with long-range semantic dependency} \\
  A.B. Dieng et al.
\end{book}
Use a Gaussian distribution instead of a Dirichlet prior for the topic distribution of each document.

Instead of modeling each topic as a distribution on words,
use a \emph{language model} parametrized by the topic vector (RNN).

Model stopwords (problematic, in topic models, because they do not carry any information)
using a mixture between the topic model and a distribution of stopwords (from a list).

\nextbook
\begin{book}
  \emph{Deep learning for assessing banks' distress from news and numerical financial data} \\
  P. Cerchiello et al.
\end{book}

Feed the 600-dimensional doc2vec embedding and 12 financial ratios to a binary classifier
(with one 50-neuron hidden layer).
% It is not clear if they have an out-of-sample period

%% NLP

\nextbook
\begin{book}
  \emph{Empath:\\ understanding topic signals in large-scale text} \\
  E. Fast et al.
\end{book}
MIT-licensed replacement for LIWC, 
with 200 categories selected from ConceptNet
and the words obtained using cosine similarity 
with a skipgram embedding trained on amateur fiction 
(Wattpad -- fiction is better for sentiment) 
and manually reviewed.

\nextbook
\begin{book}
  \emph{Automatic keyword extraction\\ from individual documents} \\
  S. Rose et al. (2010)
\end{book}
To extract multi-word keywords from an isolated document (not in a corpus), the \textsc{rake} algorithm proceeds as follows:
\begin{compactitem}[--]
\item Split the text on punctuation and stopwords to get keyword candidates (but allow candidates with one stopword if they are frequent enough);
\item For each word, compute the frequency (number of occurrences),
degree (number of words in the same candidates) and degree/frequency ratio;
\item Define the keyword score by summing the word scores.
\end{compactitem}
Also check TextRank.

To find stopwords from (manually generated) keywords, 
look for words at the boundary of keywords and rarely inside.

%% Interpreting ML models

\nextbook
\begin{book}
  \emph{Interpretable machine learning} \\
  C. Molnar (2018)
\end{book}
Interpretability is needed: 
\begin{compactitem}[--]
\item The problems we are solving are not completely specified -- 
we do not really want to optimize a single metric but several, 
and the model output is not the final goal, just an intermediate step before some decision;
\item We want to convince stakeholders that the model is safe, 
  robust unbiased and fair.
\end{compactitem}
But interpretability may make the system gamable.

Interpretability methods can be: 
\begin{compactitem}[--]
\item Intrinsic (how the model actually works)
or post hoc (as human explanations are);
\item Local (only valid for observations similar to a given one)
or global.
\end{compactitem}
The output can be: 
\begin{compactitem}[--]
\item Some feature summary (importance, contribution, visualization);
\item Model internals (weights);
\item Data points (prototypes, counterfactuals); 
\item An interpretable model.
\end{compactitem}
Good explanations should
\begin{compactitem}[--]
\item Be contrastive, \ie, explain why we got an output and not another; 
\item Be short (1 to 3 reasons, even of the model is more complex);
\item Highlight abnormal or unusual inputs (outliers);
\item Be consistent with prior beliefs (e.g., monotonicity);
\item Be general (apply to a large number of instances).
\end{compactitem}

% Part 1: Interpretable models
\textbf{1.} Interpretable models include 
linear models (with a sparsity constraint),
logistic regression, decision trees, 
decision rules, regression trees, naive Bayes, $k$-nearest neighbours.

% Part 2: Model-agnostic methods
\textbf{2.} Model-agnostic methods include: 
\begin{compactitem}[--]
\item Individual conditional expectation (ICE) plots, 
  \[ 
  f(x,x_2,\dots,x_n) \sim x, 
  \quad \text{for } (x_1,\dots,x_n) \in \text{Data}; 
  \]
\item Partial dependency plots (PDP),
  \[ E\bigl[ f(X_1,\dots,X_n) \,|\, X_1 = x \bigr] \sim x, \]
  \ie, the average of the ICE curves; 
  it can also be used for pairs of variables;
\item Friedman's $H$ statistic looks for interactions
  by comparing the partial dependency functions of 
  $X_1$, $X_2$, $X_{12}$, $X_{-1}$,
  \begin{align*}
    \text{PD}_I(x) &= E[ \hat f(X) | X_I = x_I ] \\
    H^2 &= \dfrac{
      E[ \text{PD}_{12}(X) - \text{PD}_1(X) - \text{PD}_2(X) ]
    }{
      E[ \text{PD}_{12}(X) ^ 2 ]
    } \\
    H^2 &= \dfrac{
      E[ \hat f(X) - \text{PD}_1(X) - \text{PD}_{-1}(X) ]
    }{
      E[ \hat f(X) ^2 ]
    }
  \end{align*}
\item Feature importance: permute the feature's values,
  and check the drop in performance;
\item  Global surrogate model;
\item Local surrogate model (LIME),
e.g., with a sparse linear model: 
  \begin{compactitem}[\ensuremath{\cdot}]
  \item For text, randomly remove some of the words;
  \item For images, segment them them into superpixels;
  \end{compactitem}
\item Shapley values
  \begin{align*}
    \phi_j &= \sum_{\substack{ 
      I \subset \llbracket 1, p \rrbracket \\ 
      j \not\in I 
    }}
    \binom{p}{\va I}
    \bigl( 
      v( I \union \{ j \} ) - v(I)
    \bigr) \\
    v(I) &= E\bigl[ \hat f(X) | X_I = x_I \bigr] - 
    E\bigr[ \hat f(X) \bigr].
  \end{align*}
\end{compactitem}

% Part 3. Example-based explanations
\textbf{3.} Example-based explanations include
\begin{compactitem}[--]
\item Counterfactual explanations: smallest changes to the features to change the outcome to a predefined value;
\item Adversarial examples: small, insignificant perturbations of the input
which nonetheless change the output;
\item MMD critic: 
greedily select \emph{prototypes} to reduce the maximum mean discrepancy 
%$\text{MMD}(\text{prototypes},\text{data})$,
between prototypes and data,
\[ 
  \text{MMD}(X,Y) = E\bigl[
    \kappa(X,X) - 2 \kappa(X,Y) + \kappa(Y,Y)
  \bigr],
\]
where $\kappa$ is an RBF kernel,
then greedily select \emph{criticisms}
where the prototypes and the data distributions differ,
\ie, maximizing 
$\va{ \text{witness}( x, \text{prototypes}, \text{data} ) }$
\[ 
  \text{witness}(x,X,Y) = E[ \kappa(x,X) - \kappa(x,Y) ],
\]
with a diversity-inducing submodular penalty 
\[ 
\log \det \bigl( \kappa( x_i, x_j ) \bigr)_{i,j} \in \text{criticism};
\]
\item Influential instances (\textsc{dfbeta}, Cook's distance, influence function).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Peeking inside the black box:\\ visualizing statistical learning\\ with plots of individual conditional expectation} \\
  A. Goldstein et al. (2014)
\end{book}
% ICE
The partial dependency plot integrates out $X_2,\dots,X_n$,
\[ \E_{ X_2,\dots,X_n } \bigl[ f(x_1, X_2, \dots, X_n ) \bigr] \]
while the ICE plots fix $x_2,\dots,x_n$ (one curve for each observation)
\[ f(x_1,\dots,x_n) \sim x_1. \]

\nextbook
\begin{book}
  \emph{Visualizing the effects of predictor variables\\ in black box supervised learning models} \\
  D.W. Apley
\end{book}
The \emph{partial dependency plot} 
\[ \E_{X_2} \bigl[ \hat f(X_1,X_2) \bigm| X_1 = x_1 \bigr] \]
uses the marginal distribution of $X_2$,
and estimates the predictor $\hat f$ 
very far away from the data, 
where it is unlikely to extrapolate well.

The \emph{marginal plot}
\[ \E_{ X_2 | X_1 = x_1 } \bigl[ \hat f( X_1, X_2 ) \bigm| X_1 = x_1 \bigr] \]
uses the conditional distribution $X_2 | X_1 = x_1$ instead,
but it suffers from the omitted variable bias: 
if $X_2$ plays a role, its impact will be included in the model intercept.

The \emph{accumulated local effects} (ALE) plot 
\[ \int_{-\infty} ^ {x_1} \E_{ X_2 | X_1 = x_1 } 
\Bigl[ \dfrac{ \partial f}{ \partial x_1} (X_1,X_2) \Bigm|X_1 = x \Bigr]
dx
\]
has the same interpretation without bias.
For non-differentiable models (e.g., trees),
use differences and sums instead of derivatives and integrals.

\nextbook
\begin{book}
  \emph{A unified approach\\ to interpreting model predictions} \\
  S.M. Lundberg and S.I. Lee (2017)
\end{book}
\d{Shapley values} estimate all models on a subset of the variables 
$I \subset S$ and compares those with and without variable $i$.

%% Stat, etc.

\nextbook
\begin{book}
  \emph{The separation plot: a new visual method\\ for evaluating the fit of binary models} \\
  B. Greenhill et al. (2011)
\end{book}
To assess the quality of a logistic model, look at
the ROC curve,
the AUC, 
the Brier score 
\[ \dfrac1n \sum ( \hat p_i - X_i )^2, \]
the pseudo-$R^2$ (likelihood ratio),
the expected proportion of correct predictions 
\[ 
\text{EPCP} = \dfrac1n 
\biggl [ 
  \sum_{ y_1 = 1 } \hat p_i + 
  \sum_{ y_1 = 0 } ( 1 - \hat p_i )
\biggr],
\]
the \emph{separation plot}
(1-dimensional tile plot, with one colour for each outcome, the cells ordered by the forecast, 
with the forecasted probability curve overlaid, 
and the expected number of events $\sum \hat p_i$ highlighted).

\nextbook
\begin{book}
  \emph{Deep learning: a critical appraisal} \\
  G. Marcus
\end{book}
Deep learning 
\begin{compactitem}[--]
\item Needs infinite data;
\item Cannot leverage background data, integrate prior knowledge,
  or learn abstractions from explicit verbal descriptions;
\item Has limited transfer learning capabilities;
\item Struggles with hierarchical structures;
\item Is a black box;
\item Cannot distinguish causation from correlation;
\item Assumes the world is stationary;
\item Has (frightening) non-human ``failure modes''.
\end{compactitem}
We need more unsupervised learning and hybrid symbolic-statistical systems.

