%% 2024-09
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%%
%%

\nextbook
\begin{book}
  \emph{Interpretable and explainable machine learning: a methods-centric overview\\ with concrete examples}\\
  R. Marcinkevi\v cs and J.E. Vogt (2023)
\end{book}
\emph{Explainable} AI refers to methods to interpret
(rationalize the decisions of) already trained black-box models:
feature importance, Shapley values, saliency maps, integrated gradients, global surrogate models, local surrogate models (LIME), counterfactuals, etc.

\emph{Interpretable} AI refers to models
interpretable by construction --
interpretability is provided by their ``inductive bias'':
\begin{compactitem}[--]
\item  Falling rule lists (with monotonic output as we move along the list);
\item Supersparse linear integer models (SLIM):
  linear regression, with integer coefficients (possibly with a sign constraint)
  and binary inputs --
  the objective function uses a 0-1 loss, an $\ell^0$ penalty,
  and a very small $\ell^1$ penalty (for the ties from the $\ell^0$ penalty);
  it is a MIP (after big-M transformation);
  you can approximate it with an integer-constrained lasso regression;
\item GAM, GA$^2$M (GAM with interactions), neural GAM,
  [GAM boosting];
\item Sparse input neural nets (group lasso penalty for the first layer weights, to select which features to use);
\item Knockoff features
  (replace $x_i$ with random data sampled from
  the distribution of $x_i | x_{\setminus i}$ (ignoring $y$)
  to see how much value it adds to the model of interest);
\item Varying coefficient models,
  self-explaining neural networks
  \[ f(x) = \theta(x) ^ \top x \qquad
  (\text{or } f(x) = \theta(x) ^ \top h(x)) \]
  there $\theta$ is almost constant
  \[ \nabla_x f(x) \approx \theta(x_0)
  \quad \text{if } x \text{ is close to } x_0 \]
  (and $\theta$ may depend on only a subset of the inputs)
\item Mixture of experts
  \begin{align*}
    & h_j(x) \text{: latent representation from expert } j \\
    & c_j(x) \text{: output from expert } j \\
    & u_j = \sigma \bigl(
    W_j \cdot [ h_1, c_1 , \dots , h_p, c_p ] + b_j
    \bigr) \\
    & a_j \propto \exp \langle u_j , \theta_j \rangle
    \text{ attention weights} \\
    & f(x) = \sum_j  a_j c_j(x) 
  \end{align*}
  with an \emph{auxiliary loss} to minimize the discrepancy
  between the prediction error if we remove $j$
  and the corresponding attention weight $a_j$;
\item Symbolic regression;
\item Interpretable representation learning. % ??? 
\end{compactitem}

\nextbook
\begin{book}
  \emph{Designing inherently interpretable\\ machine learning models}\\
  A. Sudjianto and A. Zhang (2021)
\end{book}
Checklist of qualitative characteristics an interpretable model should have:
additivity, sparsity, linearity, smoothness, monotonicity, visualizability,
projection (sparse or near-orthogonal projections are more interpretable),
segmentation (models with few ``segments'' are more interpretable).

\nextbook
\begin{book}
  \emph{GAMI-Net: an explainable neural network based on generalized additive models\\ with structured interactions}\\
  Z. Yang et al.
\end{book}
GA$^2$M,
\[ y \approx \sum_i g_i(x) + \sum_{ij} g_{ij}( x_i, x_j )
\]
with neural networks,
sparsity penalty, and ``marginal clarity'' penalty
($g_i \indep g_{ij}$).

\nextbook
\begin{book}
  \emph{Granger-causal attentive mixtures of experts:
  learning important features with neural nets}\\
  P. Schwab et al. (2019)
\end{book}
Define a GAM-VCM (variable coefficient model)
\[ f(x) = \sum_i w_i(x) h_i(x) \]
as follows:
\begin{compactitem}[--]
\item Transform each input feature $x_i$ in a nonlinear way
  into a forecast (``contribution'') $c_i$,
  with an MLP, with activations (latent representation) $h_i$
  \[
  \underset{\text{\scriptsize (scalar)}}{ x_i }
  \longmapsto
  \, h_i
  \,
  \longmapsto
  \underset{\text{\scriptsize (scalar)}}{ c_i }
  \]
\item Concatenate all the latent representations $h_i$ and forecasts $c_i$
  into a vector $h$;
\item For each ``expert'' $i$, compute a context vector $u_i$ from $h$,
  and compare it with a learned reference context
  $u_i^{\text{ref}}$, with a scalar product,
  $\langle u_i , u_i^{\text{ref}} \rangle$
\item Compute the corresponding weights with a softmax,
  \[ w_i \propto \langle u_i , u_i^{\text{ref}} \rangle \]
  (the paper has a different formula).
\end{compactitem}

To force those ``attention'' weights to reflect feature importance,
add a penalty, computed as follows:
\begin{compactitem}[--]
\item Train auxiliary predictors, using $h$ and $h_{\setminus i}$:
  $p(h)$, $p_i(h_{\setminus i})$;
  % That is a *large* number of auxiliary models...
\item Compute their error
  \begin{align*}
    \epsilon &= \text{loss} \bigl( y, p(h) \bigr) \\
    \epsilon_i &= \text{loss} \bigl( y, p_i(h_{\setminus i}) \bigr) \\
    \Delta \epsilon_i &= \epsilon_i - \epsilon \geq 0
    ;
  \end{align*}
\item Compare those errors with the attention weights
  \begin{align*}
    \omega_i &= \dfrac{ \Delta \epsilon_i }{ \sum_j \Delta \epsilon_j } \\
    \text{KL}( \omega \| w ) &= \sum \omega_i \log \dfrac{ \omega_i }{ w_i }
  \end{align*}
  ($w_i$ depends on the sample, $\omega_i$ does not: average over all samples).
\end{compactitem}
There is no penalty to make $w$ slow-moving.

\nextbook
\begin{book}
  \emph{Self-explaining neural networks}\\
  D. Alvarez-Melis and T.S. Jaakola
\end{book}
Variable coefficient models (VCM) are of the form
\[ f(x) = \sum_i \theta_i(x) x_i \]
where the $\theta_i$'s are slow-moving functions
(often, of a subset of the $x_i$'s).
They can be generalized to
\[ f(x) = \sum_i \theta_i(x) h_i(x) \]
where $h$ is a (low-dimensional) representation of the data
(e.g., from an auto-encoder).
If $\theta$ is almost constant,
\begin{align*}
  \nabla_x f
  &= \theta(x) ^\top \nabla_x h + \nabla_x \theta^\top h(x) \\
  &\approx \theta(x) ^\top \nabla_x h;
\end{align*}
the model can be trained by adding a penalty
$\n{ \nabla_x f - \theta(x)^\top \nabla_x h }$.

