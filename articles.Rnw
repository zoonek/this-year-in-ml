\]

Implementation in \texttt{faiss}.

\nextbook
\begin{book}
  \emph{Double descent demystified:\\ identifying, interpreting and ablating\\ the sources of a deep learning puzzle}\\
  R. Schaeffer et al.
\end{book}
Double decent for linear regression suggests the phenomenon requires:
\begin{compactitem}[--]
\item Small but nonzero singular values in the training data features;
\item The test data varies in different directions from the training data
  (it is not in the span of the first singular values);
\item The best model possible makes errors on the training data
  (the training data is noisy).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Multiple descent:\\ design your own generalization curve}\\
  L. Chen et al.
\end{book}
% Double descent can get more complicated: triple descent, etc.

\nextbook
\begin{book}
  \emph{Lost in the middle:\\ how language models use long contexts}\\
  N.F. Liu et al.
\end{book}
LLMs struggle to use information in the middle of their context:
performance is higher when relevant information is at the begining or end --
models with a smaller context perform better.

\nextbook
\begin{book}
  \emph{Path neural networks:\\ expressive and accurate graph neural networks}\\
  G. Micher et al. (2023)
\end{book}
Do not aggregate just neighbours, but paths:
\begin{compactitem}[--]
\item Single shortest paths;
\item All shortest paths;
\item All single paths of length up to $k$.
\end{compactitem}
Use recurrent layers to encode paths into vectors.

\nextbook
\begin{book}
  \emph{Leveraging label non-uniformity for node classification in graph neural networks}\\
  F. Ji et al. (2023)
\end{book}
Train a GNN for node classification and compute,
for each node $v$,
its label non-uniformity
\[ w(v) = \n{ \mu_v - \tfrac1n \mathbf 1 }_1, \]
where $\mu_v$ is the label distribution for $v$ from the model.
Nodes with low $w$ are close to class boundaries.
To improve model performance,
\begin{compactitem}[--]
\item Add nodes with low $w$ to the training set,
  with their \emph{predicted} labels, and retrain;
\item Pick a proportion $\eta_1$ of nodes with the smallest $w$;
  build a spanning tree on them;
  drop a proportion $\eta_2$ of edges
  (between those nodes) not in that tree (to preserve connectivity)
  and re-train.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Graph positional encoding\\ via random feature propagation}\\
  M. Eliasof et al. (2023)
\end{book}
Adding node features from the first power iterations
combines the advantages of random features
(before the first iteration) and spectral positional encoding
(limit of the power iterations).

\nextbook
\begin{book}
  \emph{Towards deep attention in graph neural networks: problems and remedies}\\
  S.Y. Lee et al. (2023)
\end{book}
GATv2 learns edge attention $\smash{ \alpha_{ij}^{(k)} } \in (0,1)$,
and suffers from over-smoothing;
DAGCN leanrs $\alpha_{ij}^{(k)} \in (-1,1)$ and does not.

\nextbook
\begin{book}
  \emph{Understanding convolutions\\ on graphs via energies}\\
  F. Di Giovanno et al.
\end{book}
The Dirichlet energy is
\begin{align*}
  \mathscr E(F) &= \dfrac12 \sum_{ ij \in E } \n{ ( \nabla F )_{ij} } ^ 2 \\
  (\nabla F)_{ij} &= \dfrac{ f_j }{ \sqrt{ d_j } } - \dfrac{ f_i }{ \sqrt{ d_i } }.
\end{align*}
It can be generalized to
\begin{align*}
  \mathscr E _\theta(F) &=
  \sum_i \langle f_i,  \Omega fi \rangle -
  \sum_{ij} A_{ij} \langle f_i W f_j \rangle +
  \phi\bigl( F , F(0) \bigr) \\
  &=
  \sum_i \langle f_i , (\Omega - W ) fi \rangle + {}\\
  &\hphantom{={}}
  \dfrac12 \sum_{ij} \n{ \Theta_+ ( \nabla F )_{ij} } ^ 2 
  - \dfrac12 \sum_{ij} \n{ \Theta_- ( \nabla F )_{ij} } ^ 2 + \\
  &\hphantom{{}={}}  
  \phi\bigl( F , F(0) \bigr) \\
  W &= \Theta_+ ' \Theta_+ - \Theta_- ' \Theta_-.
\end{align*}
Graph convolutions do not necessarily oversmooth the data:
the negative eigenvalues of $W$ can provide over-sharpening.

\nextbook
\begin{book}
  \emph{Node embedding from neural Hamiltonian orbits in graph neural networks}\\
  Q. Kang et al. (2023)
\end{book}
Graphs are not flat: embedding them in hyperbolic space preserves more information.
Their \emph{Gromov $\delta$-hyperbolicity distributions}
show they do not have constant curvature.
Do not embed the nodes in a constant negative curvature space:
embed them in $(\RR^d,g)$, where the metric $g$ is learned.

The \emph{Hamiltonian GNN}
\begin{compactitem}[--]
\item Learns an embedding
  $(q_n^{(0)}, p_n^{(0)}) \in \RR^{2d}$
  for each node~$n$;
\item Learns a metric $g_{ij}$ on $\RR^d$
  (with inverse $g^{ij}$);
\item Moves those embeddings along the Hamiltonian flow
  \begin{align*}
    H(p,q) &= \dfrac12 g^{ij} (q) p_i p_j \\
    \dot q_i &= g^{ij} p_j \\
    \dot p_i &= - \dfrac12 \partial_i g^{jk} p_j p_k \\
    \bigl( q_n^{(0)}(0), p_n^{(0)}(0) \bigr)
    &\rightsquigarrow
    \bigl( q_n^{(0)}(T), p_n^{(0)}(T) \bigr) 
  \end{align*}
\item Aggregates the resulting embeddings
  \[ q_n^{(1)} = q_n^{(0)}(T) + \operatorname*{Mean}_{ m \in \mathscr N (n) } q_m^{(0)}(T) \]
  (the momentum of the next layer, $p_n^{(1)}$ is learned --
  it does not come from $p_n^{(0)}(T)$);
\end{compactitem}

The Gromov $\delta$-hyperbolicity of a graph $G$ is
\[ \max_{\substack{
    a,b,c,d \in V \\
    d(a,b) + d(c,b) \geq \\
    d(a,c) + d(b,d) \geq \\
    d(a,d) + d(b,c)
}}
\bigl[ d(a,b) + d(d,c) \bigr] -
\bigl[ d(a,c) + d(b,d) \bigr] 
\]

Implementation
(slightly more efficient than the naive $O(n^4)$)
in
\texttt{sage.graphs.hyperbolicity.*}.
  
\nextbook
\begin{book}
  \emph{Can large language models\\ reason about program invariants}\\
  K. Pei et al. (2023)
\end{book}
Alternative to dynamic analysis tools
(e.g., Daikon, for Java, which needs access to several program traces).

\nextbook
\begin{book}
  \emph{Data representations' study\\ of latent image manifolds}\\
  I. Kaufman and O. Azencot (2023)
\end{book}
To assess the geometry of latent representations learned by a neural net:
\begin{compactitem}[--]
\item Compute its intrinsic dimension;
\item Augment the data around
  one of the training samples,
  to have a dense neighbourhood:
  for image data,
  consider the image as a width$\times$height matrix
  (separately for each channel),
  compute its SVD,
  and remove some of the 10 smallest singular values -- this produces
  $2^{10}$ points;
\item Compute the mean absolute principal curvature (MAPC).
\end{compactitem}
The curvature increases sharply in the first few layers,
then plateaus, and (only in well-trained networks)
increases again in the last layers.

\nextbook
\begin{book}
  \emph{Intrinsic dimension of data represetations\\ in deep neural networks}\\
  A. Ansuini et al.
\end{book}
To measure the \emph{intrinsic dimension} (ID)
of a cloud of points,
fit a Pareto distribution to the ratios
$\mu_i = r_i^{(2)} / r_i^{(1)}$,
where $r_i^{(1)}$ and $r_i^{(2)}$ are the distances between a point $i$
and its first and second nearest neighbours.
\begin{align*}
  p(\mu_i) &= d \cdot \mu_i ^ { - (d+1) } \\
  p(\mu)  &= d ^N \prod_{ 1 \leq i \leq N } \mu_i ^{ - (d+1) }
\end{align*}
It is robust, even if the points are not really sampled uniformly,
provided $d \leq 20$ -- otherwise it underestimates the dimension.
Measure it at different scales (by decimating the data)
to check if it is scale-invariant.

The ID of the latent representations in trained neural nets are much lower
(10 to 100 times) than the number of neurons;
it increases sharply in the first layers,
then decreases slowly (``hunchback'' shape).
The ID of the last layer is a good predictor of performance (lower is better).

The data manifolds are not flat: they cannot be recovered by linear projections.

\nextbook
\begin{book}
  \emph{Estimating the intrinsic dimension of datasets by a minimal neighbourhood information}\\
  E. Facco et al.
\end{book}
Since $F_{\text{Pareto}}(\mu) = ( 1 - \mu^{-d} ) \mathbf 1 _{ [ \mu \geq 1 ] }$,
the intrinsic dimension can also be estimated with an (intercept-free)
linear regression
\[ \dfrac{ \log \bigl[ 1 - F(u) \bigr] }{ \log \mu } = d. \]

\nextbook
\begin{book}
  \emph{Curvature-aware manifold learning}\\
  Y. Li  (2017)
\end{book}
% CAML
To estimate the curvature of a set of points:
\begin{compactitem}[--]
\item Compute its intrinsic dimension; 
\item Take a neighbourhood of the point of interest
  (100 times as many points as the dimension);
\item Use PCA to find local coordinates; 
\item Compute a quadratic approximation of the chart of the manifold
  in those coordinates; 
\item The eigenvaues of the Hessian of that quadratic approximation are the
  \emph{principal curvatures};
\item The mean absolute principal curvature (MAPC) is the average of their absolute values
  (this is an extrinsic notion of curvature,
  for submanifolds of a Riemannian manifold).
\end{compactitem}
% There are too many notions of curvature...
LLE (local linear embedding) can be generalized to account for (intrinsic) curvature.

\nextbook
\begin{book}
  \emph{Dink-Net: Neural clustering on large graphs}\\
  Y. Liu et al. (2023)
\end{book}
% Broken English
Learn node embeddings with a contrastive loss,
and cluster the nodes, with a ``shrinking'' loss
bringing the node representations close to the cluster centers,
and a ``dilation'' loss
keeping the centers apart, end-to-end.

\nextbook
\begin{book}
  \emph{Dirichlet diffusion score model\\ for biological sequence generation}\\
  P. Avdeyev (2023)
\end{book}
Diffusion process on the probability simplex to generate discrete sequences
(sudoku puzzles, sudoku solutions, DNA sequences).
Jacobi diffusion
\[ dx = \dfrac s2 \bigl[
  a(1-x) - bx 
  \bigr] dt + \sqrt{ s x (1-x) } dW \]
has Beta$(a,b)$ as stationary distribution.
This can be generalized to a diffusion with a Dirichlet stationary distribution
(stick-breaking construction with $k-1$ Jacobi diffusions).

\nextbook
\begin{book}
  \emph{Conformal inference is (almost) free for neural networks trained with early stopping}\\
  Z. Liang et al. (2023)
\end{book}
Conformal inference for models selected by early stopping requires a 3-way split of the data:
\begin{compactitem}[--]
\item To train the models; 
\item To decide when to stop;
\item For conformal inference.
\end{compactitem}
It is possible to use only two subsets,
by storing all (or 100) the models,
delaying the model selection,
and chosing one, anew, for each new observation.

\nextbook
\begin{book}
  \emph{Why random pruning is all we need\\ to start sparse}\\
  A. Gadhikar et a. (2023)
\end{book}
Randomly pruned (Erd\"os-R\'enyi) neural networks contain a lottery ticket.

\nextbook
\begin{book}
  \emph{Synthetic data for model selection}\\
  A. Shishan et al.
\end{book}
Synthetic data is often used for data augmentation (StyleGAN, GAN-GP).
You can also use it instead of the validation set,
for model selection (early stopping,
random seed choice, hyperparameter optimization).
Reweight the synthetic dataset using a holdout set of classifiers.

\nextbook
\begin{book}
  \emph{Large language models as optimizers}\\
  C.  Yang et al.
\end{book}
Ask an LLM to generate a prompt template for the problem you want to solve --
not just once, but iteratively,
each time providing the previous prompts and their performance,
to progressively improve it.

Ask for several prompts, each time, for more exploration.
Change the LLM sampling temperature to tune the exploration-exploitation tradeoff.

Applications include linear regression, traveling salesman problem,
reasoning (GSM8k, BigBenchHard: arithmetic, commonsense).

\nextbook
\begin{book}
  \emph{Scaling transformer to 1M tokens\\ and beyond with RMT}\\
  A. Bulatov et al.
\end{book}
To increase the context length of a transformer,
split the input into segments, and concatenate the latent
representation of segment $i-1$ to segment $i$.
\[
\begin{tikzpicture}[>=stealth,xscale=2.5,yscale=.8,inner sep=1pt,outer sep=0pt,baseline=0]
  \node (s1) at (0,0) {segment 1};
  \node (s2) at (1,0) {segment 2};
  \node (s3) at (2,0) {segment 3};
  \node[draw,inner sep = 3pt] (t1) at (0,1) {transformer};
  \node[draw,inner sep = 3pt] (t2) at (1,1) {transformer};
  \node[draw,inner sep = 3pt] (t3) at (2,1) {transformer};
  \draw[->] (s1) -- (t1);
  \draw[->] (s2) -- (t2);
  \draw[->] (s3) -- (t3);
  \draw[->] (t1) |- (.5,1.6)  -- (.5,.4)  -| ([xshift=-6pt]t2.south);
  \draw[->] (t2) |- (1.5,1.6) -- (1.5,.4) -| ([xshift=-6pt]t3.south);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Recurrent memory transformer}\\
  A. Bulatov et al.
\end{book}

\nextbook
\begin{book}
  \emph{RWKV: reinventing RNNs\\ for the transformer era}\\
  A. Albalak et al.
\end{book}
Time mixing
\begin{align*}
  r_t &= W \bigl[ \mu x_t + ( 1-\mu) x_{t-1} \bigr] \\
  k_t &= W \bigl[ \mu x_t + ( 1-\mu) x_{t-1} \bigr] \\
  v_t &= W \bigl[ \mu x_t + ( 1-\mu) x_{t-1} \bigr] \\
  w_t &= \dfrac{ \displaystyle
    \sum_{ i < t } e^{ - (t - 1 - i) w + k_i } v_i + e^{ u + k_t } v_t
  }{ \displaystyle
    \sum_{ i < t } e^{ - (t - 1 - i) w + k_i }     + e^{ u + k_t }
  } \\
  o_t &= W \bigl[ \sigma(r_t) \odot w_t \bigr]
\end{align*}
followed by channel mixing
\begin{align*}
  r_t &= W \bigl[ \mu x_t + ( 1-\mu) x_{t-1} \bigr] \\
  k_t &= W \bigl[ \mu x_t + ( 1-\mu) x_{t-1} \bigr] \\
  o_t &= \sigma(r_t) \odot \bigl[ W \max(k_t,0)^2 \bigr]. \\
\end{align*}
% There is a different $\mu$ and $W$ in each equation: I have removed the indices to de-clutter the formulas.

\nextbook
\begin{book}
  \emph{Precise zero-shot dense retrieval\\ without relevance labels}\\
  L. Gao et al. 
\end{book}
Instead of computing the similarity between a query and the documents in the database,
HyDE (hypothetical document embeddings) asks an LLM to produce a hypothetical
(potentially hallucinated) document answering the query, and retrieve the (actual)
documents most similar to the hypothetical document.

\nextbook
\begin{book}
  \emph{Pysentimiento: a Python toolkit\\ for sentiment analysis and social NLP tasks}\\
  J.M. P\'erez et al.
\end{book}
Transformer-based models (RoBERTa) for sentiment and emotion detection,
for en, es, it, pt.

\nextbook
\begin{book}
  \emph{Visualizing graph neural networks\\ with CorGIE: corresponding a graph\\ to its embedding}\\
  Z. Liu et al.
\end{book}
To assess the quality of the node embeddings learned by a GNN,
compare the distance matrices of:
\begin{compactitem}[--]
\item The latent representations (node embeddings), using the cosine distance; 
\item The graph, with the inverse Jaccard index of the $k$-hop neighbours;
\item The node features, with the Euclidean distance.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Supervised probabilistic\\ principal component analysis}\\
\end{book}
Probabilistic PCA (PPCA) estimates the parameters of the data generation process
\begin{align*}
  z &\sim N(0,I) && \text{latent} \\
  \epsilon &\sim N(0, \sigma^2 I ) \\
  x &= W z + \epsilon && \text{observed}
\end{align*}
Supervised probabilistic PCA (SPPCA) adds another observed variable.
\begin{align*}
  z &\sim N(0,I) && \text{latent} \\
  \epsilon &\sim N(0, \sigma_1^2 I ) \\
  \eta &\sim N(0, \sigma_2^2 I ) \\
  x &= W_1 z + \epsilon && \text{observed}
  y &= W_2 z + \eta && \text{observed}
\end{align*}
It can be estimated with EM.
% Implemented

