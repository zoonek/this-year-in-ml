\draw[->] ([yshift=+3pt]y.east) -- node[anchor=south,pos=.2] {\footnotesize $c$} ([yshift=+3pt]z.west);
\draw[->,decorate, decoration={snake, pre length=2pt, post length=2pt}] (x) to[out=-45, in=-135, looseness=1]  node[anchor=north east,pos=.1] {\footnotesize $b$} (z);
\end{tikzpicture}
\]
\begin{align*}
  & P(a|x,y) > P(b|x,y) && \text{more direct path} \\
  & P(c|y,z) = \pi(c|y) && \text{any action will do}
\end{align*}

\nextbook
\begin{book}
  \emph{Weight-agnostic neural networks}\\
  A. Gaier and D. Ha
  (NeurIPS 2019)
\end{book}
Look for neural network architectures that work well without training.

To simplify the search, use a shared weight (yes, only one parameter: all the weights of all the layers are the same), random.
Start with minimal networks of the form
\[
\begin{tikzpicture}[>=stealth,xscale=.7,yscale=.3,inner sep=2pt, outer sep=1pt]
  \node[circle,draw,thick] (A1) at (0,3) {};
  \node[circle,draw,thick] (A2) at (0,2) {};
  \node[circle,draw,thick] (A3) at (0,1) {};
  \node[circle,draw,thick] (A4) at (0,0) {};
  \node[circle,draw,thick] (B)  at (1,1.5) {};
  \draw[thick] (A1) -- (B);
  \draw[thick] (A3) -- (B);
\end{tikzpicture}
\]
and modify them by inserting nodes, adding connections, or changing activation functions.

The performance is decent on reinforcement learning problems, competitive with SOTA models after training, for much smaller networks.

Those architectures contain implicit priors.

\nextbook
\begin{book}
  \emph{Asymmetric valleys:\\ beyond sharp and flat local minima}\\
  H. He et al.
  (NeurIPS 2019)
\end{book}
According to popular belief, flat minima generalize better.
But the loss landscape could be flat in some directions and sharp in others.

\[
\begin{tikzpicture}[>=stealth,xscale=.8,yscale=.8,inner sep=1pt, outer sep=1pt]
  \draw (-1,0) -- (1,0);
  \draw[ultra thick] (-.5,1) -- (0,0) -- (1,.5);
  \draw[dotted] (0,0) -- (0,1);
  \node[anchor=north] at (-.5,0) {\footnotesize sharp};
  \node[anchor=north] at (+.5,0) {\footnotesize flat};
\end{tikzpicture}
\]

Prefer solutions biased towards the flat side -- they generalize better;
they can be obtained by averaging the solutions on the SGD path.

\nextbook
\begin{book}
  \emph{UniXGrad: a universal, adaptive algorithm with optimal guarantees\\ for constrained optimization}\\
  A. Kavis et al.
  (NeurIPS 2019)
\end{book}

Gradient descent
\[ x_{n+1} = x_n - \alpha \nabla f (x_n) \]
could be replaced by an ``implicit'' step,
\[ {\color{blue!50!black}x_{n+1}} = x_n - \alpha\nabla f( {\color{blue!50!black}x_{n+1}} ) \]
which can be approximated with two explicit steps
\begin{align*}
  y_{n+1} &= x_n - \alpha \nabla f(x_n) \\
  x_{n+1} &= x_n - \alpha \nabla f(x_{n+1}).
\end{align*}
The \emph{MirrorProx} algorithm adds a generalized projection wrt a Bregman divergence.
\begin{align*}
  y_t &= \argmin_y \langle y , \nabla f x_{t-1} \rangle + \alpha D_R( y, x_{t-1} ) \\
  x_t &= \argmin_x \langle x , \nabla f y_t \rangle + \alpha D_R( x , x_{t-1} ) \\
  D_R(x,y) &= Rx - Ry - \langle \nabla R y , x - y \rangle \\
  R(x) &= \dfrac12 \n x ^2
\end{align*}
The UniXGrad algorithm evaluates the gradients
$\nabla f x_{t-1}$ and $\nabla f y_t$
at weighted averages $\bar x_{t-1}$ and $\bar y_t$ of the previous points
$y_1,\dots,y_{t-1}, x_{t-1}$ and $y_1,\dots,y_t$.
and uses an adaptive learning rate,
defined with the sum of the gradient differences
$\n{ \nabla f \bar x_{t-1} - \nabla f \bar y_t } ^2$.

\nextbook
\begin{book}
  \emph{Sinkhorn barycenters with free support\\ via Frank-Wolfe algorithm}\\
  G. Luise et al.
  (NeurIPS 2019)
\end{book}
To compute the average between probability distributions
(for the Sinkhorn divergence, \ie, entropic optimal transport),
assume
$a^* = \sum a_i \delta_{ x_i }$,
with the $x_i$'s fixed and estimate the $a_i$'s.
Instad, do not fix the $x_i$'s, but add them one by one, and do not re-estimate the previous coefficients.

\nextbook
\begin{book}
  \emph{Learning dynamic polynomial proofs}\\
  A. Fawzi et al.
  (NeurIPS 2019)
\end{book}
Given a polynomial $P$, prove that $\forall x \in [0,1]^n \ P(x) \geq 0$,
using a reinforcement learning agent,
trained with DQN, with unsupervised dense rewards, accounting for symmetries.

\nextbook
\begin{book}
  \emph{Generative modeling by estimating\\ gradients of the data distribution}\\
  Y. Song and S. Ermon
  (NeurIPS 2019)
\end{book}
Generative models are usually implicit, only providing a sampling procedure (e.g., GANs)
or explicit, directly modeling a probability distribution function (e.g., VAE), but these need to be normalized.
Instead, model the \emph{score function}
$\nabla_{\!x} \log p(x)$.
It can be estimated from data
(integration by parts, score matching).
\begin{align*}
  \text{Fisher divergence} &= \tfrac12 \E_{ x \sim \text{data} } \n{ \nabla_{\!x} \log p_{\text{data}}(x) - s_\theta(x) } \\
  &= \E_{ x \sim \text{data} }\left[
    \tfrac12 \n{ s_\theta(x) }_2^2 + \tr \nabla_{\!_x} s_{\theta}(x) 
  \right]
\end{align*}
It is necessary to add some noise:
\begin{compactitem}[--]
\item At least a very small amount, because the data lies on a low-dimensional manifold (or, even, is discrete), to help convergence;
\item A larger amount of noise to have a better estimate of the score in low-density regions -- but this leads to noisy samples.
\end{compactitem}
The \emph{noise-conditional score network} trains a single model for all levels of noise (the level of noise is one of the inputs).
One can sample from a score function using \emph{Langevin dynamics};
progressively reduce the amount of noise while sampling (\emph{annealed Langevin dynamics}).

\nextbook
\begin{book}
  \emph{Implicit generation and modeling\\ with energy-based models}\\
  Y. Du and I. Mordatch
  (NeurIPS 2019)
\end{book}
Energy-based models (EBM)
\[ p_\theta(x) \propto \exp - E_\theta(x) \]
can be trained with contrastive divergence
\begin{align*}
  \mathscr L(\theta) &= \E_{ x \sim \text{data} } \bigl[ - \log p_\theta(x) \bigr] \\
  \nabla \mathscr L &= \E_{ x \sim \text{data} } \bigl[ \nabla E_\theta(x) \bigr] -
  \E_{ x \sim p_\theta } \bigl[ \nabla E_\theta(x) \bigr]
\end{align*}
and sampled from with Langevin dynamics.

\nextbook
\begin{book}
  \emph{Residual flows\\ for invertible generative modeling}\\
  R.T.Q. Chen et al.
  (NeurIPS 2019)
\end{book}
The \emph{invertible ResNet} $f : x \mapsto x + g(x)$ is invertible
if $g$ has Lipschitz constant less than 1
(enforced by spectral normalization)
and its inverse can be computed by fixed point iterations.
To compute
\[ \log \va{ \det \nabla_{\!x} f } = \sum \dfrac{ (-1)^k }{ k } \tr J_g(x)^k, \]
use the \d{Russian roulette estimator}
which replaces the infinite sum with an unbiased estimator,
computed as a weighted sum of a random number of terms.

The \emph{lipswish} activation is Lipschitz.
\begin{align*}
  \text{swish}(x) &= x \cdot \text{sigmoid}(x) \\
  \text{lipswish}(x) &= \text{swish}(x) / 1.1
\end{align*}

\nextbook
\begin{book}
  \emph{Hype: a benchmark for human eye perceptual evaluation of generative models}\\
  S. Zhou et al.
  (NeurIPS 2019)
\end{book}
Use crowdsourcing to evaluate the quality of a generative model,
by measuring the time needed by humans to decide if an image is real or fake,
either by showing the image for a limited amount of time,
progressively increased or decreased depending on performance
(``adaptive staircase procedure'', from psychometrics)
or by letting the user choose how long they need.
It costs \$60 and takes 60 minutes per model.
It was tested on 
WGAN-GP, ProGAN, SN-GAN, BEGAN, BigGAN.

\nextbook
\begin{book}
  \emph{Adaptive density estimation\\ for generative models}\\
  T. Lucas et al.
  (NeurIPS 2019)
\end{book}

