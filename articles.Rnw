\nextbook
\begin{book}
  \emph{Beyond vector spaces:\\ compact data representation\\ as differentiable weighted graphs}\\
  D. Mazur et al. (2019)
\end{book}
To account for arbitrary geometries,
embed your data in a graph rather than a vector space [PyTorch implementation available].
\begin{align*}
  & \rlap{\ensuremath{ p_\theta(i,j) }} \qquad\qquad \text{edge probability} \\
  & \rlap{\ensuremath{ w_\theta(i,j) }} \qquad\qquad \text{edge weight} \\
  & d(i,j) = \min_{ \pi : i \to j } \sum _{ e \in \pi } w_\theta(e) \\
  & \text{Loss} = \E_{ G \sim p_\theta } L(G) + \dfrac1{ \va E } \sum_{ij} p_\theta(i,j) 
\end{align*}
(use the ``log-derivative trick'' (\textsc{reinforce}) for the gradient).
After optimization, the edge probabilities are close to 0 or 1:
discard all those below 0.5 to have a sparser graph.
Examples include generalization of MDS (or Poincar\'e MDS) and collaborative filtering.
\begin{align*}
  L(G) &= \bigl( \n{ x_i - x_j } - d(i,j) \bigr) ^ 2 \\
  L(G) &= \biggl[ 1 + \dfrac{ e^{ - d(u_i, x^+) } }{ e^{ - d(u_i, x^-) } } \biggr]^{-1}
\end{align*}

\nextbook
\begin{book}
  \emph{Embedding words in non-vector spaces\\ with unsupervised graph learning}\\
  M. Ryabinin et al. (2020)
\end{book}
Embedding words (GloVe) in Euclidean or hyperbolic space (constant curvature)
assumes the geometry of the space is the same everywhere:
instead, use a graph embedding.

\nextbook
\begin{book}
  \emph{Poincar\'e GloVe: hyperbolic word embedding}\\
  A. Tifrea et al. (2019)
\end{book}
The \emph{Gromov $\delta$-hyperbolicity}
measures how tree-like (hyperbolic) a metric space is:
it is half (the average of) the difference between the biggest two of
$d(x,y)+d(z,t)$,
$d(x,z)+d(y,t)$,
$d(x,t)+d(y,z)$
(normalize it by dividing by the average distance;
hyperbolic spaces have lower values).

Words can be embedded as Gaussian distributions --
but the space of Gaussian distributions is hyperbolic --
the space of diagonal Gaussians is isometric to a product of Poincar\'e half planes
$( \HH^2 )^n$.
 
\nextbook
\begin{book}
  \emph{Gradient estimation\\ with stochastic softmax tricks}\\
  M.B. Paulus et al. (2020)
\end{book}
Sampling from a discrete distribution
\begin{align*}
  U &\sim U(0,1) \\
  i &= \max \{ i \ :\ p_1 + \cdots + p_{i-1} \leq U \} \\
  Z &= \text{onehot}(i)
\end{align*}
can be parametrized with a Gumbel distribution
\begin{align*}
  G_i &\sim \text{Gumbel}(0,1) \\
  i &= \argmax ( G_i + \log p_i ) \\
  Z &= \text{onehot}(i)
\end{align*}
and relaxed (\emph{Gumbel softmax})
\begin{align*}
  G_i &\sim \text{Gumbel}(0,1) \\
  X_i &= G_i + \log p_i \\
  Z &= \text{softmax}(X).
\end{align*}
The ``reparametrization trick''
is used to differentiate wrt the parameters of a discrete distribution
(in the backward pass -- in the forward pass, you may still use discrete distributions).
It can also be written
\begin{align*}
  Z &= \argmax_{ x \in \operatorname{conv} \mathscr X} U' x - t f(x)  \\
  U &\sim \text{Gumbel} \\
  \mathscr X &= \Delta_n \\
  f(x) &= \sum x_i \log x_i \\
  t &\text{: temperature}
\end{align*}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{Deep Bayes 2019}\\
\end{book}

%% Introduction
\textbf{1.}
Frequentist and Bayesian approaches do not disagree: 
maximum likelihood only provides asymptotic guarantees, and is asymptotically equivalent to the Bayesian approach.

Frequentist and Bayesian approaches use probabilities to encode different types of randomness.
The frequentist approach assumes randomness in the data generation process -- 
even though there is rarely any actual physical (e.g., quantum) randomness, 
just complex, chaotic phenomena that look random.
The Bayesian approach uses probability theory to model uncertainty.

\begin{center}
\begin{tabular}{lll}
Likelihood & Parameters & Conjugate prior \\
\hline
Gaussian & $\mu$ & Gaussian \\
& $\sigma^{-2}$ & Gamma \\
& $(\mu, \sigma^{-2})$ & Gaussian-Gamma \\
& $\Sigma^{-1}$ & Wishart \\
Bernoulli & $p$ & Beta \\
Multinomial & $(p_1,\dots,p_m)$ & Dirichlet \\
Poisson & $\lambda$ &  Gamma \\
Uniform & $\theta$ & Pareto
\end{tabular}
\end{center}

%% Variational inference
\textbf{2.}
The posterior distribution $p(\theta|x)$ is often intractable: 
\d{variational inference} replaces it with a simpler distribution $q(\theta)$,
as close as possible for the (mode-seeking) Kullback-Leibler divergence.
\begin{align*}
  q &= \argmax_q \text{KL}\bigl( q(\theta) \bigm\| p(\theta|x) \bigr) \\
  \text{KL}(q \| p) &= \int \log \dfrac{ q(\theta) }{ p(\theta) } q(\theta) d\theta
\end{align*}
Since the posterior is intractable, so seems the KL divergence.

% TODO: PLOT (mode-seeking behaviour)

However, the \emph{evidence} $p(x)$ can be decomposed as  
\begin{align*}
  \log p(x)
  &= \int \log p(x) q(\theta) d\theta \\
  &= \int \log \dfrac{ p(x,\theta) }{ p(\theta|x) } q(\theta) d\theta \\
  &= \int \log \left(
  \dfrac{ p(x,\theta) }{ p(\theta|x) } \dfrac{ q(\theta) }{ q(\theta) }
  \right)
  q(\theta) d\theta \\
  &= \int \log \dfrac{ p(x,\theta) }{ q(\theta) } q(\theta) d\theta +
     \int \log \dfrac{ q(\theta) }{ p(\theta|x) } q(\theta) d\theta \\
  &= \mathscr L \bigl( q(\theta) \bigr) + \text{KL} \bigl( q(\theta) \bigm\| p(\theta|x) \bigr ).
\end{align*}
Since the lhs does not depend on $q$,
to minimize the KL divergence, it suffices to maximize the \d{evidence lower bound} (ELBO)
$\mathscr L \bigl( q(\theta) \bigr)$.

Note that, since $\text{KL} \geq 0$,
it is indeed a lower bound:
$\log p(x) \geq \mathscr L \bigl( q(\theta) \bigr)$.

The ELBO can be decomposed as
\begin{align*}
  \mathscr L \bigl( q(\theta) \bigr)
  &= \int \log \dfrac{ p(x,\theta) }{ q(\theta) } q(\theta) d\theta \\
  &= \E_{ \theta \sim q } \bigl[ \log p(x|\theta) \bigr] -
  \text{KL} \bigl( q(\theta) \bigm\| p(\theta) \bigr).
\end{align*}
The first term, the expected log-likelihood,
is maximum if $q = \delta_{ \hat \theta_{\text{MLE}} }$;
the second term, the KL divergence with the prior $p(\theta)$, is minimum if $q=p$,
and acts as a regularizer.
This decomposition is similar to the Bayes formula:
\begin{align*}
  \text{Posterior} &\propto \text{likelihood} \times \text{prior} \\
  \text{ELBO} &= \text{data term} + \text{regularizer}.
\end{align*}

The \emph{mean-field approximation} constrains $q$ to be of the form
$q(\theta) = \prod_i q_i(\theta_i)$.
\emph{Block coordinate descent}
updates the estimate of $q_j$ while keeping the other $q_i$'s fixed.
\begin{align*}
  \mathscr L \bigl( q(\theta) \bigr) &=
  \int \log \dfrac{ p(x,\theta) }{ q(\theta) } q(\theta) d\theta \\
  &= \E_{ \theta \sim q } \log p(x, \theta ) -
  \E_{ \theta \sim q } \log q(\theta) \\
  \E_{ \theta \sim q } \log p(x, \theta ) &=
  \E_{ \theta_j \sim q_j} \E_{\substack{ \theta_i \sim q_i \\ i \neq j }} \log p(x,\theta) \\
  \E_{ \theta \sim q } \log q(\theta) &=
  \sum_i \E_{ \theta_i \sim q_i }  \log q_i(\theta_i) \\
  &= \E_{ \theta_j \sim q_j } \log q_j(\theta_j) + \text{const} \\
  \mathscr L \bigl( q(\theta) \bigr) &=
  \E_{ \theta_j \sim q_j }
  \biggl[
  \E_{\substack{ \theta_i \sim q_i \\ i \neq j }} \log p(x,\theta) -
  \log q_j(\theta_j)
  \biggr] + \text{const} \\
  &= 
  \E_{ \theta_j \sim q_j }
  \bigl[
  \log r_j(\theta_j) - \log q_j(\theta_j)
  \bigr] + \text{const} \\
  &= - \text{KL} \bigl( q_j(\theta_j) \bigm\| r_j(\theta_j) \bigr) + \text{cont}
\end{align*}
This is maximum for $q_j = r_j$;
it can be computed if prior and likelihood are conditionally conjugate, \ie,
when
$p(\theta_j| \theta_{i\neq j}$ and
$p(\theta_j| x, \theta_{i\neq j}$ are in the same family.

\textbf{3.}
To estimate a mixture of Gaussians
\begin{align*}
  Z_i &\sim \text{Categorical}( \pi_1, \dots, \pi_k ) \\
  X_i &\sim N( \mu_{z_i}, \sigma^2_{z_i} ) \\
  \theta_j &= ( \mu_j, \sigma_j^2 ),
\end{align*}
use the evidence decomposition
\begin{align*}
  \log p(X | \theta ) &=
  \int \log \dfrac{ p( X, Z | \theta ) }{ q(Z) } q(Z) dZ + {} \\
  &\hphantom{={}}
  \int \log \dfrac{ q(Z) }{ p(Z,|X,\theta) } q(Z) dZ \\
  &= \mathscr L(q,\theta) +
  \text{KL}\bigl( q(Z) \bigm\| p(Z|X,\theta) \bigr) \\
  &\geq \mathscr L(q,\theta)
\end{align*}
Insead of maximizing $p(X|\theta)$,
maximize $\mathscr L(q, \theta)$, wrt $q$ and $\theta$.
The \emph{EM algorithm} is the block-coordinate ascent algorithm to maximize $\mathscr L$.
\begin{align*}
  & \text{E step} &
  q &= \argmax_ q \mathscr L(q, \theta) \\
  && &= \argmin_q \text{KL} \bigl( q(Z) \bigm\| p(Z|X,\theta) \bigr) \\
  && &= p(Z|X,\theta) \\
  & \text{M step} &
  \theta &= \argmax_\theta \mathscr L(q,\theta ) \\
  && &= \argmax_\theta \E_{ Z \sim q } \log p(X, Z | \theta )
\end{align*}

If $Z$ is discrete, this is tractable.
\begin{align*}
  q(Z_i = k) &= \dfrac{
    p(x_i | Z_i = k, \theta) p(Z_i = k | \theta )
  }{
    \sum\limits_\ell p( x_i | Z_i = \ell, \theta ) p(Z_i = \ell | \theta )
  } \\
  \theta &= \argmax_\theta
  \sum_i \sum_k
  q(Z=k) \log p( x_i, Z=k | \theta )
\end{align*}

\emph{Variational EM} uses variational inference in the E step.

A \emph{variational lower bound} $g$ of $f$ satisfies
\begin{align*}
  & \forall x \ \forall \xi \ f(x) \geq g(\xi,x) \\
  & \forall x \ \exists \xi \ f(x) = g(\xi,x) 
\end{align*}
The \emph{MM algorithm} iterates
\begin{align*}
  x &\leftarrow \argmax_x g(\xi,x) \\
  \xi &\leftarrow \argmax_\xi g(\xi,x)
\end{align*}

The \emph{Ada-gram} (adaptive skipgram) algorithm
extends the word2vec model by considering several embeddings for each word,
corresponding to different meanings.
Add a latent variable to select the meaning;
use a Dirichlet process to have an unbounded number of meanings per word.

\textbf{4.}
PCA is a latent variable model
\begin{align*}
  p(X,Z|\theta) &= \prod_i p(x_i | z_i, \theta) p(z_i | \theta) \\
  &= \prod_i N( x_i | V z_i + \mu, \sigma^2 I ) N( z_i | 0, I);
\end{align*}
it can be estimated with the EM algorithm,
generalized to \emph{mixture PCA}
\[
  p(X,Z,Y|\theta)  =
  \prod_i N( x_i | V_{t_i} z_i + \mu_{t_i}, \sigma_{t_i}^2 I ) N( z_i | 0, I) \pi_{t_i}
\]
or non-linear PCA
\begin{align*}
  p(X,Z|\theta) &= \prod_i p(x_i | z_i , \theta ) p(z_i | \theta ) \\
  &= \prod_i \biggl[
  \prod_j N( x_{ij} | \mu_j(z_j), \sigma_j^2(x_j) )
  \biggr]
  N( z_i | 0, I)
\end{align*}
(mean and variance of the factorized (diagonal) Gaussian are nonlinear functions
of the latent variables instead of linear or constant).

For the E step, we need $q(z) = \prod_i p(z_i | x_i, \theta)$,
which is intractable: use a variational approximation
\begin{align*}
  q( z_i |x_i, \phi ) &\approx p(z_i | x_i, \theta ) \\
  q( z_i  x_i, \phi ) &= \prod _j N\bigl( z_{ij} | \mu_j(xi) , \sigma_j^2(x_i) \bigr)
\end{align*}
where $\mu_j$ and $\sigma_j$ are other neural nets.
The ELBO
\[
\mathscr L(\phi, \theta) =
\int q(Z | X, \phi) \log \dfrac{
  p( X | Z, \theta ) p(Z) 
}{
  q(Z | X, \phi )
}
dZ
\]
is intractable:
\begin{compactitem}[--]
\item Instead of doing a full optimization at each step,
alternatively for $\phi$ and $\theta$, optimize jointly for $(\phi,\theta)$
using gradient descent;
\item Use mini-batches;
\item Express $\nabla_{\!\theta} \mathscr L$ and $\nabla_{\!\phi} \mathscr L$ as expectations,
and approximate them with Monte Carlo;
\item Somehow reduce the variance of those gradient estimators.
\end{compactitem}

\begin{align*}
  \nabla_{\!\theta} \E_{ z \sim q_\phi} \bigl[ f(z, \theta) \bigr] &=
  \E_{ z \sim q } \bigl[ \nabla_{\!\theta} f(z,\theta)  \bigr] \\
  \nabla_{\!\color{blue}\phi} \E_{ z \sim q_{\color{blue}\phi}} \bigl[ f(z, {\color{blue}\phi}) \bigr] &=
  \E_{ z \sim q_{\color{blue}\phi} }
  \bigl[ \nabla_{\!\color{blue}\phi} f(z,{\color{blue}\phi}) \bigr] +
  \E_{ z \sim q_{\color{blue}\phi} }
  \bigl[
  f(z,{\color{blue}\phi})
  \nabla_{\!\color{blue}\phi}
  \log q_{\color{blue}\phi}(z)
  \bigr]
\end{align*}

Monte Carlo estimators of the second term (\textsc{reinforce} estimator)
are unstable: the score function,
$\nabla_{\!\phi} \log q_\phi(z)$, whose expectation is zero, oscillates.
To reduce the variance, use a baseline,
\[
  \E_{ z \sim q_\phi }
  \bigl[
  \bigl( f(z,\phi) - B(\phi) \bigr)
  \nabla_{\!\phi} \log q_\phi(z) 
  \bigr]
\]
with $B(\phi) \approx E[f]$, or use the \emph{reparametrization trick}
(only for continuous variables),
replacing
$z \sim q_\phi$
with $\epsilon \sim r$, $z = g_\phi(\epsilon)$.
\begin{align*}
\nabla_{\!\phi} \E_{ z \sim q_\phi} \bigl[ f(z, \phi) \bigr]
&= \nabla_{\!\phi} \E_{ \epsilon \sim r } \bigl[ f(g_\phi(\epsilon), \phi) \bigr] \\
&= \E_{ \epsilon \sim r } \bigl[ \nabla_{\!\phi} f(g_\phi(\epsilon), \phi) \bigr]
\end{align*}
\[
\begin{array}{ccc}
q & r & y = g_\phi(\epsilon) \\
\hline
N(\mu, \sigma^2) & N(0,1) & y = \mu + \sigma \epsilon \\
\text{Gamma}(1,\beta) & \text{Gamma}(0,1) & y = \beta \epsilon \\
\text{Exp}(\lambda) & U(0,1) & y = - \lambda^{-1} \log \epsilon \\
N(\mu, AA') & N(0,I) & y = \mu + A \epsilon
\end{array}
\]

