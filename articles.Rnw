%% 2023-12
%%

\nextbook
\begin{book}
  \emph{Monotone operator equilibrium network}\\
  E. Winston adn J.Z. Kolter
\end{book}
An \emph{operator} is a subset $F \subset \RR^n \times \RR^n$,
seen as a multi-valued function.
\emph{Operator splitting} refers to ways of finding zeroes of a sum of operators,
\ie, solving $0 \in (F+G)(x)$.
For a maximal monotone sum, use
\emph{forward-backward spliting}
\[ x_{k+1} = R_G \bigl[ x_k - \alpha F(x_k) \bigr] \]
or \emph{Peaceman-Rachford splitting}
\begin{align*}
  u_{k+1} &= C_F C_G ( u_k ) \\
  x_k &= R_G ( u_k ) .
\end{align*}
The \emph{resolvent} and \emph{Cayley} operators are
\begin{align*}
  R_F &= ( I + \alpha F )^{-1} \\
  C_F &= 2 R_F - I .
\end{align*}
If $F(x) = G x + h$ is linear,
then
\[ R_F(x) = ( I + \alpha G )^{-1} ( x - \alpha h ). \]
If $F = \partial f$ (with $f$ convex, closed, proper (CCP)),
then
\[
R_F(x) = \operatorname{prox}_f^\alpha (x) = \argmin_z  \dfrac12 \n{ x - z }_2 ^2 + \alpha f(z).
\]

A \emph{deep equilibrium network} (DEQ) model
is a weight-tied, input-injected network
\[ z_{i+1} = g( z_i, x ) . \]
A fixed point $z^* = \sigma ( W z^* + U x + b )$
is a zero of the operator splitting problem
$0 \in (F+G) ( z^* )$
\begin{align*}
  F(z) &= ( I - W ) z - (Ux + b) \\
  G &= \partial f \\
  \sigma &= \operatorname{prox}_f^1 \\
  f\ &\text{CCP}.
\end{align*}
If $I - W \succcurlyeq mI$ for some $m>0$, \ie, if
\[ W = (1-m) I - A'A + B-B' \]
then, there is a unique solution.

Common non-linearities (ReLU, sigmoid, tanh, softplus) are proximal operators.

The DEQ iteration
$z \leftarrow \sigma ( W z + U x + b ) $ may not converge,
but the forward-backward (for small $\alpha$) and the Peaceman-Rachford updates
(for all $\alpha$ -- it is also faster) do.
  
\nextbook
\begin{book}
  \emph{Monotone deep Boltzmann machines}\\
  Z. Feng et al. (2023)
\end{book}
A (non-restricted) Boltzman machine defines a joint probability distribution
\[ p(x) \propto \exp \left(
\sum_{ij} x_i ' \Phi_{ij} x_j + \sum_i b_i ' x_i 
\right).  \]
Parametrize $\Phi$ as a block-hollow matrix
\begin{align*}
  \Phi_{ij} &= \begin{cases}
    - \hat A_i ' \hat A_j & \text{if } i \neq j \\
    0 & \text{if } i = j 
  \end{cases} \\
  \hat A_i &= A_i \cdot \min \left\{
  \dfrac{ \sqrt{ 1 - m } }{ \n{ A_i }_2 }, 1
  \right\};
\end{align*}
this ensures $ I - \Phi \succcurlyeq m I $.
Then, the mean-field fixed point
\[ q_h = \text{softmax} ( \Phi_{hh} q_h + \Phi_{ho} x_o + b_h ) \]
is the fixed point of a monotone deep equilibrium (monDEQ) model.

\nextbook
\begin{book}
  \emph{A non-parametric $k$-nearest neighbour\\ entropy estimator}\\
  D. Lombardi and S. Pant (2015)
\end{book}
To estimate the entropy from samples,
\[ \hat H - \dfrac1N \sum_i \log \dfrac1{ \hat p( x_i ) }, \]
the KL estimator assumes that $\hat p$ is constant in
$B(x_i, \epsilon_i)$,
where $\epsilon_i$ is the distance to the nearest neighbour
\begin{align*}
  \hat H &= \psi(N) - \psi(k) + \log c_d + \dfrac dN \sum_{i=1} ^N \log \epsilon_i \\
  \psi&: \text{ digamma function} \\
  c_d &= \begin{cases}
    2^d & \text{ for } \n{\cdot}_\infty \\
    \dfrac{ \pi^{ d/2 } }{ \Gamma( 1 + d/2 ) } & \text{ for } \n{ \cdot }_2
  \end{cases}
\end{align*}
In particular, this assumes the distribution is isotropic in the ball $B(x_i,\epsilon_i)$.
Instead, the KpN estimator
assumes it is a (truncated) Gaussian
$N(\mu_i, \Sigma_i)$, where $\mu_i, \Sigma_i$ are the sample mean and variance of the
$p \geq k$ nearest neighbours of $x_i$:
\begin{align*}
  g_i(x) &= \exp -\dfrac12 ( x - \mu_i ) ' \Sigma_i ^{ -1 } ( x - \mu_i ) \\
  G_i &= \int_{ B(x_i, \epsilon_i ) } g_i(x) dx \\
  \hat H &= \psi(N) - \psi(k) - \dfrac1N \sum \log \dfrac{ g_i(x_i) }{ G_i }.
\end{align*}
Computing the Gaussian integral $G_i$ is tricky, but can be done,
for the $L^\infty$ ball, with expectation propagation multivariate Gaussian probability.

\nextbook
\begin{book}
  \emph{Gaussian probabilities\\ and expectation propagation}\\
  J.P. Cunningham et al. (2011)
\end{book}
How to compute a Gaussian integral
\[ \operatorname*{P}_{ X \sim N(\mu,\Sigma) } \left[ X \in \prod_i [\ell_i , u_i] \right] \]
approximately, with expectation propagation.

\nextbook
\begin{book}
  \emph{Flow annealed importance sampling bootstrap}\\
  L.I. Midgley et al.
\end{book}
Importance sampling (IS) samples from a distribution $p_0$
and reweights the samples to match a distribution $p_1$.
\begin{align*}
  x &\sim p_0 \\
  w(x) &= \dfrac{ p_1(x) }{ p_0(x) }
\end{align*}
\emph{Annealed importance sampling} (AIS) uses a chain of distributions,
\[ \log p_i = \beta_i \log p_0 + ( 1 - \beta_i ) \log p_M, \]
progressively moving from $p_0$ to $p_M$,
\[
\begin{tikzpicture}[>=stealth,scale=1.2,inner sep=1pt,outer sep=0pt,baseline=0]
  \node (x1) at (0,3) {$X_1\rlap{$\sim p_0$}$};
  \node (x2) at (0,2) {$X_2$};
  \node (x3) at (0,1) {$\vdots$};
  \node (x4) at (0,0) {$X_M$};
  \draw[->,decorate, decoration={snake, post length=1mm}] (x1)
    to node[pos=.5,right=3pt]{\footnotesize MCMC with stationary distribution $p_1$} (x2);
  \draw[->,decorate, decoration={snake, post length=1mm}] (x2) 
    to node[pos=.5,right=3pt]{\footnotesize MCMC with stationary distribution $p_2$} (x3);
  \draw[->,decorate, decoration={snake, post length=1mm}] (x3) -- (x4);
\end{tikzpicture}
\]
\[ w( x_M ) =
\dfrac{ p_1(x_1) }{ p_0(x_1) }
\dfrac{ p_2(x_2) }{ p_1(x_2) }
\cdots
\dfrac{ p_M(x_M) }{ p_{M-1}(x_M) }
\]

Application to normalizing flows and the $\alpha$-divergence, for $\alpha=2$ (to limit mode collapse)
\begin{align*}
  D_\alpha( p \| q ) &= \dfrac1{ \alpha ( 1-\alpha ) } \int p(x) ^ \alpha q(x) ^{ 1 - \alpha } dx \\
  D_0( p \| q ) &= \text{KL}( q \| p ) \\
  D_1( p \| q ) &= \text{KL}( p \| q )
\end{align*}
% Not read

\nextbook
\begin{book}
  \emph{Conditional random fields: an introduction}\\
  H.M. Wallach (2004)
\end{book}
A \emph{conditional random field} (CRF) is a conditional probability distribution on sequences of labels,
often used to tag text (e.g., POS tagging, NER, etc.),
of the form
\[ P( Y | X ) = \dfrac{ 1 }{ Z(X) } \sum_j
\lambda_j \underbrace{ \sum_i f_j ( y_{i-1}, y_i, x, i ) }_{ F_j(y,x) }
\]
where the $f_j$ are binary features of $y_i$, or $y_i$ and $y_{i-1}$,
possibly involving $x$. It is a log-linear probabilistic graphical model.

The log-likelihood is
\[ \ell( \lambda ) = \sum_{ (x,y) \sim \text{data} }
- \log Z(x) + \sum_j \lambda_j F_j(y,x). \]
Its gradient is
\[ \dfrac{ \partial \ell }{ \partial \lambda _j } =
\E_{ (x,y) \sim \text{data} } F_j(y,x) -
\sum_{ x \sim \text{data} }
\E_{ y \sim p( y | x, \lambda ) }
F_j(y,x)
.\]

The normalization factor can be computed with a matrix product
\[ Z(x) = \bigl[ \prod M_i(x) \bigr]_{ \text{start}, \text{end} } \]
where
\[ M_i(x)_{ y', y } = \exp \sum_j \lambda_j ( y', y, x, i ) \]
after adding labels $y_0 = \text{start}$, $y_{n+1} = \text{end}$.

The second term in the gradient can be computed with dynamic programming
(forward-backward algorithm)
\begin{align*}
  &\E_ {y \sim p(y|x,\lambda) } F_j(y,x) \\
  &\hspace*{1cm}= \sum_y p(y|x,\lambda) F_j(y,x) \\
  &\hspace*{1cm}= \sum_i \sum_{ y , y' } p( Y_{i-1} = y'  , Y_i = u | x, \lambda ) f_j( y' , y , x ) 
\end{align*}
\begin{align*}
  \alpha_0( y | x ) &= \mathbf{1}_{ y = \text{start} } &
  \alpha_i(x) &= M_i(x) ' \alpha_{i-1} (x) \\
  \beta_{n+1}(y|x) &= \mathbf1_{y=\text{end}} &
  \beta_i(x) &= M_{i+1}(x) \beta_{i+1}(x)
\end{align*}
\[ P( Y_{i-1} = y' , Y_i = y | x , \lambda ) = \dfrac{
  \alpha_{i-1} ( y' | x ) M_i( y', y | x ) \beta_i( y | x )
}{ Z(x) }
\]

\nextbook
\begin{book}
  \emph{Implicit MLE: backpropagating through discrete exponential family distributions}\\
  M. Niepert (2021)
\end{book}
To train a model involving sampling from discrete random variables
\[
\begin{tikzpicture}[>=stealth,scale=1.2,inner sep=1pt,outer sep=2pt,baseline=0]
  \node (x) at (0,0) {$x$};
  \node (t) at (1,0) {$\theta$};
  \node (z) at (2.3,0) {$z \sim p_\theta(z)$};
  \node (y) at (3.8,0) {$y$};
  \draw[|->] (x) to node[above=1pt]{$\footnotesize h_V$} (t);
  \draw[|->] (t) -- (z);
  \draw[|->] (z) to node[above=1pt]{$\footnotesize f_U$} (y);
\end{tikzpicture}
\]

\[ \text{loss}(u,v) = \E_{ z \sim p_{h_v}(x) } \bigl[ \ell\bigl( f_u(z), y \bigr) \bigr] \]
implicit MLE uses
\begin{align*}
  &\text{forward:} & \epsilon  &\sim \rho \\
  && \hat z &= \text{MAP}( \theta + \epsilon ) \\[2mm]
  &\text{backward:} & \theta' &= \theta - \lambda \nabla_{\! z} \ell \\
  && \hat \nabla_{\!\theta} \ell &= \hat z - \text{MAP}( \theta' + \epsilon ).
\end{align*}
