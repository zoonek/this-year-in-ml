  \draw[->] (A2.east) -- (O);
  \draw[->] (A3.east) -- (O);
  \draw[->] (A4.east) -- (O);
\end{tikzpicture}
\]
  
\nextbook
\begin{book}
  \emph{On Hawkes processes\\ with infinite mean intensity}\\
  C. Aubrun et al. (2022)
\end{book}
The linear Hawkes process has intensity
\[ \lambda_t = \lambda_\infty + \int_{-\infty}^t \phi(t-u) dN_u . \]
It can be generalized to
\begin{align*}
  \lambda_t &= \lambda_\infty + \int_{-\infty}^t \phi(t-u) dN_u + \\
  &\hphantom{=} \int_{-\infty}^t \int_{-\infty}^t Q(t-s, t-u) \epsilon_u \epsilon_s dN_u dN_s
\end{align*}
(with $\epsilon_t = \pm1$).
For instance, the ZHawkes model uses
\[ Q(s,u) = \phi(s) \delta(s-u) + z(s) z(u). \]

\nextbook
\begin{book}
  \emph{Distributionally robust risk evaluation with causality constraint and structural information}\\
  B. Han (2022)
\end{book}
Optimal transport (OT)
computes the Wasserstein distance
\[ W(\mu, \nu) = \inf_{ \pi \in \Pi(\mu,\nu) } \int_{X \times Y} c(x,y) \pi(dx,dy). \]
For distributions on time series,
\emph{causal optimal transport} (COT)
only considers causal transport plans:
$\pi( y_t | x_{1:T} ) = \pi( y_t | x_{1:t} )$
(it can be formulated as a linear constraint).
A risk measure $\rho$ can be made distrbutionally robust by taking the worst case in a Wasserstein ball
around the empitical distribution
\[ \max_{ W( \mu, \hat \mu ) \leq \epsilon } \rho(\mu). \]

\nextbook
\begin{book}
  \emph{What affects the relationship\\ between oil prices and the US stock market?\\
  A mixed-data sampling copula approach}\\
\end{book}
The \emph{copula-Midas-X} model models a high-frequency (daily)
bivariate time series $(u,v)$ using low frequency (monthly) time series $X_s$.
\begin{align*}
  (u_t, v_t) &\sim C(\lambda_t)
  && \text{copula} \\
  \lambda_t &= \lambda_\tau + \alpha \Phi^{-1}(u_t) \Phi^{-1}(v_t) + \beta \lambda_{t-1}
  && \text{daily} \\
  \lambda_\tau &= \sum_s \gamma_s \sum_k \phi_k(w_s) X_{s,\tau-k}
  && \text{monthly} \\
  \gamma_s &: \text{ weight of predictor $s$} \\
  \phi_k(w_s) &: \text{ weight decay of predictor $s$} \\
  \phi_k(w) &\propto \left( 1 - \dfrac kK \right) ^{ \!\! w - 1 },
  \qquad \phi_k(w) = 1
\end{align*}
Try with the symmetrized Joe-Clayton (SJC) copula.

\nextbook
\begin{book}
  \emph{Structural clustering of volatility regimes\\ for dynamic trading strategies}\\
  A. Prakash et al. (2021)
\end{book}
To determine the number of volatility regimes (in a return time series):
\begin{compactitem}[--]
\item Partition the time series into stationary segments
  (Mood test, in R's \texttt{cpm} package to detect changes in variance)
\item Compute the Wasserstein distance matrix
  \[ D_{ij} = W_p( F_i, F_j ) = \Bigl( \int \va{ F_1 - F_j }^p \Bigr)^{1/p} \]
\item Use spectral clustering, with affinity matrix
  \[ A_{ij} = \exp - \dfrac{ D_{ij}^2 }{ \sigma_i \sigma_j }, \]
  where $\sigma_i$ is the distance between $i$ and its
  $\lceil \sqrt m \,\rceil$th nearest neighbour,
  where $m$ is the number of segments.
\end{compactitem}
The resulting strategy could be: buy the S\&P when volatility is low,
switch to gold when it is high.

To compare
$(x_i,\dots,x_s)$ and $(x_1,\dots,x_t)$,
replace the observations by their ranks and compare
$\langle ( x_i - \bar x ) ^2 \rangle$ in each segment.

\nextbook
\begin{book}
  \emph{High-frequency-based volatility model\\ with network structure}\\
  H. Yuan et al.
\end{book}
The \textsc{heavy} volatility model combines high and low frequency data.
\begin{align*}
  r_t &: \text{ daily returns} \\
  \text{RM}_y &:\text{ daily realized volatility} \\
  h_t &= \var_{t-1}[ r_t ] \\
  \mu_t &= \E\nolimits_{t-1} [ \text{RM}_t ] \\
  h_t &\sim h_{t-1} + \text{RM}_{t-1} \\
  \mu_t &\sim \mu_{t-1} + \text{RM}_{t-1}
\end{align*}
It can be generalized to $N$ assets ($N=18$, in the example),
linked through an adjacency matrix $A$ (e.g., industry membership).
\begin{align*}
  h_{i,t} &\sim h_{i,t-1} + \text{RM}_{i,t-1} + \dfrac1{d_i} \sum_j a_{ij} \text{RM}_{j,t-1} \\
  \mu_{i,t} &\sim \mu_{i,t-1} + \text{RM}_{i,t-1} + \dfrac1{d_i} \sum_j a_{ij} \text{RM}_{j,t-1}
\end{align*}

\nextbook
\begin{book}
  \emph{Learning probability distributions\\ in macroeconomics and finance}\\
  J. Barun\'ik and L. Hanus (2022)
\end{book}
Forecast the $h$-period ahead distribution of GDP growth, inflation, unemployment
from 60 years of 200 macroeconomic variables (FREQ-QD),
with a multi-output neural net
(MLP, RNN, LSTM) forecasting the binary variables
$[y_{t+h} \geq q_t^\alpha]$,
where $q_t^\alpha$ is the $\alpha$-quantile of $y$ on $[0,t]$,
for 20 values of $\alpha$ (0.01 to 0.99),
with a penalty to ensure the quantiles are in the correct order.

Implementation in Julia (\texttt{Flux.jl}): \texttt{DistrNN.jl}.

\nextbook
\begin{book}
  \emph{Complexity and persistence of price time series of the European electricity spot market}\\
  C. Han et al.
\end{book}
To look at the tails of a distribution, plot its (kernel) density
with a logarithmic vertical scale and fit a symmetric L\'evy $\alpha$-stable distribution
\begin{align*}
  L(x) &= \dfrac1{2\pi} \int_{-\infty}^\infty \phi(t) e^{ - i x t } dt \\
  \phi(t) &= \exp \bigl[ i t \mu - \va{ct}^\alpha \bigr] \qquad \alpha < 2
\end{align*}
or a $q$-Gaussian distribution
\begin{align*}
  G(x) &\propto e_q \bigl( - c ( x - \mu )^2 \bigr)  \\
  e_q(x) &= \bigl[ 1 - (1-q) \bigr] ^{ 1 / (1-q) } \qquad q > 1
\end{align*}
using $\text{KL}( \text{data} \| p )$.

To show multifractality, plot the return variance versus the window size:
if the Hurst exponent is constant, it is a straight line.
  
