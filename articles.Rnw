\node[node] (y5) at (5,1) {};
\draw[->] (0,-1) -- (x0);
\draw[->] (1,-1) -- (x1);
\draw[->] (2,-1) -- (x2);
\draw[->] (x0) -- (x1);
\draw[->] (x1) -- (x2);
\draw[->] (x2) -- (y2);
\draw[->] (y2) -- (y3);
\draw[->] (y3) -- (y4);
\draw[->] (y4) -- (y5);
\draw[->] (y3) -- (3,2);
\draw[->] (y4) -- (4,2);
\draw[->] (y5) -- (5,2);
\end{tikzpicture}
\]

Use t-SNE to plot word embeddings.

\emph{Collaborative filtering}
is a low-rank matrix factorization (SVD with missing values),
\emph{Content-based recommentation systems} address the cold-start problem by learning an embedding
of user and/or item features.
Recommender systems are contextual bandits.

Other applications include embeddings (of words, phrases, relations, etc.),
and learning structured data (knowledge base) for link prediction
and question answering.

\textbf{13.}
Nor all learning problems are supervised:
generative models,
outlier/anomaly detection,
missing values,
semi-supervised learning,
unsupervised learning.

% 13. Linear factor models

PCA has many variants.
\begin{align*}
  & \text{PCA}               & X & \sim N( b , WW' ) \\
  & \text{Probabilistic PCA} & X & \sim N( b , WW' + \sigma^2 I) \\
  & \text{Factor analysis}   & X & \sim N( b , WW' + \Delta)   
\end{align*}
Equivalently,
\begin{align*}
  h &\sim N(0,I)  &   h &\sim N(0,I)                  &   h &\sim N(0,I) \\
  X &= b + W h    &   \epsilon &\sim N(0,\sigma^2 I)  &   \epsilon &\sim N(0,\Delta) \\
    &             &   X &= b + W h                    &   X &= b + W h 
\end{align*}
\begin{align*}
  h &\sim p \text{ non-Gaussian} \\
  X &= b + W h \text{ $W$ orthogonal (ICA)} 
\end{align*}

Nonlinear variants replace
$h \mapsto b + W h$
with $h \mapsto f(h)$, a nonlinear mapping given by, e.g., a neural net.

\emph{Slow feature analysis} generalizes PCA 
\[
\begin{array}{ll}
\text{Find} & u \in \RR^n \\
\text{To maximize} & E(u'X)^2 \\
\text{Such that} & u' u = 1
\end{array}
\]
to time series
\[
\begin{array}{ll}
\text{Find} & u \in \RR^n \\
\text{To maximize} & E(u'x_{t+1} - u'x_t)^2 \\
\text{Such that} & E[u'x_t] = 0 \\
 & E( u' x_t )^2 = 1.
\end{array}
\]
The mapping $x \mapsto u' x$ can be replaced with an affine transform
$x \mapsto u' x + b$.
To learn several features,
add a constraint
$E[ (u_i'x_t)(u_j'x_t) ] = \delta_{ij}$.
Apply on a nonlinear transform (e.g., a quadratic kernel) of $x$.

\emph{Sparse coding} generalizes PPCA by using a prior with a sharp peak at 0
(not sparse, but still sparsifying).
\begin{align*}
  h &\sim \text{Laplace, Cauchy or Student} \\
  \epsilon &\sim N(0,\sigma^2I) \\
  X &= b + Wh + \epsilon
\end{align*}
Sparse coding can learn good features,
but not how to combine them.

\textbf{14.}
\emph{Autoencoders} are nonlinear generalizations of PCA.

% Auto-encoder  
\[
\begin{tikzpicture}[xscale=2.5,>=stealth,inner sep=1pt, outer sep=1pt,
n/.style={}
]
  \node[n] (x) at (0,0) {$x$\vphantom{xhr}};
  \node[n] (h) at (1,0) {$h$\vphantom{xhr}};
  \node[n] (r) at (2,0) {$r$\vphantom{xhr}};
  \draw[|->] (x) -- node[auto,pos=.5,inner sep = 1pt] {\footnotesize $f$} (h);
  \draw[|->] (h) -- node[auto,pos=.5,inner sep = 1pt] {\footnotesize $g$} (r);
  \node at (0,-.4) {\scriptsize input};
  \node at (1,-.4) {\scriptsize code,};
  \node at (2,-.4) {\scriptsize reconstruction};
  \node at (1,-.4) {\scriptsize code,};
  \node at (1,-.7) {\scriptsize latent representation};
  \node at (.5,-.2) {\scriptsize encoder};
  \node at (1.5,-.2) {\scriptsize decoder};
\end{tikzpicture}
\]

One can add a regularizer on the local features.
To avoid trivial solutions ($f = \epsilon \text{Id}$, $g = \epsilon^{-1} \text{Id}$),
impose $g = f^T$.

\emph{Contrastive autoencoders} (CAE)
add a penalty on
$\n{ \nabla_{\text{input}} \text{latent} }^2$ -- large derivatives will only be kept if they are tangent to the data manifold.

In a \emph{stochastic autoencoder} (SAE),
the decoding function is replaced by a probability distribution

% Stochastic auto-encoder
\[
\begin{tikzpicture}[xscale=2,>=stealth,inner sep=1pt, outer sep=1pt,
n/.style={}
]
  \node[n] (x) at (0,0) {input};
  \node[n] (h) at (1,0) {latent};
  \node[n] (r) at (3,0) {output};
  \draw[|->] (x) -- node[auto,pos=.5,inner sep = 1pt] {\footnotesize $f$} (h);
  \draw[|->,dashed] (h) -- node[auto,pos=.5,inner sep = 1pt] {\footnotesize $p_\theta(\text{output}|\text{latent})$} (r);
\end{tikzpicture}
\]

($f$ and $p_\theta$ are learnt).
Both steps could be stochastic.
\[
\begin{array}{ll}
  \text{encoder:} & p_{\theta_1} ( h | x ) \\
  \text{decoder:} & p_{\theta_2} ( x | h ) \\
\end{array}
\]

\emph{Denoising autoencoders} (DAE) try to reconstruct their input from a noisy version of it:
\[
\operatorname*{Maximize}_{p,f} \E_{ x \sim \text{data} } \E_{ \epsilon \sim \text{noise} }
p\bigl[ x | h = f(x+\epsilon) \bigr].
\]
It is not possible to remove the noise if $x+\epsilon$ is still on the data manifold,
but if it is away from it,
the denoising autoencoder will
project it onto the data manifold:
it learns a vector field that moves towards the manifold,
$\nabla\!_x \log p_{\text{data}} (x)$.

<<DAEVectofield,results='hide',echo=FALSE,fig.width=6,fig.height=3,out.width='\\hsize',fig.show='hold'>>=
set.seed(1)
op <- par( mar = c(0,0,0,0) )
plot( NA, xlim = c(-1,1), ylim = .5 * c(-1,1), type = "n", xlab = "", ylab = "", axes = FALSE )
s <- .2
f <- function(x) - s * sin(pi*x)
df  <- function(x) - s * pi * cos(pi*x)
curve( f(x), lwd = 10, add = TRUE, col = "#193296" )
n <- 50
xs <- 2 * runif(n) - 1
xs <- seq(-1,1,length=n) + .05 * rnorm(n)
d <- .5 * ( 2 * runif(n) - 1 )
d <- sign(d) * pmax( .1, abs(d) )
for( i in 1:n ) {
  x <- c( xs[i], f(xs[i]) )
  v <- c( -df(xs[i]), 1 )
  v <- v / sqrt(sum(v^2))
  y <- x + d[i] * v
  arrows( y[1], y[2], x[1], x[2], angle = 15, lwd = 3, col = "#653E1D" )
}
par(op)
@

\emph{Predictive sparse decomposition} (PSD)
\[
\begin{array}{r@{}c@{}l}
  x \mapsto & f(x) \\ & h & \mapsto g(h)
\end{array}
\]
minimizes (alternatively $h$ and $f,g$ in)
\[
\n{ x - g(h) }^2 + \lambda \n{ h }_1 + \gamma \n{ h - f(x) }^2.
\]

% 15. Representation learning
\textbf{15.}
\emph{Unsupervised (greedy, layerwise) pretraining}
is sometimes helpful (e.g., when there is not enough data),
but often detrimental (it assumes some features useful for the unsupervised task are also useful for the supervised one;
it relies on a regularizing effect of the chice of starting point
to avoid ``bad local minima'' --
but those are extremely rare and this could drastically reduce exploration).
Prefer dropout and batchnorm (big data)
or Bayesian methods (small data) --
unsupervised pretraining is only still useful in NLP.

\emph{Transfer learning} (same input, different tasks)
and \emph{domain adaptation} (different inputs, same tasks)
are forms of \emph{supervised pretraining}.
One-shot learning uses a single labeled example for the new task.
Zero-shot learning uses none, e.g.:
\begin{compactitem}[--]
\item Given textual descriptions of animals and photographs of some of them, learn to recognize those you have never seen;
\item Given models for languages $A$ and $B$ and a bilingual $A \leftrightarrow B$ lexicon,
  learn to translate sentences.
\end{compactitem}
Semi-supervised learning looks for a representation of the input $x$ that disentangles its causes,
in the hope that the output $y$ is one of them --
this will not work if there is no structure in $x$, e.g., $x \sim N(0,1)$.

% 16. Structured probabilistic models for deep learing
\textbf{16.}
An \emph{energy-based model} (or \emph{Boltzman machine})
is a probability distribution of the form
$ p(x) \propto \exp -E(x) $
(a \emph{Boltzman distribution} -- it just says that $\forall x \ p(x) \neq 0$).
In a \emph{product of experts},
the energy is a sum of ``experts'', each checking if some constraint is satisfied, using a subset of the variables.

Undirected models cannot represent ``immoral'' dependencies;
directed models cannot represent ``non-chordal'' dependencies.
