\draw[->] (H2) -- (K2);
\draw[->] (H3) -- (K3);
\draw[->] (K1) -- (O1);
\draw[->] (K2) -- (O2);
\draw[->] (K3) -- (O3);
\draw[->] (L) -- (H1);
\draw[->] (H1) -- (H2);
\draw[->] (H2) -- (H3);
\draw[->] (H3) -- (R);
\draw[->] (L2) -- (K1);
\draw[->] (K1) -- (K2);
\draw[->] (K2) -- (K3);
\draw[->] (K3) -- (R2);
\draw[->] (H1) to [out=135, in=225,looseness=1] (O1);
\draw[->] (H2) to [out=135, in=225,looseness=1] (O2);
\draw[->] (H3) to [out=135, in=225,looseness=1] (O3);
\node at (3,1) {\rlap{\footnotesize deterministic}};
\node at (3,2) {\rlap{\footnotesize stochastic}};
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Improved techniques for training GANs} \\
  T. Salimans et al. (2016)
\end{book}
Training a GAN is a Nash equilibrium problem
\begin{align*}
  \theta_D &\in \argmin J_D( \theta_D, \theta_G ) \\
  \theta_G &\in \argmin J_G( \theta_D, \theta_G ):
\end{align*}
gradient descent can fail to converge.
\begin{compactitem}[--]
\item To prevent the generator from overfitting the discriminator, 
  have the generator generate data whose statistics match those of the real data, 
  e.g., the expected values of the features on an intermediate layer of the discriminator (feature matching);
\item Include a term for historical averaging
\[ \Biggl\| \theta - \dfrac1t \sum_{ 1 \leq i \leq t} \theta_i \Biggr\| ^2; \]
\item To prevent the generator from always emitting the same point,
  allow the discriminator to look at several examples 
  (minibatch discrimination);
\item Replace the 0 and 1 targets with smoothed values (label smoothing);
\item Batch normalize using the statistics of a fixes reference batch (virtual batch renormalization).
\end{compactitem}

\nextbook
\begin{book}
  \emph{DeepMath -- deep sequence models\\ for premise selection} \\
  A.A. Alemi et al. (2016)
\end{book}
Using the Mizar mathematical library (the library is free, the theorem prover is not) of formal proofs
(of real-world theorems: Hahn-Banach, Brouwer, Borsuk-Ulam, G\"odel, etc.),
train a RNN and/or a CNN, with LSTM/GRU, from character or word embeddings,
to select which axioms will be useful in proving a given conjecture,
to guide automated theorem provers.

\nextbook
\begin{book}
  \emph{Learning to pivot with adversarial networks} \\
  G. Louppe et al.
\end{book}
To make a model $f$ of $Y \sim X$ robust to a latent parameter $Z$ (e.g., model specification), 
\[
\begin{array}{ll}
  \text{Find} & f \\
  \text{Such that} & Y \approx f(X) \\
  \text{and} & f(X) \indep Z
\end{array}
\]
using an adversarial network: 
\begin{compactitem}[--]
\item Learn $f$ so that $y \approx f(x)$ and $g$ performs poorly;
\item Learn $g$ to predict $z$ from $f(x)$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Deep networks with stochastic depth} \\
  G. Huang et al. (2016)
\end{book}
During training, randomly drop a subset of layers.

\nextbook
\begin{book}
  \emph{Exponential family embeddings} \\
  M. Rudolph et al. (2016)
\end{book}
Dimension reduction with word vector embedding looks for a map 
$f: \text{Words} \to \RR^n$
minimizing $\text{Loss}(f(\text{word}), f( \text{surrounding words} ) )$.
One can replace the word and the surrounding words, and their discrete distributions,
with exponential distributions conditioned on a ``context'', for instance: 
\begin{compactitem}[--]
\item A Gaussian embedding can be used to model neuron activity, conditioned on the activity of nearby neurons; 
\item A \emph{Poisson embedding} can model items conditioned on other items from the same shopping basket.
\end{compactitem}

\nextbook
\begin{book}
  \emph{On the expressive power\\ of deep neural networks} \\
  R. Raghu et al.
\end{book}
To measure the expressivity of a neural net, check how the length of a 1-dimensional trajectory in the input space changes as it propagates through the network; 
for instance, for the output node, look at the number of sign changes.

The regimes in which the neurons are 
(ReLUs have two regimes, zero and linear; hard-tanh have three, linear and saturated at $\pm1$)
define the ``activation patterns'' of a network (binary strings, for ReLUs).
For ReLU networks, the activation patterns subdivide the input space into convex polytopes.

<<ExpressivePowerNeural,results='hide',echo=FALSE,fig.width=6,fig.height=2,out.width='\\hsize',fig.show='hold'>>=
library(RColorBrewer)
#for( i in 1:20 ) {
i <- 1
set.seed(i) # 1 or 19 are good

W1 <- matrix( rnorm(8),  nc = 2 )
W2 <- matrix( rnorm(16), nc = 4 )
W3 <- matrix( rnorm(4),  nc = 4 )
b1 <- rnorm(4)
b2 <- rnorm(4)
b3 <- rnorm(1)
ReLU <- function(x) ifelse( x > 0, x, 0 )
f1 <- function(x) ReLU( b1 + W1 %*% x )
f2 <- function(x) ReLU( b2 + W2 %*% f1(x) )
f3 <- function(x) ReLU( b3 + W3 %*% f2(x) )

x <- rnorm(2)
f1(x)
f2(x)
f3(x)
signs2 <- function(x) {
  signs <- sign(x)
  bits <- ( 1 + signs ) / 2
  n <- length(bits)
  sum( rev(bits) * 2^(1:n) ) / 2
}
pattern1 <- function(x) signs2( f1(x) )
pattern2 <- function(x) signs2( c( f1(x), f2(x) ) )
pattern3 <- function(x) signs2( c( f1(x), f2(x), f3(x) ) )

xs <- seq( -3, 3, length = 500 )
ys <- seq( -3, 3, length = 500 )
m1 <- m2 <- m3 <- matrix( NA, nr = length(xs), nc = length(ys) )
for( i in seq_along(xs) ) {
  for( j in seq_along(ys) ) {
    #m[i,j] <- f3( c(xs[i],ys[j]) )
    m1[i,j] <- pattern1( c(xs[i],ys[j]) )
    m2[i,j] <- pattern2( c(xs[i],ys[j]) )
    m3[i,j] <- pattern3( c(xs[i],ys[j]) )
  }
}
f <- function(m) { 
  breaks <- c( sort( unique( as.vector(m) ) ) - .5, max(m) + .5 )
  col <- rep( brewer.pal(12, "Paired"), 50 )[ 1 : ( length(breaks) - 1 ) ]
  image( m, col = col, breaks = breaks, axes = FALSE )
  box()
}
op <- par( mfrow = c(1,3), mar = c(0,0,0,0) + .5 )
f(m1)
f(m2)
f(m3)
par(op)

@

\nextbook
\begin{book}
  \emph{Matrix factorization using\\ window sampling and negative sampling\\ for improved word representations} \\
  A. Salle et al.
\end{book}
Let $M_{wc}$ be the cooccurrence matrix between words $w$ and context words $c$,
\[ \text{PMI}_{wc} = \log \dfrac{ M_{mw} M_{\cdot,\cdot} }{ M_{w,\cdot} M_{\cdot,c} } \]
the pointwise mutual information matrix
and PPMI the positive semidefinite matrix obtained by zeroing out negative eigenvalues.
These matrices have been used to define word embeddings as follows:
\begin{compactitem}[--]
\item PPMI-SVD factorizes $\text{PPMI}_{wc} \approx W_w W_c'$ using a truncated SVD,
$\text{PPMI} = U \Sigma V'$, $W = U \Sigma^{1/2}$;
\item GloVe factorizes $\log M$ by minimizing 
\[
  \sum_{w,c} f( M_{wc} ) ( W_w W_c' + b_w + \tilde b_c - \log M_{wc} )^2;
\]
where the weights are 
\[
  f(x) = \left\{
  \begin{array}{ll}
  ( x / x_{\text{max}} )^ \beta & \text{if } x \leq x_{\text{max}} \\
  1 & \text{otherwise;}
  \end{array}
  \right. 
\]
\item Skipgram with negative sampling factorizes PMI 
by minimizing 
\[
  \sum_{w,c} ( W_w W'_c    - \text{PMI}_{wc}   )^2 - 
  E_{w'}     ( W_w W'_{w'} - \text{PMI}_{w w'} )^2;
\]
\item LexVec is similar but factors PPMI.
\end{compactitem}

\nextbook
\begin{book}
  \emph{On multiplicative integration\\ with recurrent neural networks} \\
  Y. Wu et al.
\end{book}
Replace the computational blocks 
$ \phi( Wx + Uz + b ) $
with 
$ \phi( Wx \odot Uz + b ) $.
[This is one of the ideas behind LSTMs, but it can be used separately.]

\nextbook
\begin{book}
  \emph{Tagger: deep unsupervised perceptual grouping} \\
  K. Greff et al.
\end{book}
To segment an image, look for groupings of pixels for which 
denoising autoencoders easily reconstruct the image withing each group.

\nextbook
\begin{book}
  \emph{Neural networks with differentiable structure} \\
  T. Miconi
\end{book}
To select network structure via gradient descent,
make it differentiable by multiplying the output of each neuron 
with a scalar factor (e.g., one for each layer), and add an $L^1$ penalty 
for those new parameters to encourage sparsity.

\nextbook
\begin{book}
  \emph{Progressive neural networks} \\
  A.A. Rusu et al.
\end{book}
To learn a task related to an already-learnt one, consider a new neural net, parallel to the first one, randomly initialized, with lateral connections. 
To keep the model scalable (task $n+1$ has connections from tasks 1 through $n$), 
use dimension reduction (single-layer network) for those lateral connections.
\[ % Progressive neural net
\begin{tikzpicture}[
  >=stealth,yscale=.6,xscale=1.3,
  neuron/.style={draw,thick,inner sep=2pt,text width=15pt}
]
\footnotesize
\node[inner sep = 0pt] (A) at (.5,0) {input};
\node[neuron,gray] (B1) at (0,1) {};
\node[neuron,gray] (C1) at (0,2) {};
\node[neuron,gray] (D1) at (0,3) {};
\node[neuron] (B2) at (1,1) {};
\node[neuron] (C2) at (1,2) {};
\node[neuron] (D2) at (1,3) {};
\node[inner sep = 1pt] (E1) at (0,4) {\color{gray}output$_1$};
\node[inner sep = 1pt] (E2) at (1,4) {output$_2$};
\draw[->,thick,gray] (A) -- (B1);
\draw[->,thick,gray] (B1) -- (C1);
\draw[->,thick,gray] (C1) -- (D1);
\draw[->,thick,gray] (D1) -- (E1);
\draw[->,thick] (D2) -- (E2);
\draw[->,thick] (A) -- (B2);
\draw[->,thick] (B2) -- (C2);
\draw[->,thick] (C2) -- (D2);
\draw[->,thick] (B1) -- (B2);
\draw[->,thick] (C1) -- (C2);
\draw[->,thick] (D1) -- (D2);
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Visualizing deep convolutional neural networks using natural pre-images} \\
  A. Mahendran and A. Vedaldi (2016)
\end{book}
To understand what a neural network (CMM for computer vision or image recognition) sees: 
\begin{compactitem}[--]
\item Compute the inverse of a representation, \ie, look at images sharing the same representation;
\item Maximize a certain component (cf. the ``cat neuron'');
\item Exagerate the patterns present in an image (deep dream).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Inception-v4, Inception-ResNet and the impact of residual connections on learning} \\
  C. Szegedy et al.
\end{book}
Adding residual connections to Inception networks speeds up training.

\nextbook
\begin{book}
  \emph{Question answering via integer programming over semi-structured knowledge} \\
  D. Khashabi et al. 
\end{book}
Factoid question answering systems just look for an already written answer in a large corpus,
but cannot combine separate pieces of information to create a new, never-seen sentence.
Given tables of knowledge (65, for a total of 5000 rows, origin unknown),
integer programming can find a way to join them to best answer a given question.

\nextbook
\begin{book}
  \emph{Do deep convolutional nets really\\ need to be deep (or even convolutional)?} \\
  G. Urban et al.
\end{book}
The results of a deep convolutional network can be reproduced
by a shallower network, but it still needs to be deep (one hidden layer is not enough)
and convolutional.

\nextbook
\begin{book}
  \emph{Tweet2vec: character-based distributed representations for social media} \\
  B. Dhingra et al.
\end{book}
Character-level bidirectional LSTMs or GRUs
can learn vector embeddings that generalize well to rare, abbreviated or misspelt words,
frequent on Twitter.

\nextbook
\begin{book}
  \emph{Detecting relative anomaly} \\
  R. Neuberg and Y. Shi
\end{book}
To detect anomalies:
\begin{compactitem}[--]
\item From the distance matrix, compute a similarity matrix via a Gaussian kernel
  and use its first eigenvector as a measure of centrality (similar to PageRank);
  with the normalized similarity matrix, this is actually equivalent to a kernel density estimator.
\item Consider an observation highly normal if its degree is in the top $\alpha$\%;
  label an observation anomalous if the length of the shortest path
  to the highly normal observations is high (in the top $\beta$\%)
\end{compactitem}

\nextbook
\begin{book}
  \emph{Unifying count-based exploration\\ and intrinsic motivation} \\
  M.G. Bellemare et al.
\end{book}
Practical applications of reinforcement learning still rely on $\epsilon$-greedy policies for exploration.
\emph{Intrinsic motivation} (IM) achieves exploration using \emph{novelty} signals,
e.g., prediction error or value error.
Sequential density models (probability distributions on the set of sequences of states)
can be used to define pseudocounts: count-based reinforcement learning algorithms then apply
(experience replay, actor-critic, etc.).
% not read

\nextbook
\begin{book}
  \emph{Model-free episodic control} \\
  C. Blundell et al.
\end{book}
Gradient-based reinforcement learning is slow: 
to speed it up, remember (not learn) successful strategies and re-enact them 
when the agent encounters a similar state.
(In humans, the hippocampus does that.)

\nextbook
\begin{book}
  \emph{Resnet in Resnet:\\ generalizing residual architectures} \\
  S. Targ et al.
\end{book}
% ResNet in ResNet
