  H.B. Yang et al.
\end{book}
LoRA over LLaMA, with daily updated financial text data
(news (Yahoo finance), social media (Twitter), SEC filings, blogs, etc.).
  
\nextbook
\begin{book}
  \emph{Temporal data meets LLM: explainable financial time series forecasting}\\
  X. Yu et la.
\end{book}
Ask ChatGPT to:
\begin{compactitem}[--]
\item Describe the business of a company;
\item List its risk, growth, etc. factors;
\item Summarize recent (time-stamped) news about it;
\item Summarize recent macro-economic news related to the keywords; 
\item Use all of the above to forecast the future stock price, reasoning step by step.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Bloated disclosures: can ChatGPT help investors process financial information?}\\
  A.G. Kim et al.
\end{book}
Ask ChatGPT to summarize corporate disclosures:
\begin{compactitem}[--]
\item Bloated disclosures (smaller summaries) herald bad market events; 
\item The sentiment is easier to extract from the summaries.
\end{compactitem}
% Prompts not provided

\nextbook
\begin{book}
  \emph{Improved financial forecasting\\ via quantum machine learning}\\
  S. Thakkar et al.
\end{book}
Sampling from a determinantal point process (DPP) (which increases diversity)
gives an unbiased least squares estimator
\[ \E_{ S \sim \text{d-DPP}(XX') } [ X_S ^{-1} y_S ] = \argmin_w \n{ X w - y } ^ 2 \]
Apply this to random forests, sampling both observations and features.
  
\nextbook
\begin{book}
  \emph{Quantum computer based\\ feature selection in machine learning}\\
  G. Hellstern et al.
\end{book}
Let $\rho_{ij}$ be the dependency between predictors $i$ and $j$,
and $\rho_{iY}$ the dependency between predictor $i$ and target $Y$.
The feature selection problem can be formulated as a QUBO problem:
\[ \begin{array}{ll}
  \text{Find} & z \in \{0,1\}^n \\
  \text{To maximize} & \displaystyle
  \sum_i z_i \va{ \rho_{iY} } -
  \lambda \sum_{i\neq y} z_i z_j \va{ \rho_{ij} }
\end{array} \]
This can be solved with gate-based quantum computers (QAOA).

\nextbook
\begin{book}
  \emph{A unified framework\\ for fast large-scale portfolio optimization}\\
  W. Deng et al. (2023)
\end{book}
IPCA (instrumental PCA) is a factor model whose loadings $\beta$ are linear functions
of (time-varying) asset characteristics.

Add $\ell^1$ and $\ell^2$ penalties to your portfolio optimization problem.

Implementation in \texttt{PyPortOpt}.
  
\nextbook
\begin{book}
  \emph{Enhanced Bayesian neural network\\ for macroeconomics and finance}\\
  N. Hauzenberger et al. (2023)
\end{book}
Nowcast a time series using a Bayesian neural net
(separating linear and nonlinear effects, allowing for heteroskedasticity)
\begin{align*}
  y_t &= \gamma' \mathbf x_t + f( \mathbf x_t ) + \epsilon_t \\
  \epsilon_t &\sim N(0, \sigma_t^2 ) \\
  \log \sigma_t &\sim \text{AR}(1) \\
  f &:
  \begin{tikzpicture}[>=stealth,scale=1.4,inner sep=2pt,outer sep=1pt,baseline=-1.3]
  \node (x) at (.1,0) {$\mathbf x_t$};
  \node[draw] (k) at (1,0) {linear};
  \node[circle,draw,inner sep = 1.55ex] (h) at (2,0) {};
  \node[draw] (b) at (3,0) {linear};
  \node (y) at (3.9,0) {$y_t$};
  \draw[->] (x) -- (k);
  \draw[->] (k) -- (h);
  \draw[->] (h) -- (b);
  \draw[->] (b) -- (y);
  \draw[densely dotted] (1.8,0) -- (2.2,0);
  \draw[densely dotted] (2,-.2) -- (2,.2);
  \node[below=0pt of k] {$\kappa$};
  \node[below=0pt of h] {$h$};
  \node[below=0pt of b] {$\beta$};
  \begin{scope}[shift={(2.01,0)}]
    \begin{scope}[xscale=.5]
      \begin{scope}[shift={(0,-.1)}]
        \clip (0,0) circle (4mm);
        \draw[ultra thick] 
        (-0.5,0.001)--(-0.45,0.002)--(-0.4,0.004)--(-0.35,0.006)--(-0.3,0.009)--(-0.25,0.015)--(-0.2,0.024)--(-0.15,0.036)--(-0.1,0.054)--(-0.05,0.076)--(0,0.1)--(0.05,0.124)--(0.1,0.146)--(0.15,0.164)--(0.2,0.176)--(0.25,0.185)--(0.3,0.191)--(0.35,0.194)--(0.4,0.196)--(0.45,0.198)--(0.5,0.199);
      \end{scope}
    \end{scope}
  \end{scope}  
\end{tikzpicture}
\end{align*}
where $h$ is a convex combination of ReLU, LeakyReLU,
sigmoid and tanh,
with priors
\begin{compactitem}[--]
\item $\beta \sim \text{MGP}$ (multivariate Gamma process)
  \begin{align*}
    \rho_r &\sim \text{Gamma}(a,1) \\
    \phi_q &= \prod_{ 1 \leq r \leq q } \rho_r \\
    \beta_q &\sim N(0, \phi_q^{-1} )
  \end{align*}
  so that the neurons' activations are progressively shrunk to zero
  ($\phi_q \gg 1$ for $q \gg 1$): you can have a large number of neurons,
  only those useful will be kept.
\item $\kappa \sim \text{Horseshoe}$
  \begin{align*}
    j &\text{: predictor} \\
    q &\text{: neuron} \\
    \phi_{jq} &\sim \text{HalfCauchy} \\
    \lambda_q &\sim \text{HalfCauchy} \\
    \kappa_{jq} &\sim N( 0, \lambda_q^2 \phi_{jq}^2 )
  \end{align*}
  The Horseshoe prior generalizes the (sparsifying) Laplace prior:
  \begin{align*}
    &\text{Laplace prior} && \text{Student $t$ prior} \\
    &\lambda^2 \sim \text{Exp}(2) && \lambda^2 \sim \text{IG}(a,b) \\
    &\beta \sim N(0, \lambda^2) && \beta \sim N(0, \lambda^2).
  \end{align*}
\item $\beta \sim \text{Horseshoe}$.
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Successive one-sided Hodrick-Prescott filter with incremental filtering algorithm\\ for nonlinear economic time series}\\
  Y. Liu et al.
\end{book}
The HP filter is
\begin{align*}
  F &=
\left[\!\!\!  
\begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)},outer sep=0pt]
%\begin{tikzpicture}[baseline=(current bounding box.center)]
\clip (-1.25,-.6) rectangle (1.25,.7);
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells,
  row sep={3ex,between origins},column sep={3ex,between origins},
  ampersand replacement=\&% <= to change col separator for align env  
]{
  1 \& -2 \& 1 \&\& 0 \\
  \\
  0 \&\& 1 \& -2 \& 1 \\
};
\draw (m-1-1) -- (m-3-3);
\draw (m-1-2) -- (m-3-4);
\draw (m-1-3) -- (m-3-5);
\end{tikzpicture}
\!\!\!\right]
\\
  S &= I + \eta F' F \\
  \text{trend} &= \argmin_u \n{ y - u } ^2 + \eta \n{ F u }^2 \\
  &= S^{-1} y \\
  \text{cycle} &= ( I - S^{-1} ) y.
\end{align*}
It can be computed efficiently on an expanding window (Woodbury formula).
It can be iterated, to remove any trend remaining in the cycle:
\begin{align*}
  \text{cycle} &= ( I - S^{-1} )^n y \\
  \text{trend} &= \bigl[ I - ( I - S^{-1} )^n \bigr] y
\end{align*}
  
\nextbook
\begin{book}
  \emph{Generating synergistic formulaic alpha collections via reinforcement learning}\\
  S. Yu et al.
\end{book}
RL-based formulaic alpha mining to maximize the performance,
not of each alpha, but of their combination.

\nextbook
\begin{book}
  \emph{Efficient solution\\ of portfolio optimization problems\\ via dimension reduction and sparsification}\\
  C.K. Buhler et al.
\end{book}
To solve large (Markowitz) portfolio optimization problems approximately and efficiently, try:
\begin{compactitem}[--]
\item LSTM to forecast if a stock is never (0) or sometimes (1)
  in the optimal portfolio,
  for no/some value of the risk aversion $\lambda$;
\item Change the risk measure from
  \[ w' V w = w' ( X - \bar X ) ' ( X - \bar X ) w =
  \n{ ( X - \bar X ) w } _2 ^2 \]
  to $\n{ ( X - \bar X ) w } _1$,
  to get a linear program;
\item Sparsify the covariance matrix
  by truncating small vaues and adding back those in a row or column
  with a non-zero off-diagonal element
  (the result is block-diagonal and positive semi-definite).
\end{compactitem}
  
\nextbook
\begin{book}
  \emph{Deep attentive survival analysis in\\ limit order books:
  estimating fill probabilities\\ with convolutional-transformers}\\
  \'A. Arroyo et al.
\end{book}
Use a neural network
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.8,inner sep=2pt,outer sep=0pt,baseline=0]
  \node (x) at (0,3.9) {$x$\rlap{ \footnotesize (features)}};
  \node[fill=blue!10] (DCC) at (0,3) {Dilated causal convolutions};
  \node[fill=blue!10] (T) at (0,2) {Transformer};
  \node[fill=blue!10,align=center] (MRNN) at (0,.8) {Monotonically restricted\\neural net};
  \node (S) at (0,-.4) {\llap{{\footnotesize(survival function)}\ \ }$S(t;x)$};
  \node (t) at (-1.6,2) {\llap{{\footnotesize(event time)}\ }$t$};
  \draw[->] (x) -- (DCC);
  \draw[->] (DCC) -- (T);
  \draw[->] (T) -- (MRNN);
  \draw[->] (MRNN) -- (S);
  \draw[->] (t) -- (MRNN.north-|t.south);  
\end{tikzpicture}
\]
for survival analysis,
maximizing the right-censored log-likelihood
\begin{align*}
\text{loglik} &=
\sum_{ k \text{ observed} }
\log f_\theta( t_k ; x_k ) +
\sum_{ k \text{ censored} }
\log S( t_k ; x_k )
\hspace*{-3cm}
\\
t_k &\text{: event time} \\
x_k &\text{: features} \\
S(t) &= P[T \geq t ] = \exp - \int_0^t h  && \text{survival function}\\
F(t) &= 1 - S(t) && \text{cdf}\\
f(t) &= - \dfrac{ dS }{ dt } && \text{pdf} \\
h(t) &= \dfrac{ f(t) }{ 1 - F(t) } && \text{hazard rate}
\end{align*}

\nextbook
\begin{book}
  \emph{Neural likelihoods\\ via cummulative distribution functions}\\
  P. Chilinski and R. Silva
\end{book}
To model probability distributions (cdf and pdf),
use a neural network, with positive weights and tanh activations;
automatic differentiation gives $f$ and $F$.
This can be generalized to higher dimensions.
Applications include the tail dependence coefficient (TDC).

\[
\begin{tikzpicture}[>=stealth,xscale=1.2,yscale=.8,inner sep=2pt,outer sep=0pt,baseline=0]
