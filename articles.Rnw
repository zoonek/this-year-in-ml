\]

\nextbook
\begin{book}
  \emph{Probabilistic watershed:\\ sampling all spaning forests for seeded segmentation and semi-supervised learning}\\
  E.F. Sanmart\'in et al.
  (NeurIPS 2019)
\end{book}

\[
