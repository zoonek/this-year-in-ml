  \node (A)  at (-1,0) [node] {};
  \node (B1) at  (0,1)  [node,fill=black!20] {};
  \node (B2) at  (0,-1) [node,fill=black!20] {};
  \node (C)  at  (1,0) [node] {};
  \draw (A) -- (B1) -- (C);
  \draw (A) -- (B2) -- (C);
  \draw (A) -- (-2,-1);
  \draw (A) -- (-2,0);
