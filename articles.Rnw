\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Unsupervised machine translation\\ using monolingual corpora only} \\
  G. Lample et al. (2018)
\end{book}
Use denoising autoencoders.
\[
\begin{tikzpicture}[>=stealth,yscale=1,xscale=2,inner sep = 1pt,outer sep = 0pt]
\node[anchor=east] (A) at (0,0) {Language A};
\node[text width=1.3cm,align=center] (L) at (1,0) {Latent space};
