  \draw[->,thick] (H) -- (B);
  \draw[->,thick] (H) -- (C);
  \draw[->,decorate, decoration={snake, post length=1mm}, very thick] (4.8,0) -- (6.2,0);
  \node[thick,circle,draw]        (A) at (7,0) {$A$};
  \node[thick,circle,draw]        (B) at (9,0) {$B$};
  \node[thick,circle,draw]        (C) at (11,0) {$C$};
  \draw[->,thick] (A) -- (B);
  \draw[->,thick] (C) -- (B);
\end{tikzpicture}
\]

DAGs are not closed under marginalization; there are many extensions:
\begin{compactitem}[--]
\item MAG (maximal ancestral graphs);
\item PAG (partially ancestral graphs);
\item IPG (induced path graph);
\item POIPG (completed partially oriented induced path graph);
\item ADMG (acyclig directed mixed graph);
\item Chain graphs.
\end{compactitem}
The FCI (fast causal inference) algorithm is a generalization of the PC algorithm to PAGs.

Conditional independences are not the only constraints that can help identify a model:
\begin{compactitem}[--]
\item Verma constraints,
  \[ \sum_b P(b|a) P(d|a,b,c) = f(c,d) \]
  which can detect the presence of a directed edge $A \to D$;
\item Bell's inequality (which ruled out hidden variables in quantum mechanics);
\item Elementary inequalities, in information theory, and their generalizations;
\item Covariance-based constraints, such as 
  \[ \rho_{AC} \rho_{BD} = \rho_{AD} \rho_{BC} = \rho_{AB} \rho_{CD} \]
\[
\begin{tikzpicture}[>=stealth,yscale=1,xscale=.6,inner sep = 1pt]
  \node[thick,circle,draw,dotted] (H) at (1,1) {$H$};
  \node[thick,circle,draw,dotted] (J) at (5,1) {$J$};
  \node[thick,circle,draw]        (A) at (0,0) {$A$};
  \node[thick,circle,draw]        (B) at (2,0) {$B$};
  \node[thick,circle,draw]        (C) at (4,0) {$C$};
  \node[thick,circle,draw]        (D) at (6,0) {$D$};
  \draw[->,thick] (H) -- (A);
  \draw[->,thick] (H) -- (B);
  \draw[->,thick] (J) -- (C);
  \draw[->,thick] (J) -- (D);
  \draw[->,thick] (H) -- (J);
\end{tikzpicture}
\]
\item An additive model
  \begin{align*}
    H &= N_H \\
    X &= f(H) + N_X \\
    Y &= g(H) + N_Y
  \end{align*}
  can be estimated by (nonlinear) dimension reduction;
\item One can detect if a path is blocked by a hidden variable with few values.
\end{compactitem}

% 10. Time series
\textbf{10.}
With time series, the DAG is often identifiable, even in presence of instantaneous effects.

Granger causality relies on
\[
X_t^k \indep X_{<t}^j \,|\, X_{<t}^{-j}
\quad \implies \quad
X^j \to X^k
\]
(if there are no instantaneous effects).
There are nonlinear variants of Granger causality.
The transfer entropy
$\text{TE}(X\to Y) = I( Y_t : X_{<t} | Y_{<t} )$
looks tempting, but it fails to measure the strength of an influence.

VAR models can be generalized
\[ X_t^i = f_i \bigl( (\text{Pa}_q^i)_{t-q}, \dots, (\text{Pa}_0^j)_t \bigr) + N_t^j. \]

The \d{spectral independence criterion} (SIC) is another way of formalizing
the independence between cause and mechanism.
\begin{align*}
  Y_t &= \sum_{ k \geq 1} h(k) X_{t-k} \\
  C_{XX}(\tau) &= \E[ X_t X_{t-\tau} ] \\
  S_{XX} &= \hat C_{XX} \text{ (Fourier transform)} \\
  S_{YY}(\nu) &= \va{ \tilde h(\nu) } ^2 S_{XX}(\nu)
\end{align*}
The SIC is
\[ \bigl\langle S_{XX} \cdot \bigl| \tilde h(\nu) \bigr| ^2 \bigr\rangle = \bigl\langle S_{XX} \bigr\rangle \bigl\langle \bigl| \tilde h(\nu) \bigr| ^2 \bigr\rangle, \]
where $\displaystyle \langle f \rangle = \int_{-1/2} ^{1/2} f(\nu) d\nu$;
one then has
\[ \bigl\langle S_{YY} \cdot \bigl| \tilde h(\nu) \bigr| ^2 \bigr\rangle \leq \bigl\langle S_{YY} \bigr\rangle \bigl\langle \bigl| \tilde h(\nu) \bigr|^2 \bigr\rangle, \]
with equality if $\va{ \tilde h(\nu) }$ is constant.

