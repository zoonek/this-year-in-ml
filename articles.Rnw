  \node[align=center] (clean) at (0,0) {clean\\image};
  \node[align=center] (rec) at (2,0) {reconstructed\\noise};
  \node[circle,draw,inner sep=0pt] (m) at (2,1.5) {\footnotesize$-$};
  \node (loss) at (3,1.5) {loss};
  \draw[->] (camera) -- (render);
  \draw[->] (w) -- (nerf);
  \draw[->] (nerf) -- (render);
  \draw[->] (render) -- (image);
  \draw[->] (image) -- (noisy);
  \draw[->] (noise) -- (noisy);
  \draw[->] (noise) -- (m);
  \draw[->] (noisy) -- (clip);
  \draw[->] (text) -- (clip);
  \draw[->] (clip) -- (clean);
  \draw[->] (clip) -- (rec);
  \draw[->] (rec) -- (m);
  \draw[->] (m) -- (loss);
  \draw[->] (loss) to[out=90,in=-60] (w);  
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{OCD: learning to overfit\\ with conditional diffusion models}\\
  S. Lutati and L. Wolf (2023)
\end{book}
Diffusion process to generate the weights of another network (hytpernetwork);
ensemble several of the resulting models.

\nextbook
\begin{book}
  \emph{Evaluating self-supervised learning\\ via risk decomposition}\\
  Y. Dubois et al. (2023)
\end{book}
For a supervised learning model, the error can be decomposed into
that coming from the limited model class
and that coming from the finiteness of the training data:
\[ \text{test error} = \text{training error} + ( \text{test error} - \text{training error} ). \]

For self-supervised learning, there are two models, the representation and the probe;
the decomposition is finer, accounting for:
\begin{compactitem}[--]
\item The representation model class, the probe model class; 
\item Whether the representation can be used by the probe (e.g., linear separability);
\item The finiteness of the training data, for the representation and/or the probe.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Efficient self-supervised learning\\ with contextualized target representations\\ for vision, speech and language}\\
  A. Baevski et al. (2023)
\end{book}
Datavec2.0 is a SimSiam-based multimodal self-supervised learning model.

\nextbook
\begin{book}
  \emph{Unsupervised embedding quality evaluation}\\
  A. Tsitsulin et al. (2023)
\end{book}
To assess the quality of an unsupervised embedding $M \in \RR^{ n_1 \times n_2 }$:
\begin{compactitem}[--]
\item $\alpha$-ReQ: exponent of a power law fit of the singular values,
  $\lambda_i \propto i ^{ - \alpha}$
  (linear regresion on a log-log scale);
  $\alpha = 1$ suggests good generalizarion;
\item RankMe: effective rank, \ie, entropy of the normalized singular values;
\item NESum: flatness of the eigenspectrum of the covariance matrix,
  $\sum \lambda_i / \lambda_0$;
  we want the representation to be ``whitened'', \ie, $\forall i \ \lambda \approx \lambda_0$;
\item Incoherence: alignement of the singular vectors with teh standard basis:
  $\max_i \n{ U' e_i }$, $\max_i \n{ V' e_j }$;
\item Pseudo-condition number
  $\kappa_2 = \sigma_1 / \sigma_n$;
\item Numerical rank: $\n M _F / \n M _2 ^2$;
\item Clustering (compared with a random distribution on a sphere),
  from the norm of the pairwise dot product matrix $\n{ W W' }_F$.
\end{compactitem}
Self-cluster and coherence give more consistent results.

