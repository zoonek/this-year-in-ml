\nextbook
\begin{book}
  \emph{Training deep autoencoders\\ for collaborative filtering} \\
  O. Kuchaiev and B. Ginsburg
\end{book}
Use an autoencoder, with SELU units, tied weights 
(the decoder's weights are the transpose of the encoder's)
and masked mean square error loss, for collaborative filtering.
Since the input is sparse and the output $f(x)$ dense,
re-feed the output to the autoencoder to have 
$f(f(x)) \approx f(x)$.

\nextbook
\begin{book}
  \emph{A meta-learning perspective on cold-start recommendations for items} \\
  M. Vartak et al. (2017)
\end{book}
Meta-learning can replace matrix factorization for recommendation systems,
when new items arrive continuously (tweet recommendation):
\[ \text{user} \longmapsto ( \text{tweet} \longmapsto \text{score} ). \]
The meta-learning learns, 
for a user's history (items liked or not),
the weights of a neural network
(either all the weights of a linear network, 
or the biases of a nonlinear one, the other weights being shared across users).

\nextbook
\begin{book}
  \emph{Tropical geometry of deep neural networks} \\
  L. Zhang et al.
\end{book}
Neural networks with ReLU activations are just tropical rational maps.

\nextbook
\begin{book}
  \emph{Deep learning works in practice.\\But does it work in theory?} \\
  L.N. Hoang and R. Guerraoui (2018)
\end{book}
At equivalent Kolmogorov complexity,
deeper neural networks compute functions with larger ``non-parallelizable logical depth''.

\nextbook
\begin{book}
  \emph{Generalizing Hamiltonian Monte Carlo\\ with neural networks} \\
  D. Levy et al. (2018)
\end{book}
Neural networks can learn a reparametrization to speed up HMC,
maximizing the expected squared jumped distance.

\nextbook
\begin{book}
  \emph{Backpropagation through the void:\\ optimizing control variates\\ for black-box gradient optimization} \\
  W. Grathwohl et al. (2018)
\end{book}
To minimize a function of the form 
\[ \text{Loss}(\theta) = \E_{ b \sim p_\theta } \bigl[ f(b) \bigr], \]
SGD needs gradients $\hat g$ such that 
\[ E[\hat g] = \dfrac{ \partial \text{Loss} }{ \partial \theta } \]
and (ideally) $\var \hat g$ small.
Common choices include 
\begin{align*}
  \hat g_{\text{reinforce}} &= f(b) \dfrac{ \partial }{ \partial \theta } \log p_\theta(b) \\
  \hat h_{\text{reparam}} &= \dfrac{ \partial f }{\partial b} \dfrac{ \partial b }{ \partial \theta}, \qquad \text{where } 
  b = b(\theta,\epsilon),\ \epsilon \sim p_\epsilon.
\end{align*}
\emph{Control variates} can reduce variance: 
\[ \hat g_{\text{new}} (b) = \hat g(b) - c(b) + \E_{b \sim p_\theta} \bigl[ c(b) \bigr]. 
\]
They can also deal with non-differentiable $f$ and discrete $b$,
\begin{align*}
  \hat g_{\text{lax}} &= \hat g_{\text{reinforce}}[f] - 
  \hat g_{\text{reinforce}}[c_\phi] + \hat g_{\text{reparam}}[c_\phi] \\
  &= \bigl[ f(b) - c_\phi(b) \bigr] 
  \dfrac{ \partial \log p_\theta (bv) }{ \partial \theta } + 
  \dfrac{ \partial c_\phi(b) }{ \partial \theta }
\end{align*}
where $c_\phi$ is a neural network approximating $f$.
\begin{align*}
  \hat g_{\textsc{dlax}} &= 
  f(b) \dfrac{\partial}{\partial\theta} \log p_\theta(b) 
  \!-\! c_\phi(z) \dfrac{\partial}{\partial\theta} \log p_\theta(z) 
  \!+\! \dfrac{\partial}{\partial\theta} c_\phi(z) \\
  \hat g_{\textsc{relax}} &= 
  \bigl[ f(b) \!-\! c_\phi(\tilde z) \bigr]
  \dfrac{\partial}{\partial\theta} \log p_\theta(b)
  \!+\! \dfrac{\partial}{\partial\theta} c_\phi(z) 
  \!-\! \dfrac{\partial}{\partial\theta} c_\phi(\tilde z) \\
  b &= H(z), \qquad 
  z \sim p_\theta(z), \qquad 
  \tilde z \sim p_\theta(z|b)
\end{align*}

\nextbook
\begin{book}
  \emph{Beyond power calculations: assessing type S (sign) and type M (magnitude) errors} \\
  A. Gelman and J. Carlin (2014)
\end{book}
Besides the \emph{$p$-value} and the \emph{power},
also consider the \emph{type S error rate},
\ie, the probability that the sign is incorrect given that the parameter is significantly different from zero,
and the \emph{exaggeration ratio},
\ie, the expectation of the absolute value of the estimate over the effect size, given it is significantly different from zero.
(R code provided)

\nextbook
\begin{book}
  \emph{Implicit causal models\\ for genome-wide association studies} \\
  D. Tran and D.M. Blei
\end{book}
