\nextbook
\begin{book}
  \emph{Direct parametrization\\ of Lipschitz-bounded deep networks}\\
  R. Wang and I.R. Manchester (2023)
\end{book}
$\gamma$-Lipschitz neural nets
\begin{align*}
  z_0 &= x \\
  z_{k+1} &= \sigma( W_k z_k + b_k ) \\
  y &= W_L z_L + b_L
\end{align*}
can be parametrized as
\begin{align*}
  b_k &\in \RR^{n_{k+1}}  \\
  d_j &\in \RR^{n_j}  \\
  X_k &\in \RR^{n_{k+1}\times n_{k+1}}  \\
  Y_k &\in \RR^{n_{k}\times n_{k+1}}  \\
  \Psi_k &= \text{diag}( e^{d_k} ) \\
  \begin{bmatrix} A_k' \\ B_k \end{bmatrix} &= \text{Cayley}
  \begin{bmatrix} X_k \\ Y_k \end{bmatrix} \\
  A_{-1} &= I \\
  \Psi_{-1} &= \sqrt{ \dfrac{ \gamma }{ 2 } } I \\
  W_k &= 2 \Psi_{k-1}^{-1}B_k A_{k-1}'\Psi_{k-1}
\end{align*}
where the Cayley transform is
\begin{align*}
  \text{Cayley} \begin{bmatrix} X \\ Y \end{bmatrix} &=
  \begin{bmatrix}
    (I+Z)^{-1} (I-Z) \\
    - 2 Y ( I - Z ) ^{-1} 
  \end{bmatrix} \\
  Z &= X - X' + Y'Y
\end{align*}
Equivalently, the model can be written with
\emph{Lipschitz sandwich layers}
\begin{align*}
  h_0 &= \sqrt \gamma x \\
  h_{k+1} &= \sqrt 2 A_k' \Psi_k \sigma( \sqrt 2 \Psi_k^{-1} B_k h_k + b_k )  \\
  y &= \sqrt \gamma B_L h_L+ b_L,
\end{align*}

\nextbook
\begin{book}
  \emph{Recurrent equilibrium networks:\\
  flexible dynamic models \\with guaranteed stability and robustness}\\
  M. Revay et al.
\end{book}
A recurrent equilibrium network (REN)
is a state space model
\begin{align*}
  x_{t+1} &= A x_t + B_1 w_t + B_2 u_t + b_x \\
  y_{t} &= C_2 x_t + D_{21} w_t +  D_{22} u_t + b_y 
\end{align*}
whose weights are given by an equilibrium network
\[w_t = \sigma( D_{11} w_t+ C_1 x_t + D_{12} u_t + b_v ) . \]
Sufficient conditions for the model to be Lipschitz
can be translated into direct parametrizations.

\nextbook
\begin{book}
  \emph{A cookbook of self-supervised learning}\\
  R. Balestriero et al.
\end{book}
% Good review
There are 4 families of self-supervised learning (SSL) models:
\begin{compactitem}[--]
\item Contrastive loss (SimCLR);
\item Self-distillation (BYOL, SimSiam, DINO);
\item Canonical correlation (VICReg, Barlow Twins);
\item Maxed image modeling.
\end{compactitem}
The projection introduced in SimCLR is needed
because the training task is different from the downstream task.

\nextbook
\begin{book}
  \emph{On the representation and learning\\ of monotone triangular transport maps}\\
  R. Baptista et al. 
\end{book}
A \emph{Triangular transport map} $S$ between two probability distributions
$\mu$ and $\nu$ on $\RR^d$ is a map of the form
\[  S : \left\{
\begin{array}{r@{\,}c@{\,\,}l}
  \RR^d & \longrightarrow & \RR^d  \\
  x & \longmapsto &
  \!
  \begin{bmatrix}
    S_1(x_1) \\ S_2(x_1,x_2) \\ \vdots \\ S_d(x_1,\cdots,x_d)
  \end{bmatrix}
\end{array}
\right. \]
such that $X \sim \mu \,\,\Rightarrow\,\, Z = S(X) \sim \nu$,
\ie, $\mu = S^\#\nu$ (this is an alternative to normalizing flows).

If the $x_k \mapsto S_k( x_{<k} , x_k )$ are increasing,
then $S$ is invertible.

If $\mu \ll \text{Lebesgue}$ and $\nu = N(0,I)$,
then $S$ is essentially unique.

The \emph{rectification operator} $R_k$ transforms a smooth function
into a monotonic one
\[ R_k(f_k) ( x_{<k}, x_k ) =
f_k(x_{<k},0) + \int_0^{x_k} g  \bigl[
  \partial_k f_k( x_{<k}, t)
  \bigr]dt \]
for some $g: \RR \to \RR_{>0}$, e.g., softplus.

To find the $S_k$'s from data sampled from $\mu$
(for the reference distribution $\nu = N(0,I)$),
minimize
\[ \hat J_k(S) = \dfrac1n \sum_i
\dfrac12 S( x_{\leq k} ^i ) ^2 -
\log \va{ \partial_k S( x_{\leq k} ^ i ) }
\]
(the KL divergence, up to a constant),
under the constraint
$\partial_k S(x_{\leq k}) > 0$
(use the rectification operator to remove the constraint).
Under reasonable assumptions, there are no spurious local minima:
they are all global.

Look for $S_k$ of the form
\begin{align*}
  S_k( x_{\leq k} ) &= \sum_ { \boldsymbol \alpha \in \Lambda }
  c_{ \boldsymbol \alpha } \psi_{ \boldsymbol \alpha } ( x_{\leq k} )
  \qquad \text{ ${ \boldsymbol \alpha }$ multi-index}\\
  \psi_{ \boldsymbol \alpha } ( x_{\leq k} ) &=
  \prod_{ j = 1 }^k \psi_{ \alpha_j } ( x_j )
\end{align*}
where the $\psi_\alpha$ are: 
\begin{compactitem}[--]
\item Hermite polynomials (orthogonal wrt the Gaussian density)
  \[ \phi_\alpha(x) = (-1)^\alpha e^{ x^2 / 2 }
  \dfrac{ d^\alpha }{ d x^\alpha } e^{ - x^2 / 2 }, \]
  modified to be linear outside some compact interval $[a,b]$
\item or wavelets
  \begin{align*}
    \psi_{\ell, q} (x) &= 2^{ \ell/2 } \psi( 2^\ell x - q ) \\
    \psi(x) &= ( 1 - x^2 ) e^{ - x^2 / 2 } \qquad \text{ (Mexican hat).}
  \end{align*}
\end{compactitem}

Greedily build the multi-index set $\Lambda$
by adding the multi-index ${ \boldsymbol \alpha }$ giving the best improvement
to $\hat J_k$
\[ \Lambda_{ t+1 } = \Lambda_t \union \{ { \boldsymbol \alpha } _t^* \} \]
ensuring that $(\Lambda_t)_{t\geq0}$ remains downward closed
\[ \forall \alpha \in \Lambda_t \quad \forall \alpha' \leq \alpha \quad \alpha' \in \Lambda_t, \]
\ie, ${ \boldsymbol \alpha }_t^*$ is in the reduced margin of $\Lambda_t$
\[ { \boldsymbol \alpha } _t^* = \argmin_{
  { \boldsymbol \alpha }  \in \Lambda_t^{\text{RM}}
} \va{ \nabla_{ \boldsymbol \alpha } \hat J_k }.
\]
The sparsity structure of $\Lambda$ defines a graphical model.

The triangular structure of the transport map
\[ S(x_1,x_2) = \begin{bmatrix}
  S_1(x_1) \\ S_2( x_1, x_2 )
\end{bmatrix} \]
gives the conditional distribution
\[ X_2 | X_1 \!=\! x_1 \,\sim\, S_2( x_1, \bigcdot )^\# \nu_2 . \]

Implementation: \texttt{MParT}.

\nextbook
\begin{book}
  \emph{Categorical reparametrization\\ with Gumbel softmax}\\
  E. Jang et al.
\end{book}
Sampling from a categorical distribution
\[ z \sim \text{Categorical}( \pi_1,\dots,\pi_k ) \]
is equivalent to (\emph{Gumbel max trick})
\begin{align*}
  g_1 & \overset{\text{iid}}{\sim} \text{Gumbel}(0,1) \\
  z &= \text{one-hot} \argmax_i( g_i + \log \pi_i )
\end{align*}
where the Gumbel distribution can be sampled as
\begin{align*}
  u &\sim \text{Unif}(0,1) \\
  g &= -\log -\log u .
\end{align*}
The \emph{Gumbel softmax} replaces argmax with softmax.
\begin{align*}
  g_1 & \overset{\text{iid}}{\sim} \text{Gumbel}(0,1) \\
  z &= \text{softmax}_\tau( g + \log \pi ) \in \Delta
\end{align*}
It is a reparametrization trick for an approximate categorical distribution.

In practice:
\begin{compactitem}[--]
\item Slowly decrease the temperature $\tau$ to approach 1-hot vectors;
\item If you need a discrete output (e.g., discrete actions in reinforcement learning),
  use argmax in the forward pass and the Gumbel softmax in the backward pass.
\end{compactitem}

\nextbook
\begin{book}
  \emph{The concrete distribution: a continuous relaxation of discrete random variables}\\
  C.J. Maddison et al.
\end{book}
Earlier paper on the Gumbel softmax (initially called ``concrete'').

\nextbook
\begin{book}
  \emph{Learning with\\ differentiable perturbed optimizers}\\
  Q. Berthet et al. (2020)
\end{book}
The optimization problem
\[ y^*(\theta) = \argmax_{ y \in \text{Conv}\, Y } \langle y , \theta \rangle , \]
for a finite set $Y$, can be perturbed into
\[ y_\epsilon^*(\theta) = \E_{ z \sim \mu } \bigl[
  y^*( \theta + \epsilon Z )
  \bigr] ; \]
the Jacobian is
\[ J_\theta y^*_\epsilon(\theta) = \E_{ z \sim \mu} \bigl[
  y^*( \theta + \epsilon Z ) \nabla_Z \nu(Z) ' / \epsilon
  \bigr] \]
where $d\mu(z) = e^{ - \nu(z) } dz$.

This generalizes the Gumbel softmax:
\begin{align*}
\mu &= \text{Gumbel}(0,1) \\
Y &= \{ \text{1-hot vectors} \} \\
\text{Conv}\,Y &= \Delta
\end{align*}

Many problems can be put in this form
(maximizing a linear quantity over a polytope):
\begin{compactitem}[--]
\item Ranking: $Y = \{ \sigma \cdot v \ :\ \sigma \in \mathfrak S _n \}$,
  for some vector $v$; $\text{Conv}\,Y$ is then the \emph{permutahedron};
\item Shortest path, etc.
\end{compactitem}
The perturbed solution $y_\epsilon^*$
minimizes the \emph{Fenchel-Young loss}
\begin{align*}
  L_\epsilon(\theta;y) &= F_\epsilon(\theta) + \epsilon \Omega(y) - \langle \theta , y \rangle \\
  F_\epsilon(\theta) &= \E_{ Z \sim \mu } \max_{ y \in \text{Conv}\, Y }
  \langle y , \theta + \epsilon Z \rangle \\
  \Omega &= F_1^* \qquad \text{ (Fenchel dual)}.
\end{align*}

\nextbook
\begin{book}
  \emph{Differentiation\\ of blackbox combinatorial solvers}\\
  M. Vlastelica et al.
\end{book}
To back-propagate through a combinatorial solver
\[ y(w) = \argmin_{ y \in Y } \langle w, y \rangle \]
(\emph{linear} objective, arbitrary constraints),
use the actual (discrete) solution in the forward pass
and a continuous interpolation of (a linearization of)
the loss in the backward pass.
\begin{align*}
  \hat y &= \text{solver} ( \hat w ) \\
  \dfrac{ d L }{ d y } ( \hat y ) &: \text{ gradient to back-propagate} \\
  w' &= \hat w + \lambda \dfrac{ d L }{ d y } ( \hat y ) \\
  y_\lambda &= \text{solver} ( w' ) \\
  \nabla_w f_\lambda ( \hat w ) &=
  - \dfrac1\lambda ( \hat y - y _\lambda )
\end{align*}

\nextbook
\begin{book}
  \emph{Optimizing rank-based metrics\\ with blackbox differentiation}\\
  M. Rol\'inet et al.
\end{book}
Application of blackbox differentiation to ranking problems, maximizing
\begin{compactitem}[--]
\item Recall: proportion of relevant items ($y_i^*=1$)
  among the top $k$ (for a fixed value of $k$);
\item Average precision: average of recall$_k$, as $k$ varies;
\item Mean average precision: average of the average precision, as the class varies.
\end{compactitem}
\[ \begin{array}{ll}
  y \in \RR^n & \text{scores} \\
  y^* \in \{0,1\}^n & \text{ground truth}
\end{array} \]

\nextbook
\begin{book}
  \emph{Backpropagation through combinatorial algorithms: identity with projection works}\\
  S.S. Sahoo et al. 
\end{book}
To back-propagate through a blackbox solver
$w \mapsto t(w) = \argmin_{ y \in Y } \langle w , y \rangle$,
use $-I$,
apply a projection $P$ accounting for invariances
$\forall w \ y^*(w) = y^*\bigl(P(w)\bigr)$,
$d\ell/dy \mapsto -P'(w) d\ell/dy$
and add noise to $w$ before feeding it to the solver.

\nextbook
\begin{book}
  \emph{Fenchel-Young losses with skewed entropies for class-posterior probability estimation}\\
  H. Bao and M. Sugiyama (2021)
\end{book}
The optimization problem
$\hat y(\theta) = \argmax_{y \in Y} \theta y$
can be regularized into
\[ \hat y_\Omega(\theta) = \argmax_y \theta y - \Omega(y). \]
The corresponding \emph{Fenchel-Young loss} is
\begin{align*}
  \ell_\Omega( \theta, y ) &= \Omega^*(\theta) + \Omega(y) - \theta y \\
  \Omega^*(\theta) &= \sup_\eta \theta \eta - \Omega(y) .
\end{align*}
Under reasonable assumptions ($\Omega$ strictly convex),
$\ell$ is convex, smooth, and reaches its minimum 0 at $y = \hat y_\Omega(\theta)$.

A cdf $F$ defines a Fenchel-Young loss
\begin{align*}
  \ell_F(\theta,y) &= \Omega_F^* + \Omega_F(y) - y \theta  \\
  \Omega_F(y) &= \int_0^y F^{-1}(q) dq \\
  \Omega_F^*(\theta) &= \int_{-\infty} ^ \theta F(s) ds.
\end{align*}

Because of the symmetry of the logit link,
logistic regression tends to underestimate the probability of rare events.
Skewed links address that problem but, with maximum likelihood estimation (MLE),
they lead to non-convex optimization problems.
Instead, use the generalized eigenvalue distribution (GEV) link
and the corresponding (convex) Fenchel-Young loss
\[ F_\xi(\theta) = \exp - ( 1 + \xi \theta )_+ ^{ - 1 / \xi }. \]

\nextbook
\begin{book}
  \emph{Learning with Fenchel-Young losses}\\
  M. Blondel et al.
\end{book}
% Technical. I only read the begining.
The optimization problem
\[ \operatorname*{Maximize}_{ y \in Y } \langle \theta , y \rangle \]
can be relaxed to
\[ \hat y_\Omega(\theta) = \argmax_{ y \in \text{Conv}\, Y }
\langle \theta , y \rangle - \Omega(y) . \]
Examples include
\[ \begin{array}{ll}
  \text{Argmax}    & \Omega = I_\Delta \\
  \text{Softmax}   & \Omega = -H + I_\Delta \\
  \text{Sparsemax} & \Omega = \tfrac12 \n{ \cdot } ^ 2 + I_\Delta \\
  \text{Sigmoid}
\end{array} \]

The \emph{Fenchel-Young loss}
\begin{align*}
  L_\Omega(\theta,y) &= \Omega^*(\theta) + \Omega(y) - \langle \theta, y \rangle \\
  &= f_\theta(y) - f_\theta\bigl( \hat y_\Omega(\theta) \bigr),
\end{align*}
where $f_\theta(y) = \Omega(y) - \langle \theta , y \rangle$,
is convex, and reaches its minimum at
$y = \hat y_\Omega(\theta)$.

A \emph{generalized entropy} is a function $H : \Delta_n \to \RR$,
strictly concave, $\mathfrak S_n$-symmetric,
zero on the corners of $\Delta_n$;
it is maximal for the uniform distribution.
\[ \begin{array}{ll}
  \text{Shannon} & \displaystyle
  - \sum p_i \log p_i \\[2mm]
  \text{Tsallis} & \displaystyle
  \dfrac{ 1 \mathstrut}{ \alpha ( \alpha - 1 ) } \left( 1 - \sum p_i^\alpha \right) \\[3mm]
  \text{R\'enyi} & \displaystyle
  \dfrac{1\mathstrut}{1 - \beta} \log \sum p_i ^\beta \\[3mm]
  \text{Norm} & \displaystyle
  1 - \n{ p }_q  \\[1mm]
  \text{Squared norm} & \displaystyle
  \dfrac12 \bigl( 1 - \n p _q^2 )
\end{array} \]

\nextbook
\begin{book}
  \emph{Differentiable clustering and partial Fenchel-Young losses}\\
  L. Stewart et al. (2023)
\end{book}
Given a similarity matrix $\Sigma \in \RR^{n \times n}$,
the adjacency matrix of the $k$-spanning forest with maximum similarity
is the solution of a linear program
\[ \operatorname*{Maximize}_{ A \in C_k } \langle A , \Sigma \rangle \]
where $C_k$ is the set of adjacency matrices of forests with $k$ connected components;
it corresponds to single linkage clustering.

\nextbook
\begin{book}
  \emph{Distributions for compositionally differentiating parametric discontinuities}\\
  J. Michel et al. (2023)
\end{book}
Integral primitive for differentiable programming languages,
to differentiate integrals with discontinuous integrands.

\nextbook
\begin{book}
  \emph{Cold analysis of\\ Rao-Blackwellized straight-through\\ Gumbel-softmax gradient estimator}\\
  A. Shekhovtsov (2023)
\end{book}
There are many estimators of
\( \displaystyle
J = \dfrac{ d }{ d \eta } \E_{ x \sim p_\eta } \bigl[ \ell\bigl( \phi(x) \bigr) \bigr].
\)
\begin{align*}
  J^{\text{RF}} &=
  \ell\bigl(\phi(x)\bigr)
  \cdot
  \dfrac{ d }{ d \eta } \log p_\eta (x)
  \\
  J^{\text{ST}} &= 
  \dfrac{ d }{ d \eta } 
  \ell\bigl(\phi(x)\bigr)
  \cdot
  \dfrac{ d }{ d \eta } 
  \bar \phi
  , \qquad \bar\phi = \E\bigl[ \phi(x) \bigr] \\
  J^{\text{DARN}} &= 
  \dfrac{ d }{ d \eta } 
  \ell\bigl(\phi(x)\bigr)
  \cdot
  \bigl( \phi(x) - \bar\phi )
  \cdot
  \dfrac{ d }{ d \eta } \log p_\eta (x) \\
  &\hphantom{{}={}}
  \bar\phi = \text{your choice} \\
  J^{\text{GS}} &=
  \dfrac{ d }{ d \phi } \ell( \tilde \phi )
  \cdot
  \dfrac{ d \tilde \phi }{ d \eta } \\
  &\hphantom{{}={}}
  G_k \sim \text{Gumbel}(0,1)   \\
  &\hphantom{{}={}}
  \tilde \phi = \text{softmax}_t ( \log p_\eta + G ) \\
  J^{\text{GS-ST}} &=
  \dfrac{ d }{ d \phi }
  \ell\bigl(\phi(x)\bigr)
  \cdot
  \dfrac{ d \tilde \phi }{ d \eta } \\
  J^{\text{GR}} &=
  \dfrac{ d }{ d \phi }
  \ell\bigl(\phi(x)\bigr)
  \cdot
  \E_{ G \sim \text{Gumbel} } \left[
    \dfrac{ d \tilde \phi }{ d \eta }
    \right]
\end{align*}

\nextbook
\begin{book}
  \emph{Automatic differentiation of programs\\ with discrete randomness}\\
  G. Arya et al.
\end{book}
Given a family of discrete random variables $X(p): \Omega \to E$
for $p \in I = [a,b] \subset \RR$,
we want another one, $\tilde X(p)$,
such that
\[ \E \bigl[ \tilde X (p) \bigr] = \dfrac{ d }{ dp } \E\bigl[ X(p) \bigr]. \]

We cannot use the reparametrization trick
\[ \dfrac{ d \E \bigl[X(p)\bigr] }{ dp } \overset{?}{=} \E \left[ \dfrac{ d X(p) }{ xp } \right] \]
because $d X(p) / dp = 0$ a.s.
Instead, let
\begin{align*}
  \delta &= \lim_{ \epsilon \to 0 }
  \dfrac{ X(p+\epsilon) - X(p) }{ \epsilon } = \dfrac{ d X(p) }{ dp } \\
  B &> \va \delta \\
  A_B(\epsilon) &= \left\{ \omega \in \Omega \ : \:
  \va{ \dfrac{ X(p+\epsilon) - X(p) }{ \epsilon } } > B
  \right\} \\
  &= \{ \text{large jumps} \} \\
  w &= \left.
  \dfrac{ d P[ A_B(\epsilon) ] }{ d \epsilon }
  \right|_{ \epsilon = 0 }
  = 
  \left.
  \dfrac{ d P[ \text{large jump} ] }{ d \epsilon }
  \right|_{ \epsilon = 0 } \\
  Y_\epsilon & \overset{d}{=} X(p+\epsilon) - X(p) | A_B(\epsilon), X(p) \\
  Y &= \lim_{ \epsilon \to 0 } Y_\epsilon.
\end{align*}
Then,
\[ \dfrac{ d \E\bigl[ X(p) \bigr] }{ dp } =
\E \bigl[ \delta + w \bigl( Y - X(p) \bigr) \bigr].
\]

Concretely, with dual numbers, this gives results like
\begin{align*}
  & \texttt{X} \sim \texttt{Bernoulli(0.6 + $\epsilon$)} \\
  & \texttt{0 + 1 with probability 2.5$\epsilon$}
\end{align*}
More generally, for random variables with jumps,
sampling returns \emph{stochastic triples} $(a,b,c,d)$
\[ a + b \epsilon + ( c \text{ with probability } d \epsilon ). \]
This is amenable to automatic differentiation.
Implementation in \texttt{StochasticAD.jl}.

\nextbook
\begin{book}
  \emph{SurCo: learning linear surrogates for combinatorial nonlinear optimization problems}\\
  A. Ferber et al. (2023)
\end{book}
Solve nonlinear optimization problems
\[ \operatorname*{Minimize}_{ x \in \Omega } f(x,y) \]
by reducing them to linear problems,
by training a neural net to find the closest linear program.
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=1,inner sep=0pt,outer sep=1pt,baseline=0]
  \node (y) at (0,3.8) {$y$};
  \node (c) at (0,2.9) {$c(y)$};
  \node[fill=blue!15,inner sep = 2pt] (ls) at (0,2) {linear solver};
  \node (x) at (0,1) {$\displaystyle x = \argmin_{ x \in \Omega } c(y) ' x $};
  \node (l) at (0,0) {$\text{loss} = f(x,y)$};
  \draw[->] (y) -- (c);
  \draw[->] (c) -- (ls);
  \draw[->] (ls) -- (x);
  \draw[->] (x) -- (l);
\end{tikzpicture}
\]
(The linear solver can be an MIP solver.)

\nextbook
\begin{book}
  \emph{MIPaaL: Mixed integer program as a layer}\\
  A. Ferber et al. 
\end{book}
To compute surrogate gradients for an MIP solver,
solve the problems by relaxing the integral constrains and progressively adding cutting planes,
and use the final (continuous, convex) optimization problem KKT conditions.

\nextbook
\begin{book}
  \emph{Differentiation of\\ blackbox combinatorial solvers}\\
  M. Vlastelica et al.
\end{book}
We want to backprop through a blackbox (combinatorial) optimizer with a linear objective.
\[ w \longmapsto \hat y = \argmin_{ y \in Y } w \cdot \phi(y)  \longmapsto L( \hat y ) \]
Consider the first order approximation of the loss
\[ L(y) \approx L(\hat y) + \dfrac{ dL }{ dy } ( y - \hat y ) = f(y) . \]
Define a relaxation of $f$
\begin{align*}
  y_\lambda (w) &= \argmin_{ y \in Y } w \cdot \phi(y) + \lambda f(y) \\
  f_\lambda(w) &= f \bigl( y_\lambda(w) \bigr) - \dfrac1\lambda
  \bigl[
    w \cdot \phi\bigl( y(w) \bigr) - w \cdot \phi\bigl( y_\lambda(w) \bigr)
    \bigr].
\end{align*}
The surrogate gradient can be computed as
\begin{align*}
  w' &= \hat w + \lambda \cdot \dfrac{ dL }{ dy } (\hat y ) \\
  y_\lambda &= \text{solver} ( y ' ) \\
  \nabla_w f_\lambda( \hat w ) &= - \dfrac1\lambda ( \hat y - y_\lambda ).
\end{align*}
Try $ \lambda \approx \dfrac{ \langle w \rangle }{ \left\langle
  \dfrac{ dL }{ dy } \right\rangle }$
where $\langle\cdot\rangle = \text{avg}$.

\nextbook
\begin{book}
  \emph{Differentiable Monte Carlo samplers with piecewise deterministic Markov processes}\\
  R. Seyer
\end{book}
The ergodic theorem states
\[ \E_{ X \sim \mu } \bigl[ f(X) \bigr] = \lim_{ T \to \infty } \dfrac1T
\int_0^T f(Z_t) dt \]
but, in general, we do not have
\[
\dfrac{ d }{ d\theta } \E_{ X \sim \mu_\theta } \bigl[ f(X) \bigr]
\overset{?}{=}
\lim_{ T \to \infty }
\dfrac{ d }{ d \theta }
\dfrac1T
\int_0^T f(Z_t^\theta) dt. \]
To differentiate $\smash{ \E\limits_{ X \sim \mu_\theta } } \bigl[ f(X) \bigr]$,
there are several approaches:
\begin{compactitem}[--]
\item The reparametrization trick (aka pathwise derivative)
  to get a \emph{coupling}
  between $\mu_{\theta}$ and $\mu_{\theta+\epsilon}$,
  but it only gives an unbiased estimator
  if the reparametrization is Lippschitz -- this excludes discrete variables or jumps;
\item Stratified derivatives,
  which handle the discontinuities separately (e.g., the ``stochastic triples'');
\item The score method (\textsc{Reinforce}).
\end{compactitem}

A \emph{piecewise deterministic Markov process} has 3 components:
\begin{compactitem}[--]
\item Betweem jumps, it follows a deterministic flow,
  \[ \dfrac{ dz }{ dt } = \xi(z) \]
  for some drift $\xi: E \to E$;
\item The timing of the jumps follow an inhomogeneous Poisson process
  with rate $\lambda_t = \lambda( z_t )$
 for some $ \lambda: E \to \RR_+$;
\item The jumps are given by a transition kernel $Q(z,dz)$.
\end{compactitem}

The main examples are the \emph{zigzag} sampler on $\RR$
\[ \begin{array}{ll}
  \text{state space} & E = \RR \times \{ \pm 1 \} \\
  \text{drift} & \xi(x,v) = (v,0) \\
  \text{event rate} & \lambda(x,v) = \max
  \left\{ 0 , c
  %\dfrac{ \partial }{ \partial x }
  \nabla_x
  - \log \pi(x) \right\} \\
  \text{transition kernel} & \text{deterministically flip sign($v$)}
\end{array} \]
and its generalization, the \emph{bouncy particle} sampler
\begin{align*}
  & E = \RR^d \times \RR^d \\
  & \xi(x,v) = (v,0) \\
  & \lambda(x,v) = \max \{ 0, v' \nabla_x - \log \pi(x) \} \\
  & Q \text{: elastic reflection of $v$ tangentially} \\[-1mm]
  & \hphantom{Q \text{: }}\text{to the potential $\nabla_x - \log \pi$}
\end{align*}
(there is also a ``refreshment rate'' in $\lambda$, corresponding to resetting
the velocity to $v \sim N(0,I)$.)

Those continuous-time non-invertible Markov chains
tend to mix faster than the classic discrete-time reversible ones.

To couple the zig-zag processes
$Z_t^\theta$ and $Z_t^{\theta+\epsilon}$
on $[0,T_\theta]$ and $[0,T_{\theta+\epsilon}]$,
use the unter-arrival times
\[ \tau_i' = \Lambda_t^{\leftarrow} \bigl(
\Lambda_i( \tau_i,\theta) , \theta + \epsilon \bigr) \]
where
\begin{align*}
  \Lambda(t) &= \int_0^t \lambda(r) dr \\
  \Lambda^{\leftarrow}(\omega) &= \inf \{ t \geq 0 \ :\ \Lambda(t) \geq \omega \}
  \quad \text{pseudo-inverse} 
\end{align*}
(they have the same number of events).
Under reasonable assumptions ($\Lambda$ invertible, with smooth inverse),
we can swap $d/d\theta$ and $\lim_{T \to \infty}$.
% The general case gives a more complicated formula.
% It can be generalized to the bouncy particle sampler.
% [not read]

\nextbook
\begin{book}
  \emph{Reformer: the efficient transformer}\\
  N. Kitaev et al.
\end{book}
The attention matrix is quadratic in the context length,
but its rows are softmaxes and tend to be sparse:
instead of computing the whole matrix, only compute, for each row (query),
the $k$ largest entries, corresponding to the $k$ closest keys,
with an approximate nearest neighbour (ANN) algorithm, e.g.,
LSH (locality sensitive hashing).

The Reformer also uses reversible layers.

\nextbook
\begin{book}
  \emph{Linformer: self-attention\\ with linear complexity}\\
  S. Wang et al.
\end{book}
The attention matrix has low rank:
reduce the dimension of the key and value matrices before using them.
\[
\begin{tikzpicture}[>=stealth,xscale=1,yscale=.5,inner sep=0pt,outer sep=1pt,baseline=0]
  \node (Q) at (0,4) {$Q$};
  \node (K) at (0,2) {$EK$};
  \node (V) at (0,0) {$FV$};
  \node[circle,draw,inner sep=0pt] (p1) at (1,3) {\footnotesize$\times$};
  \node[circle,draw,inner sep=0pt] (p2) at (2,1.5) {\footnotesize$\times$};
  \node (y) at (3,1.5) {};
  \draw[->] (Q) -| (p1);
  \draw[->] (K) -| (p1);
  \draw[->] (p1) -| (p2);
  \draw[->] (V) -| (p2);
  \draw[->] (p2) -- (y);
  \node[above left=-2pt of Q] {\footnotesize $L\times d$};
  \node[above left=-2pt of K] {\footnotesize $\ell\times d$};
  \node[above left=-2pt of V] {\footnotesize $\ell\times D$};
  \node[above right=-2pt of p1] {\footnotesize $L\times \ell$};  
  \node[above right=-2pt of y] {\footnotesize $L\times D$};  
\end{tikzpicture}
\]

\nextbook
\begin{book}
  \emph{Random feature attention}\\
  H. Peng et al.
\end{book}
The attention $\text{Att}(q,K,V) = \text{softmax}(qK'/\sqrt d)V$
is the expectation of a quantity whose computation is linear in time and space;
estimating it with a single sample is good enough.

The Gaussian kernel can be estimated as
\[ \exp - \dfrac{ \n{x-y} ^ 2 }{ 2 \sigma^2 } =
\E_{ w_i \overset{\text{iid}}{\sim} N( 0, \sigma^2 I ) }
\bigl[ \phi(x) \cdot \phi(y) \bigr]
\]
where
\[
\phi: \left\{
\begin{array}{rcl}
  \RR^d & \longrightarrow & \RR^{2D} \\
  x & \longmapsto & \begin{bmatrix}
    \sin( w_1 \cdot x ) \\
    \vdots \\
    \sin( w_D \cdot x ) \\
    \cos( w_1 \cdot x ) \\
    \vdots \\
    \cos( w_D \cdot x ) \\
  \end{bmatrix}
\end{array}
\right.
\]
The softmax appearing in the attention formula can be approximated as
\begin{align*}
  \exp \left( \dfrac{ x \cdot y }{ \sigma^2 } \right)
  &= \exp \dfrac{
    \n x ^2 + n y ^2 - n{ x - y } ^ 2
  }{ 2 \sigma^2 } \\
  &=
  \exp \dfrac{ \n x ^2 }{ 2 \sigma^2 }
  \exp \dfrac{ \n y ^2 }{ 2 \sigma^2 }
  \exp \dfrac{ \n{x-y} ^2 }{ 2 \sigma^2 } \\
  &= \exp\left( \dfrac1{\sigma^2} \right) \E_w \bigl[ \phi(x) \cdot \phi(y) \bigr]
  \ \text{if}\, \n x \!=\!\n y\!=\!1 \\
  &\approx 
  \exp \left(\dfrac1{\sigma^2}\right) \phi(x) \cdot \phi(y)
\end{align*}

The attention operator can therefore be approximated without large intermediate matrices,
\begin{align*}
  \text{Att}(q, K, V) &=
  \sum_i \dfrac{
    \exp( q \cdot k_i / \sigma^2 )
  }{
    \sum_j \exp( q \cdot k_j / \sigma^2 )
  } v_i ' \\
  &\approx \sum_i \dfrac{
    \phi(q) \cdot \phi(k_i)
  }{
    \sum_j \phi(q) \cdot \phi(k_j)
  }
  v_i ' \\
  &= \sum_i \dfrac{
    \phi(q) ' \phi(k_i) v_i'
  }{
    \sum_j \phi(q) ' \phi(k_j)
  } \\
  &= \dfrac{
    \phi(q) ' \sum_i \phi(k_i) v_i'
  }{
    \phi(q) ' \sum_i \phi(k_i)
  } \\
\end{align*}
where $\sigma^2$ is the softmax temperature.

\nextbook
\begin{book}
  \emph{Rethinking attention with performers}\\
  K. Choromanski et al.
\end{book}
Attention is defined as
\begin{align*}
  & \text{Att}(Q, K, V) = D^{-1} A V \\
  & A = \kappa( Q, K ) = \exp( Q K' / \sqrt d ) \\
  & D = \text{diag}(A \mathbf 1).
\end{align*}
The kernel can be written
\[ \kappa(x,y) = \E_\phi \bigl[ \phi(x) ' \phi(y) \bigr] \]
and the attention can be approximated as
\begin{align*}
  & \widehat{\text{Att}}(A,K,V) = \hat D ^{-1} \hat Q \hat K ' V \\
  & \hat D = \text{diag}( \hat Q \hat K ' \mathbf 1 ) \\
  & \hat Q = \phi(Q)
  \qquad ( \phi(q_i')' \text{ as rows})
  \\
  & \hat K = \phi(K)
\end{align*}

For the random features $\phi$,
do not use the trigonometric random features
(they have negative values, which increases the variance),
but \emph{positive random features}.
\begin{align*}
  & \phi(x) = \dfrac{ h(x) }{ \sqrt m } \bigl[
    f_1( \omega_1'x) , \dots , f_1( \omega_m' x), \\[-3.5mm]
  & \hphantom{\phi(x) = \dfrac{ h(x) }{ \sqrt m } \bigl[{}}
    \dots, \\[-1mm]
  & \hphantom{\phi(x) = \dfrac{ h(x) }{ \sqrt m } \bigl[{}}
    f_\ell( \omega_1'x) , \dots , f_\ell( \omega_m ' x )
    \bigr] \\
  & h(x) = \exp - \dfrac{ \n x ^ 2 }2 , \quad \ell = 1 , \quad f_1 = \exp \\
  & h(x) = \dfrac1{\sqrt2} \exp - \dfrac{ \n x ^2 }2 ,
    \quad \ell = 2, \quad f_1 = \exp , \quad f_2 = 1/f_1 \\
  & \exp ( x' y ) = \E_{ \omega \sim N(0,I) } \bigl[ \phi(x) ' \phi(y) \bigr]    
\end{align*}

Use \emph{orthogonal random features} (apply Gram-Schmidt to $\omega_1,\dots,\omega_n$)
to further reduce variance.

