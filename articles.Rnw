%%% ICML 2025: Unsorted
%%%

\nextbook
\begin{book}
  \emph{Trajectory inference\\ with smooth Schr\"odinger bridges}\\
  W. Hong et al. (2025)
\end{book}
% Not read
In the Schr\"odinger bridge problem,
\[ \begin{array}{ll}
  \text{Find} & P \text{ stochastic process} \\
  \text{To minimize} & \text{KL}( P \,\|\, \text{Brownian motion} ) \\
  \text{Such that} & \forall k \in [K] \ \ P_k = \mu_k ,
\end{array} \]
replace Brownian motion with a smooth Gaussian process (Mat\'ern).

\nextbook
\begin{book}
  \emph{Nested expectations with kernel quadrature}\\
  Z. Chen et al. (2025)
\end{book}
Kernel quadrature (aka Bayesian quadrature) approximates
\[ \E_{ X \sim \pi } \bigl[ h(X) \bigr] \approx \sum_{ n=1 }^N w_n h( x_n ) \]
where $h \in \mathscr H$, a RKHS with kernel $\kappa$
(e.g., the Sobolev space $X_2^s(\mathcal X)$ of functions on $\mathcal X$ whose (weak) derivatives
of order up to $s$ are in $L^2$).
\begin{align*}
  \mathbf w &= \mu_\pi(\mathbf x ) ( K + N \lambda I )^{-1} \\
  K &= \kappa( \mathbf x, \mathbf x ) \text{ Gram matrix} \\
  \mu_\pi(x) &= \E_ { X \sim \pi } \bigl[ \kappa( X, x ) \bigr ]
  \text{ kernel mean embedding}
\end{align*}
The convergence rate is optimal, but non-iid choices of the $x_i$'s can reduce the rate constant.

It can be used to compute nested expectations
\[ \E_{ \theta \sim q } f\biggl( \E_{ X \sim p_\theta} \bigl[ g(X,\theta) \bigr] \biggr). \]
Alternatives (with no smoothness restrictions on $f$ and~$g$) include
\begin{compactitem}[--]
\item Nested Monte Carlo: $O(\epsilon^{-4})$;
\item Nested quasi Monte Carlo: $O(\epsilon^{-2.5})$;
\item Multi-level Monte Carlo: $O(\epsilon^{-2})$.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Moduli: unlocking preference generalization via diffusion models for offline\\ multi-objective reinforcement learning}\\
  Y. Yuan et al.
\end{book}
Multiobjective reinforcement learning (MORL) learns
\begin{compactitem}[--]
\item Either a set of policies (Pareto front);
\item Or a preference-conditioned policy.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Latent variable estimation\\ in Bayesian Black-Litterman models}\\
  T.Y.L. Lin et al.
\end{book}
In the Black-Litterman framework
\[
\begin{tikzpicture}[>=stealth,yscale=.4,xscale = .8,inner sep=1pt,outer sep=1pt,baseline=0]
  \node[anchor=east] (r) at (0,2) {$r \sim N(\mu, \Sigma)$};
  \node[anchor=east] (p) at (0,0) {$p_r \sim N(v,\Omega)$};
  \node[anchor=west] (o) at (1,1) {$r^* \sim N(\mu^*, \Sigma^*)$};
  \draw[->] (r.east) -- ([yshift=+5pt]o.west);
  \draw[->] (p.east) -- ([yshift=-5pt]o.west);
\end{tikzpicture}
\]
have a neural net compute $v$ and $\Omega$ from asset-specific data.

%%
%% ICML 2025
%%
%%%%%%%%%%%%%%%
%%
%%
%%

\nextbook
\begin{book}
  \emph{Convergent Cross Mapping (CCM)}\\
\end{book}
CCM is a nonlinear Granger causality test:
\begin{compactitem}[--]
\item Start with two time series $(x_t)_t$ and $(y_t)_t$;
\item Build their delay embeddings $(X_t)_t$ and $(Y_t)_t$
  (choose the lag $\tau$ and the embedding dimension $E$);
\item Forecast $x_t$ from $Y_t$, and $y_t$ from $X_t$,
  with $k$-NN ($k=E+1$) and weights
  \[ w_i \propto \exp( - d_i / d_1 ) \]
  where $d_i$ is the distance to the $i$th closest neighbour;
\item Compute $\cor( x_t, \hat x_t )$ and $\cor( y_t, \hat y_t )$;
  consider values above 0.3 significant.
\end{compactitem}

\nextbook
\begin{book}
  \emph{GLiNER: generalist model for named entity recognition using bidirectional transformer}\\
  U. Zaratiana et al. (2024)
\end{book}
Zero-shot NER with a BERT model:
\begin{compactitem}[--]
\item Compute embeddings $p_i$ of entity types and $h_i$ of sentence tokens;
\item Apply FFNs to have embeddings $\text{FFN}(p_i)$ and $\text{FFN}(h_i,h_j)$,
  ($i<j$, $\va{j-i}<12$) of entity types and spans; 
\item Compute the similarity (sigmoid of scalar product)
  between entity types and spans;
\item Return the highest scoring non-overlapping spans
  (you may also allow fully nested spans).
\end{compactitem}

The model is trained on Pile-NER
(50,000 texts from the Pile, annotated by ChatGPT, with open-ended entity types).
Implementation available in \texttt{gliner}.

\nextbook
\begin{book}
  \emph{UniversalNER: targeted distilation\\ from large language models\\ for open named entity recognition}\\
  W. Zhou et al.
\end{book}
\emph{Targeted} distillation of ChatGPT onto Llama for Open NER.

\nextbook
\begin{book}
