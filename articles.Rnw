\nextbook
\begin{book}
  \emph{Panning for gold: Model-X knockoffs for high-dimensional controlled variable selection}\\
  E. Cand\`es et al. (2017)
\end{book}
To select relevant variables in a model
$ Y \sim X $
while controlling the false discovery rate (FDR),
one could use \emph{conditional randomization}, \ie,
repeatedly sample $X_i^*$ from $X_i | X_{-i}$,
compute test statistics $T_i$ and $T_i^*$,
compare them, and use
\[ P = \dfrac{ 1 + \sum_k \mathbf{1} _{ T_i > T_i ^* } }{ 1 + K }. \]

This can be done with a single sample ($K=1$) with a \emph{knockoff distribution},
\ie, a distribution $(X,\tilde X)$  such that
\begin{compactitem}
\item[(i)]  $(X,\tilde X) \overset{d}{=} (X,\tilde X)_{\text{swap}(S)}$,
  where $S \subset \llbracket 1 , p \rrbracket$
  and $\text{swap}(S)$ swaps $X_j$ and $\tilde X_j$ for all $j \in S$
\item[(ii)] $\tilde X \indep X \mathrel{|} Y$ (e.g., $\tilde X$ is constructed without looking at $Y$
\end{compactitem}

For a Gaussian distribution, $X \sim N(0,\Sigma)$,
we can use
\[ (X , \tilde X ) \sim N \left(
0, \begin{pmatrix}
    \Sigma & \Sigma - \text{diag}(s) \\ \Sigma - \text{diag}(s) & \Sigma
\end{pmatrix}
\right)
\]
and sample from $\tilde X | X$, 
where $s$ is chosen so that the matrix be positive semi-definite;
we then have $\cor( X_j, \tilde X_j) = 1 - s_j$.
\begin{compactitem}[--]
\item Choose $\Sigma_{\text{approx}} \approx \Sigma$, e.g., $I$ or block-diagonal;
\item $\hat s = \argmin\limits_s \sum \va{ 1 - s_j} \text{ st } s \geq 0 ,\ 
  \text{diag}(s) \preccurlyeq 2 \Sigma_{\text{approx}}$;
\item $\gamma = \argmax\limits_\gamma \gamma \text{ st } \text{diag}(\gamma \hat s ) \preccurlyeq 2 \Sigma$;
\item $s = \gamma \hat s$.
\end{compactitem}

Use a statistic $W_j = w_j( X ,\tilde X, y) $ such that
\[
w_j\bigl( (X,\tilde X)_{\text{swap}(S)}, y \bigr) =
\begin{cases}
  + w_j(X, \tilde X, y ) & \text{if } j \not\in S \\
  - w_j(X, \tilde X, y ) & \text{if } j \in S 
\end{cases}
\]
for instance, a difference of lasso coefficients
\begin{align*}
  Z_j &= b_j(\lambda) \\
  W_j &= \va{ Z_j} - \va{ \tilde Z_j } \\
  \intertext{or}
  Z_j &= \max \{\, \lambda \,:\, b_j(\lambda) \neq 0 \,\} \\
  W_j &= \text{sign}\bigl( \va{Z_j} - \va{\smash{\tilde Z_j}\vphantom{Z_j}} \bigr)
  \max\bigl\{ \va{Z_j}, \va{\smash{\tilde Z_j}\vphantom{Z_j}} \bigr\}.
\end{align*}
Conditional on $\va{W_1},\dots,\va{W_p}$,
the signs of the null (\ie, irrelevant) $W_j$ are iid coin flips.
Estimate the false discovery proportion as
\[ \widehat{ \text{FDP} } (t) = \dfrac{
  \# \{ \, j \,:\, W_j \leq -t \}
}{
  \# \{ \, j \,:\, W_j \geq t \}
};
\]
set the threshold to
\[ \tau = \min \bigl\{ \, t > 0 \,:\, \widehat{\text{FDP}}(t) \leq q \,\bigr\} \]
and select the variables
$ \hat S = \{ \, j \,:\, W_j \geq \tau \,\} $:
this controls the modified FDR
\[ \text{mFDR} = \E \left[
  \dfrac{
    \bigl| \hat S \inter H_0 \bigr|
  }{
    \bigl| \hat S \bigr| + 1/q 
  }
  \right] \leq q
\]
(add 1 to the $\widehat{\text{FDR}}$ numerator to control the FDR).
R implementation: \texttt{knockoff}.

