\end{tikzpicture}
\qquad
\begin{tikzpicture}[>=stealth,yscale=1,xscale=1,inner sep = 2pt, outer sep = 0pt,baseline=-7]
  \node (A) at (0,0) {$A,S$};
  \node (B) at (1,0) {$B,S$};
