% Neural nets

\nextbook
\begin{book}
  \emph{DehazeNet: an end-to-end system\\ for single image haze removal} \\
  B. Cai et al.
\end{book}
Use a convolutional neural net with convolutions of different sizes and bilateral ReLUs
\begin{tikzpicture}[scale=.25]
\draw[ultra thick] (-1,0) -- (0,0) -- (1,1) -- (2,1);
\draw[thick,densely dotted] (-1,0) -- (2,0);
\draw[thick,densely dotted] (0,-.1) -- (0,1);
\end{tikzpicture}
to estimate the transmission map
(the haze intensity -- easy if you have a depth map)
and de-haze.
Commonly-used features include: 
\begin{compactitem}[--]
\item Dark channel, $D(x) = \min\limits_{ y \in N_x } \min\limits _{ x \in \{r,g,b\} } I_c(y)$,
  where $x$ is the pixel position and $N_x$ its neighbourhood
  (in haze-free patches, at least one colour channel is close to zero -- except the sky);
\item Maximum contrast $C(x) = \max\limits_{ y \in N_x} \sum\limits_{ z \in N_y } \n{ I(z) - I(y) }^2$;
\item Colour attenuation 
  $A(x) = I^{\text{value}}(x) - I^{\text{saturation}}(x)$;
\item  Hue disparity 
  $H(x) = \va{ I^{\text{hue}}_{\text{si}}(x) - I^{\text{hue}}(x) }$
  where 
  $I^{c}_{\text{si}}(x) = \max \{ I^{c}(x), 1 - I^{c}(x) \}$, 
  $c \in \{r,g,b\}$.
\end{compactitem}

