\]
  
\nextbook
\begin{book}
  \emph{D-CODE: discovering closed form ODEs\\ from observed trajectories}\\
  Z. Qian et al.
\end{book}
To find an ODE $\dot x = f(x)$
from trajectories $x$, when the data is noisy
and/or infrequently sampled
(so that we cannot reliably estimate $\dot x$ and use symbolic regression,
\texttt{gplearn}),
use the \emph{variational formulation} of $\dot x = f(x)$
(multiply by a test function $g$ such that $g(0) = g(T) = 0$,
integrate between 0 and $T$, integrate by parts to remove $\dot x$):
\[ C = \int_0^T x(t) \dot g(t) dt + \int_0^T f\bigl( x(t) \bigr) g(t) dr. \]
  
\nextbook
\begin{book}
  \emph{Understanding over-squashing and bottlenecks on graphs via curvature}\\
  J. Topping et al.
\end{book}
The \emph{balanced Forman curvature} of an edge $i$--$j$ counts:
\begin{compactitem}[--]
\item The number of triangles containing that edge (positive curvature);
\item The number of 4-cycles with no diagonal, containing that edge (zero curvature);
\item The number of remaining outgoing edges (negative curvature).
\end{compactitem}
Oversquashing is caused by negatively curved edges (bottlenecks).
\[
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=2pt,outer sep=1pt,baseline=0]
  \foreach \i in {0,...,4}
  \node[circle,fill,inner sep=1pt] at (90+72*\i : 1cm) {};
  \foreach \i in {0,...,4}
  \foreach \j in {0,...,4}
  \draw (90+72*\i : 1cm) -- (90+72*\j : 1cm);
  \node at (0,-2.5) {\footnotesize clique ($>0$)};
\end{tikzpicture}
\qquad
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=2pt,outer sep=1pt,baseline=0]
  \foreach \i in {-1,0,1}
  \foreach \j in {-1,0,1}
  \node[circle,fill,inner sep=1pt] at (\i,\j) {};
  \foreach \i in {-1,0,1} {
    \draw (-1.5,\i) -- (1.5,\i);
    \draw (\i,-1.5) -- (\i,1.5);
  }
  \node at (0,-2.5) {\footnotesize grid ($=0$)};
\end{tikzpicture}
\qquad\ 
\begin{tikzpicture}[>=stealth,scale=.3,inner sep=2pt,outer sep=0pt,baseline=0]
  \node[circle,fill,inner sep=1pt] (O) at (0,0) {};
  \node[circle,fill,inner sep=1pt] (A) at (90:1cm) {};
  \node[circle,fill,inner sep=1pt] (B) at (210:1cm) {};
  \node[circle,fill,inner sep=1pt] (C) at (330:1cm) {};
  \node[circle,fill,inner sep=1pt] (A1) at ($(A)+(90:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (A2) at ($(A)+(120:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (A3) at ($(A)+(60:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (B1) at ($(B)+(210:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (B2) at ($(B)+(240:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (B3) at ($(B)+(180:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (C1) at ($(C)+(-30:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (C2) at ($(C)+(0:1cm)$) {};
  \node[circle,fill,inner sep=1pt] (C3) at ($(C)+(-60:1cm)$) {};
  \draw (O) -- (A) -- (A1);
  \draw (O) -- (B) -- (B1);
  \draw (O) -- (C) -- (C1);
  \draw (A2) -- (A) -- (A3);
  \draw (B2) -- (B) -- (B3);
  \draw (C2) -- (C) -- (C3);
  \node at (0,-2.5) {\footnotesize tree ($<0$)};
\end{tikzpicture}
\]

To limit it, rewire the graph using the stochastic discrete Ricci flow (SDRF):
\begin{compactitem}[--]
\item Pick the edge $i$--$j$ with the minimum curvature;
\item Add the edge $k$--$\ell$ increasing the curvature the most,
  where $k$ and $\ell$ are neighbours of $i$ and $j$ (or $i$ and $j$ themselves);
\item Remove edges with curvature above some threshold.
\end{compactitem}

% TODO: PLOT

The \emph{Ollivier curvature} of an edge $i$--$j$ is
\[
\kappa(i,j) = \lim_{ \alpha \to 1 } \dfrac{
  1 - W_1( \mu_i^\alpha , \mu_j^\alpha )
}{ 1 - \alpha }
\]
where
\begin{compactitem}[--]
\item $\mu_i^\alpha$ is the measure on $B_1(i)$ (the ball of radius 1 centered on $i$,
  \ie, $i$ and its immediate neighbours)
  putting weight $\alpha$ on $i$ and $(1-\alpha)/d_i$
  on its neighbours;
\item $W_1$ is the Wasserstein distance (for the geodesic distance on the graph)
  \[ W_1( \mu_i, \mu_j ) = \inf_{ \substack{
      \sum\limits_k \! M_{kw} = \mu_j(w) \\
      \sum\limits_w \! M_{kw} = \mu_i(k)
  }}
  \sum_{k,w} M_{kw} d(k,w)
  \]
\end{compactitem}

The augmented \emph{Forman curvature} only considers triangles.
\[ F(i,j) = 4 - d_i - d_j + 3 \#_\Delta^{ij} \]

\nextbook
\begin{book}
  \emph{Rewiring networks for graph neural network training using discrete geometry}\\
  J. Bober et al.
\end{book}
Same algorithm, but the edge added is picked at random, using the softmax of the curvature improvement.

The \emph{Ricci flow} on a manifold
\[ \dfrac{ \partial g }{ \partial t } = - 2 \text{Ric}(g) \]
``smooths'' a manifold:
\[
