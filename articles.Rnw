% Networks in finance

\nextbook
\begin{book}
  \emph{Partial correlation analysis:\\ applications for financial markets} \\
  D.Y. Kenett et al. (2014)
\end{book}
The influence of a random variable $Z$ on the correlation between two random variables $X$ and $Y$ is 
\[ d(X,Y : Z ) = \rho(X,Y) - \rho(X,Y \mid Z ) \]
where 
\[
\rho(X,Y \mid Z) = \dfrac{
  \rho(X,Y) - \rho(X,Z) \rho(Y,Z)
}{
  \sqrt{
    \bigl(1 - \rho^2(X,Z)\bigr)
    \bigl(1 - \rho^2(Y,Z)\bigr)
  }
}.
\]
The average influence 
$ d(X : Z) = \langle d(X,Y : Z) \rangle_{Y \neq X} $
or
$ d(X) = \langle d(X : Z) \rangle_Z $
is asymptotically Gaussian 
and can be used in statistical tests.

For two dates, one can compute the rank correlation
$\cor( d_{t_1}(X), d_{t_2}(X) )$:
the corresponding date$\times$date matrix shows the market stability.

By looking at the influence of stocks $Y$ 
in a given sector $S_i$ on a stock $X$,
$ d(X:S) = \langle d(X : Y) \rangle_{Y \in S}, $
one can derive a finer sector decomposition,
adapted to companies spanning several sectors.

\nextbook
\begin{book}
  \emph{A multiple network approach\\ to corporate governance}\\
  F. Bonacina et al. (2014)
\end{book}

Eigenvalue centrality 
$x_i = \sum_j A_{ij} x_j$
can be generalized to directed graphs 
(\textsc{hits} algorithm,
identifying hubs and authorities)
\begin{align*}
a_j & = \sum_i A_{ij} h_i \\
h_i & = \sum_j A_{ij} a_i
\end{align*}
and directed graphs with coloured topics
\begin{align*}
a_j & = \sum_{ik} A_{ijk} h_i t_k \\
h_i & = \sum_{jj} A_{ijk} a_i t_k \\
t_k &= \sum_{ij} A_{ijk} a_j h_i.
\end{align*}
The \textsc{hits} authority $\mathbf a$ and 
hub $\mathbf h$ vectors are 
the first left and right singular vectors of $A$,
obtained from a low rank decomposition 
$ A \approx \sum_r \sigma_r u^{(r)} \circ v^{(r)} $
or the SVD decomposition $A = U D V'$ -- 
the next singular vectors can often be interpreted as well.

These decompositions can be generalized to tensors: 
parallel factor analysis 
$ A \approx \sum_r \sigma_r u^{(r)} \circ v^{(r)} \circ w^{(r)} $
or Tucker decomposition 
$A \approx G \times_1 U \times_2 V \times_3 W$.

In a financial context, one could look at 
the three following networks: 
\begin{align*}
  A_{ij1} &= \text{percentage of company $i$ owned by company $j$} \\
  A_{ij2} &= \text{number of directors sitting on both boards} \\
  A_{ij3} &= \mathbf 1_{ \cor(X_i,X_j) > 0.65 }.
\end{align*}

The various singular vectors correspond 
to various influence networks.

\nextbook
\begin{book}
  \emph{Inside the network: trading of inside and outside stocks by corporate insiders} \\
  H. Berkman et al. (2014)
\end{book}
Insiders central in the corporate network
earn higher returns when they buy or sell their stock,
or nearby stocks.
% Lots of holdings data in Finland.

\nextbook
\begin{book}
  \emph{A network approach to portfolio selection} \\
  G. Peralta and A. Zareei (2014)
\end{book}
Stocks with high centrality are more stable; stocks with low centrality bring higher diversification benefits.
Avoid stocks with extreme centrality: they are either too volatile or fail to bring any diversification benefit.

% Graph

\nextbook
\begin{book}
  \emph{Using friends as sensors\\ to detect global-scale contagious outbreaks} \\
  M. Garcia-Herranz et al. (2014)
\end{book}
Since the S-shaped cummulative epidemic curve is shifted 
left for more central nodes,
one can build an early-warning system
(here, for viral spread of hashtags on Twitter)
using a random sample of central nodes.
For instance,
one could take $n$ nodes at random
(control group) and then a random neighbour (followee) of each of them (sensor group -- they have higher centrality).

\nextbook
\begin{book}
  \emph{Common pitfalls\\ using the normalized compression distance:\\ what to watch out for in a compressor} \\
  M. Cebri\'an et al. (2005)
\end{book}
The (incomputable) 
normalized information distance (NID)
is 
\[
\text{NID}(x,y) = \dfrac{
  \max\{\, K(x|y) - K(x),\  K(y|x) - K(y) \,\}
}{
  \max\{\, K(x),\  K(y) \,\}
}
\]
where the conditional Kolmogorov complexity 
$K(x|y)$ is the length of the shortest program 
that outputs $x$ when fed $y$,
and $k(x) = k(x|\nothing)$.

The normalized compression distance is
\[
\text{NCD}(x,y) = \dfrac{
  \max\{\, C(xy) - C(x),\  C(yx) - C(y) \,\}
}{
  \max\{\, C(x),\  C(y) \,\}
}
\]
where $C(x)$ is the length of $x$ after compression
with your favourite algorithm
(bzip2 (Burrow-Wheeler transform),
gzip (LZ77),
PMZZ (Markov model)).
To really have a distance, one needs
$C(xx) = C(x)$ or, at least,
$C(xx) = C(x) + O( \log \va x )$ -- 
but if $xx$ exceeds the block size, this is not guaranteed.

\nextbook
\begin{book}
  \emph{Clustering by compression} \\
  R. Cilibrasi and P.M.B. Vit\'anyi (2005)
\end{book}
Initial article on NCD, with applications to clustering.

Implementation: \texttt{complearn-gui}.

\nextbook
\begin{book}
  \emph{The Google similarity distance} \\
  R. Cilibrasi and P.M.B. Vit\'anyi (2007)
\end{book}
Let $N_{\{x,y\}}$
be the number of web pages containing both $x$ and $y$,
according to Google.
Define a probability distribution on all singletons and doubletons of search terms by 
$g(\{x,y\}) \propto N_{\{x,y\}}$
(allowing $x=y$).
The Google code is then 
$G(x,y) = - \log g(\{x,y\}) = - \log N_{\{x,y\}} + \log N$
and $G(x) = G(x,x)$.
The normalized Google distance is another approximation of the NID: 
\begin{align*}
NGD(x,y) &= \dfrac{
  G(x,y) - \min \{ G(x) , G(y) \} 
}{
  \max \{ G(x) , G(y) \}
} \\
&= \dfrac{
  \log \max \{ N_x, N_y \} - \log N_{xy} 
}{
\log N - \log \min \{ N_x, N_y \}
}
\end{align*}
We do not know $N$, 
but the results do not seem very sensitive to it: 
\[
\# \text{pages} \leq N \leq 
\# \text{words per page} \times 
\# \text{pages}.
\]

\nextbook
\begin{book}
  \emph{Cross-firm information flows\\ and the predictability of stock returns} \\
  A. Scherbina and B. Schlusche (2013)
\end{book}
Test for Granger causality 
\begin{align*}
  x &\sim \text{lag}(x) + \text{lag}(y) + \text{lag}(\text{market}) \\
  y &\sim \text{lag}(x) + \text{lag}(y) + \text{lag}(\text{market})
\end{align*}
for all pairs of stocks on a moving window 
(12 or 36 months, or 52 weeks)
to identify leaders ($p < 5\%$ -- 
you may want to control for multiple testing).

For each stock with leaders,
forecast the returns 
from the past returns of the leaders 
(using the previous regression --
there is one forecast per leader)
and invest if most leaders agree.

Beware of non-synchronous trading.

Other signs of leadership include: 
analyst coverage, institutional ownership,
trading volume,
increased news coverage 
(but when the coverage is too high,
the company ceases to be a leader: 
information spreads almost instantly).

% Graph, Fin
\nextbook
\begin{book}
  \emph{Exploring multi-layer flow network\\ of international trade based on flow distances} \\
  B. Shen et al. (2015)
\end{book}
After adding source and sink nodes 
to the world trade flow network
(for some commodity)
to ensure that the net flow through each node is zero, one can compute distances: 
\begin{compactitem}[--]
\item Expected first passage time;
\item Expected (not only first) passage time
  (only well-defined for open flow networks, 
  \ie, with source and sink);
\item The symmetrization of those, e.g., using a minimum or a harmonic mean: 
\[ 
  \min(d_{ij}, d_{ji}), 
  \quad
  \dfrac{ 
    2 d^\alpha_{ij} d^\alpha_{ji} 
  }{ 
    d^\alpha_{ij} + d^\alpha_{ji}
  }.
\]
\end{compactitem}
The \emph{trophic level} of a node 
is the (first passage) distance from the source. 

% Text, Finance
\nextbook
\begin{book}
  \emph{The tone of financial news\\ and the perceptions of stock and CDS traders} \\
  M. Liebmann et al. (2014)
\end{book}
One can estimate the relation between news 
(they are often already tagged, 
e.g., ``results'' or ``debt/credit'')
and returns
(for different assets, e.g., stocks and CDS)
using a Naive Bayes classifier,
\ie, by looking at the words one by one and keeping the most relevant, e.g., 
\[ 
\text{Tone}(w) = 
\dfrac{ P(+|w) }{ P(+) } -
\dfrac{ P(-|w) }{ P(-) }.
\]
One could also use association rule mining 
[mentioned, not tried -- should not work well]
or logistic regression 
[not mentioned -- should work with a penalty and word pairs].

Commonly-used lexicons do not work well 
in a financial context
(e.g., ``cancer'' is usually negative,
but neutral in a financial context):
one needs a bespoke or dynamic lexicon.

%% 2015-06
%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%
%%

\nextbook
\begin{book}
  \emph{Generalized low-rank models} \\
  M. Udell et al. (2014)
\end{book}

This is one of the first papers introducing 
a statistical algorithm with an implementation, 
not in R, Python, Matlab or C, 
but in (both) Julia and Spark.

Principal component analysis (PCA) 
of $A \in \mathscr M_{mn}$, 
\begin{align*}
(X,Y) &= \argmin_{\substack{
  X \in \mathscr M_{mk} \\
  Y \in \mathscr M_{nk}
}}
 \n{ A - X Y' }_F^2 \\
 &=
\argmin_{X,Y}
\sum_{ij} ( A_{ij} - x_{i \cdot} y_{j \cdot}' )^2 
\end{align*}
can be generalized to 
\[
\argmin_{X,Y} \sum_{(i,j) \in \Omega}
\!\!\text{Loss}( x_{i\cdot} y_{j\cdot}', A_{ij} ) +
 \sum_i r( x_{i \cdot } ) + 
 \sum_j s( y_{j \cdot } ).
\]

Here are a few examples, for the penalty terms: 
\begin{compactitem}[--]
\item Low-rank matrix completion: 
  $\Omega \subsetstr 
  \llbracket 1, m \rrbracket \times 
  \llbracket 1, n \rrbracket $;
\item  Quadratically-penalized PCA: 
  $r = s = \n{ \cdot }_2^2 $;
\item Non-negative matrix factorization: 
  $r(x) = I_{ \forall j \, x_j \leq 0 }$
  where 
  \[
  I_{\text{condition}} = \left\{ \begin{array}{ll}
    0 & \text{if condition is true} \\
    \infty & \text{otherwise};
  \end{array}\right.
  \]
\item Sparse PCA: 
  $r(x) = I_{ \# \{ j : x_j \neq 0 \} \leq s}$
  or its $L^1$ relaxation $r=\n{\cdot}_1$;
\item  Quadratic clustering ($k$-means): 
  $r(x) = I_{ \exists \ell: x = e_\ell }$,
  where the $e_\ell$ are the basis vectors;
\item Quadratic mixtures: $r(x) = I_{x \in \Delta}$,
  where $\Delta$ is the standard simplex;
\item Subspace clustering 
  (approximation of the data as a union 
  of low-dimensional subspaces): 
  partition the columns of $x$ into blocks and set 
$r(x) = I_{\text{at most one block has nonzero entries}}$;
\item Feature selection: 
  $r(x) = \n{\cdot}_2^2$, 
  $s(y) = \n{\cdot}_2$ (not $\n{\cdot}_2^2$),
  to make $y$ column-sparse (most columns are zero);  
\item Supervised learning;
\item Dictionary learning: 
  $r=\n{\cdot}_1$ to enforce sparsity 
  and $s=\n{\cdot}_2^2$ 
  (to ensure the problem is well-posed 
  when $k \gg m,n$).
\end{compactitem}

Here are a few examples for the loss function: 
\begin{compactitem}[--]
\item Robust PCA: 
\[ 
  \argmin \n{A - XY'}_1 + \gamma \n{X}_F^2 + \gamma\n{Y}_F^2;
\]
\item Weighted PCA: $L_{ij}(u,a) = w_{ij}(u-a)^2$;
\item Huber PCA: $L(u,a)=\text{huber}(u-a)$, where 
\[
  \text{huber}(x) = \left\{ \begin{array}{ll}
    \tfrac12 x^2     & \text{if } \va x \leq 1 \\
    \va x - \tfrac12 & \text{if } \va x \geq 1
  \end{array} \right.
\]
\item Quantile PCA (if the cost of under- and over-estimating $A$ is different: 
$L_{ij}(u,a) = \lambda(u-1)_+ + (1-\lambda) (u-a)_-$;
\item Divergences: 
  \begin{align*}
  L_{\text{KL}}(u,a) &= a \log \dfrac au - a + u \\
  L_{\text{IS}}(u,a) &= a \log \dfrac au - 1 + \dfrac au \\
  L_{\beta}(u,a) &= 
  \dfrac{ a^\beta }{ \beta(\beta-1) } + 
  \dfrac{ u^\beta }{ \beta } -
  \dfrac{ a u^{\beta-1} }{ \beta - 1 };
  \end{align*}
\item Boolean PCA: 
  $L(u,a) = (1-ua)_+$ with $a \in \{0,1\}$
  (hinge loss);
\item Logistic PCA
  $L(u,a) = \text{softplus}(-au) = \log(1+e^{-au})$,
  with $a \in \{0,1\}$;
\item Poisson PCA
  $L(u,a) = e^u - au + a \log a - a = L_{\text{KL}}(e^u,a)$,
  with $a \in \NN$ (count data);  
\item Ordinal PCA 
  \[
  L(u,a) = \sum\limits_{b<a} (1-u+b)_+ + 
           \sum\limits_{b>a}(1+u-b)_+;
  \]
\item Interval PCA
  $L(u,[a,b]) = \max\{ (a-u)_+, (b-u)_+ \}$;
\item Categorical PCA
  \[ L(u,a) = (1-u_a)_+ + \sum_{b\neq a} (1+u_b)_+, \]
  where $a \in \llbracket 1, k \rrbracket$
  and $u \in \RR^k$, \ie, 
  we consider a block of $k$ columns of $Y$ at a time;
\item Ordinal PCA $L(u,a) = \sum_b  ( 1 - I_{a>b} u_b )_+$;
\item Permutation PCA
  $L(u,a) = \sum_i (1 - u_{a_i} + u_{a_{i+1}} )_+$;
\item Ranking PCA
$L(u,a) = \sum_{i<j} (1-u_{a_i} + u_{a_j} )_+$.
\end{compactitem}

The problem is not convex, but often \emph{biconvex}
(convex in one variable when the other is fixed)
and can be solved by \emph{alternating minimization}
(alternatively minimize wrt one variable 
with the other fixed).
Each step is easy to parallelize:
treat the rows of $X$ separately.
We do not need the exact minimum at each iteration: 
a single step in the right direction is often enough.

To deal with non-finite regularization terms,
one can use the \emph{proximal gradient} method: 
\begin{align*}
  g_1 &= \sum_{ j : (i,j) \in \Omega } 
  \nabla \text{Loss}( x_i y_j, A_{ij} ) y_j \\
  x_i &\leftarrow \text{prox}_{\alpha r} ( x_i - \alpha g_i )
\end{align*}
where $\text{prox}_f(z) = \argmin_x f(x) + \tfrac12{x-z}^2$
and $\alpha = 1/k$ (for the $k$th iteration) 
or $\alpha = 1 / \n{g_i}_2$.

Stochastic gradient can help.

Careful initialization (e.g., SVD, k-means++) is important.

\nextbook
\begin{book}
  \emph{Adaptive subgradient methods for online learning and stochastic optimization} \\
  J. Duchi et al. (2010)
\end{book}
Gradient descent is the iterative algorithm 
\[ x_{n+1} \leftarrow x_n - \eta g_n, \]
where $\eta$ is the learning rate and
$g_n$ the gradient (or a subgradient) of the loss function.

Projected gradient descent adds a constraint 
$x \in \mathcal X$: 
\[ x_{n+1} \leftarrow \argmin_{ x \in \mathcal X} 
\n{ x - (x_n - \eta g_ n) }^2_2. \]
One can give more importance to the directions in which the gradient is larger: 
\[ x_{n+1} \leftarrow \argmin_{x \in \mathcal X}
\n{
  x - (x_n - \eta G_n^{1/2} g_ n) 
}_{G_n}^2
\]
where 
$ G_n = \sum_{1 \leq k \leq n } g_k g'_k $
or 
$ G_n = \sum \diag g_k g'_k $
and $\n{x}_G^2 = \langle x, x \rangle_G = \langle x, Gx \rangle$ defines the Mahalanobis norm.

The proximal gradient is 
\[ x_{n+1} \leftarrow \argmin_{x \in \mathcal X} 
\eta \langle g_n, x \rangle +
\eta \phi(x) + 
B_{ \psi_n }( x, x_n )
\]
where 
$\psi_n = \psi$
or $\psi_n = n \phi$
or $\psi_n = \sqrt n \psi$
or $\psi_n(x) = \n{ x } _{ \delta I + G_n^{1/2} }$
or $\psi_n(x) = \n{ x } _{ \delta I + \diag G_n^{1/2} }$
and \[
  B_\psi(x,y) = 
  \psi x - \psi y - \langle \nabla \psi y, x-y \rangle
\] 
is the Bregman divergence.
The first term pulls $x$ in the direction $-g_n$,
as much as allowed by the other terms; 
the second is a regularization; 
the third forces $x$ to be close to $x_n$.  

\nextbook
\begin{book}
  \emph{Identifying and attacking\\ the saddle point problem\\ in high-dimensional non-convex optimization} \\
  Y.N. Dauphin et al.
\end{book}
In high dimension, the local minima 
(of a draw of a Gaussian process)
are very close to the global minimum,
but there are many critical points far away from the minima
(to see it: plot the value of the objective function 
at critical points 
versus the proportion of negative eigenvalues).
They are surrounded by plateaus,
on which gradient methods get stuck. 
Newton methods are even worse: 
the saddle points are attractive 
(Newton methods assume there are no negative eigenvalues 
and end up going in the wrong direction).

\emph{Trust region} methods (minimize a first 
or second order approximation of the objective,
with a constraint on the distance from the previous point)
%-- this is not unlike momentum
fare better.
One can ``fix'' the Newton method for saddle points by replacing the eigenvalues of the Hessian by their absolute values (saddle-free Newton method).
This is actually a trust region method, 
using $\va H$ as a distance,
and a first-order approximation.
In high dimension, 
one can stay on a Krylov subspace
(a subspace of the form 
$\Span \{ x, Hx, \dots, H^kx \}$,
for some $x$ -- this approximates the subspace 
spanned by the most important eigenvectors).

\nextbook
\begin{book}
  \emph{Fast large-scale optimization by unifying stochastic gradient and quasi-Newton methods} \\
  J. Sohl-Dickstein et al. (2014)
\end{book}
Combine the mini-batches of stochastic gradient descent 
with the approximate Hessian
(and absence of hyper-parameters) 
of quasi-Newton methods by keeping track 
of the (compressed) approximate Hessian 
of each mini-batch separately 

\nextbook
\begin{book}
  \emph{Deep learning with elastic averaging SGD} \\
  S. Zhang et al. (2015)
\end{book}
To parallelize stochastic gradient descent (SGD),
add an $L^2$ penalty for the distance to some central, reference value,
updated only once in a while -- only send updates to the parameter server for parameters that have drifted enough from their initial values.

% Older summary
More precisely, replace the problem 
\[
\begin{array}{ll}
  \text{Find} & x \\ 
  \text{To minimize} & f(x)
\end{array}
\]
with 
\[
\begin{array}{ll}
  \text{Find} & x, x_1, \dots, x_n \\ 
  \text{To minimize} & \sum f(x_i) + \rho \sum \n{ x - x_i } ^2\\
  \text{Such that} & \forall i \ x_i = x.
\end{array}
\]
For the implementation, ignore the constraint; 
worker~$i$ knows $x_i$ and $x$, 
and can compute the contribution of $x_i$ to the gradient; 
to update $x$, 
the workers need to combine their knowledge 
(this can be done asynchronously).

\nextbook
\begin{book}
  \emph{Bayesian optimization in a billion dimensions via random embeddings} \\
  Z. Wang et al.
\end{book}
Bayesian optimization works best in low dimensions: 
in high dimensions,
project on a random subspace -- 
if the intrinsic dimension of the problem is low, 
this is good enough.

\nextbook
\begin{book}
  \emph{Practical Bayesian optimization\\
  of machine learning algorithms} \\
  J. Snoek et al.
\end{book}
Bayesian optimization is a class of optimization algorithms
tha looks for the minimum of an expensive function; 
contrary to other optimization algorithms, 
it keeps (and uses) all the previous function evaluations.

For instance, one can model the function as a 
\emph{Gaussian process} (GP),
often with a \emph{Matern $5/2$ kernel}
(this makes the function a.s. $\mathscr C^2$, 
but not more) and choose the next point to evaluate
by maximizing 
\begin{compactitem}[--]
\item The probability of improvement, 
  \[ \text{PI}(x) = P[ y(x) \geq \text{best} ]; \]
\item The expected improvement, 
  \[ \text{EI}(x) = E[ (y(x) - \text{best})_+ ]; \]
\item The upper confidence bound, 
  $\text{LCB}(x) = \mu_x - \kappa \sigma_x$,
  where $y(x) \sim N( \mu_x, \sigma_x)$.
\end{compactitem}
(Prefer the expected improvement.)

Possible improvements include: 
\begin{compactitem}[--]
\item Modeling the (log-)duration function as well, 
and minimizing the expected improvement per second; 
\item Running several function evaluations in parallel 
  and maximizing the expected improvement 
  over all possible outcomes of the pending evaluations. 
\end{compactitem}

\nextbook
\begin{book}
  \emph{Hyperopt: a Python library\\ for optimizing the hyperparameters\\ of machine learning algorithms} \\
  J. Bergstra et al. (2013)
\end{book}
If you need to minimize an expensive function,
some of whose arguments may be discrete 
(you need to provide a prior on the parameters, 
not just bounds).
Also check spearmint.

\nextbook
\begin{book}
  \emph{Continuous global optimization in R} \\
  K.M. Mullen (2014)
\end{book}
Big list of \emph{global} optimization algorithms
available in R, \ie, 
algorithms robust to local minima
(simulated annealing, genetic algorithms, 
particle swarm optimization, 
brancg-and-bound, \textsc{direct}, etc.),
with tests on 50 different problems 
(in the \texttt{globalOptTests} package): 
prefer
\texttt{nloptwrap::stogo} 
(very slow, unless you provide an analytic gradient),
\texttt{rgenoud::genoud},
\texttt{GenSA}.

\nextbook
\begin{book}
  \emph{On best practice optimization methods in R} \\
  J.C. Nash (2014)
\end{book}
The \texttt{optreplace} package replaces the default optimization algorithms in \texttt{optim}: 
\begin{compactitem}[--]
\item \texttt{dfoptim::nmkb} instead of \texttt{Nelder-Mead};
\item \texttt{Rcgmin} instead of \texttt{CG};
\item \texttt{Rvmmin} instead of \texttt{BFGS} or
  \texttt{L-BFGS-B}
  (but it uses a full Hessian, not a low-memory approximation);
\end{compactitem}
\texttt{nls} is not replaced, 
but \texttt{nmlrt} is a robust alternative.

Diagnostics are often lacking 
(there are some in \texttt{optimx}).

Stochastic optimization (SANN, DEoptim), 
constrained optimization (constrOptim),
fuzzy optimization
deserve attention.

Representative/benchmark problems are needed (those in NISTnls/NISTopt are ``extreme'').

\nextbook
\begin{book}
  \emph{Convex optimization in R} \\
  R. Koenker and I. Mizera (2014)
\end{book}

Long list of applications of convex programming 
in statistics:
\begin{compactitem}[--]
\item Median regression;
\item Quantile regression;
\item Hinge regression 
(or other piecewise linear convex loss functions);
\item Huber $M$-estimators (the loss function is quadratic
when the residuals are small, linear when they are large);
\item Penalized quantile regrsssion;
\item Support vector machines (hinge loss and $L^2$ penalty)
  (\texttt{kernlab});
\item Random linear constraints,
  $ P[ a_i' x \leq b_i ] \geq \eta, $
  where $a_i \sim N(\alpha_i, \Omega_i)$ are random variabes;
\item Square root lasso, group lasso;
\item Convex regression.
\end{compactitem}

Matrix completion and robust PCA 
can be expressed with matrix norms 
such as the spectral norm (largest eigenvalue) 
or the nuclear norm (sum of the singular values). 

Interior point methods usually replace 
linear inequality constraints with \emph{log-barriers}.
For proper cones, one can use a \emph{generalized log}
$\lambda: K \to \RR$, 
$\mathscr C^2$, 
with $\nabla^2 \lambda \prec_{\text{psd}} 0$ 
(\ie, concave), such that 
\[
\exists \theta \quad 
\forall x \succ_K 0 \quad
\forall y \succ^{\mathstrut}_{\RR_+} 0 \quad
\lambda(yx) = \lambda(x) + \theta \log y.
\]
For instance, 
\begin{align*}
  \lambda(x) &= \sum_i \log x_i && \text{for } K = \RR_+^n \\
  \lambda(x) &= \log( x_0^2 - \n{ x_{1:n} }^2 ) 
             && \text{for } 
             K = 
       \{ x \in \RR^{n+1} : \n{x_{1:n}} \leq x_0 \}\\
       %[ \n{x_{1:n}} \leq x_0 ] \subset \RR^{n+1} \\
  \lambda(A) &= \log \va A  && \text{for } K = \mathcal S_n^+   
\end{align*}

Interior point methods work best when the Hessian 
(of the objective function plus the barrier) 
is sparse, e.g., when the problem is 
\emph{additively separable}.

After discretization, infinite mixture models
(Kiefer-Wolfowitz)
\[ \begin{array}{ll}
  \text{Find} & f \\
  \text{To minimize} & \sum_i \log g_i \\
  \text{Such that} & g = A f, \ f \geq 0, \ f' \mathbf 1 = 1
\end{array} \]
(where
$A_{ij} = \phi(x_i,\theta_j)$,
the $\theta_j$ are on a fine grid,
the $x_i$ are the observations
and $\phi(\cdot,\theta_j)$ 
the probability distribution functions being mixed)
or penalized/constrained density estimation problems 
are convex
and additively separable
(the penalty could be 
$\int (\sqrt f)'$,
$\int (\log f) '' {}^2$,
$\int \va{ ( \log f ) '' }$;
the constraint could be ``$f$ log-concave'').
Many of these are implemented in \texttt{REBayes},
but it unfortunately relies on Mosek.

\nextbook
\begin{book}
  \emph{trustOptim: an R package for trust region optimization with sparse Hessians} \\
  M. Braun (2014)
\end{book}
\emph{Trust region optimization}
minimizes a second order approximation 
of the objective function 
in a small region around the current point 
(it is similar to sequential quadratic optimization,
but with constraints, to avoid moving too fast --
and it does not misbehave in presence 
of indefinite Hessians);
if the approximation is not good at the new point, 
of if it does not bring any improvement, shrink the region;
if the new point is on the boundary, expand the region.

This is implemented in the \texttt{trust} package,
but the algorithm does not scale well 
if the Hessians are dense:
\texttt{trustOptim} uses the same idea with sparse Hessians
(either provide the sparsity structure 
and use numeric differentiation, 
or provide an analytic Hessian, 
e.g., from \texttt{CppAD} or \texttt{R2admb}).

\nextbook
\begin{book}
  \emph{Square root lasso: pivotal recovery of sparse signals via conic programming} \\
  A. Belloni et al. 
\end{book}

The square root lasso is 
\[ \argmin_\beta \n{ y - x' \beta }_2 + \lambda \n\beta _1;\]
while the lasso is 
\[ \argmin_\beta \n{ y - x' \beta }_2^2 + \lambda \n\beta _1.\]
% Technical, not read in detail

\nextbook
\begin{book}
  \emph{Spectral projected gradient methods:\\
  review and perspectives} \\
  E.G. Birgin (2014)
\end{book}
The spectral projected gradient 
(SPG, implemented in \texttt{BB::BBoptim}),
combines (projected) gradient descent
and secant methods.
\emph{Secant methods} approximate the gradient $\nabla f$
with an affine function 
$x \mapsto \phi(x) = a + Bx$,
using the last two points,
\begin{align*}
  \phi( x_{n-1} ) &= a + B x_{n-1} = \nabla f x_{n-1} \\
  \phi( x_{n}   ) &= a + B x_{n}   = \nabla f x_{n}
\end{align*}
\ie, 
\begin{align*}
  B ( x_n - x_{n-1} ) &= \nabla f x_n - \nabla f x_{n-1} \\
  a &= \nabla f x_n - B x_n 
\end{align*}
(there are many such functions).
The BB method tries to use $B = \sigma I$; 
this is usually mot possible,
but the least squares approximation is good enough: 
\begin{align*}
  \sigma &= \dfrac{
  \langle 
    \text{previous step}, 
    \text{change in gradient}
  \rangle
  }{
    \text{previous step size}
  } \\
  \sigma_{n+1} &= \dfrac{
    s_n ' y_n
  }{
    s_n ' s_n
  } \\
  s_n &= x_n - x_{n-1} \\
  y_n &= \nabla f x_n - \nabla f x_{n-1}.
\end{align*}

Spectral methods use this step,
multiplied by some coefficient,
adjusted to ensure that the objective function 
improves every $M$ steps 
(not at every step -- it is a non-monotonic method).

\nextbook
\begin{book}
  \emph{What is... a spectrahedron?} \\
  C. Vinzant
\end{book}
The positive semidefinite cone.

\nextbook
\begin{book}
  \emph{AD model builder: using automatic differentiion 
  for statistical inference of highly parameterized 
  complex nonlinear models} \\
  D.A. Fournier et al. (2011)
\end{book}
Automatic differentiation (AD) 
differentiates a function written in C++ as follows:
\begin{compactitem}[--]
\item Evaluate the function and keep track 
  of all the floating point operations performed;
  if there are loops or conditionals, expand them -- 
  the sequence of operations need not always be the same;
\item Iteratively compute either 
  $\partial t_j / \partial x_i$ 
  (forward mode)
  or $\partial f / \partial t_i$
  (reverse mode, aka, back-propagation),
  where the $t_i$ are the intermediate results; 
  reverse mode if more efficient.
\end{compactitem}
ADMB provides a C++-like DSL to specify a function 
and uses a quasi-Newton algorithm 
with the gradient from AD 
to minimize it. 
It also provides diagnostics useful in statistics: 
inverse of the information matrix 
(\ie, variance of the estimated parameters), 
profile likelihood, 
MCMC samples from the posterior distribution 
of the parameters
(for the Hessian, they use finite differences: 
the code generated by AD is often 
``ludicrously obfuscated'' and AD tools 
``frequently cannot differentiate 
the code they produce,
so you are usually limited to derivatives of order 1'').
% Source: SciComp Stack Exchange

\nextbook
\begin{book}
  \emph{Using AD model builder and R together: 
  getting started with the R2admb package} \\
  B. Bolker (2013)
\end{book}
If you write down the likelihood of your model yourself,
want to use gradient-based optimization methods,
but your model is too complex 
to have its gradient computed by hand 
or for numeric differentiation to be useful,
\texttt{R2admb} can compute the (analytic) gradient for you 
and optimize the log-likelihood. 
It generates the usual diagnostics 
(AIC, vcov, profile likelihood)
and (MCMC-based) posterior parameter distributions.
It needs ADMB (free, but has to be installed separately)
and a C++ compiler,
and forces you to write the log-likelihood in C++.
There does not seem to be a way of accessing 
the (compiled, analytic) gradient directly. 

Also check \texttt{glmmADMB} --
\texttt{PBSadmb} % (with a Tk GUI that seems to only allow you to enter file names)
and 
\texttt{ADMB2R} %(old).
are older.

In Python, check PyAutoDiff (it uses Theano, 
and can therefore leverage GPUs).

\nextbook
\begin{book}
  \emph{Getting things in order:\\ 
  an introduction to the R package seriation} \\
  M. Hahsler et al. 
\end{book}
To reorder the rows and columns of a matrix, 
e.g. a dissimilarity matrix (in R: \texttt{seriation}): 
\begin{compactitem}[--]
\item Try to minimize the number of inversions 
  in each row and column; 
\item Find a Hamiltonian path on the distance matrix (TSP);
\item Minimize the moment of inertia around the diagonal 
  $\sum_{ij} d_{ij} \va{i-j}$;
\item Make the dissimilarities close to 
  the distance to the diagonal, 
  \ie, $d_{ij} \approx \va{i-j}$
  (find $\sigma \in \mathfrak S_n$ 
  to minimize the sum of squares 
  $\sum_{ij} ( d_{ij} - \va{i-j} )^2$);
\item Ensure similar values are close together
  by minimizing 
  $\sum\limits_p \sum\limits_{q \in \text{Neigh}(p)} (x_p - x_q)^2$,
  using 4- or 8-element neighbourhoods;
\item Use the first principal component;
\item Compute a hierarchical clustering 
  and apply some heuristic 
  to select an ordering compatible with it 
  (in R: \texttt{gclus}).
\end{compactitem}
Few of those methods can be generalized
to rectangular matrices and, in this case, 
rows and columns are often treated independently. 

\nextbook
\begin{book}
  \emph{Generalized association plots:\\
  information visualization\\
  via iteratively generated correlation matrices} \\
  C.H. Chen
\end{book}
Take the correlation matrix of the columns of a correlation matrix, and iterate.

On the first two principal components, 
  the points form an ellipse;
  the linear order on this ellipse can be used 
  to solve seriation problems
  (``rank-2 ellipse seriation'').
  
After a few more iterations, 
  the matrix often only has $\pm1$ entries 
  and only two different columns; 
  the observations can be split into two groups; 
  recursively iterating gives a hierarchical clustering.
  [This assumes the matrix has no symmetries, \ie,
  its stabilizer for the action 
  $\sigma \cdot A = (A_{\sigma i, \sigma j})_{ij}$
  is trivial.]

\nextbook
\begin{book}
  \emph{Package hdlm: regression tables\\
  for high-dimensional linear model estimation} \\
  T.B. Arnold 
\end{book}
It is often claimed that penalized regression 
does not provide $p$-values
or confidence intervals -- but one can use a 2-step approach: 
\begin{compactitem}[--]
\item Fit a \emph{sparse} model
  (least squares with lasso, quantile regression with lasso, 
  Dantzig selector, etc.)
  on part of the data
  (be conservative: we want to keep all the variables 
  in the true model with high probability);
\item Fit this smaller model 
  on another (independent) part of the data,
  and compute $p$-values and confidence intervals.
\end{compactitem}

The \texttt{hdlm} package also bootstraps 
the $p$-values and corrects them (by taking 
the median).

\nextbook
\begin{book}
  \emph{Exact and approximate area-proportional
  circular Venn and Euler diagrams} \\
  L. Wilkinson (2012)
\end{book}
To plot an Euler diagram, 
representing the intersections of $n$ sets, 
with circles: 
\begin{compactitem}[--]
\item Encode all possible intersections as 
$n$-bit binary numbers
(e.g., $Y_{1101} = X_1 \inter X_3 \inter X_4$);
use the same numbering for the disjoint sets,
$Z_k = Y_k \setminus
\bigcup\limits_{\ell : Y_\ell \subsetstr Y_k}
Y_\ell$;
\item Define the loss as 
$\sum ( \text{area} - \text{desired area} )^2 $,
where the sum is over the disjoint sets; 
\item Estimate those areas using either 
  exact computations (compute pairwise intersections,
  compute the area of the polygon and the lunes),
  polygon approximations of the circles 
  or a bitmap approach (discretize the circles into pixels);
\item For the initial guess, use the desired disk areas
and place them using multidimensional scaling (MDS)
on the Jaccard distance matrix
$d_{ij} = \va{ X_i \inter X_j} / \va{ X_i \union X_j}$;
\item In the optimization, only move the circle centers, 
  first using an (analytical) approximate gradient 
  with a small learning rate, them a numeric gradient.
\end{compactitem}
In R, this is implemented in the \texttt{venneuler} package.

\nextbook
\begin{book}
  \emph{Visualizations with Venn and Euler diagrams} \\
  L. Micallef
\end{book}
A polygonal Euler diagram can be drawn with a force-directed layout, with attractive and repulsive forces, not only between vertices, but also between edges and polygons.
% No details.

\nextbook
\begin{book}
  \emph{Statistical computing 
  in functional data analysis: 
  the R package fda.usc} \\
  M. Febrero-Bande and M. Oviedo de la Fuente% (2013)
\end{book}
The \texttt{fda.usc} package 
builds on the other functional data analysis (FDA) packages
(\texttt{fda}, \texttt{ftsa}, \texttt{rainbow},
\texttt{fpca}, \texttt{MFDF}, \texttt{fdaMixed})
and provides an abstraction for functional objects 
(an \texttt{fdata} type)
aimed at making functional data manipulations 
as easy as categorical variable manipulations 
(with the \texttt{factor} abstraction).
It provides: 
\begin{compactitem}[--]
\item Conversion methods from \texttt{fdata}: 
basis expansion, non-parametric kernel smoothing 
(\texttt{min.basis}, \texttt{fdata2fd}, \texttt{min.np});
\item $L^p$ distances, semi-metrics 
  ($L^p$ distance between the $k$th derivatives);
\item Depth computations 
  (the average distance between a given observation 
  and all the (other) observations -- 
  it is minimum for the median) 
  and the corresponding measures of location and dispersion;
  they can also be used for outlier detection;
\item Smoothed bootstrap; 
\item Regression with scalar response 
  and functional covariates, 
  with cross-validation 
  and influence measures (Cook's distance).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Online prediction under model uncertainty\\
  via dynamic model averaging:\\
  application to a cold rolling mill} \\
  A.E Raftery et al. (2010)
\end{book}
Dynamic model averaging (DMA) generalizes 
Bayesian model averaging (BMA) to time-varying models.
Given $n$ time-varying models
(e.g., a time-varying regression, 
which can be fitted with a Kalman filter),
assume that the data may come 
from a different model at each point in time,
and that the correct model changes 
according to a Markov chain; 
model the correct model as 
the hidden state in a hidden Markov model (HMM); 
use the state probabilities as weights 
when averaging the $n$ models.

\nextbook
\begin{book}
  \emph{White noise and simulation\\ 
  of ordinary Gaussian processes} \\
  B. Puig and F. Poiron 
\end{book}
\emph{White noise} can be defined as a 
\emph{generalized process}
(the stochastic analogue of a tempered distribution),
\ie, a continuous linear form on the Schwartz space $S$ 
(the space of rapidly-decreasing functions $\phi$: 
$\forall \alpha, \beta \  
\sup_x \va{ x^\alpha D^\beta \phi } < \infty$);
it is entirely defined by its characteristic function 
\[ C(\phi) = \int_\Omega e^{i X_\phi} dP = 
\int_{S'} e^{ i \langle \omega, \phi \rangle } d\mu(\omega)
= \exp -\tfrac12 \n{ \phi }_H^2. \]

With a stochastic process, we can consider $X_t$ 
(a random variable)
or $X_t(\omega)$ (a number).
With a generalized process, 
we can only look at $X_\phi$,
where $\phi$ is a test function, \ie,
the weighted average of ``$X_t$'', 
using $(\phi(t))_t$ as weights.

\nextbook
\begin{book}
  \emph{ABC model choice via random forests} \\
  P. Pudlo et al. (2014)
\end{book}
ABC posterior probabilities for model selection
are not trustworthy.
Instead, simulate data from several models, 
compute a summary statistic,
and ask some machine learning algorithms
(say, random forests) 
to predict the model (and its aprameters)
from the summary statistic.
% Use posterior error rates instead of posterior probabilities.

\nextbook
\begin{book}
  \emph{A survey of metric learning 
  for feature vectors and structured data} \\
  A. Bellet et al. (2014)
\end{book}
Some machine learning algorithms 
($k$-means, $k$ nearest neightbours) rely on a distance,
but choosing it beforehand need not be optimal:
\emph{metric learning} uses the data 
to select the best distance for the problem at hand.

\emph{Mahalanobis distance learning} looks for 
a distance of the form 
\[ d_M(x,y) = \sqrt{ (x-y)' M (x-y) } \]
with $M$ positive semidefinite,
that optimizes some criterion, 
e.g. (large merging nearest neighbours, LMNN)
\[
\begin{array}{ll}
  \text{Find} & M \in \mathcal S_+ \\
  \text{To minimize} & 
  (1-\mu) \!\!\sum\limits_{(i,j) \in S}\!\!\!\!
  d_M^2(x_i,y_i) + 
  \mu \!\!\sum\limits_{(i,j,k) \in R}\!\!\!\!
  \xi_{ijk} \\
  \text{Such that} & 
  \forall (i,j,k) \in R \\
  &d_M^2(x_i,x_k) - d_M^2(x_i,x_j) \geq 1 - \xi_{ijk}
\end{array}
\]
where 
\begin{align*}
S &= \{ (i,j) \ :\ y_i = y_j \text{ and } x_i \in \text{Neigh}(x_j) \} \\
R &= \{ (i,j,k) \ :\ (i,j) \in S \text{ and } y_i \neq y_k \}
\end{align*}
Regularizations include: 
\begin{compactitem}[--]
\item The mixed $L^{2,1}$ norm, 
  $\n{ M }_{2,1} = \sum_i \n{ M_{i,\cdot} }_2$,
  which tends to zero out entire rows of $M$;
\item Log-det divergence, 
  \[ D(M,M_0) = \tr( M M_0^{-1} ) - \log \det ( M M_0^{-1} ) - d, \]
  with $M_0=I$.
\end{compactitem}

Non-Mahalanobis similarities include: 
\begin{compactitem}[--]
\item $k(x,y) = x' M y$, with $M$ not necessarily positive, 
  or even symmetric;
\item $k(x,y) = \dfrac{ x' M y }{ \sqrt{x'Mx} \sqrt{y'My} }$
  (generalized cosine similarity);
\item Kernalization, kernal PCA (kPCA);
\item A neural network (deep belief net, convolutional net)
to learn a non-linear projection $g$ so that 
$\n{g(x) - g(y)}_1$ be small for positive pairs and large for negative pairs.
\end{compactitem}

Local metric learning: 
\begin{compactitem}[--]
\item Cluster the data and learn a different 
  Mahalanobis metric in each cluster; 
  one can also consider the a barycenter 
  of Mahalanobis distances; 
\item The symmetrized Bregman divergence 
  is a smoothly-varying Mahalanobis distance:
  \begin{align*}
  d_\phi(x,y) &= \phi x \phi y - (x-y)' \nabla \phi y \\
  \llap{\ensuremath{d_\phi^{\text{sym}}(x,y)}} 
  &= d_\phi(x,y) + d_\phi(y,x) \\
  &= (x-y)' \nabla^2 \phi(z) (x-y) 
  \text{for some } z \in [x,y]
  \end{align*}
\end{compactitem}

One can devise distances for specific types of data: 
\begin{compactitem}[--]
\item Histogram data (points in the standard simplex $\Delta$) and the $\chi^2$ distance
  \begin{align*}
  \chi^2(x,y) &= \dfrac12 \sum_i \dfrac{(x_i-y_i)^2}{x_i+y_i} \\
  \chi_L^2(x,y) &= \chi^2( Lx, Ly ) \quad\text{(with $L\Delta\subset\Delta$)}
  \end{align*}
  or the earth mover's distance;
\item Strings, trees, graphs with the edit distance.
\end{compactitem}

% The survey lists a large (30+) number of algorithms, 
% for supervised, semi-supervised, transfer, online learning. 

\nextbook
\begin{book}
  \emph{Handling sparsity via the horseshoe} \\
  V.M. Carvalho et al. (2009)
\end{book}
To estimate a sparse model, besides the Laplace prior (lasso) and the Student prior (relevance vector machine),
consider the \emph{horseshoe prior}
\begin{align*}
  \beta   &\sim N(0, \lambda^2 \tau^2 ) \\
  \lambda &\sim \text{Half-Cauchy}
\end{align*}
where $\lambda$ is the local shrinkage and $\tau$ the global shrinkage. 
The model expects two types of observations: 
strong signal (no shrinkage)
or noise (total shrinkage) -- the lasso is more moderate
and always has some shrinkage. 

\nextbook
\begin{book}
  \emph{Missing value estimation\\ for DNA microarray gene expression data:\\ local least squares imputation} \\
  H. Kim et al.
\end{book}
To impute missing values in a gene$\times$experiment matrix
(many genes, few experiments): 
\begin{compactitem}[--]
\item Assume we want to impute a value in the first gene (row) $g_1$;
\item Find the $k$ closest genes (highest correlation)
  $g_{i_1},\dots,g_{i_k}$;
\item Regress $g_1 \sim g_{i_1} + \cdots + g_{i_k}$
  and fill in $g_1$.
\end{compactitem}
This is a refinement of nearest neighbour imputation,
which uses an equal- (or empirically) weighted 
average of $g_{i_1},\dots,g_{i_k}$.

\emph{SVD imputation} works well for low-noise time series: 
\begin{compactitem}[--]
\item Fill in the missing values with row averages;
\item Compute the eigenvectors;
\item Regress $g_1$ against the (first) eigenvectors;
\item Predict the missing values;
\item Iterate until convergence.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Choquistic regression: generalizing logistic regression using the Choquet integral} \\
  A. F. Tehrani
\end{book}
A \emph{non-additive} discrete measure 
(sometimes called a capacity or a fuzzy measure)
is a function 
$\mu : \mathscr P(C) \to [0,1]$
such that 
\begin{align*}
  &\mu(\nothing) = 0 \\
  &\mu(C) = 1 \\
  &A \subset B \implies \mu(A) \leq \mu(B).
\end{align*}

It is determined by its \emph{M\"obius transform} $m$:
\begin{align*}
  \mu(B) &= \sum_{A \subset B} m(A) \\
  m(A) &= \sum_{B \subset A} (-1)^{\va A - \va B} \mu(B).
\end{align*}

A non-additive measure is $k$-additive if 
$\va A > k \implies m(A) = 0$; 
0-additive measures are (additive) measures.

The \d{Choquet integral} generalizes the weighted average
(a way of aggregating several criteria)
\[ \sum_{ c \in C} \mu(\{c\}) f(c) \]
from (additive) measures to non-additive measures. 
Intuitively, it allows for interactions 
between the criteria being averaged.
\begin{align*}
&f:C\to\RR_+ \\
& 0 \leq f(c_{(1)}) \leq \cdots \leq f(c_{(m)}) \\
& C_\mu(f) = 
\sum_{i=1}^m \left[ 
  f(c_{(i)}) - f(c_{(i-1)})
\right]
\mu(\{ c_{(1)},\dots,c_{(m)} \}) \\
& \hphantom{ C_\mu(f) }
= \sum_{T \subset C} m(T) \times \min_{c \in T} f(c).
\end{align*}

In logistic regression, we can replace $w' x$
with $\gamma ( C_\mu(x) - \beta )$,
where $x$ is seen as a function $i \mapsto x_i$
and $\mu$ is $k$-additive, with $k$ small.
The log-likelihood is concave.

\nextbook
\begin{book}
  \emph{Mendelian randomization and causal inference in observationsl epidemiology} \\
  N.A. Sheehan et al. (2008)
\end{book}
Medelian randomization is another name for instrumental variables (IV): 
find a variable IV so that 
\begin{align*}
  &\text{IV} \indep \text{confounding factors} \\
  &\text{IV} \longrightarrow \text{possible cause} \\
  & \text{IV} \indep \text{consequence} \mid \text{possible cause}
\end{align*}
\[
\begin{tikzpicture}[>=stealth,xscale=.8]
\node (IV) at (-4.5,0) {IV};
\node (A) at (-2,0) {possible cause};
\node (B) at (2,0) {consequence};
\node (C) at (0,1.4) {confounding factors};
\draw[->] (IV) -- (A);
\draw[->] (A) -- (B);
\draw[->] (C) -- (A);
\draw[->] (C) -- (B);
\end{tikzpicture}
\]
The IV is often a gene. 
Gene interactions complicate the picture. 

\nextbook
\begin{book}
  \emph{Simulation of fractional Brownian motion} \\
  T. Dieker (2004)
\end{book}

A stationary stochastic process $X$ is 
\emph{self-similar}
if $X^{(m)} = \tfrac1m( X_1 + \dots + X_m )$
and $X_1$ have the same distribution.
It has \emph{long-range dependence} if 
$\sum \gamma_k$ diverges, 
where $\gamma_k = \cov(X_0,X_k)$.
A standard \emph{fractional Brownian motion}
is characterized by 
\begin{align*}
  & B(t) \text{ has stationary increments} \\
  & B(0) = 0, \ E B(t) = 0 \\
  & E B(t)^2 = t^{2H} \\
  & B(t) \text{ is Gaussian}.  
\end{align*}
Its increments $X_k = B(k+1) - B(k)$
are \emph{fractional Gaussian noise}.
These are Gaussian processes with covariance functions 
\begin{align*}
E[ B(s) B(t) ] &= 
\tfrac12 [ t^{2H} + s^{2H} + \va{t-s}^{2H} ] \\
\gamma_k = E[ X_n X_{n+1} ] &= \tfrac12 
[ \va{k-1}^{2H} - 2 \va{k}^{2H} + \va{k+1}^{2H}  ].
\end{align*}
There is no closed form for 
the spectral density of fractional Gaussian noise 
\begin{align*}
  &f(\lambda) = \sum_{k \in \ZZ} e^{ik\lambda} = \\
  &\quad 2 \sin( \pi H ) \Gamma( 2 H + 1 )
  (1 - \cos \lambda )
  \left( \va{\lambda}^{-2H-1} + \sum \cdots \right)
\end{align*}
but approximations are available.

ARFIMA processes,
$(1-L)^d X_k \sim \text{ARMA}(p,q)$
also have long memory;
the fractional integration is defined by 
\begin{align*}
  (1-L)^d &= \sum_{n\geq 0} \binom dn (-L)^n \\
  \binom dn &= \dfrac{\Gamma(d+1)}{\Gamma(d-n+1)\Gamma(n+1)} \end{align*}
%  & L \text{: lag operator} \\
%  & Y \sim \text{ARMA}(p,q) \\
%  & \phi(L) Y_k = \theta(L) \epsilon_k \\
%  & \epsilon \text{: white noise} \\
%  & \phi, \theta \text{: polynomials} \\
%  & \deg \phi = p \\
%  & \deg \theta = q

The \emph{Hosking method} simulates 
a general stationary Gaussian process iteratively,
in $O(n^2)$: 
since 
\[
  V_{1:n+1} = \var X_{1:n+1} = 
\left(\!\!\!  
\begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)}]
%\begin{tikzpicture}[baseline=(current bounding box.center)]
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells
%  right delimiter={]},
%  left delimiter={[} 
]{
\gamma_0 & \gamma_1  & & \\
\gamma_1 & &  & \\
&  & & \gamma_1 \\
&  & \gamma_1 & \gamma_0 \\
};
\draw[loosely dotted] (m-1-2) -- (m-1-4);
\draw[loosely dotted] (m-2-1) -- (m-4-1);
\draw[loosely dotted] (m-4-1) -- (m-4-3);
\draw[loosely dotted] (m-1-4) -- (m-3-4);
\draw (m-1-1)-- (m-4-4);
\draw (m-1-2)-- (m-3-4);
\draw (m-2-1)-- (m-4-3);
\end{tikzpicture}
\!\!\!\right)
\]
and \( E[ X_{1:n+1} ] = 0, \)
we know that 
$X_{n+1} | X_{1:n} = x_{1:n} \sim N(\mu,v)$,
where $\mu$ and $v$ are easy to compute 
(because of the shape of $V_{1:n}$).

The \emph{Choleski method} 
can simulate arbitrary Gaussian processes;
the Choleski matrix can actually be computed explicitly, 
and this gives an $O(n^3)$ incremental algorithm.

The \emph{Davies and Harte method} 
embeds the covariance matrix into a circulant matrix
\[
\left(
\!\!\!\!
\begin{tikzpicture}[baseline={([yshift=-.8ex]current bounding box.center)}]
%\begin{tikzpicture}[baseline=(current bounding box.center)]
\matrix (m) [
  matrix of math nodes,
  nodes in empty cells,
  every node/.append style={text width=7mm,align=center,minimum height=5mm},
%  right delimiter={]},
%  left delimiter={[} 
  outer sep=0,
]{
\gamma_0 & \gamma_1  & & \gamma_{n-1} & 0 & \gamma_{n-1} && \gamma_1 \\
\gamma_1 & & & & \gamma_{n-1} &&& \\
&  & & \gamma_1 &&&& \gamma_{n-1} \\
\gamma_{n-1} &  & \gamma_1 & \gamma_0 & \gamma_1 && \gamma_{n-1} & 0\\
% 
0 & \gamma_{n-1} && \gamma_1 & \gamma_0 & \gamma_1 && \gamma_{n-1} \\
\gamma_{n-1} &&& & \gamma_1 \\
&&& \gamma_{n-1} &&&& \gamma_1 \\
\gamma_1 && \gamma_{n-1} & 0 & \gamma_{n-1} && \gamma_1 & \gamma_0 \\
};
\draw[loosely dotted] (m-1-2) -- (m-1-4);
\draw[loosely dotted] (m-2-1) -- (m-4-1);
\draw[loosely dotted] (m-4-1) -- (m-4-3);
\draw[loosely dotted] (m-1-4) -- (m-3-4);
\draw (m-1-1) -- (m-4-4);
\draw (m-1-2) -- (m-3-4);
\draw (m-2-1) -- (m-4-3);
\draw[loosely dotted] (m-1-6) -- (m-1-8);
\draw[loosely dotted] (m-2-5) -- (m-4-5);
\draw[loosely dotted] (m-4-5) -- (m-4-7);
\draw[loosely dotted] (m-1-8) -- (m-3-8);
\draw (m-1-5) -- (m-4-8);
\draw (m-1-6) -- (m-3-8);
\draw (m-2-5) -- (m-4-7);
% Idem, add 4 to the first coordinate
\draw[loosely dotted] (m-5-2) -- (m-5-4);
\draw[loosely dotted] (m-6-1) -- (m-8-1);
\draw[loosely dotted] (m-8-1) -- (m-8-3);
\draw[loosely dotted] (m-5-4) -- (m-7-4);
\draw (m-5-1) -- (m-8-4);
\draw (m-5-2) -- (m-7-4);
\draw (m-6-1) -- (m-8-3);
\draw[loosely dotted] (m-5-6) -- (m-5-8);
\draw[loosely dotted] (m-6-5) -- (m-8-5);
\draw[loosely dotted] (m-8-5) -- (m-8-7);
\draw[loosely dotted] (m-5-8) -- (m-7-8);
\draw (m-5-5) -- (m-8-8);
\draw (m-5-6) -- (m-7-8);
\draw (m-6-5) -- (m-8-7);
% Block matrix
\draw[dotted] (m-1-4.north east) -- (m-8-4.south east);
\draw[dotted] (m-4-1.south west) -- (m-4-8.south east);
\end{tikzpicture}
\!\!\!\right)
\]
which can be efficiently inverted (FFT), 
to find a square root in $O(n \log n)$.

There are approximate simulation methods
(\ie, they sample from a distribution 
which is not exactly a fractional Brownian motion), using: 
\begin{compactitem}[--]
\item The expression of a fractional Brownian motion as a stochastic integral;
\item Queueing theory;
\item Random midpoint displacement, 
  \ie, replacing $X_{n+1} | X_{1:n}$ 
  with $X_n | X_{i_1,\dots,i_k}$
  in the Hosking or Choleski method;
\item Spectral analysis: 
  a stationary Gaussian process can 
  be expressed as a stochastic integral involving 
  its spectral density $f$, 
  \begin{align*}
  X_n &= 
  \int_0^\pi 
  \sqrt{\dfrac{f(\lambda)}{\pi}}
  \cos( n \lambda) 
  d B_1(\lambda) 
  - \\
  &\phantom{={}}
  \int_0^\pi 
  \sqrt{\dfrac{f(\lambda)}{\pi}}
  \sin( n \lambda) 
  d B_2(\lambda);
  \end{align*}
\item Wavelets:
  the wavelet coefficients of a fractional Brownian motion
  are almost independent and almost Gaussian, 
  with zero mean and known variance; 
\item Fractional integration of white noise
  (white noise is the ``derivative'' of Brownian motion,
  seen as a generalized process, aka tempered distribution);
  % No details given
\item Series expansions.
\end{compactitem}

The Hurst exponent can be estimated in many ways: 
\begin{compactitem}[--]
\item Aggregated variance
  $ \var X^{(m)} = m^{2H-2} \var X $
  or absolute moments 
  $ E \va{ X^{(m)} - \bar X^{(m)} }^k \sim m^{k(H-1)}
  E \va{ X - EX }^k $
  but, in presence of autocorrelation, 
  the finite-sample estimators are biased;
\item Higuchi estimator: 
  absolute moment estimator, 
  with $k=1$ and overlapping windows;
\item The slope of the periodogram;
\item The variance of the regression residuals,
  on a moving window (\ie, the aggregated variance, 
  after detrending);
\item R/S analysis;
\item Likelihood estimator: 
  $(X_1,\dots,X_N) \sim N(0, \Gamma_H)$, 
  where $\Gamma_H$ is known (as a function of $H$) -- 
  unfortunately, $\det \Gamma_H$ and $\Gamma_H^{-1}$
  are expensive to compute;
\item Whittle estimator: compare 
  the periodogram $I(\lambda)$
  with the spectral density $f_H(\lambda)$, 
  \[ 
  \hat H = \argmin_H \sum_k 
  \dfrac{ I(\lambda_k) }{ f_H(\lambda_k) } 
  ;
  \]
\item Local Whittle estimator: 
  replace $f_H(\lambda)$ 
  with $C \va{ \lambda }^{ 1 - 2 H } $;
\item Variance of the wavelet coefficients 
  (no detrending is needed 
  if the wavelet has enough vanishing moments).
\end{compactitem}

\nextbook
\begin{book}
  \emph{Speeding up convolutional neural networks using fine-tuned CP-decomposition} \\
  V. Lebedev et al. (2015)
\end{book}
In image processing, 
convolutional neural networks (CNN) perform the convolution of an image with a 4-dimensional tensor: 
\begin{align*}
x_{ijk} &= \text{pixel at coordinates $(i,j)$, in RGB plane $k$,} \\
&\hphantom{={}} \text{for one of the patches} \\
y_\ell &= b_\ell + \sum_{ijk} a_{ijk\ell} x_{ijk} \\
&= 
\text{$\ell$th coordinate of the output, for this patch}
\end{align*}
The tensor can be replaced by a low-rank approximation, 
e.g., the CP-decomposition
(a higher-order analogue of PCA).

\nextbook
\begin{book}
  \emph{FitNets: hints for thin deep nets} \\
  A. Romero et al. (2015)
\end{book}
To have a small network (e.g., a thin but deep)
mimick a large one (wide and deep)
do not only learn the outputs, 
also use the intermediate representations.

\nextbook
\begin{book}
  \emph{Effective use of word order\\ 
  for text categorization\\ 
  with convolutional neural networks} \\
  R. Johnson and T. Zhang
\end{book}
Convolutional neural networks (CNN),
often used to process images,
apply convolutional and pooling layers
(one or several pairs)
to the data
before passing it to a linear classifier.
\begin{compactitem}[--]
\item A \emph{convolutional layer} 
  takes $k \times k$ (overlapping) regions of the image
  and gives each of them to $m$ neurons;
  the weights are shared accross regions; 
  each region, a $3k^2$-dimensional vector,
  becomes an $m$-dimensional vector;
\item A \emph{pooling layer} takes the output 
  of a convolutional layer, 
  cuts it into non-overlapping regions,
  and aggregates them 
  (max-pooling or average pooling),
  so that each region becomes an $m$-dimensional vector.
\end{compactitem}

This can also be applied to text: 
\begin{compactitem}[--]
\item Encode length-$k$ regions as bags of vords
  (\ie, $\va V$-dimensional vectors)
  or using indicator variables 
  (\ie, $k\va V$-dimensional vectors);
\item To deal with variable sentence or text length,
  fix the number of pooling units 
  and dynamically select the pooling region size;
\item Use linear rectifiers.  
\end{compactitem}

\nextbook
\begin{book}
  \emph{Link analysis, eigenvectors and stability} \\
  A.Y. Ng et al.
\end{book}
\textsc{Hits} and PageRank are eigenvalue problems: 
if the eigengap
(the difference between the two largest eigenvalues)
is small, the first eigenvector is not stable.
Hits is unstable if the maximum degree is large;
PageRank is not robust to perturbations
 to pages with a high score.
\emph{Latent semantic indexing} (LSI)
(compute the left and right singular vectors 
of the binary term-document matrix) 
is a special case of \textsc{Hits} 
and has the same problem.
% In experiments, PageRank appears more stable.

\nextbook
\begin{book}
  \emph{Stable algorithms for link analysis} \\
  A.Y. Ng et al. (2001)
\end{book}
The \emph{randomized Hits} algorithm 
is the \textsc{Hits} algorithm, 
expressed as a random walk with teleportation,
\`a la PageRank (teleportation increases stability).

The \emph{subspace Hits} algorithm uses 
the first $k$ eigenvectors 
and defines the scores as 
\[ 
  a_j = \sum_{i=1}^k f(\lambda_i) \langle e_j, x_i \rangle^2 
\]
where $e_j$ are the basis vectors 
(zeroes except in position~$j$),
$f(\lambda) = \lambda^2$ (but other weight functions are possible),
$x_i$ are the eigenvectors and 
$\lambda_i$ the eigenvalues.

\nextbook
\begin{book}
  \emph{Intriguing properties of neural networks} \\
  C. Szegedy et al. (2014)
\end{book}
Deep neural networks are discontinuous: 
it is possible to manufacture 
an imperceptible alteration of an image to misclassify it.

While it is possible to interpret individual hidden neurons,
it is equally easy to interpret 
random linear combinations of neurons. 

\nextbook
\begin{book}
  \emph{On the effective measure of dimension\\ in the analysis cosparse model} \\
  R. Giryes et al. (2014)
\end{book}
Compressed sensing tries to reconstruct a vector $x$ 
so that $y = Ax + \text{noise}$,
assuming $x$ is sparse. 

The cosparse model tries to reconstruct a vector $x$
so that $y = Ax + \text{noise}$
assuming $Bx$ is sparse --
for instance, $x$ could be an image and $Bx$ its gradient.

\nextbook
\begin{book}
  \emph{Adaptive compressed sensing for estimation\\ of structured sparse sets} \\
  R.M. Castro and E. T\'anczos (2014)
\end{book}
Compressed sensing, \ie, the reconstruction of a signal from noisy and partial observations, under the assumption that it is sparse,
can be generalized to more general supports,
e.g., 
subsets of length $s$ of $\llbracket 1, n \rrbracket$,
subintervals of length $s$ of $\llbracket 1, n \rrbracket$,
disjoint unions of $k$ such intervals, $s$-element stars in a graph, etc.

\nextbook
\begin{book}
  \emph{An exact mapping between the variational renormalization group and deep learning} \\
  P. Mehta and D.J. Schwab (2014)
\end{book}
% Surprisingly clear
The renormalization group is 
the hierarchical description of a physical phenomenon
by progressively integrating out (marginalizing over) 
small features
(``iterative coarse-graining scheme'').
It is not unlike deep networks, 
which integrate small features into larger ones, 
from layer to layer. 

\nextbook
\begin{book}
  \emph{Taming the monster: a fast and simple algorithm for contextual bandits} \\
  A. Agarwal et al. (2014)
\end{book}
The $\epsilon$-greedy or epoch-greedy algorithm
have a suboptimal regret.
Randomized UCB has an optimal regret,
but it is complex and slow:
it can be simplified and sped up.

\nextbook
\begin{book}
  \emph{Learning to discover social circles\\ in ego networks} \\
  J. McAuley and J. Leskovec 
\end{book}
A generalization of BigCLAM 
that allows overlapping or nested communities
(not unlike topics)
and uses both graph structure and node features. 

\nextbook
\begin{book}
  \emph{Fast, simple and accurate handwritten digit classification using extreme learning machines with shaped input-weights} \\
  M.D. McDonnell et al. (2014)
\end{book}

Extreme learning machines (ELM, echo nets -- 
neural nets whose hidden layer is random and not learned) 
perform as well as deep nets 
in the digit classification task: 
\begin{compactitem}[--]
\item Augment the training set by distorting it;
\item Each hidden unit only operates on 
  a randomly sized and positioned patch of the image. 
\end{compactitem}

\nextbook
\begin{book}
  \emph{Selfieboost: a boosting algorithm\\ for deep learning} \\
  S. Shalev-Shwarts
\end{book}

Adaboost sequentially fits a model, 
assigning more weight to currently 
misclassified observations,
and returns a linear combination of the models. 
Selfieboost only returns the last one; 
to avoid losing the performance of the earlier models, 
it adds a penalty to keep the new model forecasts 
close to the previous ones. 

\nextbook
\begin{book}
  \emph{Move evaluation in Go\\ 
  using deep convolutional networks} \\
  C. Maddison et al. (2015)
\end{book}
The positions on a Go board are not unlike 
the pixels of an imge: 
use convolutional neural networks to evaluate
a position or a move, 
using training data from the KGS server

\nextbook
\begin{book}
  \emph{Teaching deep convolutional neural neworks\\ 
  to play Go} \\
  C. Clark and A. Storkey
\end{book}
More details.

\nextbook
\begin{book}
  \emph{Efficient gradient-based inference through transformations between Bayes nets and Neural nets} \\
  D.P. Kingma and M. Welling (2014)
\end{book}
Bayesian networks and neural networks are the same thing:
each can (often) be transformed into the other.

\nextbook
\begin{book}
  \emph{Hogwild!: a lock-free approach to parallelizing stochastic gradient descent} \\
  F. Niu et al.
\end{book}
Stochastic gradient descent (SGD) is often 
easy to parallelize:
reformulate the objective function to make it 
almost sepearable (a large sum of functions 
of a small number of variables -- 
that is usually possible if the input is sparse) 
and forget about concurrency problems 
(let the processors overwrite each other's work -- 
it happens too rarely to have a noticeable effect).

\nextbook
\begin{book}
  \emph{Crypto-nets:\\ neural networks over encrypted data} \\
  P. Xie et al. (2015)
\end{book}
Homomorphic encryption can be used with neural networks -- 
but since it only provides $+$ and $\times$,
you need to approximate the transfer function 
with a polynomial 
(the input space should be compact).

\nextbook
\begin{book}
  \emph{libDAI: a free and open source C++ library for discrete approximate inference\\ in graphical models} \\
  J.M. Mooij (2010)
\end{book}
To estimate Bayesian networks or Markov random fields (MRF).
Also check OpenGM2.

\nextbook
\begin{book}
  \emph{LSH forest: self-tuning indexes\\ for similarity search} \\
  M. Bawa et al.
\end{book}
Given a locality-sensitive hash (LSH) family
$\mathscr H = ( h_i) _{i \geq 1}$,
one usually assigns a fixed-length label 
$g(p) = ( h_1(p), \dots, h_n(p) )$
to each point $p$.
Instead, one can use variable-length labels, arranged in a prefix tree,
sufficiently long
so that all the points have a different label.
An LSH forest is a set of such LSH trees.

\nextbook
\begin{book}
  \emph{A performance evaluation\\ of open source graph databases} \\
  R. McColl et al. (2014)
\end{book}
Stinger, MTGL, Boost, Giraph and NetworkX perform well.

\nextbook
\begin{book}
  \emph{Trend filtering methods\\ for momentum strategies} \\
  B. Bruder et al. (2011)
\end{book}

Here are a few algorithms to identify trends in a time series: 
\begin{compactitem}[--]
\item Moving average, exponential moving average;
\item Local regression, which can be seen 
  (for a rectangular kernel)
  as the discretization of the \emph{Lanczos derivarive}
  (a noise-robust slope)
  \[ f'(x) = \lim_{\epsilon \to 0}
  \dfrac{3}{2\epsilon^2} 
  \int_{-\epsilon}^\epsilon
  t f(x+t) dt;
  \]
\item Local polynomial regression, 
  loess smoothing;
\item Hodrick-Prescott filter, 
  \[ 
  \hat y = \argmin_y \n{ y-x}^2_2 + 
  \lambda \n{ D^2 y}_2^2;
  \]
\item Structural model (Kalman filter);
\item Low-pass filter, from a Fourier or Wavelet transform;
\item Singular spectrum analysis (SSA): let 
  \[ H = \begin{pmatrix}
    y_1 & \cdots & y_m \\
    \vdots && \vdots \\
    y_n & \cdots & y_t
  \end{pmatrix}
%  , \ 
%  y_p = \dfrac1{\#[i+j-1=p]} 
%  \sum_{i+j-1=p} H_{ij}
  \] 
  and perform a dimension reduction on $H$; 
\item Support vector machines, $Y \sim \text{time}$,
  with radial basis functions (RBF),
  and their standard deviation as smoothing parameter; 
\item Empirical mode decomposition (EMD), 
  Hilbert filter;
\item Gaussian processes (not mentioned).
\end{compactitem}
Multivariate filtering methods were listed but not detailed: 
Kalman filter (with a small number of stochastic components), 
error correction models, 
permanent-transitory decomposition.

\nextbook
\begin{book}
  \emph{Chaos in economics and finance} \\
  D. Gu\'egan (2009)
\end{book}
Let $X_0$ be a random variable 
and $X_n = f(X_{n-1})$
a deterministic dynamic system.
To study time series using this model: 
\begin{compactitem}[--]
\item Estimate the embedding dimension; 
  % Recurrence plots?
\item Estimate $f$ and $f'$ 
  (using $k$-NN, radial basis functions, neural nets, etc.);
\item Estimate the Lyapunov esxponent 
  \[ 
  \lambda = 
  \lim_{n \to \infty} \dfrac1n 
  \sum_{1 \leq t \leq n}
  \ln \va{ f'(X_t) },
  \]
  \ie, the speed at which trajectories diverge: 
  $\n{x_n - y_n} \approx e^{\lambda n} \n{ x_0 - y_0 }$;
\item Test if it is positive.
\end{compactitem}
% Logistic map: x \mapsto 4x(1-x) on [0,1]
% Henon map
% Wikipedia: list of chaotic maps

\nextbook
\begin{book}
  \emph{Computing present values:\\ 
  capital budgeting done correctly} \\
  R. Jarrow (2014)
\end{book}
The value $V_t$ of an asset is related 
to its expected returns as follows.
\begin{align*}
1 + \mu_{T-1} &:= E_{T-1} \left[ \dfrac{ V_T}{ V_{T-1} } \right] \\
V_{T-1} &= E_{T-1} \left[ \dfrac{V_T}{1 + \mu_{T-1}} \right] \\
V_{T-2} &= E_{T-2} \left[ \dfrac{V_{T-1}}{1 + \mu_{T-2}} \right] \\
&= E_{T-2} \left[ \dfrac1{1 + \mu_{T-2}} E_{T-1} \left[  \dfrac{V_T}{1 + \mu_{T-1}} \right] \right] \\
&= E_{T-2} \left[ \dfrac{V_T}{(1 + \mu_{T-2})(1 + \mu_{T-1})} \right] \\
V_t &= E_t \left[
  \dfrac{V_T}{
    (1+\mu_t)\cdots(1+\mu_{T-1})
    }
\right]
\end{align*}
(This is the real-world measure, $P$).

Some textbooks incorrectly price stochastic cash flows as 
\[ 
V_0^{\text{wrong}} = \dfrac{
  E[ V_T ]
}{
  (1 + E\mu_0) \cdots (1+E\mu_{T-1})
}.
\]

\nextbook
\begin{book}
  \emph{Correlation in the magnitude\\
  of financial returns} \\
  J. H\"am\"al\"ainen (2014)
\end{book}
Look at $\cor( \va{r_i}, \va{r_j} )$.

\nextbook
\begin{book}
  \emph{Understanding the relationship\\
  of momentum with beta}
 \\
 T. Cenesizoglu et al. (2014)
\end{book}
Beta explains momentum performance.

\nextbook
\begin{book}
  \emph{The stability and accuracy of credit ratings} \\
  P. Viegas de Carvalho et al. (2014)
\end{book}
Reratings are not related to changes 
in the probability of default,
but rather to changes in the relative probability of default.
Ratings depend on the business or economic cycle.

