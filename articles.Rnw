Closed-source; check \texttt{imodels} instead.

\nextbook
\begin{book}
  \emph{Varying coefficient models}\\
  T. Hastie and R. Tibschirani (1993)
\end{book}
\emph{Variable coefficient models} are locally linear:
\[ y \approx \sum_j \beta_j(x) x_j. \]
Often, the coefficients $\beta_j$ only depend on a subset $R_j$ of the predictors:
$y \approx \sum_j \beta_j( R_j ) x_jj $.
They can be estimated as
\[ \beta_j(R_j) = \dfrac{
  \E \left[
    X_j ^2 \dfrac{ Y - \sum\limits_{k \neq j } \beta_k(R_k) X_k }{ X_j } 
    \middle| R_j
    \right]
}{
  \E[ X_j^2 | R_j ]
}
\]
with tensor product splines, minimizing
\[
\biggl[
  \sum_i y_i - \sum_j  x_{ij} \beta_j(r_{ij})
  \biggr]^2
+ \sum_j \lambda_j \int \beta_j''(r_j) dr_j
\]

\nextbook
\begin{book}
  \emph{Sparse-input neural networks\\ for high-dimensional nonparametric\\ regression and classification}\\
  J. Feng and N. Simon (2019)
\end{book}
Add a sparse group lasso penalty on the first layer weights $W_1$.
\[ \text{loss} = \text{error} + \lambda_0 \sum_{ a \geq 2 } \n{ W_a }_2^2
+ \lambda_{12} \n{ W_1 }_{12} + \lambda_1 \n{ W_1 }_1 \]
Gradient descent (or other standard gradient-based optimizers) will not give a sparse solution:
use proximal gradient.
\begin{align*}
  W & \leftarrow w - \gamma \nabla \text{loss}_{\text{smooth}} \\
  W_1 &\leftarrow S( w_1, \gamma \lambda_1 ) \\
  W_{1\bigcdot i} &\leftarrow \left(
  1 - \dfrac{ \gamma \lambda_{12} }{ \n{ W_{1\bigcdot i}}_2 }
  \right)_{\!\!+} W_{1 \bigcdot i }
\end{align*}

\nextbook
\begin{book}
  \emph{Supersparse linear integer models\\ for interpretable classification}\\
  B. Ustun et al. (2014)
\end{book}
For interpretable linear models, SLIM uses:
\begin{compactitem}[--]
\item Binary predictors,
\item 0-1 loss;
\item $\ell_0$ penalty,
\item Very small $\ell_1$ penalty to avoid the ties created by the $\ell_0$ penalty;
\item Integer coefficients (or number with just one significant digit,
  possibly with a sign constraint).
\end{compactitem}
This can be solved as a mixed integer linear program
(with a big-$M$ transformation),
and approximated with an integer-constrained lasso regression.

