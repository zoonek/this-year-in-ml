\begin{tikzpicture}[scale=.5,>=stealth,inner sep=1pt, outer sep=1pt, baseline=5pt,
n/.style={circle, fill}
]
  \node[n] (A) at (0,0) {};
  \node[n] (B) at (1,0) {};
  \node[n] (C) at (1,1) {};
  \node[n] (D) at (0,1) {};
  \draw[->] (A) -- (B);
  \draw[->] (C) -- (B);
  \draw[->] (C) -- (A);
  \draw[->] (D) -- (A);
  \draw[->] (D) -- (C);
\end{tikzpicture}
\]

Undirected models are ambiguous:
does
\(
\begin{tikzpicture}[scale=.5,>=stealth,inner sep=1pt, outer sep=1pt, baseline=4pt,
n/.style={circle, fill}
]
  \node[n] (C) at (0,0) {};
  \node[n] (B) at (60:1) {};
  \node[n] (A) at (120:1) {};
  \draw (B) -- (A);
  \draw (C) -- (A);
  \draw (B) -- (C);
  \node [above=0pt of A] {\scriptsize 1};
  \node [above=0pt of B] {\scriptsize 2};
  \node [below=0pt of C] {\scriptsize 3};
\end{tikzpicture}
\)
represent
\(
\begin{tikzpicture}[scale=.5,>=stealth,inner sep=1pt, outer sep=1pt, baseline=4pt,
n/.style={circle, fill}
]
  \node[n] (C) at (0,0) {};
  \node[n] (B) at (60:1) {};
  \node[n] (A) at (120:1) {};
  \draw[thick,blue!80!black]  (B) -- (A);
  \draw[thick,red!80!black]   (C) -- (A);
  \draw[thick,green!80!black] (B) -- (C);
  \node [below=0pt of C] {\scriptsize $f_{12} f_{23} f_{13}$};
\end{tikzpicture}
\text{ or }
\ \ 
\begin{tikzpicture}[scale=.5,>=stealth,inner sep=1pt, outer sep=1pt, baseline=4pt,
n/.style={circle, fill}
]
  \node[n] (C) at (0,0) {};
  \node[n] (B) at (60:1) {};
  \node[n] (A) at (120:1) {};
  \draw[thick,blue!80!black] (B) -- (A);
  \draw[thick,blue!80!black] (C) -- (A);
  \draw[thick,blue!80!black] (B) -- (C);
  \node [below=0pt of C] {\scriptsize $f_{123}$};
\end{tikzpicture}
\),
\ie, in terms of \emph{factor graphs}
\[
\begin{tikzpicture}[scale=.6,>=stealth,inner sep=1pt, outer sep=0pt, baseline=-6pt,
n/.style={circle, fill}
  ]
  \node (O) at (0,0) {};
