\]

Modal decision trees, for temporal or spatial data, allows rules like
\[
\begin{array}{l}
  \exists [a,b] \ T_{[a,b]} \geq 39 \\
  \exists [c,d] \ \text{HR}_{[c,d]} \geq 140 \\
  \relax
  [a,b] \inter [c,d] \neq \nothing
\end{array}
\ \text{ or }\ 
\begin{array}{l}
  \exists R_1 \ \text{Red}( R_1 ) \geq a \\
  \exists R_2 \ \text{Green}( R_2 ) \leq b \\
  R_2 \subset R_1.
\end{array}
\]
They are more expressive (and sparser) than decision trees,
but more interpretable than ILP models (inductive logic programming, \ie, FOL rules).

\nextbook
\begin{book}
  \emph{Bayesian streaming\\ sparse Tucker decomposition}\\
  S. Fang et al. (2021)
\end{book}
The CP decomposition is a Tucker decomposition with a diagonal core --
instead, add a sparsifying penalty (with a Bayesian spike-and-slab prior).
  
\nextbook
\begin{book}
  \emph{CoSTCo: a neural tensor completion model for sparse tensors}\\
  H. Liu et al. (2019)
\end{book}
The Tucker decomposition
\[ T_{ i_1 , \dots , i_N } = \sum_{ j_1 , \dots , j_N } 
G_{ j_1 , \dots , j_N }
U^1_{j_1 i_1 }
U^2_{j_2 i_2 }
\cdots
U^N_{j_N i_N }
\]
can be made nonlinear
$ T_{ i_1 , \dots , i_N } = f_\theta( i_1 , \dots , i_N ) $:
\begin{compactitem}[--]
\item Use the 1-hot encoding $e \in \RR^{ \sum d_i }$
  of the index tuple $(i_1 , \dots , i_N)$;
\item Compute an embedding
  \[ \begin{pmatrix} U^1 & & 0 \\ & \ddots & \\ 0 && U^N \end{pmatrix} e \in \RR^{r \times N};\]
\item Apply CNNs with filter sizes $(r,1)$ and $(1,N)$;
\item Finish with a fully-connected layer.
\end{compactitem}

\nextbook
\begin{book}
  \emph{How many bins should be put\\ in a regular histogram}\\
  L. Birg\'e and Y. Rozenholc (2005)
\end{book}
Choose the number of bins $D$ to partition $[0,1]$
by maximizing
\begin{align*}
  L(D) &= \sum_{ 1 \leq j \leq D } N_j \log \dfrac{ D N_j }{ n } - \text{pen}(D) \\
  \text{pen}(D) &= D - 1 + ( \log D )^{2.5}.
\end{align*}
Test with
$N(0,1)$,
$\frac14 N(0,1) + \frac34 N(2,\frac1{16})$,
$\frac34 N(0,1) + \frac14 N(3,\frac19)$,
$\text{Exp}(1)$,
$\text{T}(3)$,
$\text{U}(0,1)$.
  
\nextbook
\begin{book}
  \emph{Cone-constrained monotone mean-variance portfolio selection under diffusion models}\\
  Y. Shen and B. Zou (2022)
\end{book}
The mean-variance preference
\[ J(X) = \E_{\PP}[X] - \lambda \var_{\PP}[X] \]
is not monotonic:
we can have $X \geq X'$ a.s., but $J(X) < J(X')$
(for instance
\( X = 
\begin{tikzpicture}[>=stealth,xscale=.15,yscale=.18,inner sep=1pt,outer sep=1pt,baseline=0]
  \draw (-.7,0) -- (4.7,0);
  \draw (0,0) -- (0,1);
  \draw (1,0) -- (1,1);
  \draw (2,0) -- (2,1);
  %\draw (3,0) -- (3,1);
  \draw (4,0) -- (4,1);
  \node[circle,fill] at (0,1) {};
  \node[circle,fill] at (1,1) {};
  \node[circle,fill] at (2,1) {};
  \node[circle,fill] at (3,0) {};
  \node[circle,fill] at (4,1) {};
\end{tikzpicture}
\),
\( X' = 
\begin{tikzpicture}[>=stealth,xscale=.15,yscale=.2,inner sep=1pt,outer sep=1pt,baseline=0]
  \draw (-.7,0) -- (4.7,0);
  \draw (0,0) -- (0,1);
  \draw (1,0) -- (1,1);
  \draw (2,0) -- (2,1);
  \draw (3,0) -- (3,1);
  %\draw (4,0) -- (4,1);
  \node[circle,fill] at (0,1) {};
  \node[circle,fill] at (1,1) {};
  \node[circle,fill] at (2,1) {};
  \node[circle,fill] at (3,1) {};
  \node[circle,fill] at (4,0) {};
\end{tikzpicture}
\),
$\lambda=1$)

Replace it with the monotone mean variance preference
\[ J(X) = \inf_{ \QQ \ll \PP } \E_{\QQ} \biggl[ X + \lambda^{-1} \biggl( \dfrac{d\QQ}{d\PP} - 1 \biggr) \biggr]. \]

\nextbook
\begin{book}
  \emph{Portfolio selection with monotone mean-variance preferences}\\
  F. Maccheroni et al. (2009)
\end{book}
The MMV preference coincides with the mean-variance preference
on its domain of monotonicity
(the subset of $L^2$ where the G\^ateaux derivative of
$U(f) = \E[f] - \frac12 \lambda \var[f]$
is positive),
and is the best monotone approximation outside.

The unconstrained optimal portfolio is still
of the form $\alpha^* = \lambda^{-1} V^{-1} \mu$, but $V$ and $\mu$ are now \emph{lower} moments of $X$ (for some threshold).

