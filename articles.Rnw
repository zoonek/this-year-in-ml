\textbf{7.} Tuberculosis
\begin{compactitem}[--]
\item Long period of latency;
\item Only becomes active in 10\% of cases; 
\item Two strains: MDR-TB (multi-drug-resistant)
\item Reinfection is possible, because of non-compliance or infection from someone with MDR-TB.
\end{compactitem}

TODO: MANY PLOTS

\textbf{8.} HIV/AIDS
\begin{compactitem}[--]
\item High infectivity for 2 months, low infectivity for 10 years,
  then disease (and low infectivity, because of a drop in sexual
  activity);
\item Model with stages, or age of infection;
\item Combination with TB.
\end{compactitem}

