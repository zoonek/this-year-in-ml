\begin{tikzpicture}[xscale=.5,yscale=.8,>=stealth,inner sep=0pt, outer sep = 1pt,baseline=14mm]
\node       (E) at (0,3.3) {};
\node[outer sep = 0pt] (A) at (0,3) {};
