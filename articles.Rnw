  \draw (\k-.1,-.5) -- (\k+.1,-.5) -- (\k+.1,2.5) -- (\k-.1,2.5) -- cycle;
  \draw (\k-.1,4.5) -- (\k+.1,4.5) -- (\k+.1,8.5) -- (\k-.1,8.5) -- cycle;
}
\foreach \k in {0,1,2} {
