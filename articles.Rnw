\emph{Coupling flows} generalize the linear invertible transformation
\begin{align*}
  \begin{pmatrix} h_1 \\ h_2 \end{pmatrix}
  &\longmapsto \begin{pmatrix} 1 & 0 \\ * & 1 \end{pmatrix}
  \begin{pmatrix} h_1 \\ h_2 \end{pmatrix}
  \\
  \intertext{to}
  \begin{pmatrix} h_1 \\ h_2 \end{pmatrix}
  & \longmapsto
  \begin{pmatrix} h_1 \\ g_{ \phi(h1) } h_2 \end{pmatrix}
  \\
  \intertext{with inverse}
  \begin{pmatrix} h_1 \\ g_{ \phi(h1) }^{-1} h_2 \end{pmatrix}
  &\longmapsfrom
  \begin{pmatrix} h_1 \\ h_2 \end{pmatrix}
\end{align*}

\[
