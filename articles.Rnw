\nextbook
\begin{book}
  \emph{COPAR: multivariate time series modeling using copulas autoregressive model}\\
  E.C. Brechmann amd C. Czado (2012)
\end{book}
A univariate copula-AR($p$) model specifies copulas for
\begin{align*}
  & X_{n-1} , X_n \\
  & X_{n-2} , X_n | X_{n-1} \\
  & X_{n-3} , X_n | X_{n-1}, X_{n-2} \\
  & \vdots \\
  & X_{n-p} , X_n | X_{n-1} , \dots , X_{n-p+1}.
\end{align*}
The COPAR model similarly generalizes the VAR($p$) model;
for two variables abd $s<t$:
\begin{align*}
  & X_s , X_t | X_{s+1 : t-1} \\
  & X_s , Y_t | X_{s+1 : t} \\
  & Y_s , X_t | X_{1:t-1}, Y_{s+1 : t-1} \\
  & Y_s , Y_t | X_{1:t} , Y_{s+1 : t-1}.
\end{align*}

\nextbook
\begin{book}
  \emph{The realized hierarchical archimedean copula in risk modelling}\\
  O. Okhrib and A. Tetereva
\end{book}
Estimate the structure of a \emph{hierarchical archimedean copula} (HAC --
an alternative to the pair copula constuction (PCC) of vine copulas)
by testing if each triplet of variables
$p,q,r$ is closer to
\[
\begin{tikzpicture}[>=stealth,yscale=.25,xscale=.25,inner sep=1pt,outer sep=0pt, baseline=-1]
  \node (p) at (0,0) {$p$};
  \node (q) at (2,0) {$q$};
  \node (r) at (4,0) {$r\vphantom{p}$};
  \draw (p) -- (2,2);
  \draw (q) -- (2,2);
  \draw (r) -- (2,2);
\end{tikzpicture}
\ \ \text{ or }\ \ 
\begin{tikzpicture}[>=stealth,yscale=.25,xscale=.25,inner sep=1pt,outer sep=0pt, baseline=-1]
  \node (p) at (0,0) {$p$};
  \node (q) at (2,0) {$q$};
  \node (r) at (4,0) {$r\vphantom{p}$};
  \draw (p) -- (2,2);
  \draw (r) -- (2,2);
  \draw (q) -- (1,1);
\end{tikzpicture}
\ \ \text{ or }\ \ 
\begin{tikzpicture}[>=stealth,yscale=.25,xscale=.25,inner sep=1pt,outer sep=0pt, baseline=-1]
  \node (p) at (0,0) {$p$};
  \node (q) at (2,0) {$q$};
  \node (r) at (4,0) {$r\vphantom{p}$};
  \draw (p) -- (2,2);
  \draw (r) -- (2,2);
  \draw (q) -- (3,1);
\end{tikzpicture}
\ \ \text{ or }\ \ 
\begin{tikzpicture}[>=stealth,yscale=.25,xscale=.25,inner sep=1pt,outer sep=0pt, baseline=-1]
  \node (p) at (0,0) {$p$};
  \node (q) at (2,0) {$r\vphantom{p}$};
  \node (r) at (4,0) {$q$};
  \draw (p) -- (2,2);
  \draw (r) -- (2,2);
  \draw (q) -- (1,1);
\end{tikzpicture}
\]
from the (rank) correlation (of intraday returns) -- contrary to a dendrogram,
the tree is not constrained to be binary.
Estimate the copula parameters
(the copula family is assumed known)
by ``inverting'' the average correlation
(there can be more than two variables at a time).

\nextbook
\begin{book}
  \emph{Nonparametric estimation of the tree structure of a nested Archinedean copula}\\
  J. Segers and N. Uyttendaele (2018)
\end{book}
A \emph{rooted tree} on a finite set of nodes (leaves) $X$
is a set of subsets $\lambda \in \mathscr P(X)$
such that
\begin{compactitem}
\item[(i)] $X \in \lambda$;
\item[(ii)] $ \forall x \in X \quad \{x\}\in \lambda$;
\item[(iii)] $\forall A, B \in \lambda \quad A \subset B \text{ or } B \subset A \text{ or } A \inter B = \nothing$.
\end{compactitem}
The triplet trees can be estimated from data
(for a known, 1-parameter copula family)
with statistical tests on Kendall's $\tau$.
If they are not compatible,
lower the confidence level of the tests, $\alpha$, until they are. 

\nextbook
\begin{book}
  \emph{Implicit generative copulas}\\
  T. Janke et al.
\end{book}
To fit a nonparametric copula to data,
train a neural network with two components:
\begin{compactitem}[--]
\item The first transforms $N(0,1)$ random data
  into another distribution $Q$, without paying attention to the margins;
\item The second makes the margins of $Q$ uniform, to have a copula, not
  with the (sample) probability integral transform (it is not differentiable),
  but with a softrank,
  \begin{align*}
    v_i &= \dfrac1M 
      \dfrac12 \sum_{j=1}^M \dfrac{ 1 }{ 1 + \exp \alpha ( y_i - y_j ) }
      \\
    & \approx \dfrac1M \sum_j \mathbf1_{ y_i \leq y_j }.
  \end{align*}
\end{compactitem}
Use the \emph{energy distance} as loss function
\[ d^2 = \E_{\substack{
    U, U' \sim \text{data} \\
    V, V' \sim \text{network}
}} \bigl[
  2 \n{ U - V } - \n{ U - U' } - \n{ V - V' }
  \bigr].
\]

\nextbook
\begin{book}
  \emph{Copulas as high-dimensional generative models: vine copula autoencoders}\\
  N. Tagasovska et al.
\end{book}
Learn a low-dimensional representation of the data with an autoencoder;
fit a vine copula to that representation;
use it to sample new data.

