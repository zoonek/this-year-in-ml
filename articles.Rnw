\]
  
\nextbook
\begin{book}
  \emph{Deep signature transforms}\\
  P. Bonnier et al. (2019)
\end{book}
Prior to the truncated signature transform,
augment the time series to keep the information
that would otherwise be discarded by the truncation
\[ x \longmapsto
\begin{pmatrix} x \\ \phi(x) \end{pmatrix}
\longmapsto
\text{Sig}^N \!\!
\begin{pmatrix} x \\ \phi(x) \end{pmatrix}.
\]
This may be very similar to wavelet or Fourier features.

\nextbook
\begin{book}
  \emph{Nonstationary temporal matrix factorization for multivariate time series forecasting}\\
  X. Chen et al.
\end{book}
Temporal matrix factorization reconstructs a multivariate time series from
(contemporaneous) latent factors,
with a penalty to make them close to VAR.
\[
\begin{array}{ll}
  \text{Find} & W, X, A_1, \dots, A_d \\[2pt]
  \text{To minimize} &
  \tfrac12 \n{ P_\Omega( Y - W' X ) }_F^2
  \\[1pt] &+ \tfrac12 \rho \bigl( \n W _F^2 + \n X _F^2 )
  \\[1pt] &+ \tfrac12 \lambda \sum_t \n{
    x_t - \sum_k A_k x_{t-k}
  }_2^2
\end{array}
\]
If the time series are not stationary, differentiate them first.

\nextbook
\begin{book}
  \emph{LDE-Net: L\'evy induced\\ stochastic differential equation\\ equipped with neural network\\ for time series forecasting}\\
  L. Yang et al.
\end{book}
Model time series as
\begin{align*}
  X_{k+1} &= X_k + f(X_k) \Delta t + g(X_k) (\Delta t)^{1/\alpha} L_k \\
  L_k &\sim \text{Stable}(\alpha) \\
  f, g &:\text{ neutal nets}.
\end{align*}
Combine with an embedding and an attention layer.
\[
