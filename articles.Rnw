\nextbook
\begin{book}
  \emph{Combination of two-dimensional cochleogram and spectrogram features\\ for deep learning-based ASR} \\
  A. Tjandra et al. (2015)
\end{book}
The \d{cochleogram}, a convolution with the \emph{gammatone filter}
\begin{align*}
g(t) &= t^{n-1} e^{-2\pi bt} \cos( 2\pi \omega t) \\
n &: \text{filter order}\\
b &= 110 \, \omega + 25.2 \, \text{: bandwidth}
\end{align*}
is an alternative to 
MFCC (Mel frequency cepstral coefficients)
features.

\nextbook
\begin{book}
  \emph{Visually identifying rank} \\
  D.F. Fouhey et al.
\end{book}
Can CNNs (or SVMs with VLFeat features) recognize the rank of a matrix?
Results are not as disastrous as you may think.

\nextbook
\begin{book}
  \emph{High-dimensional probability estimation\\ with deep density models} \\
  O. Rippel and R.P. Adams
\end{book}
Dimension reduction of a dataset $Y$ in $\mathscr Y$ to a simpler space $\mathscr X$
can be obtained by two functions $f: \mathscr X \to \mathscr Y$
and $g: \mathscr Y \to \mathscr X$
(neural nets with sigmoid functions)
minimizing the divergence between the marginals of $g(Y$)
and the desired marginals (Beta distribution with $\alpha \gg 1$)
with a penalty for poorly conditioned $f$ (we want it invertible) 
and another one to ensure $g \approx f^{-1}$.

\nextbook
\begin{book}
  \emph{FractalNet:\\ ultra-deep neural networks without residuals} \\
  G. Larson et al.
\end{book}
Fractal networks are defined recursively, 
\[ % FractalNet
f_1 = 
\begin{tikzpicture}[>=stealth,yscale=.6,xscale=1, baseline={([yshift=-.8ex]current bounding box.center)}]
\node (I) at (0,-1) {};
\node[draw, inner sep = 2pt] (C) at (0,0) {\hspace*{5mm}};
\node (O) at (0,1) {};
\draw[thick,->] (I) -- (C);
\draw[thick,->] (C) -- (O);
\end{tikzpicture}
\qquad
f_{n+1} = 
\begin{tikzpicture}[>=stealth,yscale=.8,xscale=.5,baseline={([yshift=-.8ex]current bounding box.center)}]
\node (I) at (0,-1.7) {};
\node[inner sep = 0pt] (Ib) at (0,-1.2) {};
\node[draw, inner sep = 2pt] (C) at (-1,0) {\hspace*{5mm}};
\node[draw] (f1) at (1,-.5) {\footnotesize $f_n$};
\node[draw] (f2) at (1,.5) {\footnotesize $f_n$};
\node[inner sep = 0pt] (Ob) at (0,1.2) {};
\node (O) at (0,1.7) {};
\draw[thick] (I) -- (Ib);
\draw[thick,->] (Ib) to [out=180, in=270, looseness=1] (C.south);
\draw[thick,->] (Ib) to [out=0,   in=270, looseness=1] (f1.south);
\draw[thick,->] (f1) -- (f2);
\draw[thick,-] (C.north)  to [out=90, in=180, looseness=1] (Ob);
\draw[thick,-] (f2.north) to [out=90, in=0,   looseness=1] (Ob);
\draw[thick,->] (Ob) -- (O);
\end{tikzpicture}
\]
where $f$ is, for instance, a convolutional layer,
and trained with \emph{drop path}
(each join
drops each input with some probability, but keeps at least one)
and global (keep only one path, with layers in the same column).

\nextbook
\begin{book}
  \emph{Random rotation ensembles} \\
  R. Blaser and P. Fryzlewicz (2016)
\end{book}
To reduce the artifacts (and the number of trees needed) in ensembles of decision trees, randomly rotate the feature space before training the base learners.

\nextbook
\begin{book}
  \emph{Accelerating Eulerian fluid simulation\\ with convolutional networks} \\
  J. Tompson et al.
\end{book}
Machine learning and convolutional nets can help solve PDEs.

\nextbook
\begin{book}
  \emph{Compressing deep convolutional networks using vector quantization} \\
  Y. Gong et al. (2014)
\end{book}
Compress dense weight matrices with: 
\begin{compactitem}[--]
\item Matrix factorization;
\item Scalar quantization, by replacing the matrix entries with their signs,
  or by clustering them with $k$-means;
\item Product quantization: split the matrix into blocks of columns; 
  for each block, cluster the rows with $k$-means;
\item Residual quantization: cluster the rows, then the residuals, and iterate a few times.
\end{compactitem}

\nextbook
\begin{book}
  \emph{The sketchy database:\\ learning to retrieve badly drawn bunnies} \\
  P. Sangkloy et al.
\end{book}
A \d{siamese network} is a pair of convnets detecting if two inputs are similar or not; they use a contrastive loss.
\begin{align*}
\text{Loss} &= \lambda d(S, I_+) + (1-\lambda) \bigl( m - d(S,I_-) \bigr)_+ \\
\lambda &= 0 \text{ or } 1 \\
S &: \text{ source image} \\
I_+ &: \text{ matching image} \\
I_- &: \text{ non-matching image} \\
m&: \text{ margin}
\end{align*}
\[
\begin{tikzpicture}[>=stealth,yscale=1,xscale=1.6]
\node[draw, text centered, minimum height = 2em] (C1) at (0,0) {\footnotesize conv};
\node[draw, text centered, minimum height = 2em] (C2) at (1,0) {\footnotesize conv};
\node (I1) at (0,-1) {\footnotesize $S$};
\node (I2) at (1,-1) {\footnotesize \smash[b]{$I_+$ or $I_-$}};
\node[inner sep = 1pt] (O1) at (0,1) {\footnotesize embedding};
\node[inner sep = 1pt] (O2) at (1,1) {\footnotesize embedding};
\draw[thick,->] (I1) -- (C1);
\draw[thick,->] (C1) -- (O1);
\draw[thick,->] (I2) -- (C2);
\draw[thick,->] (C2) -- (O2);
\end{tikzpicture}
\]

\d{Triplet networks} are similar, but their loss is of the form ``$S$ is closer to $I_+$ than to $I_-$''.
\[ \text{Loss} = \bigl( d( S, I_+ ) - d( S, I_- ) \bigr) _+ \]
\[
\begin{tikzpicture}[>=stealth,yscale=1,xscale=1.6]
\node[draw, text centered, minimum height = 2em] (C1) at (0,0) {\footnotesize conv};
\node[draw, text centered, minimum height = 2em] (C2) at (1,0) {\footnotesize conv};
\node[draw, text centered, minimum height = 2em] (C3) at (2,0) {\footnotesize conv};
\node (I1) at (0,-1) {\footnotesize $S$};
\node (I2) at (1,-1) {\footnotesize \smash[b]{$I_+$}};
\node (I3) at (2,-1) {\footnotesize \smash[b]{$I_-$}};
\node[inner sep = 1pt] (O1) at (0,1) {\footnotesize embedding};
\node[inner sep = 1pt] (O2) at (1,1) {\footnotesize embedding};
\node[inner sep = 1pt] (O3) at (2,1) {\footnotesize embedding};
\draw[thick,->] (I1) -- (C1);
\draw[thick,->] (C1) -- (O1);
\draw[thick,->] (I2) -- (C2);
\draw[thick,->] (C2) -- (O2);
\draw[thick,->] (I3) -- (C3);
\draw[thick,->] (C3) -- (O3);
\end{tikzpicture}
\]

For a dataset of sketch-photo pairs, the two (or two of the three) convnets are different. 

\nextbook
\begin{book}
  \emph{Interaction networks for learning\\ about objects, relations and physics}
\end{book}
To design a data-driven physics engine, learn: 
\begin{compactitem}[--]
\item Object-centric functions, which map teh state of an object at time $t$ to its state at time $t+1$ (or, rather, a state increment);
\item Relation-centric functions, which map the states of two objects and the characteristics of the relation (e.g., the spring constant) to their state increments;
\item An aggregation function, which combines the state increments.
\end{compactitem}

\nextbook
\begin{book}
  \emph{On the modeling of musical solos\\ as complex networks} \\
  S. Ferretti (2016)
\end{book}
From a piece of music, create a network, 
with pitch-duration pairs as nodes (you can also add rests and chords),
and directed arcs to denote succession;
the usual graph statistics (degree distribution, centralities, etc.)
can help classify the piece.

\nextbook
\begin{book}
  \emph{A first look at music compositing using LSTM recurrent neural networks} \\
  D. Eck and J. Schmidhuber
\end{book}
LSTMs can generate the global structure RNNs cannot capture.

\nextbook
\begin{book}
  \emph{DeepBach: a steerable model\\ for Bach chorales generation} \\
  G. Hadjeres and F. Pachet
\end{book}
Represent the data as 6 sequences, corresponding to the 4 voices (either the midi pitch or a ``hold'' symbol),
the beat ($12341234\cdots$) and the presence of a fermata; the last two are fixed.

Model the data as $v_i = f( v_{<i}, v_{>i} )$,
where $f$ is a neural net, processing $v_{<i}$ and $v_{>i}$ with LSTMs (in opposite directions).

Generate new chorales with Gibbs sampling.

The \d{pseudo-log-likelihood} is a Gibbs-inspired approximation of the log-likelihood.
\begin{align*}
  \text{Log-likelihood} &:\quad \log P( V_1,\dots,V_n \,|\, \theta ) \\
  \text{Pseudo-log-likelihood} &:\quad \sum_i \log P( V_i \,|\, V_{\neq i}, \theta )
\end{align*}

\nextbook
\begin{book}
  \emph{An information-theoretic approach\\ to machine-oriented music summarization} \\
  F. Raposo et al.
\end{book}
% Not clear
Text summarization extracts relevant and diverse (bits of) sequences;
for music, this can create harsh discontinuities.
% They seem to 
Compute MFCC features on a moving window, model them as a (mixture of) multivariate Gaussians, 
use this distribution as a (machine-oriented) summary,
and somehow turn it into a human oriented summary.
Implementation in C++ using open\textsc{smile} (feature extraction) and Marsyas (synthesis).

\nextbook
\begin{book}
  \emph{Text extraction from the web\\ via text-to-tag ratio} \\
  T. Weninger and W.H. Hsu
\end{book}
To detect relevant text in the midst of today's HTML pages tag soup: 
\begin{compactitem}[--]
\item Remove empty lines, comments, \texttt{<script>} and \texttt{<style>} blocks;
\item In each line, count the number of (non-tag) characters, the number of tags, the ratio text/max(1,tag);
\item Apply $k$-means on smoothed ratios and pick the cluster with the largest average ratio,
\item Or pick lines whose smoothed ratio is above a one standard deviation thereshold,
\item Or apply some technical analysis indicator.
\end{compactitem}
This could be combined with
\begin{compactitem}[--]
\item Other line metrics, e.g., entropy;
\item Template detection (often, pages on the same web site belong to the same or a few templates);
\item Machine learning algorithms to detect boilerplate (not unlike span detection).
\end{compactitem}

\nextbook
\begin{book}
  \emph{CETR: content extraction via tag ratios} \\
  T. Weninger et al. (2010)
\end{book}
Instead of clustering the 1-dimensional text-to-tag ratio $x$,
cluster $(x, \va{ \dot x })$ (after smoothing).

\nextbook
\begin{book}
  \emph{A machine learning approach\\ to webpage content extraction} \\
  J. Yao and X. Zuo
\end{book}
After discarding \texttt{<nav>} and \texttt{<aside>} elements
(contents should be in \texttt{<article>}),
consider blocks rather than lines
and train a machine learning classifier (SVM, naive Bayes)
using the following features: 
number of words, average sentence length, text density, link density (and the ratios wrt the previous block),
block number (rescaled to $[0,1]$), id and class attributes.

\nextbook
\begin{book}
  \emph{CrossCat: a fully Bayesian nonparametric method for analyzing heterogeneous, high-dimensional data} \\
  V. Mansinghka et al.
\end{book}
CrossCat is a hierarchical nonparametric Bayesian model for tabular data, 
used by BayesDB, whose generative process looks like: 
\begin{compactitem}[--]
\item Partition the columns, using a Chinese restaurant process (CRP);
\item Likewise partition the rows;
\item Sample the parameters for each column (variable) in each intersection;
\item Sample the rows in each intersection.
\end{compactitem}

\nextbook
\begin{book}
  \emph{BayesDB: a probabilistic programming system for querying the probable implications of data} \\
  V. Mansinghka et al.
\end{book}
When you insert data in a table, BayesDB estimates a model that allows it to: 
\begin{compactitem}[--]
\item Sample new rows from the resulting joint or conditional distribution;
\item Compute the likelihood of each row, to detect outliers;
\item Retrieve similar rows;
\item Compute the mutual information (MI) between pairs of variables
  (or, rather, the probability that the posterior MI is nonzero),
  which is better than correlation at detecting dependencies;
\item Infer missing values.
\end{compactitem}

The univariate models (``data types'') are: 
\begin{compactitem}[--]
\item Numeric: normal-gamma;
\item Count: Poisson-gamma;
\item Binary: asymmetric Beta-Bernoulli;
\item Categorical: multinomial with symmetric Dirichlet prior.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Identifying almost identical files using context-triggered piecewise hashing} \\
  J. Kornblum (2006)
\end{book}
To check if two files are almost identical: 
\begin{compactitem}[--]
\item Compute a hash on a rolling window of moderate size 
  and note the positions at which it takes a specific value (trigger); discard the hashes;
\item Compute a hash for the parts between two triggers.
\end{compactitem}
[One could also compute a longer rolling hash and only keep the values if the first bytes have a specified value.]
This is implemented in \texttt{ssdeep}; similar algorithms include tlsh and sdhash.
Some use CTPH as features in machine learning algorithms to detect or cluster spam, malware, bot control centers, etc.

\nextbook
\begin{book}
  \emph{An introduction to topology} \\
  M.J. Dominus (2010)
\end{book}
A \emph{valuation} for classical logic is a map 
\[ v : \{ \text{formulas} \} \longrightarrow \{  \top, \bot \}. \]
Instead of $\{\top, \bot\}$, one can use 
$(\mathscr P(X), \inter, \union )$
or any other boolean algebra.
\emph{Tautologies} are formulas whose value is $\top$ (or $X \in \mathscr P(X)$).

For \emph{intuistionistic logic}, 
where $\neg p \vee p$ is not a theorem, one replaces Boolean algebras 
with sufficiently large \emph{Heyting algebras}, e.g., $\mathscr P(\RR)$:
\begin{align*}
A \vee B &= A \union B \\
A \wedge B &= A \inter B \\
A \to B &= ( A^c \union B)^\circ \\
\neg A &= A^{c\circ}.
\end{align*}
The \emph{compactness principle}
(\ie, Tychonov's theorem)
says that if any finite subset of a set of axioms has a model, then so does the whole set --
for instance, with the real numbers axioma and $\epsilon <1$, $\epsilon < 1/2$, $\epsilon < 1/3$, \dots, $\epsilon > 0$, this allows for infinitesimals. 

\nextbook
\begin{book}
  \emph{Tensor rank and the ill-posedness\\ of the best low-rank approximation problem} \\
  V. de Silva and L.H. Lim (2006)
\end{book}
Many properties of the rank of a matrix do not generalize to tensors of order $k\geq3$:
\begin{compactitem}[--]
\item The \emph{outer product rank}
\[ \rank \nolimits_{\otimes} A = \min \Bigl\{ n \ :\ 
\exists x_{ij} \ A = \sum_{i=1}^n x_{1i} \otimes \cdots \otimes x_{ki} \Bigr\}
\]
and the multilinear rank $\rank_\boxplus$
($k$-tuple of the dimensions of the spaces spanned by the columns of the $k$ matricizations of the tensor)
do not coincide.
\item A tensor in $\RR^{d_1 \times \cdots \times d_k}$
can have rank greater than $\min(d_1,\dots,d_k)$.
\item Tensor rank is not upper semi-continuous;
many tensors (a non-negligible set) do not have a best rank $r$ approximation: 
for instance, the rank-3 tensor 
\[ 
A = 
x_1 \otimes x_2 \otimes y_3 + 
x_1 \otimes y_2 \otimes x_3 + 
y_1 \otimes x_2 \otimes x_3
\]
can be approximated arbitrarily close by the rank-2 tensors
\begin{align*}
A_n &= n
\Bigl( x_1 + \dfrac1n y_1 \Bigr) \otimes
\Bigl( x_2 + \dfrac1n y_2 \Bigr) \otimes
\Bigl( x_2 + \dfrac1n y_2 \Bigr)  \\
&\hphantom{={}}
- n x_1 \otimes x_2 \otimes x_3.
\end{align*}
\end{compactitem}

\nextbook
\begin{book}
  \emph{Scalable latent tree model\\ and its application to health analytics} \\
  F. Huang et al.
\end{book}
The \emph{multivariate information distance}
\[ 
d(X,Y) = - \log \dfrac {
  \prod \sigma_i [ \cov(X,Y) ]
}{ \sqrt{
  \det \cov(X,X) \det \cov(Y,Y)
} }
\]
where the $\sigma_i$ are the top-$k$ singular values
generalizes the correlation to multivariate random variables
(on a tree, this distance is additive).

To learn a \emph{latent tree graphical model}
(an undirected graphical model, with no loops, and both observed and unobserved variables),
compute the matrix of multivariate information distances; 
build the corresponding minimum spanning tree; 
find triplets of nodes for which the distance is additive: this indicates the presence of a hidden node;
add it and iterate.
To estimate the model parameters, compute a low rank tensor decomposition of the third moment of triplets of variables $E[ X_1 \otimes X_2 \otimes X_3 ]$.

\nextbook
\begin{book}
  \emph{High-dimensional neural spike train analysis\\ with generalized count\\ linear dynamical systems} \\
  Y. Gai et al.
\end{book}
The Poisson distribution $p(k) \propto \lambda^{-k} e^{-k} / k!$ 
is a special case of the \d{generalized count} (GC) distribution,
$p(k) = e^{ \theta k + g(k) } / k!$
which can account for over- or under-dispersion.

It can be used in latent variable models 
$ y_{ij} | x_j \sim \text{Poisson}( \exp c_i' x_j + d ) $
where the state $x_j$ is modeled by a Gaussian dynamic system
$ x_{j,t+1}  | x_{j,t} \sim N( A x_{jt} + b, Q ) $.

\nextbook
\begin{book}
  \emph{Large scale unusual time series detection} \\
  R.J. Hyndman et al. (2015)
\end{book}
To detect outliers in a dataset of time series: 
compute features for each time series
(mean, variance, autocorrelation, trend, linearity, 
curvature, seasonality, peakedness, troughiness, 
spectral entropy, lumpiness, spikiness, level shift, 
variance change, flat spots, crossing points, Kullback-Leibler, etc. -- 
scagnostics),
reduce the dimension (PCA), and use 2-dimensional outlier detection algorithms 
(alpha-hull or density-based).

\nextbook
\begin{book}
  \emph{Topology data analysis of critical transitions in financial networks} \\
  M. Gidea (2017)
\end{book}
Compute the correlation matrix of asset returns on a moving window, 
convert it to a distance 
$d_{ij} = \sqrt{ 1 - c_{ij} }$,
compute the persistence diagram of the corresponding Rips filtration 
(with \texttt{TDA::ripsDiag})
and look at the Wasserstein or bottleneck distance between two dates: 
they may help forecast crises.

[How different is it from the $L^2$ distance between the correlation matrices?]

\nextbook
\begin{book}
  \emph{Network-based anomaly detection\\ for insider trading} \\
  A. Kulkarni et al.
\end{book}
Build a network with insiders (of the same company) as nodes
and an edge whenever the length of the
\emph{longest common subsequence} (LCS) of ordered trade dates exceeds some threshold 
(5 for sales, 10 for purchases).
Look at the \emph{egonets}, \ie, the subgraphs induced by the nodes at distance at most one from a given node.
Identify outliers by the residuals of 
$\log \#E \sim \log \# V$ for the egonets,
and the local outlier factor (LOF) comparing the density of a node with that of its neighbours;
they are hubs or bridges between highly connected components.

The same approach applies to hypergraphs 
(a hyperedge between a set of insiders if the length of the LCS of trade dates exceeds some threshold);
the profit of the transactions in those hyperedges tends to be positive.

\nextbook
\begin{book}
  \emph{Graph-based anomaly detection} \\
  C.C. Noble and D.J. Cook (2003)
\end{book}
To detect repetitive patterns (substructures) in a graph,
compare the description length of the graph before and after contracting this substructure
\[ \text{DL}(G) - \bigl( \text{DL}(G|S) + \text{DL}(S) \bigr). \]
Compress the most frequent substructure and iterate (``Subdue'' algorithm).

To detect anomalies in a graph.
compute 
\[
  A = 1 - \dfrac1n \sum_1^n ( n - i + 1 ) \dfrac{
  \text{DL}_{i-1}(S) - \text{DL}_i(S)
  }{
  \text{DL}_0(S)
  } 
\]
for each substructure $S$, where $\text{DL}_i(S)$ is the description length of $S$ after $i$ steps of the algorithm. 

To detect anomalies in a graph, one could also find substructures $S$ such that 
\[ \text{size of $S$} \times \text{number of instances of $S$} \]
be small.

\nextbook
\begin{book}
  \emph{RolX: Structural role extraction\\ and mining in large graphs} \\
  K. Henderson et al. (2012)
\end{book}
To identify ``roles'' in a network (e.g., star center, clique member, peripheral node, etc.),
compute node features
(degree, number of within-egonet edges, average and maximum neighbour degree, 
number of triangles, etc.) and soft-cluster them with nonnegative matrix factorization (NMF).

\nextbook
\begin{book}
  \emph{It's who you know: graph mining\\ using recursive structural features} \\
  K. Henderson et al. (2010)
\end{book}
\emph{Recursive graph features} are built as follows: 
\begin{compactitem}[--]
\item Number of within-egonet edges;
\item Number of edges leaving or entering the egonet;
\item Mean or sum of a feature over the egonet.
\end{compactitem}
Prune the features by discarding those similar to previous ones; 
prune them further by focusing on those with good predictive power on node attributes. 

Applications include graph de-anonymization, graph isomorphism, 
graph-based anomaly detection.

\nextbook
\begin{book}
  \emph{Graph-based anomaly detection\\ and description: a survey} \\
  K. Akoglu et al. 
\end{book}
% Good survey

\nextbook
\begin{book}
  \emph{Statistical industry classification} \\
  Z. Kakushadze and W. Yu (2017)
\end{book}
To cluster stocks, use excess returns, normalized by the squared volatility 
(rather than the volatility, to reduce the influence of volatile stocks -- 
in practice, consider something like 
$ r / \sigma \max(\bar\sigma, \sigma) $
to avoid creating a similar problem with low-volatility stocks).

To choose the number of clusters, use the \emph{effective rank}
of the correlation matrix: 
\begin{align*}
  & \lambda_1, \dots, \lambda_n \text{ eigenvalues} \\
  & p_i = \dfrac{ \lambda_i }{ \sum \lambda_j } \\
  & H = - \sum p_i \log p_i \text{ (spectral) entropy} \\
  & \operatorname{erank} C = \exp H.
\end{align*}
\nextbook
\begin{book}
  \emph{The effective rank:\\ a measure of effective dimensionality} \\
  O. Roy and M. Vetterli (2007)
\end{book}
Instead of minimizing the rank of a matrix, minimize its \d{effective rank}:
compute its singular values 
$\sigma_1 \geq \cdots \geq \sigma_m \geq 0$,
rescale them $p_i = \sigma_i / \sum \sigma_j$,
compute the \emph{spectral entropy} $H = - \sum p_i \log p_i $
and take its exponential.
\nextbook
\begin{book}
  \emph{Statistical risk models} \\
  Z. Kakushadze and W. Yu (2017)
\end{book}
To estimate the number of factors in a statistical risk model,
use the effective rank: 
compute the eigenvalues, rescale them to have a probability distribution, compute its entropy, 
and the corresponding effective number of values.

Since the ``market'' factor dominates, the result is often close to 1: 
if this is not desirable, remove the largest eigenvalue and add 1 back at the end.

Optimization can be approximated with a weighted regression on the first principal components,
with the inverse of the specific variances as weights. 

\nextbook
\begin{book}
  \emph{Decoding Chinese stock market returns: three-state hidden semi-Markov model} \\
  Z. Liu and S. Wang (2016)
\end{book}
The \emph{Taylor effect} is yet another stylized fact:
$ \cor( \va{ r_t }^\theta, \va{ r_{t-\tau} }^\theta ) $
is maximum for $\theta = 1$.

In a hidden Markov model (HMM),
the sojourn time follows a geometric distribution.
\d{Hidden semi-Markov models} 
(HSMM, estimated with the EM algorithm)
relax that restriction by separately modeling the sojourn time and the state transitions.

\nextbook
\begin{book}
  \emph{Spatial dependence in asset pricing models} \\
  B. Zhu and S. Milcheva
\end{book}
To price real estate firms, add the physical distance between their properties to the CAPM or the factor model used.
\[ 
r_i = \alpha_i + \rho \sum_{ j \neq i} w_{ij} r_j + \sum_k \beta_{ik} f_k + \epsilon_i,
\quad
w_{ij} \propto d_{ij}^{ -1 } \text{ or } d_{ij}^{-2}
\]

\nextbook
\begin{book}
  \emph{Time series copulas for heteroskedastic data} \\
  R. Loaiza-Maya et al. (2016)
\end{book}
In presence of heteroskedasticity, the dependence structure of a time series 
$(X_{t-1}, X_t)$ cannot be described by the common parametric copulas: 
the observations gather in the four corners, or along an ``X'',
instead of one or two corners and along a diagonal.

One can use \emph{mixtures of rotated copulas}
(or D-vines (drawable vines) of them, in higher dimensions).

\nextbook
\begin{book}
  \emph{DEA portfolio modeling} \\
  S.M. Gasser (2016)
\end{book}
Data envelopment analysis (DEA) is often used as a screening step, 
to select stocks according to multiple criteria,
before portfolio optimization.
Instead, one can directly use the DEA efficiency score to compute the portfolio weights
(just rescale them).

\nextbook
\begin{book}
  \emph{Deep learning for finance: deep portfolios} \\
  J.B. Heaton et al. (2016)
\end{book}
Use autoencoders for non-linear PCA regression
to replicate an index, 
or to explain returns (as with the CAPM or factor models).

\nextbook
\begin{book}
  \emph{The volatility of bitcoin} \\
  A. Urquhart (2017)
\end{book}
The \emph{heterogeneous auto-regressive} (HAR) model is an alternative to GARCH models with high frequency data: 
\[ \sigma_{[t,t+1]} \sim \sigma_{[t-1,t]} + \sigma_{[t-7,t]} + \sigma_{[t-30,t]}. \]

\nextbook
\begin{book}
  \emph{Efficient algorithms for computing\\ risk parity portfolio weights} \\
  D. Chaves et al. (2012)
\end{book}
The risk parity portfolio can be computed using Newton's method to solve 
\begin{align*}
  & V w = \lambda w^{-1} \\
  & w' 1 = 1
\end{align*}
(the unknowns are $\lambda$ and $w$),
\begin{align*}
J &= \begin{pmatrix} V + \lambda \diag( w^{-2} ) & - w^{-1} \\ 1' & 0 \end{pmatrix} \\
\begin{pmatrix} w \\ \lambda \end{pmatrix} &\leftarrow
\begin{pmatrix} w \\ \lambda \end{pmatrix} - J^{-1} 
\begin{pmatrix} Vw - \lambda w^{-1} \\ 1' w - 1 \end{pmatrix}
\end{align*}
or by iterating 
\begin{align*}
  w_i &\leftarrow \dfrac{ \beta_i ^ {-1} }{ \sum \beta_j^{-1} } \\
  \beta_i &\leftarrow \dfrac{ (Vw)_i }{ w' V w }.
\end{align*}
These algorithms are not guaranteed to converge.

\nextbook
\begin{book}
  \emph{A fast algorithm for computing high-dimensional risk parity portfolios} \\
  T. Griveau-Billion et al.
\end{book}
The usual algorithm to find long-only risk parity portfolios, 
sequential quadratic programming (SQP) to equalize the total contributions to risk, \ie, minimize 
\[ \sum_{i<j} ( \text{TCTR}_i - \text{TCTR}_j )^2, \]
does not scale.

Use coordinate descent to minimize 
$\sqrt{ w' V w } - \sum b_i \log w$
(where the $b_i$ are the risk budgets): 
$w_i$ is the positive solution of 
\[ \sigma_i w_i^2 + \biggl( \sum_{j\neq i} w_j \rho_{ij} \sigma_i \sigma_j \biggr) w_i - b_i \sqrt{ w' V w } = 0. \]

\nextbook
\begin{book}
  \emph{Constrained Kelly portfolios\\ under $\alpha$-stable laws} \\
  N. Wesselh\"offt (2016)
\end{book}
Add a CVaR constraint to the growth-optimal strategy, 
and assume $\alpha$-stable returns.

\nextbook
\begin{book}
  \emph{Managing diversification} \\
  A. Meucci (2010)
\end{book}
The eigendecomposition 
$E' \Sigma E = \Lambda$ of the variance matrix $\Sigma$ of asset returns $X$
defines \emph{principal portfolios},
with returns $E' X$.
Their contributions to portfolio variance $w' \Sigma w$ are 
$(E^{-1} w) \odot (E^{-1} w) \odot \diag \Lambda$;
dividing by $w' \Sigma w$ gives the \emph{diversification distribution}
whose entropy defines the \d{effective number of uncorrelated bets}.

If market exposure is not under our control, 
remove the first principal portfolio.
If there are more constraints, write them as 
$A w = b $
and compute the corresponding 
\d{conditional eigenvectors}
\[
  e_i = \argmax_{\substack{
    e \text{ such that } \\
    e' e = 1 \\
    Ae = 0  \\
    \forall j < i \ e' \Sigma e_j = 0
  }} 
  e' \Sigma e.
\]
They can be computed (using Lagrange multipliers) as 
\begin{align*}
  B &= \begin{pmatrix} A \\ e_1' \Sigma \\ \vdots \\ e'_{j-1} \Sigma \end{pmatrix} \\
  P &= I - B' ( B B' )^{-1} B \\
  e_i &= \argmax\limits_{ \n e = 1 } e' P \Sigma P' e.
\end{align*}
We still have $E' \Sigma E = \Lambda$,
with $\Lambda$ diagonal,
but $E' \neq E^{-1}$.

One can then look at the mean-entropy frontier.

\nextbook
\begin{book}
  \emph{Building diversified portfolios\\ that outperform out-of-sample} \\
  M. L\'opez de Prado
\end{book}
\d{Hierarchical risk parity} (HRP) aims to circumvent \emph{Markowitz's curse}: 
  the more correlated the investments,
  the greater the need for diversification,
  and yet the more likely we will receive unstable solutions.
Other approaches include: constraints, Bayesian priors, robust optimization, 
numerically stable variance estimators (shrinkage, factor models, graphical lasso).

Compute the sample correlation matrix $\rho$,
the corresponding distances $d_{ij} = \sqrt{ 1 - \rho_{ij} }$ and
the distances between those distances 
$\delta_{ij} = \n{ d_{\cdot,i} - d_{\cdot,j} }_2 $;
perform single linkage hierarchical clustering
and use it to reorder the covariance matrix: 
it is now near-diagonal.

By analogy with the (unconstrained) minimal variance portfolio, 
$w = V^{-1} 1 / 1' V^{-1} 1 $, 
whose weights are the inverses of the variances when the variance matrix is diagonal: 
\begin{compactitem}[--]
\item Start with the full set of assets $L = \{ 1, \dots, n \}$ and initial weights $(1,\dots,1)'$;
\item Split $L$ in two, $L = L_1 \union L_2$
  [they use two halves, but with a more balanced hierarchical clustering (e.g., complete linkage),
  it would make more sense to use it]; 
\item Compute the variances of the corresponding inverse-variance-weighted portfolios
  \begin{align*}
  V & = \begin{pmatrix} V_1 & \\ & V_2 \end{pmatrix} \\
  w_i & \propto (\diag V_1 )^{-1} \\
  v_i &= w_i ' V w_i;
  \end{align*}
\item Rescale the weights 
  [this does not preserve the sum of the weights]
  \begin{align*}
    w_{I_1} & \leftarrow \alpha \, w_{I_1} \\
    w_{I_2} & \leftarrow (1-\alpha) \, w_{I_2} \\
    \alpha &= \dfrac{ v_2 }{ v_1 + v_2 };
  \end{align*}
\item Continue recursively.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Interconnectedness risk \\and active portfolio management} \\
  E. Baitinger and J. Papenbrock (2016)
\end{book}
Peripheral stocks, for some measure of centrality (betweenness, closeness,
eccentricity, degree, eigenvector)
of the minimum spanning tree (or some other ``strongly filtered graph'')
built from the correlation matrix of daily returns,
estimated on a 6-month moving window,
have higher risk-adjusted returns.
Build a portfolio by minimizing the average centrality (with a few constraints: 
$w' 1 = 1, \n{w - w_0}_1 \leq \epsilon$ -- it is a linear problem);
compare with minimum variance, minimum average correlation, 
maximum diversity, 
maximum entropy, 
hierarchical risk parity;
measure the performance with Jensen's alpha, 
the upside capture ratio
\[ 
\text{UC} = \dfrac{
  E[ \text{portfolio returns} \,|\, \text{market up} ]
}{
  E[ \text{market returns} \,|\, \text{market up} ]
},
\]
the downside capture ratio, or the certainty equivalent return 
for $U(W) = W^{1-\gamma} / (1-\gamma)$ for $\gamma \in \{3,5,10\}$.

\nextbook
\begin{book}
  \emph{Interconnectedness risk \\and active portfolio management: \\the information-theoretic perspective} \\
  E. Baitinger and J. Papenbrock (2017)
\end{book}
Build minimum centrality portfolios from the \emph{mutual information} rather than the correlation
[one could also use the \emph{distance correlation}].
In R check \texttt{entropy::mi.plugin} or \texttt{infotheo::mutinformation}.

\nextbook
\begin{book}
  \emph{The real side\\ of the high-volume return premium} \\
  D. Israeli et al. (2017)
\end{book}
Abnormal volume around earnings announcements increases 
investor recognition and firm visibility,
decreases the cost of capital, 
and increases future investments.
The effect remains after controlling for sales, cash flow,
current investments, legerage, Tobin's Q, earnings surprises,
abnormal returns around earnings, etc.,
but is more pronounced for financially-constrained firms (low assets, low payout ratio)
and has been decreasing as information becomes more readily available.

\emph{Tobin's Q} is 
\begin{align*}
Q &= \dfrac{ \text{Market value of assets} }{ \text{Book value of assets} } \\
& = \dfrac{ \text{BV}( \text{assets} ) + \text{MV}(\text{equity}) - \text{BV}(\text{equity}) }{
  \text{BV}( \text{assets} ) }
\end{align*}

\nextbook
\begin{book}
  \emph{The limits of arbitrage and stock mispricing: evidence from decomposing\\ the market to book ratio} \\
  N.M. Al-Shammasi (2017)
\end{book}
Stocks with easily-identified peers have a lower mispricing.
The nearest stock is that with the closest \emph{propensity score}, \ie, 
predicted value of a logistic regression 
$\mathbf{1}_{\text{S\&P 500}} \sim \text{Fama-French}$.
[Other measures of proximity may be more meaningful: 
density (LOF), correlation, mutual information, distance correlation, cointegration test, etc.]

\nextbook
\begin{book}
  \emph{Programmed selection\\ of cyclical turning points} \\
  G. Bry and C. Boschan (1971)
\end{book}
To detect business cycles on a ``clean'' time series: 
\begin{compactitem}[--]
\item Find local minima and maxima, with a  5-month or 2-quarter window;
\item Prune them to ensure there are no consecutive minima or maxima; keep the most extreme;
\item Prune them to ensure ``up'' and ``down'' periods are at least 5 months long, 
  and the cycles (up-then-down or down-then-up) 15 months;
\item Remove extrema too close to or inconsistent with the extremities.
\end{compactitem}
For a real-world time series: 
\begin{compactitem}[--]
\item Apply the procedure to the 12-month moving average;
\item Pick the local extrema of the Spencer curve (a moving average with more weight at the center)
  best matching those points (most extreme in a 5-month radius);
\item Pick the local extrema of the raw data best matching those points.
\end{compactitem}

\nextbook
\begin{book}
  \emph{Dating the Euro area business cycle} \\
  M. Artis et al.
\end{book}
Markov switching models can help identify business cycles.

The local maxima and minima of a price time series
give a set of candidate latent state sequences: 
we can compute the likelihood of each of them
and pick the best. 
Duration constraints can be imposed by enlarging the state space to contain 
the $(S_1,\dots,S_{15})$ satisfying the constraints; 
the only transitions are 
$(S_1,\dots,S_{15}) \to (S_2,\dots,S_{15}, *)$.
For monthly data, it may be necessary to filter the time series to remove low frequency patterns, e.g., with a band-pass filter or an HP filter. 

\nextbook
\begin{book}
  \emph{Noise fit, estimation error\\ and a Sharpe information criterion} \\
  D. Paulsen and J. S\"ohl (2016)
\end{book}
The realized information ratio tends to be much lower than the forecasted one: correct it.
\[ 
  \text{IR}_{\text{out}} = \text{IR}_{\text{in}} - \dfrac{
    \# \text{parameters or assets}
  }{
    \text{IR}_{\text{in}} \times \# \text{periods}
  }
\]

\nextbook
\begin{book}
  \emph{Option-based benchmark indices -- a review\\ of performance and (in)appropriate measures} \\
  M. Natter (2017)
\end{book}
Jensen's alpha (the CAPM intercept) is inappropriate to measure the performance of option strategies
(for which there are now many indices and even a few ETFs): 
\begin{compactitem}[--]
\item Let the CAPM beta vary with time (e.g., make it a linear or 2-valued function of market returns);
\item Add a straddle factor to the CAPM;
\item Correct Jensen's alpha for skewness (Leland): 
\begin{align*}
  x &: \text{market log-returns}\\
  y &: \text{strategy log-returns}\\
  b &= \dfrac{ E[x] }{ \var[x] } \\
  \beta &= \dfrac{ 
    \cov( e^x, - e^{-by} )
  }{ 
    \cov( e^x, - e^{-bx} )
  } \\
  \alpha &= E[y] - \beta E[x]
\end{align*}
\item Adjust the Sharpe ratio for higher moments (Stutzer index): 
\begin{align*}
  I &= \max\limits_\theta - \log E[ e^{\theta y} ] \\
  \text{IR} &= \sqrt{ 2 I } \times \operatorname{sign} E[y].
\end{align*}
\end{compactitem}

%% 2017-03-31
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\nextbook
\begin{book}
  \emph{Information geometry\\ and statistical manifolds} \\
  M. Suzuki (2014)
\end{book}
% Only definitions. No/few motivation
Consider a family of probability distributions indexed by an open set 
$\Omega \subset \RR^n$,
$ S = \{ p( \cdot, \xi ) \ : \ \xi \in \Omega \}. $
The \emph{Fisher information matrix} 
\[ g_{ij}(\xi) = E[ \partial_i \ell_\xi \partial_j \ell _\xi ] = - E[ \partial_i \partial_j \ell_\xi ] \]
where $\ell_\xi = \log p(\cdot,\xi)$
and $\partial_i = \partial / \partial \xi_i$,
defines a Riemann structure on $S$.
For instance, the Gaussian (1-dimensional) family is the Poincar\'e half plane
\begin{align*}
\Omega &= \RR \times \RR_+^\times \\
S &= \{ N(\mu,\sigma^2) \ :\ (\mu,\sigma) \in \Omega \} \\
g_{ij} ( \mu, \sigma ) &= \begin{pmatrix} \sigma^{-2} & 0 \\ 0 & 2 \sigma^{-2} \end{pmatrix}
\end{align*}

The $\alpha$-connection,
\begin{align*}
\Gamma_{ijk}^\alpha &= \langle \nabla_{\partial_i} ^\alpha \partial_j, \partial_k \rangle \\
&= E \Bigl[
  \Bigl(
    \partial_i \partial_j \ell_\xi + 
    \dfrac{1-\alpha}2 \partial_i \ell_\xi \partial_j \ell_\xi 
  \Bigr) 
  \partial_k \ell_\xi
  \Bigr],
\end{align*}
for $\alpha \in \{-1,0,+1\}$,
satisfies 
\begin{align*}
  \Gamma_{ijk}^\beta &= \Gamma_{ijk}^\alpha + \dfrac{\alpha - \beta}2 T_{ijk} \\
    T_{ijk} &= E[ \partial_i \ell_\xi \partial_j \ell_\xi \partial_k \ell_\xi ] \\
    \nabla^\alpha &= (1-\alpha) \nabla^0 + \alpha \nabla^1 = 
    \dfrac{1+\alpha}2 \nabla^1 + \dfrac{1-\alpha}2 \nabla^{-1}
\end{align*}
where 
\begin{compactitem}[--]
\item $\nabla^0$ is the Levi-Civita connection (compatible with the metric, torsion-free);
\item $\nabla^1$ is called the \emph{exponential connection}; 
  it is flat if $S$ is an exponential family;
\item $\nabla^{-1}$ is called the \emph{mixture connection};
it is flat is $S$ is a mixture family.
\end{compactitem}   
Computations with $\nabla^{1}$ and $\nabla^{-1}$ are often easier than those with $\nabla^0$: they involve divergences rather than geodesic distances. 

\nextbook
\begin{book}
  \emph{Information geometry for neural networks} \\
  D. Wagenaar (1998)
\end{book}

Families of distributions are often parametrized by an open of $\RR^n$: this endows them with a geometric structure 
(differential manifold), but the Euclidean distance is inappropriate.
\emph{Fisher information} gives a better (parametriation-independent) 
Riemannian structure: 
\[ g_{\mu\nu} = E[ \partial_\mu \ell \partial_\nu \ell ] = 
- E[ \partial_\mu \partial_\nu \ell ]. 
\]

A \emph{parallel transport} is a 
differentiable way of comparing tangent spaces at different points,
when they are linked by a curve,
\[
\Phi_{ P \overset{\!\gamma}{\rightarrow} P' } : 
T_{P'} M \longrightarrow T_P M,
\]
with $\Phi_{P\to P} = \text{Id}$.
Its first Taylor expansion,
for $P=\gamma(0)$, $P'=\gamma(\epsilon)$, 
$\dot\gamma(0) = \partial_\mu$,
can be written 
\[ 
\Phi_{ P \overset{\!\gamma}{\rightarrow} P' }  ( \partial_\nu ) = 
\partial_\nu + 
\epsilon \Gamma_{\mu\nu}^\rho \partial_\rho + o(\epsilon)
\]
and defines a \emph{connection} $\Gamma$.

\emph{Tangent vectors} have several interpretations: 
\begin{compactitem}[--]
\item 1-jets, \ie, equivalence classes of curves;
\item Derivatives, $\partial_\mu$;
\item Random variables, $\partial_\mu \ell$, \ie, functions of $X$.
\end{compactitem}
This last interpretation is specific to statistical manifolds 
and allows us to define two new connections. 
A connection is a mappting between 
$T_\theta M$ and $T_{\theta + \delta\theta} M$,
whose bases are 
\begin{align*}
  &\partial_\mu \ell(\theta) \\
  &\partial_\mu \ell( \theta + \delta\theta ) = 
  \partial_\mu \ell(\theta) + 
  \partial_\mu\partial_\nu \ell(\theta) \delta\theta^\nu + 
  O( \delta \theta^\mu \delta \theta^\nu ).
\end{align*}
We can modify the second term to make its expectation disappear
(this looks desirable since $E[ \partial_\mu \ell(\theta) ] = 0$)
in two ways
\begin{align*}
& \partial_\mu \partial_\nu \ell(\theta) + E[ \partial_\mu\ell \partial_\nu\ell ] \\
\text{or} \quad & \partial_\mu \partial_\nu \ell(\theta) - \partial_\mu\ell \partial_\nu\ell. 
\end{align*}
Projecting the random variable onto $T_\theta M$,
\[ \text{proj} : A \longmapsto  E[ A \partial_\nu \ell ] g^{\mu\nu} \partial_\mu\ell \]
gives 
\begin{align*} 
\Gamma_{\mu\nu}^\lambda &= 
E[ 
  \partial_\mu \partial_\nu \ell \, \partial_\rho \ell 
] 
g^{ \rho \lambda }  \\
\text{and} \quad
\Gamma_{\mu\nu}^\lambda &= 
E[ 
  \partial_\mu \partial_\nu \ell \, \partial_\rho \ell + 
  \partial_\mu \ell \, \partial_\nu\ell \, \partial_\rho\ell 
] 
g^{\rho\lambda}. 
\end{align*}
This defines the family of \emph{$\alpha$-connections}
\[ 
\Gamma^{(\alpha)}_{\vphantom{\mu}} \vphantom{\Gamma}^{\lambda}_{\mu\nu} = 
E\Bigl[ 
  \partial_\mu \partial_\nu \ell \, \partial_\rho \ell + 
  \dfrac{ \alpha - 1 }{ 2 } 
  \partial_\mu \ell \, \partial_\nu\ell \, \partial_\rho\ell 
\Bigr] 
g^{\rho\lambda}. 
\]
The metric connection 
\[
\Gamma_{\mu\nu}^\lambda = \tfrac12 [
\partial\mu  g_{\nu\rho} + 
\partial\nu  g_{\mu\rho} -
\partial\rho g_{\mu\nu} 
] g^{\rho\lambda}
\]
is $\Gamma^{(0)}$.

Parallel transport does not usually preserve scalar products.
Two connections $\Gamma$ and $\Gamma^*$ are \emph{dual}
if the vector fields $X$ and $Y^*$, 
defined as the parallel transport of 
$X|_{\gamma(0)}$
and 
$Y|_{\gamma(0)}$
wrt $\Gamma$ and $\Gamma^*$
along a curve $\gamma$
satisfy 
\[ \forall t \quad \langle X(t) , Y^*(t) \rangle = \langle X(0), Y(0) \rangle. \]
The $\alpha$ and $-\alpha$ connections are dual.

For dually flat connections, $\Gamma$, $\Gamma^*$,
there exist local coordinate systems $\theta$, $\tilde \theta$,
such that $\Gamma \equiv 0$ and $\Gamma^* \equiv 0$,
and potential functions 
$\Theta(\theta)$, $\tilde\Theta(\tilde\theta)$
such that 
$\tilde\theta_\mu = \partial_\mu \Theta(\theta)$
(and conversely).
The \emph{divergence} 
between two points $P$ and $Q$ 
is
\[ D(P,Q) = \Theta( \theta_P) + \tilde\Theta( \tilde\theta_Q) - \theta_P^\mu \tilde\theta_{Q,\mu}. \]
It behaves like a distance, but is easier to compute: there is no need to integrate along a geodesic.
\begin{align*}
  & D(P,Q) \geq 0 \\
  & D(P,Q) = 0 \equiv P + Q \\
  & \left. \dfrac{ \partial D(P,Q) }{ \partial \theta } \right|_{P=Q} = 0 \\
  & \dfrac{ \partial^2 D(P,Q) }{ \partial \theta^\mu \, \partial \theta^\nu } = g_{\mu\nu}(P)
\end{align*}

\nextbook
\begin{book}
  \emph{A computational approach\\ to Fisher information geometry\\ with applications to image analysis} \\
  W. Mio et al.
\end{book}
Given two probability density functions (pdf) on $[0,1]$,
how can we deform one into the other?
Those pdfs form an infinite dimensional statistical manifold
(we can represent a pdf $p$ with its log-likelihood $\phi = \log p$): 
\begin{align*}
  \mathscr P &= \textstyle \bigl\{\, \phi \ :\ \int e^\phi = 1 \,\bigr\} \\
  T_\phi \mathscr P &= \textstyle \bigl\{\, f \ :\ \int f e^\phi = 0 \,\bigr\} \\
  \langle f , g \rangle &= \int f g e^\phi 
\end{align*}
(for the scalar product, use the Hessian of the Kulback-Leibler divergence).
Discretizing the pdf on an equispaced grid gives
\begin{align*}
  \mathscr P_n &= F^{-1}(1) \\
  F &: \left\{
  \begin{array}{rcl}
  \RR^n & \longrightarrow & \RR \\
  \phi & \longmapsto & \displaystyle\sum e ^ {\phi_i}
  \end{array}
  \right. \\
  \langle f, g \rangle_\phi &= \sum f_i g_i e^{\phi_i} \\
  T_\phi \mathscr P_n &= \bigl\{\, f \ :\ \langle f, \mathbf 1 \rangle _\phi = 0 \, \bigr\} \\
  d F_\phi(f) &= \sum f_i e^{ \phi_i } = \langle f, \mathbf 1 \rangle _\phi
\end{align*}
Geodesics in a given direction can be computed
by iterating the following steps (?).
\begin{align*}
  \phi_0 &: \text{ starting point} \\
  f_0 &: \text{ direction} \\
  \phi_1 & \leftarrow \phi_0 + \epsilon f \\
  \phi_1 & \leftarrow \phi_1 + \alpha \mathbf 1 
  \text{, with $\alpha$ s.t. } F \phi_1 = 1\\
  f_1 & \leftarrow f_0 - \langle f_0, \mathbf 1 \rangle_{ \phi_1 } \mathbf 1 \\
  f_1 &\leftarrow \n{ f_0 } \dfrac{ f_1 }{ \n{ f_1 } } \\
\end{align*}
For the geodesic between two points, use the shooting method
to find the correct direction to reach the desired target in unit time.

Those geodesics can help compute Fr\'echet means, 
perform PCA or $k$-means.

\nextbook
\begin{book}
  \emph{Computational information geometry\\ for machine learning} \\
  F. Nielsen (MLSS 2015)
\end{book}

% Exponential families
\textbf{1.} 
A statistic $t$ is \emph{sufficient} for a parameter $\theta$
if 
\[ P\bigl(X \,|\, t(X), \theta \bigr) = P\bigl(X \,|\, t(X) \bigr). \]
The probability can then be decomposed as 
(Fisher--Neyman theorem) 
\[ P(x; \theta) = g\bigl( t(x), \theta \bigr) h(x) .\]
This motivates the \d{exponential family}:
\begin{align*}
p(x;\theta) &= \exp \bigl[
\langle t(x), \theta \rangle - F(\theta ) + k(x) 
\bigr] \\
t(x) &: \text{ sufficient statistic} \\
k(x) &: \text{ auxiliary term} \\
F(\theta) &: \text{ normalization constant}.
\end{align*}
Many common distributions are exponential (Uniform, Cauchy and stable distributions are not exponential).

The normalizing constant 
\[ F(\theta ) = \log \int \exp \bigl[ \langle t(x), \theta \rangle + k(x) \bigr] dx \]
is convex.
Its convex conjugate is 
\[ F^*( \eta ) = \sup_{ \theta \in \Theta } \langle \eta, \theta \rangle - F(\theta), \]
for $\eta \in H$, $H = \{ \nabla F(\theta) \ : \ \theta \in \Theta \}$,
and the supremum is obtained for 
$\theta = \nabla F^* (\eta) = (\nabla F)^{-1} (\eta)$. 
The \emph{canonical divergence} is 
(Fenchel--Young inequality)
\[ A_F(\theta : \eta ) = F(\theta) + F^*(\eta) - \langle \eta, \theta \rangle \geq 0. \]
Exponential families have two parametrizations.
\[
\begin{array}{ccc}
  \text{natural} && \text{expectation} \\
  \theta \in \Theta & \longleftrightarrow & \eta \in H \\
  \theta = \nabla F^*(\eta) & & \eta = \nabla F(\theta) = E[ t(X) ].
\end{array}
\]
The maximum likelihood estimator is easy to compute in expectation coordinates: 
$\eta = E[ t(X) ]$.

% (M,g)
\textbf{2.}
The \d{Fisher information} is the variance of the \emph{score}, 
\ie, the information a random variable $X$ carries about a parameter $\theta$.
It defines a metric on statistical manifolds
\[
  g_{ij}(\theta) 
  = E[ \partial_i \ell \, \partial_j \ell ] 
  = - E[ \partial_i \partial_j \ell ] 
  = 4 \int \partial_i \sqrt p \, \partial_j \sqrt p dx.
\]
The \emph{exponential map} 
maps (a star-shaped neighbourhood of the origin in) 
$T_x M$ to $M$: 
$v \mapsto \exp_x(v) = \gamma_v(1)$;
its inverse is $\log_x$.
Location-scale families (Gaussian, Cauchy, Student, etc.)
are hyperbolic (they have negative curvature);
the multinomial family is spherical.

On a statistical manifold, one can interpret tangent vectors as random variables,
e.g., 
$\partial_i p(x)$,
$\partial_i \ell(x)$,
$2\partial_i \sqrt{ p(x) }$,
or, more generally, 
$\partial_i f_\alpha(x)$, 
where
\[
  f_\alpha(u) = 
  \begin{cases}
  \dfrac{2}{1-\alpha} u^{\textstyle \frac{1-\alpha}2 } & \alpha \neq 1 \\
  \log u & \alpha = 1 
  \end{cases}
\]
For a univariate Gaussian, the Fisher information is 
\[ I(\mu,\sigma) = \sigma^{-2} \begin{pmatrix} 1 & 0 \\ 0 & 2 \end{pmatrix}; \]
after rescaling, this is the Poincar\'e half plane.
Positive matrices are also hyperbolic spaces,
e.g., the Poincar\'e disk (conformal) or the Klein disk (not conformal).

\emph{Information geometric optimization} uses 
the natural gradient $I^{-1} \nabla f$ instead of the gradient $\nabla f$.

\emph{Jeffrey's prior},
$q(\theta) \propto \sqrt{ \va{ g(\theta ) } }$,
is invariant under reparametrization.

% (M, g, \nabla, \nabla^*), (M,g,T)
\textbf{3.}
The Riemannian metric is not the only way of defining geodesics and ``distances''.
Given two probability distributions $p$ and $q$, one can consider curves between them: 
\begin{align*}
  &\gamma_m: & r(x,t) &= \alpha p(x) + (1-\alpha) q(x) \\
  &\gamma_e: & \log r(x,t) &= \alpha \log p(x) + (1-\alpha) \log q(x) + c.
\end{align*}
They are geodesics for the dual \emph{mixture} (m) 
and \emph{exponential} (e) \d{connections}.
For the exponential family, they are flat, 
and $\Gamma \equiv 0$, resp. $\Gamma^* \equiv 0$, 
in the $\theta = \nabla F^*(\eta)$ and $\eta = \nabla F(\theta)$ coordinate.
The metric tensor can be recovered from the \emph{potential functions} $F$ and $F^*$: 
\begin{align*}
  g_{ij}(\theta) &= \dfrac{ \partial^2 F(\theta) }{ \partial \theta_i \, \partial \theta_j } &
    \Gamma_{ijk}^\alpha &= \dfrac{ 1 - \alpha }2 \dfrac{ \partial^3 F(\theta) }{ \partial \theta_i \, \partial \theta_j \, \partial \theta_k } \\
  g^{ij}(\eta) &= \dfrac{ \partial^2 F^*(\eta) }{ \partial \eta_i \, \partial \eta_j } &
  \kappa &= \dfrac{ 1 - \alpha^2 }{ 4 }
\end{align*}
If $p(x;\theta) = \exp \bigl[ \langle \theta,x\rangle - F(\theta) \bigr] $, 
$F$ is the \emph{cummulant} dunction
and $F^*$ the \emph{negentropy}.
Since $\nabla^{(e)} = \nabla^{(1)}$ and
$\nabla^{(m)} = \nabla^{(-1)}$ are flat,
the geodesics are easier to compute than those for the Levi-Civita connection 
$\nabla^{(0)}$.

% Divergences
\textbf{4.}
If $P$ and $Q$ belong to the same exponential family,
the canonical and Bregman \d{divergences} 
are related.
\begin{align*}
  A_F(\theta : \eta) &= F\theta + F^*\eta - \langle \eta, \theta \rangle \\
  B_F(\theta_1 : \theta_2 ) &= F \theta_1 - F \theta_2 - \langle \theta_1 - \theta_2 , \nabla F \theta_2 \rangle \\
  KL( P \,||\, Q ) & = B_F( \theta_P : \theta_Q ) = B_{F^*}( \eta_P : \eta_Q ) \\
  &= A_F( \theta_Q : \eta_P ) = A_{F^*} ( \eta_P : \theta_Q )
\end{align*}
\[ 
