\nextbook
\begin{book}
  \emph{Topological tail dependence:\\ evidence from forecasting realized volatility}\\
  H.G. Souto (2023)
\end{book}
Compute the (birth-death) persistence diagram (PD) for one month of daily log-returns
for stocks in a given basket (e.g., sector)
($T$ days for $n$ stocks gives $T$ points in $\RR^n$);
then use the Wasserstein distance between consecutive PDs
as a predictor of realized volatility.

It is an alternative to the change in average absolute correlation.


\nextbook
\begin{book}
  \emph{Path problems in networks}\\
  J.S. Baras and G. Theodorakopoulos (2010)
\end{book}
The \emph{algebraic path problem} aggregates edges along a path,
and then aggregates the results across paths:
\begin{compactitem}[--]
\item For the shortest path problem,
  we sum the edge weights along a path, and then take the path with the minimum weight;
\item For the maximum reliability problem, we multiply the edge weights
  (probability of non-failure) along a path, and then take the path with the largest weight.
\end{compactitem}

The shortest path can be computed with:
\begin{compactitem}[--]
\item Dijkstra (for non-negative weights);
\item Bellman-Ford (if there are no negative cycles):
  iterate
  \[ d_v \leftarrow \min_u d_u + w(u,v) \]
  until convergence (the updates can be asynchronous);
\item Floyd-Warshall
  (dynamic programming, to compute the all-pairs shortest paths,
  by progressively increasing the set of vertices used)
  \begin{align*}
    D^0 &\leftarrow A \\
    D^k_{ij} &\leftarrow \min \{ D_{ij}^{k-1} , D_{ik}^{k-1} + D_{kj}^{k-1} \}. 
  \end{align*}
\end{compactitem}

The algebraic path problem on a semiring
$(S,\oplus, \otimes, 0, 1)$, e.g.,
$(R\union\{\infty\}, \text{min}, +, \infty, 0)$
or
$([0,1], \text{max}, \times, 0, 1)$,
computes
\begin{align*}
  d_{st} &= \bigoplus_{ p \in P_{st} } w(p) \\
  w(p) &= w(v_1,v_2) \otimes \cdots \otimes w(v_{k-1}, v_k).
\end{align*}

If $S$ is a semiring, then so are
\begin{compactitem}[--]
\item $S^{n\times n}$ (matrices);
\item $S[[x]]$ (formal power series);
\item $S[[x]]/(x^2) \simeq S \times S$;
\item $\operatorname{End} S$;
\item $S_f$ (fixed points of $f: S \to S$, if $f$ is a ``reduction'').
\end{compactitem}

In matrix form, the problem is
$d' = d' A \oplus 1_s'$,
where
\begin{align*}
  d' &\text{: row vector} \\
  A &\text{: weighted adjacency matrix} \\
  1_s &\text{: vector of 0's, except for a 1 in position $s$}.
\end{align*}
Bellman-Ford iterates
$d' \leftarrow d' A \oplus 1_s'$.
The all-pairs shortest path problem solves
$D = DA \oplus I$
(and Floyd-Warshall iterates $D \leftarrow DA \oplus I$).
Under reasonable assumptions, the limit
$A^* = I \oplus A \oplus A^2 \oplus \cdots$
exists; the solution is not unique but
(under further reasonable assumptions) $A^*$ is the smallest.

Applications include
\begin{compactitem}[--]
\item Path enumeration:
  algebraic path problem on $S_f$,
  where
  \begin{align*}
    S &= \mathscr P( V \union V^2 \union \cdots \union V^n ) \\
    \oplus &\text{: union} \\
    \otimes &\text{: path concatenation} \\
    f(W) &= \{ w \in W \ :\ w \text{ elementary} \}
  \end{align*}
\item Expectations, from a Markov chain
  (expected number of visits of a given node,
  expected value of a path $s$--$t$);
\item Minimum spanning tree;
\item Shortest path;
\item Widest path;
\item Most reliable path;
\item $k$ shortest paths;
\item etc.  % Very long list
\end{compactitem}

Non-semiring path problems (aka non-Markovian path problems),
e.g., the sortest path with discounting,
can often be converted to semiring problems,
by enlarging the carrier set $S$
and selecting an approproate reduction function $f$.

\nextbook
\begin{book}
  \emph{Neural Bellman-Ford networks:\\ a general graph neural network framework\\ for link prediction}\\
  Z. Zhu et al. (2021)
\end{book}
Compute the representation of a pair of nodes (a potential edge)
$g(s,t)$ from the representation of the edges on the path from $s$ to $t$,
with the generalized Bellman-Ford algorithm
\[
f(s,t) = \bigoplus_{\substack{
    p : s \to t  \\
    p = (s=v_0,v_1,\dots,v_k=t)
}}
f(v_0,v_1) \otimes \cdots \otimes f(v_{k-1}, v_k)
\]
where $\oplus$, $\otimes$, 0 are learned.
Distance, Katz index, personalized page rank, etc., are special cases.

\nextbook
\begin{book}
  \emph{Direct preference optimization:\\ your language model is secretely\\ a reward model}\\
  R. Rafailov et al. (2023)
\end{book}
RLHF (reinforcement learning with human feedback) can be reformulated without reinforcement learning.

RLHF first learns a reward function, with a Bradley-Terry model
\begin{align*}
  P(y_1 > y_2) &= \dfrac{ e^{ r(x,y_1) } }{ e^{ r(x,y_1) } +e^{ r(x,y_2) } } \\
  \text{loss}(\phi) &= - \E_{ x, y1, y_2 \sim \text{Data} }
  \log \sigma\bigl( r_\phi(x,y_1) - r_\phi(x,y_2) \bigr)
\end{align*}
and uses it for RL
\begin{align*}
  & \operatorname*{Maximize}_\pi \E_{\substack{ x \sim \text{Data} \\ y \sim \pi }}
  \bigl[ r_\phi(x,y) \bigr] - \beta \cdot \text{KL} ( \pi \| \pi_{\text{ref}} )  \\
  & \pi(y|x) = \dfrac{
    \pi_{\text{ref}}(y|x) e^{ r_\phi(x,y) / \beta }
  }{ Z(x) }.
\end{align*}
But the reward can be expressed with the policy
\[ r_\phi(x,y) = \beta \cdot
\log \dfrac{ \pi(y|x) }{ \pi_{\text{ref}}(y|x) }
+ \beta \log Z(x) \]
and the Bradley-Terry model only uses the difference between the rewards:
the partition function disappears,
\[ P(y_1>y_2|x) = \sigma \left[
  \beta \log \dfrac{ \pi(y_1|x) }{ \pi_{\text{ref}}(y_1|x) } -
  \beta \log \dfrac{ \pi(y)2|x) }{ \pi_{\text{ref}}(y_2|x) }
  \right] \]
The DPO loss is
\[ \text{loss}(\pi) = - \!\!\!\! \E_{ x, y_1, y_1} \!\!\!\!
\log \sigma \!\left[
  \beta \log \!\dfrac{ \pi(y_1|x) }{ \pi_{\text{ref}}(y_1|x) } -
  \beta \log \!\dfrac{ \pi(y)2|x) }{ \pi_{\text{ref}}(y_2|x) }
  \right].
\]

\nextbook
\begin{book}
  \emph{BERTopic: neural topic modeling\\ with a class-based TF-IDF procedure}\\
  M. Grootendorst (2022)
\end{book}
BERTopic is a topic modeling pipeline:
\begin{compactitem}[--]
\item Document embedding (sentence transformer, SBERT);
\item Dimension reduction (UMAP);
\item Clustering (HDBScan);
\item Keyword extraction (cTF-IDF);
\item Topic representation fine-tuning
  (either None (just use the list of keywords)
  or an LLM to which you provide the keywords and the documents).
\end{compactitem}
For visualization, check \texttt{DataMapPlot}.

